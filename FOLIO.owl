    <!-- https://folio.openlegalstandard.org/RCim0bnYhIyP6C7Vx0G3tmQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCim0bnYhIyP6C7Vx0G3tmQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8LxIR1bsgFd3td2G24G3mq"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R90rPz0ItLncGp6GL7Dh1KR"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/10.00-MultipleBody-Adult.htm"/>
        <rdfs:label>Non-Mosaic Down Syndrome</rdfs:label>
        <skos:altLabel>Chromosome 21 Translocation</skos:altLabel>
        <skos:altLabel>Chromosome 21 Trisomy</skos:altLabel>
        <skos:altLabel>Non-Mosaic Trisomy 21</skos:altLabel>
        <skos:definition>Non-mosaic Down syndrome is a genetic disorder where individuals have three copies of chromosome 21 in all their cells (chromosome 21 trisomy) or an extra copy of chromosome 21 attached to another chromosome (chromosome 21 translocation). This condition results in characteristic physical features, developmental delays, and intellectual disability.</skos:definition>
    </owl:Class>
    


