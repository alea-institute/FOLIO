        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de extensión de horarios y declaraciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de extensión de horarios y declaraciones</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion d&apos;extension des délais et des déclarations de calendrier</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de prorrogação de prazos e apresentação de declarações</skos:altLabel>
