    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNTLgdEoQpfLgYExWmsFao -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNTLgdEoQpfLgYExWmsFao">
