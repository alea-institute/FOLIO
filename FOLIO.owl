        <skos:altLabel xml:lang="de-de">Bedingungsvorbehalt-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de condition préalable</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Condición Previa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Condición Previa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de condição precedente</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Condition Precedent Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תנאי קודם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शर्त पूर्ववता शब्दावली</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">先决条件条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">条件前提条項</skos:altLabel>
        <skos:definition>A condition precedent clause is a provision in a contract that specifies an event or action that must occur before the parties are obligated to perform their respective duties under the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RTxfNOfdvqgdC7o0NJpRwu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RTxfNOfdvqgdC7o0NJpRwu">
