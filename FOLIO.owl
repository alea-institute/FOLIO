        <skos:altLabel xml:lang="ja-jp">企業およびパートナーシップの責任請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公司和合伙责任索赔</skos:altLabel>
        <skos:definition>Corporate and Partnership Liability Claims refer to legal claims made against corporations or partnerships for their actions or inactions that result in harm or injury to others, including claims related to breach of fiduciary duty, wrongful interference, debt liability, freeze-out of minority shareholders, and piercing the corporate veil.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9JkqKed1jktjgwaeiLc7ru -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9JkqKed1jktjgwaeiLc7ru">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
        <rdfs:label>Liquidation Bankruptcy</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Falência de liquidação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Liquidation judiciaire</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Liquidationsinsolvenz</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">清算型破産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">清算破产</skos:altLabel>
        <skos:definition>This is a type of bankruptcy where an individual&apos;s or company&apos;s assets are sold to pay off creditors. The debtor is typically absolved of further responsibility for the debts once the assets are liquidated, and the proceeds are distributed amongst the creditors.</skos:definition>
    </owl:Class>
    


