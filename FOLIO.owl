        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R15Bf89EBBcdd05Ca4462a0b"/>
        <dc:identifier>US-FD-DOL-BLS</dc:identifier>
        <rdfs:label>Bureau of Labor Statistics</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bundesanstalt für Arbeitstatistik</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Bureau des statistiques du travail</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Departamento de Estatísticas do Trabalho</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Office for National Statistics</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Estadísticas Laborales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina de Estadísticas Laborales</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רשות הסטטיסטיקה העבודתית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">श्रम विभाग के सांख्यिकी ब्यूरो</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">劳工统计局</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">労働統計局</skos:altLabel>
        <skos:definition>The Bureau of Labor Statistics (BLS) is a unit of the United States Department of Labor. It is the principal fact-finding agency for the U.S. government in the broad field of labor economics and statistics and serves as a principal agency of the U.S. Federal Statistical System.</skos:definition>
        <skos:hiddenLabel>BLS</skos:hiddenLabel>
        <skos:prefLabel>Bureau of Labor Statistics</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFFozWk14Ts7EFMFQ4Of6X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFFozWk14Ts7EFMFQ4Of6X">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfP04tDTTpn4LDvwAxAqkh"/>
        <rdfs:label>Liberty Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Freiheitsklauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Liberty Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Libertad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de Cláusula de Libertad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de liberdade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de clause de liberté</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף חירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वतंत्रता धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">自由条款要求</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自由条項主張</skos:altLabel>
        <skos:definition>A Liberty Clause claim is a legal assertion related to the Due Process Clauses of the Fifth and Fourteenth Amendments of the United States Constitution. These clauses prohibit the federal government (Fifth Amendment) and state governments (Fourteenth Amendment) from depriving any person of &quot;life, liberty, or property&quot; without due process of law. A claim involving the Liberty Clause might arise in situations where an individual argues that a government action has unduly restricted their personal freedoms without proper legal procedures or justification.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFL8kZyR3c9ZZnIdisSm9o -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFL8kZyR3c9ZZnIdisSm9o">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
        <rdfs:label>Civil Law System</rdfs:label>
        <skos:altLabel>Code Law</skos:altLabel>
        <skos:altLabel>Continental Law</skos:altLabel>
        <skos:altLabel>Roman Law System</skos:altLabel>
        <skos:definition>Civil Law is a legal system that is primarily based on written codes and statutes, rather than case law. This system emphasizes comprehensive sets of laws that are codified and accessible, guiding judges in applying the law to individual cases.</skos:definition>
        <skos:prefLabel>Napoleonic Law System</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFMd9KTufdLa5bOSiMa67z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFMd9KTufdLa5bOSiMa67z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
        <rdfs:label>Travel Expense</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Despesas de viagem</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais de déplacement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gastos de viaje</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gastos de viaje</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Reisekosten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Travel Expense</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאות נסיעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यात्रा व्यय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">差旅费用</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">旅費</skos:altLabel>
        <skos:definition>Travel Expense refers to the costs incurred by an individual or organization for transportation, lodging, meals, and other related expenses while traveling for business or other purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFRFxY94fI8g3YrioLXDTZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFRFxY94fI8g3YrioLXDTZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
        <rdfs:label>Socialist Law System</rdfs:label>
        <skos:altLabel>Marxist-Leninist Law</skos:altLabel>
        <skos:altLabel>Socialist Legal Framework</skos:altLabel>
        <skos:altLabel>State Law</skos:altLabel>
        <skos:definition>Socialist Law is a legal system that developed in communist states, primarily based on the principles of Marxism-Leninism. This system emphasizes state ownership of property, centralized planning, and the role of the state in enforcing laws that promote socialist values.</skos:definition>
        <skos:prefLabel>Communist Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFRUssa9OxEwcySpHx8iby -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFRUssa9OxEwcySpHx8iby">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBGd796pNg5ltGWhkyk2ifm"/>
        <rdfs:label>Mortgage-Backed Securities</rdfs:label>
        <skos:altLabel>MBS</skos:altLabel>
        <skos:definition>Mortgage-Backed Securities (MBS) are investment vehicles that represent claims to the cash flows from pools of mortgage loans, primarily residential or commercial properties. Investors in MBS receive periodic payments derived from the principal and interest of the underlying mortgages, offering a means to invest in real estate without direct property ownership.</skos:definition>
        <skos:prefLabel>Securitized Mortgages</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFS05TC0KeQMxUVL41hffR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFS05TC0KeQMxUVL41hffR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
