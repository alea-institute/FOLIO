        <dc:identifier>US-FD-TREAS-SIGTARP</dc:identifier>
        <rdfs:label>Special Inspector General for the Troubled Asset Relief Program</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Inspecteur spécial pour le programme de secours des actifs en difficulté</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inspector Especial General para el Programa de Alivio de Activos en Problemas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inspector Especial General para el Programa de Alivio de Activos en Problemas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Inspetor Especial para o Programa de Alívio de Ativos Problemáticos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sonderinspektor für das Programm zur Rettung von problematischen Vermögenswerten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Special Inspector General for the Troubled Asset Relief Program</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מפקח מיוחד ראשי על תוכנית ההקלה מנכסי הסיכון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विशेष निरीक्षक जीआरएफएस के लिए तंग किए गए एसेट प्रोग्राम के लिए</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">問題資産救済プログラムの特別監査官</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">特别监察员负责烦扰资产救助计划</skos:altLabel>
        <skos:definition>The Office of the Special Inspector General for the Troubled Asset Relief Program (SIGTARP) is a federal law enforcement agency and an independent audit watchdog that targets financial institution crime and other fraud, waste, and abuse related to TARP</skos:definition>
        <skos:hiddenLabel>SIGTARP</skos:hiddenLabel>
        <skos:prefLabel>Special Inspector General for the Troubled Asset Relief Program</skos:prefLabel>
    </owl:Class>
    


