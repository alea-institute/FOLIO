        <rdfs:label>Native Village of Tununak</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HuNkpWm24qMFuntuug6RB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HuNkpWm24qMFuntuug6RB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7zvYKadqTXgMZV8ghLsloR"/>
        <rdfs:label>Evidence</rdfs:label>
        <skos:definition>Evidence refers to information, data, or physical items presented in a legal proceeding to support or refute a claim or charge. Its purpose is to prove or disprove the existence of an alleged fact. Evidence can take many forms, including witness testimony, documents, photographs, and forensic findings, and its admissibility in court is governed by a set of legal standards and rules.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HvF7FfEi0bAHAm2QCwRUe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HvF7FfEi0bAHAm2QCwRUe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2BaikN50BQY375QT0PEWD"/>
        <rdfs:label>Sick Leave</rdfs:label>
        <skos:definition>Sick leave is a form of paid time off that allows employees to take time away from work when they are ill or need medical care. It is designed to ensure that employees can recover from illness without losing income.</skos:definition>
        <skos:prefLabel>Sick Day</skos:prefLabel>
    </owl:Class>
    


