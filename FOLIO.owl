        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm"/>
        <rdfs:label>Thyroid Gland Disorders</rdfs:label>
        <skos:definition>Thyroid gland disorders affect the thyroid&apos;s ability to regulate metabolism and influence the sympathetic nervous system. These disorders can lead to cardiovascular issues, weight fluctuations, cerebrovascular accidents, cognitive impairments, mood disorders, and anxiety.</skos:definition>
        <skos:prefLabel>Thyroid Dysfunction</skos:prefLabel>
    </owl:Class>
    


