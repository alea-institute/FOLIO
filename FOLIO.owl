        <skos:altLabel xml:lang="en-gb">Answer with Counterclaims</skos:altLabel>
        <skos:altLabel>Answer with Set-Off and Counterclaim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Antwort mit Gegenansprüchen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Resposta com Contrapedidos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Respuesta con Contrademanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Respuesta con Contrademanda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réponse avec des contre-demandes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תשובה עם טענות חוזרות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्तर के साथ काउंटर क्लेम्स</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">以反诉答辩</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">反訴を含む回答</skos:altLabel>
        <skos:definition>Answer with Counterclaims: A response to a legal claim that includes additional claims made by the defendant against the plaintiff.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8b3GwW18cMlKh0m1z3FjbJ -->

