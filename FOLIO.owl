        <rdfs:label>A115 Medical Record and Medical Bill Management</rdfs:label>
        <skos:definition>Any services associated with the review, compilation, digesting, summary or processing of medical records or bills when performed in-house only</skos:definition>
        <skos:prefLabel>A115 Medical Record and Medical Bill Management</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R-tUY9f6JQmaH3G9o46sj6w -->

