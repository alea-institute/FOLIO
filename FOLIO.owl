        <rdfs:label>Tax Law Regulatory Objectives</rdfs:label>
        <skos:definition>Tax law regulatory objectives encompass the fundamental principles and considerations surrounding taxation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKAbM3LW2xY7EihJPQ0hih -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDKAbM3LW2xY7EihJPQ0hih">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCa0GJrngclDdSJ8dRAueqB"/>
