    <!-- https://folio.openlegalstandard.org/RCP7l2FfOtj2kWIy3WBWif5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCP7l2FfOtj2kWIy3WBWif5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rhpdjd9p358e9Rkel80dvQ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8aNhIN6jIIVcj5Cbh8Bduw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Compensation Agreement</rdfs:label>
        <skos:definition>A Compensation Related Agreement is a legally binding contract that specifically focuses on the structure and details of an employee&apos;s compensation, including elements like base salary, bonuses, stock options, and other financial incentives. These agreements serve to outline how an employee&apos;s pay is determined, disbursed, and adjusted over time, ensuring clarity and fairness in compensation arrangements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCPG83j3G4XHRakJP2jCUbT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCPG83j3G4XHRakJP2jCUbT">
