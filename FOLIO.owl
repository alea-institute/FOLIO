        <rdfs:label>Missouri Circuit Court - Perry County</rdfs:label>
        <skos:definition>Missouri Circuit Court - Perry County: A specific court within the Missouri Circuit Court system that has jurisdiction over legal proceedings in Perry County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRR2i6KF52EMANSCZJce4j -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRR2i6KF52EMANSCZJce4j">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC8gGTL4dazXLDWuElLZLjI"/>
        <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
        <rdfs:label>Online Dispute Resolution Forum</rdfs:label>
        <skos:altLabel>ODR</skos:altLabel>
        <skos:altLabel>ODR Forum</skos:altLabel>
        <skos:definition>An Online Dispute Resolution (ODR) Forum is a type of Alternative Dispute Resolution (ADR) Forum that operates through digital means, either with or without human facilitation, to resolve disputes between parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRTf0NaJCqqQm5rsltQSDH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRTf0NaJCqqQm5rsltQSDH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDs4RXqtrzif7ulCp2kI0mO"/>
        <rdfs:label>Multi-Jurisdictional Survey</rdfs:label>
        <skos:definition>A multi-jurisdictional survey (e.g., 50-state survey, 50-country survey) involves a systematic examination of laws, regulations, or practices across multiple specific jurisdictions within a larger entity, such as states within a country. It is often used to identify variations in legal standards or requirements and assess their impact on compliance or policy development.</skos:definition>
        <skos:prefLabel>50-State Survey</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRTsPoZhucp80NJy00WHwY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRTsPoZhucp80NJy00WHwY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7OQ65vKuOBSSGgSVYnoMfx"/>
        <rdfs:label>Proportional Electoral System</rdfs:label>
        <skos:definition>A proportional electoral system is a voting method designed to allocate seats in a legislative body in proportion to the number of votes each party or candidate receives. This system aims to create a representative body that mirrors the overall distribution of public support, promoting fairer and more inclusive representation.</skos:definition>
        <skos:prefLabel>Proportional Voting System</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRUXCA9aW6bv7Rdf2DaM5M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRUXCA9aW6bv7Rdf2DaM5M">
