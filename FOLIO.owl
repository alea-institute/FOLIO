&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBeOt3YZjlGxyEqD6VfyKrj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBeOt3YZjlGxyEqD6VfyKrj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVaHiNBU68DENmeHicnzro"/>
        <rdfs:label>Musical Work</rdfs:label>
        <skos:definition>A Musical Work is a composition that consists of a combination of melodies, harmonies, rhythms, and lyrics (if any), intended to be performed or recorded. Protected under copyright law, musical works grant composers and lyricists exclusive rights to reproduce, distribute, perform, and display the composition.</skos:definition>
        <skos:prefLabel>Song</skos:prefLabel>
    </owl:Class>
    


