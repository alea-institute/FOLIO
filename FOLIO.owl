        <rdfs:label>Extortion</rdfs:label>
        <skos:altLabel>Blackmail</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erpressung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Extorsion</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Extorsión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Extorsión</skos:altLabel>
