    <!-- https://folio.openlegalstandard.org/RCHjUD8ZPY6IzxUQx4LdHZn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHjUD8ZPY6IzxUQx4LdHZn">
