            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Disorderly Conduct</rdfs:label>
        <skos:altLabel>Affray</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Conducta desordenada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Conduta desordeira</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Desorden público</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disorderly Conduct</skos:altLabel>
        <skos:altLabel>Disturbing the Peace</skos:altLabel>
        <skos:altLabel>Noisy Quarrel</skos:altLabel>
        <skos:altLabel>Provocation of Disturbance</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Trouble à l&apos;ordre public</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unordentliches Verhalten</skos:altLabel>
        <skos:altLabel>Violent Disorder</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התנהגות לא מסודרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुशासित आचरण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不埒な行為</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不当行为</skos:altLabel>
        <skos:definition>Any behavior that tends to disturb the public or decorum, scandalize the community, or shock the public sense of morality.</skos:definition>
        <skos:prefLabel>Breach of the Peace</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Kso78437jpOj9Mkuf4huK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Kso78437jpOj9Mkuf4huK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDvvMcl4VbqDv1BGaZqaSL"/>
        <dc:description>Bankruptcy Courts will sometimes outsource court duties (e.g., Claims) to external agents (e.g., Claims Agents)</dc:description>
        <rdfs:label>Claims Agent</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Agent d&apos;indemnisation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Agente de Sinistros</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Agente de reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Agente de reclamos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Claims Agent</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schadensregulierer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוכן תביעות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावे एजेंट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クレームエージェント</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">理赔代理人</skos:altLabel>
        <skos:definition>A claims agent is a person who acts on behalf of an individual or organization to manage and process insurance claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8KyMVnE8XDipRREHWb4UYH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8KyMVnE8XDipRREHWb4UYH">
