    <!-- https://folio.openlegalstandard.org/R8ZwcccDaVSGgC9VLp18b1L -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZwcccDaVSGgC9VLp18b1L">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L4OY7QCBEVJpav2Da6Gef"/>
        <rdfs:label>Specific Service Tax Payment</rdfs:label>
        <skos:altLabel>Sector-Specific Tax Payment</skos:altLabel>
        <skos:altLabel>Service Industry Tax Payment</skos:altLabel>
        <skos:altLabel>Service-Specific Tax Payment</skos:altLabel>
        <skos:altLabel>Targeted Service Tax Payment</skos:altLabel>
        <skos:definition>Specific Service Tax Payment includes taxes assessed on payments for specific services, such as insurance premiums, banking services, gambling and betting stakes (e.g., from horse races, football pools, lottery tickets), transportation, entertainment, restaurant services, and advertising charges. It also covers taxes on entry to casinos, races, and similar events or venues, as well as stamp taxes on specific services. Additionally, it encompasses taxes levied on the gross income of companies providing these services, including bank levies and payments to deposit insurance and financial stability schemes.</skos:definition>
        <skos:prefLabel>Taxes on Specific Services</skos:prefLabel>
    </owl:Class>
    


