        <rdfs:label>Antitrust - Horizontal Market Allocation Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de asignación de mercado horizontal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de asignación de mercado horizontal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Antitrust - Horizontal Market Allocation Claims</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations d&apos;allocation de marché horizontal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de alocação de mercado horizontal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kartellrecht - Ansprüche auf horizontale Marktzuweisung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות חלוקת שוק אופקיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - हॉरिजॉन्टल मार्केट आवंटन दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反垄断 - 水平市场分配索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占禁止法 - 水平市場配分請求</skos:altLabel>
        <skos:definition>Antitrust - Horizontal Market Allocation Claims refer to legal claims that allege agreements between competitors to divide markets or customers, which violate antitrust laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rmv3aWwfnLGj1avQvTQulY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rmv3aWwfnLGj1avQvTQulY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9MVhcSKkXJDVsx44Ww5zfU"/>
        <rdfs:label>No-Shop Covenant - Fiduciary Exception</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-shopping - Exception fiduciaire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Covenant de no compras - Excepción fiduciaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Covenant de no compras - Excepción fiduciaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Covenants de não-compra - Exceção fiduciária</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kein-Shop-Pakt - Treuhänderische Ausnahme</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No-Shop Covenant - Fiduciary Exception</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם לא לקנות - יוצאי דופן פידוסיארי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नो-शॉप कवेनेंट - फिडूशियरी अपवाद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ノーショップ契約 - 受託者例外</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不购物契约 - 受托人例外</skos:altLabel>
        <skos:definition>A No-Shop Covenant - Fiduciary Exception is a legal agreement that allows a target company&apos;s board of directors to consider alternative acquisition offers during a specified period, despite a prior agreement with an initial bidder, if the board determines that it is in the best interest of the company and its shareholders.</skos:definition>
    </owl:Class>
    


