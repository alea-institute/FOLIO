        <rdfs:label>Florida Circuit Court - Citrus County - 5th Circuit Court</rdfs:label>
        <skos:definition>A court located in Citrus County, Florida that is part of the larger Florida Circuit Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiRVLCipn93y5m4XetrILF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiRVLCipn93y5m4XetrILF">
