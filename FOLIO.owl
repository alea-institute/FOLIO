        <skos:altLabel xml:lang="hi-in">स्केटबोर्ड और होवर बोर्ड लिएबिलिटी क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スケートボードおよびホバーボードの責任請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">滑板和悬浮板责任索赔</skos:altLabel>
        <skos:definition>A Skateboard and Hover Board Liability Claim is a legal claim for damages resulting from injuries caused by the use of a skateboard or hover board, falling under the category of Personal Injury Claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ReoekaIFkvXuZDtiEVwWPe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ReoekaIFkvXuZDtiEVwWPe">
