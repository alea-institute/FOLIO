        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Dispute Resolution Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de résolution de conflit</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Resolución de Controversias</skos:altLabel>
