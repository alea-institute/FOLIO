        <skos:altLabel xml:lang="es-es">Moneda de la factura</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moneda de la factura</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechnungswährung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מטבע החשבונית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चालान मुद्रा</skos:altLabel>
