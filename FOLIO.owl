        </rdfs:subClassOf>
        <rdfs:label>Name Change</rdfs:label>
        <skos:definition>A name change refers to the legal act of altering one&apos;s official given name, surname, or both. The process typically requires the submission of a petition to a court and, upon approval, results in a legal decree formally recognizing the new name</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHRgW9FoXBjAT8LzX1CiKD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHRgW9FoXBjAT8LzX1CiKD">
