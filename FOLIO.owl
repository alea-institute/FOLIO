        <skos:altLabel xml:lang="zh-cn">米克马克人</skos:altLabel>
        <skos:definition>A Native American language spoken by the Mi&apos;kmaq people in Eastern Canada and Northeastern United States.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wXEpicPBDF420JUfmdsD8 -->

