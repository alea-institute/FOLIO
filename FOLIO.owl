        <rdfs:label>Motion in Limine to Exclude Document</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss eines Dokuments im Vorfeld des Prozesses</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción en Limine para Excluir Documento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción en Limine para Excluir Documento</skos:altLabel>
