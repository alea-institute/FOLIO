        <skos:altLabel xml:lang="en-gb">Right to Indemnification Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות לפיצויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भरण-शुल्क अधिकार शर्त</skos:altLabel>
