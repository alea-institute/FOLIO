        <rdfs:label>Motion to Withdraw Document</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Rücknahme des Dokuments</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Retirar Documento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Retirar Documento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion de retrait de document</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Withdraw Document</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Retirada de Documento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למשיכת מסמך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दस्तावेज़ वापस लेने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤回文件动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書撤回の申立て</skos:altLabel>
        <skos:definition>A Motion to Withdraw Document is a formal request made to a court or other legal authority to remove a written or recorded representation of thought or expression from consideration in a legal proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Ru41sI42cmsEoPZNzlCVbW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Ru41sI42cmsEoPZNzlCVbW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCIv9j8UdKC0YVPrbl5EGRq"/>
        <rdfs:label>Peppers</rdfs:label>
        <skos:altLabel>Capsicum</skos:altLabel>
        <skos:definition>Peppers are fruit vegetables from the Capsicum genus, known for their diverse flavors ranging from sweet to spicy. They are used in a wide array of culinary applications, valued for their vibrant colors, unique flavors, and nutritional benefits, including vitamins A and C and antioxidants.</skos:definition>
        <skos:example>Bell Peppers</skos:example>
        <skos:example>Chili Peppers</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Ru4JWcuxmRIKjPMhZxpgyvA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Ru4JWcuxmRIKjPMhZxpgyvA">
