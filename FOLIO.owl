        <skos:altLabel xml:lang="fr-fr">Opposition à la confirmation du plan</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התנגדות לאישור התוכנית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">योजना की पुष्टि के विरोध</skos:altLabel>
