    <!-- https://folio.openlegalstandard.org/RCC2GjmZO3mWrOPOcd9r0Lc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCC2GjmZO3mWrOPOcd9r0Lc">
