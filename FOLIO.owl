        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=711120"/>
        <rdfs:label>Dance Companies</rdfs:label>
        <skos:definition>This industry comprises companies, groups, or theaters primarily engaged in producing all types of live theatrical dance (e.g., ballet, contemporary dance, folk dance) presentations. Dance companies or groups may or may not operate their own theater or other facility for staging their shows.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/QKrevBEYTJOraTpDdJHUhw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/QKrevBEYTJOraTpDdJHUhw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/f5KVOtZmSlibxAGrEymRkQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311225"/>
        <rdfs:label>Fats and Oils Refining and Blending</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing shortening and margarine from purchased fats and oils; (2) refining and/or blending vegetable, oilseed, and tree nut oils from purchased oils; and (3) blending purchased animal fats with purchased vegetable fats.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/QMDWyi9LRsu0sEfRO0bH0w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/QMDWyi9LRsu0sEfRO0bH0w">
