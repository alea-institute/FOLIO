        <skos:definition>Trade Secret Assets are a type of Intellectual Property Asset that refers to confidential information or knowledge that provides a competitive advantage to a person, business, or economic entity and is kept secret from the public.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMYc4C8uXSI5QSPFRcJHbr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMYc4C8uXSI5QSPFRcJHbr">
