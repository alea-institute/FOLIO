        <skos:altLabel xml:lang="es-mx">Moción para incurrir en deuda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour encourir une dette</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Incur Debt</skos:altLabel>
