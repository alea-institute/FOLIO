        <skos:altLabel xml:lang="es-mx">Cláusula de no solicitud de clientes</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não solicitação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Nichtansprachevereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Non Solicitation Agreement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הסכם אי-סילוקיטציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ग्राहक अनुरोध अनुबंध शर्त</skos:altLabel>
