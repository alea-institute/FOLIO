                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RUrIiX9pApJERjw9wlyjXg"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Islamic Law</rdfs:label>
        <skos:altLabel>Fiqh Law</skos:altLabel>
        <skos:altLabel>Islamic Jurisprudence</skos:altLabel>
        <skos:definition>Sharia Law is an Islamic legal system based on the Quran and the teachings and practices of the Prophet Muhammad, governing aspects of both personal and communal life.</skos:definition>
        <skos:prefLabel>Sharia Law</skos:prefLabel>
    </owl:Class>
    


