        <skos:altLabel xml:lang="ja-jp">不動産書類</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房地产文件</skos:altLabel>
        <skos:definition>Real Estate Documents are written or recorded representations of property ownership, transfer, or use, including but not limited to deeds, mortgages, and leases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9OVaeQiwFO2v0rOQ7F7IoT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9OVaeQiwFO2v0rOQ7F7IoT">
