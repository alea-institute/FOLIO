        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBRosNDPt8cNUuRnoPqYufN"/>
        <rdfs:label>Breach of Implied Warranty of Habitability by Home Seller</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Habitability by Home Seller</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de la garantía implícita de habitabilidad por parte del vendedor de la casa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de la garantía implícita de habitabilidad por parte del vendedor de la vivienda</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung der Bewohnbarkeit durch den Hausverkäufer</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite d&apos;habitabilité par le vendeur de la maison</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de habitabilidade pelo vendedor da casa</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת האחריות המשתלמת המשתלמת על ידי מוכר הבית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">घर विक्रेता द्वारा निहित वारंटी के अवहेलना का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">住宅売主による暗黙の居住可能性保証の違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房屋卖方违反隐含的适居保证</skos:altLabel>
        <skos:definition>The Breach of Implied Warranty of Habitability by Home Seller refers to the failure of a home seller to provide a livable and safe dwelling to the buyer, which was not disclosed during the sale, resulting in legal action against the seller.</skos:definition>
    </owl:Class>
    


