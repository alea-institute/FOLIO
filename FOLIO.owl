    <!-- https://folio.openlegalstandard.org/R855VzWlwJfhQ93qKVKTPrB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R855VzWlwJfhQ93qKVKTPrB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2BaikN50BQY375QT0PEWD"/>
        <rdfs:label>Work Holiday</rdfs:label>
        <skos:altLabel>Bank Holiday</skos:altLabel>
        <skos:altLabel>Federal Holiday</skos:altLabel>
        <skos:altLabel>National Holiday</skos:altLabel>
        <skos:altLabel>Public Holiday</skos:altLabel>
        <skos:altLabel>Statutory Holiday</skos:altLabel>
        <skos:definition>A Work Holiday is a designated day off from regular work duties, typically established by law, custom, or employer policy, where employees are not required to work but usually receive pay. These days often commemorate significant cultural, historical, or religious events and are intended to provide workers with time for celebration, remembrance, or rest.</skos:definition>
    </owl:Class>
    


