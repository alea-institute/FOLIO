    <!-- https://folio.openlegalstandard.org/RWIHny9UXFuBj5mDBhG4A4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RWIHny9UXFuBj5mDBhG4A4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Three-fifths Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf den Drei-Fünftel-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Tres Quintos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Tres Quintos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula dos Três Quintos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de la clause des trois cinquièmes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Three-fifths Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף שלוש-חמישים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तीन-पांचवां धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">三分の五条項クレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">三分之五条款索赔</skos:altLabel>
        <skos:definition>A Three-fifths Clause claim is a legal assertion tied to Article I, Section 2, Clause 3 of the U.S. Constitution, historically known as the Three-fifths Clause. This clause counted enslaved individuals as three-fifths of a person for purposes of representation and taxation, but it was effectively rendered obsolete by the Thirteenth Amendment, which abolished slavery.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RWKIphtLSAmBsHlh8PVumF -->

