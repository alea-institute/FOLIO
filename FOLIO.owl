        <skos:altLabel xml:lang="es-mx">Evento Interviniente - Ocurre Después de la Firma</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intervening Event - Occurs After Signing</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement intervenant après la signature</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירוע מתערב - מתרחש לאחר החתימה</skos:altLabel>
