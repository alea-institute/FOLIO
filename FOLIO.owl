        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RhRZrC0x98pp0kpwiGgwSD"/>
        <rdfs:label>Copyright Concept Objectives</rdfs:label>
        <skos:definition>Copyright Concept Objectives refer to the criteria that a work must meet to be eligible for copyright protection. These objectives can include originality, expression in a tangible medium, and creativity, ensuring the work is a unique creation of the author.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8O7ZXDsTGKT17x6b5Ie4nd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8O7ZXDsTGKT17x6b5Ie4nd">
