    <!-- https://folio.openlegalstandard.org/RCE0Yra7ugHR8DmISUDu3qp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCE0Yra7ugHR8DmISUDu3qp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxtm6yCTUcImGngCzkPcx0"/>
        <dc:source>Fed. R. Evid. 804(b)(3)</dc:source>
        <rdfs:label>Statement Against Interest</rdfs:label>
        <skos:altLabel>Admission Against Interest</skos:altLabel>
        <skos:altLabel>Declaration Against Interest</skos:altLabel>
        <skos:definition>A Statement Against Interest is a hearsay exception that allows the admission of statements that, at the time they were made, were contrary to the declarant&apos;s pecuniary, proprietary, or penal interest, or subjected the declarant to civil or criminal liability. This exception is based on the assumption that a person is unlikely to make a statement that goes against their own interests unless they believe it to be true.</skos:definition>
    </owl:Class>
    


