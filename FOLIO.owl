        <rdfs:label>Waiver of Right of First Refusal Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation au droit de préemption</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia al derecho de primera oferta</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia al derecho de tanteo</skos:altLabel>
