        <rdfs:label>Waiver of Presentment Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation à la présentation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia a la presentación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a la presentación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renúncia à apresentação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzicht auf Vorlageklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waiver of Presentment Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פטור מהצגה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रस्तुति के अस्तव्यस्त क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">提示免除条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">放弃呈现条款</skos:altLabel>
        <skos:definition>A Waiver of Presentment Clause is a provision in a legal document that waives the requirement for a party to present a document or instrument for payment or acceptance before taking legal action.</skos:definition>
    </owl:Class>
    


