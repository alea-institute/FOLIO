            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Spousal Support</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ehegattenunterhalt</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Manutención conyugal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pension alimentaire pour conjoint</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Pensión alimenticia para el cónyuge</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pensão alimentícia para cônjuge</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Spousal Maintenance</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תמיכה בניידות בני זוג</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पति या पत्नी का सहारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">配偶扶養費</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">配偶赡养费</skos:altLabel>
        <skos:definition>Spousal support refers to the financial assistance provided by one spouse to the other after separation or divorce, typically to maintain the standard of living established during the marriage.</skos:definition>
        <skos:prefLabel>Alimony</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDeXT5Kv4E7Dr18IlbAMl0D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDeXT5Kv4E7Dr18IlbAMl0D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92S2HIVThaRnO0lgcFKgIw"/>
        <rdfs:label>Rest Break Violation Claim</rdfs:label>
        <skos:altLabel xml:lang="es-es">Reclamación por violación del descanso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por violación del descanso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de violação de intervalo de descanso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Rest Break Violation Claim</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation pour violation de pause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verstoß gegen die Ruhepause geltend machen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת מנוחה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आराम विराम उल्लंघन दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">休息时间违规索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">休憩時間違反請求</skos:altLabel>
        <skos:definition>A rest break violation claim is a legal action initiated by an employee against their employer for not complying with the legal requirement to provide rest breaks of a certain duration during the workday. The claim typically arises when an employer either denies or interrupts the rest break, does not provide the break in accordance with applicable labor laws, or requires the employee to perform work duties during the rest break. In some cases, employers may also be liable for rest break violations if they do not compensate employees for certain types of work performed during rest breaks.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDeZlellOVEkUBkTSbLgxUC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDeZlellOVEkUBkTSbLgxUC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Student</rdfs:label>
        <skos:definition>A student is an individual who is enrolled in an educational institution, such as a school, college, or university, for the purpose of acquiring knowledge, skills, and qualifications. Students engage in a structured learning process to pursue academic or vocational goals, typically under the guidance of teachers or instructors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDebWvZPYljGPGcwuhNz4rR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDebWvZPYljGPGcwuhNz4rR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDECjssxw76vdlahxiUTb4L"/>
        <rdfs:label>Missouri Circuit Court - McDonald County</rdfs:label>
        <skos:definition>Missouri Circuit Court - McDonald County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters in McDonald County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDef8aRK4pZQeql9eOhL7O3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDef8aRK4pZQeql9eOhL7O3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB6mWlc1WihUbnT7ztVcao5"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm#5_11"/>
        <rdfs:label>Small Intestine Transplantation</rdfs:label>
        <skos:altLabel>Intestinal Transplant</skos:altLabel>
        <skos:altLabel>Small Bowel Transplantation</skos:altLabel>
        <skos:definition>Small intestine transplantation is a surgical procedure where a diseased or non-functional small intestine is replaced with a healthy donor intestine. This transplant is typically performed for patients with severe intestinal failure or dysfunction who cannot absorb nutrients effectively through other means.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDefVOzoV0h0oR8Ys3gSzw7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDefVOzoV0h0oR8Ys3gSzw7">
