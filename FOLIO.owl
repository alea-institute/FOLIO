        <skos:altLabel xml:lang="zh-cn">文件处理实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書処理の実践</skos:altLabel>
        <skos:definition>The Processing of Documents Practice refers to the specific legal work involved in collecting and producing documents in the course of a legal matter, and is a subcategory of the Document Collection and Production Practice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9yxbDuVoy3DTGPFCjwuh3K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9yxbDuVoy3DTGPFCjwuh3K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJgy4NDLgsP7qaqied5k5c"/>
        <rdfs:label>Virtual Reality</rdfs:label>
        <skos:altLabel>Immersive Digital Experiencea</skos:altLabel>
        <skos:altLabel>VR</skos:altLabel>
        <skos:altLabel>VR Experience</skos:altLabel>
        <skos:altLabel>Virtual Reality Simulation</skos:altLabel>
        <skos:altLabel>Virtual Simulation</skos:altLabel>
        <skos:definition>A Virtual Reality Experience is an immersive, interactive environment created using computer technology that simulates a real or imagined world, allowing users to engage with the environment through specialized hardware such as VR headsets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9yzeK9HOihAOIF0x8nTHxG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9yzeK9HOihAOIF0x8nTHxG">
