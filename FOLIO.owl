        <rdfs:label>Native Village of Chitina</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uBWMWwqnnRqkH4BibwCDr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uBWMWwqnnRqkH4BibwCDr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7y4MfRVjPqdQsxJpyGbD67"/>
        <rdfs:label>Fee Simple Determinable Interest</rdfs:label>
        <skos:definition>A fee simple determinable interest is a type of freehold estate in real property that automatically ends and reverts to the grantor upon the occurrence or non-occurrence of a specified event or condition. This estate is characterized by a possibility of reverter, where the original owner (or their heirs) has the right to reclaim ownership if the condition is breached.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uBsKVQDX9xAi6Pltit8dF -->

