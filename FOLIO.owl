        <skos:altLabel xml:lang="pt-br">Reivindicação de transferência preferencial</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de transfert préférentiel</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorzugsübertragungsanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת העברה מועדפת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्राथमिक अंतरण दावा</skos:altLabel>
