        <dc:identifier>US-FD-NRC</dc:identifier>
        <rdfs:label>U.S. Nuclear Regulatory Commission</rdfs:label>
        <skos:altLabel xml:lang="es-es">Comisión Reguladora Nuclear de los Estados Unidos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Comisión Reguladora Nuclear de los Estados Unidos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Comissão Reguladora Nuclear dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Commission de réglementation nucléaire des États-Unis</skos:altLabel>
        <skos:altLabel xml:lang="de-de">U.S. Nuclear Regulatory Commission</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">U.S. Nuclear Regulatory Commission</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוועדה לרישוי גרעיני של ארצות הברית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूएस न्यूक्लियर नियामक आयोग</skos:altLabel>
