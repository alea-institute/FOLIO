        <rdfs:label>Texas Court of Appeals - 2d</rdfs:label>
        <skos:definition>The Texas Court of Appeals - 2d is a specific intermediate appellate court in Texas that hears appeals from lower courts within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R84ixwXrvkKsyCQNmplwY8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R84ixwXrvkKsyCQNmplwY8">
