    <!-- https://folio.openlegalstandard.org/R9WOb0bt92MYMFhZ3FFwROe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9WOb0bt92MYMFhZ3FFwROe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nREeU6lB0zs0dt9N339nm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
