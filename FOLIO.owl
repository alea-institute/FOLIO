    <!-- https://folio.openlegalstandard.org/R7RIiGEhbNy3YC5PH9ohXMp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7RIiGEhbNy3YC5PH9ohXMp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8R7UAZpzIQTdqNtctKj3XY"/>
        <dc:source>Fed. R. Evid. 610.</dc:source>
        <rdfs:label>Religious Belief Evidence Objection</rdfs:label>
        <skos:altLabel>Creed Evidence Objection</skos:altLabel>
        <skos:altLabel>Faith-Based Evidence Objection</skos:altLabel>
        <skos:altLabel>Objection to Evidence of Religious Affiliation</skos:altLabel>
        <skos:definition>A Religious Belief Evidence Objection is raised when a party in a legal proceeding believes that evidence regarding a person&apos;s religious beliefs or practices is being used unfairly to suggest credibility, believability, or character. This objection aims to prevent prejudice or bias based on religious affiliation and to ensure that the focus remains on relevant and admissible evidence.</skos:definition>
    </owl:Class>
    


