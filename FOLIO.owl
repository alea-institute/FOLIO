        <rdfs:label>Motion to Abstain and Remand</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Enthaltung und Zurückverweisung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Abstención y Devolución</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Abstención y Devolución</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion d&apos;abstention et de renvoi</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Abstain and Remand</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Abstenção e Devolução</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת חדלון והחזרה לשיקול דעת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुच्छेद अवरुद्ध करने और पुनर्निर्देशित करने का अभियान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">弃权和退回动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">棄権および差し戻しの動議</skos:altLabel>
        <skos:definition>A Motion to Abstain and Remand is a request made in a bankruptcy case to temporarily halt proceedings and send the case back to a lower court for further review or action.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RixnrA7cMNoJE25gFQ2maF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RixnrA7cMNoJE25gFQ2maF">
