        <skos:altLabel xml:lang="es-es">Cláusula de no competencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no competencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não concorrência</skos:altLabel>
