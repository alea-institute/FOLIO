        <skos:altLabel xml:lang="ja-jp">配偶は他の配偶者の債務に責任を負う</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">配偶对另一配偶的债务负责</skos:altLabel>
        <skos:definition>When one spouse is responsible for the debt of the other spouse, typically due to a joint account or co-signing a loan.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDlhbcek4X5EXc5Oz0vWnOi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDlhbcek4X5EXc5Oz0vWnOi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_15"/>
        <rdfs:label>Pleura or Mediastinum Cancer</rdfs:label>
        <skos:altLabel>Thoracic Cavity Cancer</skos:altLabel>
        <skos:definition>Pleura or mediastinum cancer refers to malignant tumors originating in the pleura, the thin tissue covering the lungs and lining the chest cavity, or in the mediastinum, the central compartment of the thoracic cavity. These cancers can significantly affect respiratory function and often require complex diagnostic and therapeutic approaches due to their proximity to vital structures.</skos:definition>
        <skos:example>Mediastinal Cancer</skos:example>
        <skos:example>Pleural Cancer</skos:example>
    </owl:Class>
    


