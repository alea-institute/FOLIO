        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RE5Fc26D4606fC0Cd7664845"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Statement of Current Monthly Income</rdfs:label>
        <skos:altLabel xml:lang="es-es">Declaración de ingresos mensuales actuales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Declaración de ingresos mensuales actuales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Declaração de Renda Mensal Atual</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déclaration de revenus mensuels actuels</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erklärung des aktuellen monatlichen Einkommens</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Statement of Current Monthly Income</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצהרת הכנסה חודשית נוכחית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वर्तमान मासिक आय का बयान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">当前月收入声明</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現在の月収入の声明</skos:altLabel>
        <skos:definition>A Statement of Current Monthly Income is a document required in bankruptcy and restructuring proceedings that provides a detailed account of an individual&apos;s income and expenses for the current month.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUtAfKXfMN4dku9MsqeFjW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUtAfKXfMN4dku9MsqeFjW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
        <rdfs:label>Purchase Price Adjustment Mechanism</rdfs:label>
        <skos:altLabel>Price Adjustment Clause</skos:altLabel>
        <skos:definition>A Purchase Price Adjustment Mechanism is a contractual provision in M&amp;A transactions that allows for changes to the initial purchase price based on the target company&apos;s financial performance or position as of the closing date. It ensures that the final price reflects the actual value of the target, protecting the interests of both buyer and seller.</skos:definition>
        <skos:prefLabel>Transaction Price Adjustment Mechanism</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUuMlya908dAt6EHF7YDy4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUuMlya908dAt6EHF7YDy4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QtA1XEvYBttW8LUvBN7OB"/>
        <rdfs:label>Release of Obligations Clause</rdfs:label>
