    <!-- https://folio.openlegalstandard.org/Rc3SCACYuFZN3xybjUHDjy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rc3SCACYuFZN3xybjUHDjy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89ziIl0nXs5c4ONtS7qXTP"/>
        <dc:source rdf:resource="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf#page=401&amp;zoom=100,124,477"/>
        <rdfs:label>Top Secret</rdfs:label>
        <skos:altLabel>Highest Security Classification</skos:altLabel>
        <skos:altLabel>Maximum Security Classification</skos:altLabel>
        <skos:altLabel>Most Sensitive Information</skos:altLabel>
        <skos:definition>Top Secret is the highest level of classified information, requiring the strictest control and protection due to its potential to cause exceptionally grave damage to national security if disclosed. Access to top secret information is highly restricted and granted only to individuals with the appropriate security clearance and a demonstrated need to know.</skos:definition>
        <skos:prefLabel>Maximum Security Information</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rc3fpKzNOlwHWBICwHGUUn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rc3fpKzNOlwHWBICwHGUUn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDBbmSqBVTGWStGET9PQuFk"/>
        <rdfs:label>Annual Recurring Revenue</rdfs:label>
        <skos:altLabel>ARR</skos:altLabel>
        <skos:definition>Annual Recurring Revenue (ARR) is a metric commonly used by subscription-based businesses to measure the total amount of predictable revenue generated from subscriptions over a one-year period. Unlike Monthly Recurring Revenue (MRR), ARR provides a longer-term view of revenue stability and is often used for strategic planning and valuation purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rc5228EFUCPVV6xlzi7rTd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rc5228EFUCPVV6xlzi7rTd">
