    <!-- https://folio.openlegalstandard.org/Rhpdjd9p358e9Rkel80dvQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rhpdjd9p358e9Rkel80dvQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg"/>
        <rdfs:label>Employment and Labor Agreements</rdfs:label>
        <skos:definition>An employment-related agreement refers to a broad category of legally binding contracts that govern various aspects of the employer-employee relationship, such as Collective Bargaining Agreements (CBAs) negotiated between labor unions and employers to set terms and conditions of employment, Compensation Related Agreements detailing how compensation and benefits are structured, and Retention Related Agreements designed to retain key employees through incentives or contractual obligations. These agreements serve to define the rights, responsibilities, and expectations of both parties involved in the employment relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RhpzdUQII7ofiS6SGGBcM1 -->

