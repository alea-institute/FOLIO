    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7QiKeEkci1FYlRMv6nDRnv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7QiKeEkci1FYlRMv6nDRnv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7VHEoDUFVEwkyvRY96BMGR"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RE5Fc26D4606fC0Cd7664845"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bankruptcy First Day Motions</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anträge am ersten Tag des Insolvenzverfahrens</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bankruptcy First Day Motions</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones del primer día de bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones del primer día de quiebra</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions du premier jour de la faillite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedidos do primeiro dia de falência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועות יום ראשון של בישול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवस एक दिवस दिवस दावों में दिवस दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产首日动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産初日モーション</skos:altLabel>
        <skos:definition>Bankruptcy First Day Motions are motions filed by a debtor on the first day of a bankruptcy case, seeking relief from certain requirements or restrictions, such as the automatic stay, to allow for the continued operation of the debtor&apos;s business.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Qj5gZIdKfp8urYwCzPXO7 -->

