        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQxwZ0byxdnIYBnX6xystH"/>
        <rdfs:label>Librarian</rdfs:label>
        <skos:definition>A Librarian is a professional who manages, categorizes, and provides accessto  collections of legal resources, books, and documents, to ensure that legal practitioners can quickly and accurately access the information they need.</skos:definition>
        <skos:prefLabel>Law Librarian</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UG79BtYP2uqnKNklLYXB8"/>
        <rdfs:label>Demographic Market Segments</rdfs:label>
        <skos:definition>Demographic segments refer to divisions of the market that are categorized based on demographic characteristics such as age, gender, income, education level, and family status. These segments help marketers and businesses tailor their products and services to specific groups within the population, based on their unique needs and preferences.</skos:definition>
        <skos:note>Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0</skos:note>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KxjL7VPa0Qrz5eSP9DAs3 -->

