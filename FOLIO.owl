        <skos:altLabel xml:lang="hi-in">पूंजी विवरण और वारंटी का प्रतिनिधित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">資本化の表現と保証</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">资本化陈述和保证</skos:altLabel>
        <skos:definition>A Capitalization Representations and Warranties is a legal concept that refers to the specific promises and guarantees made by a party in a contract regarding the accuracy and completeness of information related to the capitalization of a company.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RhPmRmpfrSEU2MzOj8RMmg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RhPmRmpfrSEU2MzOj8RMmg">
