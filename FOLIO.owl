        <rdfs:label>Injunctions, Restraining Orders, and Provisional Remedies Practice</rdfs:label>
        <skos:altLabel>Injunctions, Restraining Orders, and Provisional Remedies</skos:altLabel>
        <skos:altLabel>Injunctions, Restraining Orders, and Provisional Remedies Service</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Injunctions, Restraining Orders, and Provisional Remedies Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique des injonctions, des ordonnances de restriction et des mesures provisoires</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Praxis der einstweiligen Verfügungen, einstweiligen Anordnungen und vorläufigen Maßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de medidas cautelares, órdenes de restricción y remedios provisionales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de medidas cautelares, órdenes de restricción y remedios provisionales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de medidas cautelares, ordens de restrição e remédios provisórios</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעשה בצווי עיכוב, הגבלה ופתרונות זמניים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निषेधाज्ञा, रोकथाम आदेश और अस्थायी उपाय अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">差止命令、差止令、仮処分の実務</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">禁令、限制令和临时救济实践</skos:altLabel>
        <skos:definition>The practice of seeking and obtaining court orders, such as injunctions, restraining orders, and provisional remedies, before a trial takes place, as part of pretrial motion practice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiY06PEub4nD4fdnlfwkqq -->

