        <rdfs:label>Minnesota District Court - Stearns County</rdfs:label>
        <skos:definition>A Minnesota District Court located in Stearns County, which is a trial court of general jurisdiction in Minnesota, handling civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xXHdEoLx3SWagIQRtEFIh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xXHdEoLx3SWagIQRtEFIh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QiKeEkci1FYlRMv6nDRnv"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9YRpWbNnIcSUZuYywRWkU"/>
        <rdfs:label>First Day Declaration</rdfs:label>
        <skos:altLabel xml:lang="es-es">Declaración del Primer Día</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Declaración del Primer Día</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Declaração do primeiro dia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déclaration du premier jour</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erklärung zum ersten Tag</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">First Day Declaration</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצהרת יום ראשון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पहले दिन की घोषणा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">初日宣言</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">首日声明</skos:altLabel>
        <skos:definition>A First Day Declaration in bankruptcy is a legal document filed by a debtor that provides information about the debtor&apos;s financial situation and the reasons for filing for bankruptcy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xXtNuWfHbvZCMmCvK0Ece -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xXtNuWfHbvZCMmCvK0Ece">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9kmGZf5FSmFdouXWQ1Nndm"/>
        <rdfs:label>Legal Services Related Attributes</rdfs:label>
        <skos:definition>Legal Services Related Attributes refer to the characteristics and classifications of tasks performed by a legal service provider that determine whether the activities are billable or non-billable to the client. These attributes help identify the financial impact and efficiency of the services provided, influencing billing practices and revenue generation for the firm.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMBmtgbWlLDL3wM3Mv5eOp"/>
        <rdfs:isDefinedBy rdf:resource="http://oecdprivacy.org/"/>
        <rdfs:label>Privacy Principles</rdfs:label>
        <skos:altLabel xml:lang="de-de">Datenschutzprinzipien</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Principes de confidentialité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Principios de privacidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Principios de privacidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Princípios de privacidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Privacy Principles</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עקרונות פרטיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गोपनीयता सिद्धांत</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プライバシー原則</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">隐私原则</skos:altLabel>
        <skos:definition>These privacy principles, developed by the Organisation for Economic Co-operation and Development (OECD), provide the most commonly used privacy framework, they are reflected in existing and emerging privacy and data protection laws, and serve as the basis for the creation of leading practice privacy programs and additional principles. These principles are part of the OECD Guidelines on the Protection of Privacy and Transborder Flows of Personal Data, which was developed in the late 1970s and adopted in 1980.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xetKG7UJNRSImGDq3ssRk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xetKG7UJNRSImGDq3ssRk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9I5NnI41F5zvaAiT1AdU7I"/>
        <rdfs:label>Accumulation Fund</rdfs:label>
        <skos:altLabel>Growth Fund</skos:altLabel>
        <skos:altLabel>Growth Investment Fund</skos:altLabel>
        <skos:altLabel>Profit Reinvestment Fund</skos:altLabel>
        <skos:definition>An Accumulation Fund is an investment fund that typically reinvests its investment profits back into the fund, rather than distributing them to shareholders. This reinvestment strategy aims to enhance the fund&apos;s value over time, providing potential for capital growth.</skos:definition>
        <skos:prefLabel>Reinvestment Fund</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xiZlU9FV7hpv5tDKrbnFm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xiZlU9FV7hpv5tDKrbnFm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8HQFWxgtCe3eNwvBbsVg7v"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Export Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Export Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Exportklauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de cláusula de exportación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de cláusula de exportación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de exportação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de clause d&apos;exportation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף יצוא</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्यात शर्त दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">出口条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">輸出条項請求</skos:altLabel>
        <skos:definition>An Export Clause claim is a legal argument asserting that a law or government action violates the Export Clause of the United States Constitution, which prohibits states from imposing excessive burdens or discriminatory measures on interstate or international trade and commerce, thereby interfering with the free flow of goods and services across borders</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xjtdjCK8LoDNrx5EwqIJa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xjtdjCK8LoDNrx5EwqIJa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Data Security Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de sécurité des données</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de segurança de dados</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de seguridad de datos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de seguridad de datos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Data Security Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Datensicherheitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אבטחת מידע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डेटा सुरक्षा अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">データセキュリティ条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">数据安全条款</skos:altLabel>
        <skos:definition>A Data Security Clause is a provision in a contract that outlines the measures and responsibilities for protecting sensitive information from unauthorized access, use, disclosure, modification, or destruction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xjyYlLUGcj13HDSJFndDD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xjyYlLUGcj13HDSJFndDD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC8gGTL4dazXLDWuElLZLjI"/>
        <rdfs:isDefinedBy rdf:resource="https://www.americanbar.org/groups/dispute_resolution/resources/DisputeResolutionProcesses/mini-trial/#:~:text=A%20mini%2Dtrial%20is%20a,authority%20to%20settle%20the%20dispute."/>
        <rdfs:label>ADR Mini-Trial Forum</rdfs:label>
        <skos:definition>An ADR Mini-Trial Forum is a specific type of Alternative Dispute Resolution (ADR) Forum where parties present their case to a panel of experts who then provide a non-binding evaluation of the dispute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xkC6Bs7ZPn190uzRkGFC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xkC6Bs7ZPn190uzRkGFC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
        <rdfs:label>Turnover of property by a custodian</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Cession de biens par un gardien</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Entrega de propiedad por un custodio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Entrega de propiedad por un custodio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Giro de propriedade por um guardião</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Turnover of property by a custodian</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vermögensumsatz durch einen Verwalter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">העברת נכסים על ידי אפקטיבי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एक कस्टोडियन द्वारा संपत्ति का वापसी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">托管人的财产周转</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">管理人による財産の回転</skos:altLabel>
        <skos:definition>The turnover of property by a custodian refers to the legal action taken to recover assets that were wrongfully transferred or held by a custodian, as part of an avoidance action claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xla5mpMCkDl1t6YAR0Eoh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xla5mpMCkDl1t6YAR0Eoh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7kUD6H5adQ83mCKuHjT5JD"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9L2shTy2cnDMS1sImF2PBy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
        <rdfs:label>Information Technology Risk</rdfs:label>
        <skos:definition>The threats and opportunities associated with an organization&apos;s capacity and sustainability of information technology, both the infrastructure and utilization of technological applications — including the potential for negative consequences arising from an organization&apos;s reliance on technology systems, infrastructure, and processes. This can result from technology failures, cyber attacks, data breaches, or inadequate IT management practices, potentially leading to operational disruptions, financial losses, reputational damage, or legal liabilities, ultimately impacting the organization&apos;s overall performance and competitiveness.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xmPX9pj9KdiRWgSiw76Ys -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xmPX9pj9KdiRWgSiw76Ys">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Effective Tangible Net Worth Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de valeur nette tangible effective</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Patrimonio Neto Tangible Efectivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Patrimonio Neto Tangible Efectivo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Patrimônio Líquido Tangível Efetivo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Effective Tangible Net Worth Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Effektive materielle Eigenkapitalklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ערך נטו מוחשי יעיל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रभावी वास्तविक नेट वर्थ क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">有効な有形純資産条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">有效有形净值条款</skos:altLabel>
        <skos:definition>An Effective Tangible Net Worth Clause is a provision in a contract that requires a party to maintain a certain level of tangible assets in relation to their liabilities, in order to ensure their financial stability and ability to fulfill their obligations under the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xpf80TbUte15aQuYy4a12 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xpf80TbUte15aQuYy4a12">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R80ZEN9QYz3ntT0V4OTWJ6D"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8i9ifFKGOUWKWVHDXvxgR1"/>
        <rdfs:label>Poultry</rdfs:label>
        <skos:altLabel>Domestic Fowl</skos:altLabel>
        <skos:altLabel>Domesticated Birds</skos:altLabel>
        <skos:altLabel>Farm Birds</skos:altLabel>
        <skos:definition>Poultry refers to domesticated birds raised primarily for their meat, eggs, and feathers. This category includes chickens, turkeys, ducks, and geese, and these birds are integral to agriculture, providing a significant source of protein and other products for human consumption.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xqVevh0JKSwX977TRIZQV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xqVevh0JKSwX977TRIZQV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVoyN9hN3m5gy3So01ZEZ8"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDhhApr0eDVle3F076WAVct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Loan</rdfs:label>
        <skos:altLabel xml:lang="de-de">Darlehen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Empréstimo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Loan</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Préstamo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Préstamo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Prêt</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הלוואה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ローン</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">贷款</skos:altLabel>
        <skos:definition>A transaction whereby property is lent or given to another on condition of return or, where the loan is of money, repayment. In a loan of money, the money lent becomes the property of the borrower during the period of the loan against an undertaking to return a sum of an equivalent amount either on demand or on a specified date or in accordance with an agreed schedule of repayments.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xqzcm2A0qK3UaLVIgtSft -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xqzcm2A0qK3UaLVIgtSft">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB8gtCBLdNnUSfnwwQZSVhG"/>
        <rdfs:label>Passport Issuing Country</rdfs:label>
        <skos:definition>Passport Issuing Country refers to the nation that issued an individual&apos;s passport. This information is a key element of the passport and is used to establish the individual&apos;s nationality and citizenship. It is important for identification, travel, and various legal and administrative purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xrNuVBQ2B3sD1PzbweIcr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xrNuVBQ2B3sD1PzbweIcr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8qItBwG2pRMFhUq1HQEMnb"/>
        <rdfs:label>Written Asynchronous Communication</rdfs:label>
        <skos:altLabel xml:lang="de-de">Asynchrone schriftliche Kommunikation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Communication écrite asynchrone</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Comunicación Asincrónica Escrita</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Comunicación Asincrónica Escrita</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Comunicação escrita assíncrona</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Written Asynchronous Communication</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקשורת אסינכרונית כתובה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लिखित असिंक्रोनस कम्यूनिकेशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">书面异步通信</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">書面による非同期コミュニケーション</skos:altLabel>
        <skos:definition>A communication that occurs in writing and does not require that the users be synchronous (communicating at the same time).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xvhTRvZsOK7xYmQh6eEKG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xvhTRvZsOK7xYmQh6eEKG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t29mcCgDnprofEh5VP2LX"/>
        <rdfs:label>Timing of Acquisition Proposal Closing</rdfs:label>
        <skos:altLabel xml:lang="es-es">Momento de cierre de la propuesta de adquisición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Momento de cierre de la propuesta de adquisición</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tempo de fechamento da proposta de aquisição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Timing de la clôture de la proposition d&apos;acquisition</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Timing of Acquisition Proposal Closing</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeitpunkt des Abschlusses des Akquisitionsvorschlags</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זמן סגירת הצעת רכישה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिग्रहण प्रस्ताव बंद करने का समय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">收购提案截止时间</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買収提案の締め切り時期</skos:altLabel>
        <skos:definition>The Timing of Acquisition Proposal Closing refers to the specific period during which a proposal for acquisition must be closed, as determined by the Tail Period Fee Triggers, and includes the conditions of being signed, closed, not opposed, or approved during that period.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7y4MfRVjPqdQsxJpyGbD67 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7y4MfRVjPqdQsxJpyGbD67">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
        <rdfs:label>Fee Simple Absolute</rdfs:label>
        <skos:altLabel>Freehold Estate</skos:altLabel>
        <skos:definition>Fee Simple Absolute is the highest form of ownership interest one can acquire in real estate, granting the holder complete and unrestricted rights to the property. This ownership is inheritable and free of any conditions or limitations beyond standard government-imposed restrictions like zoning and taxes</skos:definition>
        <skos:prefLabel>Freehold Interest</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yCEY6OSN7ESR5xoGbpsqr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yCEY6OSN7ESR5xoGbpsqr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Georgia Eastern Cherokee</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yFvjE3c7XNyrKkiFPHUUs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yFvjE3c7XNyrKkiFPHUUs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDp8cEr3KYyVDenm1P9ejdx"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Negligence of Notary Public &amp; Sureties</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fahrlässigkeit des Notars und der Bürgen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligence of Notary Public &amp; Sureties</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia del Notario Público y los Fiadores</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia del Notario Público y los Fiadores</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência do notário e dos fiadores</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence du notaire et des cautions</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת הזהות של הנוטריון הציבורי והערבים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नोटरी पब्लिक और सुरेटी की लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公証人および保証人の過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公证人和保证人的疏忽</skos:altLabel>
        <skos:definition>The failure of a notary public and their guarantors to exercise reasonable care and diligence in performing their duties, resulting in harm or loss to a party involved in a real estate transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yGKmHfKLvmiQ41HwpVeQ7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yGKmHfKLvmiQ41HwpVeQ7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFED426F2C97b94Fa28DA94e"/>
        <rdfs:label>Delaware Industrial Accident Board</rdfs:label>
        <skos:definition>The Delaware Industrial Accident Board is a specialized court within the Delaware State Courts system that handles cases related to workplace injuries and accidents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yIjNsOTcwKyqxQ7elA7rC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yIjNsOTcwKyqxQ7elA7rC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED: Litigation Engagement Scope</rdfs:label>
        <skos:definition>DEPRECATED: Litigation Engagement Scope refers to the scope of work and services provided by a law firm to a client in a litigation matter, including the tasks and responsibilities of the law firm and the expected outcomes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yKB3SkQ5bQZsUOV5R0jT1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yKB3SkQ5bQZsUOV5R0jT1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4DhauAKgAkWtnyFXhCePi"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Stolen Property Offenses</rdfs:label>
        <skos:altLabel xml:lang="es-es">Delitos de propiedad robada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Delitos de propiedad robada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Diebstahl von Eigentum</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Infractions liées aux biens volés</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ofensas de propriedade roubada</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stolen Property Offenses</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עבירות רכוש גנוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चोरी की संपत्ति के अपराध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">盗品犯罪</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">盗窃财物罪</skos:altLabel>
        <skos:definition>Receiving, buying, selling, possessing, concealing, or transporting any property with the knowledge that it has been unlawfully taken, as by Burglary, Embezzlement, Fraud, Larceny, Robbery, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yQYf6cDb3K2dwaEPoftwf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yQYf6cDb3K2dwaEPoftwf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Tlingit</rdfs:label>
        <skos:definition>A Native American language spoken by the Tlingit people of Alaska and Canada, characterized by its complex grammar and extensive use of consonant clusters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yQfCOV7FKR5X31pCjWI5J -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yQfCOV7FKR5X31pCjWI5J">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCuus493FlHkCuRCdg8eDmC"/>
        <rdfs:label>Simple Procedure</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einfaches Verfahren</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Procedimento simples</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Procedimiento simplificado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Procedimiento simplificado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Procédure simplifiée</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Simple Procedure</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הליך פשוט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सरल प्रक्रिया</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">简易程序</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">簡易手続き</skos:altLabel>
        <skos:definition>Defendant is not required to tell the plaintiff of dangers of a simple procedure where it is commonly understood the dangers are not likely to occur.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ySw3Q2ZOiM5J4f8o0nRKK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ySw3Q2ZOiM5J4f8o0nRKK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCijZPAaPw0lgYwtl8qWG67"/>
        <rdfs:label>Service Sales Practice</rdfs:label>
        <skos:altLabel>Service Sales</skos:altLabel>
        <skos:altLabel>Service Sales Service</skos:altLabel>
        <skos:altLabel>Service Agreement Practice</skos:altLabel>
        <skos:definition>Services sales practice is the area of law focused on the legal aspects and agreements related to the sale and provision of services, rather than assets. This practice encompasses contract formation, regulatory compliance, liability issues, and the protection of intellectual property related to service transactions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yULiuUW6FwlVvfIPt13We -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7yULiuUW6FwlVvfIPt13We">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG"/>
        <rdfs:label>Receivership Creation</rdfs:label>
        <skos:altLabel>Appointment Of Receiver</skos:altLabel>
        <skos:altLabel>Receiver Establishment</skos:altLabel>
        <skos:altLabel>Receivership Appointment</skos:altLabel>
        <skos:definition>Receivership creation refers to the judicial appointment of a receiver to take control of and manage a company&apos;s assets during financial distress or litigation. This process aims to protect and preserve the assets while a resolution is sought, often leading to restructuring, liquidation, or sale.</skos:definition>
    </owl:Class>
    


