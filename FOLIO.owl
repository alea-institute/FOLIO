        <rdfs:label>Regulatory Taking Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Entschädigungsklage wegen Regulierungseingriffen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por expropiación regulatoria</skos:altLabel>
