        <rdfs:label>Non-current Law</rdfs:label>
        <skos:altLabel>Bad Law</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit non courant</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei não vigente</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nicht-aktuelles Recht</skos:altLabel>
        <skos:altLabel>Obsolete Law</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非现行法律</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">非現行法</skos:altLabel>
        <skos:definition>The previously effective law currently appears to have no legal efficacy, having been displaced (e.g., overruled, reversed, vacated, superseded).</skos:definition>
        <skos:prefLabel>Citator - Red Flag</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7g2Hh9C5epfhbWgjHrpbNQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7g2Hh9C5epfhbWgjHrpbNQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ZlXt0J1JMbXm6T0xEg2SO"/>
        <rdfs:label>Normal Rate Dividend Payment</rdfs:label>
        <skos:definition>Normal Rate Income refers to a type of dividend income where shareholders receive the same dividends as common or ordinary shareholders but have additional privileges, such as preferential treatment in the distribution of assets upon the company&apos;s dissolution. These shareholders benefit from regular dividend payments while retaining certain priority rights in specific circumstances.</skos:definition>
    </owl:Class>
    


