        <skos:altLabel xml:lang="de-de">Wettbewerbsrecht - Ansprüche auf gebündelte Preisgestaltung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות מחירים מאוגדים</skos:altLabel>
