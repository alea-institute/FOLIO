    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qgJwhdyqvE8u175RN80fT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qgJwhdyqvE8u175RN80fT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCRVBAzI4EaLARuVLhgDBTB"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RgHUj7ZKoJL0s6JURcX8OI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Reprieve</rdfs:label>
        <skos:definition>A reprieve is a temporary delay or suspension of a punishment or sentence, especially in the context of the death penalty. It serves as a postponement of the execution of a sentence, often to allow the defendant more time to seek a new trial, appeal, or another form of relief. However, a reprieve does not change the underlying conviction or sentence; it only delays its enforcement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qhPJtO8qtuoWinPbe4ZNK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qhPJtO8qtuoWinPbe4ZNK">
