        <skos:altLabel xml:lang="es-mx">Anders Brief</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Anders-Brief</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Memorial Anders</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mémoire Anders</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנדרס בריף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एंडर्स ब्रीफ</skos:altLabel>
