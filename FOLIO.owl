        <rdfs:label>Corporate Meeting Management</rdfs:label>
        <skos:definition>Corporate Meeting Management refers to the process of organizing and managing meetings for corporations, including scheduling, logistics, and documentation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCwl2Flj2LauuaT4NBrdeaJ -->

