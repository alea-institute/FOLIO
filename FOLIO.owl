        <skos:altLabel xml:lang="fr-fr">Harcèlement civil</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Perseguição Civil</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zivilistisches Stalking</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ציד רגיל בפלילים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नागरिक स्टॉकिंग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">民事ストーキング</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民事骚扰</skos:altLabel>
