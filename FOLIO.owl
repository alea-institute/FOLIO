    <!-- https://folio.openlegalstandard.org/RwgJby1wc2ct10CJbrPH2i -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RwgJby1wc2ct10CJbrPH2i">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Import-Export Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Import-Export Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Import-Export-Klauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de cláusula de importación-exportación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de cláusula de importación-exportación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de importação-exportação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de clause d&apos;import-export</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף ייבוא-יצוא</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आयात-निर्यात शर्त दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">輸出入条項請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">进出口条款索赔</skos:altLabel>
        <skos:definition>An Import-Export Clause claim is a legal argument asserting that a law or government action violates the Import-Export Clause of the United States Constitution, which prohibits states from imposing taxes or regulations that discriminate against imports or exports, thus protecting the free flow of goods across state and national borders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RwiYr04MwuGhJnwApa5Oua -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RwiYr04MwuGhJnwApa5Oua">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo"/>
        <rdfs:label>Quasi-Public Governmental Body</rdfs:label>
        <skos:altLabel>GSE</skos:altLabel>
        <skos:definition>A Quasi-Public Governmental Body is an organization that has governmental functions but operates with some degree of independence from direct government control. These bodies often provide public services and may have regulatory authority, yet they typically function more like private enterprises.</skos:definition>
        <skos:example>Airport Authorities</skos:example>
        <skos:example>FINRA</skos:example>
        <skos:example>Fannie Mae</skos:example>
        <skos:example>Freddie Mac</skos:example>
        <skos:prefLabel>Government-Sponsored Enterprise</skos:prefLabel>
    </owl:Class>
    


