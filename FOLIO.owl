    <!-- https://folio.openlegalstandard.org/RDhTcHUNxUGDRmxL1iJYtw8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDhTcHUNxUGDRmxL1iJYtw8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Agoraphobia</rdfs:label>
        <skos:altLabel>Anxiety Disorder with Avoidance Behavior</skos:altLabel>
        <skos:altLabel>Fear of Crowded Places</skos:altLabel>
        <skos:altLabel>Fear of Open Spaces</skos:altLabel>
        <skos:definition>Agoraphobia is an anxiety disorder characterized by an intense fear of being in situations where escape might be difficult or help unavailable during a panic attack. This fear often leads to avoidance of a variety of situations, such as being outside alone, being in a crowd, or traveling in a vehicle, which can significantly impair daily functioning and social interactions.</skos:definition>
    </owl:Class>
    


