    <!-- https://folio.openlegalstandard.org/R8D6zCNSxUO8g0ZstLxnK28 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8D6zCNSxUO8g0ZstLxnK28">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq"/>
        <rdfs:label>Chronic Obstructive Pulmonary Disease</rdfs:label>
        <skos:altLabel>COPD</skos:altLabel>
        <skos:definition>Chronic Obstructive Pulmonary Disease (COPD) is a progressive respiratory condition characterized by persistent airflow limitation due to chronic inflammation of the airways and lung tissue. The most common forms of COPD are chronic bronchitis and emphysema, leading to symptoms such as chronic cough, breathlessness, and reduced lung function, necessitating ongoing management and treatment.</skos:definition>
        <skos:prefLabel>Chronic Respiratory Disease</skos:prefLabel>
    </owl:Class>
    


