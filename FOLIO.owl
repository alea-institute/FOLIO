            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>863 DIWC/DIWW (405(g)) (PACER NoS)</rdfs:label>
        <skos:altLabel>405(g</skos:altLabel>
        <skos:definition>Action filed with regard to social security benefits provided to disabled individuals: worker or child, or widow</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
        <rdfs:label>Debt Instrument Attributes</rdfs:label>
        <skos:definition>Debt Instrument Attributes refer to specific characteristics and features that define various aspects of debt instruments, such as bonds, loans, and other forms of borrowing. These attributes include terms related to pricing, structure, and type of debt, which impact the instrument’s value, risk, and marketability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UeM96MYe3xwWh4Q581ncP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9UeM96MYe3xwWh4Q581ncP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9CPJK9GY42oQZFTPL3DyA1"/>
        <rdfs:label>Michigan Circuit Court - Wayne Cty 3d Jud. Cir.</rdfs:label>
        <skos:definition>A court located in the third judicial circuit of Wayne County, Michigan, responsible for hearing civil and criminal cases within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Uhwom9TKZx0L9euy4pyZ8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Uhwom9TKZx0L9euy4pyZ8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwajUPdKVdK5tlwiUjmNzG"/>
        <rdfs:label>Just Compensation Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf gerechte Entschädigungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Just Compensation Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Compensación Justa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Compensación Justa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de compensação justa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de clause de juste indemnisation</skos:altLabel>
        <skos:altLabel>Takings Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף פיצוי הוגן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बस्तित्वाधिकार धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正な補償条項の請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公正补偿条款索赔</skos:altLabel>
        <skos:definition>A Just Compensation Clause claim is a legal assertion related to the Fifth Amendment of the United States Constitution, which states that private property cannot be taken for public use without just compensation. If the government takes private property for public use and the property owner believes they have not received fair market value or other appropriate compensation, they may file a Just Compensation Clause claim to seek additional compensation or challenge the taking.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UklGmubMZcbVTeGrZFSJx -->

