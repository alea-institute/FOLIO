        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Schizotypal Personality Disorder</rdfs:label>
        <skos:altLabel>Schizotypal Personality</skos:altLabel>
        <skos:definition>Schizotypal Personality Disorder is characterized by a pervasive pattern of eccentric behavior, cognitive distortions, and discomfort with close relationships. Individuals with this disorder may exhibit odd beliefs, unusual perceptual experiences, and suspiciousness or paranoia, alongside a marked preference for social isolation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkI43KINwzlJ3zEve2icFG -->

