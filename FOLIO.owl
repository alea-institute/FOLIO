    <!-- https://folio.openlegalstandard.org/R9VkHQ2TY9sCeZb1IcmHDLc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9VkHQ2TY9sCeZb1IcmHDLc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBtDyjzrPbQyhvU5V64Irn"/>
        <rdfs:label>Entity Formation Document</rdfs:label>
        <skos:definition>An Entity Formation Document is a legal document filed with a governmental authority, such as a state&apos;s Secretary of State, to officially establish a legal entity, such as a limited liability company (LLC), corporation, or limited partnership. It typically includes essential details like the entity&apos;s name, purpose, registered agent, and the names of its initial members, directors, or partners.</skos:definition>
    </owl:Class>
    


