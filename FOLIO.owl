        <skos:altLabel xml:lang="es-es">Reclamación de cláusula de selección de foro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de cláusula de selección de foro</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de seleção de foro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על סעיף בחירת פורום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फोरम चयन डिबेट दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フォーラム選択条項請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">论坛选择条款索赔</skos:altLabel>
        <skos:definition>A forum selection clause claim is a legal argument or plan that asserts a specific venue for resolving a dispute, and is supported by legal or other professional frameworks.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMCP90GVoL3dRBIj5FyYQl -->

