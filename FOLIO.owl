    <!-- https://folio.openlegalstandard.org/R7hBC2pePnUMRnaYOfOMsWc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7hBC2pePnUMRnaYOfOMsWc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RByl0iNSHBNmfLanOSBWLSx"/>
        <rdfs:label>Other Recurrent Use and Permission Tax Payment</rdfs:label>
        <skos:altLabel>Continuous License Tax Payment</skos:altLabel>
        <skos:altLabel>Other recurrent taxes</skos:altLabel>
        <skos:altLabel>Periodic License Fee Payment</skos:altLabel>
        <skos:altLabel>Professional License Tax Payment</skos:altLabel>
        <skos:altLabel>Recurring Business License Tax Payment</skos:altLabel>
        <skos:altLabel>Regular Permission Fee Payment</skos:altLabel>
        <skos:definition>Other Recurrent Use and Permission Tax Payment covers taxes levied on a recurring basis for business and professional licenses required to carry on particular types of businesses or professions. This includes licenses such as those for taxis and casinos, as well as dog licenses and recurrent general licenses for hunting, shooting, and fishing. Broadcast license fees are included when the payer cannot opt out from making payments for public broadcasting, even if they do not consume such services. Specific exemptions do not alter the compulsory nature of these payments.</skos:definition>
        <skos:example>Casino Tax</skos:example>
        <skos:example>Dog License Tax</skos:example>
        <skos:example>Fishing License Tax</skos:example>
        <skos:example>Hunting License Tax</skos:example>
        <skos:example>Shooting License Tax</skos:example>
        <skos:example>Taxi Tax</skos:example>
    </owl:Class>
    


