        <skos:altLabel xml:lang="es-mx">Cláusula de asignación de automóvil</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de asignación de coche</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fahrzeugkostenklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כספי לרכב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार भत्ता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">車両手当条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">车辆津贴条款</skos:altLabel>
        <skos:definition>A car allowance clause is a provision in a contract that provides for a specific amount of money to be paid to an employee for the use of their personal vehicle for work-related purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RmQmrqdwna293DNyilBdBW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RmQmrqdwna293DNyilBdBW">
