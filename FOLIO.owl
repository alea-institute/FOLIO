        <skos:altLabel xml:lang="he-il">זכות דואר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डाउर</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">嫁妆</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">持参</skos:altLabel>
        <skos:definition>A dower is a claim made by a widow to a portion of her deceased husband&apos;s estate, typically one-third, as a form of support and security.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9uoItz60Ut8I4l3jEH3mSF -->

