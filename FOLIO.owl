        <rdfs:label>DEPRECATED NODES</rdfs:label>
        <skos:definition>DEPRECATED NODES: A group of concepts within the ZZZ - SANDBOX: UNDER CONSTRUCTION parent class that have been replaced or are no longer in use.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8H9foK2FqmL2yHmJoYVtik -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8H9foK2FqmL2yHmJoYVtik">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqEOIQE7piF24rITlbKn6q"/>
        <rdfs:label>Book</rdfs:label>
        <skos:altLabel>Manuscript</skos:altLabel>
        <skos:altLabel>Tome</skos:altLabel>
        <skos:definition>A Book is a substantial written or printed work typically covering a specific subject or narrative. Books can be in many formats, both paper and electronic.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8H9mw1xu0sYmrwbdIVo92A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8H9mw1xu0sYmrwbdIVo92A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1"/>
        <rdfs:label>Brillhart-Wilton Abstention</rdfs:label>
        <skos:altLabel xml:lang="es-es">Abstención de Brillhart-Wilton</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Abstención de Brillhart-Wilton</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Abstention de Brillhart-Wilton</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Abstenção de Brillhart-Wilton</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Brillhart-Wilton Abstention</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Brillhart-Wilton-Abstinenz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התמנות ברילהרט-ווילטון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ब्रिलहार्ट-विल्टन अवहेलना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ブリルハート・ウィルトン棄権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">布里尔哈特-威尔顿回避原则</skos:altLabel>
        <skos:definition>A legal doctrine known as Brillhart-Wilton Abstention, which falls under the category of abstention doctrines, allows a federal court to abstain from hearing a case that involves complex state law issues that are better suited for resolution in state court.</skos:definition>
    </owl:Class>
    


