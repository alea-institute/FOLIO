        <dc:identifier>US-FD-CPSC</dc:identifier>
        <rdfs:label>U.S. Consumer Product Safety Commission</rdfs:label>
        <skos:altLabel xml:lang="es-es">Comisión de Seguridad de Productos de Consumo de EE. UU.</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Comisión de Seguridad de Productos de Consumo de EE. UU.</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Comissão de Segurança de Produtos de Consumo dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Commission américaine de sécurité des produits de consommation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">U.S. Consumer Product Safety Commission</skos:altLabel>
        <skos:altLabel xml:lang="de-de">US-amerikanische Kommission für Produktsicherheit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוועד לבטיחות מוצרי הצרכן של ארצות הברית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूएस उपभोक्ता उत्पाद सुरक्षा आयोग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">米国消費者製品安全委員会</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">美国消费品安全委员会</skos:altLabel>
        <skos:definition>The United States Consumer Product Safety Commission (CPSC or Commission) is an independent agency of the United States government that seeks to promote the safety of consumer products by addressing &quot;unreasonable risks&quot; of injury (through coordinating recalls, evaluating products that are the subject of consumer complaints or industry reports, etc.); developing uniform safety standards (some mandatory, some through a voluntary standards process); and conducting research into product-related illness and injury.</skos:definition>
        <skos:hiddenLabel>CPSC</skos:hiddenLabel>
        <skos:prefLabel>Consumer Product Safety Commission</skos:prefLabel>
    </owl:Class>
    


