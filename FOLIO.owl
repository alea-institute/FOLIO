        <rdfs:label>Medical Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle médicale</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Medical Negligence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia Médica</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia Médica</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ärztliche Kunstfehler</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה רפואית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चिकित्सा लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">医疗事故责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">医療過誤</skos:altLabel>
        <skos:definition>Medical Malpractice: Negligence or breach of duty by a healthcare professional that results in harm or injury to a patient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aujIepeuFUyfMEjLBqYza -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aujIepeuFUyfMEjLBqYza">
