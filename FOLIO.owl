        <skos:altLabel xml:lang="pt-br">Petição para Certificação da Classe</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en certification de la classe</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאישור המחלקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वर्ग को सत्यापित करने के लिए मोशन</skos:altLabel>
