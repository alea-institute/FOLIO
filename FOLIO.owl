    <!-- https://folio.openlegalstandard.org/RD3AsL6dIQwlCnaA8Rezj3B -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RD3AsL6dIQwlCnaA8Rezj3B">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKj3panTdxsJ7nFn11CPGT"/>
        <rdfs:label>Excessive Bail Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf unangemessen hohe Kaution</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Excessive Bail Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de fianza excesiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de fianza excesiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de fiança excessiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de caution excessive</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת ערבות מופקרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अत्यधिक जमानत दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过度保释要求</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">過剰保釈請求</skos:altLabel>
        <skos:definition>An excessive bail claim is a legal action initiated by an individual alleging that their Eighth Amendment right to be free from excessive bail has been violated by the government or a government actor. The Eighth Amendment prohibits the government from imposing excessive bail, which is a monetary sum set by a court to ensure that an individual shows up for trial or other legal proceedings. An excessive bail claim may arise in various contexts, such as when a court sets an unreasonably high bail amount that is beyond the individual&apos;s ability to pay, or when a court sets bail at a level that is disproportionate to the offense committed.</skos:definition>
    </owl:Class>
    


