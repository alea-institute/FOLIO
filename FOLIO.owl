            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>UTBMS Litigation</rdfs:label>
        <skos:definition>UTBMS Litigation refers to the standardized codes used to categorize legal activities and expenses related to the litigation process, including discovery, pre-trial pleadings and motions, trial preparation and trial, and appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QK5HHpHaMbIsluZWCxJCB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8QK5HHpHaMbIsluZWCxJCB">
