        <skos:altLabel xml:lang="de-de">Transkripte und Aufnahmen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תמלילים והקלטות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रांसक्रिप्ट और रिकॉर्डिंग्स</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">文字记录和录音</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">記録と録音</skos:altLabel>
        <skos:definition>Transcripts and Recordings are documents that contain a verbatim or recorded account of legal proceedings, including depositions, witness statements, and trial transcripts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCn46eIc5j39dfkp4HLA5jB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCn46eIc5j39dfkp4HLA5jB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
        <rdfs:label>INVOICE_TAX_CURRENCY</rdfs:label>
        <skos:definition>A standardized format for invoices that includes information on taxes and currency, as defined by the LEDES98BI V5 Format Rev 1-2020.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCn4N8uYzSo6xnYwLKQUFrk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCn4N8uYzSo6xnYwLKQUFrk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9YxIkGNEnotiOtItG96PxY"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/RB9WPZAmqztZGzX1qXk6gXv"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R1Nqf5L2i7dYyR9DA5fcvo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Response to Request for Proposal</rdfs:label>
        <skos:altLabel>Bid Response</skos:altLabel>
        <skos:altLabel>Tender Response</skos:altLabel>
        <skos:definition>A Response to a Request for Proposal (RFP) is a formal document submitted by a prospective vendor or service provider, outlining how they will meet the requirements specified in the RFP. It typically includes the proposed solution, costs, timelines, and qualifications of the responding party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCn4fp0HBzIn3hNiysCN3TV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCn4fp0HBzIn3hNiysCN3TV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R71ioUDFC2H7Ndh54CU1rlM"/>
        <rdfs:label>Florida County Court - Liberty County</rdfs:label>
        <skos:definition>Florida County Court - Liberty County: A court of limited jurisdiction in Florida that handles civil and criminal cases within the geographical boundaries of Liberty County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCn8WOWcXNa9jnjY9QOJFKw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCn8WOWcXNa9jnjY9QOJFKw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSwOCeFhWxUA3fOiTvlja4"/>
        <rdfs:label>Unemployment Payments</rdfs:label>
        <skos:altLabel>Jobless Benefits</skos:altLabel>
        <skos:altLabel>Unemployment Compensation</skos:altLabel>
        <skos:altLabel>Unemployment Insurance Benefits</skos:altLabel>
        <skos:altLabel>Unemployment Insurance Payments</skos:altLabel>
        <skos:definition>Unemployment Payments are financial benefits provided by the government to individuals who are temporarily out of work and meet certain eligibility requirements. These payments aim to provide temporary financial assistance to help cover living expenses while individuals search for new employment.</skos:definition>
        <skos:prefLabel>Unemployment Income</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCn9LUvz0qRZZwYVwFfUzEm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCn9LUvz0qRZZwYVwFfUzEm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMZqt2BD3qRRYlj61ssnIZ"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Open_list"/>
        <rdfs:label>Party-List Proportional Representation System - Open List</rdfs:label>
        <skos:altLabel>Voter-Determined List System</skos:altLabel>
        <skos:definition>An Open List Party-List Proportional Representation System allows voters to influence the order of candidates on a party&apos;s list by indicating their preference for specific candidates. The number of seats each party wins is determined by the proportion of votes received, and candidates are selected based on their popularity within the party list.</skos:definition>
        <skos:example>Local Open List: Switzerland&apos;s National Council elections</skos:example>
        <skos:example>National Open List: Finland&apos;s Eduskunta elections</skos:example>
        <skos:example>Regional Open List: Sweden&apos;s Riksdag elections</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCnArbN2IpjDOqHB342pOXB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCnArbN2IpjDOqHB342pOXB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Bislama</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bislama</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Bislama</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Bislama</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ビスラマ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">比斯拉马语</skos:altLabel>
        <skos:definition>Bislama is a structured system of communication consisting of grammar and vocabulary, used in legal matters as a language of a document, artifact, evidence, testimony, proceeding, or any other legal aspect.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCnBMtje8T0YKSuODD0evsV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCnBMtje8T0YKSuODD0evsV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Sole Discretion Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de discrétion exclusive</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Discrição Exclusiva</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de discreción exclusiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de discreción exclusiva</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur alleinigen Entscheidungsbefugnis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sole Discretion Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שיקול דעת בלעדי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एकल विवेक अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">単独裁量条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">唯一决定条款</skos:altLabel>
        <skos:definition>A Sole Discretion Clause is a contractual provision that grants one party the exclusive right to make a decision or take an action without the need for justification or approval from the other party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_08"/>
        <rdfs:label>Personality and Impulse-Control Disorders</rdfs:label>
        <skos:altLabel>Impulse-Control Disorders</skos:altLabel>
        <skos:definition>These disorders are characterized by enduring, inflexible, maladaptive, and pervasive patterns of behavior. Onset typically occurs in adolescence or young adulthood. Symptoms and signs may include, but are not limited to, patterns of distrust, suspiciousness, and odd beliefs; social detachment, discomfort, or avoidance; hypersensitivity to negative evaluation; an excessive need to be taken care of; difficulty making independent decisions; a preoccupation with orderliness, perfectionism, and control; and inappropriate, intense, impulsive anger and behavioral expression grossly out of proportion to any external provocation or psychosocial stressors</skos:definition>
        <skos:prefLabel>Personality Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCnHoyKfzwNJAYH34rE0B8D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCnHoyKfzwNJAYH34rE0B8D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu"/>
        <rdfs:label>Arab League</rdfs:label>
        <skos:definition>Arab League: A regional organization of Arab countries in and around North Africa, the Horn of Africa, and Arabia, formed to strengthen ties among member states, coordinate their policies, and promote their common interests.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCnLkZp9RPMT0ckkWepnov2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCnLkZp9RPMT0ckkWepnov2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDw3C0Q9SA9H8y85Zz4cMvz"/>
        <rdfs:label>Earnings Before Interest, Taxes, Depreciation, and Amortization</rdfs:label>
        <skos:altLabel>EBITDA</skos:altLabel>
        <skos:definition>Earnings Before Interest, Taxes, Depreciation, and Amortization (EBITDA) is a financial metric used to assess a company&apos;s operational performance. It is calculated by subtracting cost of goods sold and operating expenses from revenue, but before accounting for interest, taxes, depreciation, and amortization. EBITDA is commonly used for company valuation and comparisons, providing a snapshot of a company&apos;s profitability from its core operations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCnT6mtIS5PFqLHFn37D1cS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCnT6mtIS5PFqLHFn37D1cS">
