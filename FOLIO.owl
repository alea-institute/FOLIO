        <dc:identifier>CRIM-CYBR</dc:identifier>
        <rdfs:label>Cybercrime Law</rdfs:label>
        <skos:altLabel>Cybercrime</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cybercrime Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Cyberkriminalitätsgesetz</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei de crimes cibernéticos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ley de Cibercrimen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Ciberdelitos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Loi sur la cybercriminalité</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק פשעי סייבר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साइबर अपराध कानून</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サイバー犯罪法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">网络犯罪法</skos:altLabel>
        <skos:definition>Crimes committed using a computer or directed at computers, data, or other information technology - piracy, hacking, etc.</skos:definition>
        <skos:hiddenLabel>CYBR</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeXAZJ8y359CuicTAz65GY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeXAZJ8y359CuicTAz65GY">
