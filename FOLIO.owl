        <rdfs:label>Motion for Leave to File as Amicus</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Zulassung als Amicus Curiae</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para presentarse como Amicus</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para presentarse como Amicus</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Leave to File as Amicus</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Intervenção como Amicus Curiae</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en autorisation de déposer un mémoire d&apos;amicus curiae</skos:altLabel>
