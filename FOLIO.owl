        <skos:altLabel>Phobia</skos:altLabel>
        <skos:altLabel>Terror</skos:altLabel>
        <skos:definition>Fear is an emotion experienced in anticipation of some specific pain or danger, usually accompanied by a desire to flee or fight.</skos:definition>
    </owl:Class>
    


