        <skos:altLabel xml:lang="de-de">Büro für Bürgerrechte - Bildungsministerium</skos:altLabel>
        <skos:altLabel>ED</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escritório de Direitos Civis - Departamento de Educação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Office for Civil Rights - Department of Education</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Derechos Civiles - Departamento de Educación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina de Derechos Civiles - Departamento de Educación</skos:altLabel>
