        <rdfs:label>United Cherokee Ani-Yun-Wiya Nation</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBq67HJOHkfI3KZNpYvJm3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBq67HJOHkfI3KZNpYvJm3">
