        <rdfs:label>Missouri Circuit Court - Gentry County</rdfs:label>
        <skos:definition>A Missouri Circuit Court in Gentry County is a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Gentry County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfEU8knfMhgMdtzlQOMm4n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfEU8knfMhgMdtzlQOMm4n">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8QJDc8SCwsfsJARkyevIJ0"/>
        <rdfs:label>A100 Activities</rdfs:label>
        <skos:definition>A100 Activities refer to the specific tasks involved in the UTBMS Litigation code set, including communicating with clients and outside counsel, managing data and files, conducting research, drafting and revising documents, and appearing for/attending hearings or meetings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfPKcyAwOrC1M6ZhHEpwAx -->

