        <skos:altLabel xml:lang="de-de">Kündigung wegen Verstoß gegen Regeln</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Licenciement pour violation des règles</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים עקב הפרת חוקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नियमों का उल्लंघन के लिए निलंबन</skos:altLabel>
