        <rdfs:label>Tokelau</rdfs:label>
        <skos:definition>A language spoken in Tokelau, a territory of New Zealand, which is a member of the Polynesian language family.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRWBaLpGSGCdJyGv2Bc1Xd -->

