        <dc:identifier>INF-TELE</dc:identifier>
        <rdfs:label>Telecommunications Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de las Telecomunicaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de las Telecomunicaciones</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des télécommunications</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de telecomunicações</skos:altLabel>
        <skos:altLabel>Telecommunications</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Telecommunications Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Telekommunikationsbranche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית הטלקומוניקציות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दूरसंचार उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">电信行业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">通信産業</skos:altLabel>
        <skos:definition>Industries in this group provide telecommunications and the services related to that activity (e.g., telephony, including Voice over Internet Protocol (VoIP); cable and satellite television distribution services; Internet access; telecommunications reselling services). The group is primarily engaged in operating, and/or providing access to facilities for the transmission of voice, data, text, sound, and video.</skos:definition>
        <skos:hiddenLabel>TELE</skos:hiddenLabel>
    </owl:Class>
    


