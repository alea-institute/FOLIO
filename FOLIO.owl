        <rdfs:label>Information Governance Management</rdfs:label>
        <skos:definition>Information Governance Management refers to the process of managing and controlling an organization&apos;s information assets in a way that aligns with legal and regulatory requirements, as well as business objectives.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R97JuqM8SotChE9RBRLPfcn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R97JuqM8SotChE9RBRLPfcn">
