        <rdfs:label>Attornment Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Attornment Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;attornment</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de reconocimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de reconocimiento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de submissão</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zustimmungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הכרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अटॉर्नमेंट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">承諾条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">转让条款</skos:altLabel>
        <skos:definition>An attornment clause is a provision in a contract that requires a tenant to recognize a new landlord as the rightful owner of the property.</skos:definition>
    </owl:Class>
    


