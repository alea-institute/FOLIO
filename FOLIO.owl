    <!-- https://folio.openlegalstandard.org/RCzD82dQgANaiGfk432H8EK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCzD82dQgANaiGfk432H8EK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_21"/>
        <rdfs:label>Kidney Cancer</rdfs:label>
        <skos:altLabel>Nephric Cancer</skos:altLabel>
        <skos:altLabel>Renal Cancer</skos:altLabel>
        <skos:altLabel>Renal Cell Carcinoma</skos:altLabel>
        <skos:definition>Kidney cancer is a type of cancer that originates in the kidneys, the two bean-shaped organs responsible for filtering blood and producing urine. The most common type is renal cell carcinoma, and treatments often include surgery, targeted therapy, immunotherapy, and, in some cases, radiation therapy.</skos:definition>
        <skos:prefLabel>Kidney, Adrenal Gland, or Ureter Cancer</skos:prefLabel>
    </owl:Class>
    


