        <skos:altLabel xml:lang="pt-br">Testamento vital</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צו חיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जीवित इच्छापत्र</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">生前遗嘱</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">生前遺言書</skos:altLabel>
        <skos:definition>A Living Will is a legal document that allows an individual to express their wishes regarding medical treatment in the event they become incapacitated and unable to communicate those wishes themselves.</skos:definition>
    </owl:Class>
    


