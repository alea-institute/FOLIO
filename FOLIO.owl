        <skos:altLabel xml:lang="pt-br">Cláusula de Propriedade do Produto do Trabalho</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de propiedad del producto de trabajo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de propiedad del producto de trabajo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Eigentumsübertragung von Arbeitsergebnissen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Work Product Ownership Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף בעלות על מוצר עבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वर्क प्रोडक्ट स्वामित्व शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">作業成果所有権条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工作成果所有权条款</skos:altLabel>
        <skos:definition>A Work Product Ownership Clause is a provision in a contract that specifies the ownership rights of the work product created under the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NgQgBrQtQicNGf4IaEkTa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NgQgBrQtQicNGf4IaEkTa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7OGr396bNkl4sseQ1bBCA6"/>
        <rdfs:label>Common Law Lien</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Common Law Lien</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gemeine Pfandrecht</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gravamen de derecho común</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gravamen de derecho común</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Penhor comum da common law</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège commun de la common law</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משכון דין רגיל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य कानून लियन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コモン・ロー・リーン</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">普通法留置权</skos:altLabel>
        <skos:definition>A Common Law Lien is a type of lien that arises from the common law rather than from a statute, and allows a creditor to retain possession of a debtor&apos;s property until the debt is paid.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NhmHvt8LqUHj6HTQwDgAL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NhmHvt8LqUHj6HTQwDgAL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Clarion County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Clarion County is a specific court within the Pennsylvania Magisterial District Court system that handles minor criminal offenses, traffic violations, and civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NkyPiBO4cDYNheqxFYHqF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NkyPiBO4cDYNheqxFYHqF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UZkDXz7Wg2AtyHFQEeySC"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8vAEBB4vqpklciwq0MiMSa"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <rdfs:label>Freedom of Association</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Vereinigungsfreiheit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Freedom of Association Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de libertad de asociación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de libertad de asociación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da liberdade de associação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la liberté d&apos;association</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת חופש הקישור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संघर्ष की स्वतंत्रता दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">結社の自由の主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">结社自由权利主张</skos:altLabel>
        <skos:definition>A freedom of association claim is a legal action initiated by an individual or group alleging that their right to freedom of association, as protected by the First Amendment of the United States Constitution, has been violated by the government or a government actor. The First Amendment guarantees the right to associate with others for the expression of ideas, beliefs, and collective action, including the right to form and join groups and organizations. A freedom of association claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts the right to associate or form organizations, when a government actor interferes with the right to join or participate in a group or organization, or when an individual or group is discriminated against or punished based on their association with a particular group or organization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Nlu1VORhFmeFKM5x3yYHB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Nlu1VORhFmeFKM5x3yYHB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Worth County</rdfs:label>
        <skos:definition>Georgia Superior Court - Worth County: A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Worth County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NvVLe26lWZXxjXVtX1uuU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NvVLe26lWZXxjXVtX1uuU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
        <rdfs:label>False Arrest and Imprisonment</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Arrestation et emprisonnement injustifiés</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Detención y encarcelamiento ilegal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Detención y encarcelamiento ilegal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Falsche Verhaftung und Freiheitsberaubung</skos:altLabel>
        <skos:altLabel>False Arrest</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">False Arrest and Imprisonment</skos:altLabel>
        <skos:altLabel>False Imprisonment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prisão e detenção ilegais</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עצירה ומעצר שוים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गलत गिरफ्तार और कैद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不当逮捕および拘禁</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">错误逮捕和监禁</skos:altLabel>
        <skos:definition>The concept of False Arrest and Imprisonment refers to the unlawful detention or confinement of an individual without legal justification or consent, resulting in a violation of their personal liberty and freedom of movement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NvsufkQHORQ3VcXpa3Cm2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NvsufkQHORQ3VcXpa3Cm2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RouKBMqFNMZxi21EPh6JJ6"/>
        <rdfs:label>Lost Profits Damages</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Danos de lucros cessantes</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Daños por pérdida de beneficios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Daños por pérdida de ganancias</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Entgangener Gewinn</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lost Profits Damages</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pertes de profits</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגיעה ברווחים אבודים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हानि उत्पाद क्षतिपूर्ति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">失われた利益の損害</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">失去利润损失</skos:altLabel>
        <skos:definition>Lost Profits Damages refer to the financial harm suffered by a party as a result of a breach of contract or other wrongful act, where the damages are calculated based on the profits that the party would have earned if the breach or wrongful act had not occurred.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NwI4yCwegzAreujm0aAiN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NwI4yCwegzAreujm0aAiN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
