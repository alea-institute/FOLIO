    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDvUGgl6XjksYTzpRcEcGz2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDvUGgl6XjksYTzpRcEcGz2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RYqnzVgHfUjot8PC4mJs0G"/>
        <rdfs:label>Negative Advertisement</rdfs:label>
        <skos:altLabel>Attack Ad</skos:altLabel>
        <skos:altLabel>Disparaging Advertisement</skos:altLabel>
        <skos:altLabel>Negative Campaign Ad</skos:altLabel>
        <skos:altLabel>Oppositional Ad</skos:altLabel>
        <skos:definition>A Negative Advertisement is a type of advertising that focuses on criticizing or discrediting a competitor, individual, or opposing viewpoint rather than promoting the advertiser&apos;s own product or message. These advertisements are often used in political campaigns and competitive business markets to highlight perceived flaws, mistakes, or negative attributes of the target.</skos:definition>
        <skos:prefLabel>Critical Advertisement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDvVBJAIjWJ6V7k3Hor0WSN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDvVBJAIjWJ6V7k3Hor0WSN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBt449Gy4YQBuVqNLxE7Gg"/>
        <rdfs:label>Governmental Civil Law Division</rdfs:label>
        <skos:altLabel>Civil Legal Affairs Division</skos:altLabel>
        <skos:altLabel>Government Civil Legal Department</skos:altLabel>
        <skos:altLabel>Public Civil Law Office</skos:altLabel>
        <skos:definition>A Governmental Civil Law Division is a governmental entity that handles civil legal matters involving the government. It provides legal advice to government agencies, represents the government in civil litigation, and ensures compliance with civil laws and regulations.</skos:definition>
        <skos:example>City Civil Law Division</skos:example>
        <skos:example>Civil Litigation Unit</skos:example>
        <skos:example>County Civil Law Office</skos:example>
        <skos:example>Federal Civil Litigation Unit</skos:example>
        <skos:example>State Civil Law Division</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDvY0TcDt3VYHZiiDhPUh38 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDvY0TcDt3VYHZiiDhPUh38">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Consideration Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de contrepartie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de contraprestación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de contraprestación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de contraprestação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Consideration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenleistungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף התחשבנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विचार क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">对价条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">対価条項</skos:altLabel>
        <skos:definition>A consideration clause is a provision in a contract that outlines the exchange of something of value between parties, which is necessary for the contract to be legally binding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDvd595QjUByS6fw9LeWBTA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDvd595QjUByS6fw9LeWBTA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RMo0rWec8owXGDAYl6PGNG"/>
        <rdfs:label>Tenancy in Common</rdfs:label>
        <skos:definition>Tenancy in Common is a form of concurrent property ownership where multiple individuals hold separate and undivided interests in the same property. Each tenant in common has the right to sell, transfer, or bequeath their individual share without the consent of the other co-owners, and upon death, their interest passes to their heirs rather than the remaining co-owners.</skos:definition>
    </owl:Class>
    


