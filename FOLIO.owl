    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfYaEPtCAVEbeQxgFszQIc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfYaEPtCAVEbeQxgFszQIc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Non Circumvention Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-contournement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de no elusión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no elusión</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não contorno</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Vermeidung von Umgehungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Non Circumvention Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוראת חסימת עסקאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गोलमाल नहीं करने की शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">回避禁止条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非规避条款</skos:altLabel>
        <skos:definition>A Non Circumvention Clause is a provision in a contract that prohibits the parties from bypassing each other and making direct contact or doing business with each other&apos;s contacts or associates.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfZA58JH88QrVPUBjsLg9j -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfZA58JH88QrVPUBjsLg9j">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4"/>
        <dc:source>International Bill of Human Rights</dc:source>
        <rdfs:label>Right to Liberty</rdfs:label>
        <skos:definition>The right to liberty refers to the fundamental human right to freedom from unlawful or arbitrary arrest, detention, or other forms of physical restraint. This right is enshrined in international legal instruments such as the Universal Declaration of Human Rights and the International Covenant on Civil and Political Rights, and aims to protect individual autonomy and freedom from state interference.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfZBXE5a6YzktNQk3ubz02 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfZBXE5a6YzktNQk3ubz02">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJC40G3TxG4CIj1rBvhWoF"/>
        <rdfs:label>Pennsylvania Municipal Court - Philadelphia County</rdfs:label>
        <skos:definition>A court in Philadelphia County that handles minor criminal and traffic offenses, as well as civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfcUW3rCpbt8lAjVaduocy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfcUW3rCpbt8lAjVaduocy">
