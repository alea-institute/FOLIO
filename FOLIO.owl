                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R823glDLgYxwmTy40ur3kxA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
