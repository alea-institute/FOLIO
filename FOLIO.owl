        <skos:definition>A voter, also known as an Elector, is an individual who is eligible to vote in an election. This term can also refer to a member of an electoral college, who has the formal responsibility to cast votes for the selection of certain public officials, such as the President of the United States.</skos:definition>
        <skos:prefLabel>Elector</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rul3ZQ6VDAEkNdMR0ajfam -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rul3ZQ6VDAEkNdMR0ajfam">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ksYmaNhrwE6VL9r0qV1sL"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
        <rdfs:label>&quot;&apos;Reasonably likely/expected to be inconsistent&apos; with fiduciary duties&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="de-de">&apos;Angemessen wahrscheinlich/erwartet, dass es mit Treuepflichten unvereinbar ist&apos;</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">&apos;Raisonnablement susceptible/d&apos;attendre d&apos;être incompatible&apos; avec les devoirs fiduciaires</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">&apos;Razoavelmente provável/esperado de ser inconsistente&apos; com deveres fiduciários</skos:altLabel>
        <skos:altLabel xml:lang="es-es">&apos;Razonablemente probable/esperado que sea inconsistente&apos; con los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">&apos;Razonablemente probable/esperado que sea inconsistente&apos; con los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">&apos;Reasonably likely/expected to be inconsistent&apos; with fiduciary duties</skos:altLabel>
        <skos:altLabel xml:lang="he-il">&apos;בהסתמך על הסיכוי המתקיים/הצפוי להיות&apos; לא עקבי עם חובות פידוסיאריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फिडुशियरी ड्यूटी के साथ &apos;योग्यता संभवतः/अपेक्षित&apos; असंगत होने की संभावना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">“合理地可能/预计与受托责任不一致”</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">「信託義務と矛盾する可能性が合理的にある/予想される」</skos:altLabel>
        <skos:definition>&quot;&apos;Reasonably likely/expected to be inconsistent&apos; with fiduciary duties&quot; Language refers to a specific phrase used in legal documents that indicates actions or decisions that may go against the responsibilities and obligations of a fiduciary, such as a trustee or agent, and may result in legal consequences.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
        <rdfs:label>Abstention Doctrines</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Abstention Doctrines</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Doctrinas de Abstención</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Doctrinas de Abstención</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Doctrines d&apos;abstention</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Doutrinas de abstenção</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Enthaltungsdoktrinen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תאוריות המניעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अल्पविराम नीतियाँ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">弃权原则</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">棄権主義</skos:altLabel>
        <skos:definition>Abstention Doctrines refer to legal theories that allow federal courts to abstain from exercising jurisdiction over a case in deference to state court proceedings, including Pullman Abstention, Brillhart-Wilton Abstention, Younger Abstention, Burford Abstention, and Colorado River Abstention.</skos:definition>
    </owl:Class>
    


