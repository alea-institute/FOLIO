        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Cancel Meeting of Creditors</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Aufhebung der Gläubigerversammlung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para cancelar la junta de acreedores</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para cancelar la reunión de acreedores</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour annuler la réunion des créanciers</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Cancel Meeting of Creditors</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para cancelar a reunião de credores</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לביטול ישיבת האשראיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋणदाताओं की बैठक रद्द करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債権者会議の中止申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">取消债权人会议动议</skos:altLabel>
        <skos:definition>A Motion to Cancel Meeting of Creditors is a request made in a bankruptcy case to cancel the scheduled meeting of creditors, which is a meeting where the debtor is required to appear and answer questions under oath about their financial affairs.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8nAwoW16KIuykQfuJKLyvl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8nAwoW16KIuykQfuJKLyvl">
