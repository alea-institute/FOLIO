        <rdfs:label>Intranet Management</rdfs:label>
        <skos:definition>Intranet Management refers to the process of organizing and controlling the internal network of an organization, including the management of content, access, and security.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7nJP4dSsrkKNSDVNhvRI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7nJP4dSsrkKNSDVNhvRI">
