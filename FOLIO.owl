    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfWR4bW2pSANcrrVnQNPgG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfWR4bW2pSANcrrVnQNPgG">
