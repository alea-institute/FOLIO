        <rdfs:label>Penis Cancer</rdfs:label>
        <skos:altLabel>Penile Carcinoma</skos:altLabel>
        <skos:definition>Penis cancer is a malignant tumor originating in the tissues of the penis, typically starting in the skin cells or the internal structures of the penis. It can present with symptoms such as growths or sores on the penis, unusual discharge, and bleeding, often requiring treatments such as surgery, radiation therapy, and chemotherapy.</skos:definition>
        <skos:prefLabel>Penile Cancer</skos:prefLabel>
    </owl:Class>
    


