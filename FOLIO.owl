        <skos:altLabel xml:lang="es-mx">Acciones - Activos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Actions - Actifs</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Aktien - Vermögenswerte</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ações - Ativos</skos:altLabel>
        <skos:altLabel>Stocks</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stocks - Assets</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מניות - נכסים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्टॉक - संपत्ति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">株式 - 資産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">股票 - 资产</skos:altLabel>
        <skos:definition>A stock (also known as &quot;shares&quot; or &quot;equity&quot;) is a type of security that signifies proportionate ownership in the issuing corporation. This entitles the stockholder to that proportion of the corporation&apos;s assets and earnings.</skos:definition>
        <skos:hiddenLabel>STOCKS</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7UL77ApThOeQHgvfPUIfDF -->

