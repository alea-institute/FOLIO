        <skos:altLabel xml:lang="hi-in">गलत संभोग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不法誘惑</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法诱奸</skos:altLabel>
        <skos:definition>The act of seducing someone through deceit or manipulation, resulting in harm or damages, which can be legally pursued as a tort claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wl00Cx0YzzMrf2sOvIKrx -->

