        <skos:altLabel>ETN</skos:altLabel>
        <skos:altLabel>Tracking Securities</skos:altLabel>
        <skos:definition>A Tracker Certificate is a financial instrument that allows participation in the development of the underlying asset(s). These certificates reflect the underlying price movements 1:1, adjusted by the conversion ratio and any related fees, offering a risk profile comparable to direct investment in the underlying asset(s).</skos:definition>
        <skos:prefLabel>Exchange Traded Note</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNme9QOPFVGg4hO6Fqf6TW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNme9QOPFVGg4hO6Fqf6TW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
        <rdfs:label>Bailments</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bailments</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Depósito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Depósito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Depósito</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dépôt</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hinterlegung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הלוואה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बेलमेंट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保管</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">預託</skos:altLabel>
        <skos:definition>A bailment is a legal relationship in which one party (the bailee) holds personal property belonging to another party (the bailor) for a specific purpose, with the understanding that the property will be returned or disposed of according to the bailor&apos;s instructions.</skos:definition>
    </owl:Class>
    


