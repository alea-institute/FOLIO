                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBjYepK2dGo0eMf20eWQmI3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Landlord-Tenant Claims</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ansprüche von Vermieter und Mieter</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Landlord-Tenant Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de arrendador- arrendatario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamaciones de arrendador-inquilino</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de proprietário e inquilino</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations de propriétaire et locataire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות בעלי נכסים-שוכרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लैंडलॉर्ड-टेनेंट दावे</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家主・テナント請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房东-租户索赔</skos:altLabel>
        <skos:definition>Landlord-Tenant Claims refer to legal disputes between a landlord and a tenant, including issues such as failure to return a tenant&apos;s security deposit, unlawful eviction, retaliation, and failure to repair or remedy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R97tgzvknramX3sTnwyUZLN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R97tgzvknramX3sTnwyUZLN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCiwr86zmjFFCLgof7UXAiU"/>
        <dc:source rdf:resource="https://nna.jse.co.za/Help/cfi.htm"/>
        <rdfs:label>Naked Warrant</rdfs:label>
        <skos:altLabel>Third-Party Warrant</skos:altLabel>
        <skos:altLabel>Uncovered Warrant</skos:altLabel>
        <skos:definition>A Naked Warrant is a financial instrument issued by a third party that is not the issuer of the underlying securities to which the warrant refers. The issuer of the naked warrant does not hold a sufficient quantity of the underlying securities to cover all the warrants if they are exercised, which differentiates it from a traditional warrant.</skos:definition>
        <skos:prefLabel>Third-Party Issued Warrant</skos:prefLabel>
    </owl:Class>
    


