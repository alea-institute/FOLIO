        <skos:altLabel>PPM</skos:altLabel>
        <skos:altLabel>Reg D Offering</skos:altLabel>
        <skos:definition>An Offering Memorandum is a legal document outlining the objectives, risks, and terms of an investment involved in a private offering. It is not registered with public securities regulators and is intended for accredited or sophisticated investors.</skos:definition>
        <skos:prefLabel>Offering Memorandum</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkKltCs6qv3E5GLBaSJ8H4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkKltCs6qv3E5GLBaSJ8H4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvV18Mbbb9FYFXbHt1inuL"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R78PKqeEIORKpYVwEfC4aG4"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD3CNG3ecVo2oIloP4lYFoX"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
