    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HBQQorBzLchJWIZlbvzUM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HBQQorBzLchJWIZlbvzUM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Failure to Mediate</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Failure to Mediate</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha na mediação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fracaso en la Mediación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fracaso en la Mediación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nichtdurchführung einer Mediation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Échec de la médiation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כישלון בגישה לפי תיווך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मध्यस्थता में असफलता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">調停の失敗</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">调解失败</skos:altLabel>
        <skos:definition>The concept of Failure to Mediate refers to a civil defense in litigation where one party fails to participate in mediation, which is a process of resolving disputes outside of court with the help of a neutral third party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HE5GFA1XOadp4IeFHXStE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HE5GFA1XOadp4IeFHXStE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Twi</rdfs:label>
        <skos:altLabel xml:lang="de-de">Twi</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Twi</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Twi</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">トウィ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">特威语</skos:altLabel>
        <skos:definition>Twi is a language spoken in Ghana and is a subcategory of the Language class in the ontology.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HKgi7LSbdz9zvbOykr6pp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HKgi7LSbdz9zvbOykr6pp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Ahr1iRMkczkHNvcrZ3KOG"/>
        <rdfs:label>Certificate of Deposit</rdfs:label>
        <skos:definition>A Certificate of Deposit (CD) is a time-bound deposit made with a bank or financial institution that offers a fixed interest rate over a specified period. Unlike a regular savings account, funds in a CD are usually locked in for the term of the CD and early withdrawal may result in penalties.</skos:definition>
        <skos:prefLabel>CD</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HLUMVIgthompejqWqUHOe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HLUMVIgthompejqWqUHOe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
        <rdfs:label>Pathology Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle en pathologie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia médica en patología</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia médica en patología</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em patologia</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Pathologiefehler</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pathology Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה רפואית בפתולוגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पैथोलॉजी लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">病理医疗事故</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">病理学的医療過誤</skos:altLabel>
        <skos:definition>Pathology Malpractice refers to a type of medical malpractice claim that arises from errors or negligence in the examination and diagnosis of tissue samples and bodily fluids by pathologists.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HNdgwRrqNB4YxqQeKKM02 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HNdgwRrqNB4YxqQeKKM02">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBi5nYq1khAzzGeY5YZ10ya"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7dcZJLuYutSG7vbZRwstAC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCmAarh6Wj8m6lLe6lJJBmj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Interference with Leave Rights Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Freistellung beeinträchtigen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interference with Leave Rights Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por interferencia en los derechos de permiso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por interferencia en los derechos de permiso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de interferência nos direitos de licença</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation d&apos;interférence avec les droits de congé</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת זכויות חופשה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">छुट्टी के अधिकारों के दावे में हस्तक्षेप</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">休暇権利侵害請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">干涉休假权利索赔</skos:altLabel>
        <skos:definition>An interference with leave rights claim is a legal action initiated by an employee against their employer for interfering with their right to take protected leave under applicable laws. These laws may include the Family and Medical Leave Act (FMLA), the California Family Rights Act (CFRA), or other state and local laws that provide protected leave for certain reasons, such as for the employee&apos;s own serious health condition, to care for a seriously ill family member, or for the birth or adoption of a child. The claim typically arises when an employer denies or discourages an employee from taking leave or retaliates against an employee for taking protected leave.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HPWCZUhOAniaeM37hZVY1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HPWCZUhOAniaeM37hZVY1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKzL5nW7IGg4mvAPFX2MUL"/>
        <rdfs:subClassOf>
