        <skos:altLabel xml:lang="en-gb">Antitrust - Market Allocation Claims</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Antitrust - Revendications d&apos;allocation de marché</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de Alocação de Mercado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kartellrecht - Ansprüche auf Marktzuweisung</skos:altLabel>
