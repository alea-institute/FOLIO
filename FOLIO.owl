        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aoLYQoIooB9xRkhiMtgR4"/>
        <rdfs:label>Color Blindness</rdfs:label>
        <skos:definition>Color Blindness is a visual impairment that affects an individual&apos;s ability to perceive colors accurately, typically due to a deficiency or absence of certain color-sensitive photoreceptors in the retina. This condition can range from difficulty distinguishing between specific colors to complete inability to see any colors.</skos:definition>
        <skos:prefLabel>Color Vision Impairment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBFSyAy4VY1rETaHMaRwOpo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBFSyAy4VY1rETaHMaRwOpo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBP9N5ER7Y6inNQdjggrKt"/>
        <rdfs:label>Chattels</rdfs:label>
        <skos:altLabel>Movable Property</skos:altLabel>
        <skos:altLabel>Personal Property</skos:altLabel>
        <skos:altLabel>Personalty</skos:altLabel>
        <skos:definition>Chattels are personal property items that are movable and do not include land or interests in land. This legal term encompasses tangible and intangible assets that a person owns, which can be physically relocated or transferred from one place to another, as opposed to real property or immovable assets.</skos:definition>
        <skos:prefLabel>Transferable Personal Possessions</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBFV1dXu2aXDzaGfasJbnsa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBFV1dXu2aXDzaGfasJbnsa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
        <rdfs:label>Involuntary Debtor</rdfs:label>
        <skos:definition>An involuntary debtor is an individual or entity against whom creditors initiate bankruptcy proceedings, often because the debtor has failed to meet financial obligations. The involuntary bankruptcy process is initiated by the filing of a petition by the creditors, rather than the debtor themselves</skos:definition>
    </owl:Class>
    


