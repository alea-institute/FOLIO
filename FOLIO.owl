        <skos:altLabel xml:lang="en-gb">Taking Deposition</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Toma de declaración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Toma de declaración</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tomando depoimento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeugenvernehmung</skos:altLabel>
