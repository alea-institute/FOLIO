        <rdfs:label>Indiana Superior Court - Vigo County</rdfs:label>
        <skos:definition>A court of general jurisdiction in Indiana that has the power to hear and decide a wide range of legal cases within Vigo County.</skos:definition>
    </owl:Class>
    


