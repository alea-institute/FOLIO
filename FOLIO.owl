        <rdfs:label>Interested Party</rdfs:label>
        <skos:altLabel xml:lang="de-de">Interessierte Partei</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interested Party</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Parte Interesada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Parte Interesada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Parte interessada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Partie intéressée</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צד מעוניין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इच्छुक पक्ष</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">利害关系人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">利害関係者</skos:altLabel>
        <skos:definition>A person or entity who is interested in a legal proceeding - without necessarily being a party to that legal proceeding. https://www.ca11.uscourts.gov/e-filing/notices-cases-interest</skos:definition>
        <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9mf4jHGk1EcEkyTBhfv6Zw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9mf4jHGk1EcEkyTBhfv6Zw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sdPQV8kCK3BNF8jcPV5cD"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rte2A8gY3vh8lVIpY5myli"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bail Payment Event</rdfs:label>
        <skos:definition>A Bail Payment is the financial transaction made to secure the temporary release of an accused individual from custody, usually in the form of cash, bond, or property, which is pledged to guarantee their appearance at future court dates. This payment acts as a surety that the defendant will return for trial and may be forfeited if the individual fails to appear in court.</skos:definition>
    </owl:Class>



    <!-- https://folio.openlegalstandard.org/RtQgrbKIvgHvOXm_6lIpaY172 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RtQgrbKIvgHvOXm_6lIpaY172">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sdPQV8kCK3BNF8jcPV5cD"/>
        <rdfs:label>Refund</rdfs:label>
        <skos:altLabel>Reimbursement</skos:altLabel>
        <skos:altLabel>Repayment</skos:altLabel>
        <skos:altLabel>Return of Payment</skos:altLabel>
        <skos:altLabel>Rebate</skos:altLabel>
        <skos:definition>A refund is the return of money to a payor following the overpayment, cancellation, or reversal of a transaction, or the return of goods or services that fail to meet contractual specifications. This payment event typically occurs when a seller or service provider returns all or part of the original payment to the buyer or customer due to dissatisfaction, contractual breach, error in billing, or other circumstances warranting restitution.</skos:definition>
        <skos:example>The customer received a full refund within 30 days after returning the defective merchandise to the retailer.</skos:example>
        <skos:example>Upon discovering the overcharge, the tax authority issued a refund to the taxpayer for the excess amount collected.</skos:example>
        <skos:example>The court ordered the defendant to provide a refund of all payments made under the fraudulent contract.</skos:example>
    </owl:Class>



