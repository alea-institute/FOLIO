            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Lease Related Guaranty</rdfs:label>
        <skos:definition>A Lease Related Guaranty is a promise by a third party (the guarantor) to fulfill the tenant&apos;s obligations under a lease if the tenant fails to do so.</skos:definition>
    </owl:Class>
    


