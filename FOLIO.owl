        <skos:altLabel xml:lang="fr-fr">Clause de subrogation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de sub-rogação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de subrogación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de subrogación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Subrogation Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Subrogationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תחליפין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सबरोगेशन क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">代位权条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">代位請求条項</skos:altLabel>
        <skos:definition>A subrogation clause is a provision in a contract that allows one party to step into the shoes of another party and assume their legal rights and remedies in the event of a loss or damage.</skos:definition>
    </owl:Class>
    


