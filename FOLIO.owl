            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Health Rights</rdfs:label>
        <skos:definition>Health rights refer to the legal and ethical entitlements aimed at ensuring access to a minimum standard of healthcare and well-being for individuals. These rights can include access to medical treatment, preventative care, and essential medications, and are often supported by both international treaties and national healthcare policies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XAQoyqCZvUawGZUsBxFOG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XAQoyqCZvUawGZUsBxFOG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R01E1a02E74a0235f7022f40"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R5DE425E15b8c8CE8fb6Eecf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
