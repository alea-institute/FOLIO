    <!-- https://folio.openlegalstandard.org/R7e5zrrgbQaXa560D2gCDND -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7e5zrrgbQaXa560D2gCDND">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu"/>
        <rdfs:label>United Nations</rdfs:label>
        <skos:altLabel>UN</skos:altLabel>
        <skos:definition>The United Nations (UN) is an international organization founded in 1945 to promote peace, security, and cooperation among member states. It aims to address global challenges such as poverty, climate change, and conflict, and provides a forum for countries to engage in diplomatic relations and collective decision-making.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7e6JFsdgxEOnQLXBpY1lD3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7e6JFsdgxEOnQLXBpY1lD3">
