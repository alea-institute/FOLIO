        <skos:altLabel xml:lang="pt-br">Linguagem de desastres naturais</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Natural Disaster Language</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sprache der Naturkatastrophen</skos:altLabel>
