    <!-- https://folio.openlegalstandard.org/R73cUH079dsK0pNRJiV7Jps -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73cUH079dsK0pNRJiV7Jps">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq6neiK9deZLSfSa41jylg"/>
        <rdfs:label>Business Interruption Insurance Policy</rdfs:label>
        <skos:definition>Business interruption insurance compensates for lost income and operating expenses when a business is unable to operate due to a covered event, such as a natural disaster, fire, or other insurable occurrences. This coverage helps to maintain financial stability during periods when normal business operations are adversely affected.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73dveMt11oYotWVGR1ST2F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73dveMt11oYotWVGR1ST2F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8WhsyEOse5TvMLfnHDYfTY"/>
        <rdfs:label>Cherries</rdfs:label>
        <skos:altLabel>Prunus Fruit</skos:altLabel>
        <skos:definition>Cherries are small, round stone fruits from the Prunus genus, characterized by their juicy flesh, smooth skin, and varying flavors from sweet to tart. They are widely consumed fresh, dried, or processed into products like jams, pies, and beverages, valued for their rich antioxidant content, vitamins, and dietary fiber.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73e7MvslVKhXMpvW8lfJbB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73e7MvslVKhXMpvW8lfJbB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RdOK7keDYcH1kYilffkkjr"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCyX1ukzdCGh1AZ9GHAVTMB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Status - Approved</rdfs:label>
        <skos:altLabel>Approved</skos:altLabel>
        <skos:definition>Status of &quot;Approved&quot; indicates that an application or request has been reviewed and granted approval by the relevant authority, confirming that the individual&apos;s request or application has met the necessary criteria and legal requirements, allowing them to proceed with the intended action, status change, or benefit. This tag is particularly relevant to regulatory agencies (e.g., immigration, patent, trademark).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73fgmpNbSrKeieM9ZPWglZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73fgmpNbSrKeieM9ZPWglZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rh51oMpYnnkIQkUt41V76O"/>
        <dc:source>Fed. R. Evid. 803(5)</dc:source>
        <rdfs:label>Past Recollection Document</rdfs:label>
        <skos:altLabel>Documented Recollection</skos:altLabel>
        <skos:altLabel>Recorded Memory</skos:altLabel>
        <skos:definition>Past recollection recorded is a document that is a hearsay exception, allowing a witness to use a written or recorded statement to testify about a matter that they once knew but cannot recall during testimony. The statement must have been made when the event was fresh in the witness&apos;s memory and must accurately reflect their knowledge at that time.</skos:definition>
        <skos:prefLabel>Past Recollection Recorded</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Event</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ereignis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Event</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Evento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Evento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירוע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">घटना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">イベント</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">事件</skos:altLabel>
        <skos:definition>A matter&apos;s events, as well as collections of those events (often noted as &quot;phases&quot;).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73jCDNZO71858YRbQG6iRA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73jCDNZO71858YRbQG6iRA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RpiGkhd21dqeqzY6R5l2tN"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>International Bill of Human Rights</dc:source>
        <rdfs:label>Freedom from Slavery</rdfs:label>
        <skos:definition>Freedom from slavery is a basic human right that prohibits all forms of slavery, servitude, and forced or compulsory labor. This right is enshrined in various international instruments, such as the Universal Declaration of Human Rights and the United Nations Slavery Convention, and is considered a non-derogable right, meaning it cannot be suspended for any reason.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73kyLODrqAqSL1LXWdxFSx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73kyLODrqAqSL1LXWdxFSx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Mutual Waiver of Consequential Damages Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation mutuelle aux dommages indirects</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia mutua a daños y perjuicios consecuenciales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia mutua a daños y perjuicios consecuenciales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renúncia mútua de danos consequentes</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur gegenseitigen Verzichtserklärung auf Folgeschäden</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mutual Waiver of Consequential Damages Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פטור משותף מפגיעות נזקיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">परस्पर अनुबंध अनुबंध अनुबंध अनुबंध अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">相互免責条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">相互放弃后果损害条款</skos:altLabel>
        <skos:definition>A Mutual Waiver of Consequential Damages Clause is a provision in a contract where both parties agree to waive their right to seek damages for indirect or consequential losses resulting from a breach of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73l5ieLA2jBChIQidqru7F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73l5ieLA2jBChIQidqru7F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ"/>
        <rdfs:label>Cluttering</rdfs:label>
        <skos:altLabel>Disorganized Speech Pattern</skos:altLabel>
        <skos:altLabel>Rapid Speech Disorder</skos:altLabel>
        <skos:definition>Cluttering is a speech disorder characterized by a rapid or irregular speech rate, which often results in disorganized speech patterns, including omitting or collapsing syllables and words. This disorder affects the clarity and fluency of speech, making it difficult for listeners to understand.</skos:definition>
        <skos:prefLabel>Tachylalia</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73nCk9hdOpN2xWeIaJ8CY6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R73nCk9hdOpN2xWeIaJ8CY6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Germanic languages</rdfs:label>
        <skos:altLabel xml:lang="de-de">Germanische Sprachen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langues germaniques</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas germânicas</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ゲルマン語派</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">日耳曼语族</skos:altLabel>
        <skos:definition>Germanic languages are a branch of the language family that includes English, German, Dutch, and Scandinavian languages.</skos:definition>
    </owl:Class>
    


