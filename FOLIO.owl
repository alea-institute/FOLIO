        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Independent Consideration Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de considération indépendante</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Consideración Independiente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Consideración Independiente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de consideração independente</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Independent Consideration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel unabhängiger Berücksichtigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שיקול עצמי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वतंत्र विचार शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独立考慮条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">独立考虑条款</skos:altLabel>
        <skos:definition>An independent consideration clause is a clause in a contract that states that each party&apos;s consideration is separate and independent from the other party&apos;s consideration, and that the failure of one party to perform their obligations does not release the other party from their obligations.</skos:definition>
    </owl:Class>
    


