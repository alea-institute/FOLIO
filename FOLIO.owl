        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Ahr1iRMkczkHNvcrZ3KOG"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBFgL4Dth9VONjmIdH0bEOs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</dc:source>
        <rdfs:label>Payable-on-Death Account</rdfs:label>
        <skos:altLabel>POD</skos:altLabel>
        <skos:definition>A Payable-on-Death (POD) Account is a financial account, such as a bank account or a certificate of deposit, that allows the account holder to designate a specific beneficiary who will receive the funds in the account upon the account holder&apos;s death. This designation operates outside of the probate process, making it a straightforward way to transfer assets to a chosen beneficiary without the need for a will or going through the probate court.</skos:definition>
    </owl:Class>
    


