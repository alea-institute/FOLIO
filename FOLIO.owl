        <skos:altLabel xml:lang="ja-jp">判決執行停止申立書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">暂缓执行判决动议</skos:altLabel>
        <skos:definition>A Motion to Stay Execution of Judgment is a request made to temporarily halt the enforcement of a court order or judgment, typically to allow for further legal proceedings or to provide time for the party to comply with the order or judgment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RK5PDvSB6WBAF62b78Ctev -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RK5PDvSB6WBAF62b78Ctev">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHYAaMF4QRHH9QwmNKGN8Y"/>
        <rdfs:label>Nonverbal Learning Disability</rdfs:label>
        <skos:altLabel>Nonverbal Learning Disorder</skos:altLabel>
        <skos:definition>Nonverbal Learning Disability (NVLD) is a neurological condition characterized by significant difficulties with visual-spatial, motor, and social skills, despite strong verbal abilities. Individuals with NVLD may struggle with tasks requiring coordination, interpreting nonverbal cues, and spatial awareness, impacting their academic and social functioning.</skos:definition>
        <skos:prefLabel>Nonverbal Cognitive Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RK6eLsHaKDF9uflImSiTGB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RK6eLsHaKDF9uflImSiTGB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R06956a0657387D6513A8528"/>
        <rdfs:label>New York Supreme Court - Suffolk County</rdfs:label>
        <skos:definition>The New York Supreme Court - Suffolk County is a court of general jurisdiction located in Suffolk County, New York, with authority to hear and decide a wide range of legal disputes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKAu5zvBMqnQ8fixz5Sz6N -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKAu5zvBMqnQ8fixz5Sz6N">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeiXNGpqL4H3jo1g1NobSm"/>
        <rdfs:label>Indiana Circuit Court - Henry County 3</rdfs:label>
        <skos:definition>A court of general jurisdiction in Henry County, Indiana, with authority over civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKBlQ2mgZn3CTwBfUYIM7s -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKBlQ2mgZn3CTwBfUYIM7s">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_22"/>
        <rdfs:label>Motor Neuron Disorder</rdfs:label>
        <skos:altLabel>Motor Neuron Syndrome</skos:altLabel>
        <skos:altLabel>Neurodegenerative Motor Neuron Disease</skos:altLabel>
        <skos:definition>Motor neuron disorders are a group of progressive neurological diseases that affect the motor neurons, which are the nerve cells responsible for controlling voluntary muscles. These disorders lead to muscle weakness, atrophy, and eventual paralysis as the motor neurons degenerate and die.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKDBqW2rSLcrXUmqa4wl8F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKDBqW2rSLcrXUmqa4wl8F">
