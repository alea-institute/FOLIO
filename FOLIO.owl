    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9SJQGEqTv7Yi81AtSftq1C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9SJQGEqTv7Yi81AtSftq1C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHfeijrOTjaF7qpuoGIGkR"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RZQeJJHiuZAVfxCZFXSAUe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>inv_payment_terms</rdfs:label>
        <skos:definition>&quot;Discount applied to the invoice if it is paid within the stated number of days. &quot;&quot;10.00/30&quot;&quot; would indicate that the firm will accept a 10% discount of inv_total_net_due if paid within 30 days of the invoice_date.  CAN NOT be used if any tax is charged against any matter/invoice that is part of this inv_id because there may be a legal requirement that the tax amount charged should not be modified.  
  
Law firm can not apply this reduction to the invoice because it is dependent on the payment turnaround by the client; represents an additional discount that must be applied by the client&apos;s accounts payable system or third party e-billing vendor if the payment terms are met.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9SS4ShMrRoDS7ps7dIlyLF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9SS4ShMrRoDS7ps7dIlyLF">
