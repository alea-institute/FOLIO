        <skos:altLabel xml:lang="ja-jp">訴訟文書識別子</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">诉讼文件标识符</skos:altLabel>
        <skos:definition>Litigation Document Identifiers are specific pieces of information used to identify and track legal documents related to a particular case, including docket numbers, document numbers, and case names.</skos:definition>
    </owl:Class>
    


