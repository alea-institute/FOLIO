        <skos:altLabel xml:lang="he-il">מטרות רגולציה של סימני מסחר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रेडमार्क नियामक उद्देश्य</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">商标监管目标</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">商標規制目標</skos:altLabel>
        <skos:definition>Trademark Regulatory Objectives: The specific aims, goals, plans, and intentions related to the regulation of trademarks, including the legal frameworks and policies that support their execution.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IUa9jW3BLd4WrNowXl0ec -->

