        <skos:altLabel xml:lang="es-mx">Negligencia médica en radiología</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em radiologia</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Radiologie-Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Radiology Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה רפואית ברדיולוגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रेडियोलॉजी लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">放射学医疗事故</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">放射線医療過誤</skos:altLabel>
        <skos:definition>Radiology Malpractice refers to a type of medical malpractice claim that arises from errors or negligence in the interpretation of medical images or the performance of radiological procedures.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBnFgXRXMMiYQFMZI6WJk8l -->

