        <rdfs:label>Change in Control Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Change in Control Clause</skos:altLabel>
        <skos:altLabel>Change of Control Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de changement de contrôle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Cambio de Control</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Cambio de Control</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Mudança de Controle</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Änderung der Kontrolle</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שינוי בשליטה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नियंत्रण में परिवर्तन शर्त</skos:altLabel>
