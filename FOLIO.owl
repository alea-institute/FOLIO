        <skos:altLabel>Advocacy</skos:altLabel>
        <skos:altLabel>Dispute</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dispute Service</skos:altLabel>
        <skos:altLabel>Disputes</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Service de règlement des différends</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Servicio de resolución de controversias</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Servicio de resolución de disputas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Serviço de resolução de disputas</skos:altLabel>
