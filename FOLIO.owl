        <rdfs:label>Design Immunity</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Design Immunity</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Immunité de conception</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imunidade de projeto</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inmunidad de diseño</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad de diseño</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Konstruktionsimmunität</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות עיצוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डिजाइन इम्यूनिटी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">設計免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">设计豁免权</skos:altLabel>
        <skos:definition>Design Immunity is an affirmative defense to a claim of dangerous condition of public property and should be considered where the design of the subject area is at issue.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8R2AoaEDICGsFmF97dz5gG -->

