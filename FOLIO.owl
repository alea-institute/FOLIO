        <rdfs:label>Scenic and Sightseeing Transportation, Other</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/IMG5GjCWTgeRGbpJARBXcQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/IMG5GjCWTgeRGbpJARBXcQ">
