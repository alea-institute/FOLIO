        <rdfs:label>Illinois Circuit Court - Washington County (20th Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhkE9QAFGnMrZbdkx1K28X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhkE9QAFGnMrZbdkx1K28X">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
