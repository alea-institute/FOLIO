        <skos:altLabel xml:lang="en-gb">Partnership Liability for Debts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad de la sociedad por deudas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad de la sociedad por deudas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade dos sócios pelas dívidas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité des partenaires pour les dettes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות שותפות עבור חובות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋणों के लिए साझेदारी दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パートナーシップの債務責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合伙责任债务</skos:altLabel>
        <skos:definition>The concept of Partnership Liability for Debts refers to the legal responsibility of partners in a partnership to pay off any debts incurred by the partnership, even if it means using their personal assets to do so.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCXrYpp1ijYGjHeVTcU5RfV -->

