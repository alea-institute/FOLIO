        <rdfs:label>Dismissal With Prejudice</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abweisung mit Vorurteil</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Arquivamento com prejuízo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Desestimación con Perjuicio</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Desestimación con Prejuicio</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dismissal With Prejudice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Rejet avec préjudice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים עם פגמים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्व न्यायाधीश के फैसले के साथ खारिजी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不受理（不許可）決定</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">带有成见的驳回</skos:altLabel>
        <skos:definition>Dismissal with prejudice is a legal ruling that permanently prevents the same case from being brought to court again, due to a decision made on the merits of the case.</skos:definition>
    </owl:Class>
    


