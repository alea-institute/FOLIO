        <skos:altLabel xml:lang="es-es">Cláusula de modificación de estatutos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de modificación de estatutos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Änderung der Satzungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שינוי תקנות</skos:altLabel>
