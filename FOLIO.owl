    <!-- https://folio.openlegalstandard.org/R82DCY9wpy8RlxYrwn0NIya -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R82DCY9wpy8RlxYrwn0NIya">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9yi9EljTLvrh7N74L460ye"/>
        <dc:source>Fed. R. Evid. 801(d)</dc:source>
        <rdfs:label>Non-Hearsay Evidentiary Objective</rdfs:label>
        <skos:definition>A Non-Hearsay Evidentiary Objective refers to a purpose for admitting an out-of-court statement that is specifically exempted from the hearsay rule due to its inherent reliability or fairness in the context of the adversarial process. These objectives include party admissions, prior statements by witnesses under oath, and prior identifications made by witnesses.</skos:definition>
    </owl:Class>
    


