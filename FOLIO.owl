    <!-- https://folio.openlegalstandard.org/R9em7T0Di8mYGAQVo5qSqdc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9em7T0Di8mYGAQVo5qSqdc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Preemptive Rights Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de droits préférentiels</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Derecho de Adquisición Preferente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Derecho de Adquisición Preferente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de direitos de subscrição</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pre-emption Rights Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorzugsaktienklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכויות קדם קנייה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्वाधिकार अधिनियम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">优先认购权条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">優先的引受権条項</skos:altLabel>
        <skos:definition>A preemptive rights clause is a provision in a contract that grants a party the right to purchase additional shares of stock in a company before they are offered to the public, thereby maintaining their percentage of ownership.</skos:definition>
    </owl:Class>
    


