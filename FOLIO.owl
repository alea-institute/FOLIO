        <rdfs:label>C100 Fact Gathering</rdfs:label>
        <skos:definition>This phase includes all initial inquiries, meetings and instructions and the identification and collection of information relevant to the assignment.</skos:definition>
        <skos:prefLabel>C100 Fact Gathering</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RhM0ab89J6bNADGZjt9GhX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RhM0ab89J6bNADGZjt9GhX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R87EsagydUYKkWMX3oyulrq"/>
        <rdfs:label>Eviction for Nonpayment of Rent</rdfs:label>
        <skos:definition>Eviction for nonpayment of rent is a legal process through which a landlord seeks to remove a tenant from a rented property because the tenant has failed to pay the agreed-upon rent. This eviction process typically involves the landlord providing notice to the tenant, initiating legal proceedings, and obtaining a court order to regain possession of the property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RhMjXchJCejHKsKf0dzM8N -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RhMjXchJCejHKsKf0dzM8N">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQCFqSF0Q0sCqCcEwv2pgz"/>
        <rdfs:label>Domain Name Claim</rdfs:label>
        <skos:definition>A domain name claim is a legal assertion by an individual or entity regarding the right to use a specific internet domain name. This claim often arises in the context of trademark disputes, cybersquatting, or domain name registration conflicts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RhNl96zoCgI6solrSRV55Z -->

