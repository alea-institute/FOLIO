        <rdfs:label>New Mexico Metropolitan Court</rdfs:label>
        <skos:definition>The New Mexico Metropolitan Court is a court of limited jurisdiction within the New Mexico State Courts system, located in Bernalillo County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9MD9rwRADsqy2eadoz5R8L -->

