        <skos:altLabel xml:lang="de-de">Materiale Rabatte oder Gutschriften</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Matter Fees Discount or Credit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Remises ou crédits sur les frais de matière</skos:altLabel>
