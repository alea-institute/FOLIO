        <rdfs:label>Partner Breaching Duty to Co-Partner</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Parceiro violando o dever para com o co-parceiro</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Partenaire en violation du devoir envers le co-partenaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Partner Breaching Duty to Co-Partner</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Partner verletzt Pflicht gegenüber Mitgesellschafter</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Socio que incumple su deber con el co-socio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Socio que incumple su deber con el co-socio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שותף שמפר את החובה שלו לשותף המשותף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साझेदार जो सह-साझेदार के प्रति अपना दायित्व नहीं निभाता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パートナーが共同パートナーに対する義務を違反する</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合伙人违反对合伙人的义务</skos:altLabel>
        <skos:definition>When a partner fails to fulfill their legal obligation to another partner in a business entity, resulting in harm or damages, it is considered a breach of duty to co-partner.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RPCoOZAngR2KbFh-lLxnFkw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RPCoOZAngR2KbFh-lLxnFkw">
