    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ch7kaT0lU1J8sKvhpf3sh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ch7kaT0lU1J8sKvhpf3sh">
