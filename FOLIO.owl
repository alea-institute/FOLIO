        <skos:altLabel xml:lang="es-es">Reclamaciones por negligencia médica</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de negligência médica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations pour négligence médicale</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות רשלנות רפואית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मेडिकल ग़लती के मामले</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">医疗过失索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">医療過誤請求</skos:altLabel>
        <skos:definition>Medical Negligence Claims refer to legal claims made by individuals who have suffered harm or injury due to the failure of medical professionals to provide an appropriate standard of care.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ZfDTW9ZZuAvpJxvh75trh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ZfDTW9ZZuAvpJxvh75trh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0EU9KrLDwhmIAsBno5K4c"/>
        <rdfs:label>Motion to Introduce Evidence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einführung von Beweismitteln</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Presentar Pruebas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Presentar Pruebas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour introduire des preuves</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Introduce Evidence</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Introdução de Provas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להצגת ראיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साक्ष्य पेश करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">引入证据动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証拠提出請求</skos:altLabel>
        <skos:definition>A Motion to Introduce Evidence is a formal request made to a court to allow the presentation of evidence during a trial or hearing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Zfa5zKmebxoYJBZqiOQYq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Zfa5zKmebxoYJBZqiOQYq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBY4j5UKZ7L8gp0q9Wrxyge"/>
        <rdfs:label>Full-Time Employee</rdfs:label>
        <skos:definition>A Full-Time Employee is an individual who works a minimum number of hours specified by their employer or by labor laws, often at least 35 to 40 hours per week. This classification usually comes with benefits such as health insurance, paid time off, and retirement plans, which may not be available to part-time or contract workers</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ZirUAl92QNUmY1boxGTbq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ZirUAl92QNUmY1boxGTbq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB3FT9lFNQIjRnFIueLgCa7"/>
        <rdfs:label>Notice of Bankruptcy</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Avis de faillite</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Aviso de bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aviso de falência</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aviso de quiebra</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Insolvenzmitteilung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Notice of Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הודעת פשיטת רגל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन का नोटिस</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产通知</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産通知書</skos:altLabel>
        <skos:definition>A Notice of Bankruptcy is a formal written communication that informs creditors and other interested parties that an individual or entity has filed for bankruptcy protection.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ZkEwFlNJhzaSONYM8lfAH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ZkEwFlNJhzaSONYM8lfAH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8THIhCQDpX9BgtDhsfKsQ5"/>
        <rdfs:label>Crohn&apos;s Disease</rdfs:label>
        <skos:altLabel>Crohn Disease</skos:altLabel>
        <skos:altLabel>Regional Enteritis</skos:altLabel>
        <skos:definition>Crohn&apos;s disease is a chronic inflammatory condition of the gastrointestinal (GI) tract, which can affect any part from the mouth to the anus, though it most commonly impacts the small intestine and colon. The disease is characterized by transmural inflammation, which can lead to complications such as strictures, fistulas, and abscesses, and typically requires ongoing medical management and sometimes surgical intervention.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ZlaQW5BEvAiAweNG6LPZ2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ZlaQW5BEvAiAweNG6LPZ2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Nature of Work Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause sur la nature du travail</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Naturaleza del Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Naturaleza del Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de natureza do trabalho</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Art der Arbeit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nature of Work Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף טבע העבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">काम की प्रकृति धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工作性质条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">業務性質条項</skos:altLabel>
        <skos:definition>A Nature of Work Clause is a provision in a contract that defines the type of work that will be performed by one or both parties involved in the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ZouJ8WES1J06md808zLqB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ZouJ8WES1J06md808zLqB">
