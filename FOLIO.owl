        <rdfs:label>Food Service Contractors</rdfs:label>
        <skos:definition>See industry description for 722310.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/bD6UCewkTA6c-7gYQoTg0w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/bD6UCewkTA6c-7gYQoTg0w">
