        <rdfs:label>Equity Agreements</rdfs:label>
        <skos:definition>Equity Related Agreement is an umbrella term for agreements related to ownership interest in a company. It outlines terms and conditions associated with equity ownership, including rights and responsibilities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLyrii562E72Ns6JtXAOeX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLyrii562E72Ns6JtXAOeX">
