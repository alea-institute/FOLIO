        <rdfs:label>Goods Sold and Delivered</rdfs:label>
        <skos:altLabel xml:lang="es-es">Bienes vendidos y entregados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Bienes vendidos y entregados</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Goods Sold and Delivered</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">bens vendidos e entregues</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">biens vendus et livrés</skos:altLabel>
        <skos:altLabel xml:lang="de-de">verkaufte und gelieferte Waren</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סחורות נמכרות ומסורות</skos:altLabel>
