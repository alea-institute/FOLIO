        </rdfs:subClassOf>
        <rdfs:label>Abuse of Adults</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Abuse of Adults</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Abuso de Adultos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Abuso de Adultos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Abuso de adultos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Maltraitance des adultes</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Missbrauch von Erwachsenen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התעללות במבוגרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वयस्कों के दुरुपयोग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">大人の虐待</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">成年人虐待</skos:altLabel>
        <skos:definition>The mistreatment or harm of an adult who is dependent on another person, which can result in civil claims. This includes abuse of adults who are dependent on their children or elderly individuals.</skos:definition>
    </owl:Class>
    


