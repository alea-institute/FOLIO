        <skos:altLabel xml:lang="hi-in">सेवा को रद्द करने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销送达申请</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">送達取消申立書</skos:altLabel>
        <skos:definition>A Motion to Quash Service is a legal request to invalidate or nullify a summons or other legal notice that was improperly served to a party in a lawsuit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RadgKbGJ3NluNEV56hmGFN -->

