    <!-- https://folio.openlegalstandard.org/R74MfMU3dp9biaiPczk4vmp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74MfMU3dp9biaiPczk4vmp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Prepayment Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de prépaiement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de prepago</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de prepago</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de pré-pagamento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Prepayment Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorauszahlungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תשלום מראש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रीपेमेंट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">前払い条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">预付款条款</skos:altLabel>
        <skos:definition>A prepayment clause is a provision in a contract that allows the debtor to pay off a debt before it is due without incurring a penalty.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74Ml4vxSPjSu45jw41IZ2u -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74Ml4vxSPjSu45jw41IZ2u">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N"/>
        <rdfs:label>Biometric Claim</rdfs:label>
        <skos:definition>A Biometric Claim refers to a legal assertion or action brought under laws regulating the collection, use, and storage of biometric data, such as fingerprints, facial recognition, and other unique biological attributes. Many jurisdictions have enacted legislation setting strict consent and protection standards for biometric data.</skos:definition>
        <skos:example>New York City Biometric Information Privacy Law</skos:example>
        <skos:example>Texas Capture or Use of Biometric Identifier Act (CUBI)</skos:example>
        <skos:example>Washington Biometric Law</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rub2xErcJ0t8GToQfoaVG1"/>
        <rdfs:label>Leafy Vegetables</rdfs:label>
        <skos:altLabel>Leafy Greens</skos:altLabel>
        <skos:altLabel>Salad Greens</skos:altLabel>
        <skos:definition>Leafy vegetables, also known as greens, are a category of vegetables harvested primarily for their edible leaves, which are rich in vitamins, minerals, and dietary fiber. They are consumed raw or cooked and are valued for their nutritional benefits, including high levels of vitamins A, C, and K, as well as antioxidants and phytonutrients.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74PEDCu9aothhQ4GcsR6LZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74PEDCu9aothhQ4GcsR6LZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9CZTlyeU1hg4NPl7hcDKI2"/>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Engagement Names</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Engagement Names</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Engagement-Namen</skos:altLabel>
        <skos:altLabel>Matter Names</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Nombres de compromiso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Nombres de compromiso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Nomes de engajamento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Noms d&apos;engagement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שמות התחייבות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विवाह नाम</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エンゲージメント名</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">参与名称</skos:altLabel>
        <skos:definition>Engagement Names refer to the specific names or titles given to legal engagements for providing legal services, such as docket numbers, formal engagement names, litigation identifiers, and billing matter names.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74TUaDuXhtfgwnBtY34zgP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74TUaDuXhtfgwnBtY34zgP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rs2T4JXRBzxyj3hNAMRsoT"/>
        <rdfs:label>Event Due Date</rdfs:label>
        <skos:definition>A Due Date Event refers to the specified deadline by which a particular task, action, or submission is required to be completed. In immigration contexts, it could pertain to the submission of documents, responses to inquiries, or meeting other requirements within the prescribed timeframe set by immigration authorities or relevant parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74W8n1Is40wEpY9mVJCzn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74W8n1Is40wEpY9mVJCzn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R80nTp0xPWvxkJonwMOIvBA"/>
        <dc:source rdf:resource="https://www.nih.gov/nih-style-guide/sex-gender-sexuality"/>
        <rdfs:label>Genderfluid</rdfs:label>
        <skos:definition>Genderfluid refers to a gender identity or expression that may change over time or depending on circumstances, signifying a fluid or dynamic experience of gender rather than a fixed or static identity. In legal contexts, understanding and accommodations regarding genderfluid identities can intersect with discussions and policies related to anti-discrimination, gender recognition, and inclusivity</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74eoff0t9bkabhhZR20Z0B -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74eoff0t9bkabhhZR20Z0B">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmHm8XikjkCUxdyjBkR7Q0"/>
        <rdfs:label>Appellate Court Judicial Opinion</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Appellate Judicial Opinion</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Berufungsgerichtliche Meinung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Opinion judiciaire d&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Opinião judicial de apelação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Opinión Judicial de Apelación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Opinión Judicial de Apelación</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פסק דין משיכה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपीलीय न्यायिक राय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">上诉法院意见</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴審判意見</skos:altLabel>
        <skos:definition>An Appellate Court Judicial Opinion is a written decision by a higher court that reviews and affirms, reverses, or modifies the decision of a lower court, and provides legal reasoning and analysis for the decision.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R74fiWrDWHFdnzcHB1hETEv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R74fiWrDWHFdnzcHB1hETEv">
