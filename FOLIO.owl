        <skos:altLabel>Applicant/Petitioner</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Applicant/Petitioner</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demandeur/Requérant</skos:altLabel>
        <skos:altLabel>Petitioner</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Requerente/Peticionário</skos:altLabel>
