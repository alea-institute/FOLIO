    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R86iUPXLpkUxhNOxdQYUaWl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R86iUPXLpkUxhNOxdQYUaWl">
