    <!-- https://folio.openlegalstandard.org/R7OM23yAFBywKVmUN7pAksz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OM23yAFBywKVmUN7pAksz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWuBs7zey8BVg86iZuFUNk"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_23"/>
        <rdfs:label>Ovarian Cancer</rdfs:label>
        <skos:altLabel>Ovarian Carcinoma</skos:altLabel>
        <skos:definition>Ovarian cancer is a type of cancer that begins in the ovaries, the female reproductive glands responsible for producing eggs. It is often diagnosed at an advanced stage and typically requires treatments such as surgery, chemotherapy, and targeted therapy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OQ65vKuOBSSGgSVYnoMfx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OQ65vKuOBSSGgSVYnoMfx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Electoral_system"/>
        <rdfs:label>Electoral System</rdfs:label>
        <skos:altLabel>Balloting System</skos:altLabel>
        <skos:altLabel>Election Method</skos:altLabel>
        <skos:altLabel>Election Protocol</skos:altLabel>
        <skos:altLabel>Election System</skos:altLabel>
        <skos:altLabel>Electoral Mechanism</skos:altLabel>
        <skos:altLabel>Electoral Procedure</skos:altLabel>
        <skos:altLabel>Vote Counting System</skos:altLabel>
        <skos:altLabel>Voting System</skos:altLabel>
        <skos:definition>An electoral system is a set of rules and procedures used to conduct elections and determine the outcome of votes. Different systems can influence the election&apos;s outcome, voter behavior, and the overall representation in the elected body, ranging from single-member plurality systems to proportional representation systems.</skos:definition>
        <skos:prefLabel>Voting Framework</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OQGIV07yTmUJLm6I1jgRB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OQGIV07yTmUJLm6I1jgRB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R24Fe8aF4D15b46F6031E543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Blue Sky Filing</rdfs:label>
        <skos:altLabel>Provincial Securities Filing</skos:altLabel>
        <skos:altLabel>State Securities Filing</skos:altLabel>
        <skos:definition>A Blue Sky Filing is a state-level or province-level regulatory filing required for the sale of securities to ensure compliance with securities laws, commonly referred to as &quot;Blue Sky Laws.&quot; These filings are necessary to protect investors from fraudulent sales practices and ensure that securities offered or sold within a state meet specific disclosure and registration requirements.</skos:definition>
    </owl:Class>
    


