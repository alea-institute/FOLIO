        <dc:source rdf:resource="https://obata.com/global-esg-regulations-what-they-mean-for-your-organization/"/>
        <dc:source rdf:resource="https://www.squirepattonboggs.com/-/media/files/insights/publications/2023/07/esg-laws-across-the-world/esg-laws-across-the-world.pdf?rev=995db37cd01d448da71ab7853ff25867"/>
        <rdfs:label>Environmental, Social, and Governance Law</rdfs:label>
        <skos:definition>Environmental, Social, and Governance Law (ESG Law) encompasses a set of legal standards and regulations that guide organizations in integrating environmental, social, and governance considerations into their operations and decision-making processes. ESG laws aim to promote sustainable practices, ethical governance, and social responsibility to achieve long-term positive impacts on society and the environment.</skos:definition>
        <skos:prefLabel>ESG Law</skos:prefLabel>
    </owl:Class>
    


