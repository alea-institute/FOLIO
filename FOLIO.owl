        <rdfs:label>Pennsylvania Magisterial District Court - Greene County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Greene County is a specific court within the Pennsylvania Magisterial District Court system that has jurisdiction over minor criminal offenses and civil cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDf4tm45mbz5CHnfIm92BQP -->

