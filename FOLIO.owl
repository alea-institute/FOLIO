        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/neEU9-WeRpKClWn2ui4HvQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=321912"/>
        <rdfs:label>Cut Stock, Resawing Lumber, and Planing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing dimension lumber from purchased lumber; (2) manufacturing dimension stock (i.e., shapes) or cut stock; (3) resawing the output of sawmills; and (4) planing purchased lumber. These establishments generally use woodworking machinery, such as jointers, planers, lathes, and routers to shape wood.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/hfKF_CnLTTO8f5Y0CiuEHA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/hfKF_CnLTTO8f5Y0CiuEHA">
