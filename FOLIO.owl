        <rdfs:label>E100 Expenses</rdfs:label>
        <skos:definition>E100 Expenses refer to the costs incurred during litigation that are categorized under the UTBMS Litigation code set, including but not limited to copying, postage, delivery services, expert fees, and travel expenses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROnsDnsqxwjC17x5c1Jqrg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROnsDnsqxwjC17x5c1Jqrg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzVJL7xHCPdcNwnHbt71AD"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Petition for Rehearing</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Petition for Rehearing</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recurso de reconsideración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recurso de reconsideración</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עתירה לדיון מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पुनरावृत्ति की याचिका</skos:altLabel>
        <skos:definition>A Petition for Rehearing is a formal request made to an appellate court to reconsider its decision in a case, typically filed after an unfavorable ruling, and is a type of Appellate Filing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROnyVftkF9oj643l1BOeHN -->

