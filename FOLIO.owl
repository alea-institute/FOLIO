        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97MkMdKZEGmlgj6msDMIkq"/>
        <rdfs:label>Mutual Release of All Claims Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de libération mutuelle de toutes les revendications</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Liberación Mutua de Todas las Reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Liberación Mutua de Todas las Reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de liberação mútua de todas as reivindicações</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur gegenseitigen Freistellung von allen Ansprüchen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mutual Release of All Claims Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שחרור משותף מכל טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सभी दावों के संबंध में सहमति रिहाई धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">全請求相互放棄条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">相互豁免所有索赔条款</skos:altLabel>
        <skos:definition>A Mutual Release of All Claims Clause is a legal provision that releases both parties from any and all claims against each other, as specified in a contract or agreement.</skos:definition>
    </owl:Class>
    


