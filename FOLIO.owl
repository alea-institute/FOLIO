    <owl:Class rdf:about="https://folio.openlegalstandard.org/RmL6t0jxevPgTbIcHPoCFC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBxw7BF15bDA0Ifn2vOrC8h"/>
        <rdfs:label>Georgia District Court - Bibb County</rdfs:label>
        <skos:definition>A court located in Bibb County, Georgia that has jurisdiction over certain legal matters within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RmLdyoCICTrG3AIcahZpCAg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RmLdyoCICTrG3AIcahZpCAg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RIqMae8AYRo634OG4XtuV0A"/>
        <rdfs:label>L690 Project Management (NOS)</rdfs:label>
        <skos:definition>&quot;NOS&quot; = Not Otherwise Specified (catch-all, includes the subcategories). Activities or actions to associated with supervising or managing specific activities or actions throughout the EDRM continuum such as conducting meetings and team calls, developing work plans, budgets, forecasts, reports and other meaningful activities or for general project management not associated with a particular &quot;L&quot; code. Primarily charges on a hourly or a flat/fixed fee basis.</skos:definition>
        <skos:prefLabel>L690 Project Management (NOS)</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RmNncTGKFe6ppiYH1Uycpn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RmNncTGKFe6ppiYH1Uycpn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85Imx70Iv0XY38PT8gfM6z"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/RN3mWlXZUAt07dYsu6tls2"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rhc05UTwDLyZk96B8m5ull"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Petition for Visa for Specialized Knowledge Worker</rdfs:label>
        <skos:altLabel>L-1B Petition</skos:altLabel>
        <skos:definition>Petition for Visa for Specialized Knowledge Worker (in the U.S., L-1B petition) refers to the process of applying for a visa for intracompany transferees with specialized knowledge who are being transferred from a foreign office to a U.S. office within the same company. In the United States, employers must file a Form I-129 petition with U.S. Citizenship and Immigration Services (USCIS), providing evidence of the employee&apos;s specialized knowledge and meeting other eligibility criteria for the L-1B visa. If approved, the employee can work in the U.S. for the sponsoring employer for a specified period</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RmO3UVHCbxAoZ5hY7KFHtx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RmO3UVHCbxAoZ5hY7KFHtx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDeH9slXtJOmFPiZhIzsDUg"/>
        <rdfs:label>NATO-2 Visa</rdfs:label>
        <skos:altLabel>International Military Alliance Representative Visa</skos:altLabel>
        <skos:altLabel>NATO Civilian Employee Visa</skos:altLabel>
        <skos:altLabel>NATO Official Visa</skos:altLabel>
        <skos:altLabel>NATO Representative Visa</skos:altLabel>
        <skos:definition>A NATO-2 visa is issued to representatives of NATO, including civilian employees, who are stationed in the U.S. for official duties, along with their immediate family members. This visa category also includes dependents and staff members accompanying the representatives.</skos:definition>
    </owl:Class>
    


