        <rdfs:label>JA00 Funding (UK J-CODE)</rdfs:label>
        <skos:definition>All work relating to reviewing funding options, securing funding and reports to funders during the life of the case</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HyMVAp54g7Y2qHYFRfSeq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HyMVAp54g7Y2qHYFRfSeq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Cheroenhaka (Nottoway)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9I0nYrXSCGRN5gaGJRTypk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9I0nYrXSCGRN5gaGJRTypk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9zyvDXyYEEyM7dTnON56uL"/>
        <rdfs:label>Hunting License</rdfs:label>
        <skos:definition>A hunting license is an official permit issued by a governing authority that grants individuals the legal right to hunt specific species of wildlife within designated areas and during specified seasons. To obtain a hunting license, applicants often must complete a hunter education course and adhere to established regulations, bag limits, and conservation measures. The license may have stipulations based on species, weapon type, and region.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9I1vkniee5QgVTnu8v9GCt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9I1vkniee5QgVTnu8v9GCt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJPmwN3dU0x1Hk5Wgu3Bnx"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfdN15c44dyYEkhB4tR9Hu"/>
        <rdfs:label>Motion to Expedite Appeal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Beschleunigung der Berufung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour accélérer l&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Expedite Appeal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de aceleração do recurso</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de aceleración del recurso de apelación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de aceleración del recurso de apelación</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה להאצת הערעור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपील को त्वरित करने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加速上诉动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴の迅速化に関する請願</skos:altLabel>
        <skos:definition>A Motion to Expedite Appeal is a legal request made to a higher court to speed up the process of reviewing a lower court&apos;s decision.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9I2QOa7u8LwCRqKo4FKdPd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9I2QOa7u8LwCRqKo4FKdPd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV"/>
        <rdfs:label>Timberland Real Estate Asset</rdfs:label>
        <skos:altLabel>Timberland</skos:altLabel>
        <skos:altLabel>Woodland</skos:altLabel>
        <skos:definition>In the context of legal services, Timberland refers to a parcel of land with specific legal considerations surrounding the growth, management, and harvesting of timber. Legal issues may include property rights, environmental regulations, and contractual obligations between parties involved.</skos:definition>
        <skos:prefLabel>Forest</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9I5NnI41F5zvaAiT1AdU7I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9I5NnI41F5zvaAiT1AdU7I">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
        <rdfs:label>Asset Distribution Policy</rdfs:label>
        <skos:definition>Asset Distribution Policy refers to the strategy a fund employs to manage and allocate its investment profits. This policy includes income funds, which regularly distribute profits to investors; accumulation funds, which reinvest profits back into the fund; and mixed funds, which combine both strategies by partially distributing and partially reinvesting profits.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9I7IUYUmnVRQo4aTRWojbu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9I7IUYUmnVRQo4aTRWojbu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC8JmK2y8Na9Itkk0MCtMS4"/>
        <rdfs:label>Military Enrollment</rdfs:label>
        <skos:definition>Military Enrollment refers to the process by which individuals join the armed forces, either voluntarily or through conscription. This initial phase includes a series of steps such as application, background checks, and basic training to prepare the individual for service.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IBK1C50E7u2akjOiYsVFx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9IBK1C50E7u2akjOiYsVFx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NwY5UT07qF3VkI8MYarxj"/>
