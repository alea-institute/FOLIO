        <rdfs:label>Termination by Either Party Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de résiliation par l&apos;une ou l&apos;autre partie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Terminación por Cualquiera de las Partes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Terminación por Cualquiera de las Partes</skos:altLabel>
