            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Self-Incrimination Privilege</rdfs:label>
        <skos:altLabel>Fifth Amendment Privilege</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Privilegio de no autoincriminación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Privilegio de no autoincriminación</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège contre l&apos;auto-incrimination</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Privilégio contra a autoincriminação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht zur Selbstbelastung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Self-Incrimination Privilege</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות לא להאשים את עצמו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्व-अभियोग सुरक्षा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自己責任に関する特権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">自证权利</skos:altLabel>
        <skos:definition>The Self-Incrimination Privilege is a legal right that allows an individual to refuse to answer questions or provide evidence that may incriminate themselves in a criminal case, as protected by the Fifth Amendment of the United States Constitution.</skos:definition>
    </owl:Class>
    


