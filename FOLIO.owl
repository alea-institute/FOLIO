        <skos:altLabel xml:lang="pt-br">Legislação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Législation</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">立法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">立法</skos:altLabel>
        <skos:definition>The enactments or proposed enactments of a legislator or a legislative body.</skos:definition>
        <skos:prefLabel>Bill</skos:prefLabel>
    </owl:Class>
    


