            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion for Summary Judgment</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Zusammenfassendes Urteil</skos:altLabel>
        <skos:altLabel>MSJ</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Resolución Sumaria</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Sentencia Sumaria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Summary Judgment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Julgamento Sumário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue d&apos;un jugement sommaire</skos:altLabel>
        <skos:altLabel>SJ</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין סיכום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सारांश निर्णय के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">判决书申请书</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">略式判決申立書</skos:altLabel>
        <skos:definition>A Motion for Summary Judgment is a request made by a party in a legal case asking the court to rule in their favor without a trial, based on the evidence presented in the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGgWUd90RQdeUSpcqDDxrn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RGgWUd90RQdeUSpcqDDxrn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8tugkQDuOtwhIZjD4hMj9u"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Tip Violation Claim</rdfs:label>
        <skos:altLabel xml:lang="es-es">Reclamación por violación de propina</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por violación de propina</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação de violação de gorjeta</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de violation de pourboire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tip Violation Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verstoß gegen Trinkgeldanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת טיפ</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टिप उल्लंघन दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">チップ違反請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">小费违规索赔</skos:altLabel>
        <skos:definition>A tip violation claim refers to a legal action initiated by an employee, usually in the service industry, alleging that their employer has violated federal, state, or local laws governing tipped employees. Common examples of tip violations include employers improperly pooling tips, taking a portion of tips, or failing to pay the required minimum wage to tipped employees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGgud6WEj4JVLWr3BQEcSy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RGgud6WEj4JVLWr3BQEcSy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sMcpQMoO3EOWAx73lpZ16"/>
        <rdfs:label>Jewish Religion</rdfs:label>
        <skos:altLabel>Hebraism</skos:altLabel>
        <skos:definition>The Jewish Religion, or Judaism, is a monotheistic faith rooted in the covenantal relationship between the God of Abraham, Isaac, and Jacob and the children of Israel, as detailed in the Hebrew Bible. In legal contexts, it often involves issues related to religious freedoms, accommodations for religious observances, and the recognition of Jewish holidays and dietary laws.</skos:definition>
        <skos:example>Conservative Judaism</skos:example>
        <skos:example>Orthodox Judaism</skos:example>
        <skos:example>Reform Judaism</skos:example>
        <skos:prefLabel>Judaism</skos:prefLabel>
    </owl:Class>
    


