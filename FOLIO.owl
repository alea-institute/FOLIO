        <skos:altLabel xml:lang="fr-fr">Motion d&apos;expungement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Expunge</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Movimento para Excluir</skos:altLabel>
