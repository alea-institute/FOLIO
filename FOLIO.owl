        <skos:altLabel xml:lang="en-gb">Stay Execution of Judgment or Order</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Suspension de l&apos;exécution d&apos;un jugement ou d&apos;une ordonnance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Suspensión de la Ejecución de la Sentencia o la Orden</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Suspensión de la Ejecución de la Sentencia o la Orden</skos:altLabel>
