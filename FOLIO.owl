        <rdfs:label>Veterans Health Administration</rdfs:label>
        <skos:altLabel xml:lang="es-es">Administración de Salud de Veteranos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Administración de Salud de Veteranos</skos:altLabel>
