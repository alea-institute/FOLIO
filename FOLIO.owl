        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RjZYQdnDbpjxRszPUNrCK7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Paternity / Parentage Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Action en paternité / filiation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ação de paternidade / filiação</skos:altLabel>
        <skos:altLabel>Parentage Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Paternity / Parentage Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de paternidad / filiación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de paternidad / filiación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vaterschaftsklage / Elternschaftsklage</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת הורות / הוריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पितृत्व / मातृत्व दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">父权 / 亲权索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">父親 / 親子関係の請求</skos:altLabel>
        <skos:definition>A Paternity/Parentage Claim is a legal action brought to establish the identity of a child&apos;s biological father or mother, typically in the context of family law or matrimonial claims.</skos:definition>
        <skos:prefLabel>Paternity Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLJT8v5yTfRQ6xRfJAq59P -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLJT8v5yTfRQ6xRfJAq59P">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
        <rdfs:label>Bank’s Wrongful Payment of Negotiable Instrument</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bank’s Wrongful Payment of Negotiable Instrument</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fehlerhafte Zahlung von verhandelbaren Instrumenten durch die Bank</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pagamento indevido de instrumento negociável pelo banco</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Pago indebido de instrumento negociable por parte del banco</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Pago indebido de instrumento negociable por parte del banco</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Paiement erroné d&apos;un instrument négociable par la banque</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תשלום לא חוקי של כלי כתיבה נגוש על ידי הבנק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बैंक के द्वारा न्यौत्पादिक उपकरण के गलत भुगतान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">銀行による手形の誤払い</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">银行错误支付可转让票据</skos:altLabel>
        <skos:definition>The Bank&apos;s Wrongful Payment of Negotiable Instrument refers to a situation where a bank makes a payment on a negotiable instrument without proper authorization or without verifying the authenticity of the instrument, resulting in a loss to the rightful owner of the instrument.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLLg8Yazwudc8ePg2wA6bM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLLg8Yazwudc8ePg2wA6bM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCTnebwmInNgHYwFLgAOf0z"/>
        <rdfs:label>Resume</rdfs:label>
        <skos:altLabel>CV</skos:altLabel>
        <skos:definition>A &quot;Resume,&quot; also known as a &quot;Curriculum Vitae (CV),&quot; is a concise and structured document that provides an overview of an individual&apos;s education, work experience, skills, achievements, and qualifications. It is typically used for job applications and serves as a summary of an individual&apos;s professional background.</skos:definition>
        <skos:prefLabel>Curriculum Vitae</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLNc7gzywoZLESpwFH8Q7M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLNc7gzywoZLESpwFH8Q7M">
