        <skos:altLabel xml:lang="hi-in">कारण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">原因</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">原因</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cFRBLdfhruFx7wsEihpG2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cFRBLdfhruFx7wsEihpG2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBBtDifX6Pckw5d02IiBWFF"/>
        <rdfs:label>Assignment of Contract Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Assignment of Contract Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de cession de contrat</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cesión de contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de cesión de contrato</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de cessão de contrato</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertragsklausel zur Übertragung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף העברת חוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध शर्त का असाइनमेंट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合同转让条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約譲渡条項</skos:altLabel>
        <skos:definition>The Assignment of Contract Clause is a provision in a contract that allows one party to transfer their rights and obligations to another party, typically for consideration.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cGsSzKeAR0zJXzFLPOdd9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cGsSzKeAR0zJXzFLPOdd9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7uq2Mq8qLUybQoDhVczzZ5"/>
        <rdfs:label>Indiana Superior Court - Jay County</rdfs:label>
        <skos:definition>The Indiana Superior Court - Jay County is a specific court within the Indiana Superior Court system that has jurisdiction over cases within Jay County, Indiana.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cHgzjEuwK8EcXcFkQoi8D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cHgzjEuwK8EcXcFkQoi8D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Standard of Performance Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de norme de performance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Estándar de Desempeño</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Estándar de Desempeño</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de padrão de desempenho</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Leistungsstandards</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Standard of Performance Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תקן ביצוע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रदर्शन मानक शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パフォーマンス基準条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">绩效标准条款</skos:altLabel>
        <skos:definition>A Standard of Performance Clause is a provision in a contract that sets a specific level of performance or quality that must be met by one or both parties involved in the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cIHUn7gvxaOltKIfA7Qta -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cIHUn7gvxaOltKIfA7Qta">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ddsah86bL3tQ5OmO9B7PB"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCPtRu7JjCg1Do3DUtQofho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Security Agreement</rdfs:label>
        <skos:definition>A &quot;Security Agreement&quot; is a legal contract between a debtor and a secured party that outlines the collateral provided by the debtor to secure a loan or other obligation. The agreement defines the terms under which the secured party can take possession of the collateral in the event the debtor defaults.</skos:definition>
        <skos:prefLabel>Securities Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cJI8Stq7R6C0nx2kNnQDY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cJI8Stq7R6C0nx2kNnQDY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Tolowa</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cJmHQvy1P8kH5YhL3zhdi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cJmHQvy1P8kH5YhL3zhdi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7obzFRN58WoEDO4rf137uE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBVUyb38XelMKIl06TX139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Tuition Reimbursement</rdfs:label>
        <skos:definition>Tuition reimbursement refers to a company benefit in which an employer pays back employees for the costs associated with furthering their education, typically for courses or degree programs that are relevant to their current or potential future roles within the company. This benefit often has specific terms, such as grade requirements or staying with the company for a certain period after course completion.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cJxMJn6lAOHm1nNAxW9RP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cJxMJn6lAOHm1nNAxW9RP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Failure to Provide Notice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Défaut de notification</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Failure to Provide Notice</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha em fornecer aviso</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de notificación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de aviso</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unterlassung der Benachrichtigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כשל בספק הודעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सूचना न देने की असफलता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未提供通知</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">通知の不履行</skos:altLabel>
        <skos:definition>The failure of a party to provide proper notification or warning as required by law or contract, which may be used as a defense in civil litigation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cLxNTHXARH6xtJZ2kNYQW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cLxNTHXARH6xtJZ2kNYQW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBwMhlMYnN7SRBNxJwAJ9SF"/>
        <rdfs:comment>a collection where every member is a Role.</rdfs:comment>
        <rdfs:label>oasis:role collection</rdfs:label>
        <skos:definition>A collection of roles defined by the Organization for the Advancement of Structured Information Standards (OASIS), which is a subset of a larger collection.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cNZxZB8pyyRYwDBimKNJj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cNZxZB8pyyRYwDBimKNJj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:label>Telephone Consumer Protection Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Telephone Consumer Protection Act</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação de acordo com a Lei de Proteção ao Consumidor de Telefonia</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Protección al Consumidor de Telecomunicaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Protección al Consumidor de Telecomunicaciones</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu du Telephone Consumer Protection Act</skos:altLabel>
        <skos:altLabel>TCPA</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Telephone Consumer Protection Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק הגנת הצרכן בתחום הטלקומוניקציות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टेलीफोन उपभोक्ता संरक्षण अधिनियम दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">《电话消费者保护法》索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">電話消費者保護法クレーム</skos:altLabel>
        <skos:definition>A Telephone Consumer Protection Act (TCPA) Claim is a legal claim made under the TCPA statute, which prohibits certain telemarketing practices and provides consumers with certain rights related to unwanted phone calls and text messages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cYu4qJbywhjHFU1Ic441L -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cYu4qJbywhjHFU1Ic441L">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2Kr3kWHR9cR4zALXqt1nM"/>
        <rdfs:label>Outperformance Certificate</rdfs:label>
        <skos:altLabel>An Outperformance Certificate, also known as a Leveraged ETF, is a financial instrument that allows disproportionate participation in the positive performance of the underlying asset(s) above a certain strike level. These certificates reflect the underlying price movements 1:1, adjusted by the conversion ratio and any related fees, offering a risk profile comparable to direct investment in the underlying asset(s) but with enhanced potential returns in favorable market conditions.</skos:altLabel>
        <skos:altLabel>Leveraged Certificate</skos:altLabel>
        <skos:prefLabel>Leveraged ETF</skos:prefLabel>
        <skos:prefLabel>Leveraged Exchange Traded Fund</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cfF9aK4pAFRk8d1pKJ984 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cfF9aK4pAFRk8d1pKJ984">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
        <rdfs:label>Joint and Several Liability</rdfs:label>
        <skos:altLabel xml:lang="de-de">Gesamtschuldnerische Haftung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Joint and Several Liability</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad solidaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad solidaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade solidária</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité solidaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות משותפת ופרטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संयुक्त और एकमात्र उत्तरदायित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">连带责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">連帯責任</skos:altLabel>
        <skos:definition>Joint and Several Liability is a legal concept where multiple parties can be held responsible for the same damages or debt, and each party can be held liable for the entire amount.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7clCfObQnfyEPn8VRil9zI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7clCfObQnfyEPn8VRil9zI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motion to Hear Case with Other Case</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf gemeinsame Verhandlung zweier Fälle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para escuchar el caso con otro caso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para escuchar el caso con otro caso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour entendre une affaire avec une autre affaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Hear Case with Other Case</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para ouvir caso com outro caso</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להקשבת התיק עם תיק אחר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मामले को दूसरे मामले के साथ सुनने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">他の事件との共同審理を求める請願</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">将案件与其他案件一起听案的动议</skos:altLabel>
        <skos:definition>A Motion to Hear Case with Other Case is a formal request made in appellate courts to consolidate two or more cases for hearing together.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cllbBtOmXjbDB7XTyebg2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cllbBtOmXjbDB7XTyebg2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDlUNUSYsLydg1YtgDPDCk5"/>
        <rdfs:label>Livestock Farmland</rdfs:label>
        <skos:altLabel>Grazing Land</skos:altLabel>
        <skos:definition>Livestock Farmland pertains to designated agricultural areas used for rearing animals. Legal issues often concern animal welfare laws, property rights, leasing agreements, and related environmental regulations.</skos:definition>
        <skos:prefLabel>Pasture</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7coJULMWSPoIPITP5qUS96 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7coJULMWSPoIPITP5qUS96">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ROaRQTFgM9oWtVX4k6v6I"/>
        <rdfs:label>Failure to Accommodate</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Failure to Accommodate</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha em Acomodar</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de acomodación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta de acomodo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Refus d&apos;adaptation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versäumnis der Unterbringung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כשל בהתאמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आवास की असफलता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未能提供适当安排</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">適切な調整の不履行</skos:altLabel>
        <skos:definition>A claim of failure to accommodate is a legal action taken by an individual, often an employee, alleging that their employer has not made reasonable adjustments or provided necessary support to allow them to perform their job effectively despite having a known disability, religious belief, or other protected characteristic. Employers are required by law, such as the Americans with Disabilities Act (ADA) and Title VII of the Civil Rights Act of 1964, to provide reasonable accommodations for employees with disabilities or religious beliefs, as long as doing so does not cause undue hardship to the employer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cs1OO5PZ7pxIspMZfGI5q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cs1OO5PZ7pxIspMZfGI5q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBVXMCXoBW3Ef1c3VUuU84a"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBe8WASOOp24Pw0SKparbSV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Student&apos;s Dependent Visa</rdfs:label>
        <skos:altLabel xml:lang="en-us">F-2 Visa</skos:altLabel>
        <skos:definition>A Student&apos;s Dependent Visa is a specialized visa category that allows the spouse and dependent children of a student visa holder to accompany them to the host country while they pursue their studies. Depending on the country&apos;s immigration policies, dependents may be allowed to work or study to a limited extent, but the primary purpose of their stay is to reside with the student visa holder.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cwZdGnY26jz3hPtFTS2DU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cwZdGnY26jz3hPtFTS2DU">
