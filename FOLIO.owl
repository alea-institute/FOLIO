                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDhZWHoYtGaz11YejcsN0CS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Automobile Damaged at Parking Facility</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Automóvel danificado em estacionamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Automóvil dañado en aparcamiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Automóvil dañado en estacionamiento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Beschädigtes Auto auf Parkplatz</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Car Damaged in Car Park</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Voiture endommagée sur un parking</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רכב נפגע במתקן חניה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पार्किंग सुविधा में टूटी कार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">停车场损坏的汽车</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">駐車場で損傷した自動車</skos:altLabel>
        <skos:definition>An Automobile Damaged at Parking Facility refers to a legal claim related to property damage caused to a vehicle while parked in a designated parking area, and falls under the broader categories of Property and Premises Liability Claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7lbqYoeuZitiUJsrh5lYIB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7lbqYoeuZitiUJsrh5lYIB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9tZFXPrXQJWHbqSgtCQxJF"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmpvD4XLJx0kkUTZ3QIadI"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/RznfymBGs7WesrwWNzQLov"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RSxEoUiMU4gjY4l6L5xT8z"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Testifying Expert Witness</rdfs:label>
        <skos:altLabel xml:lang="es-es">Perito Testigo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Perito Testigo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sachverständiger Zeuge</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Testemunha perita depoente</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Testifying Expert Witness</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Témoin expert témoignant</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עד מומחה מצהיר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाह विशेषज्ञ साक्षात्कार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">作证专家证人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言専門家証人</skos:altLabel>
        <skos:definition>An expert whom a party retains for consultation, where that expert provides oral testimony and/or a written report.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7lchU2gf0voGJZmGGL0rof -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7lchU2gf0voGJZmGGL0rof">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Native Village of Tanacross</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7lf0A1jIEuJv35dVQwjxlI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7lf0A1jIEuJv35dVQwjxlI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCAIUgUHLdwFdtdPTruyEgL"/>
        <rdfs:label>Simple Agreement for Future Equity</rdfs:label>
        <skos:altLabel>Future Equity Agreement</skos:altLabel>
        <skos:definition>A Simple Agreement for Future Equity (SAFE) is a contractual agreement between an investor and a company wherein the investor provides capital to the company in exchange for the rights to receive equity at a later date. The equity is usually issued during a subsequent financing round, at which point the SAFE converts based on the terms set forth in the agreement.</skos:definition>
        <skos:prefLabel>SAFE Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ljmto05qFOOjMDFYJXgCc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ljmto05qFOOjMDFYJXgCc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
        <rdfs:label>Scènes à Faire</rdfs:label>
        <skos:definition>Scènes à Faire in copyright law refers to scenes, elements, or themes that are standard, necessary, or customary to a particular genre and are therefore not protectable due to their lack of originality. This doctrine acknowledges that certain expressions are indispensable or typical for certain topics or settings and are therefore free for use by all.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7lnHJ7QtcApqKgnLNVLRL4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7lnHJ7QtcApqKgnLNVLRL4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:label>Equal Pay Act Claim</rdfs:label>
        <skos:altLabel>Wage Discrimination Claim</skos:altLabel>
        <skos:definition>An Gender Pay Equality Claim is a legal action alleging violation of a law requiring that men and women in the same workplace be given equal pay for equal work. The claim typically involves issues of gender-based wage discrimination.</skos:definition>
        <skos:prefLabel>Gender Pay Equality Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ltqLFbA95B5Hwmwgf8WgF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ltqLFbA95B5Hwmwgf8WgF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7uzfpLbCGc2taU7nsJBuor"/>
        <rdfs:label>AAA Commercial Arbitration Rules and Mediation Procedures</rdfs:label>
        <skos:altLabel xml:lang="de-de">AAA-Schiedsgerichtsordnung und Mediationsverfahren für den gewerblichen Bereich</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">AAA商业仲裁规则和调解程序</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">AAA商業仲裁規則および調停手続き</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Regras de Arbitragem Comercial AAA e Procedimentos de Mediação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Règles d&apos;arbitrage commercial AAA et procédures de médiation</skos:altLabel>
        <skos:definition>The AAA Commercial Arbitration Rules and Mediation Procedures are a set of guidelines and procedures established by the American Arbitration Association for resolving commercial disputes through arbitration and mediation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7lw1kvfDrIqvdTv04QYbIP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7lw1kvfDrIqvdTv04QYbIP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
        <rdfs:label>Change of Recommendation Covenant</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Alteração da Cláusula de Recomendação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cambio del Convenio de Recomendación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cambio del Convenio de Recomendación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Change of Recommendation Covenant</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Changement de la clause de recommandation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Änderung der Empfehlungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שינוי ברית ההמלצה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सिफारिश निवेदन का बदलाव</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">建议变更契约</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">推奨規定変更</skos:altLabel>
        <skos:definition>A Change of Recommendation Covenant is a provision in a deal protection agreement that requires a target company&apos;s board to recommend a new offer to its shareholders, even if it is less favorable than a previous offer, in exchange for certain protections for the acquirer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7lxeVIOck43eKAMJhZmyXL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7lxeVIOck43eKAMJhZmyXL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
        <rdfs:label>ENT Negligence</rdfs:label>
        <skos:altLabel xml:lang="de-de">ENT Fahrlässigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">ENT Negligence</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">ENT疏忽</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ENT過失</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia ENT</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia de Otorrinolaringología</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência ENT</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence ENT</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בנוירולוגיה וטיפול בגוף האדם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ईएनटी लापरवाही</skos:altLabel>
        <skos:definition>Failure of a healthcare provider to exercise reasonable care, skill, or diligence in the treatment of a patient resulting in harm or injury.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7m1UQGl07ZddtpzqQtvKme -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7m1UQGl07ZddtpzqQtvKme">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:label>Worker Adjustment and Retraining Notification Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über die Benachrichtigung von Arbeitnehmern über Anpassungen und Umschulungen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Notificación de Ajuste y Reentrenamiento de Trabajadores</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Notificación de Ajuste y Reentrenamiento de Trabajadores</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Notificação de Ajuste e Reciclagem de Trabalhadores</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la notification des ajustements et de la formation des travailleurs</skos:altLabel>
        <skos:altLabel>WARN Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Worker Adjustment and Retraining Notification Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת חוק הודעת התאמה והכשרה מחדש של עובדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वर्कर एडजस्टमेंट एंड रीट्रेनिंग नोटिफिकेशन एक्ट क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">《工人调整和再培训通知法》索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">労働者調整再訓練通知法クレーム</skos:altLabel>
        <skos:definition>A WARN Act claim is a legal action initiated by an employee against their employer for not complying with the Worker Adjustment and Retraining Notification (WARN) Act. The WARN Act is a federal law that requires certain employers to provide advance notice of significant layoffs or plant closings to affected employees, as well as to state and local government officials. The claim typically arises when an employer does not comply with the WARN Act&apos;s notice requirements, which can result in employees losing their jobs without sufficient notice or time to find alternative employment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7m3V9EVDL2R68BV2HvvGd1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7m3V9EVDL2R68BV2HvvGd1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxmjoCAyfDHKhwXHlwikL"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9bu7L3xOUfbWLaHRhimQa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Reinsurance Agreement</rdfs:label>
        <skos:definition>A Reinsurance Agreement is a contract where an insurer transfers a portion of its risks to another insurer, known as the reinsurer. This helps the primary insurer manage its risk exposure and maintain solvency by spreading potential large losses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7m3iIocgmkCmBLcoygtKX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7m3iIocgmkCmBLcoygtKX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R80nTp0xPWvxkJonwMOIvBA"/>
        <dc:source rdf:resource="https://www.nih.gov/nih-style-guide/sex-gender-sexuality"/>
        <rdfs:label>Genderqueer</rdfs:label>
        <skos:definition>Genderqueer is a gender identity that falls outside the conventional binary of male or female and may encompass a range of identities that are not exclusively masculine or feminine. Legally, genderqueer individuals may seek recognition and protection under laws pertaining to gender discrimination, harassment, and equality, similar to other non-binary or gender non-conforming identities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7m7hUozBtx7JODLD9VRxlY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7m7hUozBtx7JODLD9VRxlY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bNzp6lTyATfctRVnXr5rl"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7r8FeqnphadygvNP0XHj84"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motorcyclist</rdfs:label>
        <skos:altLabel>Biker</skos:altLabel>
        <skos:definition>A motorcycle driver is an individual who operates a motorcycle, controlling its mechanisms to navigate roads and other environments. This role entails a distinct set of skills and adherence to specific traffic laws to ensure the safety of the driver and other road users.</skos:definition>
        <skos:prefLabel>Motorcycle Driver</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mBPPNZa5Dk7a8ft3v1VbD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mBPPNZa5Dk7a8ft3v1VbD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8s2P5JRpeYL9T6wkTWFLTV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>CLIENT_NAME</rdfs:label>
        <skos:definition>The term CLIENT_NAME refers to a specific data element within the LEDES98BI V5 Format Rev 1-2020 standard, which is used to identify the name of a client in legal billing and invoicing processes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mCyvoLJw7AulQA9McFLU3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mCyvoLJw7AulQA9McFLU3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Blue Lake Rancheria</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mL8NoasPohW19RcS9oqik -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mL8NoasPohW19RcS9oqik">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
        <rdfs:label>Senior Subordinated Credit Ranking</rdfs:label>
        <skos:definition>Senior Subordinated Credit Ranking refers to the priority status of senior subordinated debts, which are ranked above junior and junior subordinated debts but below senior debts in the event of liquidation. This ranking ensures that senior subordinated creditors are paid before junior creditors from the proceeds of the liquidated assets, providing them with a moderate level of security and reduced risk compared to junior debts.</skos:definition>
        <skos:prefLabel>Senior Subordinated Debt Priority</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mLi0c5rJV5GYGGuEi5dmD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mLi0c5rJV5GYGGuEi5dmD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD078pnidakfOC1UdhDigqn"/>
        <rdfs:label>Judgment Lien</rdfs:label>
        <skos:altLabel xml:lang="es-es">Gravamen de Sentencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gravamen de Sentencia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Judgment Lien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Penhora de sentença</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège du jugement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Urteilsverpfändung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גילוי ערעור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फैसला लियन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">判决留置权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決抵当権</skos:altLabel>
        <skos:definition>A judgment lien is a type of lien that is created when a court grants a judgment in favor of a creditor, giving them the right to place a lien on the debtor&apos;s property in order to secure payment of the debt.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy"/>
        <rdfs:label>Copyright Work Types</rdfs:label>
        <skos:definition>Copyright Work Types encompass various forms of creative works such as Derivative Work, Collective Work, and Joint Work, each with unique characteristics and legal implications. Derivative Works are based on pre-existing works, Collective Works involve the assembly of independent works into a single publication, and Joint Works are created by collaboration with merged contributions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mPsut1F9ySs0TTroC9g2T -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mPsut1F9ySs0TTroC9g2T">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDDqZT9xNC4I7mH402nrpml"/>
        <rdfs:label>Key Performance Indicator</rdfs:label>
        <skos:altLabel>Performance Indicator</skos:altLabel>
        <skos:altLabel>Performance Metric</skos:altLabel>
        <skos:altLabel>Success Measure</skos:altLabel>
        <skos:definition>A Key Performance Indicator (KPI) is a quantifiable measure used to evaluate the success of an organization, employee, or process in achieving specific objectives. KPIs are essential for assessing performance, guiding strategic decisions, and improving efficiency across various sectors.</skos:definition>
        <skos:prefLabel>KPI</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mRrzk4AYWd6T2Q9b0Dn0A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mRrzk4AYWd6T2Q9b0Dn0A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R06956a0657387D6513A8528"/>
        <rdfs:label>New York Supreme Court - Nassau County</rdfs:label>
        <skos:definition>The New York Supreme Court - Nassau County is a court of general jurisdiction located in Nassau County, New York, with authority to hear and decide a wide range of civil and criminal cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mSGVYgqs4JBAyPv4JzsMr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mSGVYgqs4JBAyPv4JzsMr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zwKGkogGKIKWSVWb1ItRL"/>
        <rdfs:label>Motion to Admit Involuntarily</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf unfreiwillige Zulassung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Admitir Involuntariamente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Admitir Involuntariamente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion d&apos;admission involontaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Admit Involuntarily</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Admissão Involuntária</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לקבלת כניסה באופן לא רצוני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनजब्त रूप से दाखिल करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">強制的な入場を認める動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制准入动议</skos:altLabel>
        <skos:definition>A Motion to Admit Involuntarily is a request made in a trial court to allow evidence that was obtained without the consent of the person from whom it was taken.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7mT3oM7UJnGCUIq15FYip5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7mT3oM7UJnGCUIq15FYip5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
