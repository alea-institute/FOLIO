        <rdfs:label>Pets</rdfs:label>
        <skos:altLabel>Companion Animals</skos:altLabel>
        <skos:altLabel>House Pets</skos:altLabel>
        <skos:definition>Pets are domesticated animals kept primarily for companionship, enjoyment, or protection rather than for commercial or agricultural purposes. They include a wide variety of animals such as dogs, cats, birds, and reptiles, each governed by specific regulations and care standards.</skos:definition>
        <skos:prefLabel>Domestic Animals</skos:prefLabel>
    </owl:Class>
    


