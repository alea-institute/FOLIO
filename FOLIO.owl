    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGlbB44TUulAQ6IoH8xVVX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGlbB44TUulAQ6IoH8xVVX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8MRtBMmrg5epp6WfJx4lSW"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCOOyyZhW3l3cdenBfC5LT4"/>
        <rdfs:label>eSignatures Management</rdfs:label>
        <skos:definition>eSignatures Management refers to the process of creating, verifying, and managing electronic signatures within the context of contract and document management.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGprXUGC5dXYNVQMZO50Ru -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGprXUGC5dXYNVQMZO50Ru">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3Q1HDu5jO8nvhdbr2Uj0c"/>
        <rdfs:label>Florida Circuit Court - Columbia County - 3rd Circuit Court</rdfs:label>
        <skos:definition>A court located in Columbia County, Florida that is part of the larger Florida Circuit Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGquLtBt00CMIRpIU9jQqB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGquLtBt00CMIRpIU9jQqB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmZbwmBBKWQ3vGof1sh1kB"/>
        <rdfs:label>Involuntary Commitment to a Mental Health Facility</rdfs:label>
        <skos:definition>Involuntary commitment to a mental health facility is a legal process where an individual is mandated to be admitted to a psychiatric hospital or clinic against their will. This typically occurs when the individual poses a significant risk to themselves or others due to a mental disorder, and the decision is often based on medical evaluations and established legal criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGsTH2ii3FRZBJLRhm5WNk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGsTH2ii3FRZBJLRhm5WNk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEWWtS3nM8GE8R4en1abRz"/>
        <rdfs:label>Arkansas Circuit Court - Garland Cty.</rdfs:label>
        <skos:definition>The Arkansas Circuit Court - Garland Cty. is a specific court within the Arkansas Circuit Court system that has jurisdiction over legal matters within Garland County, Arkansas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGyIyCAM6InepO8dPitNdR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGyIyCAM6InepO8dPitNdR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
        <rdfs:label>Intellectual Asset Management</rdfs:label>
        <skos:definition>Intellectual Asset Management refers to the process of identifying, protecting, and maximizing the value of a company&apos;s intellectual property assets, such as patents, trademarks, and copyrights, through strategic planning and legal management.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGzY6GxWecmgsg39XP6QMG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGzY6GxWecmgsg39XP6QMG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmZbwmBBKWQ3vGof1sh1kB"/>
        <rdfs:label>Voluntary Commitment to a Mental Health Facility</rdfs:label>
        <skos:definition>Voluntary commitment to a mental health facility occurs when an individual willingly and knowingly agrees to be admitted to a psychiatric hospital or clinic for treatment. This decision is made without external coercion, and the individual retains the right to request discharge, though there might be conditions or procedures to follow before release.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCH17vR61LKXaU30ajVBbs4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCH17vR61LKXaU30ajVBbs4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
        <rdfs:label>Metadata Scrubbing Management</rdfs:label>
        <skos:definition>Metadata Scrubbing Management refers to the process of removing sensitive or identifying information from electronic documents and files.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCH1NJTVGwEmadkYOldsHtQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCH1NJTVGwEmadkYOldsHtQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzxVprwB3RwZ8EMewt18Jt"/>
        <rdfs:label>Mutual Fund</rdfs:label>
        <skos:definition>A Mutual Fund is an investment vehicle that pools money from various investors to purchase a diversified portfolio of assets, which can include stocks, bonds, money market instruments, or other securities. Managed by professional portfolio managers, the fund aims to generate returns for its investors according to its stated investment objectives, while spreading risk across a range of assets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCH2WttNe5K5xi0HS74SOhs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCH2WttNe5K5xi0HS74SOhs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9EU57yyGYQyG3GeOJ1VgMr"/>
        <rdfs:label>Technology Procurement Services</rdfs:label>
        <skos:definition>Technology Procurement Services refers to the process of acquiring technology products and services for an organization, typically involving consulting and management services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCH6QfDmL0LVgc1n4uJvwKk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCH6QfDmL0LVgc1n4uJvwKk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs"/>
        <rdfs:label>Recognition of Foreign Insolvency</rdfs:label>
        <skos:definition>Recognition of foreign insolvency involves a domestic court acknowledging and giving effect to an insolvency proceeding initiated in another country. This legal process facilitates cooperation between jurisdictions, enabling efficient administration and resolution of cross-border insolvency cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCH9bm46SJokYFChlK01xIX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCH9bm46SJokYFChlK01xIX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKrakJNv6b1oTTMhd4c5DU"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Business License</rdfs:label>
        <skos:definition>A business license is a permit or certification issued by a governmental authority that allows an individual or company to operate a business within a specific jurisdiction. The license serves as proof of compliance with local, state, or federal regulations and is often required for tax purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHDcnDi0HyufCk0sbUQbeS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHDcnDi0HyufCk0sbUQbeS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:label>Equity Security Holders List</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Equity Security Holders List</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lista de detentores de títulos de participação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lista de titulares de valores de renta variable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lista de titulares de valores de renta variable</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Liste der Eigenkapitalinhaber</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Liste des détenteurs de titres de participation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רשימת בעלי ניירות ערך של שווי ריבית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इक्विटी सुरक्षा धारक सूची</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">株式証券保有者リスト</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">股权证券持有人名单</skos:altLabel>
        <skos:definition>A list of individuals or entities who hold equity securities in a company, typically used in bankruptcy and restructuring proceedings to determine the distribution of assets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHEH9WuYl4sNbdfqEDZgmN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHEH9WuYl4sNbdfqEDZgmN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7R1YAozFcvfvIX32msHyay"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9tZFXPrXQJWHbqSgtCQxJF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Right to Confront Witnesses</rdfs:label>
        <skos:altLabel xml:lang="es-es">Derecho a Confrontar Testigos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho a Confrontar Testigos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito de confrontar testemunhas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit de confronter les témoins</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht auf Konfrontation von Zeugen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right to Confront Witnesses</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות למעמד עדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाहों के सामने अधिकार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">与证人对抗的权利</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証人尋問権</skos:altLabel>
        <skos:definition>The right to confront witnesses is a fundamental aspect of a fair trial, ensuring that a defendant in a criminal case has the opportunity to question or cross-examine the witnesses testifying against them. Protected by the Sixth Amendment of the United States Constitution, this right enables the defense to challenge the credibility, accuracy, and reliability of the witnesses&apos; testimony, and helps ensure that the trial process is transparent and adversarial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHFVA6tqw2Zwmq2TqSmjcV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHFVA6tqw2Zwmq2TqSmjcV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8A4a837BE2d5AB3c793565b"/>
        <rdfs:label>Mississippi County Court</rdfs:label>
        <skos:definition>Mississippi County Court refers to a court of law that operates within the jurisdiction of a specific county in Mississippi and is responsible for hearing and deciding cases related to civil and criminal matters within that county.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHGm8QnXf6xcUgIKQWaZ9z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHGm8QnXf6xcUgIKQWaZ9z">
