        <skos:definition>Analysis, advice and/or opinions regarding potential bankruptcy related issues, where no bankruptcy case has been filed</skos:definition>
        <skos:prefLabel>B410 General Bankruptcy Advice/Opinions</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RVu433XojPQPseoDXhidgO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RVu433XojPQPseoDXhidgO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7z0ey8ZMeOT1q01VNPe1HY"/>
        <rdfs:label>Population Density Market Segment</rdfs:label>
        <skos:definition>The population density market segment classifies consumers or businesses based on the density of people in their geographic area, such as urban, rural, or suburban regions. This segmentation helps businesses understand and address the varying needs, preferences, and purchasing behaviors of customers living in areas with different levels of population concentration.</skos:definition>
        <skos:prefLabel>Area Density Market Segment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RVu6AgZO4SQGptuNzFn4C_Q -->

