        <skos:altLabel xml:lang="ja-jp">供給契約</skos:altLabel>
        <skos:definition>A supply agreement is a legally binding contract between two parties that outlines the terms and conditions for the supply and delivery of goods or services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KqztuWJAcs81DIE0K8zRD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KqztuWJAcs81DIE0K8zRD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Native Village of Ekwok</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KsFvVNE5x9EvtbgtiaiPd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KsFvVNE5x9EvtbgtiaiPd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RboBIGLNpJANLf0bWUxJVX"/>
        <rdfs:label>Multilateral Governmental Policy Representations</rdfs:label>
        <skos:definition>Multilateral Governmental Policy Representations refer to the legal practice of representing a client&apos;s interests in multiple jurisdictions or before various international bodies simultaneously. This practice requires a comprehensive understanding of different legal systems, treaties, and international regulations to effectively advocate for the client across borders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Kt1BGh5cJfFNgHJj0WtBI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Kt1BGh5cJfFNgHJj0WtBI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBe8WASOOp24Pw0SKparbSV"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDeZlellOVEkUBkTSbLgxUC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Vocational Student Visa</rdfs:label>
        <skos:altLabel>M-1 Visa</skos:altLabel>
        <skos:altLabel>The Vocational Student Visa (in the U.S., the M-1 visa) is a non-immigrant visa for students who wish to pursue vocational or non-academic training or education. This visa does not permit full-time university or college study, and its duration is generally for the length of the vocational program up to a maximum of one year, with some options for extension</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KwjAGH04YXSDBLO1OrlxR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KwjAGH04YXSDBLO1OrlxR">
