        <rdfs:label>Scenic and Sightseeing Transportation, Other</rdfs:label>
        <skos:definition>See industry description for 487990.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BOCMoh3VRdqwHoUwVmm2fQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BOCMoh3VRdqwHoUwVmm2fQ">
