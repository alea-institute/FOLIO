        <skos:altLabel xml:lang="pt-br">Padrão de esforços antitruste planos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Standard für flache Wettbewerbsbemühungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקן מאמצי נגד- trust שטוחים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फ्लैट एंटीट्रस्ट एफर्ट्स मानक</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フラット反トラスト努力規格</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">平面反垄断努力标准</skos:altLabel>
        <skos:definition>A Flat Antitrust Efforts Standard is a provision within antitrust efforts that requires a company to make a consistent effort to comply with antitrust laws, without any specific benchmarks or goals to meet.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJufYZeEdrxyDZJftTjwnO -->

