        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9h5aaQVsZ4v7eZ45w3c8EG"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R91pKiisIKUznRxqDYHu0bu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Invoice</rdfs:label>
        <skos:altLabel xml:lang="es-es">Factura</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Factura</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Facture</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fatura</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Invoice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechnung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חשבונית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चालान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">发票</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">請求書</skos:altLabel>
        <skos:definition>An invoice is a document issued by a seller to a buyer that details the products or services provided, their quantities, and the agreed prices for these goods or services. It serves as a formal request for payment and often includes additional information such as the date of the transaction, terms of payment, and the business&apos;s contact information. Legal invoices frequently include time entries and timekeeper narratives.</skos:definition>
        <skos:definition>Invoice includes timekeeper narratives and time entries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCiOeXNvaijCncX3j0UvHeF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCiOeXNvaijCncX3j0UvHeF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu"/>
        <rdfs:label>Internet Corporation for Assigned Names and Numbers</rdfs:label>
        <skos:definition>The Internet Corporation for Assigned Names and Numbers (ICANN) is an international, non-profit organization responsible for coordinating the management of the internet&apos;s domain name system (DNS), IP address space allocation, and protocol parameter assignment. ICANN plays a crucial role in ensuring the stability and security of the internet by overseeing the distribution and maintenance of unique identifiers used in the global network.</skos:definition>
        <skos:prefLabel>ICANN</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCiPTfOycCVxG7NV70jFxUq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCiPTfOycCVxG7NV70jFxUq">
