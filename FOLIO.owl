    <!-- https://folio.openlegalstandard.org/RpJaHVwgUyWMAHbsHog6k7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RpJaHVwgUyWMAHbsHog6k7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RpiyvcnyPAZ5hygNt0zO3j"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_18"/>
        <rdfs:label>Major Joint Dysfunction in Extremities</rdfs:label>
        <skos:definition>An abnormality of a major joint in any extremity refers to a condition where a significant joint in the arms or legs, such as the hip, knee, shoulder, or elbow, exhibits structural or functional deviations from the norm. These abnormalities can arise from congenital defects, injuries, or degenerative diseases and may affect joint mobility, stability, and overall function.</skos:definition>
        <skos:prefLabel>Abnormality of Major Joint in Any Extremity</skos:prefLabel>
    </owl:Class>
    


