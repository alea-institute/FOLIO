    <!-- https://folio.openlegalstandard.org/RBisl4Hku74Euy3AAAODOj2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBisl4Hku74Euy3AAAODOj2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UYJUZ3D37DD8nEuNUXXti"/>
        <rdfs:label>Paroled Refugee</rdfs:label>
        <skos:altLabel>Humanitarian Parolee</skos:altLabel>
        <skos:definition>A Paroled Refugee is an individual who has been allowed entry into a country on a temporary basis for urgent humanitarian reasons or significant public benefit, even though they do not meet the regular admission requirements for refugees. This status provides temporary legal presence in the host country while the individual’s case is reviewed or until more permanent arrangements can be made.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBix5fW3COPX4xfo2aJNBZa -->

