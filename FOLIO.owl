        <rdfs:label>Medical Malpractice Defenses</rdfs:label>
        <skos:altLabel xml:lang="es-es">Defensas de Mala Praxis Médica</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Defensas de Mala Praxis Médica</skos:altLabel>
