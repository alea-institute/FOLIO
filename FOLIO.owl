        <rdfs:label>Application to Have Filing Fee Waived</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Befreiung von der Einreichungsgebühr</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Application to Have Filing Fee Waived</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande de dispense de frais de dépôt</skos:altLabel>
