        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDGdgxwCGXpkY1zfT2WwGl9"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDR762ETZykxzu0RfYBxNu9"/>
        <rdfs:label>Employee Stock Ownership Plans Law</rdfs:label>
        <skos:altLabel>ESOP Law</skos:altLabel>
        <skos:altLabel>Employee Share Ownership Law</skos:altLabel>
        <skos:definition>Employee Stock Ownership Plans Law refers to the legal framework governing the establishment, management, and regulation of Employee Stock Ownership Plans (ESOPs), which allow employees to acquire ownership interests in their employer. This body of law includes statutes, regulations, and case law that ensure ESOPs are operated in the best interest of the employees and comply with tax and labor laws.</skos:definition>
        <skos:prefLabel>Employee Equity Participation Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ScMFGdsclnzXQxJJh4qN1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ScMFGdsclnzXQxJJh4qN1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Monacan Indian Nation</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Scl6Rq9sPzgThnTlkTZ8C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Scl6Rq9sPzgThnTlkTZ8C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfBdQ771UMEZMpb5zTUXAZ"/>
        <rdfs:label>Likelihood of Adverse Result</rdfs:label>
        <skos:altLabel>Likelihood of Adverse Result</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Likelihood of Adverse Result</skos:altLabel>
        <skos:altLabel>Likelihood of Conviction</skos:altLabel>
        <skos:altLabel>Likelihood of Liability</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Probabilidad de resultado adverso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Probabilidad de resultado adverso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Probabilidade de Resultado Adverso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Probabilité de résultat défavorable</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wahrscheinlichkeit eines ungünstigen Ergebnisses</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסתברות לתוצאה שלילית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुकूलता की संभावना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不良結果の可能性</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不良结果的可能性</skos:altLabel>
        <skos:definition>Likelihood of an adverse result (e.g., client liability, client convicted) — sometimes expressed as a percentage, and sometimes expressed as a classification (e.g., Very High, High, Medium, Low)</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8SmjtKjXa7BlkZuLWRJub3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8SmjtKjXa7BlkZuLWRJub3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOtHAspaFqAn6etwaV6JMm"/>
