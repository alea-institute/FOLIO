        <rdfs:label>Duration of the Contract Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de durée du contrat</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de duración del contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de duración del contrato</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de duração do contrato</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Duration of the Contract Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Vertragsdauer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף משך החוזה</skos:altLabel>
