        <skos:altLabel xml:lang="ja-jp">腫瘍学医療過誤</skos:altLabel>
        <skos:definition>Negligent or wrongful actions or omissions by a medical professional in the field of oncology, resulting in harm or injury to a patient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOcmtJjE35asuo2CYDS67l -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOcmtJjE35asuo2CYDS67l">
