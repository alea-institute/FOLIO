                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RB8HabSdO9WeY2vpA4OAbE6"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prima Facie Tort</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Prima Facie Tort</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Prima-facie-Tort</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tort prima facie</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Torto prima facie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tortura Prima Facie</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tortura Prima Facie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טורט פרימה פציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्राइमा फेसी टॉर्ट</skos:altLabel>
