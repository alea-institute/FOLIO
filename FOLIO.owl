        <skos:altLabel xml:lang="ja-jp">物質資金の適用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">物质资金应用</skos:altLabel>
        <skos:definition>The concept of &quot;Matter Funds Applied&quot; refers to the portion of an engagement fee that is specifically allocated to cover expenses related to a particular legal matter, as opposed to the fee being applied generally to the overall engagement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kYnSD5e2yIyfslBXH9cLK -->

