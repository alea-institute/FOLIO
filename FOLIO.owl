        <skos:altLabel>Settlement Method</skos:altLabel>
        <skos:altLabel>Settlement Type</skos:altLabel>
        <skos:definition>The Asset Delivery Attribute indicates whether the settlement of an option, when exercised, is made in cash or involves the physical delivery of the underlying instruments. This attribute defines the method by which the option holder receives value upon exercising the option.</skos:definition>
        <skos:prefLabel>Asset Settlement Mode</skos:prefLabel>
    </owl:Class>
    


