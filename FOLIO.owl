        <rdfs:label>Motor Vehicle Metal Stamping</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in manufacturing motor vehicle stampings, such as fenders, tops, body parts, trim, and molding.</skos:definition>
    </owl:Class>
    


