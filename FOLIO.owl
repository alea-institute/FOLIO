        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Lack of Insurance Coverage</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Absence de couverture d&apos;assurance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de cobertura de seguro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta de cobertura de seguro</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falta de cobertura de seguro</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lack of Insurance Coverage</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mangelnde Versicherungsdeckung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר כיסוי ביטוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बीमा कवरेज की कमी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保険のカバー不足</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">缺乏保险覆盖</skos:altLabel>
        <skos:definition>Lack of insurance coverage refers to a situation where an individual or entity does not have an insurance policy, or the existing policy does not cover a specific risk, loss, or event. This can result in financial liability for the uninsured party, who must bear the cost of any damages or losses incurred.</skos:definition>
    </owl:Class>
    


