        <rdfs:label>Trespassing Livestock Causing Harm</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Animais domésticos causando danos por invasão</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Animaux domestiques causant des dommages par effraction</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Intrusión de ganado causando daño</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Intrusión de ganado causando daño</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trespassing Livestock Causing Harm</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vieh, das Schaden verursacht, betritt widerrechtlich das Grundstück</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מקרים של בעלי חיים שפורצים וגורמים נזק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हानि का कारण बनने वाले अतिक्रमण करने वाले पशु</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">侵入する家畜による被害</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法入侵的牲畜造成伤害</skos:altLabel>
        <skos:definition>The concept of Trespassing Livestock Causing Harm refers to the legal claim that arises when someone&apos;s animals enter another person&apos;s property without permission and cause damage or injury.</skos:definition>
    </owl:Class>
    


