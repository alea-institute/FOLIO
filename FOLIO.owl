        <skos:altLabel xml:lang="zh-cn">楚瓦什语</skos:altLabel>
        <skos:definition>Chuvash (Language) is a structured system of communication that consists of grammar and vocabulary specific to the Chuvash people and culture.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8GRLVVkKApMEMmleQyPj1Z -->

