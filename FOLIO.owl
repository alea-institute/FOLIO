        <rdfs:label>Georgia District Court - Evans County</rdfs:label>
        <skos:definition>Georgia District Court - Evans County: A court of law in the state of Georgia that has jurisdiction over legal disputes and criminal cases within Evans County.</skos:definition>
    </owl:Class>
    


