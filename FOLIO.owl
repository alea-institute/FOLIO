        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCIQtHHdQl861KZaBklud18"/>
        <rdfs:label>Lawyer</rdfs:label>
        <skos:altLabel xml:lang="es-es">Abogado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Abogado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Advogado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Anwalt</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Avocat</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Barrister</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lawyer</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Solicitor</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Solicitor/Barrister</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עו&quot;ד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वकील</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">弁護士</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">律师</skos:altLabel>
        <skos:definition>A lawyer is a legal professional who provides legal advice and representation to clients in various legal matters, including litigation, transactions, and regulatory compliance.</skos:definition>
        <skos:prefLabel>Attorney</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcUQjieg6jZJk6oJvLLsSh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcUQjieg6jZJk6oJvLLsSh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Appointment of Successor Trustee Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Appointment of Successor Trustee Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de nomination d&apos;un fiduciaire successeur</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de nombramiento de fideicomisario sucesor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de nombramiento de fideicomisario sucesor</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de nomeação de um administrador sucessor</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Ernennung eines Nachfolge-Testamentsvollstreckers</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מינוי ממלא תפקיד יורש נאמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्तराधिकारी ट्रस्टी क्लॉज का नियुक्ति अनुच्छेद</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">任命继任受托人条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">後継信託管理者の任命条項</skos:altLabel>
        <skos:definition>An Appointment of Successor Trustee Clause is a provision in a contract that designates a person or entity to take over as trustee in the event that the original trustee is unable or unwilling to continue serving.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKyQq2d2O4kCcP6LbXtuCz"/>
        <rdfs:label>Social Rights</rdfs:label>
        <skos:definition>Social rights are the rights that focus on ensuring individuals have access to essential social services and protections, such as healthcare, education, and housing. Often considered a subset of economic rights, social rights aim to provide a safety net and foster social cohesion, and they may be protected by international treaties as well as national laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcVabDAyOfCmuIYjaqoxHf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcVabDAyOfCmuIYjaqoxHf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSYBzf149Mi5KE0YtmpUmr"/>
        <dc:identifier>TAXR</dc:identifier>
        <rdfs:label>Tax and Revenue Law</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Derecho Fiscal y de Ingresos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Derecho Tributario y Fiscal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito Tributário e de Receitas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit fiscal et des revenus</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Steuer- und Einnahmenrecht</skos:altLabel>
        <skos:altLabel>Tax and Revenue Law</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tax and Revenue Law</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוקי מסים והכנסות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कर और राजस्व विधि</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">税務・収益法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">税收法</skos:altLabel>
        <skos:definition>Law which deals with the constitutional, common-law, statutory, tax treaty, and regulatory rules that constitute the law applicable to taxation.</skos:definition>
        <skos:hiddenLabel>TAXR</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcW4pUMnXuufMtnyvdX0dB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcW4pUMnXuufMtnyvdX0dB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pDifEQPZakjZCBdUYZVOW"/>
        <rdfs:label>M&amp;A Supplemental Agreement</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RccmkBspE9N2VkexAeF8LX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RccmkBspE9N2VkexAeF8LX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNok1Pv9Qm5zVhe94vZGiV"/>
        <rdfs:label>Renewable Energy Law Objectives</rdfs:label>
        <skos:altLabel>Clean Energy Goals</skos:altLabel>
        <skos:altLabel>Sustainable Energy</skos:altLabel>
        <skos:definition>Renewable Energy Law Objectives refer to the legal and regulatory goals aimed at promoting the development, deployment, and integration of renewable energy sources into the energy mix. These objectives address environmental, economic, social, and technological aspects to ensure a transition to sustainable energy systems.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RccxQ21LARDiCtG8SaB-ABw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RccxQ21LARDiCtG8SaB-ABw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rg1FUWqjmQ3ClUqt8uHT_4g"/>
        <rdfs:label>L632 Scanning - Hard Copy</rdfs:label>
        <skos:definition>Includes OCR, production of metadata, and other services involved around scanning</skos:definition>
        <skos:prefLabel>L632 Scanning - Hard Copy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RceM7BMd4OmxX00dRlAprg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RceM7BMd4OmxX00dRlAprg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7z8IPBHMwVOHP53OFYeSZN"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/6.00-Genitourinary-Adult.htm#6_06"/>
        <rdfs:label>Nephrotic Syndrome</rdfs:label>
        <skos:altLabel>Nephrotic Disorder</skos:altLabel>
        <skos:altLabel>Proteinuria Syndrome</skos:altLabel>
        <skos:definition>Nephrotic Syndrome is a kidney disorder characterized by excessive protein loss in the urine, low blood protein levels, high cholesterol, and swelling (edema). This condition results from damage to the kidney&apos;s filtering units (glomeruli) and can lead to complications requiring medical management.</skos:definition>
        <skos:prefLabel>Nephrosis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RceZ38f0Kx5YV2ri1nUyMf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RceZ38f0Kx5YV2ri1nUyMf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D"/>
        <rdfs:label>Misfeasance in Public Office</rdfs:label>
        <skos:altLabel>Abuse Of Public Office</skos:altLabel>
        <skos:altLabel>Malfeasance In Public Office</skos:altLabel>
        <skos:altLabel>Public Officer Misconduct</skos:altLabel>
        <skos:definition>Misfeasance in public office is a legal cause of action in some jurisdictions (e.g., United Kingdom), where a public officer abuses their position by acting unlawfully with malice or reckless disregard for the harm caused. This tort requires proof of deliberate wrongful conduct by the officer, resulting in damage to the claimant.</skos:definition>
        <skos:prefLabel>Official Misconduct</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcedW7umYlqo0ua5vLpBub -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcedW7umYlqo0ua5vLpBub">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Affiliate Non-Debtor</rdfs:label>
        <skos:altLabel>Affiliated Non-Debtor</skos:altLabel>
        <skos:altLabel>Associated Non-Debtor</skos:altLabel>
        <skos:altLabel>Connected Non-Debtor</skos:altLabel>
        <skos:altLabel>Related Non-Debtor</skos:altLabel>
        <skos:definition>An affiliate non-debtor is a company or entity related to a debtor through common ownership, control, or significant financial interest, but which itself is not undergoing bankruptcy proceedings. Such entities may be involved in the bankruptcy case due to financial ties, guarantees, or shared obligations with the debtor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rcfgxuij0em7k0pjQKFJCm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rcfgxuij0em7k0pjQKFJCm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Recreational Immunity</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftungsausschluss für Freizeitaktivitäten</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Immunité récréative</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imunidade recreativa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inmunidad recreativa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad recreativa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Recreational Immunity</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות רפואית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मनोरंजन अवरोध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">レクリエーショナル免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">娱乐豁免</skos:altLabel>
        <skos:definition>Recreational immunity exists as a defense for owners and/or occupiers of land as long as the plaintiff&apos;s recreational use was uninvited, used without fee, and there was no unreasonable risks that the owner/occupier should have known or knew existed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rcg25mdkNuZujwumYxjJUt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rcg25mdkNuZujwumYxjJUt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCz0OhGJQscjwPvw2jQBP63"/>
        <rdfs:label>New York City Court - New Rochelle</rdfs:label>
        <skos:definition>A court located in New Rochelle that operates under the jurisdiction of the New York City Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rchk64a0YSX6o4ZBkwLz3GA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rchk64a0YSX6o4ZBkwLz3GA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RozngCLFFS3CuoIzXO44N9A"/>
        <rdfs:label>TR699 Other Trademark Prosecution - International</rdfs:label>
        <skos:definition>Use only for trademark prosecution activities in connection with applications that are (&quot;international&quot;) filed outside the home country or region of the applicant, and that can not be included under a previous code, or as instructed by the client.</skos:definition>
        <skos:prefLabel>TR699 Other Trademark Prosecution - International</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rchny3YFXoQyenv6XUbyo0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rchny3YFXoQyenv6XUbyo0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R73Uo5x4VyfiOXt6i4R256t"/>
