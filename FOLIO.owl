        <rdfs:label>Statutory Immunity</rdfs:label>
        <skos:altLabel xml:lang="de-de">Gesetzliche Immunität</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Immunité légale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imunidade estatutária</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inmunidad Estatutaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad Estatutaria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Statutory Immunity</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות חוקתית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी संरक्षण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法定免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法定豁免</skos:altLabel>
        <skos:definition>Statutory Immunity is a legal concept that provides protection from legal action to government officials or entities who are acting within the scope of their duties as defined by a specific statute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RfDzMtuMPdmNTonmhBxu -->

