        <skos:altLabel xml:lang="en-gb">Involuntary Dismissal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Rejet involontaire</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unfreiwillige Abweisung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים לא רצוניים</skos:altLabel>
