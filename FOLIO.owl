            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>L140 Document/File Management</rdfs:label>
        <skos:definition>The concept of L140 Document/File Management refers to the organization, storage, and retrieval of legal documents and files within a case, as a part of the overall case assessment, development, and administration process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBl1hItEnqhZyZo15Zn32St -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBl1hItEnqhZyZo15Zn32St">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9PQzGkaFkFgcMvZOKrmbqT"/>
        <rdfs:label>Moment</rdfs:label>
        <skos:definition>In legal terms, a Moment (Point in Time) refers to a precise, specific point on the timeline, often critical in determining the applicability, initiation, or cessation of legal rights, duties, or conditions. It is essential in contexts such as the execution of contracts, occurrence of events triggering legal consequences, or the effective date of legislation.</skos:definition>
        <skos:prefLabel>Point in Time</skos:prefLabel>
    </owl:Class>
    


