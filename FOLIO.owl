        <rdfs:label>Tigre</rdfs:label>
        <skos:altLabel xml:lang="de-de">Tigre</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tigre</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tigre</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ティグレ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提格雷</skos:altLabel>
        <skos:definition>Tigre is a language that belongs to the Afro-Asiatic family and is spoken in Eritrea and Sudan.</skos:definition>
