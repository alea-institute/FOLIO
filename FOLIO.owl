        <skos:altLabel xml:lang="es-mx">Moción de Conversión</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Convert</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Conversão</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête de conversion</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להמרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रूपांतरण के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">変換申立書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">转换动议</skos:altLabel>
        <skos:definition>A Motion to Convert is a request made in a bankruptcy case to change the type of bankruptcy being filed, typically from Chapter 13 to Chapter 7.</skos:definition>
    </owl:Class>
    


