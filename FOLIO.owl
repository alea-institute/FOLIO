        <rdfs:label>Texas Court of Appeals - 3d</rdfs:label>
        <skos:definition>The Texas Court of Appeals - 3d is a specific intermediate appellate court in Texas that hears appeals from lower courts within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBd1clKZgj2xZh3Hi4reLVQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBd1clKZgj2xZh3Hi4reLVQ">
