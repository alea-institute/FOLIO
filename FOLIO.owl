        <skos:altLabel xml:lang="es-mx">Moción para completar la producción del acta de transcripción de los reporteros a expensas del gobierno</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour achever la production du transcript des reporters aux frais du gouvernement</skos:altLabel>
