    <!-- https://folio.openlegalstandard.org/R99hAIIt4d9M4gVLWNXntqw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R99hAIIt4d9M4gVLWNXntqw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
        <rdfs:label>Junior Subordinated Credit Ranking</rdfs:label>
        <skos:altLabel>Bottom Tier Debt</skos:altLabel>
        <skos:altLabel>Bottom-Rank Subordinated Debt</skos:altLabel>
        <skos:definition>Junior Subordinated Credit Ranking refers to the priority status of junior subordinated debts, which are ranked below all other debts, including senior, senior subordinated, and junior debts, in the event of liquidation. This ranking ensures that junior subordinated creditors are the last to be paid from the proceeds of the liquidated assets, providing them with the lowest level of security and the highest risk compared to other creditors.</skos:definition>
        <skos:prefLabel>Lowest Priority Debt</skos:prefLabel>
    </owl:Class>
    


