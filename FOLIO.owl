        <skos:altLabel xml:lang="zh-cn">骚扰</skos:altLabel>
        <skos:definition>A nuisance is a legal claim that arises from the use of one&apos;s property or conduct that interferes with another&apos;s use or enjoyment of their property, resulting in harm or annoyance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8H00d8bXbHiknExnNFI3CR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8H00d8bXbHiknExnNFI3CR">
