        <dc:identifier>TRA-GRDT</dc:identifier>
        <rdfs:label>Transit and Ground Passenger Transportation Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria del transporte de pasajeros terrestre y de tránsito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria del transporte terrestre y de pasajeros en tránsito</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie du transport en commun et des passagers terrestres</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de transporte de passageiros em trânsito e terrestre</skos:altLabel>
        <skos:altLabel>Transit and Ground Passenger Transportation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transit and Ground Passenger Transportation Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Transit- und Bodenpassagiertransportbranche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית התחבורה הציבורית והאזורית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रांजिट और ग्राउंड पैसेंजर परिवहन उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共交通および地上旅客輸送業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公共交通和地面客运行业</skos:altLabel>
        <skos:definition>Industries in this group include a variety of passenger transportation activities, such as urban transit systems; chartered bus, school bus, and interurban bus transportation; and taxis.</skos:definition>
        <skos:hiddenLabel>GRDT</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9aAuY31Z3tgpR7hUAqTEmd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9aAuY31Z3tgpR7hUAqTEmd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/REFNhmFYG6yk3W0RPLFV6g"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_18"/>
        <rdfs:label>Traumatic Brain Injury</rdfs:label>
        <skos:altLabel>TBI</skos:altLabel>
        <skos:definition>Traumatic brain injury (TBI) is a disruption in normal brain function caused by an external mechanical force, such as a blow or jolt to the head. TBI can result in temporary or permanent cognitive, physical, and psychological impairments, requiring immediate medical attention and often long-term rehabilitation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9aHX0YWVEiSlueAEV234XV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9aHX0YWVEiSlueAEV234XV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KdQLWwrvkyzohDgf48st7"/>
        <rdfs:label>Application for Patent Registration</rdfs:label>
        <skos:definition>An Application for Patent Registration is a formal request submitted to a patent office for the grant of a patent on a specific invention or discovery. The application typically includes a written specification describing the invention in detail, any applicable drawings, and claims that define the scope of the protection sought</skos:definition>
        <skos:prefLabel>Patent Application</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9aPd17Cb8wTbqBJQiND1By -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9aPd17Cb8wTbqBJQiND1By">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aoLYQoIooB9xRkhiMtgR4"/>
        <rdfs:label>Night Blindness</rdfs:label>
        <skos:altLabel>Night Vision Deficiency</skos:altLabel>
        <skos:definition>Night Blindness, also known as Nyctalopia, is a visual impairment that affects an individual&apos;s ability to see in low light or darkness. This condition can result from various underlying issues such as retinal disorders, vitamin A deficiency, or cataracts, and significantly impacts activities that require good vision in dim lighting.</skos:definition>
        <skos:prefLabel>Nyctalopia</skos:prefLabel>
    </owl:Class>
    


