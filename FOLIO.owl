        <skos:altLabel xml:lang="pt-br">Estipulação para Compromisso de Controvérsia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Stipulation pour compromis de controverse</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stipulation to Compromise Controversy</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergleichsvereinbarung zur Beilegung von Streitigkeiten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם לפשרת סכסוך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विवाद को समझौते के लिए अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">和解争议协议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">紛争解決の妥結に関する規定</skos:altLabel>
        <skos:definition>A Stipulation to Compromise Controversy is a legal agreement between parties to settle a dispute by making concessions and coming to a mutual agreement.</skos:definition>
    </owl:Class>
    


