        <skos:definition>Finding of fact as adopted by a decisionmaker (e.g., judge, magistrate, arbitrator).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Zwd84vqcynsz8PsQJt7xj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Zwd84vqcynsz8PsQJt7xj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Entertainment Visa</rdfs:label>
        <skos:altLabel>Entertainer Visa</skos:altLabel>
        <skos:altLabel>P-1B Visa</skos:altLabel>
        <skos:definition>The Entertainment Visa (in the U.S., P-1B Visa), is designed for members of internationally recognized entertainment groups that wish to perform in the destination country (e.g., U.S.). In the United States, this non-immigrant visa allows the entertainers to stay for the duration of the event, competition, or performance, with an initial period of up to one year, which can be extended in increments of up to one year for continued performances or events</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Zx0Z5V6kJy0JWEnLV91S8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Zx0Z5V6kJy0JWEnLV91S8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motions for Bail</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anträge auf Kaution</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones de libertad bajo fianza</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones de libertad bajo fianza</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motions for Bail</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions pour la libération sous caution</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedidos de liberdade provisória</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות לשחרור על עזבון ערבות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जमानत के लिए याचिकाएं</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保釈請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保释动议</skos:altLabel>
        <skos:definition>A Motion for Bail is a formal request made to a court by a defendant or their attorney, asking for the release of the defendant from custody pending trial or appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Zymc3xp7oUcp7PF4AsljK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Zymc3xp7oUcp7PF4AsljK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHfeijrOTjaF7qpuoGIGkR"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
