        <skos:altLabel xml:lang="he-il">הגדרת &quot;השפעה נזיקית משמעותית&quot; - יוצאים מן הכלל - כשל בהצגת ההכנסות</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">“实质性不利影响”定义-例外-未达到预期</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">「重大な不利益影響」の定義-例外-予測の達成失敗</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7eATaojOKUvWDxLLinFIxg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7eATaojOKUvWDxLLinFIxg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
        <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
        <rdfs:label>Stakeholders and Partnerships Risk</rdfs:label>
        <skos:definition>The threats and opportunities associated with an organization&apos;s partners and stakeholder demographics, characteristics, and activities. This includes the potential for negative consequences arising from an organization&apos;s inability to effectively manage relationships with key stakeholders, such as customers, suppliers, investors, or partners. Causes can include poor communication, misaligned expectations, or unaddressed concerns, potentially leading to diminished trust, reduced collaboration, or loss of support, ultimately impacting the organization&apos;s overall performance, reputation, and growth opportunities</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7eCKOVVCm1MJa3hlvIn8qc -->

