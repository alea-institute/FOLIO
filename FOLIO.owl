        <skos:altLabel xml:lang="es-es">Respuesta a la Oposición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Respuesta a la Oposición</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réponse à l&apos;opposition</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תשובה להתנגדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विरोध का जवाब दें</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">回复反对意见</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">異議申立に対する回答</skos:altLabel>
        <skos:definition>A Reply to Opposition is a legal document filed in response to an opposition brief, typically in an appellate court, that addresses and refutes the arguments made by the opposing party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hnGOe7W6bbC8HjkaMmkPb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hnGOe7W6bbC8HjkaMmkPb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7P7kd5lf60cWlSHHwGsH5k"/>
        <rdfs:label>Technical Report</rdfs:label>
        <skos:altLabel>Research Report</skos:altLabel>
        <skos:definition>A Technical Report is a document that outlines the results, methodology, and conclusions of a scientific or engineering research project. It serves as a detailed record of the research performed and is often used to disseminate findings to specialists in the field.</skos:definition>
        <skos:prefLabel>Engineering Report</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hrAbTc3rhzosq6n83fxf6 -->

