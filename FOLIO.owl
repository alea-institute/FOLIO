        <skos:altLabel xml:lang="zh-cn">公司无故终止条款</skos:altLabel>
        <skos:definition>A Termination Without Cause by the Company Clause is a provision in a contract that allows a company to end the agreement without providing a reason.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDNJ4NKjJEf08oWXQI1cC22 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDNJ4NKjJEf08oWXQI1cC22">
