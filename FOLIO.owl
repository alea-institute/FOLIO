        <skos:altLabel xml:lang="fr-fr">Ensemble de règles complexes</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Komplexer Regelkatalog</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">复杂规则集</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">複雑なルールセット</skos:altLabel>
