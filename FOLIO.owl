        <rdfs:label>Florida County Court - Baker County</rdfs:label>
        <skos:definition>Florida County Court - Baker County is a specific court within the Florida County Court system that has jurisdiction over legal matters within Baker County, Florida.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
        <rdfs:label>Business of Law</rdfs:label>
        <skos:definition>Business of Law refers to the management and administration of legal services, including tasks such as client portal management, procurement management, and pricing management, among others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RObDXKmoefrAqYpuco45fm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RObDXKmoefrAqYpuco45fm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
        <rdfs:label>Pre-Judgment Interest</rdfs:label>
        <skos:altLabel xml:lang="es-es">Intereses Prejudiciales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Intereses Prejudiciales</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Intérêts pré-judiciaires</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Juros pré-julgamento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pre-Judgment Interest</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorprozessuale Zinsen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ריבית לפני פסק דין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्व-न्यायाधीश ब्याज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">判决前利息</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決前利息</skos:altLabel>
        <skos:definition>Pre-Judgment Interest refers to the interest that accrues on a monetary award from the time the cause of action arose until the judgment is entered, and is intended to compensate the plaintiff for the loss of use of the money during that period.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RObTyeuV6yxdWyj5mj108e -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RObTyeuV6yxdWyj5mj108e">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBIgSt9tTBIIgOibr6v8RDz"/>
        <rdfs:label>Use and Permission Tax Payment</rdfs:label>
        <skos:altLabel>Activity Permission Tax Payment</skos:altLabel>
        <skos:altLabel>Usage Fee Payment</skos:altLabel>
        <skos:altLabel>User Tax Payment</skos:altLabel>
        <skos:definition>Use and Permission Tax Payment includes taxes levied for the use of goods or permission to use goods or perform activities. These taxes are distinct from those assessed on the value of the goods themselves and are usually fixed amounts. This category also covers pollution taxes not based on the value of specific goods. Distinguishing between compulsory user charges and license fees considered as taxes and those regarded as non-tax revenues can be challenging.</skos:definition>
        <skos:prefLabel>Taxes on use of goods, or on permission to use goods or perform activities</skos:prefLabel>
        <skos:prefLabel>Utilization Tax Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROdGbjIXGMksEMO7vXETw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROdGbjIXGMksEMO7vXETw">
