        <skos:definition>The unauthorized use of a trademark or service mark, including the trafficking of counterfeit marks, which violates the rights of the owner and may result in legal action under unfair competition or intellectual property claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQDXR2Gnn6virD8cjpZyWV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQDXR2Gnn6virD8cjpZyWV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
        <rdfs:label>People Management</rdfs:label>
        <skos:definition>The concept of People Management refers to the legal use cases related to managing employees, including temporary placement, recruiting, appraisals, and professional development.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQDZzkIzCRJhsd55BS4zvW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQDZzkIzCRJhsd55BS4zvW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Forest County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court located in Forest County, which is responsible for administering justice in minor criminal and civil matters within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQFA6tWJcZSJsrTdNryq26 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQFA6tWJcZSJsrTdNryq26">
