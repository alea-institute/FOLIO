                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RcTA2iQmrtqOnX3WrjJIp8"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Right to Counsel</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Derecho a la defensa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Derecho a la defensa letrada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito à assistência jurídica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit à l&apos;assistance d&apos;un avocat</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht auf anwaltliche Vertretung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right to Counsel</skos:altLabel>
        <skos:altLabel>Right to Defense Counsel</skos:altLabel>
        <skos:altLabel>Right to Legal Representation</skos:altLabel>
        <skos:altLabel>Right to an Attorney</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות לייעוץ משפטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वकील के अधिकार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">弁護人の権利</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">辩护权</skos:altLabel>
        <skos:definition>The right to counsel refers to a fundamental legal principle that ensures individuals have access to legal representation, particularly during criminal proceedings. In the United States, this right is enshrined in the Sixth Amendment of the United States Constitution and guarantees that defendants facing criminal charges have the opportunity to be represented by an attorney, either privately retained or provided by the state if they cannot afford one, to protect their rights and ensure a fair trial.</skos:definition>
        <skos:prefLabel>Right to a Lawyer</skos:prefLabel>
    </owl:Class>
    


