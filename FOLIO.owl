        <rdfs:label>Cushitic languages</rdfs:label>
        <skos:altLabel xml:lang="de-de">Kuschitische Sprachen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langues couchitiques</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas cuxíticas</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クシ語族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">库施特语系</skos:altLabel>
        <skos:definition>Cushitic languages are a group of languages within the broader category of Language, which are spoken primarily in the Horn of Africa and are characterized by shared grammatical features and vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7PyR6ZeFKwHLi0gh4W6HUK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7PyR6ZeFKwHLi0gh4W6HUK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Obsessive-Compulsive Disorder</rdfs:label>
        <skos:altLabel>Compulsive Disorder</skos:altLabel>
        <skos:altLabel>Compulsive-Obsessive Disorder</skos:altLabel>
        <skos:altLabel>OCD</skos:altLabel>
        <skos:altLabel>Obsessive Disorder</skos:altLabel>
        <skos:definition>Obsessive-Compulsive Disorder (OCD) is a chronic mental health condition characterized by uncontrollable, recurring thoughts (obsessions) and behaviors (compulsions) that the individual feels driven to perform. These obsessions and compulsions can significantly interfere with daily activities and cause distress.</skos:definition>
    </owl:Class>
    


