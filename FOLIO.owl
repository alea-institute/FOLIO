        <rdfs:label>New Jersey Superior Court - Gloucester County</rdfs:label>
        <skos:definition>The New Jersey Superior Court - Gloucester County is a specific court within the New Jersey Superior Court Appellate Division that has jurisdiction over civil and criminal cases in Gloucester County, New Jersey.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8H6juVpaeXuliJoxIUxXdS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8H6juVpaeXuliJoxIUxXdS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UELEvq0EkRnKE9zMt5IfZ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:label>&quot;Back-Door&quot; Material Adverse Effect Closing Condition</rdfs:label>
        <skos:altLabel xml:lang="hi-in">&quot;बैक-डोर&quot; सामग्री अधिकारी असाधारण प्रभाव समापन शर्त</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Back-Door&quot; Material Adverse Effect Closing Condition</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Closing-Bedingung für Material Adverse Effects durch Hintertür</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Condición de cierre de efecto adverso material &quot;Back-Door&quot;</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Condición de cierre de efecto adverso material &quot;Back-Door&quot;</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Condition de clôture pour les effets indésirables matériels par la porte dérobée</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Condição de fechamento para Efeitos Adversos Materiais por meio de Porta dos Fundos</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנאי סגירת השפעה נזקית חומרית &quot;Back-Door&quot;</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">バックドアの重大な不利な影響のクロージング条件</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">通过后门的重大不利影响关闭条件</skos:altLabel>
        <skos:definition>A &quot;Back-Door&quot; Material Adverse Effect (MAE) Closing Condition is a provision in a legal agreement that allows a party to back out of the agreement if an adverse event occurs that was not specifically listed as a condition for termination.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv">
