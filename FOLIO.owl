        <rdfs:label>B130 Asset Disposition</rdfs:label>
        <skos:definition>Sales, abandonment and transaction work related to asset disposition</skos:definition>
        <skos:prefLabel>B130 Asset Disposition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROakK54UeI9iwaSUHGK35k -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROakK54UeI9iwaSUHGK35k">
