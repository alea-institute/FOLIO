        <rdfs:label>Lien</rdfs:label>
        <skos:altLabel xml:lang="es-es">Gravamen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gravamen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lien</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Penhor</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Pfandrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות מעצר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लियन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">抵当権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">留置权</skos:altLabel>
        <skos:definition>A lien is a legal claim or right that a creditor has over a debtor&apos;s property as security for a debt or obligation, which can be enforced through court action or other legal means.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OJQHant3Dx172WXuPbWgx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OJQHant3Dx172WXuPbWgx">
