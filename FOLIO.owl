        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP"/>
        <rdfs:label>&quot;Hell or High Water&quot; Antitrust Standard</rdfs:label>
        <skos:altLabel xml:lang="zh-cn">&quot;地狱或高水&quot;反垄断标准</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">&apos;हेल या हाई वाटर&apos; एंटीट्रस्ट मानक</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Antitrust-Standard &quot;Hölle oder Hochwasser&quot;</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándar Antimonopolio &apos;A Prueba de Todo&apos;</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Estándar Antimonopolio &apos;Contra Viento y Marea&apos;</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Hell or High Water Antitrust Standard</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Norme antitrust &quot;Hell or High Water&quot;</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Padrão antitruste &quot;Hell or High Water&quot;</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקן הנגד למונופול &apos;גם אם יש צוללות או אש&apos;</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">「Hell or High Water」反トラスト規格</skos:altLabel>
        <skos:definition>The &quot;Hell or High Water&quot; Antitrust Standard is a legal concept that sets a high bar for proving antitrust violations, requiring evidence that the defendant engaged in conduct that would have been undertaken only in the face of an extreme, non-economic threat.</skos:definition>
    </owl:Class>
    


