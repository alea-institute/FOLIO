        <skos:altLabel xml:lang="es-es">Enmienda a la Cláusula de Letra de Cambio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Änderung der Schuldscheinvereinbarung</skos:altLabel>
