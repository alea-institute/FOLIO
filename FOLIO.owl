        <skos:altLabel xml:lang="hi-in">ब्रीफ फाइल करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交简要文件动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">簡易書類提出請求</skos:altLabel>
        <skos:definition>A Motion to File Brief is a formal request made to a court or other legal authority seeking permission to submit a written document presenting arguments or information in support of a party&apos;s position in a legal case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Ro7NzBFiq6eW3vKMpqpufQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Ro7NzBFiq6eW3vKMpqpufQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
