        <skos:altLabel xml:lang="pt-br">Especialista em danos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Expert en dommages</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Experto en daños y perjuicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Experto en daños y perjuicios</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schadensgutachter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מומחה נזקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हर्जाने के विशेषज्ञ</skos:altLabel>
