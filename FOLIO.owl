        <skos:altLabel xml:lang="de-de">Anerkennungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de reconnaissance</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de reconhecimento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de reconocimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de reconocimiento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הכרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पुष्टि अनुच्छेद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">承認条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">确认条款</skos:altLabel>
        <skos:definition>An Acknowledgement Clause is a provision in a contract where one party acknowledges that they have received and understood certain information or terms, but does not necessarily indicate agreement or acceptance of those terms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Y4BG1tP5vqrhbh6gFtMf3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Y4BG1tP5vqrhbh6gFtMf3">
