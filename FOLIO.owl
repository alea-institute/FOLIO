        <rdfs:label>Ganda</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ganda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ganda</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ganda</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ガンダ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">甘达语</skos:altLabel>
        <skos:definition>Ganda (Language) is a structured system of communication that consists of grammar and vocabulary used in Uganda and surrounding regions.</skos:definition>
    </owl:Class>
    


