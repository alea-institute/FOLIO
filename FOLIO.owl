        <rdfs:label>Voluntary Bankruptcy</rdfs:label>
        <skos:altLabel>Debtor-Initiated Bankruptcy</skos:altLabel>
        <skos:altLabel>Self-Initiated Insolvency</skos:altLabel>
        <skos:altLabel>Voluntary Insolvency</skos:altLabel>
        <skos:altLabel>Voluntary Liquidation</skos:altLabel>
        <skos:definition>Voluntary Bankruptcy occurs when a debtor initiates bankruptcy proceedings by filing a petition with the bankruptcy court. It contrasts with Involuntary Bankruptcy, where creditors initiate the process against a debtor.</skos:definition>
        <skos:prefLabel>Debtor-Initiated Liquidation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qYdzDpOwDU4Z5oYtmDMBp -->

