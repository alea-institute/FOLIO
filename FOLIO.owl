            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source rdf:resource="https://nna.jse.co.za/Help/cfi.htm"/>
        <rdfs:label>Investment Asset Attributes</rdfs:label>
        <skos:definition>Investment Asset Attributes refer to the specific characteristics and features that define an investment asset. These attributes include aspects such as voting rights, redemption rights, transfer rights, income rate, form, instrument dependency, distribution methods, repayment methods, underlying assets, and guarantees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9c9tTG5C2soQ95Z3m3Ruq0 -->

