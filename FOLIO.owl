        <skos:altLabel>Guardianship of Mentally Retarded</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Guardianship of Mentally Retarded or Developmentally Disabled</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tutela de personas con discapacidad mental o del desarrollo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tutela de personas con discapacidad mental o del desarrollo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tutela de pessoas com deficiência mental ou desenvolvimental</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tutelle des personnes atteintes de retard mental ou de handicap développemental</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vormundschaft für geistig behinderte oder entwicklungsbehinderte Personen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אפוטרופוס על חסימת נפש או מוגבלי פיתוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मानसिक रूप से पिछड़े या विकासात्मक रूप से विकलांगों की प्रत्यक्ष देखभाल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">智力残疾或发展迟缓的监护</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">知的障害者または発達障害者の後見</skos:altLabel>
        <skos:definition>The Guardianship of Mentally Retarded or Developmentally Disabled refers to the legal process of appointing a guardian to make decisions on behalf of an individual who is unable to make decisions for themselves due to mental or developmental disabilities.</skos:definition>
    </owl:Class>
    


