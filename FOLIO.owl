        <skos:altLabel xml:lang="pt-br">Carta de aviso legal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Legal Notice Letter</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lettre de notification légale</skos:altLabel>
