        <skos:altLabel xml:lang="es-mx">Público objetivo del documento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Público-alvo do documento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zielgruppe des Dokuments</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קהל היעד של המסמך</skos:altLabel>
