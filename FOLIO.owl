        <rdfs:label>Exceptions Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ausnahmeklauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Exceptions Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de cláusula de excepciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de cláusula de excepciones</skos:altLabel>
