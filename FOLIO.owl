        <rdfs:label>Labor and Delivery Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle lors de l&apos;accouchement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geburtsfehlerhaftigkeit und Entbindung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Labour and Delivery Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia médica en el parto y el alumbramiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia médica en el parto y el alumbramiento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica durante o parto</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאות רפואיות בלידה ולידה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">श्रम और डिलीवरी लोहे की गलती</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">分娩における医療過誤</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分娩医疗事故</skos:altLabel>
        <skos:definition>Negligent or improper medical care provided during the process of childbirth, resulting in harm or injury to the mother or child, falling under the category of medical malpractice claims.</skos:definition>
    </owl:Class>
    


