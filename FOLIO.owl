        <rdfs:label>Dissolution for Oppression</rdfs:label>
        <skos:altLabel xml:lang="de-de">Auflösung wegen Unterdrückung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Disolución por opresión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Disolución por opresión</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dissolution for Oppression</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dissolution pour oppression</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dissolução por opressão</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פירוק עקב לחץ</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अत्याचार के लिए विघटन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">压制解散</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">抑圧解消</skos:altLabel>
        <skos:definition>The concept of &quot;Dissolution for Oppression&quot; refers to a legal claim made by shareholders or partners against a corporation or partnership alleging that the majority shareholders or partners have acted oppressively towards the minority, resulting in the dissolution of the entity.</skos:definition>
    </owl:Class>
    


