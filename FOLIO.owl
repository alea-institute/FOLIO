        <skos:altLabel xml:lang="en-gb">Motion to File Supplemental Brief</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para apresentação de petição suplementar</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para presentar un escrito complementario</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להגשת תביעה משלימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अतिरिक्त ब्रीफ फाइल करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交补充简要书动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">追加意見書の提出を求める動議</skos:altLabel>
        <skos:definition>A Motion to File Supplemental Brief is a formal request made to a court or tribunal seeking permission to submit additional written arguments or evidence beyond what was originally allowed in a case.</skos:definition>
    </owl:Class>
    


