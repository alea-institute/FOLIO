        <skos:definition>M&amp;A F4 Environmental Practice refers to the legal work performed by a Legal Services Provider in the course of a merger or acquisition transaction that involves regulatory and specialty matters related to environmental issues.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rvr8AdbITF9NopKBs88F2b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rvr8AdbITF9NopKBs88F2b">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7pZSuLowh1QRBeGOhk6zEr"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBdzXlcak91MmI7U2nHYMU"/>
        <rdfs:label>Motion to Extend Time to File Appendix</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung der Frist zur Einreichung des Anhangs</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender el plazo para presentar el apéndice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour prolonger le délai de dépôt de l&apos;appendice</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Time to File Appendix</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para prorrogar o prazo para apresentação do apêndice</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de prórroga de plazo para presentar el apéndice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת הזמן להגשת הנספח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपेंडिक्स फ़ाइल करने के लिए समय बढ़ाने की मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">付録提出期限延長申立書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长提交附录的时间动议</skos:altLabel>
        <skos:definition>A Motion to Extend Time to File Appendix is a request made to a court to allow additional time beyond the original deadline for a party to submit a document containing the record of a case on appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RvtAG5ZxdY8mteP8zvIRXO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvtAG5ZxdY8mteP8zvIRXO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rnaTadzLe6EuX6FHVxEvF"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8WVl8JMk7gYU2NB0NpirR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bankruptcy Schedule - Codebtors</rdfs:label>
        <skos:altLabel>Codebtor Schedule</skos:altLabel>
        <skos:altLabel>Joint Debtors Schedule</skos:altLabel>
        <skos:altLabel>Joint Obligor Disclosure</skos:altLabel>
        <skos:definition>Bankruptcy Schedule - Codebtors, also known as Schedule H, requires the debtor to list all individuals or entities who are also liable on any of the debtor&apos;s debts. This schedule includes the names and addresses of codebtors, along with the corresponding debts for which they share liability, providing transparency about shared financial obligations.</skos:definition>
        <skos:prefLabel>Schedule H</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RvtKtmtbtUkG15r7cuHIRQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvtKtmtbtUkG15r7cuHIRQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDw3C0Q9SA9H8y85Zz4cMvz"/>
        <rdfs:label>Return on Investment</rdfs:label>
        <skos:altLabel>ROI</skos:altLabel>
        <skos:definition>Return on Investment (ROI) is a financial metric used to evaluate the profitability of an investment or to compare the profitability of multiple investments. It is calculated by dividing the net profit from the investment by the initial cost, usually multiplied by 100 to express it as a percentage. ROI is commonly used to evaluate investment effectiveness.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RvthpGbzF5vsoC8eT3rmJx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvthpGbzF5vsoC8eT3rmJx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Papuan languages</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Langues papoues</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas papuas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Papuasprachen</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パプア諸語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">巴布亚语系</skos:altLabel>
        <skos:definition>A group of languages spoken in Papua New Guinea and surrounding areas, characterized by their unique grammar and vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rvv1eQgS5npqL7Oq4auW2r -->

