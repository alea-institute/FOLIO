        <rdfs:label>Texas Court of Appeals - 4th</rdfs:label>
        <skos:definition>The Texas Court of Appeals - 4th is a specific intermediate appellate court in Texas that hears appeals from trial courts in its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R3yl9L7uI3BKIBgQugdI6r -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R3yl9L7uI3BKIBgQugdI6r">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9AX4LAp7IfL4nFnLZeugyY"/>
        <rdfs:label>UK Financial Conduct Authority</rdfs:label>
        <skos:altLabel>Conduct Authority</skos:altLabel>
        <skos:altLabel>FCA</skos:altLabel>
        <skos:altLabel>Financial Regulator</skos:altLabel>
        <skos:definition>The UK Financial Conduct Authority is an independent regulatory body responsible for overseeing the conduct of financial markets, firms, and individuals in the United Kingdom to ensure consumer protection and market integrity. The FCA regulates financial services providers and enforces rules to maintain fair, transparent, and competitive markets.</skos:definition>
    </owl:Class>
    


