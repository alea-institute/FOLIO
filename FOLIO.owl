        <rdfs:label>Rescue Doctrine</rdfs:label>
        <skos:altLabel xml:lang="es-es">Doctrina de rescate</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Doctrina de rescate</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Doctrine de sauvetage</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Doutrina do resgate</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Rescue Doctrine</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rettungslehre</skos:altLabel>
        <skos:altLabel>Voluntary Rescuer Injured by Negligence of Other</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תאוריית ההצלה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बचाव डॉक्ट्रिन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">救助教義</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">救援原则</skos:altLabel>
        <skos:definition>The Rescue Doctrine is a legal concept that allows a person who voluntarily attempts to rescue another person in danger to potentially recover damages if they are injured due to the negligence of another party.</skos:definition>
    </owl:Class>
    


