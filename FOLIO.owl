        <skos:altLabel xml:lang="fr-fr">Date de début de facturation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fecha de inicio de la factura</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fecha de inicio de la factura</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Invoice Start Date</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechnungsbeginndatum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תאריך התחלת החשבונית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चालान शुरू तिथि</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">发票开始日期</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">請求書開始日</skos:altLabel>
        <skos:definition>The Invoice Start Date is a specific detail within the broader category of Fee Invoice Detail, referring to the date on which invoicing for legal services begins.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDifpD5IXarDdCKxCD7GVkX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDifpD5IXarDdCKxCD7GVkX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
        <rdfs:label>Property Right to Profit</rdfs:label>
        <skos:altLabel>Droit de Prendre</skos:altLabel>
        <skos:definition>In civil law systems, the Right to Profit (&quot;droit de prendre&quot;) refers to a real right that allows an individual or entity to enter another&apos;s land to extract resources like minerals, timber, or fish. This right is usually granted through a contract or license and is subject to the terms and conditions specified therein, as well as overarching legal regulations.</skos:definition>
    </owl:Class>
    


