            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Matter Funds Applied</rdfs:label>
        <skos:altLabel xml:lang="es-es">Fondos de Asunto Aplicados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fondos de Asunto Aplicados</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fonds appliqués à la matière</skos:altLabel>
