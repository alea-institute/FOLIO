        <skos:altLabel xml:lang="es-mx">Derechos de visita de hermanos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direitos de visitação entre irmãos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit de visite des frères et sœurs</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Visitation Rights of Sibling</skos:altLabel>
