        <skos:altLabel>Insider Monthly Filing</skos:altLabel>
        <skos:altLabel>Monthly Ownership Report</skos:altLabel>
        <skos:definition>An Alternative Monthly Report is a disclosure document typically filed by insiders or significant shareholders to report on their activities and holdings. It is often required by securities regulators on a monthly basis.</skos:definition>
        <skos:prefLabel>Monthly Investor Disclosure</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDdonUhn8b2x65zyhSdTWzy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDdonUhn8b2x65zyhSdTWzy">
