        <rdfs:label>Red Lake Band of Chippewa Indians</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jub69dsTeA4UUodPgmxsW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jub69dsTeA4UUodPgmxsW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
