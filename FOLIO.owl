        <skos:altLabel xml:lang="pt-br">Zhuang; Chuang</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">壮族; 壮</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">壮族; 壮</skos:altLabel>
        <skos:definition>A language spoken by the Zhuang people, primarily in the Guangxi Zhuang Autonomous Region of southern China.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9O71u7Yx58p7hKk17F5AP5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9O71u7Yx58p7hKk17F5AP5">
