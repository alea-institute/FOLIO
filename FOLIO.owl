    <!-- https://folio.openlegalstandard.org/RGK6KYY8XqLTyeigvEAIOg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RGK6KYY8XqLTyeigvEAIOg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBila9ckW95W84Tk54tGfZO"/>
        <rdfs:label>Work Break</rdfs:label>
        <skos:altLabel>Break Time</skos:altLabel>
        <skos:definition>&quot;Work Break&quot; typically refers to a short period of rest or pause during the workday, allowing employees to recharge or relax briefly before resuming their tasks. It can vary in duration and purpose, such as a coffee break, lunch break, or a quick break to stretch and refocus.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGMtqJaTuraqFEBqi0Wwew -->

