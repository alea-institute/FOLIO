        <rdfs:label>Criminal Fine</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Amende pénale</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Criminal Fine</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Multa criminal</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Multa penal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Multa penal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafgeld</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עונש כספי פלילי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आपराधिक जुर्माना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">刑事罚款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">刑事罰金</skos:altLabel>
        <skos:definition>A criminal fine is a monetary penalty imposed as a punishment for a criminal offense.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj5x82UUStCv4KPk7UfoiQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rj5x82UUStCv4KPk7UfoiQ">
