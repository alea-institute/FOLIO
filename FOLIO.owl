        <skos:altLabel xml:lang="zh-cn">文档生成事件</skos:altLabel>
        <skos:definition>A Document Production Event is a specific type of event within the legal field that involves the creation and collection of documents for a case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROgOHUkJpQfCQ0v4X2QQgsw -->

