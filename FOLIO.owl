        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>No Subletting Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;interdiction de sous-location</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de no subarriendo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no subarriendo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de proibição de sublocação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Untervermietung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Subletting Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף לא ניתן לתת רשות לכניסה של מתגוררים אחרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कोई सबलेटिंग क्लॉज नहीं</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无转租条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">転貸禁止条項</skos:altLabel>
        <skos:definition>A &quot;No Subletting Clause&quot; is a provision in a contract that prohibits the tenant from subleasing the property to another party without the landlord&apos;s prior written consent.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTDbHlWwsQX0BPA5R0TDIT -->

