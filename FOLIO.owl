    <!-- https://folio.openlegalstandard.org/RBFFfSWsg811UlPoeFkEsZY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBFFfSWsg811UlPoeFkEsZY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Visa for Nurses and Medical Professionals</rdfs:label>
        <skos:altLabel xml:lang="en-us">H-1A</skos:altLabel>
        <skos:definition>A visa for nurses and medical professionals is a specialized visa category that may be offered by certain countries to healthcare workers who wish to enter for the purpose of employment in the medical field. These visas often have specific requirements, including proof of qualifications, job offers from recognized healthcare institutions, and sometimes a need to address shortages of medical professionals in the host country.</skos:definition>
    </owl:Class>
    


