        <skos:altLabel xml:lang="es-mx">Necesidad de Acceder sin Autorización</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Necesidad de Ingresar sin Autorización</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Necessidade de invasão</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Necessity of Trespass</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Notwehr</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Nécessité de franchissement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צורך בפשיטת רשות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अतिआवश्यकता द्वारा अतिक्रमण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不法侵入の必要性</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">侵权必要性</skos:altLabel>
        <skos:definition>The Necessity of Trespass is a legal defense in civil litigation that allows a defendant to justify their trespass onto another&apos;s property as necessary to prevent a greater harm.</skos:definition>
    </owl:Class>
    


