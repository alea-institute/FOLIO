        <skos:altLabel xml:lang="es-es">Ley de Gestión de Residuos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Manejo de Residuos</skos:altLabel>
        <skos:altLabel>Waste Management</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waste Management Law</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק ניהול פסולת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कचरा प्रबंधन विधि</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">废物管理法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">廃棄物管理法</skos:altLabel>
        <skos:definition>Law governing the transport, treatment, storage, and disposal of all manner of waste, including municipal solid waste, hazardous waste, and nuclear waste.</skos:definition>
        <skos:hiddenLabel>WSTM</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8iwuYOjEZFcHyzVQeXJql -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8iwuYOjEZFcHyzVQeXJql">
