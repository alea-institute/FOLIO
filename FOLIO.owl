        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCpnqQCzeexk3k9kkbLx1Zu"/>
        <rdfs:label>Reasonableness</rdfs:label>
        <skos:altLabel xml:lang="de-de">Angemessenheit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Raisonabilité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Razoabilidade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Razonabilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Razonabilidad</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reasonableness</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סבירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उचितता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合理性</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合理性</skos:altLabel>
        <skos:definition>The concept of Reasonableness refers to the standard of review used by appellate courts to determine whether a lower court&apos;s decision was based on a rational and justifiable interpretation of the law and the facts presented in the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROaMRBgiyTQ-jvPJLkTFhuw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROaMRBgiyTQ-jvPJLkTFhuw">
