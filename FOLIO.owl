        <rdfs:label>Tire Dealers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in retailing new and/or used tires and tubes or retailing new tires in combination with automotive repair services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fSJWJQ0kQ7STbE-ZvFgFFQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fSJWJQ0kQ7STbE-ZvFgFFQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_9hPY4cPTjuIdNELyo8GTg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=711190"/>
        <rdfs:label>Other Performing Arts Companies</rdfs:label>
        <skos:definition>This industry comprises companies or groups (except theater companies, dance companies, and musical groups and artists) primarily engaged in producing live theatrical presentations.</skos:definition>
        <skos:example>Carnival traveling shows</skos:example>
        <skos:example>Circuses</skos:example>
        <skos:example>Ice skating companies</skos:example>
        <skos:example>Magic shows</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fSRo747VQsGtx1lMPgcmRQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fSRo747VQsGtx1lMPgcmRQ">
