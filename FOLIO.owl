        <rdfs:label>Indiana Superior Court - Hendricks County</rdfs:label>
        <skos:definition>A court of general jurisdiction in Indiana that hears civil and criminal cases within Hendricks County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yJfwvqppJTqLzdc8w30WI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8yJfwvqppJTqLzdc8w30WI">
