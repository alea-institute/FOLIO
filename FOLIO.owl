    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72lOZM1yGI094Xre49Qsjc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72lOZM1yGI094Xre49Qsjc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
