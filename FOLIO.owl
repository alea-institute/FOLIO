    <owl:Class rdf:about="https://folio.openlegalstandard.org/RxtPqy6N4ozU2pq7p4JiOP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74IJAT8MHMqUZeBJR7txV1"/>
        <rdfs:label>&quot;Material Adverse Effect&quot; Definition - Exceptions - Economic Conditions</rdfs:label>
        <skos:altLabel xml:lang="de-de">&quot;Material Adverse Effect&quot; Definition - Ausnahmen - Wirtschaftliche Bedingungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">&quot;Material Adverse Effect&quot; Definition - Exceptions - Economic Conditions</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">&quot;Material Adverse Effect&quot; の定義 - 例外 - 経済状況</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">&quot;Material Adverse Effect&quot; 定义 - 例外 - 经济条件</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">&quot;मटेरियल एडवर्स इफेक्ट&quot; परिभाषा - अपवाद - आर्थिक स्थितियाँ</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Definición de &quot;Efecto Adverso Material&quot; - Excepciones - Condiciones Económicas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de &quot;Efecto Adverso Material&quot; - Excepciones - Condiciones Económicas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de &quot;Material Adverse Effect&quot; - Exceções - Condições econômicas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de &quot;Material Adverse Effect&quot; - Exceptions - Conditions économiques</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת &quot;השפעה נזיקה משמעותית&quot; - יוצאים מן הכלל - תנאי כלכליים</skos:altLabel>
