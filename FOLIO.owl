        <rdfs:label>The Suquamish Tribe</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrctN8FUd3Tj5gi4DWHTZx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrctN8FUd3Tj5gi4DWHTZx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Food and Cash Public Benefit</rdfs:label>
        <skos:definition>Food and cash public benefit refers to government programs that provide financial assistance and food resources to individuals or families in need. Cash benefits, often delivered through electronic benefit transfer (EBT) cards or direct deposits, are intended to help cover basic living expenses, while food benefits, such as the Supplemental Nutrition Assistance Program (SNAP) in the United States, are designated for purchasing eligible food items.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrguM7iRbnEtEeEQM1C6xV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrguM7iRbnEtEeEQM1C6xV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Gabrieleno</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrkuhfEvrGj2ITZSLQCqYW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrkuhfEvrGj2ITZSLQCqYW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8wOITiPftK5xTRvzn957oX"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RnnJLAzGV4emQlsf4z80ci"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Automobile Registration</rdfs:label>
        <skos:definition>&quot;Automobile Registration&quot; refers to the official process of recording essential information about an automobile, such as its make, model, and ownership, with a government authority. This registration, often represented by a certificate or license plate, is required for the vehicle to be legally driven on public roads.</skos:definition>
        <skos:prefLabel>Vehicle Registration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCroY6MyuPipipJMQllW9dU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCroY6MyuPipipJMQllW9dU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9aAuY31Z3tgpR7hUAqTEmd"/>
        <rdfs:label>Concussion</rdfs:label>
        <skos:altLabel>Minor Head Injury</skos:altLabel>
        <skos:definition>Mild traumatic brain injury (concussion) is a form of TBI resulting from a blow or jolt to the head that temporarily disrupts brain function. Symptoms can include headache, confusion, dizziness, and memory loss, and while typically short-term, they may require rest and medical monitoring.</skos:definition>
        <skos:prefLabel>Mild Traumatic Brain Injury</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrshoNA9Tc4Xswrj0v8nqX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrshoNA9Tc4Xswrj0v8nqX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
        <rdfs:label>Knowledge Qualifiers</rdfs:label>
        <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Calificadores de &quot;Conocimiento&quot;</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Calificadores de &quot;Conocimiento&quot;</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Auswirkungen - Qualifikatoren &quot;Wissen&quot;</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Qualificadores &quot;Conhecimento&quot;</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de l&apos;effet indésirable matériel - Qualificateurs &quot;Connaissance&quot;</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - &quot;Knowledge&quot; Qualifiers</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת השפעה שלילית חומרית - תכונות &quot;ידע&quot;</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - &quot;ज्ञान&quot; अर्थात विवरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质不利影响定义 - &quot;知识&quot;限定词</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-「知識」修飾語</skos:altLabel>
        <skos:definition>Material Adverse Effect (MAE) Definition - &quot;Knowledge&quot; Qualifiers: A term used in legal agreements to describe a negative change or event that has occurred or is likely to occur, and which is known or should have been known by a party based on their level of knowledge or investigation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCs05yTimZuTa2X0ov72PpQ -->

