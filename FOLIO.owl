            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion to File Amended Proof of Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einreichung einer geänderten Forderungsanmeldung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para presentar una prueba de reclamación enmendada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer une preuve de créance modifiée</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Amended Proof of Claim</skos:altLabel>
