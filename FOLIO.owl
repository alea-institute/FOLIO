        <dc:identifier>B-USCHAP15</dc:identifier>
        <rdfs:label>US Chapter 15 Bankruptcy</rdfs:label>
        <skos:altLabel>Chapter 15</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Faillite du chapitre 15 des États-Unis</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falência do Capítulo 15 dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Quiebra del Capítulo 15 de Estados Unidos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Quiebra del Capítulo 15 de los Estados Unidos</skos:altLabel>
        <skos:altLabel>US Chapter 15</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">US Chapter 15 Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="de-de">US-Kapitel 15 Insolvenz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פשיטת רגל פרק 15 של ארצות הברית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूएस अध्याय 15 दिवाला</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">米国第15章破産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">美国第15章破产</skos:altLabel>
        <skos:definition>Chapter 15 bankruptcy provides a way of dealing with cases that involve more than one country. The main goal of chapter 15 is to provide cooperation between a foreign debtor, foreign courts and the U.S. bankruptcy courts.</skos:definition>
        <skos:hiddenLabel>USCHAP15</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBVpHQ7fb2I2B69LOWszQjd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBVpHQ7fb2I2B69LOWszQjd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBzrK4RsgfLScZvC4Z4lCCX"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Justifiable Homicide</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Homicide justifié</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Homicidio justificable</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Homicidio justificado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Homicídio justificável</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Justifiable Homicide</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtfertigungsgrund für Tötung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התנצלות רצח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ज्युस्टिफायबल होमिसाइड</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">正当防卫杀人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">正当防衛殺人</skos:altLabel>
        <skos:definition>The killing of a perpetrator of a serious criminal offense by a peace officer in the line of duty, or the killing, during the commission of a serious criminal offense, of the perpetrator by a private individual.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBVqeuh5Yby92R8jLO7O0M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBVqeuh5Yby92R8jLO7O0M">
