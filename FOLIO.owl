        <rdfs:label>Motion to Hear</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Anhörung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Escuchar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Oír</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Hear</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Audiência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête d&apos;audition</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להקשבה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सुनवाई के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">听证动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">聴聞請求</skos:altLabel>
        <skos:definition>A Motion to Hear is a formal request made by a party in a trial court to have a specific matter or issue heard by the court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XiN2fWrOwJ5UIfnG2XJH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XiN2fWrOwJ5UIfnG2XJH">
