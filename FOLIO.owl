        <skos:altLabel xml:lang="es-mx">Cláusula de Per Diem</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de diária</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Per Diem Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Tagespauschale-Klausel</skos:altLabel>
