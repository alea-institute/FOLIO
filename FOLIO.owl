        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_04"/>
        <rdfs:label>Soft Tissue Cancer</rdfs:label>
        <skos:altLabel>Malignant Soft Tissue Tumor</skos:altLabel>
        <skos:altLabel>Sarcoma of Soft Tissue</skos:altLabel>
        <skos:definition>Soft tissue sarcoma refers to a group of malignant tumors that originate in the soft tissues of the body, including muscles, fat, blood vessels, nerves, tendons, and the lining of joints. These cancers can occur in any part of the body and often require complex treatment due to their aggressive nature and potential to spread.</skos:definition>
        <skos:prefLabel>Soft Tissue Sarcoma</skos:prefLabel>
    </owl:Class>
    


