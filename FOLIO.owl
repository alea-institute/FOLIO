        <rdfs:label>Copyright Infringement</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Copyright Infringement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Infracción de derechos de autor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Infracción de derechos de autor</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Urheberrechtsverletzung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de droit d&apos;auteur</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de direitos autorais</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת זכויות יוצרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कॉपीराइट उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">侵犯版权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">著作権侵害</skos:altLabel>
        <skos:definition>The unauthorized use or reproduction of a copyrighted work, without the permission of the owner, which may include copying, distributing, displaying, or performing the work.</skos:definition>
    </owl:Class>
    


