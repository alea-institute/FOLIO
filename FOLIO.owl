        <skos:altLabel xml:lang="es-mx">Derecho de Terminación por Efecto Adverso Material Independiente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito de rescisão em caso de efeito adverso material independente</skos:altLabel>
