        <rdfs:label>Swan Creek Black River Confederate Tribe</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8xrgxl2Dtd3UnsWfX75jF7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8xrgxl2Dtd3UnsWfX75jF7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI"/>
        <rdfs:label>Texas District Court - Comal County</rdfs:label>
        <skos:definition>A Texas District Court located in Comal County, which has jurisdiction over civil and criminal cases within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Public Benefits</rdfs:label>
        <skos:definition>Public benefits are government programs designed to provide financial or material aid to individuals or families who meet certain eligibility criteria, usually based on need or income. These benefits can include healthcare, food assistance, housing subsidies, and unemployment compensation, among others, and are intended to improve the well-being and stability of a society</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8xskhmQUaxebZTP4l8HAw4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8xskhmQUaxebZTP4l8HAw4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV"/>
        <rdfs:label>Increased Risk of Harm</rdfs:label>
        <skos:altLabel xml:lang="de-de">Erhöhtes Risiko von Schäden</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Increased Risk of Harm</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mayor riesgo de daño</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mayor riesgo de daño</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Risco aumentado de dano</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Risque accru de préjudice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיכון גבוה יותר לפגיעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हानि का बढ़ता खतरा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">增加的危害风险</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">被害の増加リスク</skos:altLabel>
        <skos:definition>Increased Risk of Harm: A legal concept that refers to the likelihood of harm or injury occurring in the future as a result of a defendant&apos;s actions or negligence, even if the harm has not yet occurred.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8xsn4ZNTKUSww8wUrawqHA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8xsn4ZNTKUSww8wUrawqHA">
