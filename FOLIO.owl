        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
        <rdfs:label>10th Amendment Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">10. Änderungsantrag Anspruch</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">10th Amendment Claim</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">10वीं संशोधन दावा</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la 10ª Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la 10ª Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da 10ª Emenda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de 10ème amendement</skos:altLabel>
        <skos:altLabel>Tenth Amendment Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת התיקון העשירי</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第10修正案主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">第十修正案索赔</skos:altLabel>
        <skos:definition>A Tenth Amendment claim is a legal argument asserting that a federal action or law has violated the Tenth Amendment of the United States Constitution, which reserves powers not delegated to the federal government to the states or the people. Such claims typically involve disputes over the balance of power between federal and state governments and aim to protect state sovereignty and autonomy.</skos:definition>
    </owl:Class>
    


