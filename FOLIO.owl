        <rdfs:label>Choice of Forum Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Choice of Forum Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de juridiction</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de elección de foro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de elección de foro</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de eleição de foro</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gerichtsstandsvereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם בחירת בית משפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फोरम का चयन शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">管轄選択条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">管辖选择条款</skos:altLabel>
        <skos:definition>A choice of forum clause is a contractual provision that designates a specific jurisdiction or court where any disputes arising from the contract will be resolved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rif2nijVwenF5TjHlpZGmi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rif2nijVwenF5TjHlpZGmi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8yT48TVCNCeeyY7WXNjCt3"/>
        <rdfs:label>Queer</rdfs:label>
        <skos:definition>Queer is an umbrella term used to describe a sexual orientation, gender identity, or gender expression that does not conform to heteronormative definitions and expectations. The term has been reclaimed by some in the LGBTQIA+ community and is often used for its inclusivity, though its meaning can vary among individuals and communities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RigrpcSYFHatuFsvX3s8X0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RigrpcSYFHatuFsvX3s8X0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7"/>
        <rdfs:label>Firm Information Services Personnel</rdfs:label>
        <skos:altLabel>Firm Information Technology Personnel</skos:altLabel>
        <skos:definition>Firm Information Services Personnel, also known as Firm IT Personnel, are professionals responsible for managing and maintaining the information technology infrastructure within a law firm or legal organization. They ensure the availability, security, and efficient operation of computer systems, networks, and data resources to support the firm&apos;s legal and administrative functions.</skos:definition>
        <skos:prefLabel>IT Personnel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RihNVfYYtmWzQWciwxquKe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RihNVfYYtmWzQWciwxquKe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sbuHkJC9aqDlHAgw58VSB"/>
        <rdfs:label>Criminal Court</rdfs:label>
        <skos:definition>A Criminal Court is a specific type of court that has jurisdiction over criminal cases and is responsible for administering proceedings related to criminal law violations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiijRwBsHpillifrZH0yoX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiijRwBsHpillifrZH0yoX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEWWtS3nM8GE8R4en1abRz"/>
        <rdfs:label>Arkansas Circuit Court - Madison Cty.</rdfs:label>
        <skos:definition>A court located in Madison County, Arkansas that has jurisdiction over civil and criminal cases within its designated geographical area.</skos:definition>
    </owl:Class>
    


