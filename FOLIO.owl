        <skos:altLabel xml:lang="ja-jp">クリー族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">克里族</skos:altLabel>
        <skos:definition>A language spoken by the Cree people, which is a member of the Algonquian language family.</skos:definition>
    </owl:Class>
    


