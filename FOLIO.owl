        <rdfs:label>Corporate and Partnership Liability Claims</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ansprüche gegen die Haftung von Unternehmen und Partnerschaften</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Corporate and Partnership Liability Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de responsabilidad corporativa y de sociedades</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamaciones de responsabilidad corporativa y de sociedades</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de responsabilidade corporativa e de parceria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations de responsabilité des entreprises et des partenariats</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות אחריות תאגידית ושותפות</skos:altLabel>
