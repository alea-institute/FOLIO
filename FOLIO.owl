        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:label>Waiver of Exemptions</rdfs:label>
        <skos:altLabel xml:lang="es-es">Renuncia de Exenciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Renuncia de Exenciones</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waiver of Exemptions</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ויתור על פטורים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">छूट का इनकार</skos:altLabel>
        <skos:definition>A waiver of exemptions is a legal document that relinquishes a debtor&apos;s right to claim certain property as exempt from seizure or sale in bankruptcy proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7x226rWjUw2bkQm2KPyySl -->

