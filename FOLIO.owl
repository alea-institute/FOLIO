        <skos:altLabel xml:lang="es-es">Presunto progenitor</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Putative Parent</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">parent présumé</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">suposto pai/mãe</skos:altLabel>
        <skos:altLabel xml:lang="de-de">vermeintlicher Elternteil</skos:altLabel>
