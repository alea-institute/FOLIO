        <skos:altLabel xml:lang="zh-cn">撤销动议</skos:altLabel>
        <skos:definition>A Motion to Expunge is a legal request made in trial courts or bankruptcy proceedings to remove or erase a record or document from the court&apos;s official records.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTMP0o99zMc6vuBbTI0PtG -->

