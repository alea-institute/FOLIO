        <skos:altLabel xml:lang="pt-br">Ativos de patente de utilidade</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nutzungsmuster-Vermögenswerte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Utility Patent Assets</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נכסי פטנט ייעודיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूटिलिटी पेटेंट संपत्ति</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实用专利资产</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">実用特許資産</skos:altLabel>
        <skos:definition>Utility Patent Assets are a specific type of patent asset that refers to the exclusive rights granted to an inventor or assignee for a specific period of time to make, use, and sell an invention.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9oqmNw5hRo7CnMIAehIRH4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9oqmNw5hRo7CnMIAehIRH4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2BaikN50BQY375QT0PEWD"/>
        <rdfs:label>Vacation</rdfs:label>
        <skos:altLabel>Annual Leave</skos:altLabel>
        <skos:definition>A Vacation, or Holiday, is a period of time taken off from work or regular activities for rest, relaxation, or travel. This planned absence from routine duties is typically paid time off for employees, allowing for leisure activities, personal pursuits, or extended breaks from professional responsibilities.</skos:definition>
        <skos:prefLabel>Holiday</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Indemnification Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de dédommagement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de indenização</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsfreistellungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Indemnity Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भरपाई अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">免責条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">赔偿条款</skos:altLabel>
        <skos:definition>An Indemnification Clause is a provision in a contract that requires one party to compensate the other for any losses or damages incurred as a result of the contract or a related transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9p16ExXgZzn7Kx478N9Bnf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9p16ExXgZzn7Kx478N9Bnf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
        <rdfs:label>Prompt Engineering</rdfs:label>
        <skos:altLabel>Input Optimization</skos:altLabel>
        <skos:altLabel>Prompt Design</skos:altLabel>
        <skos:altLabel>Query Crafting</skos:altLabel>
        <skos:definition>Prompt Engineering is the process of designing and crafting prompts for AI models to elicit desired outputs. It involves understanding the capabilities of the model and tailoring the prompt to guide the model effectively toward generating relevant, informative, and creative responses.</skos:definition>
    </owl:Class>
    


