        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=71312"/>
        <rdfs:label>Amusement Arcades</rdfs:label>
        <skos:definition>See industry description for 713120.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj77Qrw6kgfSl2QG11luyP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rj77Qrw6kgfSl2QG11luyP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ahGaNbVpIwATBsrRg3EZp"/>
        <rdfs:label>Kansas District Court - Neosho County, Erie</rdfs:label>
        <skos:definition>A court located in Neosho County, Erie, Kansas that has jurisdiction over cases within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj8CP6YnshKY7MmCXaiuY1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rj8CP6YnshKY7MmCXaiuY1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Athlete Visa</rdfs:label>
        <skos:altLabel>Athletic Visa</skos:altLabel>
        <skos:definition>The Athlete Visa (in the U.S., P-1A visa) is a non-immigrant visa specifically designed for internationally recognized athletes who wish to enter the destination country (e.g., U.S.) to participate in individual or team events. In the United States, this visa allows the athlete to stay for the duration of the competition, event, or performance, with a maximum initial period of up to 5 years for individual athletes and 1 year for athletic teams, with the possibility of extension.</skos:definition>
        <skos:prefLabel xml:lang="en-us">P-1A Visa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj8YjyXQqcyq2KLPxPvZqH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rj8YjyXQqcyq2KLPxPvZqH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Interruption of Services Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;interruption de services</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Interrupción de Servicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Interrupción de Servicios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Interrupção de Serviços</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interruption of Services Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Unterbrechung von Dienstleistungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפרעת שירותים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेवा अवरुद्धि शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サービス中断条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">服务中断条款</skos:altLabel>
        <skos:definition>An Interruption of Services Clause is a provision in a contract that outlines the rights and obligations of parties in the event that services are interrupted or unavailable due to unforeseen circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj97dODoMYEHkBffVjzGQc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rj97dODoMYEHkBffVjzGQc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RIxZRp4UxyqiBeFnokFhrA"/>
        <rdfs:label>Grapefruits</rdfs:label>
        <skos:altLabel>Citrus Paradisi</skos:altLabel>
        <skos:altLabel>Ruby Reds</skos:altLabel>
        <skos:definition>Grapefruits are large citrus fruits from the Citrus × paradisi species, known for their tart to semi-sweet flavor and distinctive segmented flesh. They are consumed fresh, juiced, or used in culinary applications, valued for their high vitamin C content, dietary fiber, and potential health benefits, including antioxidant properties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjAR6LD9HeCJgI2GEuJQtk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjAR6LD9HeCJgI2GEuJQtk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3391bdB1A2adE51071C7cf7"/>
        <rdfs:label>New York Court on the Judiciary</rdfs:label>
        <skos:definition>The New York Court on the Judiciary is a specialized court within the New York State Courts system that is responsible for investigating and disciplining judges who have engaged in misconduct.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjAfjZzqaSvOTP7iz9NmuA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjAfjZzqaSvOTP7iz9NmuA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RChEjOHUONk1Yp2qm3OHJdc"/>
        <rdfs:label>Washington Superior Court - Columbia County</rdfs:label>
        <skos:definition>Washington Superior Court - Columbia County refers to a specific court within the Washington Superior Court system that has jurisdiction over legal matters in Columbia County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjDhDDjUUDTnXvhNYE2GNj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjDhDDjUUDTnXvhNYE2GNj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP"/>
        <rdfs:label>Arugula</rdfs:label>
        <skos:altLabel>Eruca Vesicaria</skos:altLabel>
        <skos:definition>Arugula, also known as rocket, is a leafy green vegetable from the Eruca vesicaria species, known for its peppery flavor and tender texture. It is commonly used in salads, sandwiches, and as a garnish, valued for its nutritional benefits, including high levels of vitamins A, C, and K, as well as calcium and antioxidants.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjFYr8GZjMayrsvnEqXDNZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjFYr8GZjMayrsvnEqXDNZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDv8hBbEMrPuIgEyXvljAYY"/>
        <rdfs:label>Collateral Appeal</rdfs:label>
        <skos:altLabel>Collateral Attack</skos:altLabel>
        <skos:definition>A collateral appeal, also known as a collateral attack, is a legal challenge to a criminal conviction that occurs outside the direct appeal process. Instead of challenging the validity of the conviction based on the record of the original trial (as in a direct appeal), a collateral appeal addresses issues such as newly discovered evidence, ineffective assistance of counsel, or constitutional violations that weren&apos;t raised during the trial or on direct appeal. This form of relief is often sought after all direct appeals have been exhausted.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjGC9ag68KwoZVYSjOBbJI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjGC9ag68KwoZVYSjOBbJI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy"/>
        <rdfs:label>Fixation in a Tangible Medium</rdfs:label>
        <skos:altLabel>Material Embodiment</skos:altLabel>
        <skos:definition>Fixation in a Tangible Medium, a cornerstone of copyright law, requires that a work must be fixed in a medium of expression from which it can be perceived, reproduced, or otherwise communicated. This concept ensures that copyright protects not the idea itself but its expression in a form that can be physically or digitally captured and reproduced.</skos:definition>
        <skos:definition>Tangible Expression</skos:definition>
        <skos:prefLabel>Fixation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjId5qUUyYquw8QeFRCvTa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjId5qUUyYquw8QeFRCvTa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Stale Rent</rdfs:label>
        <skos:altLabel xml:lang="es-es">Alquiler vencido</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aluguel atrasado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Loyer en souffrance</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Renta vencida</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stale Rent</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Veraltete Miete</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שכירות מיושנת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बेकार किराया</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">滞租</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">滞納家賃</skos:altLabel>
        <skos:definition>Rent that remains unpaid or uncollected for a prolonged period of time, which may be used as a defense in a civil litigation case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjK5o8Fbw2loUw6HIBrt0p -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjK5o8Fbw2loUw6HIBrt0p">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Roi2OUuh5i5gPUoKu8Jyuc"/>
        <rdfs:label>Motion to Waive Filing of Excerpts of Record</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verzicht auf Einreichung von Auszügen aus dem Protokoll</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para renunciar a la presentación de extractos del registro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para renunciar a la presentación de extractos del registro</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour renoncer au dépôt d&apos;extraits du dossier</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Waive Filing of Excerpts of Record</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para dispensar a apresentação de excertos do registro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לפטור מהגשת צילומי רשומות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रिकॉर्ड के अंशों की फ़ाइलिंग से इनकार करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">記録抜粋の提出を免除する動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">豁免提交记录摘录的动议</skos:altLabel>
        <skos:definition>A Motion to Waive Filing of Excerpts of Record is a request made to the court to excuse a party from submitting certain portions of the record in a legal case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjKL1UdfWL1FCPVhnbIFSF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjKL1UdfWL1FCPVhnbIFSF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
        <dc:identifier>RRL</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=53"/>
        <rdfs:label>Real Estate, Rental and Leasing Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Immobilien-, Vermietungs- und Leasingbranche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de Bienes Raíces, Alquiler y Arrendamiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Bienes Raíces, Alquiler y Arrendamiento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie immobilière, de location et de leasing</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria imobiliária, de aluguel e leasing</skos:altLabel>
        <skos:altLabel>Real Estate, Rental and Leasing</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Real Estate, Rental and Leasing Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית נדלן, השכרה ומיתן בליסה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रियल एस्टेट, किराए पर देने और लीज़िंग उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不動産、レンタル、リース業界</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房地产、租赁和租赁行业</skos:altLabel>
        <skos:definition>The industry group comprises establishments primarily engaged in renting, leasing, or otherwise allowing the use of tangible or intangible assets, and establishments providing related services. The major portion of this sector comprises establishments that rent, lease, or otherwise allow the use of their own assets by others. The assets may be tangible, as is the case of real estate and equipment, or intangible, as is the case with patents and trademarks. This industry group also includes establishments primarily engaged in managing real estate for others, selling, renting and/or buying real estate for others, and appraising real estate.</skos:definition>
        <skos:hiddenLabel>RRL</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjLJSsBxaQyCliIG1ikK8FA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjLJSsBxaQyCliIG1ikK8FA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtpnOBk4lRnWigpEBBKYUDQ"/>
        <rdfs:label>X105 Word Processing</rdfs:label>
        <skos:definition>Any in-house word processing fees. Excludes word processing associated with a Translation (X139).</skos:definition>
        <skos:prefLabel>X105 Word Processing</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RjLrw4pDrBHKT8XC2lfAKh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RjLrw4pDrBHKT8XC2lfAKh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9qhyZbQlG5lHtijZL6Kt3l"/>
        <rdfs:label>Merger of Idea and Expression</rdfs:label>
        <skos:definition>The Merger of Idea and Expression doctrine in copyright law applies when an idea and its expression are so intertwined that the idea cannot be expressed in any other way, making the expression non-protectable. This principle recognizes that when only one or very few ways exist to express an idea, protecting such expression would effectively grant a monopoly over the idea itself.</skos:definition>
    </owl:Class>
    


