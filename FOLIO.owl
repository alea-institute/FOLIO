        <skos:altLabel xml:lang="ja-jp">ゾンカ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">宗喀语</skos:altLabel>
        <skos:definition>Dzongkha is a written or spoken structured system of communication that is the official language of Bhutan.</skos:definition>
    </owl:Class>
    


