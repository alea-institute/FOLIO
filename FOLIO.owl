        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Vendor ID of Legal Services Provider</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anbieter-ID für Rechtsdienstleistungen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">ID do fornecedor de serviços jurídicos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Identifiant de fournisseur de services juridiques</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Identificador de proveedor de servicios legales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Identificador de proveedor de servicios legales</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Vendor ID of Legal Services Provider</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זיהוי ספק שירותי משפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी सेवा प्रदाता का विक्रेता आईडी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律服务提供商的供应商ID</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法的サービスプロバイダーのベンダーID</skos:altLabel>
        <skos:definition>The ID of the provider used by the client.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9hhrrXatORR9EqD2UdC83r -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9hhrrXatORR9EqD2UdC83r">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
        <rdfs:label>Avoidance of Statutory liens</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Avoidance of Statutory liens</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Evitación de gravámenes estatutarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evitación de gravámenes estatutarios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Evitação de ônus estatutários</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vermeidung von gesetzlichen Pfandrechten</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Évitement des privilèges légaux</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הימנעות מטעני חוקיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विधायी लियन्स से बचाव</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法定抵当権の回避</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">避免法定留置权</skos:altLabel>
        <skos:definition>The concept of &quot;Avoidance of Statutory Liens&quot; refers to the legal action taken to prevent the enforcement of liens that are created by statute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9hiZkJdEEmVQCWrwvpHIa9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9hiZkJdEEmVQCWrwvpHIa9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sHH7RvjZ6aZS7ZExDpYmR"/>
        <rdfs:label>Pregnancy Status</rdfs:label>
        <skos:altLabel xml:lang="de-de">Schwangerschaftsstatus</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Status de gravidez</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Statut de grossesse</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">妊娠状態</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">怀孕状态</skos:altLabel>
        <skos:definition>Pregnancy status refers to the condition of a woman being pregnant, which is the period during which she carries a developing fetus within her uterus. In many jurisdictions, including the United States, discrimination based on pregnancy status is unlawful in various contexts, such as employment, housing, and public services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9hifDazPvowv0fWwqaomWj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9hifDazPvowv0fWwqaomWj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsDXW4XOplruZcWE3sKbal"/>
        <rdfs:label>President</rdfs:label>
        <skos:definition>A president is the elected head of state and, in many systems, also the head of government, responsible for executing laws, directing foreign and domestic policy, and representing the nation both domestically and internationally. The specific powers and duties of a president vary by country and are usually defined by a constitution or similar foundational legal document.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9hojcle5pX5ULl4lW5hWdX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9hojcle5pX5ULl4lW5hWdX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Saginaw Chippewa Indian Tribe</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9hrBuJlNrcENMSAGmTmbbS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9hrBuJlNrcENMSAGmTmbbS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
        <rdfs:label>Near Par</rdfs:label>
        <skos:altLabel>Close To Face Value</skos:altLabel>
        <skos:altLabel>Near Nominal Value</skos:altLabel>
        <skos:definition>Near Par refers to the trading price of a financial instrument, such as a bond or loan, that is close to its face value or nominal value. This indicates that the market price is approximately equal to the par value, typically within a narrow range above or below par.</skos:definition>
        <skos:example>A bond trading near par is priced slightly above or below its face value.</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9hrwkCteBcFva1vyZI6aYA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9hrwkCteBcFva1vyZI6aYA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7I291Cta585JlhpZvxV48y"/>
        <rdfs:label>Academic Transcript</rdfs:label>
        <skos:definition>An Academic Transcript is an official record provided by an educational institution that details a student&apos;s academic performance and history. It typically lists courses taken, grades received, credits earned, and any honors or awards conferred, serving as a comprehensive account of a student&apos;s academic achievements throughout their time at that institution.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9i2baqMppDj8enxXZkeIvJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9i2baqMppDj8enxXZkeIvJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7J7NYI0WlIIflyMEgnXHIq"/>
        <rdfs:label>Buyer Consent Not Unreasonably Conditioned</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Buyer Consent Not Unreasonably Conditioned</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Consentement de l&apos;acheteur non conditionné de manière déraisonnable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Consentimento do comprador não condicionado de forma irrazoável</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Consentimiento del comprador no condicionado de manera irrazonable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Consentimiento del comprador no condicionado de manera irrazonable</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Käufer-Einwilligung nicht unangemessen eingeschränkt</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכמת הקונה לא תותנה באופן לא סביר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार की सहमति अनुचित रूप से शर्त लगाई नहीं जानी चाहिए</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方同意不得不合理限制</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手の同意が不合理に制限されていない</skos:altLabel>
        <skos:definition>Buyer Consent Not Unreasonably Conditioned: A legal concept that requires a buyer&apos;s consent to be freely given without any unreasonable conditions imposed by the seller.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9i2zxWzdRux99NVnxtColj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9i2zxWzdRux99NVnxtColj">
