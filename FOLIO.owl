        <rdfs:label>New York City Court - Hornell</rdfs:label>
        <skos:definition>A court located in Hornell, New York City that has jurisdiction over certain legal matters within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QIxoqOUdevcMhlJurAxk3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QIxoqOUdevcMhlJurAxk3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R91rkMLuvkkfI4380vXkveh"/>
        <rdfs:label>National Stock Exchange</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QN0xnYI5Hase8OfxFx2Nd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QN0xnYI5Hase8OfxFx2Nd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLrqGkP9fi5OO2RhpttmVI"/>
        <rdfs:label>Earned Income</rdfs:label>
        <skos:definition>Earned income refers to the money an individual receives from working, including wages, salaries, bonuses, and commissions. It excludes income from investments, gifts, or other non-work-related sources, and serves as a basis for calculating taxes and assessing eligibility for certain benefits or deductions</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QQLAddYiYrVZR5UngMLk3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QQLAddYiYrVZR5UngMLk3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Competitor Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de concurrence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Competencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Competencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de concorrência</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Competitor Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wettbewerbsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוראת מתחרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतियोगी अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">竞争条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">競合条項</skos:altLabel>
        <skos:definition>A Competitor Clause is a provision in a contract that restricts one party from engaging in business activities that compete with the other party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QTWcwXG9FLUtwMaAvYfxl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QTWcwXG9FLUtwMaAvYfxl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqCSXkXFjhbokGf5IHmJ6a"/>
        <rdfs:label>Overpayment</rdfs:label>
        <skos:altLabel>Excess Payment</skos:altLabel>
        <skos:altLabel>Surplus Payment</skos:altLabel>
        <skos:definition>An overpayment occurs when a payer disburses more money than is owed to a recipient, which can happen in various contexts such as payroll, social benefits, or vendor payments. This typically necessitates corrective actions, including repayment or adjustment, to rectify the excess amount disbursed.</skos:definition>
        <skos:prefLabel>Overpaid</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
        <rdfs:label>Asset Exchange Attributes</rdfs:label>
        <skos:altLabel>Asset Swap Characteristics</skos:altLabel>
        <skos:altLabel>Financial Exchange Traits</skos:altLabel>
        <skos:definition>Asset Exchange Attributes encompass various methods by which financial assets are traded or converted to achieve specific strategic objectives. These attributes involve transactions where assets like debt and equity are exchanged to improve financial structure, raise capital, or consolidate ownership.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QVPObEikXAXDwK0bNSAbM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QVPObEikXAXDwK0bNSAbM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  Lycoming County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Lycoming County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering legal proceedings in Lycoming County, Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QY3CBx7aGdsSVGBQTMP18 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QY3CBx7aGdsSVGBQTMP18">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Guidiville Rancheria of California</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QcJpEJ19eAN8glCzxd4Wo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QcJpEJ19eAN8glCzxd4Wo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
        <rdfs:label>Legal Operations</rdfs:label>
        <skos:definition>Legal Operations refers to the management of legal processes and resources within a legal department or organization, including matter management, project management, spend management, and other related activities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Qf9X22qnr7DDy7sBFXP9K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Qf9X22qnr7DDy7sBFXP9K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ZZ3NsCK0vyOmGji7SpKkW"/>
        <rdfs:label>Littering</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Fly-Tipping</skos:altLabel>
        <skos:definition>Littering is the act of improperly disposing of waste materials in public or private spaces, rather than in designated trash receptacles. This behavior results in environmental pollution, health hazards, and can lead to significant fines and penalties.</skos:definition>
        <skos:prefLabel>Illegal Dumping</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QkbfBhORCO4PzTokhEiJv -->

