    <!-- https://folio.openlegalstandard.org/RB5gf73BI6veb6i7yvZa472 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB5gf73BI6veb6i7yvZa472">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2K2E9rftRKciKOqkr1BeV"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Two-round_system"/>
        <rdfs:label>Two Round Electoral System</rdfs:label>
        <skos:altLabel>Double Ballot</skos:altLabel>
        <skos:altLabel>Majority Runoff</skos:altLabel>
        <skos:altLabel>Majority Runoff System</skos:altLabel>
        <skos:altLabel>Runoff Voting</skos:altLabel>
        <skos:altLabel>Second Round Voting</skos:altLabel>
        <skos:altLabel>Two-Round Voting</skos:altLabel>
        <skos:altLabel>Two-Stage Voting</skos:altLabel>
        <skos:definition>A two-round electoral system, also known as runoff voting, is a voting method where if no candidate achieves a required majority in the first round, a second round is held between the top candidates. This system ensures that the winner has broad support, typically requiring a majority of votes in the final round.</skos:definition>
        <skos:example>Double Ballot: Brazilian presidential elections</skos:example>
        <skos:example>Majority Runoff: French presidential elections</skos:example>
        <skos:example>Second Round Voting: Russian gubernatorial elections</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB5gqaWropAnzq8l6tvaMTp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB5gqaWropAnzq8l6tvaMTp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
        <rdfs:label>Property Air Right</rdfs:label>
        <skos:altLabel>Development Air Rights</skos:altLabel>
        <skos:altLabel>Overhead Space Rights</skos:altLabel>
        <skos:definition>Property Air Rights refer to the legal entitlement to use, develop, or control the space above a piece of real property. This concept extends the traditional notion of property ownership vertically, allowing landowners or developers to potentially construct buildings, sell the rights for development, or otherwise utilize the airspace above their land.</skos:definition>
        <skos:prefLabel>Aerial Rights</skos:prefLabel>
    </owl:Class>
    


