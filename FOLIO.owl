        <skos:altLabel xml:lang="de-de">Antrag auf Aussetzung des Verfahrens bis zur Untersuchung durch die ITC</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ITC調査を待って訴訟を一時停止する動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">ITC调查期间暂停诉讼动议</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para suspender los procedimientos pendientes de investigación de la ITC</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para suspender los procedimientos pendientes de investigación de la ITC</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion de suspension de la procédure en attendant l&apos;enquête de la ITC</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Stay Proceedings Pending ITC Investigation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de suspensão do processo pendente de investigação da ITC</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להשהיית הליך בהמתנה לחקירת ה-ITC</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आईटीसी जांच के बाद कार्यवाही स्थगित करने के लिए मोशन</skos:altLabel>
        <skos:definition>A Motion to Stay Proceedings Pending ITC Investigation is a legal request to pause a court case while an investigation is conducted by the International Trade Commission.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTQmXmV8s83AYswBJrQ8Dc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTQmXmV8s83AYswBJrQ8Dc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCpnqQCzeexk3k9kkbLx1Zu"/>
        <rdfs:label>Arbitrary and Capricious</rdfs:label>
        <skos:altLabel xml:lang="es-es">Arbitrario y Caprichoso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Arbitrario y Caprichoso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Arbitrary and Capricious</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">arbitraire et capricieux</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">arbitrário e caprichoso</skos:altLabel>
        <skos:altLabel xml:lang="de-de">willkürlich und launisch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בלתי חוקי ופושע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनियमित और अनुमोदनीय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">恣意的で気まぐれな</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">武断和反复无常</skos:altLabel>
        <skos:definition>A legal standard of review used by appellate courts to determine whether an agency&apos;s decision was made without any rational basis or in an unpredictable manner.</skos:definition>
        <skos:prefLabel>Hard Look Review</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTVO33fpYYluy40LKb5I6m -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTVO33fpYYluy40LKb5I6m">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Unsolicited Information Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;information non sollicitée</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Información No Solicitada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Información No Solicitada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Informação Não Solicitada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für unerwünschte Informationen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unsolicited Information Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מידע לא מבוקש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनचाही सूचना शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未经请求信息条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">要請なし情報条項</skos:altLabel>
        <skos:definition>An Unsolicited Information Clause is a provision in a contract that specifies the conditions under which unsolicited information provided by one party to the other will be treated as confidential and not used for any purpose other than the intended purpose.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTYuUGjXvFGHrhl6PwAMt0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTYuUGjXvFGHrhl6PwAMt0">
