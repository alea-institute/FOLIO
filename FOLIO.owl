    <!-- https://folio.openlegalstandard.org/R9q2Y9Ds3fbGrRa0SxPZ551 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9q2Y9Ds3fbGrRa0SxPZ551">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCLxFZZvTWZmKpUYJa6UMmO"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBiKxjgQ4fCptoehaw3ssba"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>376 Qui Tam  (PACER NoS)</rdfs:label>
        <skos:altLabel>31 U.S.C. § 3729(a</skos:altLabel>
        <skos:definition>Action brought under the False Claims Act by private persons (also known as &quot;whistleblowers&quot;) on their own behalf and on behalf of the United States to recover damages against another person or entity that acted fraudulently in receiving payments or property from, or avoiding debts owed to, the United States Government, 31 U.S.C. § 3730</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9q3ww86gR2YzIpw6PiWdIq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9q3ww86gR2YzIpw6PiWdIq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu"/>
        <rdfs:label>Organization for Security and Co-operation in Europe</rdfs:label>
        <skos:definition>OSCE (Organization for Security and Co-operation in Europe): The world&apos;s largest security-oriented intergovernmental organization, whose mandate includes issues such as arms control and the promotion of human rights, freedom of the press, and fair elections.</skos:definition>
        <skos:prefLabel>OSCE</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9q4epP5NYLatJZ0eFtAcsE -->

