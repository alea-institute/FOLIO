        <skos:altLabel xml:lang="pt-br">Cláusula de assinatura por fac-símile</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de firma por facsímil</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de firma por facsímil</skos:altLabel>
