        <skos:altLabel xml:lang="es-mx">Contraprestación - Efectivo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Contraprestação - Dinheiro</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Contrepartie - Espèces</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenleistung - Bargeld</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תמורה - מזומן</skos:altLabel>
