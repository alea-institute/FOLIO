        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI"/>
        <rdfs:label>Texas District Court - Dallas County</rdfs:label>
        <skos:definition>A Texas District Court located in Dallas County, which has jurisdiction over civil and criminal cases within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Pr3Om4eSaH0cIW4B3sCCv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Pr3Om4eSaH0cIW4B3sCCv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMCyg29yJdESbSXnNRLABk"/>
        <rdfs:label>Common Share</rdfs:label>
        <skos:definition>Common Shares, also known as Ordinary Shares, represent a basic unit of equity ownership in a company, granting shareholders voting rights and a share in the company&apos;s profits through dividends. These shares typically entitle the holder to one vote per share and are the most prevalent type of stock issued by companies.</skos:definition>
        <skos:prefLabel>Ordinary Share</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8PtSWt5IQ5kyBmQX8ckM4h -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8PtSWt5IQ5kyBmQX8ckM4h">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Xrium2aVaYqlV8F4UZu6u"/>
        <rdfs:label>Trademark Management</rdfs:label>
        <skos:definition>Trademark Management refers to the process of overseeing and protecting a company&apos;s registered trademarks, including monitoring for infringement and taking legal action when necessary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8PvYibP2eJP2dynJCZMipF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8PvYibP2eJP2dynJCZMipF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bS3yb1nTD8lCzWFVFMZ0c"/>
        <rdfs:label>Due Diligence Management</rdfs:label>
        <skos:definition>Due Diligence Management refers to the process of conducting a thorough investigation and analysis of a legal transaction to ensure that all relevant information is disclosed and risks are identified and mitigated.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Q31MHgiF9qpQ2nPT5UPWp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Q31MHgiF9qpQ2nPT5UPWp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg"/>
        <rdfs:label>Investment Services Agreement</rdfs:label>
        <skos:definition>An Investment Services Agreement is a contract between an investor and a service provider detailing the scope of investment-related services to be offered. It outlines fees, responsibilities, and terms of the relationship.</skos:definition>
        <skos:prefLabel>Professional Services Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Q5eUVeKWV9xjRROmu7jh4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Q5eUVeKWV9xjRROmu7jh4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Copper River</rdfs:label>
    </owl:Class>
    


