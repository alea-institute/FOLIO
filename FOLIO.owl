    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/C1VQEzHJQKmzcyM2CQ0ePg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/C1VQEzHJQKmzcyM2CQ0ePg">
