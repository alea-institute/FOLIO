        <rdfs:label>Deposition Transcripts Expense</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Deposition Transcripts Expense</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Despesas de transcrição de depoimentos</skos:altLabel>
