    <!-- https://folio.openlegalstandard.org/RCymFqZ4uzSi1MXyfIUk1TH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCymFqZ4uzSi1MXyfIUk1TH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R82DCY9wpy8RlxYrwn0NIya"/>
        <dc:source>Fed. R. Evid. 801(d)(2)</dc:source>
        <rdfs:label>Party Admission</rdfs:label>
        <skos:altLabel>Admission by a Party</skos:altLabel>
        <skos:altLabel>Statement by a Party Opponent</skos:altLabel>
        <skos:definition>A Party Admission is a statement made by a party to a legal proceeding that is offered as evidence against that party. Party admissions are considered non-hearsay and are admissible as an exception to the hearsay rule due to the inherent reliability and fairness of allowing a party&apos;s own statements to be used against them.</skos:definition>
    </owl:Class>
    


