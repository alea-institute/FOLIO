        <rdfs:label>Pre-petition Payroll Motion</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Lohnzahlungen vor Insolvenzantragstellung</skos:altLabel>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de nómina previa a la petición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de nómina previa a la petición</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mouvement de paie avant la pétition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Movimento de folha de pagamento pré-petição</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pre-petition Payroll Motion</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועת שכר לפני הפטיציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्व-याचिका वेतन आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">申请在破产申请前支付工资</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産申請前の給与支払い請求</skos:altLabel>
        <skos:definition>A Pre-petition Payroll Motion is a request made in a bankruptcy case by the debtor to pay its employees for work done prior to the bankruptcy filing.</skos:definition>
    </owl:Class>
    


