        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVoyN9hN3m5gy3So01ZEZ8"/>
        <rdfs:label>Credit and Loan Agreement</rdfs:label>
        <skos:definition>A Credit and Loan Agreement is a legally binding contract between a lender and a borrower that outlines the terms and conditions for the provision of credit or a loan. The agreement specifies key details such as the amount borrowed, interest rate, repayment schedule, and any collateral required, among other terms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GCqTLHXUHtoNF4oTScTwn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GCqTLHXUHtoNF4oTScTwn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJxZ2vqqnde5q8ti6PKfnF"/>
        <rdfs:label>Tire Tread Evidence</rdfs:label>
        <skos:definition>Tire tread evidence encompasses the patterns and impressions left by vehicle tires on surfaces. By analyzing these marks, forensic experts can determine the type, brand, and sometimes specific wear characteristics of the tire, potentially linking a vehicle to a crime scene.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GEy8ufSRnWtGcuIbYIULS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GEy8ufSRnWtGcuIbYIULS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoYTC8fQGfAAw076QxHUOA"/>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Tax Point Date</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Data de vencimento do imposto</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Date de point de départ de la taxe</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fecha de Devengo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fecha de Devengo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Stichtag für die Umsatzsteuer</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tax Point Date</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תאריך נקודת המס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टैक्स पॉइंट डेट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">税点日期</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">税金支払日</skos:altLabel>
        <skos:definition>Tax Point Date refers to the specific date on which a taxable event occurs for the purpose of calculating taxes, and is a subcategory of Fee Invoice Detail within the context of Engagement Terms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GGCFTuQOQr6JDA7FtPs3k -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GGCFTuQOQr6JDA7FtPs3k">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
        <rdfs:label>Government Guarantee</rdfs:label>
        <skos:altLabel>Public Sector Guarantee</skos:altLabel>
        <skos:altLabel>Sovereign Guarantee</skos:altLabel>
        <skos:altLabel>State Backing</skos:altLabel>
        <skos:definition>A Government Guarantee is a formal assurance provided by a governmental entity to support the fulfillment of financial obligations associated with a debt instrument or investment. This guarantee serves as a pledge that the government will assume responsibility for repayment if the primary obligor defaults, thereby enhancing the security and creditworthiness of the guaranteed instrument.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GH4lWmfRGQNHS1hK97XvV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GH4lWmfRGQNHS1hK97XvV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Emmonak Village</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GHNEldQkw0cY65ZzkeI6x -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GHNEldQkw0cY65ZzkeI6x">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/2.00-SpecialSensesandSpeech-Adult.htm#2_09"/>
        <rdfs:label>Aphonia</rdfs:label>
        <skos:altLabel>Complete Voice Loss</skos:altLabel>
        <skos:altLabel>Loss of Vocal Function</skos:altLabel>
        <skos:altLabel>Vocal Cord Paralysis</skos:altLabel>
        <skos:altLabel>Voice Loss</skos:altLabel>
        <skos:definition>Aphonia is the complete loss of voice resulting from the inability to produce vocal sounds through the vocal cords, resulting in the inability to produce speech that can be heard, understood, or sustained. This condition can be caused by various factors, including severe laryngitis, vocal cord paralysis, trauma to the larynx, or neurological disorders.</skos:definition>
        <skos:prefLabel>Muteness</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GMQKpTR1BKKzaxuJ9hIbu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GMQKpTR1BKKzaxuJ9hIbu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCyxRxLaFWEAqsqfWxvvPeb"/>
        <rdfs:label>JH10 Own expert evidence (UK J-CODE)</rdfs:label>
        <skos:definition>Identifying and interviewing experts and consultants (testifying or non-testifying), working with them, and developing expert reports. Reviewing case in the light of such evidence.  Considering questions asked by Other Party(s) of own experts and experts&apos; responses.  Arranging experts&apos; discussions.  Considering reports of experts&apos; discussions.  Includes all communications or other work with counsel, and all communications with Other Party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GOYxxxk0U08WymbPpNpKN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GOYxxxk0U08WymbPpNpKN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED Debtor Claims Practice</rdfs:label>
        <skos:definition>A debtor claims practice is a deprecated concept related to the legal process of making claims against a debtor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GQ9A16tcviwBa7ali0aNW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GQ9A16tcviwBa7ali0aNW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9VNdcgRmlUlOc4aJbx1HJm"/>
        <rdfs:label>Construction Site Negligence</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Construction Site Negligence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fahrlässigkeit auf der Baustelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia en el sitio de construcción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia en el sitio de construcción</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência no canteiro de obras</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence sur le chantier de construction</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הזנחת אתר בנייה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्माण स्थल लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">建筑工地疏忽</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">建設現場の過失</skos:altLabel>
        <skos:definition>Construction Site Negligence refers to the failure of a construction company or its employees to exercise reasonable care in maintaining a safe work environment, resulting in harm or injury to workers or others on the construction site.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GRSUAwEKQ5NsqXEiOccbo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GRSUAwEKQ5NsqXEiOccbo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeiXNGpqL4H3jo1g1NobSm"/>
        <rdfs:label>Indiana Circuit Court - Gibson County</rdfs:label>
        <skos:definition>Indiana Circuit Court - Gibson County refers to a specific court within the Indiana Circuit Court system that has jurisdiction over legal matters within Gibson County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GWnUebs85ID4mFgoPO49i -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GWnUebs85ID4mFgoPO49i">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCtUZjZqZ1lszDFiDOLUuTh"/>
        <rdfs:label>Illinois Circuit Court - Jefferson County (2nd Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GaS9pNRiLf8ucevJN7bih -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GaS9pNRiLf8ucevJN7bih">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDLANHrFj8nfaiNIalX9Ndx"/>
        <rdfs:label>Castle Doctrine Claim</rdfs:label>
        <skos:altLabel>Defence of Habitation Claim</skos:altLabel>
        <skos:altLabel>Domestic Self-Defense Claim</skos:altLabel>
        <skos:definition>A Castle Doctrine Claim refers to a legal principle that allows a person to use force, including deadly force, in defense of their home or dwelling without the duty to retreat. This doctrine is based on the premise that one&apos;s home is their castle, and they have the right to protect it and its occupants from intruders or attackers.</skos:definition>
        <skos:prefLabel>Home Defense Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GgZWuLOPjDMH0v2bPfltu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GgZWuLOPjDMH0v2bPfltu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9eX3Auj16MgFGGYWRmhns8"/>
        <rdfs:label>Paraplegia</rdfs:label>
        <skos:altLabel>Lower Body Paralysis</skos:altLabel>
        <skos:definition>Paraplegia is a type of mobility disability characterized by the partial or complete paralysis of the lower half of the body, including both legs. This condition typically results from spinal cord injuries or diseases affecting the thoracic, lumbar, or sacral regions of the spine, leading to loss of motor and sensory function below the level of injury.</skos:definition>
        <skos:prefLabel>Paraplegic Condition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ggob7gh8BXqgSg9gvZ4ru -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ggob7gh8BXqgSg9gvZ4ru">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ludoWmVMfon7jd8o6ak6E"/>
        <rdfs:label>Motion to File Oversized Petition for Rehearing</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einreichung einer überdimensionierten Petition zur erneuten Verhandlung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para presentar una petición de reconsideración de gran tamaño</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer une pétition de réexamen de grande taille</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Oversized Petition for Rehearing</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para arquivar petição de reconsideração em tamanho grande</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para presentar una petición de reconsideración de gran tamaño</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה להגשת עצומה לפטירה מחדש עם גודל גדול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पुनरावृत्ति के लिए ओवरसाइज़्ड याचिका दाखिल करने के लिए अर्जन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">再審請求の大型申立てを提出するための動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交超大尺寸再审请示动议</skos:altLabel>
        <skos:definition>A Motion to File Oversized Petition for Rehearing is a request to submit a petition for rehearing that exceeds the standard size limit set by the court, typically due to the complexity of the case or the amount of evidence presented.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GhYhVpQcfACzLmyST872w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GhYhVpQcfACzLmyST872w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:label>International Annual Report</rdfs:label>
        <skos:definition>An International Annual Report is an annual report of a foreign company listed on a domestic stock exchange. In the United States, Form 40-F is an annual report filed with the U.S. Securities and Exchange Commission by Canadian issuers to register securities under the Securities Exchange Act of 1934. The 40-F serves as a combined annual report and registration statement, providing key financial statements, management discussion and analysis, and detailed business information. It helps meet SEC disclosure requirements for foreign private issuers accessing U.S. capital markets.</skos:definition>
        <skos:prefLabel>40-F</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GiJsMoTZg1cqRPGgwmQ2H -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GiJsMoTZg1cqRPGgwmQ2H">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rb9ymr4tGQwciL1lrwg0UN"/>
        <rdfs:label>Trademark Renewal Process</rdfs:label>
        <skos:definition>The trademark renewal process is a legal procedure that allows the owner of a registered trademark to extend the protection of the trademark beyond its initial term. This process typically involves submitting a renewal application and paying the required fees before the expiration of the current registration period.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Git6fvqGuGe2U4QMFH4nR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Git6fvqGuGe2U4QMFH4nR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBxw7BF15bDA0Ifn2vOrC8h"/>
        <rdfs:label>Georgia District Court - Walker County</rdfs:label>
        <skos:definition>Georgia District Court - Walker County: A specific court within the Georgia District Court system that has jurisdiction over legal matters within Walker County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Gl11ci9eu3hIdRBW6tY4C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Gl11ci9eu3hIdRBW6tY4C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCLhlWbP1bW4sRAflunmrrz"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8YEKFiYkowitD7dlvVs9Dj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Limited Conservatorship of Adult</rdfs:label>
        <skos:altLabel xml:lang="de-de">Begrenzte Vormundschaft für Erwachsene</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Curatela limitada de adultos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Limited Conservatorship of Adult</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tutela limitada de adultos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tutela limitada de adultos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tutelle limitée des adultes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגבלת הוטלת על מבוגר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वयस्क की सीमित संरक्षण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">成年人有限监护</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">成年後見の限定</skos:altLabel>
        <skos:definition>A Limited Conservatorship of Adult is a legal arrangement in which a conservator is appointed to manage the personal and/or financial affairs of an adult with developmental disabilities who is unable to fully care for themselves, but only to the extent necessary to provide for their basic needs and protect them from harm.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GqgpAu9J8iXUREZ3M7wzO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GqgpAu9J8iXUREZ3M7wzO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS"/>
        <dc:identifier>MFG-METL</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=331"/>
        <rdfs:label>Primary Metal Manufacturing Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de fabricación de metales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de fabricación de metales</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de la fabrication de métaux</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de fabricação de metais</skos:altLabel>
        <skos:altLabel>Metal Manufacturing</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Metal Manufacturing Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Metallverarbeitungsindustrie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית ייצור מתכת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मेटल विनिर्माण उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">金属制造业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">金属製造業</skos:altLabel>
        <skos:definition>Industries in the Primary Metal Manufacturing subsector smelt and/or refine ferrous and nonferrous metals from ore, pig, or scrap, using electrometallurgical and other process metallurgical techniques.  Establishments in this subsector also manufacture metal alloys and superalloys by introducing other chemical elements to pure metals.  The output of smelting and refining, usually in ingot form, is used in rolling, drawing, and extruding operations to make sheet, strip, bar, rod, or wire, and in molten form to make castings and other basic metal products.

Primary manufacturing of ferrous and nonferrous metals begins with ore or concentrate as the primary input.  Establishments manufacturing primary metals from ore and/or concentrate remain classified in the primary smelting, primary refining, or iron and steel mill industries regardless of the form of their output.  Establishments primarily engaged in secondary smelting and/or secondary refining recover ferrous and nonferrous metals from scrap and/or dross.  The output of the secondary smelting and/or secondary refining industries is limited to shapes such as ingot or billet that will be further processed.  Recovery of metals from scrap often occurs in establishments that are primarily engaged in activities, such as rolling, drawing, extruding, or similar processes.

Excluded from the Primary Metal Manufacturing subsector are establishments primarily engaged in manufacturing ferrous and nonferrous forgings (except ferrous forgings made in steel mills) and stampings.  Although forging, stamping, and casting are all methods used to make metal shapes, forging and stamping do not use molten metals and are included in Subsector 332, Fabricated Metal Product Manufacturing.  Establishments primarily engaged in operating coke ovens are classified in Industry 32419, Other Petroleum and Coal Products Manufacturing.</skos:definition>
        <skos:hiddenLabel>METL</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GrBYx6nWx1AZRaEDNMBaO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GrBYx6nWx1AZRaEDNMBaO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtHkyQ5lSxRaJ9oaSOWbkx"/>
        <rdfs:label>Dead</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Mort</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Morto</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Tot</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">死亡</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">死亡した</skos:altLabel>
        <skos:definition>Dead refers to the state of an individual who has ceased to live and has no vital signs or brain activity.</skos:definition>
        <skos:prefLabel>Deceased</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GyZHycC6BBiKe9DBhAUej -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GyZHycC6BBiKe9DBhAUej">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmqysGFQ1RYW3F9lv5u3hu"/>
        <rdfs:label>Investor Questionnaire</rdfs:label>
        <skos:definition>An Investor Questionnaire in a legal and financial context is a structured document consisting of a series of questions designed to gather specific information from the respondent. It is often used for due diligence purposes, like in Bad Actor Questionnaires to assess regulatory compliance, or FINRA Questionnaires to evaluate suitability for financial industry roles.</skos:definition>
        <skos:example>Bad Actor Questionnaire</skos:example>
        <skos:example>FINRA Questionnaire</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9GzNUToNbpmO2ZBdTqwkgT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9GzNUToNbpmO2ZBdTqwkgT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RXglkHnO0P9PdVdDRHi9wJ"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Employer&apos;s Failure to Obtain Workers&apos; Compensation Insurance Policy</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Défaut de l&apos;employeur de souscrire une assurance accidents du travail</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Employer&apos;s Failure to Obtain Workers&apos; Compensation Insurance Policy</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha do empregador em obter uma apólice de seguro de acidentes de trabalho</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta del empleador de obtener una póliza de seguro de compensación laboral</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta del empleador de obtener una póliza de seguro de compensación laboral</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versäumnis des Arbeitgebers, eine Arbeitsunfallversicherung abzuschließen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כישלון המעסיק לקבל פוליסת ביטוח תאונות עבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नियोक्ता की श्रमिक रक्षा बीमा नीति प्राप्त करने में विफलता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">雇主未能获得工伤保险政策</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">雇用者が労災保険の保険証を取得しなかった場合</skos:altLabel>
        <skos:definition>The failure of an employer to obtain an insurance policy that provides benefits to employees who suffer work-related injuries or illnesses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo"/>
        <rdfs:label>Multi-National Governmental Body</rdfs:label>
        <skos:altLabel>Supranational Organization</skos:altLabel>
        <skos:definition>A Multi-National Governmental Body refers to an organization formed by a coalition of multiple nations, primarily to address collective concerns, facilitate diplomatic relations, or coordinate actions in various fields. These entities operate based on treaties or agreements and often have a governing structure, legal personality, and set jurisdictions.</skos:definition>
        <skos:prefLabel>Supranational Governmental Body</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9H2moSYZ56RmnlXQ06F6gY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9H2moSYZ56RmnlXQ06F6gY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RrECTdM9f5ml4sac9MFrSC"/>
        <rdfs:label>U.S. Code of Federal Regulations</rdfs:label>
        <skos:altLabel>CFR</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Code des réglementations fédérales des États-Unis</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Código de Regulamentações Federais dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="de-de">U.S. Code of Federal Regulations</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">米国連邦規則集</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">美国联邦法规</skos:altLabel>
        <skos:definition>Rules or orders issued by a United States governmental regulatory agency and having the force of law.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9H4TEsEcgxSg5BEzliohZS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9H4TEsEcgxSg5BEzliohZS">
