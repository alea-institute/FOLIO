        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
        <rdfs:label>Ambulance Negligence</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Ambulance Negligence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia de ambulancia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia de ambulancia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência de ambulância</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence des ambulances</skos:altLabel>
