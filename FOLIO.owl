    <!-- https://folio.openlegalstandard.org/RCcUqT9sneDczCJi10eOBg0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCcUqT9sneDczCJi10eOBg0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:label>Foreign Corrupt Practices Act Claim</rdfs:label>
        <skos:altLabel>FCPA Violation Claim</skos:altLabel>
        <skos:altLabel>Foreign Bribery Claim</skos:altLabel>
        <skos:altLabel>International Bribery Claim</skos:altLabel>
        <skos:definition>A Foreign Corrupt Practices Act (FCPA) Claim arises when an individual or entity is accused of violating the FCPA, which prohibits bribery of foreign officials to obtain or retain business. This claim involves allegations of unlawful payments, gifts, or offers made to foreign officials to influence their actions or decisions.</skos:definition>
        <skos:prefLabel>FCPA Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCcWasK7LnVMXipm7uQAOA2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCcWasK7LnVMXipm7uQAOA2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Visitor</rdfs:label>
        <skos:definition>A visitor is an individual who temporarily enters a specific location, such as a country, city, or residence, for various purposes. Visitors can include tourists, who travel for leisure and exploration; business visitors, who come for work-related activities; or guests invited to a residence for social or personal reasons. The nature of the visit and applicable regulations, such as visa requirements or entry permissions, can differ based on the visitor&apos;s purpose and destination.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCcZ4MjUhqQHbZjYzjlwuIg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCcZ4MjUhqQHbZjYzjlwuIg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOBgLFktExGekPrKF5oWmr"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Schizoaffective Disorder</rdfs:label>
        <skos:definition>Schizoaffective Disorder is a mental health condition characterized by the presence of both schizophrenia symptoms and mood disorder symptoms (either depressive or manic episodes). Individuals with this disorder experience significant disruptions in their mood and cognitive functioning, leading to impairments in daily life.</skos:definition>
    </owl:Class>
    


