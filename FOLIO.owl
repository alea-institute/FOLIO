            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>460 Deportation (PACER NoS)</rdfs:label>
        <skos:definition>Action filed under the Immigration Acts (Habeas Corpus &amp; Review) 8:1101/18:1546</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jm33RbQQ4tbeT77BQJ6IU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jm33RbQQ4tbeT77BQJ6IU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Ahr1iRMkczkHNvcrZ3KOG"/>
        <rdfs:label>Money Market Fund</rdfs:label>
        <skos:definition>A Money Market Fund is an investment fund that aims to provide investors with a safe place to invest easily accessible, liquid assets. These funds typically invest in short-term debt securities like Treasury bills and commercial paper, and they are considered low-risk, offering relatively stable returns compared to other investment vehicles.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jmZydz8x3qTI53akaBSS8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jmZydz8x3qTI53akaBSS8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9H0HvybK6M3RpFebn0SDLu"/>
        <rdfs:label>Southern Common Market</rdfs:label>
        <skos:definition>Mercosur (Southern Common Market): A South American trade bloc established to promote free trade and the fluid movement of goods, people, and currency.</skos:definition>
        <skos:prefLabel>Mercosur</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jp9mAfFHSfJBbsZRlBjBM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jp9mAfFHSfJBbsZRlBjBM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Choice of Law Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Choice of Law Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de choix de loi</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de elección de ley</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de elección de ley</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de escolha de lei</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtswahlklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף בחירת החוק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानून का चयन अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律选择条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">準拠法選択条項</skos:altLabel>
        <skos:definition>A Choice of Law Clause is a provision in a contract that specifies which jurisdiction&apos;s laws will govern the interpretation and enforcement of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jqfUwpteNxuBdyvBeZXp3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jqfUwpteNxuBdyvBeZXp3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9jNLx5iR4vOfU2Gp8bOZ3K"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Good Samaritan Liability</rdfs:label>
        <skos:altLabel>Emergency Aid Not Given or Not Properly Given</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Good Samaritan Liability</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftung des guten Samariters</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad del buen samaritano</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad del buen samaritano</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade do bom samaritano</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité du bon samaritain</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות הסמרטן הטוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अच्छा समरिटन दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">善意のサマリア人責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">好心人责任</skos:altLabel>
        <skos:definition>The concept of Good Samaritan Liability refers to the legal responsibility of an individual who fails to provide or properly provide emergency aid to someone in need, despite having the ability to do so, and may be held liable for any resulting harm.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jrGbceP231WdSoARFhMQQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jrGbceP231WdSoARFhMQQ">
