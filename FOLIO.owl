    <!-- https://folio.openlegalstandard.org/R0q5hTo2yTMlnIAbmFnwCH -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R0q5hTo2yTMlnIAbmFnwCH">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:label>hasFigure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R1L3IueMeHCrxnDlOU2dRg -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R1L3IueMeHCrxnDlOU2dRg">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R7VtpAC807aOYLVtKmPvFRt"/>
        <rdfs:label>opposed</rdfs:label>
        <skos:altLabel>contested</skos:altLabel>
        <skos:altLabel>disputed</skos:altLabel>
        <skos:altLabel>opposed</skos:altLabel>
        <skos:notation>folio:contested</skos:notation>
        <skos:notation>folio:opposed</skos:notation>
        <skos:notation>folio:disputed</skos:notation>
        <skos:definition>In the context of an argument, &quot;opposed&quot; refers to the stance taken against a particular claim, assertion, or position. An opposed argument counters or refutes the original claim by presenting contrary evidence, reasoning, or viewpoints. In debates or discussions, this oppositional stance is vital for ensuring a comprehensive exploration of the topic at hand.</skos:definition>
        <skos:prefLabel>disputed</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R1us3pQhG9zkEb39dZHByB -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R1us3pQhG9zkEb39dZHByB">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCnTNVCQ1VndGxskbMoaLr8"/>
        <rdfs:label>observed</rdfs:label>
        <skos:altLabel>observed</skos:altLabel>
        <skos:notation>folio:watched</skos:notation>
        <skos:altLabel>watched</skos:altLabel>
        <skos:altLabel>witnessed</skos:altLabel>
        <skos:notation>folio:observed</skos:notation>
        <skos:notation>folio:witnessed</skos:notation>
        <skos:definition>In various legal contexts, &quot;observed&quot; refers to the act of witnessing, watching, or monitoring an event, situation, or process. This can include an attorney attending a deposition to oversee the process, a witness visually witnessing a crime, or a citizen attending and watching a trial. Observation in legal contexts can imply going beyond passive viewing, where the observer may potentially provide future testimony or use the observed information in later proceedings.</skos:definition>
        <skos:example>Attorney Observed Deposition</skos:example>
        <skos:example>Citizen Observed Trial</skos:example>
        <skos:example>Witness Observed Crime</skos:example>
        <skos:prefLabel>witnessed</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R3DWdkCuByi2y5EimZYMab -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R3DWdkCuByi2y5EimZYMab">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>owned</rdfs:label>
        <skos:altLabel>owned</skos:altLabel>
        <skos:notation>folio:owned</skos:notation>
        <skos:definition>In legal and financial contexts, &quot;owned&quot; refers to the possession or holding of rights, titles, or interests in property, assets, or securities. This implies a legal relationship between the owner and the object of ownership, conferring certain rights, such as usage, control, and transfer. Ownership can apply to tangible assets like houses or intangible assets like shares in a company.</skos:definition>
        <skos:example>Company owned Property</skos:example>
        <skos:example>Person Owned House</skos:example>
        <skos:example>Shareholder Owned Shares</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R3FCcrFyaoiMddiRqdTfgf -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R3FCcrFyaoiMddiRqdTfgf">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>not</rdfs:label>
        <skos:definition>A logical negation operator that excludes items containing the subsequent search term from the results.</skos:definition>
        <skos:notation>folio:not</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R3zM4v3AKS03zKslpmcdLP -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R3zM4v3AKS03zKslpmcdLP">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>analyzed</rdfs:label>
        <skos:altLabel>analyzed</skos:altLabel>
        <skos:altLabel>assessed</skos:altLabel>
        <skos:altLabel>evaluated</skos:altLabel>
        <skos:notation>folio:assessed</skos:notation>
        <skos:notation>folio:scrutinized</skos:notation>
        <skos:altLabel>scrutinized</skos:altLabel>
        <skos:notation>folio:analyzed</skos:notation>
        <skos:notation>folio:evaluated</skos:notation>
        <skos:definition>&quot;Analyzed&quot; in a legal context encompasses a comprehensive and methodical examination of legal issues, documents, or evidence. It involves applying critical thinking, legal knowledge, and analytical skills to understand, interpret, and draw conclusions from legal materials, often forming the basis for legal strategies, arguments, or decisions.</skos:definition>
        <skos:prefLabel>evaluated</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R4HVaajKP29IEU6HxKgCBL -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R4HVaajKP29IEU6HxKgCBL">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>maxResults</rdfs:label>
        <skos:definition>Specifies a limit on the number of results returned by a query.</skos:definition>
        <skos:notation>folio:maxResults</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R55RwIpe6K1xGWsaee45Ch -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R55RwIpe6K1xGWsaee45Ch">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>negotiated</rdfs:label>
        <skos:altLabel>negotiated</skos:altLabel>
        <skos:notation>folio:negotiated</skos:notation>
        <skos:definition>In legal and business contexts, &quot;negotiated&quot; refers to the process of discussing, deliberating, and reaching an agreement or compromise between parties. This involves the back-and-forth exchange of proposals and concessions, with the goal of resolving differences and concluding an arrangement, such as a contract, settlement, or plea deal.</skos:definition>
        <skos:example>Lawyer Negotiated Settlement</skos:example>
        <skos:example>Party Negotiated Contract</skos:example>
        <skos:example>Prosecutor Negotiated Plea</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R6qohvM786wjw0MNQJg9Dq -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R6qohvM786wjw0MNQJg9Dq">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>drafted</rdfs:label>
        <skos:altLabel>composed</skos:altLabel>
        <skos:altLabel>drafted</skos:altLabel>
        <skos:altLabel>edited</skos:altLabel>
        <skos:altLabel>revised</skos:altLabel>
        <skos:notation>folio:composed</skos:notation>
        <skos:notation>folio:revised</skos:notation>
        <skos:notation>folio:drafted</skos:notation>
        <skos:notation>folio:edited</skos:notation>
        <skos:definition>In the context of legal work, &quot;drafted&quot; refers to the process of composing and preparing legal documents, such as contracts, memos, pleadings, briefs, motions, or judicial opinions. This often involves a preliminary version subject to review, revision, and finalization.</skos:definition>
        <skos:prefLabel>edited</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R72kzuH5FWGcpdiLIHetuNM -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R72kzuH5FWGcpdiLIHetuNM">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Research</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R74zuvPdysbm8JDf0v5JU4n -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R74zuvPdysbm8JDf0v5JU4n">
        <rdfs:label>docketed</rdfs:label>
        <skos:altLabel>docketed</skos:altLabel>
        <skos:altLabel>recorded</skos:altLabel>
        <skos:notation>folio:recorded</skos:notation>
        <skos:notation>folio:docketed</skos:notation>
        <skos:definition>In legal procedures, &quot;docketed&quot; refers to the act of formally recording an document (e.g., application, motion) or proceeding (e.g., case, appeal, license proceeding), or other legal matter in the official registry or list of a government agency or court. This signifies that the matter has been officially entered into the system and is scheduled for consideration. A document may be &quot;filed&quot; but not &quot;docketed,&quot; often because the clerk of court rejected the filing.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R76GQpUlQwvyklNYZI3Yd9S -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R76GQpUlQwvyklNYZI3Yd9S">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Manage data/files</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R78CKihZmI99oRGDBSO0X9Z -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R78CKihZmI99oRGDBSO0X9Z">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/Rx1vavFiVPoynp4F3SB0uD"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/Rjco9ohucVSJ0XxprM5Opb"/>
        <rdfs:label>reversed</rdfs:label>
        <skos:altLabel>reversed</skos:altLabel>
        <skos:notation>folio:reversed</skos:notation>
        <skos:definition>In the legal domain, &quot;reversed&quot; refers to the decision of an appellate court to overturn or change the ruling of a lower court. This action indicates that the appellate court found errors or issues in the lower court&apos;s judgment that significantly affected the outcome, warranting a different legal conclusion.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7AjiNe4tLDt1Z4s1rZep1Y -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7AjiNe4tLDt1Z4s1rZep1Y">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RNICD9MDcFQJJX6nxX11Vt"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RiuB3WjtPaioVphDpqLzVK"/>
        <rdfs:label>accepted</rdfs:label>
        <skos:altLabel>accepted</skos:altLabel>
        <skos:altLabel>approved</skos:altLabel>
        <skos:notation>folio:accepted</skos:notation>
        <skos:notation>folio:approved</skos:notation>
        <skos:definition>In legal terms, &quot;accepted&quot; refers to the formal acknowledgment and approval of legal documents, filings, or propositions by a decisionmaker, court, judge, or other legal authority. This acceptance signifies that the material or argument meets required standards or criteria and is deemed suitable for consideration within the legal process.</skos:definition>
        <skos:prefLabel>approved</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7IaFnjI5OndDVqgzfMPpco -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7IaFnjI5OndDVqgzfMPpco">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>authored</rdfs:label>
        <skos:altLabel>authored</skos:altLabel>
        <skos:notation>folio:authored</skos:notation>
        <skos:definition>In a legal context, &quot;authored&quot; refers to the creation or writing of a legal document, article, opinion, or other written work. In contrast with someone who &quot;drafted&quot; the document (and might be unnamed in the final document), persons who &quot;authored&quot; a document are named authors.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7Icq7RNxBnj6SSAqy0jvVa -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7Icq7RNxBnj6SSAqy0jvVa">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2"/>
        <rdfs:label>equal</rdfs:label>
        <skos:definition>An operator that returns items where the field&apos;s value exactly matches the given value.</skos:definition>
        <skos:notation>folio:equal</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7N2b7y7ob6CHZK4mV5FO8R -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7N2b7y7ob6CHZK4mV5FO8R">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>billedTo</rdfs:label>
        <skos:altLabel>billed to</skos:altLabel>
        <skos:altLabel>invoiced</skos:altLabel>
        <skos:notation>folio:billedTo</skos:notation>
        <skos:notation>folio:invoiced</skos:notation>
        <skos:definition>In the context of law and commerce, &quot;billed to&quot; refers to the process of issuing a bill or invoice by a service provider, seller, or vendor to a client, customer, or purchaser for goods sold or services rendered. This action signifies a request for payment, detailing the cost of services or products provided.</skos:definition>
        <skos:prefLabel>invoiced</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7NbWQfdIKgNd43XLIu6RHe -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7NbWQfdIKgNd43XLIu6RHe">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RB0hju1karAVIAsSqkf1Pza"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>received</rdfs:label>
        <skos:altLabel>is awarded</skos:altLabel>
        <skos:altLabel>is bestowed</skos:altLabel>
        <skos:altLabel>is granted</skos:altLabel>
        <skos:altLabel>received</skos:altLabel>
        <skos:notation>folio:isBestowed</skos:notation>
        <skos:notation>folio:isGranted</skos:notation>
        <skos:altLabel>was awarded</skos:altLabel>
        <skos:altLabel>was bestowed</skos:altLabel>
        <skos:altLabel>was granted</skos:altLabel>
        <skos:notation>folio:received</skos:notation>
        <skos:notation>folio:isAwarded</skos:notation>
        <skos:definition>In various contexts, &quot;received&quot; denotes the act of being given or awarded something, such as a degree, license, or parole. This implies that the recipient has met certain criteria or conditions and has been formally granted a particular item, status, or privilege by an authoritative body or institution.</skos:definition>
        <skos:example>Applicant Received License</skos:example>
        <skos:example>Prisoner Received Parole</skos:example>
        <skos:example>Student Received Degree</skos:example>
        <skos:prefLabel>isAwarded</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7OXOZZNn8AC6Kw7F6t7ZP4 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7OXOZZNn8AC6Kw7F6t7ZP4">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9PfY9lASO3JAZnFZiWzBKN"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R7cLxNTHXARH6xtJZ2kNYQW"/>
        <rdfs:comment>a collection of Roles</rdfs:comment>
        <rdfs:label>has role collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7PEVL4EDe99UD7dVx58cFp -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7PEVL4EDe99UD7dVx58cFp">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7VtpAC807aOYLVtKmPvFRt -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7VtpAC807aOYLVtKmPvFRt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>argued</rdfs:label>
        <skos:altLabel>argued</skos:altLabel>
        <skos:altLabel>contended</skos:altLabel>
        <skos:altLabel>pleaded</skos:altLabel>
        <skos:notation>folio:pleaded</skos:notation>
        <skos:notation>folio:argued</skos:notation>
        <skos:notation>folio:contended</skos:notation>
        <skos:definition>In a legal setting, &quot;argued&quot; refers to the presentation and advocacy of a legal position or interpretation before a court or tribunal. This process involves a structured discourse, utilizing facts, evidence, and legal principles to persuade the judge or jury of the validity of a party&apos;s stance or viewpoint on the matter at hand.</skos:definition>
        <skos:prefLabel>contended</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7ZAbXHy3i3DUFYGKRC9Ti2 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7ZAbXHy3i3DUFYGKRC9Ti2">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RB3D5LuBl4dwJ8i28pdIa3A"/>
        <rdfs:label>utbms:Communicate (other outside counsel)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7a6AnAyIMbylU9ZMRLwNuZ -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7a6AnAyIMbylU9ZMRLwNuZ">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg"/>
        <rdfs:label>oasis:hasActor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7ikWnJN2d8R9S3CpCT30E -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7ikWnJN2d8R9S3CpCT30E">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg"/>
        <rdfs:label>oasis:hasRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7iub53FOISwehZAVPcISSl -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7iub53FOISwehZAVPcISSl">
        <rdfs:label>hasDeadline</rdfs:label>
        <skos:altLabel>has a deadline of</skos:altLabel>
        <skos:altLabel>is due by</skos:altLabel>
        <skos:notation>folio:hasDeadline</skos:notation>
        <skos:notation>folio:dueBy</skos:notation>
        <skos:example>Appeal of licensure denial has deadline of 90 days</skos:example>
        <skos:example>Motion to dismiss has deadline of July 1</skos:example>
        <skos:prefLabel>dueBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7rZ5m2FfgTWxirgewTUJDM -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7rZ5m2FfgTWxirgewTUJDM">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Draft/revise</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7rbNCX8S7kZnvn6AJc71MV -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7rbNCX8S7kZnvn6AJc71MV">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>served</rdfs:label>
        <skos:altLabel>served</skos:altLabel>
        <skos:notation>folio:served</skos:notation>
        <skos:definition>The act of legally serving something (e.g., a document) upon another entity. Example: Serving a Complaint upon a Defendant.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7s5qg2JvWQEFUPaLJSfUsf -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7s5qg2JvWQEFUPaLJSfUsf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>negotiatedWith</rdfs:label>
        <skos:altLabel>bargained with</skos:altLabel>
        <skos:altLabel>negotiated with</skos:altLabel>
        <skos:altLabel>parleyed with</skos:altLabel>
        <skos:notation>folio:parleyedWith</skos:notation>
        <skos:notation>folio:negotiatedWith</skos:notation>
        <skos:notation>folio:bargainedWith</skos:notation>
        <skos:definition>In legal and business interactions, &quot;negotiated with&quot; refers to the act of engaging in discussions and bargaining with a specific party or entity to reach an agreement or resolve a dispute. This term highlights the relational aspect of negotiation, indicating a two-way process involving proposals, counter-proposals, and concessions between distinct parties, such as attorneys, individuals, organizations, or business entities.</skos:definition>
        <skos:example>Criminal Defense Attorney Negotiated With Prosecutor</skos:example>
        <skos:example>Party A negotiated with Party B (e.g., contract)</skos:example>
        <skos:prefLabel>bargainedWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R7xbqZhraT1X45xH64uGCnw -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R7xbqZhraT1X45xH64uGCnw">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>isIssuedTo</rdfs:label>
        <skos:altLabel>is bestowed upon</skos:altLabel>
        <skos:altLabel>is issued to</skos:altLabel>
        <skos:notation>folio:isIssuedTo</skos:notation>
        <skos:notation>folio:isBestowedUpon</skos:notation>
        <skos:definition>In legal and administrative contexts, &quot;issued to&quot; refers to the formal granting or providing of a legal status, document, or financial instrument by an authoritative body or entity to a specific recipient. This term indicates that the recipient is the designated holder or beneficiary of the issued item, such as asylum status, a business license, or stock ownership.</skos:definition>
        <skos:example>Asylum issuedTo Asylee</skos:example>
        <skos:example>License issuedTo Business</skos:example>
        <skos:example>Stock issuedTo Investor</skos:example>
        <skos:prefLabel>isBestowedUpon</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R84mzUh0Z3D44MrLDu0YAMw -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R84mzUh0Z3D44MrLDu0YAMw">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/ROhQrThJyS0l40fB7FDDHU"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R7iUgtA4q4d8RIm0Q8wQcOL"/>
        <rdfs:comment>a LegalRuleML expression for which the Role is responsible (e.g., the expression was created or endorsed by the role).</rdfs:comment>
        <rdfs:label>for expression</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R84xWqLwURw9paxfFdpMlPY -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R84xWqLwURw9paxfFdpMlPY">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt"/>
        <rdfs:label>isMostRecent</rdfs:label>
        <skos:altLabel>is the latest</skos:altLabel>
        <skos:altLabel>is the most recent</skos:altLabel>
        <skos:notation>folio:isMostRecent</skos:notation>
        <skos:notation>folio:isLatest</skos:notation>
        <skos:definition>&quot;Is Most Recent&quot; in legal and administrative contexts refers to the latest version or update of a document, agreement, or legal ruling. This term indicates that the specified item has undergone revisions or updates and that this version supersedes all previous iterations, containing the most current information or terms.</skos:definition>
        <skos:prefLabel>isLatest</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R85ahaTQmVqquzNuoK6Fcr -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R85ahaTQmVqquzNuoK6Fcr">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62"/>
        <rdfs:label>DEPRECATED FAVORING OVERRULED folio:disavowed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R86VduVUHypjaeAGBoLfXFB -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R86VduVUHypjaeAGBoLfXFB">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>renewed</rdfs:label>
        <skos:altLabel>renewed</skos:altLabel>
        <skos:notation>folio:renewed</skos:notation>
        <skos:definition>&quot;Renewed&quot; refers to the act of extending the validity or duration of an existing agreement, license, or document. This process involves meeting the necessary requirements to continue the legal status, privileges, or rights originally granted, such as extending a visa, license, or lease term.</skos:definition>
        <skos:example>Driver Renewed License</skos:example>
        <skos:example>Healthcare Provider Renewed Medical License</skos:example>
        <skos:example>Immigrant Renewed Visa</skos:example>
        <skos:example>Person Renewed Passport</skos:example>
        <skos:example>Tenant Renewed Lease Agreement</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R87URpvCOv2mK8a5Ivhm5qP -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R87URpvCOv2mK8a5Ivhm5qP">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>developStrategy</rdfs:label>
        <skos:altLabel>developed strategy</skos:altLabel>
        <skos:notation>folio:developStrategy</skos:notation>
        <skos:definition>In the legal field, &quot;develop strategy&quot; refers to the process of creating a planned approach or method to achieve specific objectives in various legal contexts, such as contract negotiations or court hearings. This involves analyzing facts, anticipating challenges, and devising tactics to effectively represent a client&apos;s interests or achieve desired outcomes.</skos:definition>
        <skos:example>Lawyer develops strategy for contract negotiation</skos:example>
        <skos:example>Lawyer develops strategy for hearing</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8CE2qvP7a4lK7h1khGxQk3 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8CE2qvP7a4lK7h1khGxQk3">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>waitingFor</rdfs:label>
        <skos:altLabel>is waiting for</skos:altLabel>
        <skos:altLabel>waited for</skos:altLabel>
        <skos:notation>folio:waitingFor</skos:notation>
        <skos:definition>&quot;Waiting for&quot; is the state of anticipating or expecting a subsequent action, response, or document from another party. In legal proceedings and project management, this term often describes a period of inactivity where one party is dependent on the completion of an action or the receipt of information from another party to proceed with their legal tasks or responsibilities.</skos:definition>
        <skos:example>Assistant Waiting for Lawyer&apos;s Draft</skos:example>
        <skos:example>Lawyer Waiting for Response</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8I1TsGJ5eFwM8qAzethrIm -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8I1TsGJ5eFwM8qAzethrIm">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R3zM4v3AKS03zKslpmcdLP"/>
        <rdfs:label>interpreted</rdfs:label>
        <skos:altLabel>construed</skos:altLabel>
        <skos:altLabel>deciphered</skos:altLabel>
        <skos:altLabel>interpreted</skos:altLabel>
        <skos:notation>folio:construed</skos:notation>
        <skos:notation>folio:deciphered</skos:notation>
        <skos:notation>folio:interpreted</skos:notation>
        <skos:definition>In a legal context, &quot;interpreted&quot; refers to the process by which legal professionals, especially judges and lawyers, examine and elucidate the meaning or intention of legal texts, such as statutes, contracts, or judicial decisions. This activity involves applying legal principles and precedents to clarify ambiguities, reconcile conflicts, or discern the underlying purpose of the text.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8LI2NysCz4Juz9QDWeZJoE -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8LI2NysCz4Juz9QDWeZJoE">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt"/>
        <rdfs:label>hasEffectiveDate</rdfs:label>
        <skos:altLabel>has an effective date</skos:altLabel>
        <skos:notation>folio:hasEffectiveDate</skos:notation>
        <skos:definition>&quot;Has Effective Date&quot; refers to a specified date when a legal document, contract, or legislative act becomes operative and enforceable. This date marks the beginning of legal obligations, rights, or effects as stipulated in the document or law.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8N2AJIJYBB3hzZL7OeB0CB -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8N2AJIJYBB3hzZL7OeB0CB">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>oasis:hasCollection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8RerFcbBaYGo4DFhYqoXBC -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8RerFcbBaYGo4DFhYqoXBC">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>superseded</rdfs:label>
        <skos:altLabel>superseded</skos:altLabel>
        <skos:notation>folio:superseded</skos:notation>
        <skos:definition>&quot;Superseded&quot; refers to the act of replacing or nullifying a previous legal rule, decision, or practice with a new one that holds precedence. For example, when a statute supersedes a judicial opinion, it means the new law takes precedence over and effectively replaces the principles or rulings established in that opinion.</skos:definition>
        <skos:example>Statute Superseded Judicial Opinion</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8S1bzMuLtlMmrancwPOUSo -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8S1bzMuLtlMmrancwPOUSo">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R7ZrWzdAOf6mXVtcQ49gWat"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RNVlq2ReYjeb3r8UkUYvso"/>
        <rdfs:label>found</rdfs:label>
        <skos:altLabel>found</skos:altLabel>
        <skos:notation>folio:found</skos:notation>
        <skos:definition>In a legal context, &quot;found&quot; refers to the determination or conclusion reached by a decisionmaker (e.g., judge or jury) regarding the existence of facts, the truth of assertions, the credibility of witnesses, or the guilt of a defendant. This term encapsulates the act of making a judgment or decision based on the evaluation of evidence and testimony.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8ScqoB2b4ln92ntLeQCE3Y -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8ScqoB2b4ln92ntLeQCE3Y">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>hasObligation</rdfs:label>
        <skos:altLabel>has the obligation to</skos:altLabel>
        <skos:altLabel>must</skos:altLabel>
        <skos:notation>folio:hasObligation</skos:notation>
        <skos:notation>folio:must</skos:notation>
        <skos:definition>In legal terms, &quot;has obligation&quot; refers to the duty or responsibility imposed on an individual, entity, or party by law, contract, or agreement. This obligation can be towards another party, as in contractual commitments, or towards the state or society, such as adhering to criminal laws. Fulfillment of these obligations is legally enforceable, and failure to meet them can result in legal consequences. This concept indicates the direction in which the obligation flows.</skos:definition>
        <skos:example>&quot;Party A hasObligation Indemnification of Party B.&quot;</skos:example>
        <skos:prefLabel>must</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8fwHitS5ouUpOrAwTcMmIE -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8fwHitS5ouUpOrAwTcMmIE">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62"/>
        <rdfs:label>DEPRECATED FAVORING DENIED folio:declined</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8oVqWGVPjAgl133D0pNL7g -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8oVqWGVPjAgl133D0pNL7g">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R3zM4v3AKS03zKslpmcdLP"/>
        <rdfs:label>examined</rdfs:label>
        <skos:altLabel>deposed</skos:altLabel>
        <skos:altLabel>examined</skos:altLabel>
        <skos:altLabel>inspected</skos:altLabel>
        <skos:altLabel>interviewed</skos:altLabel>
        <skos:notation>folio:inspected</skos:notation>
        <skos:notation>folio:interviewed</skos:notation>
        <skos:notation>folio:questioned</skos:notation>
        <skos:notation>folio:examined</skos:notation>
        <skos:notation>folio:deposed</skos:notation>
        <skos:definition>In legal terms, &quot;examined&quot; refers to the thorough and systematic investigation or inspection of evidence, documents, or facts relevant to a legal case or issue. This process is crucial for lawyers, judges, and legal staff in assessing the validity, relevance, and implications of the materials at hand, often to establish the foundation for arguments or judgments.</skos:definition>
        <skos:prefLabel>deposed</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8xpRHcxf8y8ru3RmqO4KMx -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8xpRHcxf8y8ru3RmqO4KMx">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCgUkOdOjwvB2yJwL59gBUf"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDCkFrEclhipkoHPgckuFY6"/>
        <rdfs:label>audited</rdfs:label>
        <skos:altLabel>audited</skos:altLabel>
        <skos:notation>folio:audited</skos:notation>
        <skos:definition>In the legal and regulatory context, &quot;audited&quot; refers to the systematic examination and evaluation of financial records, operational processes, or compliance practices by an independent party. This process is designed to verify accuracy, adherence to standards or regulations, and to assess the effectiveness of internal controls or procedures.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R8zGunm4wCZOVAk8uYZIgMJ -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R8zGunm4wCZOVAk8uYZIgMJ">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBoQmbBINbNwazijSzgsexi"/>
        <rdfs:label>oasis:appliesTemporalCharacteristics</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9HWPnaugvaUXld2x3xH2hX -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9HWPnaugvaUXld2x3xH2hX">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2"/>
        <rdfs:label>greaterThanOrEqualTo</rdfs:label>
        <skos:definition>An operator that returns items where the field&apos;s value is greater than or equal to the specified value.</skos:definition>
        <skos:notation>folio:greaterThanOrEqualTo</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9KSG54ZD5NJGhEKjpDjZvO -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9KSG54ZD5NJGhEKjpDjZvO">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RcTA2iQmrtqOnX3WrjJIp8"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCYr9dOm44gvlCAHRrOG0GU"/>
        <rdfs:label>represented</rdfs:label>
        <skos:altLabel>represented</skos:altLabel>
        <skos:notation>folio:represented</skos:notation>
        <skos:definition>&quot;Represented&quot; in a legal context refers to the act of acting on behalf of another person or entity in legal matters. This involves a representative, such as a lawyer, advocating, making decisions, or taking actions under the authority and in the interest of the represented party.</skos:definition>
        <skos:example>Lawyer Represented Client</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9KtZ0zcbQ4oaEL82eUjqtH -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9KtZ0zcbQ4oaEL82eUjqtH">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBoQmbBINbNwazijSzgsexi"/>
        <rdfs:label>oasis:appliesPenalty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9OCJDSLZnUbVwWxu2ddA5J -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9OCJDSLZnUbVwWxu2ddA5J">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>affirmed</rdfs:label>
        <skos:altLabel>affirmed</skos:altLabel>
        <skos:altLabel>upheld</skos:altLabel>
        <skos:notation>folio:affirmed</skos:notation>
        <skos:notation>folio:upheld</skos:notation>
        <skos:definition>In the context of appellate law, &quot;affirmed&quot; refers to the decision of an appellate court to uphold the ruling or decision of a lower court. This signifies that, upon review, the appellate court has found no significant legal error in the lower court&apos;s handling of the case and agrees with the conclusion reached.</skos:definition>
        <skos:prefLabel>upheld</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9OgtSm35ykpUSi7mgiCW -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9OgtSm35ykpUSi7mgiCW">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>authenticated</rdfs:label>
        <skos:altLabel>attested</skos:altLabel>
        <skos:altLabel>authenticated</skos:altLabel>
        <skos:altLabel>ratified</skos:altLabel>
        <skos:notation>folio:ratified</skos:notation>
        <skos:notation>folio:authenticated</skos:notation>
        <skos:notation>folio:attested</skos:notation>
        <skos:definition>&quot;Authenticated&quot; in a legal setting refers to the process of verifying the genuineness and validity of a document or signature, typically by an authorized person or entity. This verification establishes the document&apos;s legitimacy, ensuring it has not been altered and is what it purports to be, often a prerequisite for legal recognition and enforceability.</skos:definition>
        <skos:prefLabel>attested</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9RiRk1LnffWe0xUY0IHsmL -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9RiRk1LnffWe0xUY0IHsmL">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
        <rdfs:label>isGovernedBy</rdfs:label>
        <skos:altLabel>is governed by</skos:altLabel>
        <skos:notation>folio:isGovernedBy</skos:notation>
        <skos:definition>In the legal framework, &quot;governed by&quot; refers to the regulation, control, or direction of legal matters, processes, or entities by specific laws, rules, or principles. This term indicates that a particular area of law or legal procedure is subject to and must comply with established guidelines, standards, or constitutional provisions.</skos:definition>
        <skos:example>Arbitration governed by the rules of arbitration</skos:example>
        <skos:example>Civil claims governed by the rules of civil procedure</skos:example>
        <skos:example>Courts and legislatures are governed by the constitution</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9SvQIEfVhvy8uN5GY3fB2B -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9SvQIEfVhvy8uN5GY3fB2B">
        <rdfs:label>oasis:toPrescriptiveStatement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9Urv8oRJAFxynf241PTpBB -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9Urv8oRJAFxynf241PTpBB">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBoQmbBINbNwazijSzgsexi"/>
        <rdfs:label>oasis:appliesTemporalCharacteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9W9JEOuk0H3iu0X5kmhYoi -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9W9JEOuk0H3iu0X5kmhYoi">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>overruled</rdfs:label>
        <skos:altLabel>disavowed</skos:altLabel>
        <skos:altLabel>overruled</skos:altLabel>
        <skos:notation>folio:overruled</skos:notation>
        <skos:notation>folio:disavowed</skos:notation>
        <skos:definition>In legal practice, &quot;overruled&quot; refers to the action of a higher court setting aside or nullifying the decision of a lower court or an earlier court. Or it could apply to a judge overruling an evidentiary objection. This denotes a rejection of the previous decision or objection based on legal grounds, signaling a different interpretation or application of the law.</skos:definition>
        <skos:example>Appellate Court overruled Trial Court</skos:example>
        <skos:example>Trial Court overruled Plaintiff&apos;s evidentiary objection</skos:example>
        <skos:prefLabel>disavowed</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9Y6ik9lMExYK3Xj2pJuD4V -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9Y6ik9lMExYK3Xj2pJuD4V">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R8N2AJIJYBB3hzZL7OeB0CB"/>
        <rdfs:label>hasTemporalCharacteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9ZUmvtgrZzXkfqfKcFobwZ -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9ZUmvtgrZzXkfqfKcFobwZ">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>isSecuredBy</rdfs:label>
        <skos:altLabel>is secured by</skos:altLabel>
        <skos:notation>folio:isSecuredBy</skos:notation>
        <skos:notation>folio:isCollateralizedBy</skos:notation>
        <skos:definition>In financial and legal contexts, &quot;is secured by&quot; refers to a debt or obligation that is backed by collateral or a specific asset. This means that if the debtor fails to meet their obligations, the creditor has the right to seize the collateral to recover the owed amount. The presence of collateral provides security for the lender and can affect the terms and conditions of the debt.</skos:definition>
        <skos:example>Debt is secured by Asset</skos:example>
        <skos:prefLabel>isCollateralizedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9aTcuLVmH38aqd3WcPuzCT -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9aTcuLVmH38aqd3WcPuzCT">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R7VtpAC807aOYLVtKmPvFRt"/>
        <rdfs:label>supported</rdfs:label>
        <skos:altLabel>supported</skos:altLabel>
        <skos:notation>folio:supported</skos:notation>
        <skos:definition>In the context of an argument, &quot;supported&quot; refers to the backing or justification provided for a particular claim or assertion using evidence, logical reasoning, or relevant facts. A well-supported argument is strengthened by its corroborating information, making it more persuasive and credible to its audience.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9dR7mByjtP9Tx4NUZI84iO -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9dR7mByjtP9Tx4NUZI84iO">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>disapproved</rdfs:label>
        <skos:altLabel>criticized</skos:altLabel>
        <skos:altLabel>disapproved</skos:altLabel>
        <skos:notation>folio:disapproved</skos:notation>
        <skos:notation>folio:criticized</skos:notation>
        <skos:definition>In legal contexts, &quot;disapproved&quot; refers to the expression of judicial disagreement or disfavor towards a decision or reasoning of another court, without necessarily overturning or reversing it. This indicates a divergence in legal opinion or interpretation, often noted by higher courts in their rulings or dicta, which can influence future case law without directly changing the immediate case outcome.</skos:definition>
        <skos:example>Court disapproved of its sibling court&apos;s decision, but did not overrule it</skos:example>
        <skos:prefLabel>criticized</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9e8PXI2IEusTTC9xKXN7hA -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9e8PXI2IEusTTC9xKXN7hA"/>
    


    <!-- https://folio.openlegalstandard.org/R9f0gJuj3yGziHe5HBA6CQY -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9f0gJuj3yGziHe5HBA6CQY">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBgYGQPsuNuXWjQrcusV25t"/>
        <rdfs:label>oasis:bearer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9g1ytIVLnV6isR8zHgHrdH -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9g1ytIVLnV6isR8zHgHrdH">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk"/>
        <rdfs:label>wasFiledIn</rdfs:label>
        <skos:altLabel>was filed in</skos:altLabel>
        <skos:notation>folio:wasFiledIn</skos:notation>
        <skos:definition>&quot;Was Filed In&quot; in legal terms refers to the act of submitting a legal document, application, or motion to a specific court, tribunal, or administrative body. This term denotes the location or entity where the document was officially lodged and is used to specify the jurisdiction or authority handling the matter.</skos:definition>
        <skos:example>Motion Was Filed In SDNY</skos:example>
        <skos:example>Patent Application Was Filed In U.S. Patent Office</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9iq8MqpS503pOZr7pZiOUb -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9iq8MqpS503pOZr7pZiOUb">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>appendedTo</rdfs:label>
        <skos:altLabel>appended to</skos:altLabel>
        <skos:altLabel>attached</skos:altLabel>
        <skos:notation>folio:appendedTo</skos:notation>
        <skos:notation>folio:attached</skos:notation>
        <skos:definition>&quot;Appended to&quot; in legal documentation refers to the act of adding supplementary material, such as exhibits, amendments, or additional documents, to an existing legal document or record. This process is crucial for incorporating new or relevant information that supports, clarifies, or modifies the original content, ensuring the document&apos;s completeness and accuracy.</skos:definition>
        <skos:prefLabel>attached</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9lFQGc7YqHeXhBi38Rnwj4 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9lFQGc7YqHeXhBi38Rnwj4">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R8N2AJIJYBB3hzZL7OeB0CB"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RrPgamntGVCkirompZuSgE"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RBDCMbVjuJ10m588Ou29eSf"/>
        <rdfs:label>hasTemporalCharacteristics</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9u6A5ODwWnB3Ll5fenny6E -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9u6A5ODwWnB3Ll5fenny6E">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>isUsedFor</rdfs:label>
        <skos:altLabel>is used for</skos:altLabel>
        <skos:notation>folio:isUsedFor</skos:notation>
        <skos:definition>Relationship declaring how one item (e.g., `Tool` like `Westlaw` or `vLex`) might be used for another item (e.g., `Legal Research`).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/R9yYkx0gjxfCeiErY01Coeq -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/R9yYkx0gjxfCeiErY01Coeq">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2"/>
        <rdfs:label>lessThanOrEqualTo</rdfs:label>
        <skos:definition>An operator that returns items where the field&apos;s value is less than or equal to the specified value.</skos:definition>
        <skos:notation>folio:lessThanOrEqualTo</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB0hju1karAVIAsSqkf1Pza -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB0hju1karAVIAsSqkf1Pza">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>obtained</rdfs:label>
        <skos:altLabel>acquired</skos:altLabel>
        <skos:altLabel>obtained</skos:altLabel>
        <skos:notation>folio:obtained</skos:notation>
        <skos:notation>folio:acquired</skos:notation>
        <skos:definition>To obtain an artifact (e.g., document, evidence) or a legal result (e.g., judgment, sanctions). In legal and administrative contexts, &quot;obtained&quot; refers to the successful acquisition or securing of a legal status, permission, or qualification by an individual or entity. This term indicates that the individual or entity has met the necessary criteria or completed the required procedures to gain a particular right, privilege, or certification, such as asylum, a professional license, or licensure to practice law.</skos:definition>
        <skos:example>Applicant Obtained License</skos:example>
        <skos:example>Asylee Obtained Asylum</skos:example>
        <skos:example>Investigator Obtained Evidence</skos:example>
        <skos:example>Lawyer Obtained Licensure</skos:example>
        <skos:prefLabel>acquired</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB3D5LuBl4dwJ8i28pdIa3A -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB3D5LuBl4dwJ8i28pdIa3A">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Communicate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB3G15ZJPz6X2117zd9FBzc -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB3G15ZJPz6X2117zd9FBzc">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>canceled</rdfs:label>
        <skos:altLabel>canceled</skos:altLabel>
        <skos:notation>folio:canceled</skos:notation>
        <skos:definition>Canceled refers to the termination or annulment of a legal or administrative action, such as a registration or a hearing. This can occur due to various reasons, including withdrawal by the applicant, failure to meet legal requirements, or administrative decisions.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB7sOdTG7h6T898uKuEAXpP -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB7sOdTG7h6T898uKuEAXpP">
        <rdfs:label>canAccept</rdfs:label>
        <skos:altLabel>can accept</skos:altLabel>
        <skos:altLabel>is authorized to accept</skos:altLabel>
        <skos:altLabel>is capable of accepting</skos:altLabel>
        <skos:notation>folio:isAuthorizedToConsent</skos:notation>
        <skos:notation>folio:canAccept</skos:notation>
        <skos:notation>folio:isCapableOfAccepting</skos:notation>
        <skos:definition>In legal and business terms, &quot;can accept&quot; refers to the capacity or legal authority of a party to agree to a proposal, offer, or contract. This involves having the requisite legal competence, authority, and in some cases, the necessary legal capacity, to enter into a binding agreement or to consent to certain terms.</skos:definition>
        <skos:prefLabel>isCapableOfAccepting</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB8dNjfQNfdFxTUkao2ImJ5 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB8dNjfQNfdFxTUkao2ImJ5">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF"/>
        <rdfs:label>preparedFor</rdfs:label>
        <skos:altLabel>prepared for</skos:altLabel>
        <skos:notation>folio:preparedFor</skos:notation>
        <skos:definition>In legal and business contexts, &quot;prepared for&quot; refers to the act of making ready or getting equipped for a specific event, process, or encounter. This includes activities like researching, strategizing, organizing resources, and planning.</skos:definition>
        <skos:example>Lawyer Prepared for Trial</skos:example>
        <skos:example>Party Prepared for Contract Negotiation</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB96nfBIyMVmeVgxZ79G9X7 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB96nfBIyMVmeVgxZ79G9X7">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:label>hasRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB9FzQWoT4a1hxOZ5QMiwM2 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB9FzQWoT4a1hxOZ5QMiwM2">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RB3D5LuBl4dwJ8i28pdIa3A"/>
        <rdfs:label>utbms:Communicate (with client)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB9WPZAmqztZGzX1qXk6gXv -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB9WPZAmqztZGzX1qXk6gXv">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>respondedTo</rdfs:label>
        <skos:altLabel>replied to</skos:altLabel>
        <skos:altLabel>responded to</skos:altLabel>
        <skos:notation>folio:respondedTo</skos:notation>
        <skos:notation>folio:repliedTo</skos:notation>
        <skos:definition>&quot;Responded To&quot; in legal contexts refers to the action of replying or reacting to a legal action, request, or communication. This includes formal legal responses such as answering a lawsuit, replying to a legal notice, or reacting to a court&apos;s order, and is crucial for the continuation and progression of legal processes.</skos:definition>
        <skos:prefLabel>repliedTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RB9zpRJFhAzcELy6OTNxqNT -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RB9zpRJFhAzcELy6OTNxqNT">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/Rjco9ohucVSJ0XxprM5Opb"/>
        <rdfs:label>ruledUpon</rdfs:label>
        <skos:altLabel>ruled upon</skos:altLabel>
        <skos:notation>folio:ruledUpon</skos:notation>
        <skos:definition>&quot;Ruled Upon&quot; in legal contexts refers to the act of making a formal decision or judgment by a judicial authority, such as a judge, on a particular matter or motion presented in court. This involves the application of legal principles and reasoning to reach a conclusion that resolves a legal question or directs the course of legal proceedings.</skos:definition>
        <skos:example>Judge Ruled Upon Motion</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBA9fhC1klxcqUb2bMFIIre -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBA9fhC1klxcqUb2bMFIIre">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2"/>
        <rdfs:label>lessThan</rdfs:label>
        <skos:definition>An operator that returns items where the field&apos;s value is less than the given value.</skos:definition>
        <skos:notation>folio:lessThan</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBBJ16zFnIqfmkVet3IuV6Z -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBBJ16zFnIqfmkVet3IuV6Z">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt"/>
        <rdfs:label>hasEndedDate</rdfs:label>
        <skos:altLabel>has a termination date</skos:altLabel>
        <skos:altLabel>has an end date</skos:altLabel>
        <skos:altLabel>has an expiration date</skos:altLabel>
        <skos:notation>folio:hasTerminationDate</skos:notation>
        <skos:notation>folio:hasEndedDate</skos:notation>
        <skos:notation>folio:hasExpirationDate</skos:notation>
        <skos:definition>&quot;Has Ended Date&quot; refers to the specific date on which a legal document, contract, or obligation ceases to be in effect. This marks the conclusion of the legal validity or enforceability of the document or agreement, signifying the end of rights and responsibilities under its terms.</skos:definition>
        <skos:prefLabel>hasExpirationDate</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>utbms:activities</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBDO4YSpOqTwGQp3QqhtPmq -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBDO4YSpOqTwGQp3QqhtPmq">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>abrogated</rdfs:label>
        <skos:altLabel>abrogated</skos:altLabel>
        <skos:notation>folio:abrogated</skos:notation>
        <skos:definition>In legal terms, &quot;abrogated&quot; refers to the formal repeal, nullification, or abolition of a law, regulation, legal decision, or agreement. This action signifies the complete removal or invalidation of the legal force of the abrogated item, often due to changes in circumstances, new legislation, or shifts in legal interpretation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBHS8Lk6WR8ctm4HdZNPGd9 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBHS8Lk6WR8ctm4HdZNPGd9">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>completed</rdfs:label>
        <skos:altLabel>completed</skos:altLabel>
        <skos:altLabel>concluded</skos:altLabel>
        <skos:altLabel>finalized</skos:altLabel>
        <skos:notation>folio:concluded</skos:notation>
        <skos:notation>folio:completed</skos:notation>
        <skos:notation>folio:finalized</skos:notation>
        <skos:definition>In a legal framework, &quot;completed&quot; refers to the finalization or conclusion of a legal task, process, or document. This term indicates that all necessary actions, procedures, or requirements have been fulfilled, bringing an aspect of the work to a close and often rendering it effective or enforceable.</skos:definition>
        <skos:prefLabel>finalized</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBIVZ1dC4MJaMe4K0bHVVXp -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBIVZ1dC4MJaMe4K0bHVVXp">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:label>hasActor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBMCuIWgiYrteeawprjAlsX -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBMCuIWgiYrteeawprjAlsX">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>replaced</rdfs:label>
        <skos:altLabel>replaced</skos:altLabel>
        <skos:notation>folio:replaced</skos:notation>
        <skos:definition>&quot;Replaced&quot; in a legal or administrative context refers to the act of substituting one item, individual, agreement, or legal document with another. This process involves the removal or cessation of the original entity or item&apos;s role or function, and its subsequent substitution with a new or updated equivalent.</skos:definition>
        <skos:example>Judge Replaced Order</skos:example>
        <skos:example>Registrar Replaced License</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBNqARoAvfKJ3sr0sPHzvZI -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBNqARoAvfKJ3sr0sPHzvZI">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9PfY9lASO3JAZnFZiWzBKN"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/Rwb69BL1DbTISxyVYJJApb"/>
        <rdfs:comment>a collection of figures</rdfs:comment>
        <rdfs:label>has figure collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBPsxBT931DDyTjxIBVJgE0 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBPsxBT931DDyTjxIBVJgE0">
        <rdfs:label>isMemberOf</rdfs:label>
        <skos:altLabel>is a member of</skos:altLabel>
        <skos:altLabel>is a part of</skos:altLabel>
        <skos:notation>folio:isMemberOf</skos:notation>
        <skos:notation>folio:isPartOf</skos:notation>
        <skos:definition>In legal and organizational contexts, &quot;is member of&quot; signifies the belonging or inclusion of an individual or entity in a specific group, committee, board, or organization. This denotes that the individual or entity has a role, responsibilities, rights, or a position within the collective body, subject to its rules, objectives, and governance structure.</skos:definition>
        <skos:example>Creditor is Member of Creditor&apos;s Committee</skos:example>
        <skos:example>Director is Member of Board of Directors</skos:example>
        <skos:example>Juror is Member of Jury</skos:example>
        <skos:example>Partner is Member of Partnership</skos:example>
        <skos:prefLabel>isPartOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBW19bsnBOwINS8K601XYsz -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBW19bsnBOwINS8K601XYsz">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>attended</rdfs:label>
        <skos:altLabel>attended</skos:altLabel>
        <skos:notation>folio:attended</skos:notation>
        <skos:definition>In a legal context, &quot;attended&quot; refers to the act of being present at a legal event, such as a court hearing, meeting, or negotiation. This presence, whether physical or virtual, signifies participation or observation in legal proceedings or discussions, which is often crucial for understanding, contributing to, or complying with legal processes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>operators</rdfs:label>
        <skos:definition>Operators are search-related logical tools used in databases to refine and direct search queries. They control the relationship between search terms.</skos:definition>
        <skos:notation>folio:operators</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBgYGQPsuNuXWjQrcusV25t -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBgYGQPsuNuXWjQrcusV25t">
        <rdfs:label>oasis:deonticRule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBhFi0XLvhq8d4QdZMZ42x9 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBhFi0XLvhq8d4QdZMZ42x9">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>registered</rdfs:label>
        <skos:altLabel>enrolled</skos:altLabel>
        <skos:altLabel>registered</skos:altLabel>
        <skos:notation>folio:enrolled</skos:notation>
        <skos:notation>folio:registered</skos:notation>
        <skos:definition>&quot;Registered&quot; refers to the official recording or enrollment of an item, entity, or individual in a formal registry by an authoritative body. This process provides legal recognition and may confer certain rights, responsibilities, or status, such as intellectual property protection for patents or legal authority to practice for attorneys</skos:definition>
        <skos:example>Bar Association Registered Attorney</skos:example>
        <skos:example>Copyright Office Registered Copyright Registration</skos:example>
        <skos:example>DMV Registered Vehicle</skos:example>
        <skos:example>Patent Office Registered Patent</skos:example>
        <skos:example>Secretary of State Registered Business</skos:example>
        <skos:example>Stock Exchange Registered Company</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBiubEhHTU4zds4FIm3uE3W -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBiubEhHTU4zds4FIm3uE3W">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>RIEHL NOTE: This may be deprecated. It&apos;s not used, and its purpose is unclear.</rdfs:comment>
        <rdfs:label>includes</rdfs:label>
        <skos:notation>folio:includes</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBlvKceLVwnUflJvHuHBpSO -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBlvKceLVwnUflJvHuHBpSO">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:label>denied</rdfs:label>
        <skos:altLabel>denied</skos:altLabel>
        <skos:notation>folio:denied</skos:notation>
        <skos:definition>In legal contexts, &quot;denied&quot; refers to the rejection or refusal of a request, motion, application, or claim by a judicial or administrative authority. This decision indicates that the request does not meet the necessary legal criteria, is unfounded, or is otherwise not suitable for approval or granting under the prevailing legal framework.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBnpEtVTcX8UHPGSPPAzf1w -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBnpEtVTcX8UHPGSPPAzf1w">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2"/>
        <rdfs:label>greaterThan</rdfs:label>
        <skos:definition>An operator that returns items where the specified field&apos;s value is greater than the given value.</skos:definition>
        <skos:notation>folio:greaterThan</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBoQmbBINbNwazijSzgsexi -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBoQmbBINbNwazijSzgsexi">
        <rdfs:label>oasis:applies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBu87FXpegbtFY5SjoXRe29 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBu87FXpegbtFY5SjoXRe29">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt"/>
        <rdfs:label>isInitial</rdfs:label>
        <skos:notation>folio:isFirstDraft</skos:notation>
        <skos:altLabel>is a first draft</skos:altLabel>
        <skos:altLabel>is an initial</skos:altLabel>
        <skos:notation>folio:isInitial</skos:notation>
        <skos:definition>&quot;Is Initial&quot; in a legal or administrative context refers to the first or original version of a document or agreement before any amendments, revisions, or updates. This term denotes the baseline from which any changes are measured, often serving as a reference point in legal analysis or when modifications are made.</skos:definition>
        <skos:example>Document Is Initial Version</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBvy26hKlSPzCVJMlWTlBQb -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBvy26hKlSPzCVJMlWTlBQb">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R9OgtSm35ykpUSi7mgiCW"/>
        <rdfs:label>verified</rdfs:label>
        <skos:altLabel>confirmed</skos:altLabel>
        <skos:notation>folio:validated</skos:notation>
        <skos:altLabel>validated</skos:altLabel>
        <skos:altLabel>verified</skos:altLabel>
        <skos:notation>folio:verified</skos:notation>
        <skos:notation>folio:confirmed</skos:notation>
        <skos:definition>&quot;Verified&quot; in a legal context refers to the process of confirming the accuracy, authenticity, or truthfulness of information, statements, or documents. This involves examining and validating the content to ensure it aligns with factual data, legal standards, or specified criteria, often essential in legal proceedings and documentation.</skos:definition>
        <skos:prefLabel>confirmed</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBwcSq7zBAAVljlAwwbMjoq -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBwcSq7zBAAVljlAwwbMjoq">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9x6yqzHQfo3MF4rxIcPupm"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:label>appearedBefore</rdfs:label>
        <skos:altLabel>appeared before</skos:altLabel>
        <skos:altLabel>convened</skos:altLabel>
        <skos:notation>folio:appearedBefore</skos:notation>
        <skos:notation>folio:convened</skos:notation>
        <skos:definition>&quot;Appeared before&quot; in legal parlance refers to the formal presentation or representation of a party or their legal counsel in front of a judicial body, such as a court or a judge. This term signifies the physical or legal presence required for proceedings, ranging from hearings to trials, where legal matters are argued, evidence is presented, and rulings are made.</skos:definition>
        <skos:prefLabel>convened</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBzcoqc9gDSOGkNUDhDfDV -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBzcoqc9gDSOGkNUDhDfDV">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/ROhQrThJyS0l40fB7FDDHU"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RysulJVLLFPkPX8Y2gHIAp"/>
        <rdfs:comment>an Actor that fills the Role.</rdfs:comment>
        <rdfs:label>filled by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBzfLJrwPMpX5k3ZuyirpzI -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBzfLJrwPMpX5k3ZuyirpzI">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9q7GJc1zsYT0P4Xdp6l9Oz"/>
        <rdfs:label>hasElement</rdfs:label>
        <skos:altLabel>has the element of</skos:altLabel>
        <skos:notation>folio:hasElement</skos:notation>
        <skos:definition>In legal terminology, &quot;has element&quot; refers to the essential components or criteria that must be established to prove a legal claim or defense. Each element is a necessary part of the legal theory that must be demonstrated for the claim to be legally valid. For instance, a breach of contract claim requires proving elements like the existence of a contract, breach of its terms, and resulting damages.</skos:definition>
        <skos:example>Breach of Contract Claim has Element of Damages</skos:example>
        <skos:example>Fraud claim Has Element of False Representation</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RBznsAiDL0L6nFkBBcyUPpT -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RBznsAiDL0L6nFkBBcyUPpT">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:label>hasFunction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RC3qfiYtXVNQmnmcuYjcVIj -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RC3qfiYtXVNQmnmcuYjcVIj">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>and</rdfs:label>
        <skos:definition>Default for multiple FOLIO tags. For example, if a query filters for `A B C`, then implied is the query `A folio:and B folio:and C`.  A logical conjunction operator that combines search terms, returning items that match all of the terms.</skos:definition>
        <skos:notation>folio:and</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RC4evTXFRfsDXZu7RYlCcC8 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RC4evTXFRfsDXZu7RYlCcC8">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBgYGQPsuNuXWjQrcusV25t"/>
        <rdfs:label>oasis:auxilaryParty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>oasis:metadata-actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCDOABUr8ZTMQ7N7Rydeius -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCDOABUr8ZTMQ7N7Rydeius">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>signed</rdfs:label>
        <skos:altLabel>signed</skos:altLabel>
        <skos:notation>folio:signed</skos:notation>
        <skos:definition>&quot;Signed&quot; in a legal context refers to the act of putting one&apos;s signature on a legal document, such as a pleading, contract, or order. This signature signifies the individual&apos;s approval, authorization, or acknowledgement of the content of the document, and is often a requisite for the document&apos;s legal validity and enforceability.</skos:definition>
        <skos:example>Judge Signed Order</skos:example>
        <skos:example>Lawyer Signed Pleading</skos:example>
        <skos:example>Party Signed Contract</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>temporalChanges</rdfs:label>
        <skos:definition>&quot;Temporal Changes&quot; in legal contexts refer to the various time-related aspects and milestones that affect the status, applicability, or relevance of legal documents, agreements, or decisions.</skos:definition>
        <skos:notation>folio:temporalChanges</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCFpktWEZOtDt2qAABUgJ8H -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCFpktWEZOtDt2qAABUgJ8H">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R7VtpAC807aOYLVtKmPvFRt"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RNICD9MDcFQJJX6nxX11Vt"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RnKWv1E6U2Ssc5SRsG14NO"/>
        <rdfs:label>asserted</rdfs:label>
        <skos:altLabel>asserted</skos:altLabel>
        <skos:altLabel>claimed</skos:altLabel>
        <skos:altLabel>declared</skos:altLabel>
        <skos:altLabel>proclaimed</skos:altLabel>
        <skos:notation>folio:declared</skos:notation>
        <skos:notation>folio:proclaimed</skos:notation>
        <skos:notation>folio:stated</skos:notation>
        <skos:altLabel>stated</skos:altLabel>
        <skos:notation>folio:asserted</skos:notation>
        <skos:notation>folio:claimed</skos:notation>
        <skos:definition>&quot;Asserted&quot; in a legal context refers to the act of confidently stating or declaring a fact, right, or legal position, typically as part of a legal claim or defense. This assertion forms the basis of a party&apos;s argument or claim in legal proceedings, setting the stage for the legal debate and burden of proof. Compared with the more-argumentative terms &quot;opposed&quot; or &quot;supported,&quot; the term &quot;asserted&quot; is more neutral.</skos:definition>
        <skos:prefLabel>claimed</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCFxbmwYw4z5dXO2SvKw1nI -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCFxbmwYw4z5dXO2SvKw1nI">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>dismissed</rdfs:label>
        <skos:altLabel>dismissed</skos:altLabel>
        <skos:notation>folio:terminated</skos:notation>
        <skos:altLabel>terminated</skos:altLabel>
        <skos:notation>folio:dismissed</skos:notation>
        <skos:definition>In legal practice, &quot;dismissed&quot; refers to the action taken by a court or judicial panel to terminate a case, claim, or appeal. This decision can be based on procedural grounds, lack of jurisdiction, non-compliance with legal requirements, or other reasons that render the case unsuitable for continuation.</skos:definition>
        <skos:example>Appellate panel dismissed the appeal</skos:example>
        <skos:example>Judge dismissed claim</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCJqHaoTwWRH377I9gMIP7z -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCJqHaoTwWRH377I9gMIP7z">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg"/>
        <rdfs:label>oasis:hasFigure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCP3eyKInCMJp5Fv01RmL3u -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCP3eyKInCMJp5Fv01RmL3u">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCnTNVCQ1VndGxskbMoaLr8"/>
        <rdfs:label>isDefending</rdfs:label>
        <skos:altLabel>is defending</skos:altLabel>
        <skos:notation>folio:isDefending</skos:notation>
        <skos:definition>Defense of Deposition refers to the strategic and legal actions taken by a party&apos;s attorney to protect their client during a deposition. The attorney seeks to guide the deponent in providing accurate but limited information, objecting to inappropriate questions, and ensuring that the deposition serves the best interests of the client.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCR0ohH8RV8nUH2c7aS9ERM -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCR0ohH8RV8nUH2c7aS9ERM">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>similar</rdfs:label>
        <skos:definition>Operator that returns items that are similar to the search term, potentially including synonyms, fuzzy matches, and semantically related terms.</skos:definition>
        <skos:notation>folio:similar</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCRhWf5uwQ9R136KcsD0Sdd -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCRhWf5uwQ9R136KcsD0Sdd">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Review/analyze</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2">
        <rdfs:label>decided</rdfs:label>
        <skos:altLabel>adjudicated</skos:altLabel>
        <skos:altLabel>decided</skos:altLabel>
        <skos:altLabel>determined</skos:altLabel>
        <skos:notation>folio:adjudicated</skos:notation>
        <skos:notation>folio:decided</skos:notation>
        <skos:notation>folio:determined</skos:notation>
        <skos:definition>In the legal arena, &quot;decided&quot; refers to the process of reaching a conclusion or verdict in a legal matter or legal document. This term encompasses various outcomes such as acceptance, affirmation, denial, or dismissal, representing the authoritative resolution or determination made by a court or tribunal.</skos:definition>
        <skos:prefLabel>determined</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCadgGcfBZxaL64cSvVk2dq -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCadgGcfBZxaL64cSvVk2dq">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>vacated</rdfs:label>
        <skos:altLabel>nullified</skos:altLabel>
        <skos:altLabel>vacated</skos:altLabel>
        <skos:notation>folio:vacated</skos:notation>
        <skos:notation>folio:nullified</skos:notation>
        <skos:definition>In legal practice, &quot;vacated&quot; refers to the annulment or setting aside of a court decision, order, or judgment by a judicial authority. This term implies that the previous decision is rendered null and void, often due to procedural errors, legal inconsistencies, or new evidence that fundamentally alters the case&apos;s dynamics.</skos:definition>
        <skos:prefLabel>nullified</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCagJhRyGTd2hJN5QTrg7Ru -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCagJhRyGTd2hJN5QTrg7Ru">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDCkFrEclhipkoHPgckuFY6"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:label>approved</rdfs:label>
        <skos:altLabel>approved</skos:altLabel>
        <skos:altLabel>authorized</skos:altLabel>
        <skos:notation>folio:approved</skos:notation>
        <skos:notation>folio:authorized</skos:notation>
        <skos:definition>&quot;Approved&quot; in a legal context signifies the formal acceptance or endorsement of a document, action, or decision by an authorized individual or body. This approval usually indicates compliance with legal standards or requirements and often signifies the finalization of a legal process, agreement, or decision.</skos:definition>
        <skos:prefLabel>authorized</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCcfFsMP7IYtjlfdSBJmKNF -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCcfFsMP7IYtjlfdSBJmKNF">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>stemming</rdfs:label>
        <skos:definition>Operator that returns variations of a word based on its stem (e.g., query for the stem &quot;run&quot; would result in &quot;runs&quot;, &quot;running&quot;, &quot;runner&quot;).</skos:definition>
        <skos:notation>folio:stemming</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCdPQDV9TEe33ydDVVkGQyf -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCdPQDV9TEe33ydDVVkGQyf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9tZFXPrXQJWHbqSgtCQxJF"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDCkFrEclhipkoHPgckuFY6"/>
        <rdfs:label>testified</rdfs:label>
        <skos:altLabel>Affirmed</skos:altLabel>
        <skos:altLabel>testified</skos:altLabel>
        <skos:notation>folio:testified</skos:notation>
        <skos:definition>&quot;Testified&quot; in a legal context refers to the act of giving evidence or a statement under oath in a court of law or a legal proceeding. This process is vital for presenting factual information and personal accounts to the court, helping in the establishment or disputation of facts critical to the resolution of legal disputes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCeIFhdEEtecwLgAYEoAxPX -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCeIFhdEEtecwLgAYEoAxPX">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9x6yqzHQfo3MF4rxIcPupm"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCYr9dOm44gvlCAHRrOG0GU"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDCkFrEclhipkoHPgckuFY6"/>
        <rdfs:label>advised</rdfs:label>
        <skos:definition>In legal contexts, &quot;advised&quot; refers to the provision of professional legal counsel or recommendations to clients, based on the interpretation of the law and its application to specific circumstances. This process is critical in guiding clients through legal complexities, ensuring informed decision-making and compliance with legal norms and obligations.</skos:definition>
        <skos:prefLabel>counseled</skos:prefLabel>
        <skos:notation>folio:advised</skos:notation>
        <skos:notation>folio:counseled</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCfGltyATZDch3La86F79hq -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCfGltyATZDch3La86F79hq">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:label>granted</rdfs:label>
        <skos:altLabel>granted</skos:altLabel>
        <skos:notation>folio:granted</skos:notation>
        <skos:definition>In the legal sphere, &quot;granted&quot; refers to the approval or acceptance of a request, motion, or appeal by a judicial authority. This term indicates that the court has agreed to the request, whether it&apos;s for procedural actions like a motion in a trial, or substantive issues like granting a writ of certiorari in appellate courts.</skos:definition>
        <skos:example>Supreme Court granted Certiorari</skos:example>
        <skos:example>Trial judge granted plaintiff&apos;s motion</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RChkN47HjKv8H0ovpaNILyM -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RChkN47HjKv8H0ovpaNILyM">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg"/>
        <rdfs:label>oasis:hasAgent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCmX2a3aVJOIgpjsiRggnxX -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCmX2a3aVJOIgpjsiRggnxX">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBW19bsnBOwINS8K601XYsz"/>
        <rdfs:label>presented</rdfs:label>
        <skos:altLabel>presented</skos:altLabel>
        <skos:altLabel>submitted</skos:altLabel>
        <skos:notation>folio:presented</skos:notation>
        <skos:notation>folio:submitted</skos:notation>
        <skos:definition>In legal contexts, &quot;presented&quot; refers to the act of formally introducing or submitting evidence, arguments, or information in a judicial or legal setting. This encompasses the delivery of material in a structured and often persuasive manner, essential for informing the decision-making process or supporting a legal claim or defense.</skos:definition>
        <skos:prefLabel>submitted</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCrkDVNXup86PCJ1li7GrFx -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCrkDVNXup86PCJ1li7GrFx">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>departed</rdfs:label>
        <skos:altLabel>departed</skos:altLabel>
        <skos:altLabel>left</skos:altLabel>
        <skos:notation>folio:departed</skos:notation>
        <skos:notation>folio:left</skos:notation>
        <skos:definition>Departure from a location, by a person or object, which can have litigation, immigration, tax, and other regulatory effects.</skos:definition>
        <skos:prefLabel>left</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>oasis:hasMember</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCuyvwwZzhCRHWEZZVIlpHF -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCuyvwwZzhCRHWEZZVIlpHF">
        <rdfs:label>isCurrencyFor</rdfs:label>
        <skos:altLabel>circulates in</skos:altLabel>
        <skos:altLabel>is a monetary unit of</skos:altLabel>
        <skos:altLabel>is currency for</skos:altLabel>
        <skos:notation>folio:isMonetaryUnitOf</skos:notation>
        <skos:notation>folio:isCurrencyFor</skos:notation>
        <skos:notation>folio:circulatesIn</skos:notation>
        <skos:definition>In economic and legal contexts, &quot;is currency for&quot; denotes that a specific form of money is officially recognized and used as the medium of exchange within a particular country or region. For example, the U.S. Dollar is the standard unit for pricing and transactions in the United States, and that currency holds legal backing from its government.</skos:definition>
        <skos:example>Great Britain Pound is Currency for the United Kingdom</skos:example>
        <skos:example>U.S. Dollar is Currency for United States of America</skos:example>
        <skos:prefLabel>circulatesIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCx3rNyJdykIdu45Cr4ajaK -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCx3rNyJdykIdu45Cr4ajaK">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
        <rdfs:label>appealsTo</rdfs:label>
        <skos:definition>&quot;Appeals to&quot; in a legal setting refers to the process of challenging and seeking review of a lower court&apos;s decision by a higher court. This action is initiated by the party dissatisfied with the trial court&apos;s judgment, aiming for a reassessment of the legal and factual determinations made, based on the assertion of errors in the application of law or procedural missteps. It also relates to where a case heard by a trial court &quot;appeals to&quot; the appellate court (e.g., SDNY appeals to Second Circuit).</skos:definition>
        <skos:notation>folio:appealsTo</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RCxZMkiQ7r63J4irBj8tKJv -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RCxZMkiQ7r63J4irBj8tKJv">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Plan and prepare for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RD0XCn6jU6kWpRwSH8lzFGA -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RD0XCn6jU6kWpRwSH8lzFGA">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RB3D5LuBl4dwJ8i28pdIa3A"/>
        <rdfs:label>utbms:Communicate (other external)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDC4DqaMFIcuowN8mPKfzE5 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDC4DqaMFIcuowN8mPKfzE5">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>near</rdfs:label>
        <skos:definition>Specifies a proximity search operator, used to find items that are close to each other (within a certain distance) in a text</skos:definition>
        <skos:notation>folio:near</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDGdDmBhMZICUDoXt6HEEbr -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDGdDmBhMZICUDoXt6HEEbr">
        <rdfs:comment>RIEHL NOTE: This was originally conceived as a `New York Courts folio:hasType Dispute Forum` but that will likely be deprecated in favor of having Courts be Individuals (not Classes).</rdfs:comment>
        <rdfs:label>hastype</rdfs:label>
        <skos:notation>folio:hastype</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDGeYzs7plsJOebCI0Ne8kD -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDGeYzs7plsJOebCI0Ne8kD">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBoQmbBINbNwazijSzgsexi"/>
        <rdfs:label>oasis:appliesModality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDHwdM2A0beLXWa3uCOuj18 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDHwdM2A0beLXWa3uCOuj18">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>applied</rdfs:label>
        <skos:altLabel>applied</skos:altLabel>
        <skos:notation>folio:applied</skos:notation>
        <skos:definition>In a legal setting, &quot;applied&quot; refers to the act of implementing or utilizing legal principles, caselaw, statutes, or rules in the decision-making process. This involves interpreting the relevant law and integrating it into the resolution of a case, whether by a judge, arbitrator, or jury.</skos:definition>
        <skos:example>Arbitrator applied Caselaw</skos:example>
        <skos:example>Judge applied Earlier Case</skos:example>
        <skos:example>Jury applied the Statute</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDKLC9VaaCYFPmyFrTjNTd5 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDKLC9VaaCYFPmyFrTjNTd5">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>contains</rdfs:label>
        <skos:definition>Indicates an operator that searches for items containing a specific substring or sequence.</skos:definition>
        <skos:notation>folio:contains</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>ZZZ:DEPRECATED PROPERTIES</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDNoruauHZ4Tn1JNgobdmol -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDNoruauHZ4Tn1JNgobdmol">
        <rdfs:label>concerning</rdfs:label>
        <skos:altLabel>concerning</skos:altLabel>
        <skos:altLabel>in relation to</skos:altLabel>
        <skos:altLabel>pertaining to</skos:altLabel>
        <skos:altLabel>regarding</skos:altLabel>
        <skos:notation>folio:inRelationTo</skos:notation>
        <skos:notation>folio:pertainingTo</skos:notation>
        <skos:notation>folio:concerning</skos:notation>
        <skos:notation>folio:regarding</skos:notation>
        <skos:definition>(Hearing) folio:concerning (Motion) folio:concerning (Summary Judgment)</skos:definition>
        <skos:definition>Example: (Motion) folio:concerning (Summary Judgment)</skos:definition>
        <skos:definition>In legal contexts, &quot;concerning&quot; is used to denote the subject matter, focus, or scope of a legal document, proceeding, or action. This term typically introduces the specific topic or issue that is being addressed or dealt with, such as a particular motion or hearing, linking it to a broader legal context or objective.</skos:definition>
        <skos:prefLabel>regarding</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDSBgWxWYHvX1IXdqrnXOT -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDSBgWxWYHvX1IXdqrnXOT">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>DEPRECATED FAVORING AFFIRMED folio:upheld</rdfs:label>
        <skos:definition>In legal terms, &quot;upheld&quot; refers to the decision of a court, especially an appellate court, to confirm and maintain the ruling or decision of a lower court. This indicates that, upon review, the appellate court found the original decision to be correct and in accordance with the law, warranting no change or reversal.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDVFemXaqT513UrGRVhWDSH -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDVFemXaqT513UrGRVhWDSH">
        <rdfs:label>hasNext</rdfs:label>
        <owl:inverseOf>folio:precededBy</owl:inverseOf>
        <skos:altLabel>is followed by</skos:altLabel>
        <skos:altLabel>precedes</skos:altLabel>
        <skos:notation>folio:precedes</skos:notation>
        <skos:notation>folio:hasNext</skos:notation>
        <skos:notation>folio:followedBy</skos:notation>
        <skos:definition>In the context of legal ontologies and processes, &quot;has next&quot; refers to the sequential relationship where a specific legal event or task is followed by another predetermined event or task. This concept denotes the procedural order or chronology within legal proceedings. For example, &quot;jury selection has next trial&quot; implies that the jury selection phase in a trial precedes the actual commencement of the trial proceedings.</skos:definition>
        <skos:example>Jury Selection hasNext Trial</skos:example>
        <skos:prefLabel>followedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDVP2bwCYtRO8GBcq3zcaWa -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDVP2bwCYtRO8GBcq3zcaWa">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>oasis:hasStatusDevelopment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDc1B2GDj6ckfXBkRRSJXfH -->
    
    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDc1B2GDj6ckfXBkRRSJXfH">
        <rdfs:label>TR:SALI</rdfs:label>
        <skos:definition>Mapping between Thomson Reuters concepts (i.e., labels, identifiers) and SALI concepts.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDcFjKHk0LjerTTIG0CYTXv -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDcFjKHk0LjerTTIG0CYTXv">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RBDCMbVjuJ10m588Ou29eSf"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R9PQzGkaFkFgcMvZOKrmbqT"/>
        <rdfs:label>oasis:atTime</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDexpiWmmK9xFb7iMaBJpcD -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDexpiWmmK9xFb7iMaBJpcD">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>reverted</rdfs:label>
        <skos:altLabel>reverted</skos:altLabel>
        <skos:notation>folio:reverted</skos:notation>
        <skos:definition>In legal contexts, &quot;reverted&quot; refers to the act of returning to a previous state, condition, or set of circumstances, often as a result of a judicial decision or the operation of law. This term is typically used when rights, property, or legal status are restored to their former condition, either due to contractual stipulations, legal provisions, or court orders.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDg3svGlPQWSeM8eDKzJTSf -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDg3svGlPQWSeM8eDKzJTSf">
        <rdfs:label>hasExpense</rdfs:label>
        <skos:altLabel>has the expense</skos:altLabel>
        <skos:altLabel>incurs the cost</skos:altLabel>
        <skos:notation>folio:hasExpense</skos:notation>
        <skos:notation>folio:incursCost</skos:notation>
        <skos:definition>In legal and professional contexts, &quot;has expense&quot; refers to the incurrence of costs or financial outlays associated with performing certain actions or fulfilling duties. This includes expenditures such as travel costs for depositions, purchasing materials for expert analysis, or other necessary expenses incurred in the course of legal representation or consultation.</skos:definition>
        <skos:example>Expert has expense of purchasing exemplar product</skos:example>
        <skos:example>Lawyer has expense of flight for deposition</skos:example>
        <skos:prefLabel>incursCost</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDkNxLSVfcWlNUKatMJwnMt -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDkNxLSVfcWlNUKatMJwnMt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9x6yqzHQfo3MF4rxIcPupm"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>filed</rdfs:label>
        <skos:altLabel>filed</skos:altLabel>
        <skos:altLabel>submitted</skos:altLabel>
        <skos:notation>folio:filed</skos:notation>
        <skos:notation>folio:submitted</skos:notation>
        <skos:definition>In legal procedures, &quot;filed&quot; refers to the formal submission of documents, such as lawsuits, motions, or applications, to a court, agency, or other official body. This act initiates or progresses legal proceedings and is a critical step in ensuring that legal matters are officially recorded, recognized, and acted upon according to relevant laws and regulations.</skos:definition>
        <skos:example>Lawyer filed motion with the court</skos:example>
        <skos:example>Petitioner filed the application with the agency</skos:example>
        <skos:prefLabel>submitted</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDl0w1bStTabxjJhVmoyAO8 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDl0w1bStTabxjJhVmoyAO8">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt"/>
        <rdfs:label>isSubsequent</rdfs:label>
        <skos:altLabel>is the subsequent</skos:altLabel>
        <skos:notation>folio:isSubsequent</skos:notation>
        <skos:definition>&quot;Is Subsequent&quot; in legal and procedural contexts refers to something that follows or comes after something else, particularly in a sequence of events, documents, or legal actions. This term is used to describe a version, action, or decision that occurs or is produced after a preceding one, indicating its place in a chronological or logical order.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDxHHUOM1v4NOmByelkNw11 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDxHHUOM1v4NOmByelkNw11">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCDx1OyD4xo9Pj6dWOBMStt"/>
        <rdfs:label>hasSignedDate</rdfs:label>
        <skos:altLabel>has a signature date of</skos:altLabel>
        <skos:altLabel>was signed on</skos:altLabel>
        <skos:notation>folio:hasSignedDate</skos:notation>
        <skos:definition>&quot;Has Signed Date&quot; refers to the specific date on which a contract, agreement, judicial opinion, or other legal document was signed. This date is often marks the commencement of rights, responsibilities, and terms outlined in the document.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RDyfwuKf33mCj2gfpqW702n -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RDyfwuKf33mCj2gfpqW702n">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>or</rdfs:label>
        <skos:definition>A logical operator that combines search terms to retrieve items that match any of the terms.</skos:definition>
        <skos:notation>folio:or</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBeF5svD5xdsZlF7cggOBUa"/>
        <rdfs:label>binaryOperators</rdfs:label>
        <skos:definition>A category of operators that use two operands, such as the comparison of numerical values (e.g., GreaterThan, LessThan, EqualTo, NotEqualTo).</skos:definition>
        <skos:notation>folio:binaryOperators</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RHY2uPq1euk703pZQLNwMA -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RHY2uPq1euk703pZQLNwMA">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:label>DEPRECATED FAVORING DISMISSED 
folio:disposedOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RHfRMWirAE49F9Widnyd7V -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RHfRMWirAE49F9Widnyd7V">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R8oVqWGVPjAgl133D0pNL7g"/>
        <rdfs:label>directExamined</rdfs:label>
        <skos:altLabel>direct-examined</skos:altLabel>
        <skos:notation>folio:directExamined</skos:notation>
        <skos:definition>In the legal realm, &quot;direct examined&quot; refers to the initial questioning of a witness by the party that called them to testify in a trial or hearing. This process is fundamental for establishing the facts of a case as presented by the witness, and it focuses on eliciting favorable, relevant testimony in a narrative form, typically without leading questions.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RHtKJmN0SXcOrZPEc1oJHF -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RHtKJmN0SXcOrZPEc1oJHF">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RB3D5LuBl4dwJ8i28pdIa3A"/>
        <rdfs:label>utbms:Communicate (in firm)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RI8E8tMRzJgno8mZ763EPv -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RI8E8tMRzJgno8mZ763EPv">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RH73qlQGajAwUFNMEkH9T2"/>
        <rdfs:label>notEqual</rdfs:label>
        <skos:definition>An operator that returns items where the field&apos;s value does not match the given value.</skos:definition>
        <skos:notation>folio:notEqual</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RMQvvbEUbz97RKKfKnpOTl -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RMQvvbEUbz97RKKfKnpOTl">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>requested</rdfs:label>
        <skos:altLabel>Solicited</skos:altLabel>
        <skos:altLabel>Sought</skos:altLabel>
        <skos:altLabel>requested</skos:altLabel>
        <skos:notation>folio:requested</skos:notation>
        <skos:definition>&quot;Requested&quot; in legal terms refers to the act of formally asking for something within a legal context, such as information, action, or a particular legal remedy. This typically involves a formal application or petition to a court, agency, or another party, outlining the specifics of what is being sought and the grounds for the request.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RN3mWlXZUAt07dYsu6tls2 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RN3mWlXZUAt07dYsu6tls2">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
        <rdfs:label>seeksToAchieve</rdfs:label>
        <skos:altLabel>seeks to achieve</skos:altLabel>
        <skos:notation>folio:seeksToAchieve</skos:notation>
        <skos:definition>&quot;Seeks to Achieve&quot; refers to the act of pursuing a specific legal outcome or objective. This involves drafting, arguing, and advocating for legal legal goals (e.g., preliminary injunction, securing indemnification).</skos:definition>
        <skos:example>Lawyer Seeks to Achieve Preliminary Injunction</skos:example>
        <skos:example>Party Seeks to Achieve Indemnification</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RQibzWMnQMD73BO19CWUPt -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RQibzWMnQMD73BO19CWUPt">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>sent</rdfs:label>
        <skos:altLabel>sent</skos:altLabel>
        <skos:notation>folio:sent</skos:notation>
        <skos:definition>&quot;Sent&quot; in a legal context refers to the act of dispatching or transmitting a communication or document from one party to another.</skos:definition>
        <skos:example>Lawyer Sent Message</skos:example>
        <skos:example>Paralegal Sent Notice</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RRmQYyvtQ35FVexIVWZnyn -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RRmQYyvtQ35FVexIVWZnyn">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R8oVqWGVPjAgl133D0pNL7g"/>
        <rdfs:label>crossExamined</rdfs:label>
        <skos:altLabel>cross-examined</skos:altLabel>
        <skos:notation>folio:crossExamined</skos:notation>
        <skos:notation>folio:interrogated</skos:notation>
        <skos:definition>&quot;Cross examined&quot; in legal contexts denotes the rigorous questioning of a witness by the opposing party, often following their direct examination by the party who called them. This process is a critical aspect of the adversarial system, aimed at challenging the credibility, reliability, and consistency of the witness&apos;s testimony, often through pointed, leading questions.</skos:definition>
        <skos:prefLabel>interrogated</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RSUYYgxaSZBNickjaRAqzJ -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RSUYYgxaSZBNickjaRAqzJ">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>codified</rdfs:label>
        <skos:altLabel>codified</skos:altLabel>
        <skos:notation>folio:codified</skos:notation>
        <skos:definition>In the legislative and legal context, &quot;codified&quot; refers to the process by which laws, rules, or regulations are systematically collected, arranged, and published in a formal legal code. This act of codification transforms various statutes, ordinances, and legal principles into an organized and accessible format, often to provide clarity, consistency, and ease of reference.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RSvfP5xuO21mAI4NS6EbLP -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RSvfP5xuO21mAI4NS6EbLP">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:label>distinguished</rdfs:label>
        <skos:altLabel>distinguished</skos:altLabel>
        <skos:notation>folio:distinguished</skos:notation>
        <skos:definition>In legal analysis, &quot;distinguished&quot; refers to the process of demonstrating how a current case or situation differs from a previous case, legal proposition, or fact pattern. This is often done by judges or arbitrators to justify a different legal outcome or application of law, despite apparent similarities to earlier precedents or scenarios.</skos:definition>
        <skos:example>Arbitrator distinguished earlier fact pattern</skos:example>
        <skos:example>Judge distinguished earlier caselaw</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RTVHIHUY48KidG92GXtTlH -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RTVHIHUY48KidG92GXtTlH"/>
    


    <!-- https://folio.openlegalstandard.org/RUBi4AYhUtpu5FhXaia36Q -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RUBi4AYhUtpu5FhXaia36Q">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R9OgtSm35ykpUSi7mgiCW"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDCkFrEclhipkoHPgckuFY6"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RL7sqh8NY6UuTxs6rerO5U"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:label>notarized</rdfs:label>
        <skos:altLabel>notarized</skos:altLabel>
        <skos:notation>folio:notarized</skos:notation>
        <skos:definition>In legal terms, &quot;notarized&quot; refers to the process where a document is officially certified by a notary public, a licensed official who verifies the identity of the signatories and their understanding and willingness to sign the document. This process lends authenticity and legal weight to the document, often required for legal formalities such as property deeds, wills, and contracts.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RUmf4RiyCyjE8hwApkfp6o -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RUmf4RiyCyjE8hwApkfp6o">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>researched</rdfs:label>
        <skos:altLabel>researched</skos:altLabel>
        <skos:notation>folio:researched</skos:notation>
        <skos:definition>&quot;Researched&quot; in a legal context refers to the systematic investigation or study of legal documents, case law, statutes, and other legal sources to gather information, understand legal precedents, and develop legal arguments. This process is fundamental for lawyers, legal scholars, and other professionals to build a thorough understanding of legal issues, cases, and the legal framework.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RVcCszu01sLSiXW2CvBBE7 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RVcCszu01sLSiXW2CvBBE7">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:label>reviewed</rdfs:label>
        <skos:altLabel>assessed</skos:altLabel>
        <skos:altLabel>examined</skos:altLabel>
        <skos:altLabel>reviewed</skos:altLabel>
        <skos:notation>folio:assessed</skos:notation>
        <skos:notation>folio:examined</skos:notation>
        <skos:notation>folio:reviewed</skos:notation>
        <skos:definition>&quot;Reviewed&quot; in a legal setting refers to the examination and evaluation of legal documents, motions, or evidence. This process, often undertaken by judges, lawyers, or legal officials, involves a thorough analysis to understand the content, assess its relevance and validity, and determine its impact on a legal matter or decision.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RWd966Up5VVRxKPkv1PPBZ -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RWd966Up5VVRxKPkv1PPBZ">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R9OgtSm35ykpUSi7mgiCW"/>
        <rdfs:label>certified</rdfs:label>
        <skos:altLabel>certified</skos:altLabel>
        <skos:notation>folio:certified</skos:notation>
        <skos:definition>In a legal context, &quot;certified&quot; refers to the formal declaration or confirmation by a competent authority that a document, process, or individual meets established standards or criteria. This certification process is crucial for establishing the authenticity, accuracy, or qualification of the subject matter, often required for legal compliance, recognition, or enforcement.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RXvlgtHqXTWS2UvbLmm6JD -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RXvlgtHqXTWS2UvbLmm6JD">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>hasBenefit</rdfs:label>
        <skos:definition>Who has the benefit of an item? EXAMPLE: Whom does Contractual Directionality benefit? Example:  Party A indemnifying Party B benefits Party B. Example: Party A receiving Party B&apos;s goods benefits Party A.</skos:definition>
        <skos:notation>folio:hasBenefit</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RZSnKehA643O8824iC320g -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RZSnKehA643O8824iC320g">
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R7L5eLIzH0CpOUE74uJvSjL"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk"/>
        <rdfs:label>workedFor</rdfs:label>
        <skos:altLabel>was employed by</skos:altLabel>
        <skos:altLabel>worked for</skos:altLabel>
        <skos:notation>folio:workedFor</skos:notation>
        <skos:notation>folio:wasEmployedBy</skos:notation>
        <skos:definition>&quot;Worked For&quot; refers to the employment or professional relationship where an individual, such as a lawyer or paralegal, is engaged in duties or services for an entity like a court, a judge, or a law firm. This term encompasses the scope of professional activities undertaken by the individual under the employment or direction of the specified legal entity or employer.</skos:definition>
        <skos:example>Assistant Worked For Lawyer</skos:example>
        <skos:example>Lawyer Worked For Firm</skos:example>
        <skos:example>Lawyer Worked For Judge</skos:example>
        <skos:example>Lawyer Worked for Supreme Court</skos:example>
        <skos:example>Paralegal Worked For Firm</skos:example>
        <skos:prefLabel>wasEmployedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/Rc2xL6UfK0qZytPCyBeduO -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/Rc2xL6UfK0qZytPCyBeduO">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R8N2AJIJYBB3hzZL7OeB0CB"/>
        <rdfs:label>oasis:hasRoles</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RdAgrsvdn5d59nUUq1iU9D -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RdAgrsvdn5d59nUUq1iU9D">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RB0hju1karAVIAsSqkf1Pza"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCnTNVCQ1VndGxskbMoaLr8"/>
        <rdfs:label>took</rdfs:label>
        <skos:altLabel>is taking</skos:altLabel>
        <skos:notation>folio:isTaking</skos:notation>
        <skos:altLabel>took</skos:altLabel>
        <skos:notation>folio:took</skos:notation>
        <skos:definition>&quot;Took&quot; in various legal contexts encompasses the action of acquiring, obtaining, or accepting something. That can include taking property, solemnly accepting something (e.g., oath), or taking evidence (e.g., testimony).</skos:definition>
        <skos:example>Criminal took Property</skos:example>
        <skos:example>Investigator took Testimony</skos:example>
        <skos:example>Juror took Oath</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RdpSPh3bFHYrQ3vYPDwJYB -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RdpSPh3bFHYrQ3vYPDwJYB">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCde1yp5z3QI9MoNV8BBZCj"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RDt4vQCYDfY0R9fZ5FNnTbj"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RUH9A0VJfKpItj0UkMldZQ"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RdxEgRnL667VicSJJV3xiZ"/>
        <rdfs:label>cited</rdfs:label>
        <skos:altLabel>cited</skos:altLabel>
        <skos:altLabel>invoked</skos:altLabel>
        <skos:altLabel>quoted</skos:altLabel>
        <skos:altLabel>referenced</skos:altLabel>
        <skos:notation>folio:invoked</skos:notation>
        <skos:notation>folio:quoted</skos:notation>
        <skos:notation>folio:cited</skos:notation>
        <skos:notation>folio:referenced</skos:notation>
        <skos:definition>In legal contexts, &quot;cited&quot; refers to the act of referencing or quoting authoritative sources such as caselaw, statutes, documents, or prior testimony to support arguments, claims, or positions. This practice is common in legal reasoning and advocacy, providing evidential or jurisprudential backing to the points being made.</skos:definition>
        <skos:prefLabel>referenced</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RebIkaU3BW0LoMNlSf8DQ3 -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RebIkaU3BW0LoMNlSf8DQ3">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RDNZZOyU2yb5Q9xbxIWXd62"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>DEPRECATED FAVORING REMANDED folio:remitted</rdfs:label>
        <skos:definition>In legal terminology, &quot;remit&quot; refers to the act of a higher court sending a case back to a lower court for further action, reconsideration, or a new trial. This typically occurs after an appellate review, where the appellate court has identified specific issues that require additional examination or resolution by the lower court.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RfM1fbV2yfBPHRkAlT1o3o -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RfM1fbV2yfBPHRkAlT1o3o">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>destroyed</rdfs:label>
        <skos:altLabel>destroyed</skos:altLabel>
        <skos:notation>folio:destroyed</skos:notation>
        <skos:definition>To destroy an artifact. Example: Party destroyed evidence. Example: Provider destroyed a Buyer&apos;s (e.g., a client&apos;s) closed and dormant file. Example: Party destroyed data according to its Document Retention Policy.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/Ri6OrmVAB1fhqFK0qdbch -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/Ri6OrmVAB1fhqFK0qdbch">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>discontinued</rdfs:label>
        <skos:altLabel>abandoned</skos:altLabel>
        <skos:altLabel>discontinued</skos:altLabel>
        <skos:notation>folio:discontinued</skos:notation>
        <skos:notation>folio:abandoned</skos:notation>
        <skos:definition>In the legal realm, &quot;discontinued&quot; refers to the cessation or termination of a legal action, process, or proceeding before its natural conclusion. This typically occurs when the party initiating the action decides to halt proceedings, which can be due to various reasons such as a settlement, a change in circumstances, or a reassessment of the likelihood of success.</skos:definition>
        <skos:prefLabel>abandoned</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RlWWALyEkmi7ifaz2MpmoR -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RlWWALyEkmi7ifaz2MpmoR">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067"/>
        <rdfs:label>remanded</rdfs:label>
        <skos:altLabel>remanded</skos:altLabel>
        <skos:altLabel>remitted</skos:altLabel>
        <skos:notation>folio:remanded</skos:notation>
        <skos:notation>folio:remitted</skos:notation>
        <skos:definition>&quot;Remanded&quot; in legal practice refers to the decision of a higher court to send a case back to a lower court for additional action, further proceedings, or a new decision. This often occurs when an appellate court finds that the lower court made a procedural error, or when additional fact-finding or legal analysis is necessary.</skos:definition>
        <skos:prefLabel>remitted</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RmEof79RS5Y9fhzwIXRGAW -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RmEof79RS5Y9fhzwIXRGAW">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCtXcXKz9zo5jk9QW5UpTyg"/>
        <rdfs:label>oasis:hasTime</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/Rrs38f6iVq0CeArcJaGhwR -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/Rrs38f6iVq0CeArcJaGhwR">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>arrived</rdfs:label>
        <skos:altLabel>arrived</skos:altLabel>
        <skos:notation>folio:arrived</skos:notation>
        <skos:definition>Arrival at a location, by a person or object, which can have litigation, immigration, tax, and other regulatory effects.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/Rtcn744oelK5y1pAR0epCQ -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/Rtcn744oelK5y1pAR0epCQ">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RNICD9MDcFQJJX6nxX11Vt"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RiuB3WjtPaioVphDpqLzVK"/>
        <rdfs:label>rejected</rdfs:label>
        <skos:altLabel>rejected</skos:altLabel>
        <skos:notation>folio:rejected</skos:notation>
        <skos:definition>In legal proceedings, &quot;rejected&quot; refers to the decision of an authority (judicial, arbitral, administrative) to not accept an argument, testimony, evidence, document, or claim presented. This implies that the presented material is deemed unpersuasive, insufficient, irrelevant, or inadmissible under legal standards or specific case requirements.</skos:definition>
        <skos:example>Judge rejected argument</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RvsDUAn0QArabNSac4wW2P -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RvsDUAn0QArabNSac4wW2P">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/R8N2AJIJYBB3hzZL7OeB0CB"/>
        <rdfs:label>hasTimes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RwdlnXbLIUXj4VeNyet8FP -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RwdlnXbLIUXj4VeNyet8FP">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCBqIJm4IPngJgyvh49kP62"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R9PfY9lASO3JAZnFZiWzBKN"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RlNd4fuEGnhNmnebjdyb9h"/>
        <rdfs:comment>a collection of Agents</rdfs:comment>
        <rdfs:label>has agent collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/Rzg9RcXQ0FUTW9tMLOUG0X -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/Rzg9RcXQ0FUTW9tMLOUG0X">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBD1G5FjdaXj6UM26EWBxJc"/>
        <rdfs:label>utbms:Appear for/attend</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://folio.openlegalstandard.org/RznfymBGs7WesrwWNzQLov -->

    <owl:ObjectProperty rdf:about="https://folio.openlegalstandard.org/RznfymBGs7WesrwWNzQLov">
        <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RBW19bsnBOwINS8K601XYsz"/>
        <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
        <rdfs:range rdf:resource="https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF"/>
        <rdfs:label>participatedIn</rdfs:label>
        <skos:altLabel>contributed to</skos:altLabel>
        <skos:altLabel>participated in</skos:altLabel>
        <skos:notation>folio:contributedTo</skos:notation>
        <skos:notation>folio:tookPartIn</skos:notation>
        <skos:altLabel>took part in</skos:altLabel>
        <skos:altLabel>was involved in</skos:altLabel>
        <skos:notation>folio:participatedIn</skos:notation>
        <skos:notation>folio:wasInvolvedIn</skos:notation>
        <skos:definition>&quot;Participated in&quot; within a legal framework refers to active involvement in a legal proceeding or activity, such as a hearing, deposition, or negotiation. This term encompasses not just physical presence but also engagement in the process, contributing through actions like presenting arguments, giving testimony, or collaborating in discussions.</skos:definition>
        <skos:prefLabel>wasInvolvedIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#locatedIn">
        <rdfs:label>rdfs:locatedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    


    <!-- http://www.w3.org/2002/07/owl#SymmetricProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#SymmetricProperty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <skos:definition rdf:resource="https://youtu.be/z95PYaOxPMs?t=237"/>
        <skos:definition>if isNeighborOf(a,b), then it holds that isNeighborOf(b,a)</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#TransitiveProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#TransitiveProperty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <skos:definition rdf:resource="https://youtu.be/z95PYaOxPMs?t=197"/>
        <skos:definition>E.g., if isPartOf(a,b) and isPartOf(b,c) then it holds that isPartOf(a,c)</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#complementOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#complementOf">
        <rdfs:label>owl:complementOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#isAuthor -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#isAuthor">
        <rdfs:label>owl:isAuthor</rdfs:label>
    </owl:ObjectProperty>
    


