        <rdfs:label>Fernandeno Tataviam Band of Mission Indians</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBnSXvwm8EPPRhNuxQD8avo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBnSXvwm8EPPRhNuxQD8avo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
        <rdfs:label>Debt Repayment Plan Bankruptcy</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Plan de remboursement de la dette Faillite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Plano de pagamento de dívidas Falência</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schuldenrückzahlungsplan Insolvenz</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">债务偿还计划 破产</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債務返済計画 破産</skos:altLabel>
        <skos:definition>Debt Repayment Plan Bankruptcy allows individuals with a regular income to develop a plan to repay all or part of their debts over a period of time. This form of bankruptcy can provide the debtor with an opportunity to save their home from foreclosure, reschedule secured debts, and consolidate their obligations into a single payment plan overseen by a bankruptcy trustee.</skos:definition>
    </owl:Class>
    


