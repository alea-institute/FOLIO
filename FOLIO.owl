        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11111"/>
        <rdfs:label>Soybean Farming</rdfs:label>
        <skos:definition>See industry description for 111110.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ia71XU0ERcuJXpGkikvWMw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ia71XU0ERcuJXpGkikvWMw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/BsO8OrIXSZ6XyLGTD8O5AA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=444230"/>
        <rdfs:label>Outdoor Power Equipment Retailers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in retailing new outdoor power equipment or retailing new outdoor power equipment in combination with activities, such as repair services and selling replacement parts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/iaAaRLyxRTKYRHky4EiqQw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/iaAaRLyxRTKYRHky4EiqQw">
