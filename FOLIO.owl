        <rdfs:label>Advanced Health Care Directive</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Advanced Health Care Directive</skos:altLabel>
        <skos:altLabel>Advanced Healthcare Directive</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Directiva Anticipada de Atención Médica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Directive anticipée de soins de santé</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Diretiva antecipada de cuidados de saúde</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Instrucciones Previas de Atención Médica</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorausverfügung für den Gesundheitsfall</skos:altLabel>
