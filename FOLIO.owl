        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311512"/>
        <rdfs:label>Creamery Butter Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing creamery butter from milk and/or processed milk products.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Oi22tkZrQEawQ3tlRQ-j_w -->

