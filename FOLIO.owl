    <!-- https://folio.openlegalstandard.org/RDPAkfqZsida3SmBbpuDDHh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDPAkfqZsida3SmBbpuDDHh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDeH9slXtJOmFPiZhIzsDUg"/>
        <rdfs:label>NATO-6 Visa</rdfs:label>
        <skos:altLabel>International Military Alliance Civilian Component Visa</skos:altLabel>
        <skos:altLabel>NATO Civilian Component Visa</skos:altLabel>
        <skos:altLabel>NATO Civilian Employee Visa</skos:altLabel>
        <skos:altLabel>NATO Contractor Visa</skos:altLabel>
        <skos:definition>A NATO-6 visa is issued to members of a civilian component attached to NATO armed forces, allowing them to enter the U.S. to perform their duties. This visa category includes civilian employees and contractors working directly with NATO military operations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDPDAL6xV5x2XCGzSnX6wkd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDPDAL6xV5x2XCGzSnX6wkd">
