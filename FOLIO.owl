        <rdfs:label>ADR Judicial Settlement Conference</rdfs:label>
        <skos:definition>A settlement conference facilitated by a judge or a neutral third party in an Alternative Dispute Resolution (ADR) forum to resolve disputes outside of the court system.</skos:definition>
    </owl:Class>
    


