    <!-- https://folio.openlegalstandard.org/RBFOZ6k0p0FnZyMzuijRYdU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBFOZ6k0p0FnZyMzuijRYdU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkVEfL4H41pColicGhkXJb"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_05"/>
        <rdfs:label>Non-Hodgkin Lymphoma</rdfs:label>
        <skos:definition>Non-Hodgkin lymphoma (NHL) is a diverse group of blood cancers that originate in the lymphatic system, which is part of the body&apos;s immune system. It includes various subtypes that differ in their aggressiveness and treatment protocols, commonly requiring chemotherapy, radiation therapy, immunotherapy, or stem cell transplantation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBFQCPcpMnfZ25UzTt5k770 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBFQCPcpMnfZ25UzTt5k770">
