    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fhgj0A_rT2yLAtqVkbCvhg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fhgj0A_rT2yLAtqVkbCvhg">
