        <rdfs:label>Tortilla Manufacturing</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in manufacturing tortillas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fWlD4MiEToifhYtcNfSOuA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fWlD4MiEToifhYtcNfSOuA">
