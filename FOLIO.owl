        <rdfs:label>B210 Business Operations</rdfs:label>
        <skos:definition>Issues related to debtor-in-possession operating in chapter 11 such as employee, vendor, tenant issues and other similar problems</skos:definition>
        <skos:prefLabel>B210 Business Operations</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RgQLVqqo23cFKNa2n4P7wp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgQLVqqo23cFKNa2n4P7wp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9XbvULiDU6Lhqax71LzThw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Recoupment of Public Benefit</rdfs:label>
        <skos:definition>Recoupment of public benefit refers to the action taken by a government agency to recover funds that have been overpaid to an individual or family under a public benefit program. This process may involve reducing future benefit payments, establishing repayment plans, or legal actions, and is aimed at maintaining the integrity and financial sustainability of the benefit program.</skos:definition>
    </owl:Class>
    


