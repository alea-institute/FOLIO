        <skos:altLabel xml:lang="pt-br">Resposta à Contrapartida</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Respuesta a la Contrademanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Respuesta a la Contrademanda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réponse à une demande reconventionnelle</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תשובה לתביעת כנגד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">काउंटर क्लेम का जवाब</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">反訴応答</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反诉答辩</skos:altLabel>
