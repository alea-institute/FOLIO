        <skos:altLabel xml:lang="zh-cn">仲裁裁决</skos:altLabel>
        <skos:definition>An arbitration award is a decision made by an arbitrator or panel of arbitrators to resolve a dispute between parties, which is binding and enforceable by law.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBezOsNqOiZGv3hJvsQvVkp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBezOsNqOiZGv3hJvsQvVkp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Bring Down Certificate Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bring Down Certificate Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de réduction du certificat</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Certificación de Actualización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Certificación de Actualización</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de redução do certificado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Herabsetzung des Zertifikats</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תעודת הורדה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ब्रिंग डाउन प्रमाणपत्र डाक</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">下证条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証明書削減条項</skos:altLabel>
        <skos:definition>A Bring Down Certificate Clause is a provision in a contract that requires a party to provide updated information or documentation at a later time to ensure the accuracy of the original representations and warranties made in the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBf8HVq9mGPrjgDLsuLpfox -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBf8HVq9mGPrjgDLsuLpfox">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
        <rdfs:label>Limited Warranty Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de garantie limitée</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de garantia limitada</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de garantía limitada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de garantía limitada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gewährleistungsausschlussklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Limited Warranty Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אחריות מוגבלת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सीमित वारंटी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">有限保修条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">限定保証条項</skos:altLabel>
        <skos:definition>A limited warranty clause is a provision in a contract that specifies the extent to which a seller is responsible for repairing or replacing a product that fails to meet certain standards within a specified period of time.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBf9jW3bWpfP4TPEFOvvZEv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBf9jW3bWpfP4TPEFOvvZEv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7knuzL2Cu6WLdyvQiDMp8F"/>
        <rdfs:label>Not Liable</rdfs:label>
        <skos:definition>&quot;Not liable&quot; is a legal determination in civil cases indicating that a party has been found not legally responsible or accountable for a particular harm, injury, or legal obligation. It means that the court has not established the party&apos;s liability for the claims brought against them, and they are not required to provide compensation or remedies to the plaintiff in the case.</skos:definition>
    </owl:Class>
    


