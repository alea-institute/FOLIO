        <skos:altLabel xml:lang="es-es">Moción para Rechazar el Arrendamiento o Contrato Ejecutorio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Rechazar el Arrendamiento o Contrato Ejecutorio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour rejeter le bail ou le contrat exécutoire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Reject Lease or Executory Contract</skos:altLabel>
