        <skos:altLabel xml:lang="es-mx">Parte sin representación legal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Partie Pro Se</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Pro-Se-Partei</skos:altLabel>
        <skos:altLabel>Self-Represented Party</skos:altLabel>
        <skos:altLabel>Unrepresented Party</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מי שמייצג את עצמו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वयं से पक्ष</skos:altLabel>
