        <rdfs:label>Insolvent Seller Having Sold Goods</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Insolvent Seller Having Sold Goods</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Vendedor insolvente que ha vendido bienes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Vendedor insolvente que ha vendido bienes</skos:altLabel>
