        <rdfs:label>Arkansas Circuit Court - White Cty.</rdfs:label>
        <skos:definition>A court located in White County, Arkansas that has jurisdiction over civil and criminal cases within its designated geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R85jiP49mIhIBjTNJlNv6Wx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85jiP49mIhIBjTNJlNv6Wx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7oBWHStfmqTLn2MypkW3Pj"/>
        <dc:identifier>ENTITY-SA</dc:identifier>
        <rdfs:label>Société Anonyme</rdfs:label>
        <rdfs:label xml:lang="fr">Société Anonyme</rdfs:label>
        <skos:altLabel xml:lang="de-de">Aktiengesellschaft</skos:altLabel>
        <skos:altLabel>Anonymous Society</skos:altLabel>
        <skos:altLabel>SA</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sociedade Anônima</skos:altLabel>
        <skos:altLabel>Société Anonyme</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Société Anonyme</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">匿名股份公司</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">株式会社</skos:altLabel>
        <skos:definition>Société anonyme (and variants in other languages; English: Anonymous society; shortened to S.A. or SA) designates a type of corporation in countries that mostly employ civil law. Depending on language, it means anonymous company, anonymous partnership, share company, or joint-stock company, roughly equivalent to a public limited company in common law jurisdictions. It is different from partnerships and private limited companies.</skos:definition>
        <skos:hiddenLabel>SA</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R85mRFndZGnrtqeakkdM38i -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85mRFndZGnrtqeakkdM38i">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQbVKPVl5dj5nW6aXoNxx4"/>
        <rdfs:label>Budget Market Segment</rdfs:label>
        <skos:altLabel>Discount</skos:altLabel>
        <skos:altLabel>Economy</skos:altLabel>
        <skos:altLabel>Value</skos:altLabel>
        <skos:definition>The budget segment refers to a specific portion of the market that is characterized by consumers who seek affordable, cost-effective products and services. This segment caters to price-sensitive consumers who prioritize value for money and functionality over luxury and exclusivity.</skos:definition>
        <skos:example>Budget Retailer</skos:example>
        <skos:example>Dollar Stores</skos:example>
        <skos:prefLabel>Affordable Segment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R85umXEwD6REGKm8idtaahc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85umXEwD6REGKm8idtaahc">
