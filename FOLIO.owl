        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Right of First Refusal Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de droit de préemption</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Derecho de Primera Opción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Derecho de Primera Opción</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de direito de preferência</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right of First Refusal Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorkaufsrecht-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות ראשונה לקנייה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पहले अधिकार अनुबंध की शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">优先购买权条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">優先購入権条項</skos:altLabel>
        <skos:definition>A Right of First Refusal Clause is a provision in a contract that grants a party the opportunity to purchase or lease property before it is offered to others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vxlbeyAj8xVakwh3gWHKp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vxlbeyAj8xVakwh3gWHKp">
