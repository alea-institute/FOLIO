            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>CLIENT_COUNTRY</rdfs:label>
        <skos:definition>The concept of CLIENT_COUNTRY refers to the country of origin or location of a client, as defined within the LEDES98BI V5 Format Rev 1-2020 standard for electronic legal invoicing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj2XfxoaqSzTELGNzBdQfj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rj2XfxoaqSzTELGNzBdQfj">
