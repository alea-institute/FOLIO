        <skos:altLabel xml:lang="en-gb">Maritime Lien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Penhor marítimo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège maritime</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Seerechtspfandrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גילוי טענת זכות ימית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समुद्री लियन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">海上抵当権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">海事留置权</skos:altLabel>
        <skos:definition>A maritime lien is a type of lien that gives a creditor the right to seize a vessel as collateral for unpaid debts related to the vessel&apos;s operation or maintenance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ja1m4FrybHKTH0BWbqz5M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ja1m4FrybHKTH0BWbqz5M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R527Rr0DAZ1Lu9VPx6QRbj"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Income Tax Practice</rdfs:label>
        <skos:altLabel>Income Tax</skos:altLabel>
        <skos:altLabel>Income Tax Service</skos:altLabel>
        <skos:definition>Income tax practice refers to the area of law where lawyers assist clients in matters related to personal or corporate income tax, including compliance, filing, and dispute resolution with tax authorities. Lawyers in this field often advise on effective tax planning strategies to minimize liability while adhering to applicable laws and regulations.</skos:definition>
    </owl:Class>
    


