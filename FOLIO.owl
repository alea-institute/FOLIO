        <dc:identifier>INSU</dc:identifier>
        <rdfs:label>Insurance Law</rdfs:label>
        <skos:altLabel xml:lang="es-es">Derecho de seguros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho de seguros</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito de seguros</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit des assurances</skos:altLabel>
        <skos:altLabel>Insurance Law</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Insurance Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versicherungsrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק ביטוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बीमा कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保险法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保険法</skos:altLabel>
        <skos:definition>Law surrounding insurance, including insurance policies and claims.</skos:definition>
        <skos:hiddenLabel>INSU</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFhtJuTWcY7UZGV9F5yOoA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFhtJuTWcY7UZGV9F5yOoA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF"/>
        <rdfs:label>Dispute Events</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Eventos de disputa</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Streitigkeiten Ereignisse</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événements de litige</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">争议事件</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">紛争イベント</skos:altLabel>
        <skos:definition>Dispute Events refer to the various stages and actions that occur during a legal disagreement between parties, including but not limited to negotiations, mediations, and arbitrations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFlPu4VKGyebs9dqmg6iFh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFlPu4VKGyebs9dqmg6iFh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_29"/>
        <rdfs:label>Malignant Melanoma</rdfs:label>
        <skos:altLabel>Melanocarcinoma</skos:altLabel>
        <skos:altLabel>Melanocytic Cancer</skos:altLabel>
        <skos:definition>Malignant melanoma is an aggressive type of cancer that originates in melanocytes, the cells responsible for producing melanin, the pigment that gives skin its color. This cancer can develop in the skin, eyes (ocular melanoma), or mucosal surfaces (mucosal melanoma), and is known for its high potential to metastasize to other parts of the body.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFmGucxTUBmP6gnVaQ7VvF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFmGucxTUBmP6gnVaQ7VvF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>General Economic or Financial Conditions Language</rdfs:label>
        <skos:altLabel xml:lang="en-gb">General Economic or Financial Conditions Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langage sur les conditions économiques ou financières générales</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lenguaje de Condiciones Económicas o Financieras Generales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lenguaje de Condiciones Económicas o Financieras Generales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Linguagem sobre condições econômicas ou financeiras gerais</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sprache zu allgemeinen wirtschaftlichen oder finanziellen Bedingungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שפת מצב כלכלי או פיננסי כללי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य आर्थिक या वित्तीय स्थितियों की भाषा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">一般的な経済または金融状況の言語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">一般经济或金融条件语言</skos:altLabel>
        <skos:definition>General Economic or Financial Conditions Language refers to a provision in a contract that outlines the impact of economic or financial conditions on the agreement, typically used as a carveout to a Material Adverse Effect definition.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFnGjQt5EwLENQv2FE8JE3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDFnGjQt5EwLENQv2FE8JE3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
        <dc:source>Fed. R. Evid. 601</dc:source>
        <dc:source>Fed. R. Evid. 701</dc:source>
        <rdfs:label>Speculation Objection</rdfs:label>
        <skos:altLabel>Conjecture Objection</skos:altLabel>
        <skos:altLabel>Guesswork Objection</skos:altLabel>
        <skos:altLabel>Unfounded Conclusion Objection</skos:altLabel>
        <skos:definition>Speculation Objection is a legal objection raised when a question or testimony calls for an answer based on conjecture or guesswork rather than personal knowledge or facts. It is used to prevent witnesses from providing opinions or conclusions without a proper foundation</skos:definition>
    </owl:Class>
    


