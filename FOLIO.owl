        <rdfs:label>State Department Office of the Inspector General</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Bureau de l&apos;inspecteur général du département d&apos;État</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro des Generalinspekteurs des Außenministeriums</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escritório do Inspetor Geral do Departamento de Estado</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina del Inspector General del Departamento de Estado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina del Inspector General del Departamento de Estado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">State Department Office of the Inspector General</skos:altLabel>
