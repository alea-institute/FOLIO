        <skos:altLabel xml:lang="pt-br">Contrato de hospedagem</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Contrato de hospedaje</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Hosting Agreement</skos:altLabel>
