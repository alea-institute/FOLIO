        <rdfs:label>Emergency Hearing Motion</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf eine Notfallanhörung</skos:altLabel>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Emergency Hearing Motion</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Audiencia de Emergencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Audiencia de Emergencia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour une audience d&apos;urgence</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Audiência de Emergência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לדיון דחוף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आपातकालीन सुनवाई याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">紧急听证动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">緊急ヒアリング請求</skos:altLabel>
        <skos:definition>An Emergency Hearing Motion (Bankruptcy) is a legal request made in a bankruptcy case for an urgent court hearing to address a specific issue or matter related to the bankruptcy proceedings.</skos:definition>
        <skos:prefLabel>Motion for Emergency Hearing</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJOT8wKPef5jg7CJ6RQtXA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJOT8wKPef5jg7CJ6RQtXA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFjY2mO804t9gJNy5Dn4P1"/>
        <rdfs:label>Fraud Prevention Regulation Claim</rdfs:label>
        <skos:altLabel>Identity Theft Prevention Rule</skos:altLabel>
        <skos:definition>A Fraud Prevention Regulation Claim (aka Red Flags Rule) stems from regulations by a regulator (e.g., U.S. FTC) that requires certain businesses and organizations to implement a written identity theft prevention program. Such rules are designed to detect, prevent, and mitigate identity theft by identifying and responding to &quot;red flags,&quot; which are patterns, practices, or specific activities that indicate the possible existence of identity theft.</skos:definition>
        <skos:example>16 C.F.R. § 681</skos:example>
        <skos:prefLabel>Red Flags Rule</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJPmwN3dU0x1Hk5Wgu3Bnx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJPmwN3dU0x1Hk5Wgu3Bnx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RzfFH8JWSdPtXHz4cLcFGE"/>
        <rdfs:label>Motion to Expedite</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Beschleunigung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Acelerar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Acelerar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour accélérer</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Expedite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Aceleração</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת תנועה להאצת הליך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">त्वरित करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加速动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">迅速な進展を求める動議</skos:altLabel>
        <skos:definition>A Motion to Expedite is a request made to the court to accelerate the proceedings of a legal case, typically due to time-sensitive circumstances or the need for a prompt resolution.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJR5fUevfKoAitP71be4PU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJR5fUevfKoAitP71be4PU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
        <rdfs:label>LAW_FIRM_POSTCODE</rdfs:label>
        <skos:definition>A law firm&apos;s postal code as defined in the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJR8oLdp2skjpPNMkMyUdu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJR8oLdp2skjpPNMkMyUdu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
        <rdfs:label>Financial Contagion Risk</rdfs:label>
        <skos:definition>The risk that financial instability in one sector or region spreads to others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJSlyaZIuNwnFZmW16u8si -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJSlyaZIuNwnFZmW16u8si">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
        <rdfs:label>Ripeness</rdfs:label>
        <skos:definition>Ripeness refers to the readiness of a case for judicial review, usually meaning that the issues are sufficiently clear and well-defined to be considered by a court. A case that is not ripe is generally dismissed because taking it up prematurely would involve the court in abstract or hypothetical questions, rather than an existing dispute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJUEBi1isIMI3tc2P5DHvM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJUEBi1isIMI3tc2P5DHvM">
