    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBVCwr551O94R7T2y8aKsPS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBVCwr551O94R7T2y8aKsPS">
