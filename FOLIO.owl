        <rdfs:label>Rules of the Judicial Panel on Multidistrict Litigation</rdfs:label>
        <skos:altLabel>MDL</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Regeln des Justizausschusses für multidisziplinäre Rechtsstreitigkeiten</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Regras do Painel Judicial de Litígios Multidistritais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Règles du Panel judiciaire sur les litiges multidistricts</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">多区域诉讼司法小组规则</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">多地区訴訟司法パネルの規則</skos:altLabel>
        <skos:definition>U.S. federal courts&apos; body of procedural rules governing Multidistrict Litigation (MDLs).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d6ePt6NeHR2HSsVArPLvn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d6ePt6NeHR2HSsVArPLvn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBYQBHCTDnnpanK0HJ0I7w"/>
        <rdfs:label>Annelids</rdfs:label>
        <skos:definition>Annelids are a phylum of invertebrate animals known as Annelida, characterized by their segmented bodies and a true coelom, which acts as a hydrostatic skeleton. This group includes earthworms, leeches, and polychaetes, and they play vital roles in soil aeration and aquatic ecosystems.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d6hYERMUTdeDdt51PsIX3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d6hYERMUTdeDdt51PsIX3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Common Carrier</rdfs:label>
        <skos:altLabel>Public Utility</skos:altLabel>
        <skos:definition>A common carrier is an individual or business that advertises to the public to transport people, offer goods, or provide services to the public. Common carriers are legally obligated to provide services to any paying customer without discrimination.</skos:definition>
        <skos:example>A bus company that offers transportation to the general public.</skos:example>
        <skos:example>A telephone company offering services to the public</skos:example>
        <skos:example>An airline that sells tickets to the public</skos:example>
        <skos:prefLabel>Public Transport Service</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d7C1AWWGwLTzQyqjLdwn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d7C1AWWGwLTzQyqjLdwn">
