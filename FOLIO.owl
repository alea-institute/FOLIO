        <skos:altLabel xml:lang="ja-jp">オセージ族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">奥萨奇族</skos:altLabel>
        <skos:definition>Osage (Language) is a specific written or spoken structured system of communication that consists of grammar and vocabulary, belonging to the Language top-level class, and used in legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ldp07MuEzCYqYViCbvmsI -->

