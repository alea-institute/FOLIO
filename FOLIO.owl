        <skos:altLabel xml:lang="zh-cn">合同期限条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約期間条項</skos:altLabel>
        <skos:definition>The Duration of the Contract Clause is a provision in a contract that specifies the length of time that the agreement will remain in effect.</skos:definition>
    </owl:Class>
    


