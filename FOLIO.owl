    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCxYSJ6CrzZMX2VesIrcwlY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED - Material Adverse Effect Definition - Applies to Target and Subsidiaries as a Whole</rdfs:label>
        <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Aplica a la Compañía Objetivo y sus Subsidiarias en su Conjunto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Aplica a la Compañía Objetivo y sus Subsidiarias en su Conjunto</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition eines wesentlichen nachteiligen Effekts - gilt für Ziel und Tochtergesellschaften als Ganzes</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Aplica-se ao Alvo e às Subsidiárias como um Todo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition d&apos;un effet défavorable important - s&apos;applique à la cible et aux filiales dans leur ensemble</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - Applies to Target and Subsidiaries as a Whole</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת אפקט שלילי חומרי - חלה על היעד והספקות שלו כולם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - टारगेट और सबशीडियरीज के लिए पूरे रूप से लागू होती है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-ターゲットおよび子会社全体に適用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">重大不利影响定义-适用于整个目标和子公司</skos:altLabel>
        <skos:definition>SUPERCEDED BY ACQUIROR AND ACQUIREE TAGS. A Material Adverse Effect (MAE) is a significant negative change or event that affects both the target company and its subsidiaries as a whole, as defined in a legal agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCxcU4AQo2mykjqSdB8EGpW -->

