        <skos:altLabel xml:lang="he-il">סעיף אתי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नैतिकता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">倫理条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">道德条款</skos:altLabel>
        <skos:definition>An Ethics Clause is a provision in a contract that outlines the ethical standards and principles that the parties agree to abide by during the course of their relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrY0WmfjbMJnGXxC460UCO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrY0WmfjbMJnGXxC460UCO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwD7QSyU5m2So0AXqivp9q"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/REVaSCS1dfp5tEOHNx13sD"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>JJ50 Applications relating to Costs alone (UK J-CODE)</rdfs:label>
        <skos:definition>Includes applications for security for costs, costs capping and protective costs orders.  Does not include budgeting or costs management orders which are dealt with at [JB40].   Does not include applications proceeding as to costs alone where a substantive application for some other relief has settled.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrc6QcfJgD3VcA5D9ethRo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrc6QcfJgD3VcA5D9ethRo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R78PKqeEIORKpYVwEfC4aG4"/>
        <rdfs:label>Proxy Vote</rdfs:label>
        <skos:altLabel>Delegated Vote</skos:altLabel>
        <skos:altLabel>Surrogate Voting</skos:altLabel>
        <skos:altLabel>Voting by Proxy</skos:altLabel>
        <skos:definition>A Proxy Vote is a form of voting in which a member of a decision-making body delegates their voting power to a representative to vote in their absence. This mechanism allows for continued representation and participation in the voting process when the original voter cannot be physically present or chooses not to attend a meeting or election.</skos:definition>
        <skos:prefLabel>Delegated Voting Authority</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCrcA3E4DTz5sAKbr4wdxUK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCrcA3E4DTz5sAKbr4wdxUK">
