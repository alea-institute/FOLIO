        <rdfs:label>Retirement Account</rdfs:label>
        <skos:altLabel>401(k)</skos:altLabel>
        <skos:altLabel>Individual Retirement Account</skos:altLabel>
        <skos:altLabel>Pension</skos:altLabel>
        <skos:definition>A Retirement Account is a financial account designed to help individuals save for their retirement, often offering tax advantages. Types of retirement accounts include 401(k)s, Individual Retirement Accounts (IRAs), and pension plans, among others, and they typically come with restrictions on withdrawals to incentivize long-term saving. Relevant to several areas of law (e.g., Bankruptcy Law).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC6xzNNhsMkchuMHEJO73JE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC6xzNNhsMkchuMHEJO73JE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Intermittent Explosive Disorder</rdfs:label>
        <skos:definition>Intermittent Explosive Disorder is characterized by recurrent, impulsive outbursts of aggression or violent behavior that are out of proportion to any external provocation or psychosocial stressors. These outbursts can result in significant damage to property, injury to others, or legal problems and are not attributable to another mental disorder or substance abuse.</skos:definition>
        <skos:prefLabel>Explosive Personality Disorder</skos:prefLabel>
    </owl:Class>
    


