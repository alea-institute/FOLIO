        <rdfs:label>State Court</rdfs:label>
        <skos:altLabel>County Court</skos:altLabel>
        <skos:definition>A State Court is a legal venue that has jurisdiction over cases within a specific state or county.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB7ZOBdc2DtRhkTHUYK7xZ8 -->

