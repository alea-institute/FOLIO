        <rdfs:label>Stock Purchase Agreement</rdfs:label>
        <skos:altLabel>Share Purchase Agreement</skos:altLabel>
        <skos:definition>A Stock Purchase Agreement is a contract between a buyer and a seller that outlines the terms for the purchase and sale of shares (or stock) in a company. This agreement specifies the number of shares being sold, the purchase price per share, representations and warranties of both parties, and other crucial terms and conditions of the sale.</skos:definition>
        <skos:prefLabel>SPA</skos:prefLabel>
    </owl:Class>
    


