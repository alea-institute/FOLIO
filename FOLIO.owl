            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Invoice Description</rdfs:label>
        <skos:altLabel xml:lang="es-es">Descripción de la factura</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Descripción de la factura</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Description de la facture</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Descrição da fatura</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Invoice Description</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechnungsbeschreibung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תיאור חשבונית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चालान विवरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">发票描述</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">請求書の説明</skos:altLabel>
        <skos:definition>A description of the services provided by a lawyer or law firm, included in an invoice for fees charged.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiPQBt7SDRx-w7paviiin9A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiPQBt7SDRx-w7paviiin9A">
