        <skos:altLabel xml:lang="pt-br">Cláusula de taxa de mercado prevalecente</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur geltenden Marktrate</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Prevailing Market Rate Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שער השוק הקיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रबल बाजार दर शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">優勢市場レート条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">盛行市场利率条款</skos:altLabel>
        <skos:definition>A Prevailing Market Rate Clause is a provision in a contract that sets the price or rate for goods or services based on the current market conditions at the time of performance.</skos:definition>
    </owl:Class>
    


