    <!-- https://folio.openlegalstandard.org/R7Mm9Zf0HlgIvCoXnWbJoMX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Mm9Zf0HlgIvCoXnWbJoMX">
