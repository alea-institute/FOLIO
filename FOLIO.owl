        <rdfs:label>South Carolina Supreme Court</rdfs:label>
        <skos:definition>The South Carolina Supreme Court is the highest court in the state of South Carolina, responsible for hearing appeals and making final decisions on legal disputes within the state court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwISw0syjjwmS6UpyiShve -->

