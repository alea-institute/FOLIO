        <skos:altLabel xml:lang="es-es">Aseguradora que suministra defensa en juicio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Assureur fournissant la défense d&apos;une action en justice</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Insurance Carrier Supplying Defence of Suit</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Seguradora fornecendo defesa em processo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versicherungsträger, der die Verteidigung einer Klage bereitstellt</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ספק ביטוח המספק הגנה בתביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बीमा वाहक जो मुकदमे की रक्षा प्रदान करता है</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提供诉讼辩护的保险承运人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴訟の防御を提供する保険業者</skos:altLabel>
        <skos:definition>An Insurance Carrier Supplying Defense of Suit is an insurance claim concept that refers to the situation where an insurance company provides legal defense to its policyholder in a lawsuit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RVoruROtalNTiniXRiHcxG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RVoruROtalNTiniXRiHcxG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>War Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Kriegsklauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de cláusula de guerra</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de cláusula de guerra</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de guerra</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de clause de guerre</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">War Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף מלחמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">युद्ध शर्त दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">战争条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">戦争条項請求</skos:altLabel>
        <skos:definition>A War Clause claim is a legal argument asserting that a particular action or law exceeds the constitutional authority granted to the government in times of war. This claim is based on the interpretation that the War Clause, which grants Congress the power to declare war, also imposes limitations on the government&apos;s actions during war, such as the exercise of certain powers or the infringement of individual rights.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RVoyN9hN3m5gy3So01ZEZ8 -->

