        <skos:altLabel xml:lang="fr-fr">Imprudence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Imprudencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Imprudencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imprudência</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Recklessness</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זיוף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無謀</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">鲁莽行为</skos:altLabel>
        <skos:definition>Recklessness is a legal concept that refers to a state of mind in which a person knowingly takes an unjustifiable risk that results in harm to another person or property.</skos:definition>
    </owl:Class>
    


