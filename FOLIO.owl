            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Proposed Jury Instructions</rdfs:label>
        <skos:altLabel xml:lang="es-es">Instrucciones propuestas al jurado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Instrucciones propuestas al jurado</skos:altLabel>
