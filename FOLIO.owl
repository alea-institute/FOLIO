    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/990h_ZFFS0a_v-bzQ9h8WA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/990h_ZFFS0a_v-bzQ9h8WA">
