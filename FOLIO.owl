    <!-- https://folio.openlegalstandard.org/RCxRAqdifgiYylNnWfEUciy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCxRAqdifgiYylNnWfEUciy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zwKGkogGKIKWSVWb1ItRL"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <dc:description>Motion to consolidate — where a court (e.g., bankruptcy court, civil court) will consider two entities (e.g., companies) as the same entity (e.g., veil piercing).</dc:description>
        <rdfs:label>Motion for Substantive Consolidation</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf materielle Konsolidierung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Consolidación Sustantiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Consolidación Sustantiva</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Substantive Consolidation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de consolidação substantiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en consolidation substantielle</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לכיווץ ממוקד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वास्तविक समेकन के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实体合并动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">実質的統合の申立て</skos:altLabel>
        <skos:definition>A Motion for Substantive Consolidation is a legal request made in a bankruptcy case to combine the assets and liabilities of two or more related entities into a single entity for the purpose of simplifying the administration of the bankruptcy proceedings.</skos:definition>
    </owl:Class>
    


