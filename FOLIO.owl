    <!-- https://folio.openlegalstandard.org/RCL6FYZn8Qt6m4Z71arBnIb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCL6FYZn8Qt6m4Z71arBnIb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R981K5l1Ju5uHj4jVRSUCJQ"/>
        <rdfs:label>Failure to Provide Wage Records Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Nichtvorlage von Lohnunterlagen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Failure to Provide Wage Records Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por falta de entrega de registros salariales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por falta de entrega de registros salariales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de Falha em Fornecer Registros de Salário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation pour non-fourniture de relevés de salaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על חוסר הספקת רשומות שכר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वेतन रिकॉर्ड प्रदान न करने का दावा फेल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未提供工资记录索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">賃金記録提出請求の不履行</skos:altLabel>
        <skos:definition>A failure to provide wage records claim is a legal action brought by an employee against their employer for not complying with the legal obligation to furnish access to or copies of the employee&apos;s wage-related documents. Wage records may include payroll records, pay stubs, and timekeeping data, and the claim typically arises when an employer either refuses or neglects to provide the requested information within the specified time frame mandated by applicable laws.</skos:definition>
        <skos:prefLabel>Pay Stub Violation Claim</skos:prefLabel>
    </owl:Class>
    


