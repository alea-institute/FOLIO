        <rdfs:label>Motion in Limine to Exclude Witness</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss eines Zeugen durch Motion in Limine</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción en Limine para Excluir Testigo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción en Limine para Excluir Testigo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion en limine pour exclure un témoin</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion in Limine to Exclude Witness</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Exclusão de Testemunha por Motion in Limine</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאפשר ראיות בלימיטציה כדי לאפשר הוצאת עד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाह को निकालने के लिए लिमिने में आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除证人的限制性动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証人の排除を求めるリミニングモーション</skos:altLabel>
        <skos:definition>A Motion in Limine to Exclude Witness is a pretrial motion requesting the court to prohibit a specific witness from testifying or presenting evidence at trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9OIzJtfFVfhJJFuIHL0GJr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9OIzJtfFVfhJJFuIHL0GJr">
