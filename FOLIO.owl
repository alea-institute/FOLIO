        <skos:altLabel xml:lang="es-es">Defecto de fabricación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Defecto de fabricación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Defeito de fabricação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Défaut de fabrication</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Herstellungsfehler</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Manufacturing Defect</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגם ייצור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विनिर्माण दोष</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">制造缺陷</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">製造上の欠陥</skos:altLabel>
        <skos:definition>A manufacturing defect is a type of product defect that occurs when a product is not made according to its intended design, resulting in a dangerous or defective product.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7YZiYE6y1mjgMaElmtVAGl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7YZiYE6y1mjgMaElmtVAGl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
        <dc:source rdf:resource="https://www.uscourts.gov/services-forms/bankruptcy/bankruptcy-basics/chapter-11-bankruptcy-basics"/>
        <rdfs:label>Single Asset Real Estate Debtor</rdfs:label>
        <skos:definition>A Single Asset Real Estate Debtor (SARE Debtor) refers to a specific classification in bankruptcy proceedings for debtors whose primary business involves a single real estate property. This classification impacts how bankruptcy cases are handled, particularly by expediting the process and applying unique rules concerning automatic stays and reorganization plans.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7YZtYSCWULuIY1kc2Nn8Dg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7YZtYSCWULuIY1kc2Nn8Dg">
