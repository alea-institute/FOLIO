    <!-- https://folio.openlegalstandard.org/R8M0UJWeEVpeK5gMPLTQSl2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8M0UJWeEVpeK5gMPLTQSl2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
        <rdfs:label>Estate Planning Objectives</rdfs:label>
        <skos:definition>Estate Planning Objectives refer to the goals and purposes that individuals aim to achieve when organizing their assets, properties, and financial affairs for the future distribution upon their death. These objectives ensure the proper management and transfer of wealth, fulfillment of personal wishes, and minimization of taxes and legal complications.</skos:definition>
    </owl:Class>
    


