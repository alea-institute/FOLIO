        <rdfs:label>Foul Ball Liability Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Foul Ball Liability Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsanspruch bei Foul Ball</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de responsabilidad por bola mala</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de responsabilidad por bola sucia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de responsabilidade por bola suja</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de responsabilité pour balle fautive</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת אחריות כדור עקום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फौल बॉल लाभांश दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ファウルボール責任請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">犯规球责任索赔</skos:altLabel>
        <skos:definition>A foul ball liability claim is a legal claim for damages resulting from a personal injury caused by a foul ball at a sporting event.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBULSQ5kkKWLAGpgMIhmjE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBULSQ5kkKWLAGpgMIhmjE">
