        <rdfs:label>Fluid Power Valve and Hose Fitting Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing fluid power valves and hose fittings.</skos:definition>
        <skos:example>Fluid power aircraft subassemblies manufacturing</skos:example>
        <skos:example>Hose assemblies for fluid power systems manufacturing</skos:example>
