        <skos:altLabel xml:lang="zh-cn">预付款条款</skos:altLabel>
        <skos:definition>An upfront payment clause is a provision in a contract that requires a specified amount of money to be paid in advance of the delivery of goods or services.</skos:definition>
    </owl:Class>
    


