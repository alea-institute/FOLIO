        <skos:altLabel xml:lang="pt-br">Autoridade de Proteção de Dados</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Autorité de protection des données</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Data Protection Authority</skos:altLabel>
