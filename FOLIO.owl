    <!-- https://folio.openlegalstandard.org/R8hg3JEhptyxPqtE1M05N2D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hg3JEhptyxPqtE1M05N2D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
        <rdfs:label>Right to be Forgotten</rdfs:label>
        <skos:definition>The &quot;Right to be Forgotten&quot; refers to an individual&apos;s legal ability to request the removal of personal information from digital platforms or search engine results. Originating in the European Union, this right aims to allow people to control their digital footprint by deleting or delisting information that is outdated, irrelevant, or no longer applicable.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hj0gAqtwU7U7DZCh2kEFy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hj0gAqtwU7U7DZCh2kEFy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Lead Warning Statement Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;avertissement au plomb</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Aviso de Chumbo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de advertencia de plomo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de advertencia de plomo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Blei-Warnung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lead Warning Statement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הזהרת עופרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लेड चेतावनी वाक्यांश क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">鉛警告声明条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">铅警告声明条款</skos:altLabel>
        <skos:definition>A Lead Warning Statement Clause is a provision in a contract that requires the disclosure of the presence of lead in a product or property, in order to protect individuals from potential health hazards.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hk4XUNM9YHNxlkeE6izgx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hk4XUNM9YHNxlkeE6izgx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzVJL7xHCPdcNwnHbt71AD"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Reply to Opposition</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antwort auf Widerspruch</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reply to Opposition</skos:altLabel>
