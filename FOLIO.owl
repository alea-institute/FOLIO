        <skos:altLabel xml:lang="pt-br">Representante estrangeiro</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Representante extranjero</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Representante extranjero</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Représentant étranger</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נציג זר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विदेशी प्रतिनिधि</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">外国代表</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">外国代表者</skos:altLabel>
        <skos:definition>A person or body authorized in a foreign proceeding to administer the reorganization or the liquidation of the debtor&apos;s assets or affairs or to act as a representative of such foreign proceeding. 11 U.S.C. § 101(24).</skos:definition>
