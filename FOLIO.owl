        <rdfs:label>New York Style Closing Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de clôture de style New Yorkais</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cierre de estilo neoyorquino</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de cierre de estilo neoyorquino</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de encerramento no estilo Nova York</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">New York Style Closing Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schlussklausel im New Yorker Stil</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף סגירת סגנון ניו יורק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यूयॉर्क स्टाइल क्लोजिंग क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ニューヨーク式クロージング条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">纽约式结尾条款</skos:altLabel>
        <skos:definition>A New York Style Closing Clause is a specific type of contractual clause used in legal agreements that outlines the procedures and requirements for the finalization of the agreement, typically including the location and governing law of the agreement.</skos:definition>
    </owl:Class>
    


