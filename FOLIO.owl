            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>Fed. R. Civ. P. 32</dc:source>
        <dc:source>Fed. R. Civ. P. 43</dc:source>
        <dc:source>Fed. R. Evid. 801(d)(1)</dc:source>
        <dc:source>Fed. R. Evid. 804(b)(1)</dc:source>
        <rdfs:label>Previous Testimony</rdfs:label>
        <skos:altLabel>Prior Sworn Statements</skos:altLabel>
        <skos:definition>Prior Under-Oath Statements are statements made by a witness under oath in a previous legal proceeding or deposition that are admissible as non-hearsay evidence in a current trial or hearing. These statements are considered reliable because they were made under the penalty of perjury and subject to cross-examination at the time they were originally given.</skos:definition>
        <skos:prefLabel>Prior Under-Oath Statements</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9x5QwRGiVmdj639Zj4wz1a -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9x5QwRGiVmdj639Zj4wz1a">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBbKQavNM8iQqNfPu2byT6X"/>
        <rdfs:label>Wild Animal</rdfs:label>
        <skos:altLabel>Untamed Animal</skos:altLabel>
        <skos:altLabel>Wild Creature</skos:altLabel>
        <skos:definition>A Wild Animal is a species that lives and thrives in its natural habitat without direct dependence on or control by humans. These animals have not been domesticated and typically rely on their instincts and the environment to find food, shelter, and survive.</skos:definition>
        <skos:prefLabel>Wildlife</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9x6yqzHQfo3MF4rxIcPupm -->

