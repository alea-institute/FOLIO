    <owl:Class rdf:about="https://folio.openlegalstandard.org/R49sp0iRvML6Mzkr06Bimd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDp8cEr3KYyVDenm1P9ejdx"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
