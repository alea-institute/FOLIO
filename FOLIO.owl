        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7bP5vwpnavvW5pPJutIvq8"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Second-Degree Murder</rdfs:label>
        <skos:altLabel xml:lang="es-es">Asesinato en segundo grado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Assassinato de segundo grau</skos:altLabel>
        <skos:altLabel>Depraved Heart Murder</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Homicidio en segundo grado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Meurtre au deuxième degré</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mord zweiten Grades</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Second-Degree Murder</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רצח ממעולה שנייה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">द्वितीय डिग्री हत्या</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">二度殺人</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">二级谋杀</skos:altLabel>
        <skos:definition>The concept of Second-Degree Murder, also known as Depraved Heart Murder, refers to the intentional killing of another person with malice aforethought, but without premeditation or deliberation, and with a reckless disregard for human life.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7YVt2Lq9xcrk6RYtqLUpD8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7YVt2Lq9xcrk6RYtqLUpD8">
