        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=49221"/>
        <rdfs:label>Local Messengers and Local Delivery</rdfs:label>
        <skos:definition>See industry description for 492210.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rNN_Mmk2RHOBeW_GMZzu2Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rNN_Mmk2RHOBeW_GMZzu2Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/49W_Qx6KT8OCUdWJDhzZmg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=488991"/>
        <rdfs:label>Packing and Crating</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in packing, crating, and otherwise preparing goods for transportation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rO1o5ioaSJqud-xwbyDHqA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rO1o5ioaSJqud-xwbyDHqA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/bkfeXZ0PQWCyiIZgwwoI6Q"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=111130"/>
        <rdfs:label>Dry Pea and Bean Farming</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in growing dry peas, beans, and/or lentils.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rYn97iIQSQScorg_y9i92Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rYn97iIQSQScorg_y9i92Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Ti8xGiWI5NzMSs5upZUo6"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5617"/>
        <rdfs:label>Services to Buildings and Dwellings</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in one of the following: (1) exterminating and pest control services; (2) janitorial services; (3) landscaping services; (4) carpet and upholstery cleaning services; or (5) other services to buildings and dwellings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/r_0raSlyT1OkT-1tMBtKMw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/r_0raSlyT1OkT-1tMBtKMw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/r4ZF6RhKRrWbu1A85GMsdA"/>
