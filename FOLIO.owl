        <rdfs:label>Other Residential Care Facilities</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/hlP_0DTgSJ6CsrJgou1hCg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/hlP_0DTgSJ6CsrJgou1hCg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ac4Hh3usR0SdQ7ST12Vtug"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=624221"/>
        <rdfs:label>Temporary Shelters</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in providing (1) short-term emergency shelter for victims of domestic violence, sexual assault, or child abuse and/or (2) temporary residential shelter for homeless individuals or families, runaway youth, and patients and families caught in medical crises. These establishments may operate their own shelters or may subsidize housing using existing homes, apartments, hotels, or motels.</skos:definition>
    </owl:Class>
    


