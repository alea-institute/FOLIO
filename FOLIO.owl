        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it"/>
        <rdfs:label>General Indemnity Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Allgemeine Haftungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause générale d&apos;indemnisation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización general</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización general</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula geral de indenização</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">General Indemnity Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצויים כללי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य भरपाई शर्त</skos:altLabel>
