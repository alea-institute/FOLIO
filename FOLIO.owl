        <skos:altLabel xml:lang="ja-jp">連絡先情報</skos:altLabel>
        <skos:definition>Contact Information refers to the details of an individual or entity that can be used to communicate with them, including their name, address, phone number, email, and other relevant information.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QGR6XrWipZpr96KLwiBBo -->

