        <skos:altLabel xml:lang="hi-in">एमोर्टिज़ेशन क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">償却条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">摊销条款</skos:altLabel>
        <skos:definition>An amortization clause is a provision in a contract that outlines the schedule and method for paying off a debt over time.</skos:definition>
    </owl:Class>
    


