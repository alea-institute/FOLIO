        <skos:altLabel xml:lang="ja-jp">アラビア語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿拉伯语</skos:altLabel>
        <skos:definition>Arabic (Language) refers to the written or spoken structured system of communication that consists of grammar and vocabulary specific to the Arabic language.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Z1N9HSgc8psAq3zYsdbTK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Z1N9HSgc8psAq3zYsdbTK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Neapolitan</rdfs:label>
