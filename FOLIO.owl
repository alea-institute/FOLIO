        <rdfs:label>Washington Superior Court - Whitman County</rdfs:label>
        <skos:definition>Washington Superior Court - Whitman County is a specific court within the Washington Superior Court system that has jurisdiction over legal matters within Whitman County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfcsZ2JrzHrZiwoKzHGWth -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfcsZ2JrzHrZiwoKzHGWth">
