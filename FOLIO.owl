        <skos:definition>The mishandling of a negotiable instrument by a collecting bank refers to the improper handling or processing of a commercial paper by a financial institution that is collecting payment on behalf of a creditor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFPbgVIG-RW6tmVwmF0evmQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFPbgVIG-RW6tmVwmF0evmQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnHqWL9K7RvKt0cOTLMx3pw"/>
        <rdfs:label>B120 Asset Analysis and Recovery</rdfs:label>
        <skos:definition>Identification and review of potential assets including causes of action and non-litigation recoveries</skos:definition>
        <skos:prefLabel>B120 Asset Analysis and Recovery</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFRAXA0QstPl5fw6Nfmy5v -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFRAXA0QstPl5fw6Nfmy5v">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ZlXt0J1JMbXm6T0xEg2SO"/>
        <rdfs:label>Fixed Rate Dividend Payment</rdfs:label>
        <skos:altLabel>Consistent Income Distribution</skos:altLabel>
        <skos:altLabel>Regular Income Payment</skos:altLabel>
        <skos:altLabel>Stated Income Dividend</skos:altLabel>
        <skos:definition>Fixed Rate Income refers to a type of dividend income where the shareholder periodically receives a predetermined amount. This consistent payment, often tied to preferred shares or bonds, provides predictable returns at regular intervals.</skos:definition>
        <skos:prefLabel>Fixed Dividend Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFRooBMn1RiOw7-Iq01AFjg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFRooBMn1RiOw7-Iq01AFjg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rn5kG4YdbRjOyGEVaUvrizw"/>
        <rdfs:label>P300 Structure/Strategy/Analysis</rdfs:label>
        <skos:definition>Includes time spent in planning the approach to the deal or project. Tasks include all analysis performed for purposes of developing and reassessing the strategy for the project or transaction, and all steps taken to develop a written outline or description of the structure of a transaction or the strategy for a matter (e.g., term sheets) throughout the life of the matter.</skos:definition>
        <skos:prefLabel>P300 Structure/Strategy/Analysis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFWWSd4giBdBsewqPukTnE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFWWSd4giBdBsewqPukTnE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCz0OhGJQscjwPvw2jQBP63"/>
        <rdfs:label>New York City Court - Buffalo</rdfs:label>
        <skos:definition>A court located in Buffalo, New York that is part of the New York City Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFWZoBa6betiXz65GSJKIa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFWZoBa6betiXz65GSJKIa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDQKIyqoXbr8tQZdgClywRf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bona Fide Occupational Qualification</rdfs:label>
        <skos:definition>A Bona Fide Occupational Qualification (BFOQ) is a work qualification that an employer argues is a necessary requirement for a particular job and is thus allowed to be discriminatory in nature. The legality of a BFOQ depends on its reasonableness and necessity for the specific job in question, usually subject to regulatory oversight or judicial review. For example, a job posting for a restaurant server may require applicants to be at least 18 years of age so they can legally serve alcohol. Another example is requiring at least one security hospital treatment assistant assigned to each psychiatric hospital ward to be the same gender as the ward&apos;s patients.</skos:definition>
        <skos:prefLabel>BFOQ</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
        <rdfs:label>Provisional Remedies</rdfs:label>
        <skos:altLabel xml:lang="es-es">Medidas Provisionales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Medidas Provisionales</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Provisional Remedies</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">mesures provisoires</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">remédios provisórios</skos:altLabel>
        <skos:altLabel xml:lang="de-de">vorläufige Maßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צווי מתקן זמני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अस्थायी उपाय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">临时救济措施</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">仮処分</skos:altLabel>
        <skos:definition>Provisional Remedies are temporary legal measures sought by a party in a civil matter to preserve the status quo or prevent irreparable harm until a final decision is made.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFYLTPZWRREWDLqyzEXfv3A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFYLTPZWRREWDLqyzEXfv3A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnTEPb_LCSNqAkQqrfte8zg"/>
        <rdfs:label>A121 Review and Analysis</rdfs:label>
        <skos:definition>For discovery and eDiscovery, the inspection, review, consideration and analysis of documents and/or evidence. Includes coding and relevance issues. Excludes creation of privilege log (A124 ).</skos:definition>
        <skos:prefLabel>A121 Review and Analysis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFaPio4mlb48F4I6Jc9bTq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFaPio4mlb48F4I6Jc9bTq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq7yrbwVSqS8fuRtnzDx6g"/>
