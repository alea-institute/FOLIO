        <skos:altLabel xml:lang="es-es">Definición de &quot;Información Confidencial&quot; - Excepciones - Conocida antes del Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de &quot;Información Confidencial&quot; - Excepciones - Conocida antes del Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition von &quot;Vertraulichen Informationen&quot; - Ausnahmen - Vor der Vereinbarung bekannt</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de &quot;Informações Confidenciais&quot; - Exceções - Conhecido antes do acordo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition des &quot;Informations confidentielles&quot; - Exceptions - Connu avant l&apos;accord</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת &quot;מידע סודי&quot; - יוצאים מן הכלל - ידוע לפני ההסכם</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLOT3utnNtA6pYPhY1sHFH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLOT3utnNtA6pYPhY1sHFH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RB7pLfw7zqXtd20kKg7EcOA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBYHspF2cClL6YzpLgQJNTG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
        <rdfs:label>Governance Risk</rdfs:label>
        <skos:altLabel>Strategic Direction Risk</skos:altLabel>
        <skos:definition>Governance Risk refers to the potential for negative consequences arising from an organization&apos;s ineffective or inadequate leadership, decision-making processes, and oversight structures. This can result from poor corporate governance practices, lack of transparency, or weak accountability mechanisms, ultimately leading to reputational damage, legal liabilities, and decreased stakeholder trust, which can impact the organization&apos;s performance and sustainability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLPMwzuV84x8PFhF6job2z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLPMwzuV84x8PFhF6job2z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Jasper County</rdfs:label>
        <skos:definition>Georgia Superior Court - Jasper County is a specific court within the Georgia Superior Court system that has jurisdiction over legal matters within Jasper County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLTVGCX2MXs6r6lNqrty9W -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLTVGCX2MXs6r6lNqrty9W">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
        <rdfs:label>Adultery</rdfs:label>
        <skos:altLabel xml:lang="es-es">Adulterio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Adulterio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Adulterio</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Adultery</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Adultère</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ehebruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניאוף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यभिचार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">姦通</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">通奸</skos:altLabel>
        <skos:definition>Voluntary sexual intercourse between a married person and someone who is not their spouse, which is considered as a ground for divorce.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLVFHgBAS4JQ5REt2ZtLi7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLVFHgBAS4JQ5REt2ZtLi7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Generalized Anxiety Disorder</rdfs:label>
        <skos:altLabel>Chronic Anxiety</skos:altLabel>
        <skos:altLabel>GAD</skos:altLabel>
        <skos:definition>Generalized Anxiety Disorder (GAD) is a mental health condition characterized by persistent and excessive worry about various aspects of life, such as work, health, and social interactions, that is difficult to control. This anxiety is often accompanied by physical symptoms such as restlessness, fatigue, difficulty concentrating, irritability, muscle tension, and sleep disturbances.</skos:definition>
        <skos:prefLabel>Anxiety Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLVY0zljWHvn7aUS7BnomS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLVY0zljWHvn7aUS7BnomS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
        <rdfs:label>Setoff</rdfs:label>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Compensación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Compensación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Setoff</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סטאף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेटऑफ</skos:altLabel>
        <skos:definition>A setoff in bankruptcy refers to the right of a creditor to offset a debt owed to them by the debtor against a debt owed by the creditor to the debtor, thereby reducing the amount owed by the creditor to the debtor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLW2BanodMnM0GMfcnnnoG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLW2BanodMnM0GMfcnnnoG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDrgrPYJPo0Rj0YG5xJ2OMX"/>
        <rdfs:label>Data Architecture Management</rdfs:label>
        <skos:altLabel>Data Extraction Management</skos:altLabel>
        <skos:definition>Data Architecture Management involves organizing the data extraction, planning, design, and implementation of policies, structures, and processes that govern the organization, storage, and accessibility of data within an enterprise, ensuring data integrity, consistency, and efficient use across various applications and systems.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLYLKMD32yWd9Wva6rGSya -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLYLKMD32yWd9Wva6rGSya">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RS1hG7BxbLQktXIrO1Rro"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9Ictcp1iwOnYdrf1bxOTVA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Applicant</rdfs:label>
        <skos:definition>A Regulatory Applicant is an individual or entity that applies for authorization, licensing, or compliance approval from a regulatory authority. This role relates to sectors where operations are subject to legal and regulatory standards, ensuring adherence to established laws, guidelines, and norms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLZGpqZWNsC7t5snIPmgoK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLZGpqZWNsC7t5snIPmgoK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8HLLl44Pya8Fp0uN3ewKRW"/>
        <rdfs:label>Clause Bank Management</rdfs:label>
        <skos:definition>Clause Bank Management refers to the process of organizing and maintaining a repository of standardized legal clauses for efficient retrieval and use in legal documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLodGElBPA4tNq7xpjKA5l -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLodGElBPA4tNq7xpjKA5l">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xoAbLw9cOhM7q4iRXRmXu"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCoOnTANPIS6LCYx2SVkLJL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Commission</rdfs:label>
        <skos:definition>A commission is an authoritative body formed by a government or other organization to oversee, manage, and regulate specific activities or issues. Commissions can vary widely in scope, such as city commissions for local governance, the European Commission for regional policy and law, or commissions on human rights to oversee and promote human rights protections.</skos:definition>
        <skos:example>City Commission: City of Los Angeles Planning Commission</skos:example>
        <skos:example>Commission on Human Rights: United Nations Human Rights Commission</skos:example>
        <skos:example>EU Commission: European Commission</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLsm4yCq8zn36DUl8PxkaC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLsm4yCq8zn36DUl8PxkaC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ffI3iiU2HojmiTTtoGwZP"/>
        <rdfs:label>Motion for Relief due to Fraud, Misrepresentation, or Other Misconduct</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Erleichterung wegen Betrug, Falschdarstellung oder anderem Fehlverhalten</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Alivio debido a Fraude, Representación Falsa u Otra Mala Conducta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Alivio debido a Fraude, Representación Falsa u Otra Mala Conducta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Relief due to Fraud, Misrepresentation, or Other Misconduct</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Alívio devido a Fraude, Representação Falsa ou Outra Má Conduta</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue d&apos;une mesure de soulagement en raison de la fraude, de la représentation trompeuse ou d&apos;autres actes répréhensibles</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לסיוע עקב מרמה, מיצול או התנהגות לא תקינה אחרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">धोखाधड़ी, भ्रमण या अन्य दुराचार के कारण राहत के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因欺诈、误导或其他不当行为而提出的救济动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">詐欺、虚偽陳述、またはその他の不正行為に基づく救済の申立て</skos:altLabel>
        <skos:definition>A Motion for Relief due to Fraud, Misrepresentation, or Other Misconduct is a legal request made to a court to set aside a previous order or judgment based on the opposing party&apos;s fraudulent, misleading, or wrongful actions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLtTa9apXmqCQW13JYq0xb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLtTa9apXmqCQW13JYq0xb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  Lawrence County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Lawrence County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering legal proceedings in Lawrence County, Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBLzDQdY5M3AjVUpILnB95K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBLzDQdY5M3AjVUpILnB95K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sHH7RvjZ6aZS7ZExDpYmR"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8ASw8Dgh6TE62ku8oMci5u"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDETD6YVYGhLGZbM1fBnsfj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source rdf:resource="http://publichealth.lacounty.gov/sapc/NetworkProviders/pm/082818/TypesofDisabilities.pdf"/>
        <rdfs:label>Disability</rdfs:label>
        <skos:altLabel xml:lang="de-de">Behinderung</skos:altLabel>
        <skos:altLabel>Chronic Health Condition</skos:altLabel>
        <skos:altLabel>Critical Health Condition</skos:altLabel>
        <skos:altLabel>Critical Illness</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Deficiência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Handicap</skos:altLabel>
        <skos:altLabel>Major Medical Condition</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">残疾</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">障害</skos:altLabel>
        <skos:definition>Disability refers to a physical, mental, or sensory impairment that significantly limits one or more major life activities, such as walking, speaking, learning, or working. Disabilities can be congenital or acquired, temporary or permanent, and vary in severity. Various laws, such as the Americans with Disabilities Act (ADA) in the United States, protect individuals with disabilities from discrimination and ensure they have equal access to opportunities, services, and accommodations.</skos:definition>
        <skos:prefLabel>Severe Health Condition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBM2snOfHOGu50QMiZ0LoiS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBM2snOfHOGu50QMiZ0LoiS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
        <rdfs:label>Advice &amp; Consent Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Advice &amp; Consent Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Anspruch auf Beratung und Zustimmungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Consejo y Consentimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Consejo y Consentimiento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Conselho e Consentimento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la clause de conseil et de consentement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף ייעוץ והסכמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सलाह और सहमति धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">助言と同意条項の主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">建议和同意条款索赔</skos:altLabel>
        <skos:definition>An Advice &amp; Consent Clause claim is a legal argument asserting that a particular appointment or nomination made by a government official violates the Advice and Consent Clause of the United States Constitution. This claim contends that the appointment or nomination was made without obtaining the necessary advice and consent of a legislative body, typically the Senate, as required by the constitutional provision.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBM3IlVpCVJe1AEljn6qhMC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBM3IlVpCVJe1AEljn6qhMC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ddsah86bL3tQ5OmO9B7PB"/>
        <rdfs:label>Intercreditor Agreement</rdfs:label>
        <skos:definition>An &quot;Intercreditor Agreement&quot; is a contract between two or more creditors that establishes the hierarchy and relationship of their claims against a common debtor. The agreement sets forth the rules and procedures for the distribution of assets and proceeds in the event of the debtor&apos;s default, bankruptcy, or insolvency.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBM7m2NWy0l60MBP1PLR5jC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBM7m2NWy0l60MBP1PLR5jC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Mentasta Traditional Council</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMGeeCqVcw648c4O0wX5Xk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBMGeeCqVcw648c4O0wX5Xk">
