        <skos:altLabel xml:lang="en-gb">Tax on Tax</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Taxe sur la taxe</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מס על מס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टैक्स ऑन टैक्स</skos:altLabel>
