        <rdfs:label>Armed Forces Branch</rdfs:label>
        <skos:altLabel>Defense Branch</skos:altLabel>
        <skos:altLabel>Defense Forces</skos:altLabel>
        <skos:altLabel>Military Branch</skos:altLabel>
        <skos:altLabel>Military Forces</skos:altLabel>
        <skos:altLabel>Military Services</skos:altLabel>
        <skos:definition>The Armed Forces Branch is a division of the government responsible for national defense and military operations. It encompasses all military branches, including the army, navy, air force, and other specialized units, ensuring the protection and security of the nation.</skos:definition>
        <skos:prefLabel>National Defense Forces</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBcgw1OPn4i0DV0T1CHT7Mh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBcgw1OPn4i0DV0T1CHT7Mh">
