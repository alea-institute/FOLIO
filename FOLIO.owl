        <skos:altLabel xml:lang="es-mx">Negligencia Contributiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência contributiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence contributive</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה תורמת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">योगदानी लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">責任割合</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过失责任</skos:altLabel>
        <skos:definition>Contributory Negligence: A legal defense that asserts that the plaintiff&apos;s own negligence contributed to their injury or damages, and therefore the defendant should not be held fully liable.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwajUPdKVdK5tlwiUjmNzG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwajUPdKVdK5tlwiUjmNzG">
