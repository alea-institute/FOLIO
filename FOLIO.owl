        <rdfs:label>Massachusetts Trial Court - Land Court Department</rdfs:label>
        <skos:definition>The Massachusetts Trial Court - Land Court Department is a specialized division within the Massachusetts Trial Court that handles cases related to real property disputes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rad9U0Bfny1ljSqwlvCR6Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rad9U0Bfny1ljSqwlvCR6Y">
