    <!-- https://folio.openlegalstandard.org/R90hDqtGq4sBS04uYFa8mOL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R90hDqtGq4sBS04uYFa8mOL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCuhulltRlDN8kiH5sooyW9"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/4.00-Cardiovascular-Adult.htm#4_06"/>
        <rdfs:label>Congenital Heart Defects</rdfs:label>
        <skos:altLabel>Congenital Heart Conditions</skos:altLabel>
        <skos:definition>Symptomatic congenital heart disease refers to structural heart defects present from birth that cause significant clinical symptoms. Cyanotic congenital heart disease is characterized by reduced oxygenation of blood leading to a bluish tint to the skin, lips, and nails, while acyanotic congenital heart disease involves structural defects that do not cause significant oxygenation issues but still result in symptoms such as heart failure or arrhythmias. Both types require medical intervention, often including surgical correction or ongoing management to address symptoms and improve heart function.</skos:definition>
        <skos:prefLabel>Symptomatic Congenital Heart Disease (Cyanotic or Acyanotic)</skos:prefLabel>
    </owl:Class>
    


