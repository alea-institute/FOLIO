        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=71219"/>
        <rdfs:label>Nature Parks and Other Similar Institutions</rdfs:label>
        <skos:definition>See industry description for 712190.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/VOQk8E3iRPaJ7ty0sc97lg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/VOQk8E3iRPaJ7ty0sc97lg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/S0aqiIi5Q4WHMwEpiXDtkA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33391"/>
        <rdfs:label>Pump and Compressor Manufacturing</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in manufacturing pumps and compressors, such as general purpose air and gas compressors, nonagricultural spraying and dusting equipment, general purpose pumps and pumping equipment (except fluid power pumps and motors), and measuring and dispensing pumps.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/VTSwvHqcTzeX8EE3yeTabA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/VTSwvHqcTzeX8EE3yeTabA">
