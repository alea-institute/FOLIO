        <skos:altLabel xml:lang="zh-cn">公平代位权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正代位</skos:altLabel>
        <skos:definition>Equitable subrogation is a legal claim that allows a party to step into the shoes of another party in order to enforce a right or claim, typically in the context of a mortgage or other financial transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R2zIFoRDAa7bSpXzJXOD7a -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R2zIFoRDAa7bSpXzJXOD7a">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJPmwN3dU0x1Hk5Wgu3Bnx"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motion to Expedite Case</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf beschleunigtes Verfahren</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Acelerar el Caso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Acelerar el Caso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Expedite Case</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de aceleração do processo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en accélération de la procédure</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לזריקת מקרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मामले को त्वरित करने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加快案件审理的动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">速やかな事件処理の申立て</skos:altLabel>
        <skos:definition>A Motion to Expedite Case is a request made to a court to accelerate the proceedings of a legal case, typically due to urgent circumstances or the need for a prompt resolution.</skos:definition>
    </owl:Class>
    


