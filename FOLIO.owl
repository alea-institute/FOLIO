        <skos:altLabel xml:lang="fr-fr">défendeur tiers</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">réu de terceira parte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נאשם מצד שלישי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तीसरी पक्ष का दावेदार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">第三方被告</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第三者被告</skos:altLabel>
        <skos:definition>A party who was not initially sued but is brought into a civil action by another defendant.</skos:definition>
    </owl:Class>
    


