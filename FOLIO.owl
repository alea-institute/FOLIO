            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9tZFXPrXQJWHbqSgtCQxJF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCnTNVCQ1VndGxskbMoaLr8"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Deposition Practice</rdfs:label>
        <skos:altLabel>Depositions</skos:altLabel>
        <skos:altLabel>Deposition</skos:altLabel>
        <skos:altLabel>Deposition Service</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Aussagepraxis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Deposition Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de la déposition</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de deposición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de deposición</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de depoimento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול הפגיעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाही अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言の実践</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">证言实践</skos:altLabel>
        <skos:definition>Deposition Practice refers to the legal process of obtaining sworn testimony from a witness outside of court, typically conducted in a lawyer&apos;s office or other location, as part of the discovery process in a legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDrOf3SHxglDoN9i4Olpb49 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDrOf3SHxglDoN9i4Olpb49">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCmRk3EfXQDL2eFl0x659PQ"/>
        <rdfs:label>Managing Member</rdfs:label>
        <skos:definition>A managing member is an individual or entity responsible for the day-to-day operations and decision-making of an organization. This role includes overseeing business activities, making strategic decisions, and ensuring compliance with legal and regulatory requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDrZfl9rDyGVk1ikSmx5TRd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDrZfl9rDyGVk1ikSmx5TRd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t5CSqYvG6L6Cl86vQeMRA"/>
        <rdfs:label>Sale of Personal Property</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Sale of Personal Property</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Venda de propriedade pessoal</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Venta de Bienes Personales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Venta de Bienes Personales</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vente de biens personnels</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verkauf von persönlichem Eigentum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מכירת נכסים אישיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यक्तिगत संपत्ति की बिक्री</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">个人财产出售</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">個人財産の売却</skos:altLabel>
        <skos:definition>The sale of personal property refers to the transfer of ownership of tangible items that are not considered goods under the law, such as vehicles or furniture, in exchange for payment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDrbY6MeW8iV9jZP5QxI6Vg -->

