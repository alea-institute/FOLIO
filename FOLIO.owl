        <skos:altLabel xml:lang="fr-fr">Islandais</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Islandês</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Isländisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アイスランド語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">冰岛语</skos:altLabel>
        <skos:definition>Icelandic (Language) is a structured system of communication consisting of grammar and vocabulary used in Iceland and by Icelandic speakers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72p6HAKCuvyIWvgxuoCM9R -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72p6HAKCuvyIWvgxuoCM9R">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGOU62BPz1QTVsWRE2Nodz"/>
        <rdfs:label>Employment Hierarchical Role</rdfs:label>
        <skos:definition>Employment Hierarchical Role refers to an employee&apos;s position within the organizational structure in terms of authority and responsibility. Common hierarchical roles include managers, who have oversight and decision-making responsibilities for a team, and individual contributors, who are subject matter experts or skilled workers that focus on executing specific tasks without direct managerial duties.</skos:definition>
    </owl:Class>
    


