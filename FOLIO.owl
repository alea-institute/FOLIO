        <skos:altLabel xml:lang="fr-fr">Moksha</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Moksha</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">モクシャ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">莫克沙</skos:altLabel>
        <skos:definition>A language spoken by the Moksha people, who reside primarily in the Mordovia region of Russia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCedm84EEdwbf9nS0mguG2r -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCedm84EEdwbf9nS0mguG2r">
