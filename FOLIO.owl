        <rdfs:label>PA100 Assessment, Development, and Administration</rdfs:label>
        <skos:definition>All actions to investigate and understand the facts of a matter that are not included under another patent task code below. Covers interviews of client personnel and potential witnesses, review of documents to learn the facts of a potential case, work with an investigator, and all related communications and correspondence.</skos:definition>
        <skos:prefLabel>PA100 Assessment, Development, and Administration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RS4MNLzEw9KGWGaiRAbgdF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RS4MNLzEw9KGWGaiRAbgdF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo"/>
        <rdfs:label>Governmental Branch</rdfs:label>
        <skos:definition>The branches of government typically refer to the three main divisions of a democratic system: the legislative, which makes laws; the executive, which enforces and administers laws; and the judicial, which interprets laws. These branches are designed to balance power and ensure that no single entity has unchecked authority.</skos:definition>
        <skos:prefLabel>Branches of Government</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RS51XczTItzSjgT9JkLt0N -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RS51XczTItzSjgT9JkLt0N">
