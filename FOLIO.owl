        <rdfs:label>Penalty Proceeding</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Penalty Proceeding</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Procedimiento de sanción</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Procedimiento sancionador</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Processo penal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Procédure pénale</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafverfahren</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הליך עונש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जुर्माना प्रक्रिया</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">处罚程序</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">罰則手続き</skos:altLabel>
        <skos:definition>A penalty proceeding is a legal process that deals specifically with the determination and imposition of punishment for a criminal offense.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9H8B4LW9PpywsdO2cXejL9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9H8B4LW9PpywsdO2cXejL9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mCB7w7tqtq6yOWvTxdMJI"/>
        <rdfs:label>Broadcast Timing Attributes</rdfs:label>
        <skos:definition>Broadcast Timing Attributes refer to the characteristics that define the timing of broadcast transmissions, distinguishing between content that is delivered in real-time and content that is pre-recorded and scheduled for later playback. These attributes categorize broadcasts into synchronous (live) and asynchronous (pre-recorded) transmissions.</skos:definition>
        <skos:prefLabel>Broadcast Temporal Characteristics</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9H9OMSGtJ376F4xzlqj2js -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9H9OMSGtJ376F4xzlqj2js">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgLz1KvQn0YL8W61rW55T4"/>
        <rdfs:label>Separated</rdfs:label>
        <skos:altLabel xml:lang="de-de">Getrennt</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Separado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Séparé</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分离的</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">分離された</skos:altLabel>
        <skos:definition>Separated (Marital Status) refers to the legal status of a married couple who are no longer living together but have not yet obtained a divorce.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9H9PP0j1qzvD6sNKqKyOj -->

