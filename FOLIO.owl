        <rdfs:label>Potter Valley Tribe</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jtlY9NSkzZRtDZ9hi8kmo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jtlY9NSkzZRtDZ9hi8kmo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBpPod3eNjfLujqcKrmjwq9"/>
        <rdfs:label>Output VAT Payment</rdfs:label>
        <skos:altLabel>Output Tax Liability</skos:altLabel>
        <skos:altLabel>Sales VAT Remittance</skos:altLabel>
        <skos:definition>Output VAT Payment refers to the Value Added Tax that a business collects on its sales of goods and services. This tax is remitted to the government after offsetting any Input VAT, ensuring businesses pay VAT only on the value they add to the products or services.</skos:definition>
        <skos:prefLabel>Collected VAT</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7juUYCtcikW9oVDhveMI9B -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7juUYCtcikW9oVDhveMI9B">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Shoshone-Bannock Tribes of the Fort Hall Reservation</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7juZBFldeVCsMpLJyIHb65 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7juZBFldeVCsMpLJyIHb65">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UmIB7M3FM4ZjzKbv8zbId"/>
        <rdfs:label>Zoning Text Amendments</rdfs:label>
        <skos:altLabel>Land Use Rule Changes</skos:altLabel>
        <skos:definition>Zoning Text Amendments refer to the changes made to the written regulations and ordinances that define how the land within different zones can be used. These changes can clarify ambiguities, address new development challenges, or enact new policies, and typically require legal review, public hearings, and governmental approvals.</skos:definition>
        <skos:prefLabel>Zoning Ordinance Modifications</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jznsnDisXUBLl8zmD6Rpw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jznsnDisXUBLl8zmD6Rpw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wLLoc6H1zcuVpchb4e5lQ"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Appellate Letter</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Appellate Letter</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Berufungsschreiben</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Carta de apelación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Carta de apelación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Carta de apelação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lettre d&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מכתב ערעור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपीलीय पत्र</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">上诉信</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴状</skos:altLabel>
        <skos:definition>An appellate letter is a written communication submitted to a higher court requesting review of a lower court&apos;s decision, and is a type of correspondence and form used in the appellate filing process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7k5Q5GFMsBxvwsafNHmfRF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7k5Q5GFMsBxvwsafNHmfRF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3AhgdKfrmjLxAZBerfsNx"/>
        <rdfs:label>Business Division</rdfs:label>
        <skos:definition>A Business Division is a large organizational unit within a company that operates somewhat independently, often with its own profit and loss responsibility. It typically focuses on a distinct product line or market segment and may contain multiple departments or business units to support its specific objectives and operations</skos:definition>
        <skos:definition>Division</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7k6qutnbtSRZGU365gmGoU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7k6qutnbtSRZGU365gmGoU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC339aKhjRAuw4JtEQUn5xw"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUM0A3dwvk0A2dp3WHxNrj"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rj3K3GgCUDFW3WWZSB8nsL"/>
        <rdfs:label>Motion for Judgment on the Pleadings</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Entscheidung gemäß Aktenlage</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Fallo sobre el Escrito de Demanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Fallo sobre la Demanda</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Judgment on the Pleadings</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de julgamento com base nos autos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en jugement sur pièces</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין על הטענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्लीडिंग्स पर फैसले के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">口头辩论判决动议书</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴状に基づく判決の申立て</skos:altLabel>
        <skos:definition>A Motion for Judgment on the Pleadings is a type of dispositive motion that asks the court to make a decision based solely on the pleadings and without the need for a trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kAJqaeA8gnA875Kf7OAjH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kAJqaeA8gnA875Kf7OAjH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
        <rdfs:label>INVOICE_TAX_TOTAL</rdfs:label>
        <skos:definition>The concept of INVOICE_TAX_TOTAL refers to the total amount of taxes charged on an invoice, as defined in the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
        <rdfs:label>Transaction Negotiation Dynamics</rdfs:label>
        <skos:altLabel>Transactional Bargaining Dynamics</skos:altLabel>
        <skos:definition>Transaction negotiation dynamics refer to the processes and interactions involved in negotiating the terms and conditions of a business transaction between parties. These dynamics encompass various strategies, styles, and behaviors that influence the negotiation&apos;s outcome, including the degree of cooperation, conflict, and communication between the parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kEQs8nPyKBBxFAviIIqAG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kEQs8nPyKBBxFAviIIqAG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rnaTadzLe6EuX6FHVxEvF"/>
        <rdfs:label>Bankruptcy Schedule - Expenses</rdfs:label>
        <skos:altLabel>Expenditure Disclosure</skos:altLabel>
        <skos:altLabel>Expenditure Schedule</skos:altLabel>
        <skos:altLabel>Expense Statement</skos:altLabel>
        <skos:altLabel>Insolvency Expense List</skos:altLabel>
        <skos:altLabel>Monthly Expense Disclosure</skos:altLabel>
        <skos:definition>Bankruptcy Schedule - Expenses, also known as Schedule J, requires the debtor to list all monthly living expenses, including housing, utilities, food, transportation, and other necessary costs. This schedule provides a detailed account of the debtor&apos;s expenditure, helping the court and creditors understand the debtor&apos;s financial obligations and capacity for debt repayment.</skos:definition>
        <skos:prefLabel>Schedule J</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kHYs11J8l4dSYYQ0lreI3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kHYs11J8l4dSYYQ0lreI3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Visa for Specialty Occupation Workers from Australia</rdfs:label>
        <skos:altLabel xml:lang="en-us">E-3 Visa</skos:altLabel>
        <skos:definition>The visa for Specialty Occupation Workers from Australia, commonly known as the E-3 visa in the United States, is a special work visa category that allows Australian nationals to work in a &quot;specialty occupation&quot; in the U.S. A &quot;specialty occupation&quot; is generally defined as a role requiring a bachelor&apos;s degree or higher in a specific field, and the visa is subject to annual numerical limitations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kIfSMkScq8I2fd0uHbXvp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kIfSMkScq8I2fd0uHbXvp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGOU62BPz1QTVsWRE2Nodz"/>
        <rdfs:label>Employment Geographic Location</rdfs:label>
        <skos:definition>Employment Geographic Location refers to the physical or virtual place where an employee performs their job duties, which can range from a specific city, state, or country to a remote setting. This location often has implications for taxation, labor laws, and eligibility for location-based benefits or allowances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kN5KCiAgzW39mOGpqi0eR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kN5KCiAgzW39mOGpqi0eR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Chickahominy Indian Tribe</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7kNKsqAs0ItHwKhey9rR58 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7kNKsqAs0ItHwKhey9rR58">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7J7NYI0WlIIflyMEgnXHIq"/>
        <rdfs:label>Buyer Consent Not Unreasonably Withheld</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Buyer Consent Not Unreasonably Withheld</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Consentement de l&apos;acheteur non raisonnablement refusé</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Consentimento do comprador não razoavelmente retido</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Consentimiento del comprador no retenido de manera irrazonable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Consentimiento del comprador no retenido de manera irrazonable</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Käufer-Einwilligung nicht unangemessen verweigert</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכמת הקונה לא תימנע באופן בלתי סביר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार की सहमति अनुचित रूप से नहीं रोकी जानी चाहिए</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方同意不得不合理地拒绝</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手の同意が合理的に拒否されない</skos:altLabel>
        <skos:definition>The concept of &quot;Buyer Consent Not Unreasonably Withheld&quot; refers to the requirement that a buyer&apos;s consent must be obtained before a certain action can be taken, but the buyer cannot unreasonably withhold their consent.</skos:definition>
    </owl:Class>
    


