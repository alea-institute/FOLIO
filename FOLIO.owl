        <skos:altLabel xml:lang="es-es">Infracción de patentes - Patentes de plantas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Infracción de patentes - Patentes de plantas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Patent Infringement - Plant Patents</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Patentverletzung - Pflanzenpatente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de patente - Patentes de plantas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת פטנט - פטנטי צמחים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पेटेंट उल्लंघन - प्लांट पेटेंट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专利侵权 - 植物专利</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">特許侵害 - 植物特許</skos:altLabel>
        <skos:definition>The unauthorized use, sale, or importation of a patented plant variety without the owner&apos;s permission.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJrrXlPFFEEesmT50PWgqA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJrrXlPFFEEesmT50PWgqA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Accrued Rights Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Accrued Rights Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de droits acquis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de derechos acumulados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de derechos acumulados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de direitos acumulados</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu aufgelaufenen Rechten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכויות מצטברות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एक्रू राइट्स क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">应计权利条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">発生済権利条項</skos:altLabel>
        <skos:definition>An Accrued Rights Clause is a provision in a contract that ensures the preservation of rights that have already been acquired by the parties involved, even if the contract is terminated or modified.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJvItAmZFV8Dj3T9Vxxns6 -->

