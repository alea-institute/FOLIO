        <skos:altLabel xml:lang="es-es">Intentado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Intentado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tentativa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tentative</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versuch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניסיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रयास किया गया</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">未遂</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未遂的</skos:altLabel>
        <skos:definition>An action taken with the intention of committing a crime, but which ultimately fails to achieve its intended result.</skos:definition>
        <skos:example>Attempted Arson</skos:example>
        <skos:example>Attempted Bribery</skos:example>
        <skos:example>Attempted Burglary</skos:example>
        <skos:example>Attempted Murder</skos:example>
    </owl:Class>
    


