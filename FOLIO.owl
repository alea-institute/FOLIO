        <skos:altLabel xml:lang="fr-fr">Industrie des services juridiques</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de serviços jurídicos</skos:altLabel>
        <skos:altLabel>Legal Services</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Legal Services Industry</skos:altLabel>
