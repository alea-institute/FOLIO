    <!-- https://folio.openlegalstandard.org/RXhRW62NYQ5imtM7qjDgH0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RXhRW62NYQ5imtM7qjDgH0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
        <rdfs:label>Homeowners Association Forclosure</rdfs:label>
        <skos:definition>Homeowners Association Foreclosure is the legal process by which a Homeowners Association (HOA) takes possession of a property within its jurisdiction due to the homeowner&apos;s failure to pay association fees or fines. The property is subsequently sold to satisfy the outstanding debt, and the process is governed by state laws and the HOA&apos;s governing documents.</skos:definition>
        <skos:prefLabel>HOA Foreclosure</skos:prefLabel>
    </owl:Class>
    


