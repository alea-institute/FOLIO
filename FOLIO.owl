    <!-- https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC9rPAii8f99I7p4Hi5Qdia"/>
        <rdfs:label>Speech Disability</rdfs:label>
        <skos:altLabel>Speech Communication Disorder</skos:altLabel>
        <skos:altLabel>Speech Deficit</skos:altLabel>
        <skos:altLabel>Speech Disorder</skos:altLabel>
        <skos:altLabel>Speech Impairment</skos:altLabel>
        <skos:altLabel>Verbal Communication Disability</skos:altLabel>
        <skos:definition>Speech Disability refers to impairments that affect an individual&apos;s ability to produce sounds that create words, impacting verbal communication. These disabilities can result from various causes, such as neurological disorders, physical impairments, or developmental conditions, and may affect articulation, fluency, voice, or resonance.</skos:definition>
    </owl:Class>
    


