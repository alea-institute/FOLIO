        <rdfs:label>&quot;Material Adverse Effect&quot; Definition - Exceptions - Failure to Meet Projections</rdfs:label>
        <skos:altLabel xml:lang="en-gb">&quot;Material Adverse Effect&quot; Definition - Exceptions - Failure to Meet Projections</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">&quot;मद्दी अवधारणा&quot; परिभाषा - अपवाद - प्रोजेक्शन का असफलता</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Definición de &quot;Efecto Adverso Material&quot; - Excepciones - Incumplimiento de Proyecciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de &quot;Efecto Adverso Material&quot; - Excepciones - Incumplimiento de Proyecciones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Exceções - Falha em atender às projeções</skos:altLabel>
