        <skos:altLabel xml:lang="pt-br">Cláusula de alteração</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Änderungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הזמנת שינויים</skos:altLabel>
