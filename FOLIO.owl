    <!-- https://folio.openlegalstandard.org/RCVddRYkryBzCKQd9n4A4mP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCVddRYkryBzCKQd9n4A4mP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBU9zZzHpiivyY3EFmul3Ja"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Borderline Intellectual Functioning</rdfs:label>
        <skos:altLabel>Borderline Cognitive Functioning</skos:altLabel>
        <skos:altLabel>Borderline Intellectual Capacity</skos:altLabel>
        <skos:definition>Borderline Intellectual Functioning is characterized by an IQ score that is above the range for intellectual disability but significantly below average. Individuals with this condition may experience difficulties with cognitive tasks and adaptive functioning, but their challenges are not severe enough to qualify as an intellectual disability.</skos:definition>
    </owl:Class>
    


