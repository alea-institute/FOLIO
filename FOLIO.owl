            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>UTBMS MA00 Preliminary Matters</rdfs:label>
        <skos:definition>UTBMS MA00 Preliminary Matters refers to the initial legal matters that need to be addressed in a merger or acquisition, as classified under the UTBMS Mergers and Acquisitions code set.</skos:definition>
    </owl:Class>
    


