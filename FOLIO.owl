    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLcSDERYA3ASx8GMSI9NlF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLcSDERYA3ASx8GMSI9NlF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
        <rdfs:label>Standing</rdfs:label>
        <skos:altLabel xml:lang="es-es">Falta de legitimación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta de legitimación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lack of Standing</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר זכות עמידה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खड़े होने की कमी</skos:altLabel>
        <skos:definition>Lack of Standing: A defense raised in a civil lawsuit where the plaintiff does not have the legal right to bring the claim because they are not directly affected or harmed by the defendant&apos;s actions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLeoyLBvoSHSI4IT2hjuCgA -->

