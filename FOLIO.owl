        <skos:altLabel xml:lang="fr-fr">Violation de la confidentialité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de confidencialidade</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת סודיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विश्वासघात</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">機密漏洩</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反保密协议</skos:altLabel>
        <skos:definition>A breach of confidence has occurred if the defendant discloses or uses a novel idea that the plaintiff previously disclosed to the defendant in confidence and that the defendant voluntarily received.</skos:definition>
    </owl:Class>
    


