    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RTtZtn67Cvp0TersB7y9l8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RTtZtn67Cvp0TersB7y9l8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9WeLPiEbGoOavw05ow5nev"/>
        <rdfs:label>Analysis of Pre-Petition Mortgage</rdfs:label>
        <skos:definition>An Analysis of Pre-Petition Mortgage involves the examination and evaluation of mortgage agreements and related financial transactions that occurred before the filing of a bankruptcy petition. This analysis helps determine the validity, priority, and enforceability of claims against the debtor&apos;s property within the bankruptcy proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RTvhgnc8JDUg9dP9sFve9K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RTvhgnc8JDUg9dP9sFve9K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70"/>
        <rdfs:label>European Call Option Style</rdfs:label>
        <skos:definition>A European Call Option Style is a type of option contract that can only be exercised for a short, specified period just prior to its expiration, usually on a single day. This restriction contrasts with American-style options, which can be exercised at any time before expiration.</skos:definition>
        <skos:prefLabel>European-Style Call Option</skos:prefLabel>
    </owl:Class>
    


