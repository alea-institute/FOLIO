    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTvzt8uobb19tFbNSYQkFA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBTvzt8uobb19tFbNSYQkFA">
