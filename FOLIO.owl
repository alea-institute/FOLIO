    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcAwkSXDTnSdFMAo2cFLEd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcAwkSXDTnSdFMAo2cFLEd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8eT1bTptg5J6ZfnwSUQYpf"/>
        <rdfs:label>Bearer</rdfs:label>
        <skos:definition>A Bearer in legal contexts refers to an individual or entity responsible for physically transporting or delivering documents, goods, or service of process. This role requires the bearer to ensure the safe and accurate transfer of the item in question, often with a duty to provide confirmation upon successful delivery</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcBU67deDjlI1bwA04FGcY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcBU67deDjlI1bwA04FGcY">
