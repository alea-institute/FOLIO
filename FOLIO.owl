        <rdfs:label>Analysis of Benefits Plans</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Analyse des plans d&apos;avantages</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Analyse von Nutzungsplänen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Analysis of Benefits Plans</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Análise de planos de benefícios</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Análisis de planes de beneficios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Análisis de planes de beneficios</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניתוח של תוכניות יתרונות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लाभ योजनाओं का विश्लेषण</skos:altLabel>
