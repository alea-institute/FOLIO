        <rdfs:label>Georgia Superior Court - Echols County</rdfs:label>
        <skos:definition>A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Echols County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCIspQWdIBJSwXsTANd03VE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCIspQWdIBJSwXsTANd03VE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
        <dc:source>Fed. R. Evid. 403</dc:source>
        <dc:source>Fed. R. Evid. 611</dc:source>
        <rdfs:label>Multiple Question Objection</rdfs:label>
        <skos:altLabel>Dual Inquiry Objection</skos:altLabel>
        <skos:altLabel>Objection to Multi-Part Question</skos:altLabel>
        <skos:definition>A Multiple Question Objection, also known as a Compound Objection, is raised when a party in a legal proceeding believes that a question posed by the opposing counsel contains two or more distinct inquiries. This objection aims to ensure that each question is addressed separately, allowing for clear and focused responses.</skos:definition>
        <skos:prefLabel>Compound Question Objection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCIv9j8UdKC0YVPrbl5EGRq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCIv9j8UdKC0YVPrbl5EGRq">
