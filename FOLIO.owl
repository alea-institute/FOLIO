        <skos:altLabel xml:lang="de-de">Treuhänder</skos:altLabel>
        <skos:altLabel>Trustee</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trustee</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">fiduciaire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">fiduciário</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מנהל תמיכות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रस्टी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">信託受益者</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">受托人</skos:altLabel>
        <skos:definition>A trustee is an individual person or member of a board given control or powers of administration of property in trust with a legal obligation to administer it solely for the purposes specified.</skos:definition>
        <skos:hiddenLabel>TRUS</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OA1fGV1VIu5tK8bsCx3SE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OA1fGV1VIu5tK8bsCx3SE">
