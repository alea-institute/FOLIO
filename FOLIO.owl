        <skos:altLabel xml:lang="es-mx">Formato de datos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פורמט נתונים</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תבנית נתונים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डेटा प्रारूप</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">データ形式</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">数据格式</skos:altLabel>
        <skos:definition>The data structure that gives the file its meaning; in the context of legal data, the format of the legal-data file (e.g., Microsoft Word Document, Adobe Acrobat PDF, Microsoft Excel file).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79avSlZ9WCGqpbXi4A1s2V -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79avSlZ9WCGqpbXi4A1s2V">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motion for Summary Disposition</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Zusammenfassende Entscheidung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Disposición Sumaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Disposición Sumaria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Summary Disposition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Resumo de Disposição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue d&apos;une décision sommaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפיצול סיכום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सारांश निर्णय के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">摘要处置动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">略式処分の申立て</skos:altLabel>
        <skos:definition>A Motion for Summary Disposition is a request made to an appellate court to dispose of a case without a full trial, based on the evidence and arguments presented in the record.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79dS3BFjCbPpeHjyI3fr1I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79dS3BFjCbPpeHjyI3fr1I">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7WKt0VAzs1NaH3XvbaWYIZ"/>
        <rdfs:label>Aplastic Anemia</rdfs:label>
        <skos:altLabel>Bone Marrow Failure</skos:altLabel>
        <skos:altLabel>Hypoplastic Anemia</skos:altLabel>
        <skos:definition>Aplastic anemia is a condition characterized by the failure of the bone marrow to produce sufficient quantities of blood cells, leading to pancytopenia (low levels of red blood cells, white blood cells, and platelets). This disorder results in symptoms such as fatigue, increased susceptibility to infections, and bleeding tendencies due to the lack of healthy blood cells.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79gmzbdKRAnp85dihiDh5o -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79gmzbdKRAnp85dihiDh5o">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Blackfeet Tribe of the Blackfeet Indian Reservation of Montana</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79hBING4R549RLGy2HZL1V -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79hBING4R549RLGy2HZL1V">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Subcontracting Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de sous-traitance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de subcontratación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de subcontratación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de subcontratação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Subcontracting Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unterauftragsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כנסת קבלנים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपकंपन शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">下請負い条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分包条款</skos:altLabel>
        <skos:definition>A Subcontracting Clause is a provision in a contract that allows one party to hire another party to perform some or all of the work outlined in the original contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79iVCd3MZHWbAZsUqgI00A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79iVCd3MZHWbAZsUqgI00A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Perry County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Perry County is a specific court within the Pennsylvania Magisterial District Court system that handles minor criminal offenses, traffic violations, and civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79jXpStbWPIClnqZrLu4yP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79jXpStbWPIClnqZrLu4yP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rjco9ohucVSJ0XxprM5Opb"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
