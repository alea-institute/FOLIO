        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=712120"/>
        <rdfs:label>Historical Sites</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the preservation and exhibition of sites, buildings, forts, or communities that describe events or persons of particular historical interest. Archeological sites, battlefields, historical ships, and pioneer villages are included in this industry.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/SA8cNIMITkqIl5OAGhesdQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/SA8cNIMITkqIl5OAGhesdQ">
