    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ARlCKJua3ITxq2VdwZ2xT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC2fjcpsEbrVvVymvt4oASx"/>
        <rdfs:label>Breach of Third-Party Beneficiary Contract</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Third-Party Beneficiary Contract</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de contrato de beneficiario de terceros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato de beneficiario de terceros</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung eines Vertrags mit Drittbegünstigten</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation d&apos;un contrat bénéficiaire tiers</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de contrato de beneficiário terceiro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חוזה מוטב צד שלישי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तीसरे पक्ष लाभार्थी अनुबंध का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第三者受益契約違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反第三方受益人合同</skos:altLabel>
        <skos:definition>The Breach of Third-Party Beneficiary Contract refers to a situation where a party fails to fulfill their obligations under a contract, which was made for the benefit of a third party who is not a direct party to the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ASw8Dgh6TE62ku8oMci5u -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ASw8Dgh6TE62ku8oMci5u">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8lhhP1c4Hm9RruhEpWMrJW"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDETD6YVYGhLGZbM1fBnsfj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Incapacity Event</rdfs:label>
        <skos:definition>An Incapacity Event refers to a situation where an individual becomes unable to make or communicate specific decisions, typically due to illness, injury, or cognitive decline. In such cases, legal instruments like durable powers of attorney or advance directives can guide decision-making on behalf of the incapacitated individual.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8AUKvbXRK8jOHSQaqxcAtD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8AUKvbXRK8jOHSQaqxcAtD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDhSx7fl9qS0ezDVJuZHX4"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9jpIjzc10qdgl78jXOZtfm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9pwejG33H0Y9mi74WzE2nb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDnLOdTNWmEc4EhZ0SZXDm7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RvgSllm1V4c8HFGjBKE92i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Legal Determination</rdfs:label>
        <skos:definition>&quot;Litigation determination&quot; refers to the final outcome or verdict reached in a legal dispute or trial. It can include findings such as &quot;guilty&quot; in a criminal case or &quot;liable&quot; in a civil case when a party is held responsible, or &quot;acquitted&quot; when a defendant is found not guilty in a criminal trial. A single matter&apos;s legal determination can be split between claims (e.g., liable for one claim; not liable for another claim).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8AhhP8gb3fCPRIOJmR3oyD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8AhhP8gb3fCPRIOJmR3oyD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ma9Q5FiHDcIYgKoxKNUk9"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8iqvgE2NjybgksTeqsGhr3"/>
        <rdfs:label>Criminal Conspiracy</rdfs:label>
        <skos:altLabel xml:lang="es-es">Conspiración Criminal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Conspiración Criminal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Conspiration criminelle</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Conspiração criminosa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Criminal Conspiracy</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Straftatbestand der Verschwörung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קשר פלילי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपराधी षडयंत्र</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">刑事共谋</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">犯罪共謀</skos:altLabel>
        <skos:definition>A criminal agreement between two or more people to commit a crime, even if the crime is never carried out, falls under the concept of Criminal Conspiracy in the field of Inchoate Criminal Offenses and Concert of Action Crimes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Ahr1iRMkczkHNvcrZ3KOG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Ahr1iRMkczkHNvcrZ3KOG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbvEeHm8jkxY6SgfxEoC0i"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxkTKgYqWS0WBHnJgrn27Y"/>
        <dc:identifier>CASHA</dc:identifier>
        <rdfs:label>Cash and Cash Equivalents</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Caixa e equivalentes de caixa</skos:altLabel>
        <skos:altLabel>Cash and Cash Equivalents</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cash and Cash Equivalents</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Efectivo y equivalentes de efectivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Efectivo y equivalentes de efectivo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kasse und Zahlungsmitteläquivalente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Trésorerie et équivalents de trésorerie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מזומנים ומקבלי תשלום קרובים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नकद और नकदी के समकक्ष</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">现金及现金等价物</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現金及び現金同等物</skos:altLabel>
        <skos:definition>Cash is legal tender – currency or coins – that can be used to exchange goods, debt, or services. Sometimes it also includes the value of assets that can be easily converted into cash immediately, as reported by a company. Cash equivalents are investment</skos:definition>
        <skos:hiddenLabel>CASHA</skos:hiddenLabel>
        <skos:historyNote>Because we are mixing both (1) accounting terminology and (2) other non-balance-sheet items like `Goods`, giving this concept multiple parentage likely fulfils both use cases. Happy to improve this further, though.</skos:historyNote>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8AoCbH9WBp8yoMXj21haD4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8AoCbH9WBp8yoMXj21haD4">
