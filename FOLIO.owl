            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9BhvOfuZgSGUlQfxwSi4b5"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Exclusivity Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ausschließlichkeitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;exclusivité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de exclusividad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de exclusividad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de exclusividade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Exclusivity Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף בלעדיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनन्यता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排他性条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">排他的契約条項</skos:altLabel>
        <skos:definition>An exclusivity clause is a provision in a contract that restricts one or more parties from engaging in certain activities or relationships with others, as agreed upon in the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDgGcpXGlTkoTivF8Ol8w09 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDgGcpXGlTkoTivF8Ol8w09">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOoYq5UsqIy3nBTVUnTNco"/>
        <rdfs:label>State Legislator</rdfs:label>
        <skos:altLabel>State Lawmaker</skos:altLabel>
        <skos:definition>A State Legislator is an elected official who serves as a member of a state&apos;s legislative body, responsible for drafting, debating, and voting on state laws and policies. This individual represents a specific district or constituency within the state and participates in the legislative process, including committee work, budget approval, and oversight of state agencies.</skos:definition>
        <skos:prefLabel>Provincial Legislator</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDgLz1KvQn0YL8W61rW55T4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDgLz1KvQn0YL8W61rW55T4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBz2aCAIZMshK7S6EKsCHmX"/>
        <rdfs:label>Marital Status</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Estado civil</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Familienstand</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">État civil</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">婚姻状况</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">婚姻状況</skos:altLabel>
        <skos:definition>Marital Status refers to the legal state of being single, married, divorced, separated, or widowed, for an individual person. This concept is considered in several areas of law (e.g., Tax Law, Bankruptcy Law)</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDgMBlG1guG5IgcW8MooNe5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDgMBlG1guG5IgcW8MooNe5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
        <rdfs:label>Excludes National Entitlements</rdfs:label>
        <skos:altLabel>Does Not Establish Federal Benefits</skos:altLabel>
        <skos:definition>In immigration law, the term &quot;Does Not Establish Federal Benefits&quot; often appears on identification documents issued by states to indicate that these documents are not sufficient to establish eligibility for federal benefits or entitlements. In the U.S., this is relevant in the context of the Real ID Act, which sets forth the federal standards that state-issued identification must meet for various purposes, including access to certain federally regulated facilities and federal benefits</skos:definition>
    </owl:Class>
    


