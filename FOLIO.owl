        <skos:altLabel xml:lang="es-es">Aviso de acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aviso de arreglo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Notice of Settlement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergleichsmitteilung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הודעת הסדר</skos:altLabel>
