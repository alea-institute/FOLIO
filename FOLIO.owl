        <skos:altLabel>Master of Education</skos:altLabel>
        <skos:definition>An M.Ed. (Master of Education) is an advanced academic degree typically earned after completing graduate-level coursework in education. It signifies specialized knowledge and training in educational theory and practice</skos:definition>
        <skos:prefLabel>M.Ed.</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4fxxzi0Hw23RHf3rwpPQf -->

