        <rdfs:label>Oregon Circuit Court - Marion County</rdfs:label>
        <skos:definition>Oregon Circuit Court - Marion County: A specific court within the Oregon Circuit Court system located in Marion County, responsible for administering legal proceedings within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBt0SN4pvSLYS7btxE4VScr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBt0SN4pvSLYS7btxE4VScr">
