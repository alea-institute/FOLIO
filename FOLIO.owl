        <rdfs:label>oasis:collection</rdfs:label>
        <skos:definition>A collection of metadata related to actors in the OASIS standard, including roles, agents, and figures.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBwNJhZd68pWJO0BUwQDM6b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBwNJhZd68pWJO0BUwQDM6b">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7vlavFi9wyzEzNgp9zjkE"/>
        <rdfs:label>Visa for Staff of Individuals with Extraordinary Ability or Achievement</rdfs:label>
        <skos:altLabel>O-2 Visa</skos:altLabel>
        <skos:definition>The Visa for Staff of Individuals with Extraordinary Ability or Achievement (in the U.S, the O-2 Visa) is designed for individuals who will accompany and assist a visa holder in their field of extraordinary ability or achievement. In the United States, the O-2 visa is typically granted based on the demonstration that the accompanying individual has skills and experience that are essential to the O-1 visa holder&apos;s activity or performance. The duration of the O-2 visa is generally tied to that of the principal O-1 visa holder</skos:definition>
    </owl:Class>
    


