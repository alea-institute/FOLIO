        <rdfs:label>Artistic Work</rdfs:label>
        <skos:altLabel>Artistic Composition</skos:altLabel>
        <skos:altLabel>Fine Art</skos:altLabel>
        <skos:altLabel>Visual Art</skos:altLabel>
        <skos:definition>An Artistic Work is a creation that expresses artistic or aesthetic value through visual or audio mediums, protected under copyright law. This includes paintings, sculptures, photographs, and other visual arts, granting the creator exclusive rights to reproduce, distribute, and display their work.</skos:definition>
    </owl:Class>
    


