        <skos:altLabel xml:lang="fr-fr">Inuktitut</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Inuktitut</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">イヌクティトゥット語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">伊努伊特语</skos:altLabel>
        <skos:definition>A language spoken by the Inuit people in Canada and parts of Greenland, characterized by a complex system of inflection and agglutination.</skos:definition>
    </owl:Class>
    


