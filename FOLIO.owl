        <skos:altLabel xml:lang="zh-cn">莱兹吉安语</skos:altLabel>
        <skos:definition>Lezghian is a written or spoken structured system of communication that consists of grammar and vocabulary, and is a member of the Language top-level class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9b9cucv5zG3I8ujQm3sZQc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9b9cucv5zG3I8ujQm3sZQc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t29mcCgDnprofEh5VP2LX"/>
        <rdfs:label>Pending Acquisition Proposal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ausstehender Übernahmevorschlag</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pending Acquisition Proposal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Proposition d&apos;acquisition en attente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Proposta de aquisição pendente</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Propuesta de adquisición pendiente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Propuesta de adquisición pendiente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת רכישה ממתינה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लंबित अधिग्रहण प्रस्ताव</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保留中の買収提案</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">待定收购提议</skos:altLabel>
        <skos:definition>A pending acquisition proposal is a legal concept that refers to an offer made by one party to acquire another party&apos;s assets or business, which has not yet been accepted or rejected, and is subject to certain conditions and triggers, such as tail period fee triggers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bCaZjWhV1f2PgQiwzAkDm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bCaZjWhV1f2PgQiwzAkDm">
