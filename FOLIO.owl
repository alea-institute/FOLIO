        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm"/>
        <rdfs:label>Adrenal Gland Disorders</rdfs:label>
        <skos:definition>Adrenal gland disorders impact bone calcium levels, blood pressure, metabolism, and mental status. They can lead to osteoporosis with fractures, hypertension affecting heart failure or causing arrhythmias, significant weight loss, and mood disorders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4g3TALv8nAHKja2MjsRLG -->

