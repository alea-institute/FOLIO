    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLC0L5JdLdjdUXjSDZ5kNO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Materiality Scrape Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de grattage de matérialité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de raspadura de materialidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de raspadura de materialidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de raspagem de materialidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Materiality Scrape Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Materialitäts-Schaber-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חיסוריות חומרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मददगार स्क्रेप क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质性刮擦条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重要性スクレイプ条項</skos:altLabel>
        <skos:definition>A Materiality Scrape Clause is a provision in a contract that specifies that in the event of a conflict between the materiality definition in the contract and that in another agreement, the definition in the other agreement will be used.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLCgcyVpMJC9pO2jdogXYJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLCgcyVpMJC9pO2jdogXYJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NkMt6XJKd4fSolKqqOy5B"/>
        <rdfs:label>Turnover and Other General Goods and Services Tax Payment</rdfs:label>
        <skos:altLabel>Multi-Stage Tax Payment</skos:altLabel>
        <skos:altLabel>Turnover and other general taxes on goods and services</skos:altLabel>
        <skos:definition>Turnover and Other General Goods and Services Tax Payment refers to multi-stage cumulative taxes and taxes where elements of consumption taxes are combined with multistage taxes. These taxes are levied each time a transaction takes place, without deduction for taxes paid on inputs. Multi-stage taxes can incorporate elements of value-added or sales taxes, leading to taxation at multiple points in the supply chain.</skos:definition>
        <skos:prefLabel>Multi-Stage Consumption Tax</skos:prefLabel>
    </owl:Class>
    


