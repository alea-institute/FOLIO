    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC6OuguqBnCmspFsAH9y69S">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Rent Abatement Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de réduction de loyer</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de abatimento de aluguel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de reducción de alquiler</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de reducción de renta</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mietminderungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Rent Abatement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפחתת שכר דירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">किराये में कटौती धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家賃免除条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">租金减免条款</skos:altLabel>
        <skos:definition>A rent abatement clause is a provision in a contract that allows for a reduction or suspension of rent payments in the event of certain circumstances, such as property damage or loss of use.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC6PjawbC2j2bUJ6mt3ZRKc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC6PjawbC2j2bUJ6mt3ZRKc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ0dgV4Z2Xk7aGfJt2nSj7"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_00D5"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_06"/>
        <rdfs:label>Undifferentiated and Mixed Connective Tissue Disease</rdfs:label>
        <skos:altLabel>Undifferentiated Connective Tissue Disease</skos:altLabel>
        <skos:definition>Undifferentiated and mixed connective tissue disease encompasses syndromes with clinical and immunologic features of multiple autoimmune disorders, but which do not meet the criteria for any specific disorder. These conditions may present with clinical manifestations of systemic lupus erythematosus (SLE), systemic vasculitis, and serologic findings characteristic of rheumatoid arthritis, among others.</skos:definition>
        <skos:prefLabel>Autoimmune Overlap Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC6SNzsct97dNur2jmCJwg0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC6SNzsct97dNur2jmCJwg0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB8gtCBLdNnUSfnwwQZSVhG"/>
        <rdfs:label>Passport Number</rdfs:label>
        <skos:definition>A passport number is a unique alphanumeric identifier assigned to an individual&apos;s passport by the issuing government. This number is used for verification and identification purposes during international travel, border crossings, and various official procedures. It is an essential component of the passport and is often required for legal and administrative purposes.</skos:definition>
    </owl:Class>
    


