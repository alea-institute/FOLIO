            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Election</rdfs:label>
        <skos:definition>An election is a formal decision-making process in which eligible individuals, often referred to as voters, select a choice or representative from among multiple candidates or options. Elections are used in democracies to fill various public offices or decide on legislation and public policy issues, ensuring that the will of the people is reflected in governance and leadership.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkLJ6mPMkvoXudc5ms5yza -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkLJ6mPMkvoXudc5ms5yza">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmpvD4XLJx0kkUTZ3QIadI"/>
        <rdfs:label>Court-Appointed Expert</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Court-Appointed Expert</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Expert judiciaire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Experto designado por el tribunal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Experto designado por el tribunal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gerichtlich bestellter Sachverständiger</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Perito nomeado pelo tribunal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מומחה מונה על ידי הבית המשפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अदालत नियुक्त विशेषज्ञ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法院指定专家</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判所指定の専門家</skos:altLabel>
        <skos:definition>An expert who is appointed by a court, judge, or judicial body.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkMmwVhgxwiwuOmif1WUxw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkMmwVhgxwiwuOmif1WUxw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:label>Failure to Signal Claim</rdfs:label>
        <skos:definition>A Failure to Signal Claim involves allegations that a driver has not used proper turn or lane change signals as required by traffic laws, leading potentially to misunderstandings or accidents on the road. Such claims are typically processed through traffic courts or administrative bodies and may result in fines or other penalties.</skos:definition>
        <skos:prefLabel>Turn Signal Violation Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkMsDzhDxQxUN8FKhOhozQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkMsDzhDxQxUN8FKhOhozQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
        <rdfs:label>Nil Paid Letters</rdfs:label>
        <skos:altLabel>Rights Issue Letters</skos:altLabel>
        <skos:altLabel>Unpaid Share Rights</skos:altLabel>
        <skos:definition>Nil Paid Letters, also known as Unpaid Share Subscription Rights, are temporary documents issued by a company offering new shares to existing shareholders. These letters allow shareholders to trade the rights to subscribe to the new shares before payment is required, but they do not represent ownership until the shares are fully paid.</skos:definition>
        <skos:prefLabel>Unpaid Share Subscription Rights</skos:prefLabel>
    </owl:Class>
    


