        <rdfs:label>New York City Court - Niagara Falls</rdfs:label>
        <skos:definition>A court located in Niagara Falls that operates under the jurisdiction of the New York City Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/REH9x1s5OZp3R9Iy5cAY6F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/REH9x1s5OZp3R9Iy5cAY6F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgGcpXGlTkoTivF8Ol8w09"/>
        <rdfs:label>State Lower House Legislator</rdfs:label>
        <skos:altLabel>Member of State House of Representatives</skos:altLabel>
        <skos:definition>A State Representative is an elected official who serves as a member of the lower chamber of a state&apos;s bicameral legislature, often called the House of Representatives or Assembly. This individual is responsible for drafting, debating, and voting on state laws and policies, as well as representing the interests of constituents from their specific district within the state.</skos:definition>
        <skos:prefLabel>State Representative</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/REHNCJihY35PfSEAaiRLzL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/REHNCJihY35PfSEAaiRLzL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1okJKMvv4mMHv7m4TzwBe"/>
        <rdfs:label>Sport Utility Vehicle</rdfs:label>
        <skos:definition>A Sport Utility Vehicle (SUV) is a type of motor vehicle designed to combine the capabilities of a passenger car with features typically found in off-road vehicles. SUVs are characterized by their larger size, higher ground clearance, and often, four-wheel-drive or all-wheel-drive systems.</skos:definition>
        <skos:prefLabel>SUV</skos:prefLabel>
    </owl:Class>
    


