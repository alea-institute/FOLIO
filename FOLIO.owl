        <rdfs:label>Performance Guarantee Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de garantie de performance</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de garantia de desempenho</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de garantía de desempeño</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de garantía de rendimiento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Leistungsgarantie</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Performance Guarantee Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הבטחת ביצועים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रदर्शन गारंटी शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">履约保证条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">履行保証条項</skos:altLabel>
        <skos:definition>A Performance Guarantee Clause is a provision in a contract that ensures the completion of a specific task or obligation, with a promise to compensate the other party if the task is not completed as agreed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDyBSHSjhe1bInCsxPkdmfk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDyBSHSjhe1bInCsxPkdmfk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
        <rdfs:label>Quasi-Estoppel</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cuasiestoppel</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cuasiestoppel</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Quase-estoppel</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Quasi-Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Quasi-Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Quasi-estoppel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קוואזי-אסטופל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्वासी-एस्टोपल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">准停止</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">準拘束効力</skos:altLabel>
        <skos:definition>Quasi-Estoppel is a legal principle that prevents a party from denying or asserting a position that is contrary to a previous position they have taken, even if there is no formal legal agreement or contract in place.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDyK6ysAqEvoICYZkH3C5sV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDyK6ysAqEvoICYZkH3C5sV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RClKvZvieudjUMtKTcCsMAn"/>
        <rdfs:label>Travel Insurance Policy</rdfs:label>
        <skos:definition>Travel insurance provides coverage for various risks associated with travel, such as medical emergencies, trip cancellations, and lost luggage. The scope of coverage can vary widely depending on the policy, and it&apos;s typically purchased for the duration of a specific trip or as an ongoing subscription for frequent travelers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDyKudv9hhW75PHg89wZeoY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDyKudv9hhW75PHg89wZeoY">
