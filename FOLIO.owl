        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
        <rdfs:label>Government Relations</rdfs:label>
        <skos:definition>Government relations refers to the management of interactions and communication between an organization and government entities, including legislative bodies, regulatory agencies, and policymakers. It involves advocating for policies, regulations, or actions that benefit the organization or its stakeholders, and may include lobbying, monitoring legislative developments, and engaging in public affairs activities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBAv3u5Z3iCJEvASeA7qYYY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBAv3u5Z3iCJEvASeA7qYYY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCjyAGouN1KzCc7ooEeudEH"/>
        <rdfs:label>No-Knock Warrant</rdfs:label>
        <skos:definition>A No-Knock Warrant is a legal authorization that allows law enforcement officers to enter a property without prior notification to the occupants, typically in the context of a raid or search. This type of warrant is issued when announcing their presence is believed to pose a threat to officer safety or could lead to the destruction of evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBAxfpbmWO6iXLjcldJnbKt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBAxfpbmWO6iXLjcldJnbKt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDAQMAQLYgoUdaKQquAhteq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Background Check Discrimination Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Background Check Discrimination Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Diskriminierungsklage bei Hintergrundüberprüfung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por discriminación en la verificación de antecedentes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de discriminación en la verificación de antecedentes</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de discriminação em verificação de antecedentes</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de discrimination lors d&apos;une vérification des antécédents</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת זכויות בבדיקת רקע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बैकग्राउंड चेक भेदभाव दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">バックグラウンドチェック差別クレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">背景调查歧视索赔</skos:altLabel>
        <skos:definition>A background check claim is a legal action initiated by an individual who alleges they have been unfairly treated or denied employment, housing, or other opportunities based on the results of a background check. Background checks typically involve the examination of an individual&apos;s criminal record, credit history, employment history, or other personal information. These claims often arise when an employer, landlord, or other decision-maker violates the Fair Credit Reporting Act (FCRA) or other applicable laws by not providing proper notice, failing to obtain consent, or using the background check information in a discriminatory manner.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBAz5we0vAOno0uhYu2zkpJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBAz5we0vAOno0uhYu2zkpJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>General Political or Social Conditions Language</rdfs:label>
        <skos:altLabel xml:lang="de-de">Allgemeine politische oder soziale Bedingungen Sprache</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">General Political or Social Conditions Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langue des conditions politiques ou sociales générales</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lenguaje de Condiciones Políticas o Sociales Generales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lenguaje de Condiciones Políticas o Sociales Generales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Linguagem de condições políticas ou sociais gerais</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שפת מצבים פוליטיים או חברתיים כלליים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य राजनीतिक या सामाजिक स्थितियों की भाषा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">一般政治或社会条件语言</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">一般的な政治的または社会的状況の言語</skos:altLabel>
        <skos:definition>General Political or Social Conditions Language refers to a provision in a legal agreement that allows a party to terminate or modify the agreement if there are significant changes in the political or social conditions of a particular region or country, which may affect the performance of the agreement.</skos:definition>
    </owl:Class>
    


