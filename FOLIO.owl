        <skos:altLabel xml:lang="es-mx">Retención negligente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Retenção negligente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Rétention négligente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שמירה שלא ראויה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लापरवाह रखरखाव</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过失保留</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">過失保持</skos:altLabel>
        <skos:definition>The concept of Negligent Retention refers to a legal claim that an employer was negligent in retaining an employee who they knew or should have known posed a risk of harm to others.</skos:definition>
    </owl:Class>
    


