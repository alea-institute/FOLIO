        <rdfs:label>Florida Circuit Court - Liberty County - 2nd Circuit Court</rdfs:label>
        <skos:definition>A court located in Liberty County, Florida that is part of the larger Florida Circuit Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7M0SnFzqvb2ZLS3kR9iYXj -->

