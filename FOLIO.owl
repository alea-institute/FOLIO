        <rdfs:label>Other Residential Care Facilities</rdfs:label>
        <skos:definition>See industry description for 623990.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/tC-ANburRjGXa9bmfoQdTA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/tC-ANburRjGXa9bmfoQdTA">
