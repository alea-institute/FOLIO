        <skos:altLabel xml:lang="en-gb">Incident Reconstruction Expert</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מומחה לשיקום אירועים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">घटना पुनर्निर्माण विशेषज्ञ</skos:altLabel>
