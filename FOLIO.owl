            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Visa for Intended Spouse of Citizen</rdfs:label>
        <skos:altLabel>K-1 Visa</skos:altLabel>
        <skos:altLabel>This non-immigrant visa category for the intended spouse or fiancé(e) of a destination-country citizen (in the U.S., the K-1 visa) allows the foreign-citizen fiancé(e) to travel to the destination country for the purpose of marrying their citizen sponsor within a short period (e.g., within 90 days of arrival), after which they can apply for adjustment of status to become a lawful permanent resident</skos:altLabel>
        <skos:altLabel>Visa for Fiancé(e) of U.S. Citizen</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9yZqs25yP8xj0I6DtF2b2o -->

