        <dc:source>Fed. R. Evid. 403</dc:source>
        <dc:source>Fed. R. Evid. 611</dc:source>
        <rdfs:label>Misstatement of Evidence Objection</rdfs:label>
        <skos:altLabel>Evidence Distortion Objection</skos:altLabel>
        <skos:altLabel>Incorrect Representation Objection</skos:altLabel>
        <skos:altLabel>Mischaracterization of Testimony</skos:altLabel>
        <skos:altLabel>Misstatement of Testimony</skos:altLabel>
        <skos:altLabel>Objection to False Evidence Representation</skos:altLabel>
        <skos:definition>A Misstatement of Evidence Objection is raised when a party in a legal proceeding believes that the opposing counsel or a witness has inaccurately represented the evidence on record. This objection seeks to ensure that the evidence is accurately portrayed and understood by courts, factfinders, and decisionmakers.</skos:definition>
        <skos:prefLabel>Mischaracterization of Evidence Objection</skos:prefLabel>
    </owl:Class>
    


