    <!-- https://folio.openlegalstandard.org/R8A2f18n9G7OkKnD3C0K5O -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8A2f18n9G7OkKnD3C0K5O">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
        <rdfs:label>Asset Voting Attributes</rdfs:label>
        <skos:definition>Asset Voting Attributes encompass the various rights and limitations associated with voting entitlements linked to ownership of financial assets. These attributes include voting rights, non-voting rights, restricted voting rights, and enhanced voting rights, each defining the degree of influence a shareholder has in an organization&apos;s decision-making process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8A2quE90i09h1rLyzlww1A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8A2quE90i09h1rLyzlww1A">
