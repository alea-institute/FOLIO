        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Champerty and Maintenance</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Cesariana e Manutenção</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Champart et Maintenance</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Champerty and Maintenance</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Champerty und Maintenance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Colusión procesal y mantenimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Colusión procesal y mantenimiento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צ&apos;מפרטי ותחזוקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चैम्पर्टी और मेंटेनेंस</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">チャンパティーとメンテナンス</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分享诉讼和非法经营</skos:altLabel>
        <skos:definition>The concept of Champerty and Maintenance refers to the illegal practice of a third party funding a lawsuit in exchange for a share of the proceeds, which can lead to an abuse of the legal system.</skos:definition>
    </owl:Class>
    


