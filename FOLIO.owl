        <rdfs:label>Modality</rdfs:label>
        <skos:definition>Modality refers to the way in which a statement or proposition is expressed, indicating the degree of possibility, necessity, or contingency.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJAVqPEzzt7D0FUsahseJi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJAVqPEzzt7D0FUsahseJi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7JKVOM2aFkvG1yiLzF7ndA"/>
        <rdfs:label>Defamation Per Se</rdfs:label>
