        <skos:altLabel xml:lang="es-mx">Embargado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Garnishee</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Terceiro executado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tiers saisi</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גרנישי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गार्निशी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">差し押え</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">扣押令</skos:altLabel>
        <skos:definition>A person who owes a debt to a judgment debtor, or a person other than the judgment debtor who has property in his possession or custody in which a judgment debtor has an interest. NY CPLR § 105.</skos:definition>
