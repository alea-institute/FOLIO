        <rdfs:label>Motion to Exclude Testimony</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss von Zeugenaussagen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Excluir Testimonio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Excluir Testimonio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour exclure le témoignage</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Exclude Testimony</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de exclusão de depoimento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאפשרות הוצאת עדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाही को निकालने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除证言动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言の排除を求める請願</skos:altLabel>
        <skos:definition>A Motion to Exclude Testimony is a formal request made to a court to prevent certain testimony from being presented as evidence during a trial or hearing.</skos:definition>
    </owl:Class>
    


