        <rdfs:isDefinedBy>The unlawful seizure, transportation, and/or detention of a person against his/her will, or of a minor without the consent of his/her custodial parent(s) or legal guardian.</rdfs:isDefinedBy>
        <rdfs:label>Kidnapping</rdfs:label>
        <skos:altLabel>Abduction</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Enlèvement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Entführung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Kidnapping</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Secuestro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Secuestro</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sequestro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חטיפה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपहरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">绑架</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">誘拐</skos:altLabel>
        <skos:definition>The act of unlawfully taking or confining a person, typically for ransom or as a means of coercion, and is considered a crime against individuals.</skos:definition>
