        <dc:source rdf:resource="https://www.justice.gov/ust/means-testing/20220515"/>
        <rdfs:label>Household Size</rdfs:label>
        <skos:definition>Household size refers to the number of individuals who reside together as a single economic unit. This number is relevant for determining eligibility for certain benefits, exemptions, or deductions, and it impacts calculations related to taxes, bankruptcy means tests, and other legal considerations.</skos:definition>
        <skos:prefLabel>Family Size</skos:prefLabel>
    </owl:Class>
    


