        <rdfs:label>Injurious Falsehood</rdfs:label>
        <skos:altLabel xml:lang="es-es">Falsedad perjudicial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falsedad perjudicial</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falsidade prejudicial</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Faute préjudiciable</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Injurious Falsehood</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzende Falschheit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שקר מזיק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हानिकारक झूठ</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">有害な誤った陳述</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">有害虚假言论</skos:altLabel>
        <skos:definition>A false statement made about a person or entity that causes harm to their reputation or business interests.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCG2McqzcZL8APHARe6pvPb -->

