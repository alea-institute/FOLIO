        <skos:altLabel xml:lang="pt-br">Detalhes de identificação do cliente</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Detalle de Identificación del Cliente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Detalle de Identificación del Cliente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Détails d&apos;identification du client</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kundenidentifikationsdetails</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פרטי זיהוי לקוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ग्राहक पहचान विवरण</skos:altLabel>
