        <skos:altLabel xml:lang="fr-fr">Swati</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Swati</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スワティ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">斯瓦蒂</skos:altLabel>
        <skos:definition>Swati is a written or spoken structured system of communication that consists of grammar and vocabulary, and is a member of the language family.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9OQDlkVuZ7bzfYSzAys1E6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9OQDlkVuZ7bzfYSzAys1E6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnhXmv223OLuy6W4pzIHlD"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
