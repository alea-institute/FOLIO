        <skos:altLabel>Vision Disability</skos:altLabel>
        <skos:altLabel>Vision Impairment</skos:altLabel>
        <skos:altLabel>Visual Impairment</skos:altLabel>
        <skos:definition>A Visual Disability is a condition that impairs an individual&apos;s ability to see, which can range from partial vision loss to complete blindness. This impairment affects daily activities, communication, and mobility, and may require the use of assistive devices or adaptations to improve quality of life.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ar3DiPnalW8p6wJXt9eWr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ar3DiPnalW8p6wJXt9eWr">
