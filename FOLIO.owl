        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Nondispositive Stipulation</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estipulación no dispositiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estipulación no dispositiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Estipulação não decisiva</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nicht-entscheidende Vereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nondispositive Stipulation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Stipulation non décisive</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם לא מכיל החלטות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गैर-निर्णायक स्टिपुलेशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非决定性协议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">非決定的な規定</skos:altLabel>
        <skos:definition>A Nondispositive Stipulation is an agreement between parties in a legal case that does not determine the outcome of the case, but rather sets forth certain facts or procedural matters that are not in dispute.</skos:definition>
    </owl:Class>
    


