        <skos:altLabel xml:lang="fr-fr">Motion d&apos;abstention</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Abstention</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Abstenção</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת נימוקים לפיכוף החרם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अलगाव के लिए आवेदन</skos:altLabel>
