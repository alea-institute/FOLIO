        <skos:definition>The process is active.</skos:definition>
        <skos:hiddenLabel>OP</skos:hiddenLabel>
        <skos:prefLabel>Service Begun</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7awxTX5kqxlsN3N0qTBdJE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7awxTX5kqxlsN3N0qTBdJE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBFH5v175MuTKvLEcBLRkJ4"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Motion for Leave to Appeal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Zulassung der Berufung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Leave to Appeal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de autorização para recorrer</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recurso de apelación</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recurso de súplica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en autorisation d&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להרשאה לערעור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुमति अपील के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">上诉请假动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴許可申立書</skos:altLabel>
        <skos:definition>A Motion for Leave to Appeal is a formal request made by a non-party filer in a bankruptcy case to seek permission from the court to appeal a decision made by a lower court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7azvKC8RwopK0ecoTMqfH1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7azvKC8RwopK0ecoTMqfH1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBoDiMryDOIE3XWHl6qgL3y"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RfP04tDTTpn4LDvwAxAqkh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Presumption of Innocence</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Presumption of Innocence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Presunción de Inocencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Presunción de Inocencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Presunção de inocência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Présomption d&apos;innocence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unschuldsvermutung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הנחת התפיסה של האפליה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्दोषता का पूर्वाभास</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无罪推定</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無罪推定</skos:altLabel>
        <skos:definition>The presumption of innocence is a fundamental principle of criminal law that assumes an accused person is innocent until proven guilty. This cornerstone of the justice system places the burden of proof on the prosecution, requiring them to present sufficient evidence to convince a judge or jury of the defendant&apos;s guilt, and helps ensure that individuals are not unfairly convicted without proper evidence or due process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bP5vwpnavvW5pPJutIvq8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bP5vwpnavvW5pPJutIvq8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q7GJc1zsYT0P4Xdp6l9Oz"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Criminal Claim Degree</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Criminal Claim Degree</skos:altLabel>
        <skos:altLabel>Criminal Claim Severity</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Degré de demande pénale</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Grado de Reclamación Criminal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Grado de Reclamación Criminal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Grau de Reivindicação Criminal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafantrag Grad</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעלה טענת פליליות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपराधिक दावा डिग्री</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">刑事索赔程度</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">刑事請求度</skos:altLabel>
        <skos:definition>The Criminal Claim Degree (Severity) refers to the level of seriousness of a criminal offense, such as a felony, misdemeanor, or infraction, within the context of a legal claim or litigation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bR4JuUnFZwFzMrQbRuvJq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bR4JuUnFZwFzMrQbRuvJq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBxw7BF15bDA0Ifn2vOrC8h"/>
        <rdfs:label>Georgia District Court - Bryan County</rdfs:label>
        <skos:definition>Georgia District Court - Bryan County: A court of law in the state of Georgia that has jurisdiction over legal cases and disputes specifically within Bryan County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bUyjnSIcSI4bvVW21OoxG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bUyjnSIcSI4bvVW21OoxG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGDeLOS6gclKMduTkkQmoa"/>
        <rdfs:label>Hair Evidence</rdfs:label>
        <skos:definition>Hair evidence includes strands or fragments of hair found at crime scenes or on objects. Through microscopic examination and DNA analysis, hair can reveal information about its origin, potentially linking individuals to a particular location or event.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bZqwOPufVYSnVkmLzCTlP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bZqwOPufVYSnVkmLzCTlP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RkbIrzj6HiYQSEnDLqeHsh"/>
        <rdfs:label>Entrapment</rdfs:label>
        <skos:altLabel>Government Coercion</skos:altLabel>
        <skos:altLabel>Police Inducement</skos:altLabel>
        <skos:definition>Entrapment is a defense in criminal law where the defendant argues that law enforcement induced them to commit a crime they would not have otherwise committed. This defense is used to prevent the conviction of individuals who were coerced into illegal activities by police or government agents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bddbBa7EIzMF8MI0EvJD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bddbBa7EIzMF8MI0EvJD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgEiiX23zftUP0Mggfc68n"/>
        <rdfs:label>Exclusive Agreement Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;accord exclusif</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo Exclusivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Exclusivo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de acordo exclusivo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Exclusive Agreement Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur exklusiven Vereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הסכם בלעדי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एक्सक्लूसिव समझौता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占契約条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">独家协议条款</skos:altLabel>
        <skos:definition>An exclusive agreement clause is a provision in a contract that restricts one or both parties from entering into similar agreements with other parties during the term of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bgNaAADYGryTZSNn3xNAt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bgNaAADYGryTZSNn3xNAt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Lovelock Paiute Tribe of the Lovelock Indian Colony, Nevada</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bioZVoICxYfaUkkVtwS0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bioZVoICxYfaUkkVtwS0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
        <rdfs:label>INVOICE_CURRENCY</rdfs:label>
        <skos:definition>The concept of INVOICE_CURRENCY refers to the specific currency used in a legal invoice, as defined by the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bndABfdeRug7rH6iTRITP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bndABfdeRug7rH6iTRITP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD0fU7sBZWOEYH2VBJIO7p"/>
        <rdfs:label>Employee Re-Hire Event</rdfs:label>
        <skos:definition>An Employee Re-Hire Event refers to the occasion when a former employee is formally rehired and rejoins the same organization. This event often involves the signing of a new employment contract and may necessitate another round of onboarding, while also potentially impacting seniority, benefits, and other employment conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bnear7qteTICuLSkSZc0K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bnear7qteTICuLSkSZc0K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7l492OzFfZUEluIFBwy3xI"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Collateral Estoppel</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Collateral Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cosa Juzgada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Efecto de Cosa Juzgada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Estoppel por litispendência</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kollaterale Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Préclusion</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אפקט דבר נכר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सहायक अधिकार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コラテラル・エストッペル</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">抵制权</skos:altLabel>
        <skos:definition>Collateral Estoppel is a legal doctrine that prevents a party from relitigating an issue that has already been decided in a previous case, even if the parties and legal theories are different.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bp4W5Isy3M9JAsztDsVic -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bp4W5Isy3M9JAsztDsVic">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8QBuMoK1uPFeLW0sg40CdA"/>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Contact City</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Cidade de contato</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ciudad de Contacto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ciudad de Contacto</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Contact City</skos:altLabel>
        <skos:altLabel>Contact Town</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kontaktstadt</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ville de contact</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עיר איש קשר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संपर्क शहर</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コンタクトシティ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">联系城市</skos:altLabel>
        <skos:definition>Contact City refers to the city where a person or entity can be reached and is a subcategory of Contact Information in the context of Engagement Terms for providing legal services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7btd1Kfxl5GzUMaBVEx4vc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7btd1Kfxl5GzUMaBVEx4vc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Dependent Personality Disorder</rdfs:label>
        <skos:definition>Dependent Personality Disorder is characterized by a pervasive and excessive need to be taken care of, leading to submissive and clinging behaviors and fears of separation. Individuals with this disorder have difficulty making independent decisions and rely heavily on others for emotional and practical support.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bvtHzJRM5qApWHGKcyoXi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bvtHzJRM5qApWHGKcyoXi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnTEPb_LCSNqAkQqrfte8zg"/>
        <rdfs:label>A111 Other</rdfs:label>
        <skos:definition>A111 Other refers to an unspecified activity within the legal domain that does not fit into any other predefined category.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bwZeguAOad1yUKbQstNCT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bwZeguAOad1yUKbQstNCT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8C3ez5gI2F09CMXs6RG4Cj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prisoner Reentry</rdfs:label>
        <skos:definition>Prisoner reentry refers to the process of individuals reintegrating into society after serving time in prison. It involves addressing various challenges such as employment, housing, and support services to reduce the likelihood of recidivism and help former prisoners successfully transition back into their communities.</skos:definition>
        <skos:prefLabel>Reentry</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bx4TKEqYyz5TZM0rx3Lgs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bx4TKEqYyz5TZM0rx3Lgs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCtUZjZqZ1lszDFiDOLUuTh"/>
        <rdfs:label>Illinois Circuit Court - Crawford County (2nd Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7bzhpuW6wVk2sRkYb3Us4o -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7bzhpuW6wVk2sRkYb3Us4o">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:label>Employment Misclassification Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Employment Misclassification Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klage wegen falscher Einstufung als Selbstständiger</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de clasificación errónea de empleo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de clasificación errónea de empleo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de classificação incorreta de emprego</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de classification erronée de l&apos;emploi</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על טעות בסיווג העסקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रोजगार गलत वर्गीकरण दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">就业错分类索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">雇用の誤分類請求</skos:altLabel>
        <skos:definition>An employment misclassification claim is a legal action initiated by an employee who alleges that their employer has improperly classified them as an independent contractor, rather than an employee. The claim typically arises when an employer misclassifies an employee to avoid providing benefits or complying with certain employment laws, such as minimum wage and overtime requirements. Employees who are misclassified may be entitled to back wages, benefits, and other compensation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7c1VB2r0e4p3j29LRTGV3q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7c1VB2r0e4p3j29LRTGV3q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOtHAspaFqAn6etwaV6JMm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBUe0cQF64tyOYgN6tqTSLm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>446 Americans With Disabilities - Other (PACER NoS)</rdfs:label>
        <skos:definition>Action of discrimination against an individual with disabilities in areas other than employment, filed under 42 U.S.C. § 12133 (exclusion or discrimination in provision of services, programs or activities of a public entity) or 42 U.S.C. § 12188 (public accommodations)</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7c1yU31BO5LWM06a7c0Pfd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7c1yU31BO5LWM06a7c0Pfd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
        <rdfs:label>Some Evidence</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Algumas evidências</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Alguna evidencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Alguna evidencia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Certaines preuves</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Einige Beweise</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Some Evidence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חלק מהראיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कुछ सबूत</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">いくつかの証拠</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">一些证据</skos:altLabel>
        <skos:definition>Some Evidence refers to any type of proof or information presented in a legal case that supports one party&apos;s argument or position, and falls under the burden of proof required in litigation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7c3W8aJ9ioW0cUmHmSP7RL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7c3W8aJ9ioW0cUmHmSP7RL">
