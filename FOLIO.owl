        <skos:altLabel xml:lang="es-es">Moción de nuevo juicio - Deliberaciones impropias del jurado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de nuevo juicio - Deliberaciones impropias del jurado</skos:altLabel>
