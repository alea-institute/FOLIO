        <rdfs:label>Extradition Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Auslieferungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Extradition Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Extradición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Extradición</skos:altLabel>
