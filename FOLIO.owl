        <rdfs:label>Probate due to Financial Exploitation</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Inventário devido à exploração financeira</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nachlassverfahren aufgrund von finanzieller Ausbeutung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Probate due to Financial Exploitation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Succession en raison d&apos;une exploitation financière</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Sucesión por explotación financiera</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sucesión por explotación financiera</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פרובייט עקב ניצול כספי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वित्तीय शोषण के कारण प्रोबेट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因财务剥削而产生的遗产清算</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">財務的搾取による遺産分割手続き</skos:altLabel>
        <skos:definition>Probate due to Financial Exploitation: The legal process of distributing the assets of a deceased person who was financially exploited during their lifetime, as a reason for filing a probate case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDgEiiX23zftUP0Mggfc68n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDgEiiX23zftUP0Mggfc68n">
