        <skos:altLabel xml:lang="pt-br">Reivindicações constitucionais dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendications constitutionnelles américaines</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">U.S. Constitutional Claims</skos:altLabel>
