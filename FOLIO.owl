    <!-- https://folio.openlegalstandard.org/RD2zOAhFnr74YvmiP6yNXOE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RD2zOAhFnr74YvmiP6yNXOE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sHH7RvjZ6aZS7ZExDpYmR"/>
        <rdfs:label>Natural Hair</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Cabelo natural</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Cheveux naturels</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Natürliche Haare</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ナチュラルヘア</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">天然头发</skos:altLabel>
        <skos:definition>Natural hair refers to the unaltered texture and style of an individual&apos;s hair, typically associated with the unique characteristics of various racial and ethnic groups, particularly those of African descent. Several jurisdictions have enacted laws or guidelines to protect individuals from discrimination based on their natural hair, including the CROWN Act in the United States, which prohibits discrimination in employment, housing, and education based on hair texture or protective hairstyles such as braids, locs, or twists.</skos:definition>
    </owl:Class>
    


