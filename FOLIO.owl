        <dc:identifier>BCS-REPM</dc:identifier>
        <rdfs:label>Repair and Maintenance Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de Reparación y Mantenimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Reparación y Mantenimiento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de la réparation et de la maintenance</skos:altLabel>
