        <skos:altLabel xml:lang="ja-jp">コンゴ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">刚果</skos:altLabel>
        <skos:definition>Kongo (Language) is a structured system of communication that consists of grammar and vocabulary used in the Kongo region of Africa.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDn0b6dDytXqi3nEm99XM4O -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDn0b6dDytXqi3nEm99XM4O">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ly82UzT3qEXtZR0pcZq8L"/>
        <rdfs:label>Bipolar Disorder</rdfs:label>
        <skos:altLabel>Bipolar Condition</skos:altLabel>
        <skos:altLabel>Bipolar Mental Disorder</skos:altLabel>
        <skos:altLabel>Bipolar Mood Disorder</skos:altLabel>
        <skos:altLabel>Manic-Depressive Illness</skos:altLabel>
        <skos:definition>Bipolar Disorder is a psychiatric condition characterized by extreme mood swings that include emotional highs (mania or hypomania) and lows (depression). These mood swings can affect energy levels, activity, behavior, and the ability to carry out daily tasks, often requiring long-term treatment to manage symptoms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDnCt3sjeU7doO2F3MVbkfg -->

