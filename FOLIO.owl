        <rdfs:label>Georgia Superior Court - Candler County</rdfs:label>
        <skos:definition>Georgia Superior Court - Candler County: A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Candler County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9YUcieLvwqkhpwyuTCZX9g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9YUcieLvwqkhpwyuTCZX9g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKOcs51IQGZ9MeUqtONIlc"/>
        <rdfs:label>Income from Business Ventures (Not Actively Managed)</rdfs:label>
        <skos:altLabel>Investment Business Income</skos:altLabel>
        <skos:altLabel>Non-Managed Business Earnings</skos:altLabel>
        <skos:altLabel>Passive Business Income</skos:altLabel>
        <skos:altLabel>Silent Partner Income</skos:altLabel>
        <skos:definition>Income from Business Ventures (Not Actively Managed) refers to earnings derived from business activities in which the owner does not participate in the day-to-day operations or management. This passive business income can come from investments in limited partnerships, silent partnerships, or other business arrangements where the investor&apos;s role is primarily financial.</skos:definition>
        <skos:prefLabel>Passive Business Earnings</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9YaW0nGKZ57Vp8udUt60d5 -->

