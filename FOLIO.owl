        <rdfs:label>Proceeding Reopened</rdfs:label>
        <skos:altLabel>Case Reopened</skos:altLabel>
        <skos:definition>The concept of &quot;Case Reopened&quot; refers to a legal matter that was previously closed or resolved, but has now been reopened for further proceedings or consideration.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIaHjndY8TxGhHZoz0cK0ug -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIaHjndY8TxGhHZoz0cK0ug">
