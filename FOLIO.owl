        <skos:altLabel xml:lang="es-es">Cláusula de Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Modificación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de alteração</skos:altLabel>
