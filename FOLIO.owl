    <!-- https://folio.openlegalstandard.org/R4p7hCW8i9ZoWoZKGmzfPR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R4p7hCW8i9ZoWoZKGmzfPR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7vBjMmDitSBmBKZvNugCLG"/>
        <rdfs:label>Bankruptcy Chapter 11 Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bankruptcy Chapter 11 Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Insolvenz Kapitel 11 Forderung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Capítulo 11 de Bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Capítulo 11 de Quiebra</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de falência Capítulo 11</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de faillite Chapitre 11</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת פרק 11 של בנקרותפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन अध्याय 11 दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产第11章索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産第11章請求</skos:altLabel>
        <skos:definition>A Bankruptcy Chapter 11 Claim is a request for payment made by a creditor in a Chapter 11 bankruptcy case, which allows a debtor to reorganize their finances and operations while still operating their business.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4pYCvaJ8nADRG8NCwgCoa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R4pYCvaJ8nADRG8NCwgCoa">
