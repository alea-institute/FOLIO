        <skos:altLabel xml:lang="zh-cn">税率总税</skos:altLabel>
        <skos:definition>The Tax Tier Total Tax is a subcategory of Tax Tier Detail and refers to the total amount of taxes owed.</skos:definition>
    </owl:Class>
    


