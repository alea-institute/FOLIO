    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dueCtz3A8gWIindavNGTL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7dueCtz3A8gWIindavNGTL">
