    <!-- https://folio.openlegalstandard.org/RChy6UdMyK00R5BTVT8lxaa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RChy6UdMyK00R5BTVT8lxaa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC339aKhjRAuw4JtEQUn5xw"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkYo3iSgwRUW6XZnWD2PzD"/>
        <rdfs:label>Motion to Strike Allegations of the Complaint</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Streichung von Vorwürfen der Klage</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para eliminar las alegaciones de la demanda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion en vue de rejeter les allégations de la plainte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Strike Allegations of the Complaint</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Excluir Alegações da Petição Inicial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Promoción para desechar las alegaciones de la demanda</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להסרת הטענות בתביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा के आरोपों को हटाने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销起诉状中的指控动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴状の主張の削除を求める動議</skos:altLabel>
        <skos:definition>A Motion to Strike Allegations of the Complaint is a formal request made by a party in a legal case to remove certain allegations or claims made by the opposing party from the complaint, on the grounds that they are irrelevant, improper, or otherwise inadmissible.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RChyLUYm0W5R3E1yQl08Id9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RChyLUYm0W5R3E1yQl08Id9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9DCJMzRXnPZMWQqQuPLECx"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R893WuLNcjYcvHeSARS2KH1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Female Market Segment</rdfs:label>
        <skos:definition>The female market segment refers to a division of the market that is specifically targeted towards female consumers. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of women, taking into account factors such as lifestyle, life stage, and purchasing behavior.</skos:definition>
        <skos:example>Women&apos;s Clothing Retailer</skos:example>
        <skos:example>Women&apos;s Health Product</skos:example>
        <skos:prefLabel>Women&apos;s Market Segment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCi6sGTcxzS6cbNNfNm5Tr2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCi6sGTcxzS6cbNNfNm5Tr2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq6neiK9deZLSfSa41jylg"/>
        <rdfs:label>Professional Liability Insurance Policy</rdfs:label>
        <skos:definition>Professional liability insurance, often called &quot;errors and omissions&quot; insurance, protects against claims of negligence or harm caused by professional advice or services. This is particularly important for professions such as doctors, lawyers, and consultants, where the service provided could potentially lead to financial loss or harm for the client.</skos:definition>
        <skos:prefLabel>Errors and Omissions Insurance Policy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCi7RfKkkmw6lGMEMbhezRG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCi7RfKkkmw6lGMEMbhezRG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
        <rdfs:label>Conflict of Interest</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Conflict of Interest</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Conflicto de Intereses</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Conflicto de Interés</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Conflit d&apos;intérêts</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Conflito de interesses</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Interessenkonflikt</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סכסוך עניינים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हित विरोध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">利益冲突</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">利益相反</skos:altLabel>
        <skos:definition>A conflict of interest is a situation where a person or entity has competing interests or loyalties that may interfere with their ability to act impartially or in the best interest of another party, particularly in the context of civil claims.</skos:definition>
    </owl:Class>
    


