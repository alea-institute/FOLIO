    <!-- https://folio.openlegalstandard.org/R9pcZTJcv96oYKsXQKopCTi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9pcZTJcv96oYKsXQKopCTi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Dxh7cqKFFJ2jKNTvICMhf"/>
        <rdfs:label>Space Force</rdfs:label>
        <skos:altLabel>A Space Force is a military branch dedicated to space warfare and space operations, responsible for developing, maintaining, and operating space-based assets for national security and military purposes. This organization focuses on protecting a nation&apos;s interests in space, supporting other military branches with space-based capabilities, and potentially conducting offensive and defensive operations in the space domain.</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
        <rdfs:label>Callable Asset</rdfs:label>
        <skos:altLabel>Callable Financial Instrument</skos:altLabel>
        <skos:altLabel>Callable Instrument</skos:altLabel>
        <skos:definition>A Callable Asset is a financial instrument that can be redeemed or repaid by the issuer before its specified maturity date, at the issuer&apos;s discretion. This feature allows the issuer to take advantage of favorable interest rate movements or other financial conditions, often resulting in the repayment of the principal and cessation of interest payments prior to the original maturity date.</skos:definition>
        <skos:prefLabel>Call Option Asset</skos:prefLabel>
    </owl:Class>
    


