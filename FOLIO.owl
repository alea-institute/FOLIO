        <rdfs:label>Missouri Circuit Court - Ste. Genevieve County</rdfs:label>
        <skos:definition>Missouri Circuit Court - Ste. Genevieve County: A specific court within the Missouri Circuit Court system that has jurisdiction over legal proceedings in Ste. Genevieve County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HlxYOQb4WGC3goxZENvJs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HlxYOQb4WGC3goxZENvJs">
