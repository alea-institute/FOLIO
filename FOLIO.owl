        <rdfs:label>Arkansas Circuit Court - Cleburne Cty.</rdfs:label>
        <skos:definition>The Arkansas Circuit Court - Cleburne Cty. is a specific court within the Arkansas Circuit Court system that has jurisdiction over legal matters within Cleburne County, Arkansas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9k6fCcFUIbJ8aE6Tk6jLnA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9k6fCcFUIbJ8aE6Tk6jLnA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkKltCs6qv3E5GLBaSJ8H4"/>
        <rdfs:label>Union Certification Election</rdfs:label>
        <skos:altLabel>Employee Representative Election Certification</skos:altLabel>
        <skos:altLabel>NLRB Representation Certification</skos:altLabel>
        <skos:definition>A formal process by which the regulator (e.g., National Labor Relations Board (NLRB)) certifies a union or other employee organization as the official representative of a group of employees, typically after an election. Certification occurs when the union wins the majority of votes cast in a secret-ballot election overseen by the regulator (e.g., NLRB).</skos:definition>
        <skos:prefLabel>Employee Representative Certification</skos:prefLabel>
    </owl:Class>
    


