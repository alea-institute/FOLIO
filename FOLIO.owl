        <skos:altLabel>K-2 Visa</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8WhsyEOse5TvMLfnHDYfTY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8WhsyEOse5TvMLfnHDYfTY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDx4PuWu7ZznwNEGW6rXll0"/>
        <rdfs:label>Stone Fruits</rdfs:label>
        <skos:altLabel>Drupes</skos:altLabel>
        <skos:altLabel>Hard Stone Fruits</skos:altLabel>
        <skos:altLabel>Pitted Fruits</skos:altLabel>
        <skos:definition>Stone fruits, also known as drupes, are fruits characterized by a fleshy exterior surrounding a hard pit or &quot;stone&quot; that encases the seed. They are typically grown in temperate climates and are valued for their sweet, juicy flesh and nutritional content, which includes vitamins, minerals, and antioxidants.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8WnrUA2CS73Xe482K0icqD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8WnrUA2CS73Xe482K0icqD">
