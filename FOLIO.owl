        <skos:definition>The act of an employer taking adverse action against an employee in response to the employee engaging in protected activity, such as reporting illegal conduct or filing a workers&apos; compensation claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7iwDpIEUmQx7Aa4xSVdq6C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7iwDpIEUmQx7Aa4xSVdq6C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Southern Cheyenne</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7izk0vH7DaKT6uxrqkIVci -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7izk0vH7DaKT6uxrqkIVci">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Add Creditors</rdfs:label>
        <skos:definition>A Motion to Add Creditors is a formal request filed in a bankruptcy case by the debtor to include additional creditors not originally listed in the initial bankruptcy schedules. This motion ensures that all relevant parties are notified of the bankruptcy proceedings and can participate in the distribution of assets or discharge of debts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7izoOZfRyRNtXJzVRPJwEB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7izoOZfRyRNtXJzVRPJwEB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9KvzcwdZ3asqh9BPZRGWR7"/>
        <dc:identifier>ENTITY-BUSTRST</dc:identifier>
        <rdfs:label>Business Trust</rdfs:label>
        <skos:altLabel>Business Trust</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fiducie d&apos;entreprise</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fundo de Negócios</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unternehmensvertrauen</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ビジネストラスト</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">商业信托</skos:altLabel>
        <skos:definition>A business trust is a form of business organization which is similar to a corporation, in which investors receive transferable certificates of beneficial interest.</skos:definition>
        <skos:hiddenLabel>BUSTRST</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7j2IfXCYk8tQmT4uFLqBHU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7j2IfXCYk8tQmT4uFLqBHU">
