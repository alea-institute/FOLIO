        <skos:altLabel xml:lang="zh-cn">服务范围条款</skos:altLabel>
        <skos:definition>A Scope of Services Clause is a provision in a contract that defines the specific services that a party is obligated to provide under the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4kKwslK0vcrHd0SfSyVBA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R4kKwslK0vcrHd0SfSyVBA">
