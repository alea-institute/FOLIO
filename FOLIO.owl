    <!-- https://folio.openlegalstandard.org/RF9AwkS42RlCsoilN4rTSOA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RF9AwkS42RlCsoilN4rTSOA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RozngCLFFS3CuoIzXO44N9A"/>
        <rdfs:label>TR630 Official Communication - International</rdfs:label>
        <skos:definition>All action associated with processing an Official Communication from a Trademark Office outside the home country of the applicant in connection with an application filed under TR500, including initial review and calendaring of any response deadline, report to client with any proposed response, review of applicant&apos;s instructions and comments, preparation of amendments and/or responsive arguments, submitting response to local counsel, and report of actions to the client. Includes activities associated with Official Communications not affecting the merits of the application, such as receipt of Certificate of Registration, petitions, and other requests for supervisory action that are not decided by a quasi-judicial or appellate tribunal within the Trademark Office.</skos:definition>
        <skos:prefLabel>TR630 Official Communication - International</skos:prefLabel>
    </owl:Class>
    


