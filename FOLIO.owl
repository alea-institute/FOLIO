        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Authority</rdfs:label>
        <skos:altLabel>Legal Authority</skos:altLabel>
        <skos:definition>Authority is the legal power or right to give orders, make decisions, and enforce obedience.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9im5qokc06nTAz2xYem2ck -->

