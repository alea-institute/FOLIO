    <!-- https://folio.openlegalstandard.org/RCiKuv8GFsXa7eXNCLkw9A1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCiKuv8GFsXa7eXNCLkw9A1">
