        <rdfs:label>Car Renter Liable for Injury</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Arrendatario del auto responsable de lesiones</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Arrendatario del coche responsable de lesiones</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Autovermieter haftet für Verletzungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Car Renter Liable for Injury</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Le loueur de voiture est responsable des blessures</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Locatário de carro responsável por lesão</skos:altLabel>
        <skos:altLabel xml:lang="he-il">השוכר של הרכב אחראי לפגיעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार किराएदार घायली के लिए जिम्मेदार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">租车人对伤害负责</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">車のレンタル業者は負傷に対して責任を負う</skos:altLabel>
        <skos:definition>A legal principle that holds a person who rents a car responsible for any injuries or damages caused by the car while it is in their possession.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMMxJxCYv0BGt8jtwWedzO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBMMxJxCYv0BGt8jtwWedzO">
