        <skos:altLabel xml:lang="es-mx">Transacción Especificada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Transaction spécifiée</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Transação Específica</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עסקאות מסוימות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्दिष्ट लेनदेन</skos:altLabel>
