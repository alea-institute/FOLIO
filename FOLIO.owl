        <skos:definition>Freeform text describing a matter&apos;s resolution (e.g., jury verdict, settlement, deal closing).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R73rAd7aEDnybpBUUsIGhGb -->

