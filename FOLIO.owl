        <skos:definition>A Consent in Lieu of Meeting Clause is a provision in a contract that allows parties to give their consent to a proposed action without the need for a formal meeting.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7iR8rxIoymNuxMi7I0oh1d -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7iR8rxIoymNuxMi7I0oh1d">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88m06glAkTkIFNVlAF30zy"/>
        <rdfs:label>AI Governance</rdfs:label>
        <skos:altLabel>AI Ethical Governance</skos:altLabel>
        <skos:altLabel>AI Management Framework</skos:altLabel>
        <skos:altLabel>AI Oversight</skos:altLabel>
        <skos:altLabel>AI Policy Framework</skos:altLabel>
        <skos:definition>AI Governance refers to the frameworks, policies, and practices that guide the ethical development, deployment, and oversight of artificial intelligence systems. It encompasses the establishment of standards and regulations to ensure AI systems are transparent, accountable, and aligned with societal values and ethical principles</skos:definition>
        <skos:prefLabel>AI Regulatory Governance</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7iSh4AXN4oJuPPGv1KQDnD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7iSh4AXN4oJuPPGv1KQDnD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <rdfs:label>Freedom from War and Armed Conflict</rdfs:label>
        <skos:definition>Freedom from war and armed conflict is a human aspiration often reflected in international humanitarian law, which seeks to limit the effects of armed conflict on people and communities. While not always explicitly defined as a &quot;right,&quot; various international treaties like the Geneva Conventions aim to protect civilians, prisoners of war, and combatants from unnecessary suffering and violence during times of conflict.</skos:definition>
    </owl:Class>
    


