        <skos:altLabel xml:lang="pt-br">expectativa de vida reduzida</skos:altLabel>
        <skos:altLabel xml:lang="de-de">verkürzte Lebenserwartung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צפייה בקצב חיים מופחתת</skos:altLabel>
