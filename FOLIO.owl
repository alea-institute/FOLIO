        <skos:example>Boats (except pleasure) merchant wholesalers</skos:example>
        <skos:example>Motorized passenger golf carts merchant wholesalers</skos:example>
        <skos:example>Railroad cars merchant wholesalers</skos:example>
        <skos:example>Ships merchant wholesalers</skos:example>
    </owl:Class>
    


