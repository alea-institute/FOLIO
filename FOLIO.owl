        <skos:altLabel xml:lang="es-mx">Tipo de juicio: con juez o con jurado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tipo de julgamento: Juiz ou Júri</skos:altLabel>
        <skos:altLabel>Trial Type</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial Type: Bench or Jury</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Type de procès : banc ou jury</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוג המשפט: בית משפט או חברתי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल प्रकार: बेंच या ज्यूरी</skos:altLabel>
