        <rdfs:label>DNA Test</rdfs:label>
        <rdfs:seeAlso>A DNA test involves analyzing an individual&apos;s deoxyribonucleic acid (DNA) to gather information or assess and confirm familial relationships. This type of testing has applications in various fields, from forensics to medicine to genealogy.</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ha3ZsRGkpSH9B276WKtLQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ha3ZsRGkpSH9B276WKtLQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sbuHkJC9aqDlHAgw58VSB"/>
        <rdfs:label>Provincial Court</rdfs:label>
        <skos:definition>Provincial Court refers to a court of law that has jurisdiction over cases within a specific province or territory, and is a type of court forum within the legal system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hbhbabXZds6x920J057L -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hbhbabXZds6x920J057L">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NkMt6XJKd4fSolKqqOy5B"/>
        <rdfs:label>Sales Tax Payment</rdfs:label>
        <skos:altLabel>Sales Tax Remittance</skos:altLabel>
        <skos:altLabel>Sales Taxes</skos:altLabel>
        <skos:altLabel>Single-Stage Sales Tax</skos:altLabel>
        <skos:altLabel>Single-Stage Tax Payment</skos:altLabel>
        <skos:altLabel>Transaction Tax Payment</skos:altLabel>
        <skos:definition>Sales Tax Payment refers to general taxes levied on the sale of goods and services at a single stage in the supply chain, which could be at the manufacturing, production, wholesale, or retail stage. These taxes are typically collected by the seller at the point of sale and remitted to the government.</skos:definition>
        <skos:prefLabel>Retail Sales Tax Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hd1b9kd5W7dxgaICmwgPu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hd1b9kd5W7dxgaICmwgPu">
