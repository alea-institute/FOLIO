        <skos:altLabel>Mobile Wallet Payment</skos:altLabel>
        <skos:definition>Mobile Payment is the use of mobile devices, such as smartphones and tablets, to conduct financial transactions, typically facilitated by a mobile payment application. This modality enables convenient, remote access to funds for both online and in-person transactions.</skos:definition>
        <skos:prefLabel>Digital Wallet Payment</skos:prefLabel>
    </owl:Class>
    


