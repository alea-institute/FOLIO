        <skos:altLabel xml:lang="ja-jp">棄権動議</skos:altLabel>
        <skos:definition>A Motion for Abstention is a request made in a bankruptcy case asking the court to abstain or refrain from hearing the case, usually because it would be more appropriate for another court to handle it.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9MLcIMghS2w6bPUQjXTrOG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9MLcIMghS2w6bPUQjXTrOG">
