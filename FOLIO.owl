            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8phitqyUIXJ4ZdLaJjabna"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Trademark Dilution</rdfs:label>
        <skos:altLabel xml:lang="es-es">Dilución de la marca</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Dilución de la marca</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Diluição de marca</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dilution de marque</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Markenverwässerung</skos:altLabel>
        <skos:altLabel>Service Mark Dilution</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trademark Dilution</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דילול מותג</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रेडमार्क दिलूटियन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">商标侵权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">商標の希釈</skos:altLabel>
        <skos:definition>Trademark Dilution is a legal claim that arises when a party uses a similar or identical trademark to another party&apos;s famous mark, causing a likelihood of dilution of the distinctive quality of the famous mark.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcyQuaYdvmOmAVROvfH6sk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcyQuaYdvmOmAVROvfH6sk">
