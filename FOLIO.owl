        <rdfs:label>Viejas (Baron Long) Group of the Capitan Grande Band</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d7zHvvqebdTDIDyRnp0Gs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d7zHvvqebdTDIDyRnp0Gs">
