            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion to Transfer Venue</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlegung des Gerichtsstands</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de cambio de sede</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de traslado de jurisdicción</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion de transfert de compétence</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Transfer Venue</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Transferência de Foro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להעברת מקום דיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्थानांतरण के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">管轄権移転請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">转移管辖权动议</skos:altLabel>
        <skos:definition>A Motion to Transfer Venue is a formal request made to a court to change the location of a legal proceeding to a different jurisdiction or court for reasons such as convenience or fairness.</skos:definition>
        <skos:prefLabel>Motion for Change of Venue</skos:prefLabel>
    </owl:Class>
    


