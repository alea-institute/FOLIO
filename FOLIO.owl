        <skos:altLabel xml:lang="he-il">וינדליזם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपद्रव</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破坏行为</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破壊行為</skos:altLabel>
        <skos:definition>DEFINITION OF Destruction/Damage/Vandalism of Property — To willfully or maliciously destroy, damage, deface, or otherwise injure real or personal property without the consent of the owner or the person having custody or control of it.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNzK4mYLHYdWVX8U2etw8K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNzK4mYLHYdWVX8U2etw8K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:label>Management&apos;s Discussion and Analysis</rdfs:label>
        <skos:altLabel>Management Commentary</skos:altLabel>
        <skos:altLabel>Management Financial Overview</skos:altLabel>
        <skos:definition>MD&amp;A, or Management&apos;s Discussion and Analysis, is a section often included in annual and quarterly reports that provides an overview of the company&apos;s financial condition and operational performance. It is presented from the perspective of management and aims to offer insights into past performance, future plans, and material risks.</skos:definition>
        <skos:prefLabel>MD&amp;A</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBO0DLd2qo3wXWxSyOLGmC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBO0DLd2qo3wXWxSyOLGmC">
