        <skos:altLabel xml:lang="de-de">Falschdarstellung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Misrepresentation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Má representação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Representación errónea</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Representación errónea</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tromperie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מרמות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गलत तरीके से प्रतिनिधित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">虚假陈述</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">誤認表示</skos:altLabel>
        <skos:definition>A misrepresentation is a false statement made by one party to another, which induces the other party to enter into a contract or take some other action, and which causes harm or damages to the other party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RREWb9UESRNa-HsOzkm5jBA -->

