        <rdfs:label>Consumer Loan Broker Acting Improperly</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Consumer Loan Broker Acting Improperly</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Corredor de préstamos al consumidor actuando de manera inapropiada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Corredor de préstamos al consumidor actuando de manera inapropiada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Corretor de empréstimo ao consumidor agindo de forma imprópria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Courtier en prêts à la consommation agissant de manière inappropriée</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verbraucherdarlehensvermittler handelt unangemessen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוכן הלוואות לצרכן פועל באופן לא תקין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपभोक्ता ऋण ब्रोकर अनुचित ढंग से काम कर रहा है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">消費者ローンブローカーが不適切に行動している</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">消费贷款经纪人行为不当</skos:altLabel>
        <skos:definition>A Consumer Loan Broker Acting Improperly refers to a situation where a broker who arranges loans for consumers engages in unethical or illegal behavior, such as misrepresenting loan terms or charging excessive fees.</skos:definition>
        <skos:prefLabel>Predatory Lending Claim</skos:prefLabel>
    </owl:Class>
    


