        <rdfs:label>Indiana Circuit Court - Marion County</rdfs:label>
        <skos:definition>The Indiana Circuit Court - Marion County is a specific court within the Indiana Circuit Court system that has jurisdiction over legal proceedings in Marion County.</skos:definition>
    </owl:Class>
    


