        <rdfs:label>Hyperglycemia</rdfs:label>
        <skos:altLabel>Elevated Blood Sugar</skos:altLabel>
        <skos:altLabel>High Blood Glucose</skos:altLabel>
        <skos:definition>Hyperglycemia is an abnormally high level of blood glucose that can result from inadequate insulin production or insulin resistance. It may produce both acute and long-term complications affecting various body systems.</skos:definition>
        <skos:prefLabel>High Blood Sugar</skos:prefLabel>
    </owl:Class>
    


