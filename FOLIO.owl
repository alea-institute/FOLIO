        <rdfs:label>Physical Asset Delivery</rdfs:label>
        <skos:altLabel>Actual Delivery</skos:altLabel>
        <skos:altLabel>Physical Delivery Settlement</skos:altLabel>
        <skos:altLabel>Physically-Delivered Settlement</skos:altLabel>
        <skos:altLabel>Tangible Asset Settlement</skos:altLabel>
        <skos:altLabel>Underlying Instrument Delivery</skos:altLabel>
        <skos:definition>Physical Asset Delivery refers to the settlement of a contract, financial instruments, or assets through the receipt or delivery of the actual underlying instruments instead of cash. This method is common in derivative contracts, where fulfilling the settlement obligation involves the transfer of the physical underlying asset.</skos:definition>
    </owl:Class>
    


