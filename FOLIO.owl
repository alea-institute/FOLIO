        <skos:altLabel xml:lang="fr-fr">Clause de fusion</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Fusión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Fusión</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de fusão</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Merger Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verschmelzungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מיזוג</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विलय शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合併条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合并条款</skos:altLabel>
        <skos:definition>A merger clause is a contractual clause that specifies that the written agreement represents the entire agreement between the parties and supersedes any prior or contemporaneous oral or written agreements or understandings.</skos:definition>
    </owl:Class>
    


