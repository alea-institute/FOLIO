        <rdfs:label>Oregon Circuit Court - Jackson County</rdfs:label>
        <skos:definition>Oregon Circuit Court - Jackson County: A court of general jurisdiction in Oregon that hears civil and criminal cases within Jackson County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4fmfFKxGY20psnoLlPkDW -->

