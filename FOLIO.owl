        <rdfs:label>Mortgage Contingency Loan Exacting Illegal Commission</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Empréstimo de contingência hipotecária, comissão ilegal exata</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hypotheken-Kontingenzdarlehen, exakte illegale Provision</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mortgage Contingency Loan Exacting Illegal Commission</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Préstamo con contingencia hipotecaria que exige comisión ilegal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Préstamo con contingencia hipotecaria que exige comisión ilegal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Prêt de contingence hypothécaire, commission illégale exacte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הלוואת תנאי משכנתא מוציאה עמלה בלתי חוקית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋण नियमितता ऋण अवैध कमीशन को निष्कर्षित करता है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">抵当権付き条件付きローン、正確な違法手数料</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">按揭附带条件贷款，精确的非法佣金</skos:altLabel>
        <skos:definition>A Mortgage Contingency Loan Exacting Illegal Commission is a type of loan in which the lender charges an illegal commission to the borrower, and the loan is contingent upon the borrower obtaining a mortgage.</skos:definition>
    </owl:Class>
    


