            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Physical Intrusion</rdfs:label>
        <skos:definition>Physical intrusion, also known as Breaking and entering, is the act of entering a building or other property without authorization. It can also include entering through fraud, threats, or collusion.</skos:definition>
        <skos:prefLabel>Breaking and Entering</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfdb8MayZaABJg6QubdTeu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfdb8MayZaABJg6QubdTeu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ZlXt0J1JMbXm6T0xEg2SO"/>
        <rdfs:label>Variable Rate Dividend Payment</rdfs:label>
        <skos:altLabel>Floating Rate Dividend</skos:altLabel>
        <skos:altLabel>Floating Rate Payment</skos:altLabel>
        <skos:altLabel>Variable Dividend Payment</skos:altLabel>
        <skos:definition>Variable Rate Payment, also known as Adjustable Rate Payment, refers to a type of dividend income where the dividend rate is periodically adjusted, typically based on a benchmark yield or market interest rates. This adjustment allows the dividend payments to fluctuate with changing economic conditions.</skos:definition>
        <skos:prefLabel>Adjustable Rate Dividend Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
        <dc:identifier>RET</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=44"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=45"/>
        <rdfs:label>Retail Trade Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einzelhandelsbranche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria del Comercio Minorista</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria del Comercio al por Menor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie du commerce de détail</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria do comércio varejista</skos:altLabel>
        <skos:altLabel>Retail Trade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Retail Trade Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית מסחר בקמעונאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खुदरा व्यापार उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">小売業界</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">零售贸易行业</skos:altLabel>
        <skos:definition>The Retail Trade industry group comprises establishments engaged in retailing merchandise, generally without transformation, and rendering services incidental to the sale of merchandise. The retailing process is the final step in the distribution of merchandise; retailers are, therefore, organized to sell merchandise in small quantities to the general public. This sector comprises two main types of retailers: store and nonstore retailers.</skos:definition>
        <skos:hiddenLabel>RET</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfeGpPrijZkvT8pR4lT1aC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfeGpPrijZkvT8pR4lT1aC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB45dXxacmQbbLYaT8gCptW"/>
        <rdfs:label>Underage Betting</rdfs:label>
        <skos:altLabel>Juvenile Gambling</skos:altLabel>
        <skos:altLabel>Minor Betting</skos:altLabel>
        <skos:altLabel>Underage Gambling</skos:altLabel>
        <skos:definition>Underage Betting refers to the illegal practice of individuals below the legal age limit participating in gambling activities, either online or at physical venues. This activity violates gambling laws and regulations designed to protect minors from the risks associated with gambling.</skos:definition>
        <skos:prefLabel>Youth Gambling</skos:prefLabel>
    </owl:Class>
    


