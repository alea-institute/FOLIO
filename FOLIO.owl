        <skos:altLabel xml:lang="es-es">Transferencia de fondos mal gestionada por el banco</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Transferencia de fondos mal gestionada por el banco</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Transferência de fundos mal gerenciada pelo banco</skos:altLabel>
