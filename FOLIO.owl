        <skos:altLabel xml:lang="fr-fr">Motion de retrait d&apos;avocat</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Withdraw as Counsel</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Retirada de Advogado</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לסיום עזיבת עו&quot;ד</skos:altLabel>
