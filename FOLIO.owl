        <rdfs:label>Credit Theft</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Credit Theft</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kreditdiebstahl</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Robo de crédito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Robo de crédito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Roubo de crédito</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vol de crédit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גניבת זיכויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रेडिट चोरी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クレジット盗難</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">信用盗窃</skos:altLabel>
        <skos:definition>The act of taking someone&apos;s personal information without their consent and using it to obtain credit or loans in their name.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfgMJEBmJrI7Wp0zUjROJ3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfgMJEBmJrI7Wp0zUjROJ3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBY4j5UKZ7L8gp0q9Wrxyge"/>
        <rdfs:label>Temporary Employee</rdfs:label>
        <skos:definition>A Temporary Employee is an individual hired for a specific, limited period, often to assist with seasonal workloads or to fill in for a regular employee who is absent. Temporary employees may or may not have access to company benefits, and their employment is generally terminated when the specified period or project is completed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfi3eGJmdDDpV4EDEf8lVL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfi3eGJmdDDpV4EDEf8lVL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
        <rdfs:label>Confabulation</rdfs:label>
        <skos:altLabel>AI Hallucination</skos:altLabel>
        <skos:definition>Confabulations, also known as &quot;hallucinations,&quot; occur when generative AI systems produce inaccurate or false responses that appear plausible to the user. This phenomenon often involves the invention of erroneous information, such as historical or biographical details, and results from statistical prediction, repetition of training data, or learned patterns.</skos:definition>
        <skos:prefLabel>Hallucination</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfjycAy2MGoz0ZBxpZO1W2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBfjycAy2MGoz0ZBxpZO1W2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ztXl8BwOPON0CMPeL83QD"/>
        <rdfs:label>Beets</rdfs:label>
        <skos:altLabel>Beta Vulgaris</skos:altLabel>
        <skos:definition>Beets, also known as beetroot, are root vegetables from the Beta vulgaris species, characterized by their deep red color and sweet, earthy flavor. They are consumed raw, cooked, or juiced and are valued for their high nutritional content, including vitamins A and C, potassium, manganese, and dietary fiber, as well as their antioxidant properties.</skos:definition>
        <skos:prefLabel>Beetroot</skos:prefLabel>
    </owl:Class>
    


