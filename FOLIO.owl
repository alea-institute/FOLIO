        <skos:altLabel xml:lang="pt-br">Direito de Políticas Públicas e Assuntos Governamentais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit des politiques publiques et des affaires gouvernementales</skos:altLabel>
        <skos:altLabel>Public Policy and Government Affairs</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Public Policy and Government Affairs Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht der öffentlichen Politik und Regierungsangelegenheiten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משפט מדיניות ציבורית וענייני ממשל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक नीति और सरकारी कानून विषयक</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共政策および政府関連法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公共政策和政府事务法</skos:altLabel>
        <skos:definition>Rules surrounding lobbying and political advocacy.</skos:definition>
        <skos:hiddenLabel>PPGA</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDWI8MUWQm1rMjaPbJYLX21 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDWI8MUWQm1rMjaPbJYLX21">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Permitted Disclosure Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de divulgation autorisée</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Divulgación Permitida</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Divulgación Permitida</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Divulgação Permitida</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur zulässigen Offenlegung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Permitted Disclosure Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חשיפה מותרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुमति दी गई खुलासा धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">允许披露条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">許可された開示条項</skos:altLabel>
        <skos:definition>A Permitted Disclosure Clause is a provision in a contract that allows for the sharing of confidential information between parties under certain circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDWIJRl0fjTf5EmrklsBKSJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDWIJRl0fjTf5EmrklsBKSJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtrxZGwgTL594abOAwpDkz"/>
