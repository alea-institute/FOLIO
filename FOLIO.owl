        <skos:altLabel xml:lang="es-es">Demanda de indemnización por mala conducta del acreedor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Demanda de indemnización por mala conducta del acreedor</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Damages for Creditor Misconduct</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de indenização por má conduta do credor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en dommages-intérêts pour faute du créancier</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפיצויים עבור התנהגות לא תקינה של הגורם הנושה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋणदाता दोषदायी निर्वाह के लिए नुकसान के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債権者の不正行為に対する損害賠償請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因债权人不当行为提起的损害赔偿诉讼</skos:altLabel>
        <skos:definition>A Motion for Damages for Creditor Misconduct is a legal request made in a bankruptcy case by the debtor to seek compensation for any harm caused by the creditor&apos;s wrongful actions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vrLOm6RKTfx8fw40CYWsh -->

