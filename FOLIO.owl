        <rdfs:label>Motion in Limine to Exclude Testimony</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss von Zeugenaussagen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción en Limine para Excluir Testimonio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción en Limine para Excluir Testimonio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion en limine pour exclure le témoignage</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion in Limine to Exclude Testimony</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Exclusão de Depoimento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאפשר ראיות בלימיטציה לאפשר ראיות בלימיטציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाही को निकालने के लिए लिमिने में आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除证言的限制动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言の除外を求める動議</skos:altLabel>
        <skos:definition>A Motion in Limine to Exclude Testimony is a formal request made to a judge before a trial to prevent certain testimony or evidence from being presented to the jury.</skos:definition>
    </owl:Class>
    


