        <rdfs:label>Hospital Negligence</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Hospital Negligence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia Hospitalaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia Hospitalaria</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בבית חולים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अस्पताल लापरवाही</skos:altLabel>
        <skos:definition>Hospital Negligence refers to a legal claim against a medical facility for failing to provide adequate care or treatment to a patient, resulting in harm or injury.</skos:definition>
    </owl:Class>
    


