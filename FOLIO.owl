        <skos:altLabel xml:lang="pt-br">Tempestade em progresso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tempête en cours</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tormenta en progreso</skos:altLabel>
