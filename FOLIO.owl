        <skos:altLabel xml:lang="zh-cn">监狱局</skos:altLabel>
        <skos:definition>The Federal Bureau of Prisons (BOP) is a United States federal law enforcement agency. A subdivision of the U.S. Department of Justice, the BOP is responsible for the administration of the federal prison system.</skos:definition>
        <skos:hiddenLabel>BOP</skos:hiddenLabel>
        <skos:prefLabel>Bureau of Prisons</skos:prefLabel>
    </owl:Class>
    


