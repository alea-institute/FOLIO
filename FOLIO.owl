        <rdfs:label>Weddings Market Segment</rdfs:label>
        <skos:definition>The weddings market refers to a division of the market that is specifically targeted towards individuals and couples who are planning their wedding. This segment encompasses products and services that facilitate the planning and execution of weddings, from bridal wear and catering to venue selection and photography.</skos:definition>
        <skos:example>Bridal Wear (e.g., wedding dresses, suits, accessories)</skos:example>
        <skos:example>Wedding Catering Services</skos:example>
        <skos:example>Wedding Photography and Videography (e.g., photographers, videographers)</skos:example>
        <skos:example>Wedding Venues (e.g., churches, banquet halls, outdoor locations)</skos:example>
        <skos:prefLabel>Bridal Market</skos:prefLabel>
    </owl:Class>
    


