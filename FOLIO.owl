        <skos:altLabel xml:lang="he-il">תוכנית תקשורת לפרויקט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">परियोजना संचार योजना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プロジェクトコミュニケーションプラン</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">项目沟通计划</skos:altLabel>
