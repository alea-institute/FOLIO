        <skos:altLabel xml:lang="es-mx">Tipo de activo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tipo de ativo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Type d&apos;actif</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vermögenswerttyp</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוג נכס</skos:altLabel>
