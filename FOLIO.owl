        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325320"/>
        <rdfs:label>Pesticide and Other Agricultural Chemical Manufacturing</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the formulation and preparation of agricultural and household pest control chemicals (except fertilizers).</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/dc/terms/agent -->

    <owl:Class rdf:about="http://purl.org/dc/terms/agent">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R738y5iEyY6bm1AGMZeNq4A"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RysulJVLLFPkPX8Y2gHIAp"/>
        <rdfs:comment>an entity that acts or has the capability to act.</rdfs:comment>
        <rdfs:label>oasis:agent</rdfs:label>
        <skos:definition>An &quot;oasis:agent&quot; is a type of agent or actor within the context of the OASIS standard, which is used to represent individuals or organizations that are involved in some way in a particular activity or process.</skos:definition>
    </owl:Class>
    


