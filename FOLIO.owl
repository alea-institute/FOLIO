    <!-- https://folio.openlegalstandard.org/R54swe946hCCJQs9jVUwPp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R54swe946hCCJQs9jVUwPp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
        <rdfs:label>Personal Jurisdiction by Long-Arm Statute</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par statut de bras long</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Jurisdicción personal por estatuto de brazo largo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Jurisdicción personal por estatuto de brazo largo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por estatuto de braço longo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Long-Arm Statute</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit durch Long-Arm-Statut</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי חוק זרוע ארוכה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लॉन्ग-आर्म अधिनियम द्वारा व्यक्तिगत अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ロングアーム法による個人管轄権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">长臂法令下的个人管辖权</skos:altLabel>
        <skos:definition>The concept of Personal Jurisdiction by Long-Arm Statute refers to the authority of a court to exercise jurisdiction over a defendant who is not physically present within the court&apos;s territorial boundaries, but who has sufficient minimum contacts with the forum state as specified by the state&apos;s long-arm statute.</skos:definition>
    </owl:Class>
    


