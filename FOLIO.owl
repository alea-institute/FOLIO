    <!-- https://folio.openlegalstandard.org/R1EbxjQwzgikspixQygdfK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R1EbxjQwzgikspixQygdfK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4nwMYlRLa9aP9pKWIZEE"/>
        <rdfs:label>State of Mind or Body Objectives</rdfs:label>
        <skos:definition>State of Mind or Body Objectives refer to the purposes for admitting out-of-court statements that describe the declarant&apos;s then-existing mental, emotional, or physical condition, as well as statements made for purposes of medical diagnosis or treatment. These objectives are exceptions to the hearsay rule because they are believed to be reliable due to the declarant&apos;s lack of motive to fabricate and the importance of accurate information for medical treatment.</skos:definition>
    </owl:Class>
    


