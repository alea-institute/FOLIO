        <skos:altLabel xml:lang="zh-cn">实体特征</skos:altLabel>
        <skos:definition>Entity Characteristic refers to a distinguishing feature or attribute of a Legal Entity, such as whether it is a Private Company (Not Publicly Traded) or a Public Company (Publicly Traded).</skos:definition>
        <skos:prefLabel>Organization Characteristic</skos:prefLabel>
    </owl:Class>
    


