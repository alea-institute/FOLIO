        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8"/>
        <rdfs:label>Concert of Action Crimes</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Concert of Action Crimes</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Crimes de concertation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Crimes de concerto de ação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Delitos de Concierto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Delitos de Concierto</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Konzertierte Aktion Verbrechen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פשעי קונצרט של פעולה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार्यवाही के अनुयोज्य अपराध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">行动演唱会罪</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">行動コンサート犯罪</skos:altLabel>
        <skos:definition>Concert of Action Crimes refer to a group of criminal offenses where two or more individuals work together to commit a crime, and each member of the group is held responsible for the actions of the others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8isuEACdNwfDRTEb568iKY -->

