        <skos:altLabel xml:lang="es-mx">Feticidio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Feticídio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fetozid</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fœticide</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פטיקידה</skos:altLabel>
