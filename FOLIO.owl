        <rdfs:label>Motion Picture and Video Industries</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in the production and/or distribution of motion pictures, videos, television programs, or commercials; in the exhibition of motion pictures; or in the provision of postproduction and related services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UmtThKRlSUegdS0VuXOEVg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UmtThKRlSUegdS0VuXOEVg">
