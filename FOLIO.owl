        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
        <rdfs:label>Agency &amp; Vicarious Liability</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Agence et responsabilité vicariante</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Agencia y responsabilidad vicaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Agencia y responsabilidad vicaria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Agency &amp; Vicarious Liability</skos:altLabel>
        <skos:altLabel>Agency Claims</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Agentur und Stellvertreterhaftung</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Agência e responsabilidade vicária</skos:altLabel>
        <skos:altLabel>Vicarious Liability</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוכנות ואחריות חלופית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एजेंसी और विकारी दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">代理和代理责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">代理店と代理責任</skos:altLabel>
        <skos:definition>Agency &amp; Vicarious Liability refers to the legal responsibility of one party for the actions of another party who is acting on their behalf or under their control, such as an employer being held liable for the actions of their employee.</skos:definition>
    </owl:Class>
    


