        <rdfs:label>Educational Support Services</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/bPt-cu80TJqn1iEutviPvA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/bPt-cu80TJqn1iEutviPvA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/mNcLJvWOTFaGZevzn_LXQA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=335991"/>
        <rdfs:label>Carbon and Graphite Product Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing carbon, graphite, and metal-graphite brushes and brush stock; carbon or graphite electrodes for thermal and electrolytic uses; carbon and graphite fibers; and other carbon, graphite, and metal-graphite products.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/bQRurX9qSk2Pq-ywfZzaFw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/bQRurX9qSk2Pq-ywfZzaFw">
