        <rdfs:label>Lower Sioux Indian Community in the State of Minnesota</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDin1xJsNqPCl5y7yYSPVFi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDin1xJsNqPCl5y7yYSPVFi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCcONOqbeZp3iIDXbl7spOT"/>
        <rdfs:label>Demotion</rdfs:label>
        <skos:altLabel>Position Downgrade</skos:altLabel>
        <skos:altLabel>Role Reassignment</skos:altLabel>
        <skos:definition>Demotion is the reassignment of an employee to a lower rank, position, or salary grade, typically as a disciplinary measure or due to performance issues. This action reduces the employee&apos;s responsibilities, authority, and often their compensation.</skos:definition>
        <skos:prefLabel>Rank Reduction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiv7JSMR8QXdJG121JCQpP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiv7JSMR8QXdJG121JCQpP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSepz944v79Sc4zhy0qy2X"/>
        <rdfs:label>Long Form</rdfs:label>
        <skos:definition>A Long Form is an extensive version of a document that provides detailed terms, conditions, and provisions. It is used in various legal contexts, such as contracts, agreements, and reports, to ensure thorough coverage of all relevant aspects and legal requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDj7pgP2OjIDNhdPGJXy4Bo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDj7pgP2OjIDNhdPGJXy4Bo">
