        <rdfs:label>Judgment of Arbitration</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Judgment of Arbitration</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Laudo arbitral</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Laudo arbitral</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schiedsspruch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Sentence arbitrale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sentença arbitral</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פסק דין של פרשת דיני פילוג</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विवाद-सुलह का फैसला</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">仲裁判決</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">仲裁裁决</skos:altLabel>
        <skos:definition>A Judgment of Arbitration is a decision made by an arbitrator or panel of arbitrators in a dispute resolution process, which is binding on the parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81q0MYebZZv26XtzcIvVJ5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81q0MYebZZv26XtzcIvVJ5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9C5HcTGpZz9eYQaOrTS9e"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBLzDQdY5M3AjVUpILnB95K"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBUe0cQF64tyOYgN6tqTSLm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Disability Public Benefit</rdfs:label>
        <skos:definition>Disability public benefit refers to government-provided financial assistance specifically aimed at individuals who are unable to work due to a disability. These benefits are designed to provide a safety net by replacing lost income or covering additional costs associated with the disability. In the United States, this can include Social Security Disability Insurance (SSDI), Social Security disability insurance, and Supplemental Security Income (SSI).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81sYeX6XlFzhYawUGFCAfo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81sYeX6XlFzhYawUGFCAfo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Central American Indian languages</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Langues indiennes d&apos;Amérique centrale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas indígenas da América Central</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zentralamerikanische Indianersprachen</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">中央アメリカのインディアン言語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">中美洲印第安语言</skos:altLabel>
        <skos:definition>Central American Indian languages are a group of languages spoken by indigenous peoples in Central America, including languages such as K&apos;iche&apos;, Mam, and Nahuatl.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81vvUfjtIynvagUMuGiDdV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81vvUfjtIynvagUMuGiDdV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDlYI2CbQn1u95Hs6otNU2O"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/ReA0gy8mOLrqG7eTtFxnTh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Intended Spouse</rdfs:label>
        <skos:altLabel>Fiancéé</skos:altLabel>
        <skos:definition>An Intended Spouse is a person who is engaged to be married and has a clear intention to enter into a legally recognized marriage. This status often involves legal considerations, such as immigration benefits, where the intended spouse may apply for a visa to join their partner in another country for the purpose of marriage.</skos:definition>
        <skos:prefLabel>Fiancé</skos:prefLabel>
    </owl:Class>
    


