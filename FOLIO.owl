        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS"/>
        <dc:identifier>MFG-MACH</dc:identifier>
        <rdfs:label>Machinery Manufacturing Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de fabricación de maquinaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de fabricación de maquinaria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de la fabrication de machines</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de fabricação de máquinas</skos:altLabel>
        <skos:altLabel>Machinery Manufacturing</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Machinery Manufacturing Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Maschinenbauindustrie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית ייצור מכונות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मशीनरी निर्माण उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">机械制造业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">機械製造業</skos:altLabel>
        <skos:definition>Industries in the Machinery Manufacturing industry group create end products that apply mechanical force, for example, the application of gears and levers, to perform work. Some important processes for the manufacture of machinery are forging, stamping, bending, forming, and machining that are used to shape individual pieces of metal.</skos:definition>
        <skos:hiddenLabel>MACH</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R1mmZgj9s6vqgxrWeEM82m -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R1mmZgj9s6vqgxrWeEM82m">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCyUnV82gU1j6b08TVeC22p"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RkoLkee3wjmDwsHW0ENyrT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Speeding Violation Claim</rdfs:label>
        <skos:definition>A speeding violation claim is an assertion made by a law enforcement officer or traffic camera that a driver has exceeded the posted speed limit. The claim initiates a legal process that may result in penalties, such as fines or points on the driver&apos;s license, if the violation is proven or uncontested.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R1mvqs8rqT-2Ji-pXnQHz7A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R1mvqs8rqT-2Ji-pXnQHz7A">
