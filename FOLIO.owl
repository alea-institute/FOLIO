        <rdfs:label>Political Party</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Parti politique</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Partido político</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Politische Partei</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">政党</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">政党</skos:altLabel>
        <skos:definition>A political party is an organized group of individuals who share similar political beliefs and goals, seeking to influence public policy and gain control of government through the electoral process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7nEmCl4lSrGiGW6mOuNI3Y -->

