            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Backup Certificate</rdfs:label>
        <skos:altLabel>Backup Memorandum</skos:altLabel>
        <skos:definition>A Backup Certificate is a document certifying the accuracy and completeness of Legal Opinion&apos;s facts. Authors might include clients, law firms, or third parties. Backup certificates serve as a reassurance that the facts in the Legal Opinion are valid.</skos:definition>
        <skos:prefLabel>Backup Memo</skos:prefLabel>
    </owl:Class>
    


