        <skos:altLabel xml:lang="zh-cn">强制传唤证人作证动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言強制出頭申立</skos:altLabel>
        <skos:definition>A Motion to Compel Deposition is a formal request made to a court to require a witness to attend a deposition and provide testimony or evidence that they have previously refused to provide.</skos:definition>
    </owl:Class>
    


