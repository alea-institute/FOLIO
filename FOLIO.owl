            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion for Judgment of Acquittal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Freispruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Juicio de Absolución</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Juicio de Absolución</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Judgment of Acquittal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de julgamento de absolvição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en jugement d&apos;acquittement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין של חריגה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बरी के निर्णय के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无罪判决动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無罪判決の申立て</skos:altLabel>
        <skos:definition>A Motion for Judgment of Acquittal is a legal request made by the defense in a criminal trial, asking the judge to dismiss the charges against the defendant due to lack of evidence or legal basis.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UadgkRGYTEbWSJxyP9eWV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9UadgkRGYTEbWSJxyP9eWV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCjaPxLpNSWz91c3fJzxweU"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
