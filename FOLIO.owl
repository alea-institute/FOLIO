        <skos:altLabel xml:lang="pt-br">Cláusula de servidão de estacionamento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Parking Easement Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Parkplatzdienstbarkeitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות חניה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पार्किंग इजीमेंट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">停车通行权条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">駐車場通行権条項</skos:altLabel>
        <skos:definition>A Parking Easement Clause is a provision in a contract that grants the right to use a designated parking area for a specific purpose.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R5UNdK19vGcNxeuLfEy4Dd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R5UNdK19vGcNxeuLfEy4Dd">
