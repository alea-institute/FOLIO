        <rdfs:label>Pueblo of Sandia</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ksYmaNhrwE6VL9r0qV1sL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ksYmaNhrwE6VL9r0qV1sL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCZmEz3VSzAcKpjGH5Wu1ir"/>
        <rdfs:label>General Fiduciary Exemption Language</rdfs:label>
        <skos:altLabel>General Fiduciary Exemption</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">General Fiduciary Exemption Language</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lenguaje general de exención fiduciaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lenguaje general de exención fiduciaria</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שפת פטור פידוציארי כללית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य फिडूशियरी छूट भाषा</skos:altLabel>
        <skos:definition>General Fiduciary Exemption Language refers to a legal provision that exempts fiduciaries from liability for certain actions or decisions that may be inconsistent with their fiduciary duties, as long as they were made in good faith and with reasonable care.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kuXMvqzY34vaeAdTSaPxW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kuXMvqzY34vaeAdTSaPxW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rCNhUCohkUGbQyd1C3uzz"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDGdgxwCGXpkY1zfT2WwGl9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Taxes Representation</rdfs:label>
        <skos:definition>Taxes Representation is a provision in merger and acquisition agreements where the selling party attests to the accuracy and completeness of the target entity&apos;s tax returns, payments, and compliance with all applicable tax laws and regulations. It serves to assure the buyer that the target company has no undisclosed tax liabilities or issues, and that all tax obligations up to the date of the agreement have been appropriately addressed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kvj3qr4PlwHySafh0nevU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kvj3qr4PlwHySafh0nevU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBBfInsYEtsGJvAm3qnQm6l"/>
        <rdfs:label>Blackberries</rdfs:label>
        <skos:definition>Blackberries are aggregate fruits composed of small drupelets, characterized by their dark purple to black color and sweet-tart flavor. Widely cultivated and foraged in temperate regions, blackberries are consumed fresh, processed into jams and desserts, and valued for their high antioxidant content.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kyXmzdpLGATkgzTplo1v6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kyXmzdpLGATkgzTplo1v6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  Union County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Union County is a specific court within the Pennsylvania Court of Common Pleas system that has jurisdiction over civil and criminal cases within Union County, Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9lFaqxVAcEIKXsy7lTVLzu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9lFaqxVAcEIKXsy7lTVLzu">
