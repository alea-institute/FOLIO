    <!-- https://folio.openlegalstandard.org/GdM1Rw4LShO2Xt-lrV7XNQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/GdM1Rw4LShO2Xt-lrV7XNQ">
