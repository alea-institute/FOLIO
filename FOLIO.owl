        <skos:altLabel>Code of Conduct Violation Claim</skos:altLabel>
        <skos:altLabel>Conduct Violation</skos:altLabel>
        <skos:altLabel>Ethical Breach</skos:altLabel>
        <skos:altLabel>Ethical Infraction</skos:altLabel>
        <skos:altLabel>Ethical Misconduct</skos:altLabel>
        <skos:altLabel>Ethical Standards Violation</skos:altLabel>
        <skos:altLabel>Professional Conduct Violation</skos:altLabel>
        <skos:altLabel>Professional Ethics Violation Claim</skos:altLabel>
        <skos:definition>An ethics claim is a formal allegation that an individual or organization has violated ethical standards or principles within a specific profession or field. These claims can arise in various contexts, such as legal ethics, medical ethics, or government ethics, and often lead to investigations and disciplinary actions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBT0WyT3K42Y3D2IU7mBEq6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBT0WyT3K42Y3D2IU7mBEq6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9G5Ptc8g9T3Ag0GDVQOwae"/>
        <rdfs:label>Direct Patent Infringement</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Contrefaçon de brevet directe</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Direct Patent Infringement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Direkte Patentverletzung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Infracción directa de patente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Infracción directa de patente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação direta de patente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת פטנט ישירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रत्यक्ष पेटेंट उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">直接侵犯专利</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">直接特許侵害</skos:altLabel>
        <skos:definition>The unauthorized making, using, selling, or importing of a patented invention by a party without the permission of the patent owner.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBT0b5i4mnOONVVAKgQezXZ -->

