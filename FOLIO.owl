        <skos:altLabel xml:lang="pt-br">Direito de Publicidade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit à l&apos;image</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht am eigenen Bild</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right of Publicity</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות הציבוריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पब्लिसिटी का अधिकार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">肖像权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">肖像権</skos:altLabel>
        <skos:definition>The Right of Publicity is a legal concept that protects an individual&apos;s right to control the commercial use of their name, image, likeness, or other identifiable aspects of their persona, and prohibits others from using them without permission.</skos:definition>
    </owl:Class>
    


