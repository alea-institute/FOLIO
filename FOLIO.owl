        <skos:altLabel xml:lang="ja-jp">請求書通貨</skos:altLabel>
        <skos:definition>Invoice Currency refers to the specific currency in which a fee invoice is issued for legal services rendered.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMjD76W25eDeEY0HHhbUlv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMjD76W25eDeEY0HHhbUlv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Qlu8j6378wRwqtVUxZJFg"/>
        <rdfs:label>Public Domain</rdfs:label>
        <skos:altLabel>Non-Copyrighted Works</skos:altLabel>
        <skos:altLabel>Open Access Works</skos:altLabel>
        <skos:altLabel>Publicly Available Works</skos:altLabel>
        <skos:definition>Public Domain refers to creative works and information that are not protected by intellectual property laws and are therefore freely available for anyone to use, copy, distribute, or modify without permission. This status typically applies to works whose copyrights have expired, works explicitly released into the public domain by their creators, or works that were never eligible for copyright protection.</skos:definition>
    </owl:Class>
    


