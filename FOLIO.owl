        <skos:altLabel xml:lang="pt-br">Cláusula de lei aplicável</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Governing Law Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtswahlklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חוקי ממשל</skos:altLabel>
