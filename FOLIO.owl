        <skos:altLabel xml:lang="es-mx">Incorporación por Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Incorporation by Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Incorporation par estoppel</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Incorporação por estoppel</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Inkorporation durch Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התאגדות על ידי אסטופל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एस्टोपल द्वारा सम्मिलन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エストッペルによる合併</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">禁止否认原则下的公司合并</skos:altLabel>
        <skos:definition>A legal doctrine that treats an entity as a corporation, even if it has not completed the formalities required for incorporation, when it has acted as if it were a corporation and others have relied on that assumption to their detriment.</skos:definition>
    </owl:Class>
    


