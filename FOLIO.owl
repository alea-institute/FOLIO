        <skos:altLabel>Corporation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Corporação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Korporation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Société</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公司</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法人</skos:altLabel>
        <skos:definition>An organization formed with state governmental approval to act as an artificial person that is empowered with legal rights usually only reserved for individuals, such as to sue and be sued, issue shares of stock to raise funds (unless it is non-profit), own property, hire employees or loan and borrow money.</skos:definition>
        <skos:hiddenLabel>CORP</skos:hiddenLabel>
    </owl:Class>
    


