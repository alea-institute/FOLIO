    <!-- https://folio.openlegalstandard.org/R7JYtOWpJ7Ll2VatPjcLUDD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7JYtOWpJ7Ll2VatPjcLUDD">
