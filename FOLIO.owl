        <skos:altLabel xml:lang="es-es">Cláusula de Información Confidencial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Información Confidencial</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Informação Confidencial</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Confidential Information Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertraulichkeitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מידע סודי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गोपनीय सूचना शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保密信息条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">機密情報条項</skos:altLabel>
        <skos:definition>A Confidential Information Clause is a provision in a contract that requires parties to keep certain information private and not disclose it to others without permission.</skos:definition>
    </owl:Class>
    


