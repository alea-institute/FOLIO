        <rdfs:label>Classical Newari; Old Newari; Classical Nepal Bhasa</rdfs:label>
        <skos:altLabel xml:lang="de-de">Klassisches Newari; Altes Newari; Klassisches Nepal Bhasa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Newari classique; Ancien newari; Népalais classique Bhasa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Newari clássico; Antigo newari; Nepalês clássico Bhasa</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">古典ニュワール語；古代ニュワール語；古典ネパールバサ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">古典纽瓦里语；旧纽瓦里语；古典尼泊尔巴萨语</skos:altLabel>
        <skos:definition>A language spoken in Nepal, including Classical Newari, Old Newari, and Classical Nepal Bhasa.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vJ8acn9LWAq1ZELF5odEl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vJ8acn9LWAq1ZELF5odEl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5NlX3MRKQ0Ispm4G4jHuT"/>
        <rdfs:label>Machine Authorship</rdfs:label>
        <skos:definition>Machine Authorship in copyright law pertains to works created by machines or computer algorithms, typically without direct human creative input. This concept raises significant questions about the applicability of copyright laws to works generated by artificial intelligence or other automated processes.</skos:definition>
        <skos:prefLabel>AI Authorship</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vMLmVfhRJzdHOSa9MaYaY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vMLmVfhRJzdHOSa9MaYaY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCOYxInIdB2hOEl2dAlgQQH"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RPBEBqN3r4YqvAj19Jw9fU"/>
        <rdfs:label>Ph.D. (Doctor of Philosophy)</rdfs:label>
        <skos:altLabel>Doctor of Philosophy</skos:altLabel>
        <skos:definition>The suffix &quot;Ph.D.&quot; stands for &quot;Doctor of Philosophy&quot; and is used after a person&apos;s name to indicate that they have earned the highest academic degree awarded by universities in most fields of study. The use of this suffix signifies the individual&apos;s expertise and authority in a specific subject area and is often used in academic, research, and professional settings.</skos:definition>
        <skos:prefLabel>Ph.D.</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vMvqNbleygUph9uqlWziQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vMvqNbleygUph9uqlWziQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Partnership Representative Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de représentant de partenariat</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Representante de la Sociedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Representante de la Sociedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de representante de parceria</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zum Partnerschaftsvertreter</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Partnership Representative Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף נציג שותפות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साझेदारी प्रतिनिधि शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パートナーシップ代表条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合伙代表条款</skos:altLabel>
        <skos:definition>A Partnership Representative Clause is a provision in a contract that designates a representative to act on behalf of a partnership in tax matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vSZ41a2OJv2cBFFNL6DWq -->

