        <rdfs:label>Recovery of a Chattel / Replevin</rdfs:label>
        <skos:altLabel>Recovery of a Chattel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Recovery of a Chattel / Replevin</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recuperación de un bien mueble / Replevin</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recuperación de un bien mueble / Replevin</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Recuperação de um bem móvel / Replevin</skos:altLabel>
        <skos:altLabel>Replevin</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Récupération d&apos;un bien meuble / Réplevin</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wiedererlangung einer beweglichen Sache / Replevin</skos:altLabel>
        <skos:altLabel xml:lang="he-il">החזרת רכוש נייד / רפלבין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चैटल की वसूली / रेप्लेविन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">动产追回 / 保护令</skos:altLabel>
