        <skos:altLabel xml:lang="de-de">Haftung für ungenehmigte Subunternehmer</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Liability For Unlicensed Subcontractors</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad por subcontratistas no autorizados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad por subcontratistas no autorizados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade por subcontratados não licenciados</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité pour les sous-traitants non autorisés</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות עבור קבלני עבודה משנים לא מורשים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनाधिकृत उपभोक्ताओं के लिए उत्तरदायित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未经许可的分包商责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無許可の下請け業者に対する責任</skos:altLabel>
        <skos:definition>Liability for Unlicensed Subcontractors refers to the legal responsibility of a company or individual for any harm caused by a subcontractor who does not possess the required license or permit to perform the work they were hired for.</skos:definition>
    </owl:Class>
    


