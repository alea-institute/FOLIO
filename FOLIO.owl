        <rdfs:label>Web Search Portals, Libraries, Archives, and Other Information Industry</rdfs:label>
        <skos:definition>Industries in the Web Search Portals, Libraries, Archives, and Other Information Services subsector group establishments supplying information, storing and providing access to information, searching and retrieving information, and operating Web sites that use search engines to allow for searching information on the Internet. The main components of the subsector are libraries, archives, and Web search portals.</skos:definition>
        <skos:hiddenLabel>INTE</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMNTqpAJhnP2NSq9YLP9Pq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBMNTqpAJhnP2NSq9YLP9Pq">
