        <dc:identifier>REALA-MULFAM</dc:identifier>
        <rdfs:label>Multifamily Real Estate Asset</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Actif immobilier multifamilial</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Activo inmobiliario multifamiliar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Activo inmobiliario multifamiliar</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ativo imobiliário multifamiliar</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mehrfamilienimmobilienvermögen</skos:altLabel>
        <skos:altLabel>Multifamily</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Multifamily Real Estate Asset</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נכסי נדלן משפחתיים מרובי דיור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मल्टीफैमिली रियल एस्टेट एसेट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">マルチファミリー不動産資産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">多户房地产资产</skos:altLabel>
        <skos:definition>Real estate properties that include more than one unit for residential inhabitants including residential buildings.</skos:definition>
        <skos:hiddenLabel>MULFAM</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RUCs1tfF1J4XdhUkIhPx3R -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RUCs1tfF1J4XdhUkIhPx3R">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/3.00-Respiratory-Adult.htm#3_11"/>
        <rdfs:label>Lung Transplantation</rdfs:label>
        <skos:definition>Lung transplantation is a surgical procedure in which one or both diseased lungs are replaced with healthy lungs from a donor. This treatment is typically considered for patients with end-stage lung disease, such as chronic obstructive pulmonary disease (COPD) or pulmonary fibrosis, who have not responded to other therapies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RUDVKmMNlScgBVLBkFrgcQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RUDVKmMNlScgBVLBkFrgcQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoOnTANPIS6LCYx2SVkLJL"/>
        <rdfs:label>Equity Committee</rdfs:label>
        <skos:altLabel>Equity Holders&apos; Committee</skos:altLabel>
        <skos:definition>An Equity Committee represents the interests of equity holders (shareholders) in a bankruptcy or restructuring process. This committee ensures that the rights and priorities of shareholders are considered in negotiations, particularly in scenarios where their investments are at risk of being diluted or wiped out.</skos:definition>
        <skos:prefLabel>Shareholders&apos; Committee</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RUE4fCCSnGX1wIK324EyiL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RUE4fCCSnGX1wIK324EyiL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
        <dc:identifier>TRA</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=48"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=49"/>
        <rdfs:label>Transportation and Logistics Industry</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Industria de transporte y logística</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria del transporte y la logística</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie du transport et de la logistique</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de transporte e logística</skos:altLabel>
        <skos:altLabel>Supply Chain Industry</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transport and Logistics Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Transport- und Logistikbranche</skos:altLabel>
        <skos:altLabel>Transportation and Logistics</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית התחבורה והלוגיסטיקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">परिवहन और लॉजिस्टिक्स उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">輸送・物流業界</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">运输和物流行业</skos:altLabel>
        <skos:definition>The Transportation and Logistics industry group includes industries providing transportation of passengers and cargo, warehousing and storage for goods, scenic and sightseeing transportation, and support activities related to modes of transportation. Establishments in these industries use transportation equipment or transportation related facilities as a productive asset. The type of equipment depends on the mode of transportation. The modes of transportation are air, rail, water, road, and pipeline.</skos:definition>
        <skos:hiddenLabel>TRA</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RUGjHiVKuUfRusC0Y0nlti -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RUGjHiVKuUfRusC0Y0nlti">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  Lehigh County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Lehigh County is a specific court within the Pennsylvania Court of Common Pleas system that has jurisdiction over civil and criminal cases within Lehigh County.</skos:definition>
    </owl:Class>
    


