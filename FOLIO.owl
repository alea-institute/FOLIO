        <rdfs:label>Organization of American States</rdfs:label>
        <skos:definition>OAS (Organization of American States): An international organization founded on 30 April 1948, for the purposes of regional solidarity and cooperation among its member states within the Americas.</skos:definition>
        <skos:prefLabel>OAS</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UI8xskyEjwxRderFVyxeA -->

