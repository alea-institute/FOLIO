        <skos:altLabel xml:lang="es-mx">Moción para presentar un escrito sustituto o corregido</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer un mémoire de substitution ou corrigé</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Substitute or Corrected Brief</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para apresentação de memorial substituto ou corrigido</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para presentar un escrito sustitutivo o corregido</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להגשת מסמך מחליף או מתוקן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिस्थापित या सुधारित ब्रीफ फाइल करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">代替または訂正されたブリーフの提出に関する動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交替代或更正简要的动议</skos:altLabel>
        <skos:definition>A Motion to File Substitute or Corrected Brief is a formal request made to a court to allow a party to replace or amend a previously filed brief with a new or corrected version.</skos:definition>
    </owl:Class>
    


