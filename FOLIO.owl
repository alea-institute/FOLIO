        <rdfs:label>Breach of Fiduciary Duty by Trustee</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Fiduciary Duty by Trustee</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento del deber fiduciario por parte del fiduciario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento del deber fiduciario por parte del fiduciario</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der Treuepflicht durch den Treuhänder</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation du devoir de fiduciaire par le fiduciaire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação do dever fiduciário pelo fiduciário</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת האמון על ידי הנאמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विश्वासवार्ता के द्वारा न्यायाधीश का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">受托人违反信托责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">受託者による信託義務違反</skos:altLabel>
        <skos:definition>The breach of fiduciary duty by trustee refers to a situation where a trustee fails to act in the best interest of the beneficiaries of a trust, violating their legal obligation to manage the trust assets and affairs with loyalty, honesty, and good faith.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBizcuAme8glPLFlQSQLCq5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBizcuAme8glPLFlQSQLCq5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8TvbewYypS9Uy4y5JGIwEH"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Forcible Fondling</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Apalpação forçada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Attouchements forcés</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forcible Fondling</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gewaltsames Betatschen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Manoseo Forzado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Manoseo Forzado</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גירופים בכוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बलात्कारी झपटना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">強制わいせつ行為</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制猥亵</skos:altLabel>
        <skos:definition>The touching of the private body parts of another person for the purpose of sexual gratification, forcibly and/or against that person’s will or not forcibly or against the person’s will in instances where the victim is incapable of giving consent because of his/her youth or because of his/her temporary or permanent mental or physical incapacity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBj5pmPbMTTu1gawhjU88Gg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBj5pmPbMTTu1gawhjU88Gg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R325XgE86TFi0q8WvxwrJ4w"/>
        <rdfs:label>X304 Discovery/eDiscovery Review and Analysis</rdfs:label>
        <skos:definition>Any costs associated with the inspection, review, consideration and analysis of documents and/or evidence, relevance issues, quality assurance and control when billed as an expense instead of a service. Excludes creation of privilege log (X305).</skos:definition>
        <skos:prefLabel>X304 Discovery/eDiscovery Review and Analysis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBjDj4OYq8GXdV6Oimq3Swn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBjDj4OYq8GXdV6Oimq3Swn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
        <rdfs:label>Junior Credit Ranking</rdfs:label>
        <skos:definition>Junior Credit Ranking refers to the priority status of junior debts, which are ranked above junior subordinated debts but below senior and senior subordinated debts in the event of liquidation. This ranking ensures that junior creditors are paid before junior subordinated creditors from the proceeds of the liquidated assets, providing them with a lower level of security compared to senior debts but higher than junior subordinated debts.</skos:definition>
        <skos:prefLabel>Junior Debt Priority</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBjGQJGYoSe1qFvjvtP4w5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBjGQJGYoSe1qFvjvtP4w5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCx52UAWgVQUnCDTQXlxMgU"/>
        <rdfs:label>Collision Auto Insurance Coverage Policy</rdfs:label>
        <skos:definition>Collision auto insurance covers damage to the insured&apos;s own vehicle resulting from a collision with another vehicle or object, or from flipping over. It is generally an optional coverage but may be required if the vehicle is leased or financed. A deductible usually applies.</skos:definition>
        <skos:prefLabel>Collision Coverage</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBjGhGTbPYSLXYuV7eG4CsV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBjGhGTbPYSLXYuV7eG4CsV">
