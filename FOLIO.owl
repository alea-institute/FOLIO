        <rdfs:label>Intentional Interference with Prospective Economic Advantage</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Intentional Interference with Prospective Economic Advantage</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Interferencia intencional con la ventaja económica prospectiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interferencia intencional con la ventaja económica prospectiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interferência intencional em vantagem econômica prospectiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Obstruction intentionnelle de perspectives économiques futures</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorsätzliche Beeinträchtigung künftiger wirtschaftlicher Vorteile</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרעה בכוונה ביתרון כלכלי צפוי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रत्याशित आर्थिक लाभ के साथ जानबूझकर हस्तक्षेप</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">故意干涉未来经济利益</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">見込み経済利益に対する意図的な妨害</skos:altLabel>
        <skos:definition>Intentional Interference with Prospective Economic Advantage refers to a tort where a third party intentionally disrupts a business relationship or contract between two parties, causing economic harm to one of the parties.</skos:definition>
    </owl:Class>
    


