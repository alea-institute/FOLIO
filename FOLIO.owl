        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Price Changes Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de changement de prix</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Cambios de Precio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Cambios de Precio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de alteração de preços</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Preisänderungsklausel</skos:altLabel>
        <skos:altLabel>Price Adjustment Clause</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Price Changes Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שינויי מחיר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मूल्य परिवर्तन शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">价格变更条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">価格変更条項</skos:altLabel>
        <skos:definition>A Price Changes Clause, also known as a Price Adjustment Clause, is a provision in a contract that allows for adjustments to the price of goods or services based on certain conditions or events.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpsuZXSAXxqOOdwmtkrtEp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpsuZXSAXxqOOdwmtkrtEp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC339aKhjRAuw4JtEQUn5xw"/>
        <rdfs:label>Motion for More Definite Statement</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf genauere Darlegung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para una Declaración Más Definida</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para una Declaración Más Definida</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for More Definite Statement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição por Declaração Mais Definida</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue d&apos;une déclaration plus précise</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להבהרת מאמר יותר מסוים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिक निश्चित बयान के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">より明確な陳述を求める動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">更明确陈述动议</skos:altLabel>
        <skos:definition>A Motion for More Definite Statement is a legal request made by a party in a bankruptcy case or in response to a complaint, asking the opposing party to provide a clearer and more specific statement of their claims or defenses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDptEuaqrgkf8FuH43fMilh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDptEuaqrgkf8FuH43fMilh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7cIHUn7gvxaOltKIfA7Qta"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCAIUgUHLdwFdtdPTruyEgL"/>
        <rdfs:label>Co-Sale Agreement</rdfs:label>
        <skos:altLabel>Tag-Along Rights Agreement</skos:altLabel>
        <skos:definition>A Co-Sale Agreement, also known as a Tag-Along Agreement, is a legal document that allows minority shareholders to join a sale initiated by majority shareholders. This agreement ensures that the minority shareholders receive the same terms and conditions as the majority shareholders in a sale, thereby protecting their interests during significant corporate transactions.</skos:definition>
        <skos:definition>The Right of First Refusal and Co-Sale Agreement typically outlines the terms for the sale of an issuer&apos;s Preferred Stock to investors and defines obligations of certain, specified stockholders. It typically includes provisions for the Company&apos;s right of first refusal on transferable stock from specified stockholders, secondary purchase rights for stockholders, and specific notification timelines and conditions for stock transfers.</skos:definition>
        <skos:prefLabel>Tag-Along Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpweIrA3HDW0JHli21UfdB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpweIrA3HDW0JHli21UfdB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Dauphin County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Dauphin County is a specific court within the Pennsylvania Magisterial District Court system that handles minor criminal offenses, traffic violations, and civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


