        <skos:altLabel>Motion to Reconsider</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de reconsideração</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recurso de reconsideración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recurso de reconsideración</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להתחשבנות מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पुनर्विचार के लिए आवेदन</skos:altLabel>
