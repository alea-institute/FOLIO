        <skos:definition>A court located in Ithaca, New York that operates under the jurisdiction of the New York City Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGCpbuNOHtlNDogCc7dOLY -->

