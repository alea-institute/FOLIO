        <skos:altLabel xml:lang="es-es">Mociones de Descubrimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones de Descubrimiento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions de découverte</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedidos de descoberta</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות גילוי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खोज याचिकाएं</skos:altLabel>
