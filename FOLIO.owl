        <skos:altLabel xml:lang="es-mx">Asalto Civil</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Assalto civil</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Civil Assault</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zivilrechtliche Körperverletzung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התקפה אזרחית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नागरिक हमला</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民事侵权行为</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">民事暴行</skos:altLabel>
        <skos:definition>Civil Assault: A legal claim for damages resulting from intentional conduct that causes a person to fear an imminent harmful or offensive contact.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROWsW3Tkpc2YQmbHQehntm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROWsW3Tkpc2YQmbHQehntm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
