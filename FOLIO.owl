    <!-- https://folio.openlegalstandard.org/RgGJ42FaxSIi6JWSbpHYXrQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgGJ42FaxSIi6JWSbpHYXrQ">
