        <skos:altLabel xml:lang="en-gb">Antitrust - Horizontal Agreement/Conspiracy Claims</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations d&apos;accord/conspiration horizontale</skos:altLabel>
