        <rdfs:label>Actions Required Under Transaction Agreement Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Acciones requeridas en virtud del lenguaje del acuerdo de transacción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acciones requeridas en virtud del lenguaje del acuerdo de transacción</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Actions Required Under Transaction Agreement Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Actions requises en vertu de la langue de l&apos;accord de transaction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ações necessárias nos termos da linguagem do acordo de transação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erforderliche Maßnahmen gemäß Transaktionsvereinbarungssprache</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעולות הנדרשות בהתאם לשפת ההסכם המסחרי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लेनदेन समझौते भाषा के तहत आवश्यक कार्रवाई</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">交易协议语言下的必要行动</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">取引契約言語に基づく必要な措置</skos:altLabel>
        <skos:definition>Actions Required Under Transaction Agreement Language refers to the specific obligations and duties that must be fulfilled by parties involved in a legal transaction as outlined in the agreement, and which are exempted from the Material Adverse Effect (MAE) definition.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSEc3J4h5XdVfKKWBG7u08 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSEc3J4h5XdVfKKWBG7u08">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
