        <skos:altLabel xml:lang="fr-fr">Crimes contre le public</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Delitos contra el orden público</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Delitos contra la sociedad</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verbrechen gegen die Öffentlichkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פשעים נגד הציבור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक विरुद्ध अपराध</skos:altLabel>
