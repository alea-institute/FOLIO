            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Ra8NCYdJb9YwmAxaOmLDbI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>625 Drug Related Seizure of Property 21 U.S.C. § 881 (PACER NoS)</rdfs:label>
        <skos:definition>Action (Forfeiture) by which property itself is accused of wrongdoing and is forfeited to the government as a result.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8WqS8ceuMozlL2UfLWTVPp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8WqS8ceuMozlL2UfLWTVPp">
