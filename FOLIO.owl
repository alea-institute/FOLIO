        <rdfs:label>Vermont Supreme Court</rdfs:label>
        <skos:definition>The Vermont Supreme Court is the highest court in the state of Vermont, responsible for hearing appeals from lower state courts and interpreting state law.</skos:definition>
    </owl:Class>
    


