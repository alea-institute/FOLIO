            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7PHFZzZmVmczzNQl6iZKsa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Impounding Property to Pay Debt</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Apreensão de propriedade para pagar dívida</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Beschlagnahme von Eigentum zur Begleichung von Schulden</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Embargo de bienes para pagar deudas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Embargo de propiedad para pagar deudas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Impounding Property to Pay Debt</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Saisie de biens pour payer une dette</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מילוי פקדון על נכסים לשם תשלום חוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋण चुकाने के लिए संपत्ति को जब्त करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債務の支払いのための財産の差し押さえ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">扣押财产以偿还债务</skos:altLabel>
        <skos:definition>The concept of &quot;Impounding Property to Pay Debt&quot; refers to the legal process of seizing and holding property as collateral to satisfy a debt owed by the property owner, typically in cases of equitable claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RczOdaNZnrQz9v0Xg2QO2z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RczOdaNZnrQz9v0Xg2QO2z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
        <rdfs:label>Bank Leaving Funds Transfer Incomplete</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Banco deixa transferência de fundos incompleta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bank Leaving Funds Transfer Incomplete</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bank lässt Überweisung unvollständig</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">La banque laisse le transfert de fonds incomplet</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Transferencia de fondos incompleta debido a la salida del banco</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Transferencia de fondos incompleta debido a la salida del banco</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הבנק עוזב את ההעברה של הכספים בלתי שלמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बैंक फंड ट्रांसफर अधूरा छोड़ रहा है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">銀行は資金移転を不完全なままにしておく</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">银行未完成资金转移</skos:altLabel>
        <skos:definition>When a bank fails to complete a funds transfer initiated by a customer before the customer closes their account or withdraws their authorization, resulting in the funds not being transferred, and potentially causing financial harm to the customer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rd2J0V6Magzui25PaTTJ5n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rd2J0V6Magzui25PaTTJ5n">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Eq21fpzUIBqpXfAaS2Xbo"/>
        <rdfs:label>Promissory Fraud</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Fraude promesse de paiement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fraude promisorio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fraude promisorio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fraude promissória</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Promissory Fraud</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verschuldensbetrug</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הונאת חיוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिज्ञात्मक धोखाधड़ी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">允诺欺诈</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">約束不履行詐欺</skos:altLabel>
        <skos:definition>The concept of Promissory Fraud refers to a type of fraudulent misrepresentation where a party makes a promise with no intention of keeping it, in order to induce another party to enter into a contract or take some other action to their detriment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rd3Z1kCqjqGfSSXLxegvvd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rd3Z1kCqjqGfSSXLxegvvd">
