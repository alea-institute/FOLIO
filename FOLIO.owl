        <rdfs:label>tax_item_fee segment</rdfs:label>
        <skos:definition>A tax_item_fee segment is a component of the LEDES XML E-Billing Ver. 2.2 standard that includes information about a specific tax or fee charged in a legal matter, identified by a unique transaction ID and file item number.</skos:definition>
    </owl:Class>
    


