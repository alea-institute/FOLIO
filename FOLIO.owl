        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Right of First Negotiation Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de droit de première négociation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Derecho de Primera Negociación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Derecho de Primera Negociación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de direito de primeira negociação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zum Recht auf erste Verhandlung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right of First Negotiation Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות המשא ומתן ראשוני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पहली वार्ता का अधिकार शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">优先谈判权条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">最優先交渉権条項</skos:altLabel>
        <skos:definition>A Right of First Negotiation Clause is a provision in a contract that grants one party the exclusive right to negotiate with the other party before any other potential buyers or sellers, typically in regards to a specific asset or property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfpJfj2VyROWmlBXR8Yw6cQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RfpJfj2VyROWmlBXR8Yw6cQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6iOMiH_eTfClsEnn-_jWkA"/>
        <rdfs:label>PA640 Quasi-Judicial Administrative Proceedings - International</rdfs:label>
        <skos:definition>All action associated with completing a quasi-judicial proceeding before an administrative tribunal associated with a Patent Office outside of the home country of the applicant in connection with an application filed under PA500, including Appeals, Oppositions, Interferences and other ex-parte and inter-partes proceedings. Includes collecting evidence, preparing and filing motions, briefs, responses, replies, surreplies, and other documents, attending conferences, depositions, hearings, and other proceedings. Does not include requests for supervisory action (&quot;Petitions&quot; in the U.S.) under PA630. Note that external expenses are included under E100</skos:definition>
        <skos:prefLabel>PA640 Quasi-Judicial Administrative Proceedings - International</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfqSqIIE5qf82lRaTBZdpB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RfqSqIIE5qf82lRaTBZdpB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Achinese</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Achinese</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Achinesisch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Achinois</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アチェ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿齐汉语</skos:altLabel>
        <skos:definition>Achinese is a language that belongs to the Austronesian language family and is spoken in the Aceh province of Indonesia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfrrIqKTh9me3Z5tlVD7Fz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RfrrIqKTh9me3Z5tlVD7Fz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_25"/>
        <rdfs:label>Testicle Cancer</rdfs:label>
        <skos:altLabel>Male Gonadal Cancer</skos:altLabel>
        <skos:definition>Testicle cancer, also known as testicular cancer, is a malignant tumor that originates in the tissues of one or both testicles, the male reproductive glands located in the scrotum. It includes various subtypes, such as seminomas and non-seminomas, and can cause symptoms like testicular lumps, swelling, and discomfort, often requiring treatments like surgery, chemotherapy, and radiation.</skos:definition>
        <skos:prefLabel>Testicular Cancer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RftL7w1KHiE4KqKXgdfD8k -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RftL7w1KHiE4KqKXgdfD8k">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70"/>
        <rdfs:label>Bermudan Call Option Style</rdfs:label>
        <skos:altLabel>Bermudan-Style Call Option</skos:altLabel>
        <skos:altLabel>Limited Window Call Option</skos:altLabel>
        <skos:altLabel>Multi-Date Call Option</skos:altLabel>
        <skos:definition>A Bermudan Call Option Style is a type of option contract that can be exercised on specific dates during its life, typically more than one date but fewer than the continuous exercise rights of American options. This style offers a middle ground between the flexibility of American options and the strict single-date exercise of European options.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8nycgMSnQGSzh9LvnqnhQ7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Credit Arrangement</rdfs:label>
        <skos:altLabel>Creditor Priority Classification</skos:altLabel>
        <skos:definition>Credit Arrangement (also known as Creditor Priority or Investment Guarantee or Ranking) refers to the security, priority, or guarantee associated with a financial instrument, determining the order and likelihood of repayment in various scenarios, particularly in case of default or liquidation. This classification encompasses a range of assurances and hierarchical positions, from secured arrangements to government-backed guarantees to various levels of seniority and subordination in the capital structure.</skos:definition>
        <skos:prefLabel>Investment Guarantee or Ranking</skos:prefLabel>
    </owl:Class>
    


