        <skos:altLabel>Life Sentence</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Life imprisonment</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Prisión permanente revisable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prisão perpétua</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclusión de por vida</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מאסר לכל החיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जीवनकाल कैद</skos:altLabel>
