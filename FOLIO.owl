    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzLUlKuoenkHyiDbj8b4US -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzLUlKuoenkHyiDbj8b4US">
