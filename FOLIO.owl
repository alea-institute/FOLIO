        <rdfs:label>Urology Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle en urologie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia médica en urología</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia médica en urología</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em urologia</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Urologische Kunstfehler</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Urology Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה רפואית באורולוגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूरोलॉजी लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">泌尿器科医療過誤</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">泌尿外科医疗事故</skos:altLabel>
        <skos:definition>Urology Malpractice refers to a type of medical malpractice claim that arises from the negligent or improper treatment of urological conditions by a healthcare provider.</skos:definition>
    </owl:Class>
    


