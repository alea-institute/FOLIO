        <rdfs:label>Currently Operative Law</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Droit en vigueur</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geltendes Recht</skos:altLabel>
        <skos:altLabel>Good Law</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei atualmente em vigor</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">现行法律</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現行法</skos:altLabel>
        <skos:definition>The law appears to have legal efficacy, operating effectively.</skos:definition>
        <skos:prefLabel>Citator - Green Flag</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUS0L6evAK1r6HGe8b92cw -->

