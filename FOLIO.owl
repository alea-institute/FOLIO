        <skos:altLabel xml:lang="de-de">Heilungsfristklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תקופת תיקון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपचार अवधि शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">治愈期条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">治癒期間条項</skos:altLabel>
        <skos:definition>A cure period clause is a provision in a contract that allows a party to remedy a breach or default within a specified period of time before the other party can take legal action.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7HlDH3l1T7iKYGoPjHUNAg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7HlDH3l1T7iKYGoPjHUNAg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1okJKMvv4mMHv7m4TzwBe"/>
        <rdfs:label>Autonomous Vehicle</rdfs:label>
        <skos:altLabel>Automated Vehicle</skos:altLabel>
        <skos:altLabel>CAV</skos:altLabel>
        <skos:altLabel>Connected and Automated Vehicle</skos:altLabel>
        <skos:altLabel>Driverless Car</skos:altLabel>
        <skos:altLabel>Robotic Car</skos:altLabel>
        <skos:altLabel>Self-Driving Vehicle</skos:altLabel>
        <skos:definition>An autonomous or connected vehicle, also known as a self-driving or driverless car, is a vehicle equipped with technology that allows it to navigate and operate with varying levels of human intervention (Level 1 through Level 4), or no human intervention (Level 5). Such vehicles rely on sensors, cameras, and artificial intelligence to perceive their environment and make decisions based on pre-programmed algorithms and real-time data.</skos:definition>
        <skos:prefLabel>Connected Vehicle</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Hn26F8Ni09kjmFuFvS7f1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Hn26F8Ni09kjmFuFvS7f1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Malicious Code Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de code malveillant</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de código malicioso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de código malicioso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de código malicioso</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für bösartigen Code</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Malicious Code Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף קוד זדוני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दुर्भाग्यपूर्ण कोड शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">恶意代码条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">悪意のあるコード条項</skos:altLabel>
        <skos:definition>A Malicious Code Clause is a provision in a contract that addresses the risk of harmful software or code being introduced into a system or network, typically by a third party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7HpHL4HNvWhmv9GMhimDmR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7HpHL4HNvWhmv9GMhimDmR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKzL5nW7IGg4mvAPFX2MUL"/>
        <dc:identifier>T-SVC</dc:identifier>
        <rdfs:label>Services Agreement Practice</rdfs:label>
        <skos:altLabel>Services Agreement</skos:altLabel>
        <skos:altLabel>Services Agreement Service</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Dienstleistungsvertragspraxis</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de l&apos;accord de services</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de Acuerdo de Servicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de Acuerdo de Servicios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de Acordo de Serviços</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Services Agreement Practice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול הסכם שירותים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेवा समझौता अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サービス契約実務</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">服务协议实践</skos:altLabel>
        <skos:definition>A service agreement is an agreement between two persons or businesses where one agrees to provide a specified service to the other. It can also be an express undertaking of employment signed by both the employer and the employee detailing therein the explicit terms and conditions of service. A service agreement is different from a bond. A service agreement binds both the parties to the agreement, whereas bond is one sided and binds the employee to the agreement only.</skos:definition>
        <skos:hiddenLabel>SVC</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7HqjiCnUDczoQ2AhCPbeW2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7HqjiCnUDczoQ2AhCPbeW2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSK8CbOPdmMwMyMIlw8pdO"/>
        <rdfs:label>New Mexico Magistrate Court - Chaves County</rdfs:label>
        <skos:definition>A court located in Chaves County, New Mexico that has limited jurisdiction over certain types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Hsg4OqI6gkb53rGcgVUIS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Hsg4OqI6gkb53rGcgVUIS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E111 Meals</rdfs:label>
        <skos:definition>Meals (E111) are a type of expense (E100) that refers to the cost of food and beverages consumed by an individual or group while traveling or conducting business.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7HzG8t2MHvA1beqRfqgJ1l -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7HzG8t2MHvA1beqRfqgJ1l">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
        <rdfs:label>Appointments Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch aus der Ernennungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Appointments Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Cláusula de Nombramientos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Cláusula de Nombramientos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Nomeação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de la clause de nomination</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף המינויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपॉइंटमेंट्स क्लॉज क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">任命条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">任命条項クレーム</skos:altLabel>
        <skos:definition>An Appointments Clause claim is a legal argument asserting that a particular appointment or nomination made by a government official violates the Appointments Clause of the United States Constitution. This claim contends that the appointment was not made in accordance with the constitutional requirements outlined in the Appointments Clause, which typically involves the need for Senate confirmation or compliance with other specified procedures, rendering the appointment or nomination invalid or unconstitutional.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7HznVMlYYok8h3fOdniyPT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7HznVMlYYok8h3fOdniyPT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8HLLl44Pya8Fp0uN3ewKRW"/>
        <rdfs:label>Knowledge Hub Management</rdfs:label>
        <skos:definition>Knowledge Hub Management refers to the management of a centralized platform for organizing and sharing knowledge resources within an organization, building upon the broader concept of Knowledge Management.</skos:definition>
    </owl:Class>
    


