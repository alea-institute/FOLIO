        <rdfs:isDefinedBy>PACER</rdfs:isDefinedBy>
        <rdfs:label>Collateral Order Appeal</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Appels d&apos;ordonnances de garantie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Beschwerden über Sicherheitsleistungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Collateral Order Appeals</skos:altLabel>
