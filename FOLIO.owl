        <rdfs:label>Operating Report</rdfs:label>
        <skos:altLabel xml:lang="de-de">Betriebsbericht</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Informe de Operaciones</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Operating Report</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Rapport d&apos;exploitation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Relatório de operação</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reporte de Operación</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דו&apos;&apos;ח תפעולי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऑपरेटिंग रिपोर्ट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">运营报告</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">運営報告</skos:altLabel>
        <skos:definition>An Operating Report is a type of Report that is specifically related to Bankruptcy and Restructuring Document, providing information on the financial and operational status of a company during the bankruptcy process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9q6K9SQAWS0tjXvWLtIGli -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9q6K9SQAWS0tjXvWLtIGli">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
        <rdfs:label>Par</rdfs:label>
        <skos:altLabel>Face Value</skos:altLabel>
        <skos:altLabel>Nominal Value</skos:altLabel>
        <skos:definition>Par refers to the face value of a financial instrument, such as a bond or loan, at the time of issuance or redemption. It is the nominal value that does not account for interest rates or market fluctuations</skos:definition>
        <skos:prefLabel>Par Value</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9q6Of9vCpTLTYAKbSrAmFS -->

