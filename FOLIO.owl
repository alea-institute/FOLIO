        <skos:altLabel xml:lang="pt-br">Cláusula de Prazo do Acordo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Término de Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Término de Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Vereinbarungsdauer</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Term of Agreement Clause</skos:altLabel>
        <skos:altLabel>Term of Contract Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תקופת ההסכם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समझौते की अवधि धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">协议条款条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約条項条項</skos:altLabel>
        <skos:definition>A Term of Agreement Clause is a provision in a contract that specifies the duration of the agreement and the conditions under which it can be terminated.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9pWxROKSh2Pmvgjn2qxrCY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9pWxROKSh2Pmvgjn2qxrCY">
