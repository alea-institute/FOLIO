        <rdfs:label>Laminated Plastics Plate, Sheet (except Packaging), and Shape Manufacturing</rdfs:label>
        <skos:definition>See industry description for 326130.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Aq6t-PNYQ_K8Ch4JzoS9cA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Aq6t-PNYQ_K8Ch4JzoS9cA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/oS3ZjajvSPWy2t8a-D2yAQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311211"/>
        <rdfs:label>Flour Milling</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) milling flour or meal from grains (except rice) or vegetables and/or (2) milling flour and preparing flour mixes or doughs.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ArKkIdlQRqCcPH1zV0FvLQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ArKkIdlQRqCcPH1zV0FvLQ">
