        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDRa5lUoXHzZDEwMWp3VLh8"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Oil and Gas Real Estate Asset</rdfs:label>
        <skos:definition>An oil and gas real estate asset refers to a property that contains or is believed to contain deposits of oil or natural gas. This asset is important in the context of property law, energy law, and environmental law, as it involves the rights to explore, extract, and sell these natural resources.</skos:definition>
    </owl:Class>
    


