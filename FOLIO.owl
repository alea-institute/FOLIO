            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Public Intoxication</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Ebriedad en la vía pública</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Embriaguez pública</skos:altLabel>
        <skos:altLabel>Insobriety</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Intoxicación pública</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ivresse publique</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Public Intoxication</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Öffentliche Trunkenheit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שכרות ציבורית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक मतवाद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共の酩酊</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公共醉酒</skos:altLabel>
        <skos:definition>To drink alcoholic beverages to the extent that one’s mental faculties and physical coordination are substantially impaired.</skos:definition>
        <skos:prefLabel>Drunkenness</skos:prefLabel>
    </owl:Class>
    


