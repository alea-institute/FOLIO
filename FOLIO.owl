        <rdfs:label>Slip-and-Fall Negligence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftung bei Stolper- und Sturzunfällen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia por Resbalón y Caída</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia por Resbalón y Caída</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência em casos de escorregão e queda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence en cas de glissade et de chute</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Slip-and-Fall Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת אחריות על נפילת החלקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्लिप-एंड-फॉल लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">すべり落ちることと転倒の過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">滑倒和摔倒过失</skos:altLabel>
        <skos:definition>Slip-and-Fall Negligence refers to a legal claim made by an individual who has suffered a personal injury due to the negligence of a property owner or occupier in maintaining safe conditions on their premises, specifically related to slipping or falling.</skos:definition>
    </owl:Class>
    


