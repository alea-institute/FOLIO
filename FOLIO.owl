    <!-- https://folio.openlegalstandard.org/R9S41UQgOPCfeO9ib0XWapg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9S41UQgOPCfeO9ib0XWapg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
