        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E105 Telephone</rdfs:label>
        <skos:definition>A telephone expense incurred in the course of business operations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QOvTsb6CyOwLFCPY7Vzmq -->

