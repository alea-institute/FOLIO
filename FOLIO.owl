        <skos:definition>A period of duration clause is a provision in a contract that specifies the length of time that the agreement will remain in effect.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFpHjjyeQAAERzH5snlNrf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFpHjjyeQAAERzH5snlNrf">
