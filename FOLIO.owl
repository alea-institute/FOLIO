        <dc:identifier>AER</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=71"/>
        <rdfs:label>Arts, Entertainment and Recreation Industry</rdfs:label>
        <skos:altLabel>Arts, Entertainment and Recreation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Arts, Entertainment and Recreation Industry</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de las Artes, el Entretenimiento y el Ocio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de las Artes, el Entretenimiento y el Ocio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des arts, du divertissement et des loisirs</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de Artes, Entretenimento e Recreação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kunst-, Unterhaltungs- und Erholungsbranche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית האמנות, הבידור והפנאי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कला, मनोरंजन और मनोरंजन उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">艺术、娱乐和休闲产业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">芸術、エンターテインメント、レクリエーション産業</skos:altLabel>
        <skos:definition>The Arts, Entertainment and Recreation industry group includes a wide range of establishments that operate facilities or provide services to meet varied cultural, entertainment, and recreational interests of their patrons. This sector includes establishments that are involved in producing, promoting, or participating in live performances, events, or exhibits intended for public viewing, establishments that preserve and exhibit objects and sites of historical, cultural, or educational interest; and establishments that operate facilities or provide services that enable patrons to participate in recreational activities or pursue amusement, hobby, and leisure-time interests.</skos:definition>
        <skos:hiddenLabel>AER</skos:hiddenLabel>
    </owl:Class>
    


