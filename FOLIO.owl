        <skos:altLabel xml:lang="fr-fr">Contrefaçon</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Counterfeiting</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falsificación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falsificación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falsificação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fälschung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זיוף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नकली</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">伪造</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">偽造</skos:altLabel>
        <skos:definition>(Definition of &quot;Counterfeiting/Forgery&quot;) The altering, copying, or imitation of something, without authority or right, with the intent to deceive or defraud by passing the copy or thing altered or imitated as that which is original or genuine; or the selling, buying, or possession of an altered, copied, or imitated thing with the intent to deceive or defraud.</skos:definition>
    </owl:Class>
    


