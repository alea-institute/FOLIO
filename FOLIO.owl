            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Contractor</rdfs:label>
        <skos:definition>A Contractor is an individual or entity that provides services to a company under the terms of a contract, rather than being an employee of the organization. Contractors are typically responsible for their own taxes, benefits, and liabilities, and they usually have a greater degree of flexibility and independence than employees.</skos:definition>
        <skos:prefLabel>Independent Contractor</skos:prefLabel>
    </owl:Class>
    


