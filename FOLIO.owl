        <skos:altLabel xml:lang="fr-fr">Bureau du chef de l&apos;audience administrative</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro des Chefs des Verwaltungsgerichtsverfahrens</skos:altLabel>
