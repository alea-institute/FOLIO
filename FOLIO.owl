        <skos:altLabel xml:lang="fr-fr">Manx</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Manx</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">マン島語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">曼岛语</skos:altLabel>
        <skos:definition>Manx (Language) is a structured system of communication that consists of grammar and vocabulary, and is a member of the Language top-level class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCjOapMc4xk7stF6a0bmvmq -->

