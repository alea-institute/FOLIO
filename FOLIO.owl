        <skos:altLabel xml:lang="zh-cn">经纪人</skos:altLabel>
        <skos:definition>A broker is an individual or firm employed by others to plan and organize sales or negotiate contracts for a commission.</skos:definition>
        <skos:hiddenLabel>BROK</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QBxglon1egELHpWyjj1nh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QBxglon1egELHpWyjj1nh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_02"/>
        <rdfs:label>Head and Neck Soft Tissue Cancer</rdfs:label>
        <skos:altLabel>Head and Neck Sarcoma</skos:altLabel>
        <skos:altLabel>Malignant Neoplasm of Soft Tissue in Head and Neck</skos:altLabel>
        <skos:definition>Soft tissue cancer of the head and neck refers to malignant neoplastic diseases originating in the soft tissues, including muscles, fat, fibrous tissues, blood vessels, and other connective tissues of the head and neck. This category encompasses a variety of aggressive cancers that can impact critical functions such as breathing, swallowing, and speaking.</skos:definition>
        <skos:prefLabel>Head and Neck Soft Tissue Sarcoma</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QCVwkeCigeLgC2pXYz09F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QCVwkeCigeLgC2pXYz09F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R83spgNoduHRVfnLcxe6nO5"/>
        <rdfs:label>OASISThing</rdfs:label>
        <skos:definition>OASISThing refers to a type of data structure used in LegalXML OASIS SCHEMA, which can have specific functions and roles within the schema.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QDC1chH8o0jmTMsmrcaUW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QDC1chH8o0jmTMsmrcaUW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3391bdB1A2adE51071C7cf7"/>
        <rdfs:label>New York Community Justice Center</rdfs:label>
        <skos:definition>A specialized court program in New York State that aims to reduce crime and improve public trust in the justice system, by providing community-based services and alternative sentencing options.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9QE2EdC7J6rNnMUaMTSHK9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9QE2EdC7J6rNnMUaMTSHK9">
