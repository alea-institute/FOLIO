            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>T-SEC</dc:identifier>
        <rdfs:label>Securitization Practice</rdfs:label>
        <skos:altLabel>Securitizations</skos:altLabel>
        <skos:altLabel>Securitization Service</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de la titrisation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de Titulización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de Titulización</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de Securitização</skos:altLabel>
        <skos:altLabel>Securitization</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Securitization Practice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verbriefungspraxis</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעשה הגבייה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सुरक्षा व्यवस्था अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証券化実務</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">证券化实践</skos:altLabel>
        <skos:definition>The financial practice of pooling various types of contractual debt such as residential mortgages, commercial mortgages, auto loans or credit card debt obligations (or other non-debt assets which generate receivables) and selling their related cash flows to third party investors as securities, which may be described as bonds, pass-through securities, or collateralized debt obligations (CDOs).</skos:definition>
        <skos:hiddenLabel>SEC</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7Jo3gp8LjhpdJNXYE9ow95"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>B-OOCRSTR</dc:identifier>
        <rdfs:label>Out-of-Court Restructuring</rdfs:label>
        <skos:altLabel>Out-of-Court Restructuring</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Out-of-Court Restructuring</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reestructuración extrajudicial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reestructuración extrajudicial</skos:altLabel>
        <skos:altLabel>Workouts</skos:altLabel>
        <skos:altLabel xml:lang="de-de">außergerichtliche Restrukturierung</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">reestruturação extrajudicial</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">restructuration extrajudiciaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מתן חוזים חוץ מגירעון להיערכות מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आउट-ऑफ-कोर्ट रीस्ट्रक्चरिंग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法院外重组</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判所外再編</skos:altLabel>
        <skos:definition>An out-of-court restructuring or workout is a nonjudicial process through which a financially troubled company and its significant creditors reach an agreement for adjusting the company&apos;s obligations.</skos:definition>
        <skos:hiddenLabel>OOCRSTR</skos:hiddenLabel>
        <skos:prefLabel>Workout Restructuring</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HPub0PMW2GODvjQ2PttbM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HPub0PMW2GODvjQ2PttbM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7i00MVak7HQPsePKrHq2WF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8RfDzMtuMPdmNTonmhBxu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Leasehold Estate</rdfs:label>
        <skos:definition>A Leasehold is an estate in real property where a lessee is granted the exclusive right to occupy and use a property for a predetermined period, typically in exchange for rent or other consideration. Unlike fee simple ownership, leasehold interests are temporary and revert back to the lessor at the end of the lease term</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HRq0jDT4IJcj5e27xtcHS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HRq0jDT4IJcj5e27xtcHS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDFykS6WHtTXBe9eTuwqAqk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Railway Labor Act Claim</rdfs:label>
        <skos:altLabel>Rail and Air Transport Labor Dispute</skos:altLabel>
        <skos:altLabel>Railway Labor Dispute</skos:altLabel>
        <skos:altLabel>Transport Sector Labor Relations Claim</skos:altLabel>
        <skos:definition>A Railway Labor Act Claim involves legal proceedings or disputes arising under the Railway Labor Act (RLA), which governs labor relations in the railway and airline industries in the United States. These claims typically address issues such as collective bargaining, union representation, and the resolution of labor disputes.</skos:definition>
        <skos:prefLabel>RLA Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HSXSwprTDq85YteDQo1Lb -->

