        <rdfs:label>Indemnification</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftungsfreistellung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Indemnification</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Indemnisation</skos:altLabel>
        <skos:altLabel>Indemnity</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Indemnización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Indemnización</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indenização</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיצויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भरपाई</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">赔偿</skos:altLabel>
        <skos:definition>Indemnification is a legal remedy sought by a party to be protected from financial loss or liability resulting from a specific event or action, and may be implied or granted by contract or court order.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLQedrDmb0dGL0RqZmF1Xw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLQedrDmb0dGL0RqZmF1Xw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RpiyvcnyPAZ5hygNt0zO3j"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_20"/>
        <rdfs:label>Amputation</rdfs:label>
        <skos:altLabel>Amputative Surgery</skos:altLabel>
        <skos:altLabel>Extremity Removal</skos:altLabel>
        <skos:altLabel>Limb Amputation</skos:altLabel>
        <skos:altLabel>Limb Removal</skos:altLabel>
        <skos:altLabel>Surgical Limb Loss</skos:altLabel>
        <skos:definition>Amputation is the surgical removal of a limb or extremity, such as an arm, leg, foot, hand, toe, or finger. This procedure is often performed to treat severe injuries, infections, diseases like diabetes or cancer, or as a result of traumatic accidents, leading to significant changes in mobility and functionality.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLQhKk8z0rpekZczxDuAZI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RLQhKk8z0rpekZczxDuAZI">
