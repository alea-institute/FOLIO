    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8A0lCUdGrKUCB0nu0VfLzI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8A0lCUdGrKUCB0nu0VfLzI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQbVKPVl5dj5nW6aXoNxx4"/>
        <rdfs:label>Mass Market Segment</rdfs:label>
        <skos:definition>The mass market segment refers to a large, broad portion of the market that consists of a wide range of consumers with diverse preferences and needs. This segment targets the general population and is characterized by products and services that are designed for widespread appeal and accessibility, often with a focus on affordability and practicality</skos:definition>
        <skos:example>Household Cleaning Supplies</skos:example>
        <skos:example>Personal Care Products</skos:example>
        <skos:example>Software Operating Systems</skos:example>
    </owl:Class>
    


