        <skos:altLabel xml:lang="ja-jp">清潔水請求</skos:altLabel>
        <skos:definition>A Clean Water Claim is a legal action brought under environmental law seeking to enforce or protect the right to clean water.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUsZ8s2Mv3N35ZYav18ucG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUsZ8s2Mv3N35ZYav18ucG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R969M34LEgPe5hm59rdksmi"/>
        <rdfs:label>oasis:Obligation</rdfs:label>
        <skos:definition>An &quot;Obligation&quot; is a type of deontic specification in the OASIS ontology, indicating a requirement or duty that must be fulfilled.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUshq33YKYbi0RQdiJPytd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUshq33YKYbi0RQdiJPytd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC9hKRPbfUdQjXfAQBLwpGO"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_11"/>
        <rdfs:label>Craniofacial Bone Cancer</rdfs:label>
        <skos:altLabel>Orbital Cancer</skos:altLabel>
        <skos:altLabel>Temporal Bone Cancer</skos:altLabel>
        <skos:altLabel>Upper Jaw Cancer</skos:altLabel>
        <skos:definition>Maxilla, orbit, or temporal fossa cancer refers to malignant tumors originating in the bones and surrounding structures of the upper jaw (maxilla), eye socket (orbit), and the temporal fossa, which is located at the side of the skull. These cancers can significantly impact functions such as vision, chewing, and facial symmetry and often require complex, multidisciplinary treatment approaches.</skos:definition>
        <skos:prefLabel>Maxilla, Orbit, or Temporal Fossa Cancer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUtNAEY6SLedQqmx0HbAvy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUtNAEY6SLedQqmx0HbAvy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
        <rdfs:label>Fixed Maturity Asset</rdfs:label>
        <skos:altLabel>Fixed-Term Instrument</skos:altLabel>
        <skos:altLabel>Maturity-Certain Asset</skos:altLabel>
        <skos:altLabel>Maturity-Dated Asset</skos:altLabel>
        <skos:altLabel>Term-Specified Asset</skos:altLabel>
        <skos:definition>A Fixed Maturity Asset is a financial instrument where the principal amount is repaid in full at a specified maturity date. This type of asset provides a predictable repayment schedule, offering investors assurance of receiving their principal investment at the end of the term.</skos:definition>
        <skos:prefLabel>Fixed-Term Asset</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUuDgbKnORPEWWjF69P5dO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUuDgbKnORPEWWjF69P5dO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Integration Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;intégration</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Integración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Integración</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de integração</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Integration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Integrationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אינטגרציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एकीकरण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">整合条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">統合条項</skos:altLabel>
        <skos:definition>An integration clause is a contractual provision that declares that the written agreement is the final and complete expression of the parties&apos; intentions, and that any prior or contemporaneous agreements or understandings are merged into the written agreement.</skos:definition>
    </owl:Class>
    


