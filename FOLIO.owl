        <rdfs:label>Root Vegetables</rdfs:label>
        <skos:altLabel>Edible Roots</skos:altLabel>
        <skos:definition>Root vegetables are edible plants whose underground parts, such as roots, tubers, and bulbs, are consumed as food. They are known for their nutritional content, including vitamins, minerals, and fiber, and are a staple in many cuisines worldwide due to their versatility and storability.</skos:definition>
        <skos:prefLabel>Tubers</skos:prefLabel>
    </owl:Class>
    


