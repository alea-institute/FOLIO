        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81231"/>
        <rdfs:label>Coin-Operated Laundries and Drycleaners</rdfs:label>
        <skos:definition>See industry description for 812310.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ILdsvFzWSqu7oD2LS201Rw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ILdsvFzWSqu7oD2LS201Rw">
