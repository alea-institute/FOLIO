        <rdfs:label>Legally Compelled Disclosure Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de divulgation légalement contrainte</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de divulgación legalmente obligatoria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de divulgación legalmente obligatoria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de divulgação legalmente compelida</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur rechtlich verpflichtenden Offenlegung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Legally Compelled Disclosure Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חשיפה המחייב מבחינה משפטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी रूप से मजबूर करने वाली खुलासा शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律强制披露条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法的に強制された開示条項</skos:altLabel>
        <skos:definition>A Legally Compelled Disclosure Clause is a provision in a contract that requires one or both parties to disclose information if legally required to do so.</skos:definition>
    </owl:Class>
    


