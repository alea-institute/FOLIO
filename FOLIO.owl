    <!-- https://folio.openlegalstandard.org/R6e0IIeTTMVoQl5cw3E3co -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R6e0IIeTTMVoQl5cw3E3co">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBFOZ6k0p0FnZyMzuijRYdU"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_05"/>
        <rdfs:label>Mantle Cell Lymphoma</rdfs:label>
        <skos:altLabel>Aggressive B-Cell Lymphoma</skos:altLabel>
        <skos:altLabel>Cyclin D1 Positive Lymphoma</skos:altLabel>
        <skos:altLabel>Mantle Zone Lymphoma</skos:altLabel>
        <skos:definition>Mantle cell lymphoma is an aggressive type of non-Hodgkin lymphoma that originates in the B-cells located in the mantle zone of the lymph nodes. It is characterized by a specific genetic mutation involving the overexpression of the cyclin D1 protein, leading to uncontrolled cell growth.</skos:definition>
    </owl:Class>
    


