        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/d2Vz7BDbQWirPqRc5Gh-5A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/d2Vz7BDbQWirPqRc5Gh-5A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/p3puy1sATVuq3gaHLKktRg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423710"/>
        <rdfs:label>Hardware Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of hardware, knives, or handtools.</skos:definition>
        <skos:example>Brads merchant wholesalers</skos:example>
        <skos:example>Cutlery merchant wholesalers</skos:example>
        <skos:example>Fasteners (e.g., bolts, nuts, rivets, screws) merchant wholesalers</skos:example>
        <skos:example>Handtools (except motor vehicle, machinists&apos; precision) merchant wholesalers</skos:example>
        <skos:example>Hardware (except motor vehicle) merchant wholesalers</skos:example>
        <skos:example>Keys and locks merchant wholesalers</skos:example>
        <skos:example>Knives (except disposable plastics) merchant wholesalers</skos:example>
        <skos:example>Power handtools (e.g., drills, saws, sanders) merchant wholesalers</skos:example>
        <skos:example>Staples merchant wholesalers</skos:example>
        <skos:example>Tacks merchant wholesalers</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/d4V3IwbNR5OCUvIwkLKdyg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/d4V3IwbNR5OCUvIwkLKdyg">
