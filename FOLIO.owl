    <!-- https://folio.openlegalstandard.org/RC0wUY69V88vcxTEtW6C44c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0wUY69V88vcxTEtW6C44c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9fKvjVlII2PEtadGEDimB9"/>
        <rdfs:label>Photograph</rdfs:label>
        <skos:altLabel>Photo</skos:altLabel>
        <skos:altLabel>Picture</skos:altLabel>
        <skos:altLabel>Snapshot</skos:altLabel>
        <skos:definition>A Photograph is an image captured by a camera that records a visual representation of a subject using light-sensitive materials or digital sensors. Protected under copyright law, photographs grant the photographer exclusive rights to reproduce, distribute, and display the image.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC0wa0UA7rK35ZmEWYh7b9B -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0wa0UA7rK35ZmEWYh7b9B">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9m8Wz6rX8oJIJfhFFncV5x"/>
        <rdfs:label>Lack of Proportionality</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Absence de proportionnalité</skos:altLabel>
        <skos:altLabel>Failure of Proportionality</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de Proporcionalidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta de Proporcionalidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falta de proporcionalidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lack of Proportionality</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mangel an Verhältnismäßigkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר יחסיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुपातहीनता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不成比例</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">相当性の欠如</skos:altLabel>
        <skos:definition>The Lack of Proportionality is a defense in discovery and evidentiary matters where the requested information or evidence is not reasonably related to the claims or defenses in the legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC0ycQb3ti4yr7qDxhAD1Gl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0ycQb3ti4yr7qDxhAD1Gl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7oBWHStfmqTLn2MypkW3Pj"/>
        <rdfs:label>Joint Venture</rdfs:label>
        <skos:altLabel>Business Partnership</skos:altLabel>
        <skos:altLabel>Collaborative Venture</skos:altLabel>
        <skos:altLabel>Strategic Alliance</skos:altLabel>
        <skos:definition>A joint venture is a business arrangement where two or more parties agree to pool their resources to accomplish a specific task, project, or business activity. Each party in a joint venture retains its separate legal status while sharing ownership, control, and profits of the joint enterprise.</skos:definition>
        <skos:example>BMW and Toyota&apos;s joint venture to develop hydrogen fuel cell technology</skos:example>
        <skos:example>Sony Ericsson was a joint venture between Sony Corporation and Ericsson to produce mobile phones.</skos:example>
        <skos:example>The venture between Google and NASA to collaborate on space exploration technologies.</skos:example>
        <skos:prefLabel>Cooperative Enterprise</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC0zDBYjiRDO2hTdbUIcdhN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0zDBYjiRDO2hTdbUIcdhN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvD6VheGrBYqJhgQDfMbrV"/>
        <rdfs:label>Grand Jury Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf die Grand Jury-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Grand Jury Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula del Gran Jurado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula del Gran Jurado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula do Grande Júri</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la clause du Grand Jury</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף השופט הגדול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ग्रैंड ज्यूरी क्लॉज क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">大陪审团条款主张</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">大陪審員条項主張</skos:altLabel>
        <skos:definition>A Grand Jury Clause claim is a legal assertion that an individual&apos;s Fifth Amendment rights have been violated. In the United States Constitution, the Grand Jury Clause of the Fifth Amendment requires that a grand jury indictment or presentment be obtained before a person can be charged with a serious federal crime. A claim related to this clause may arise if an individual believes that their case was not properly or fairly considered by a grand jury, or if the grand jury proceedings were flawed in some significant way.</skos:definition>
    </owl:Class>
    


