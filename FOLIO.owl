            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>L470 Enforcement</rdfs:label>
        <skos:definition>The concept of L470 Enforcement refers to the stage of legal proceedings where a court order or judgment is enforced, typically through the use of legal remedies such as garnishment, attachment, or seizure of property.</skos:definition>
    </owl:Class>
    


