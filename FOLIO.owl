            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Child Support Court</rdfs:label>
        <skos:definition>A Child Support Court is a specialized court or division within the legal system that handles cases related to child support obligations. These courts oversee matters such as the establishment, modification, enforcement, and collection of child support payments.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8v6tFfln3S9d5Ob6qMKdgQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8v6tFfln3S9d5Ob6qMKdgQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3Q1HDu5jO8nvhdbr2Uj0c"/>
        <rdfs:label>Florida Circuit Court - Flagler County - 7th Circuit Court</rdfs:label>
        <skos:definition>A court located in Flagler County, Florida that is part of the larger Florida Circuit Court system, which is responsible for administering legal proceedings within the state.</skos:definition>
    </owl:Class>
    


