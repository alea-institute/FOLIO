        <rdfs:label>Auction Rate Dividend Payment</rdfs:label>
        <skos:altLabel>Auction Dividend</skos:altLabel>
        <skos:definition>Auction Rate Income refers to a type of dividend income where the dividend rate is periodically adjusted through an auction process, such as a Dutch auction. This mechanism allows the dividend rate to be determined by investor demand, resulting in potentially variable payouts.</skos:definition>
        <skos:prefLabel>Auction-Based Dividend</skos:prefLabel>
    </owl:Class>
    


