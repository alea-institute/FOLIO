    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RPwAjD9D1KwiPvatTVOkYp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RPwAjD9D1KwiPvatTVOkYp">
