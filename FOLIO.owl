        <skos:altLabel xml:lang="pt-br">Cláusula de remédio exclusivo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de único recurso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de único remedio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur ausschließlichen Abhilfe</skos:altLabel>
