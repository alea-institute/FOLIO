        <skos:altLabel xml:lang="pt-br">Hiligaynon</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ヒリガイノン語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">希利盖农语</skos:altLabel>
        <skos:definition>A language spoken in the Western Visayas region of the Philippines, specifically in the provinces of Iloilo, Guimaras, and Negros Occidental.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDNDZH2X3OVk6FwdmXYvxqK -->

