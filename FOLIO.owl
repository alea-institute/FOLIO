        <skos:altLabel xml:lang="pt-br">Cláusula de morte</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für den Todesfall</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Upon Death Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף לאחר מות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मृत्यु के बाद शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">死亡時条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">死亡条款</skos:altLabel>
        <skos:definition>An &quot;Upon Death Clause&quot; is a provision in a contract that specifies what will happen to the contract or its subject matter upon the death of one of the parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYnKl3B3eiY89ibABaeHA5 -->

