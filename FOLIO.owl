        <skos:altLabel xml:lang="de-de">Annullierung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Annulment</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Anulación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Anulação</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Nulidad</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ביטול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रद्दीकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">废除</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無効化</skos:altLabel>
        <skos:definition>The legal process of declaring a marriage null and void, as if it never existed, typically due to some defect or impediment that existed at the time of the marriage.</skos:definition>
    </owl:Class>
    


