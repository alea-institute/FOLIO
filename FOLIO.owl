        <skos:altLabel xml:lang="es-mx">Demanda de Sentencia por Incumplimiento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Default Judgment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de julgamento por revelia</skos:altLabel>
        <skos:altLabel>Request for Entry of Default</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en jugement par défaut</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין בברירת מחדל</skos:altLabel>
