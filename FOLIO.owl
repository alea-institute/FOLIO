        <rdfs:label>New Mexico Magistrate Court - Luna County</rdfs:label>
        <skos:definition>A court located in Luna County, New Mexico that has limited jurisdiction over certain types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiLGvePXlmK5WcIC4CQuPz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiLGvePXlmK5WcIC4CQuPz">
