        <skos:altLabel xml:lang="es-mx">Proporcionar Alcohol a Menores</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Suministro de Alcohol a Menores</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Supplying Alcohol to a Minor</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ספק של כוליות לקטין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नाबालिग को शराब देना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">向未成年人提供酒精</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">未成年者へのアルコール提供</skos:altLabel>
        <skos:definition>The act of giving or serving alcoholic beverages to an individual who is under the legal drinking age, which may result in legal consequences such as charges of negligence or violation of liquor laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBbkDB8kd8SkZbK5vvNejND -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBbkDB8kd8SkZbK5vvNejND">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Xkp4FqX83NG5ZI0CDfQ1k"/>
        <rdfs:label>Motion to Dismiss for Failure to State a Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Abweisung wegen mangelnder Klagebefugnis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Desestimación por Falta de Alegación de Causa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Inadmisión por Falta de Alegación de Causa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Dismiss for Failure to State a Claim</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Demissão por Falta de Fundamento Jurídico</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en irrecevabilité pour absence de fondement juridique</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לדחיית התביעה עקב כשל בהצהרת טענה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा न करने के लिए खारिज करने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">主張不成立のための却下申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未能陈述索赔的驳回动议</skos:altLabel>
        <skos:definition>A Motion to Dismiss for Failure to State a Claim is a legal request made by a defendant to dismiss a case on the grounds that the plaintiff has failed to allege sufficient facts to support a legal claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBbkOoA0Hp0UmEnkGJOjs6D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBbkOoA0Hp0UmEnkGJOjs6D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/8.00-Skin-Adult.htm"/>
        <rdfs:label>Skin Disorders</rdfs:label>
        <skos:altLabel>Cutaneous Disorders</skos:altLabel>
        <skos:definition>Skin disorders encompass a range of conditions affecting the skin&apos;s structure and function, including inflammatory, infectious, and neoplastic diseases. These disorders can cause symptoms such as rashes, lesions, and systemic effects that impair the skin&apos;s ability to protect the body.</skos:definition>
        <skos:prefLabel>Dermatological Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBbkwoH1uH2PhTq4RgSutqL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBbkwoH1uH2PhTq4RgSutqL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVcQsyiR3zEN86uQG2Onsy"/>
        <rdfs:label>Buyer Consent Requirement Language</rdfs:label>
