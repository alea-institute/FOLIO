        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R78PKqeEIORKpYVwEfC4aG4"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bankruptcy Plan Vote</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abstimmung über den Insolvenzplan</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bankruptcy Plan Vote</skos:altLabel>
        <skos:altLabel>Event</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Votación del Plan de Bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Votación del Plan de Quiebra</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Votação do plano de falência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vote sur le plan de faillite</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצבעה על תוכנית חדשות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन योजना वोट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产计划投票</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産計画の投票</skos:altLabel>
        <skos:definition>A Bankruptcy Plan Vote (Event) is a specific type of event within the broader category of Bankruptcy and Restructuring Events, where stakeholders vote on a proposed plan for the distribution of assets and liabilities in a bankruptcy case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQY7Pn5oyAj8JroU6RUUw8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQY7Pn5oyAj8JroU6RUUw8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Takelma</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQZfWGxOZnZAvQ3ghLRvae -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQZfWGxOZnZAvQ3ghLRvae">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
        <rdfs:label>Theft of Motor Vehicle Parts/Accessories</rdfs:label>
        <skos:altLabel xml:lang="de-de">Diebstahl von Kraftfahrzeugteilen/-zubehör</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Robo de partes/accesorios de vehículos motorizados</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Robo de piezas/accesorios de vehículos motorizados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Roubo de peças/acessórios de veículos automotores</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Theft of Motor Vehicle Parts/Accessories</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vol de pièces/accessoires de véhicules à moteur</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גניבת חלקי/אביזרי רכב נייד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मोटर वाहन के भाग / सहायक उपकरणों की चोरी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">机动车零部件/配件盗窃</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自動車部品/アクセサリーの盗難</skos:altLabel>
        <skos:definition>Theft of Motor Vehicle Parts/Accessories: The act of taking or removing parts or accessories from a motor vehicle without the owner&apos;s consent, with the intention of permanently depriving the owner of their property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQaOyQUSSy8yZFZ5oy01vX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQaOyQUSSy8yZFZ5oy01vX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RkDm9J359mc6mQ5uj6uiXq"/>
        <rdfs:label>Activist Shareholder</rdfs:label>
        <skos:altLabel>Activist Investor</skos:altLabel>
        <skos:altLabel>Shareholder Activist</skos:altLabel>
        <skos:definition>An Activist Shareholder is an investor who uses their equity stake in a corporation to push for changes within the company. These changes can include modifications in management, corporate policies, strategic direction, and overall governance to increase shareholder value or address specific concerns.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQdpZxOSwnzcJhCmKnVml6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQdpZxOSwnzcJhCmKnVml6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkc9fh6vYvZbJc7ERuIJCf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9dd6R73IfKyiskT5Jf62R7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rchny3YFXoQyenv6XUbyo0"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>L450 Trial and Hearing Attendance</rdfs:label>
        <skos:definition>The concept of L450 Trial and Hearing Attendance refers to the act of physically being present at a trial or hearing, and is a subcategory of the broader concept of trial preparation and trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQdzQQxF9tJuKhWA3Xv9Ug -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQdzQQxF9tJuKhWA3Xv9Ug">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMCyg29yJdESbSXnNRLABk"/>
        <rdfs:label>Investment Fund Unit</rdfs:label>
        <skos:altLabel>Investment Fund Unit</skos:altLabel>
        <skos:altLabel>Investment Unit</skos:altLabel>
        <skos:altLabel>Pool Unit</skos:altLabel>
        <skos:altLabel>Trust Unit</skos:altLabel>
        <skos:definition>Investment Fund Unit refers to ownership interests in certain types of investment funds or pooled investment vehicles, such as mutual funds, ETFs, and REITs. Unlike traditional shares in a corporation, units represent a proportional stake in the collective assets of the fund, providing investors with a share of profits, losses, and distributions.</skos:definition>
        <skos:prefLabel>Fund Unit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQhXoruGQAMaQvENhaOFRR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQhXoruGQAMaQvENhaOFRR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsTnyZoBckeYgjbwks7DL8"/>
        <rdfs:label>California Superior Court - San Diego Cty.</rdfs:label>
        <skos:definition>A court of general jurisdiction in San Diego County, California, with the power to hear and decide a wide range of legal cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQiW39W3CDhHVyOO8bGdhH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQiW39W3CDhHVyOO8bGdhH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDhhApr0eDVle3F076WAVct"/>
        <rdfs:label>Debt Collection Law</rdfs:label>
        <skos:definition>Debt Collection Law (also known as Debt Recovery Law) refers to the legal processes and actions taken to collect outstanding debts owed by individuals or businesses. It involves methods such as negotiation, litigation, and enforcement of judgments to ensure creditors receive payment. The legal practices and regulations related to the collection of debts by creditors or third-party agencies seek to ensure fair treatment of debtors and compliance with statutory procedures during the collection process.</skos:definition>
        <skos:prefLabel>Debt Recovery Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQjEGIpmUNhT9brH9gpy58 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQjEGIpmUNhT9brH9gpy58">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8QBuMoK1uPFeLW0sg40CdA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>contact_info segment</rdfs:label>
        <skos:definition>&quot;This is not an actual segment of the file, per se, like the rest of the segments listed above.  This segment contains a list of fields that will be used to represent contact information.  When a contact is requested in a segment, that element will be listed and all fields in this segment will be the children of that element.  

The EXTEND_HEADER segment was purposely omitted from this segment.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQnybkYAVugHLSCVPFxy8s -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQnybkYAVugHLSCVPFxy8s">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:label>Credit Counseling Waiver</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Credit Counselling Waiver</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Exención de Asesoramiento de Crédito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Exención de Asesoría de Crédito</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Renonciation à la conseil en crédit</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Renúncia à orientação de crédito</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzicht auf Kreditberatung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פטור מייעוץ אשראי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रेडिट काउंसलिंग वेवर</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クレジットカウンセリング免除</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">信用咨询豁免</skos:altLabel>
        <skos:definition>A Credit Counseling Waiver is a legal document that allows an individual to waive the requirement of credit counseling before filing for bankruptcy or restructuring.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQqi86T2QOlist6vhRfdk2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQqi86T2QOlist6vhRfdk2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R955FuA1bPwrZWwF8Nc3v8A"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXwl9xfFnpmQn8Ex816ROD"/>
