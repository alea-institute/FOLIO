    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOWSerdWZR3POAsYxgxlDw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOWSerdWZR3POAsYxgxlDw">
