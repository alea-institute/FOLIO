        <rdfs:label>Indiana Circuit Court - Madison County 6</rdfs:label>
        <skos:definition>A court of general jurisdiction in Madison County, Indiana, with the authority to hear civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


