        <rdfs:label>Trial Preparation Practice</rdfs:label>
        <skos:altLabel>Trial Preparation</skos:altLabel>
        <skos:altLabel>Trial Preparation Service</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Preparação para julgamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de preparación de juicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de preparación de juicios</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Préparation de procès</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial Preparation Practice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorbereitung von Gerichtsverfahren</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול הכנה למשפטים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल तैयारी अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">审判准备实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判準備実務</skos:altLabel>
        <skos:definition>Trial Preparation Practice refers to the specific legal work performed by a Legal Services Provider in preparing for a trial, including but not limited to, gathering evidence, interviewing witnesses, and drafting trial briefs.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R87ItBEU3GWsIfCKGG3RMPN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R87ItBEU3GWsIfCKGG3RMPN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RgBq3kUkMfNYtUi93XIh0i"/>
        <rdfs:label>Material Adverse Effect Definition - &quot;Arising from/out of and Resulting From&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje &quot;Arising from/out of and Resulting From&quot;</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje &quot;Arising from/out of and Resulting From&quot;</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Effekts - Sprache &quot;Entstehend aus/ausgehend von und resultierend aus&quot;</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Linguagem &quot;Decorrente de e Resultante De&quot;</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de l&apos;effet indésirable important - Langage &quot;Découlant de et résultant de&quot;</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - &quot;Arising from/out of and Resulting From&quot; Language</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת השפעה נזיקה חומרית - שפת &quot;Arising from/out of and Resulting From&quot;</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - &quot;Arising from/out of and Resulting From&quot; भाषा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-「起因し/由来し、かつ、それによって生じる」言語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">重大不利影响定义-“源自/来自和由此产生的”语言</skos:altLabel>
        <skos:definition>A Material Adverse Effect (MAE) Definition - &quot;Arising from/out of and Resulting From&quot; Language refers to a clause in a contract that outlines the specific circumstances under which a party can terminate the agreement due to a significant negative change in the financial condition or business operations of the other party, which must be directly caused by a specific event or circumstance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R87M97iEkZoIZm400nVmw8v -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R87M97iEkZoIZm400nVmw8v">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8JVOGBEzEQHWl2bYk4uQam"/>
        <rdfs:label>Prior Art Search Process</rdfs:label>
        <skos:definition>The prior art search process is a methodical examination conducted to identify existing knowledge, inventions, or technologies relevant to a new invention or patent application. This process helps determine the novelty and non-obviousness of the invention by uncovering prior art that may impact its patentability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R87MDAJj8ZL7SprFAEqipk2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R87MDAJj8ZL7SprFAEqipk2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
        <rdfs:label>Informed Consent</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Consentement éclairé</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Consentimento informado</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Consentimiento Informado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Consentimiento Informado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Informed Consent</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Informierte Einwilligung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכמה מושכלת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सूचित सहमति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">インフォームド・コンセント</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">知情同意</skos:altLabel>
        <skos:definition>The concept of Informed Consent refers to the legal requirement for medical professionals to fully inform patients of the risks and benefits of a medical procedure or treatment, and to obtain the patient&apos;s voluntary agreement to undergo the procedure or treatment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R87PmoWmotSgo32gCYT29sw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R87PmoWmotSgo32gCYT29sw">
