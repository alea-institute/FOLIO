        <skos:altLabel xml:lang="pt-br">especialista nomeado pela parte</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">expert désigné par une partie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">vom Gericht ernannter Sachverständiger</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מומחה מונה על ידי המפלגה</skos:altLabel>
