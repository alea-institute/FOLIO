        <rdfs:label>Document Provenance</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Document Provenance</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Dokumentenherkunft</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Procedencia del documento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Procedencia del documento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Procedência do documento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Provenance du document</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מקור המסמך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दस्तावेज़ प्रोवेनेंस</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書の出所</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">文档来源</skos:altLabel>
        <skos:definition>Source of a particular document, which could include Forums (e.g., courts, government agencies), Actors (e.g., Plaintiff, Lender), vendors (e.g., Thomson Reuters, LexisNexis, vLex, Fastcase, Docket Alarm), or many others.</skos:definition>
        <skos:prefLabel>Document Source</skos:prefLabel>
    </owl:Class>
    


