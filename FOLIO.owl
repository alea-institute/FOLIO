        <skos:altLabel>Legal Process Outsourcer</skos:altLabel>
        <skos:definition>An Alternative Legal Services Provider (ALSP) is an entity that delivers legal or legal-related services outside the conventional law firm model.</skos:definition>
        <skos:prefLabel>ALSP</skos:prefLabel>
    </owl:Class>
    


