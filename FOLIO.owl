    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/HTW_cnH9Q86Nm8zI4prPbQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/HTW_cnH9Q86Nm8zI4prPbQ">
