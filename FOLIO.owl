    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/qDsXOU70Tf6usMKyrcjeUQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/qDsXOU70Tf6usMKyrcjeUQ">
