        <skos:altLabel xml:lang="pt-br">Cláusula de resolução de disputas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dispute Resolution Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schiedsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פתרון סכסוכים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विवाद समाधान अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">争议解决条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">紛争解決条項</skos:altLabel>
        <skos:definition>A Dispute Resolution Clause is a provision in a contract that outlines the process for resolving any disagreements or conflicts that may arise between the parties involved, typically through negotiation, mediation, or arbitration.</skos:definition>
    </owl:Class>
    


