        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
        <rdfs:label>Current Legal Efficacy</rdfs:label>
        <skos:altLabel xml:lang="de-de">Aktuelle Rechtswirksamkeit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Efficacité juridique actuelle</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Eficácia jurídica atual</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">当前法律效力</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現行の法的効力</skos:altLabel>
        <skos:definition>Property of a Legal Authority, annotating whether that authority (e.g., caselaw, statute, rule, regulation) is currently effective, or whether it is obsolete (e.g., overruled judicial opinion, superseded statute).</skos:definition>
        <skos:prefLabel>Citator Results</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RtSnrf1URIhJNP0fCJ6SZ7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RtSnrf1URIhJNP0fCJ6SZ7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sd4v04cEXnzbttN2gUEpV"/>
        <rdfs:label>Mammals</rdfs:label>
        <skos:definition>Mammals are a class of vertebrate animals characterized by the presence of mammary glands which produce milk for feeding their young, hair or fur, and a neocortex region in the brain. Mammals are warm-blooded and include a wide range of species from terrestrial to aquatic environments, such as humans, elephants, and whales.</skos:definition>
        <skos:prefLabel>Mammalia</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RtUC1tvBcYyMrybhdzVzAg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RtUC1tvBcYyMrybhdzVzAg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP"/>
        <rdfs:label>MAE-Based Antitrust Standard</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estándar Antimonopolio Basado en MAE</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándar Antimonopolio Basado en MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">MAE-Based Antitrust Standard</skos:altLabel>
        <skos:altLabel xml:lang="de-de">MAE-basierte Kartellrechtsnorm</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">MAEベースの独占禁止法基準</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Norme antitrust basée sur le MAE</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Padrão antitruste baseado em MAE</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקן נגד- trust המבוסס על MAE</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एमएई-आधारित विपणि नीति</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">基于MAE的反垄断标准</skos:altLabel>
        <skos:definition>A MAE-Based Antitrust Standard is a legal concept that sets limitations on antitrust efforts based on the occurrence of a material adverse effect, which is a significant negative change in the financial condition or business operations of a company.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RtVEoiPl048ZfSUppj1Cy2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RtVEoiPl048ZfSUppj1Cy2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOQpX5t5sVf55UPK2CfZTy"/>
        <rdfs:label>Bonded Labor Claim</rdfs:label>
        <skos:definition>A bonded labor claim alleges that an individual is forced to work under a debt or other obligation that they cannot repay and that limits their freedom. This practice is a form of modern-day slavery and is illegal under international law and in many national jurisdictions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RtYoJXrPiwPxepfYK3gpd6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RtYoJXrPiwPxepfYK3gpd6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ0dgV4Z2Xk7aGfJt2nSj7"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_00D7"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_10"/>
        <rdfs:label>Sjögren’s Syndrome</rdfs:label>
        <skos:altLabel>Sicca Syndrome</skos:altLabel>
        <skos:altLabel>Sjögren&apos;s Disease</skos:altLabel>
        <skos:definition>Sjögren&apos;s syndrome is an immune-mediated disorder of the exocrine glands. Involvement of the lacrimal and salivary glands is the hallmark feature, resulting in symptoms of dry eyes and dry mouth, and possible complications, such as corneal damage, blepharitis (eyelid inflammation), dysphagia (difficulty in swallowing), dental caries, and the inability to speak for extended periods of time. Involvement of the exocrine glands of the upper airways may result in persistent dry cough.</skos:definition>
    </owl:Class>
    


