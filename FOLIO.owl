        <skos:altLabel xml:lang="pt-br">Hupa</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フーパ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">胡帕</skos:altLabel>
