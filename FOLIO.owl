                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCwe6IUx1b5fuhKW0fivDZu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Consideration - Bond Assets</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Consideration - Bond Assets</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Contraprestación - Activos de bonos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Contraprestación - Activos de bonos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Contraprestação - Ativos de títulos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Contrepartie - Actifs obligataires</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenleistung - Anleihevermögenswerte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תמורה - נכסי אגרות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विचार - बॉन्ड संपत्तियाँ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">对价 - 债券资产</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">対価 - 債券資産</skos:altLabel>
        <skos:definition>Bond assets refer to debt securities issued by corporations, governments, or other entities that may be part of the target company&apos;s financial assets being transferred during the deal. Bonds represent a promise by the issuer to repay the principal amount along with interest to the bondholder at a specified maturity date.</skos:definition>
    </owl:Class>
    


