        <rdfs:label>Mississippi Ethics Opinions</rdfs:label>
        <skos:definition>Mississippi Ethics Opinions are official statements issued by the Mississippi State Courts that provide guidance on ethical issues faced by attorneys and judges in the state of Mississippi.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fwZiSjoYa5rxaKAZrRRBl -->

