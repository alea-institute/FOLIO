        <rdfs:label>Indiana Superior Court - Morgan County, Superior Court2</rdfs:label>
        <skos:definition>A court of general jurisdiction in Morgan County, Indiana, with authority over civil and criminal cases.</skos:definition>
    </owl:Class>
    


