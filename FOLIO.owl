        <skos:altLabel xml:lang="es-mx">Deber intransferible</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dever intransferível</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Devoir non déléguable</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nondelegable Duty</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unübertragbare Pflicht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חובה לא ניתנת להעברה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अप्रत्याश्रित कर्तव्य</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不可委托职责</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">委任不能義務</skos:altLabel>
        <skos:definition>A nondelegable duty is a legal obligation that cannot be transferred or assigned to another party, even if that party is an agent or representative of the original party.</skos:definition>
    </owl:Class>
    


