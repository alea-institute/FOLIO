        <skos:altLabel xml:lang="en-gb">Customer Injured Off Leased Premises</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kunde verletzt außerhalb des gemieteten Geländes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לקוח נפגע מחוץ למקום המשכיר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ग्राहक किराएदारी के बाहर घायल</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リースされた敷地外での顧客の負傷</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">客户在租赁场所外受伤</skos:altLabel>
        <skos:definition>A customer injured off leased premises refers to a legal claim made against a property owner or tenant for injuries sustained by a customer on a property that is not owned by the defendant, but is being leased or rented.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCjFyTJP2FNg122woDypkO0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCjFyTJP2FNg122woDypkO0">
