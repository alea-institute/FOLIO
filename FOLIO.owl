        <skos:altLabel xml:lang="zh-cn">闭幕式</skos:altLabel>
        <skos:definition>The Closing Event is a specific type of event that occurs during a merger and acquisition or transaction, marking the completion of the deal.</skos:definition>
        <skos:prefLabel>Sale Event</skos:prefLabel>
    </owl:Class>
    


