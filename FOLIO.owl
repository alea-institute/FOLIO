        <rdfs:label>New York Traffic Court</rdfs:label>
        <skos:definition>New York Traffic Court is a specialized court within the New York State Courts system that handles traffic violations and related matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCfMU02GZfQ9SBjEPUiAYl9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCfMU02GZfQ9SBjEPUiAYl9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoVC6WY5Cc00C8Q9AaBFQo"/>
        <rdfs:label>Filing Receipt Number</rdfs:label>
        <skos:definition>A Filing Receipt Number, such as an immigration filing receipt number or other regulatory filing receipt number, is a unique identifier assigned to an application or filing submitted to a government agency, indicating that the submission has been received and officially acknowledged. This number is used to track the progress of the filing and corresponds to the specific case for reference during the processing period.</skos:definition>
    </owl:Class>
    


