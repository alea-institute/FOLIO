            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Garnishment</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Attachment of Earnings</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Embargo de salario</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Embargo de sueldo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lohnpfändung</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Penhora de salário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Saisie de salaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעצר שכר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गार्निशमेंट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工资扣押</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">給与差し押え</skos:altLabel>
        <skos:definition>A garnishment is a legal process where a creditor can collect a debt owed by a debtor by seizing a portion of their wages or assets, as authorized by a court order.</skos:definition>
    </owl:Class>
    


