        <rdfs:label>L200 Pre-Trial Pleadings and Motions</rdfs:label>
        <skos:definition>L200 Pre-Trial Pleadings and Motions refer to the initial legal documents and requests filed by parties in a lawsuit before the trial phase, including complaints, answers, and motions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jfj4n9nrwFA6hog2jNl5I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jfj4n9nrwFA6hog2jNl5I">
