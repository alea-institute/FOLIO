        <skos:altLabel xml:lang="es-mx">Moción para Declarar Nulo el Emplazamiento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Quash Service</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Anulação da Citação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en annulation de la signification</skos:altLabel>
