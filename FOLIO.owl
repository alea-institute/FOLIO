        <skos:altLabel>Consideration Objectives</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Contraprestación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Contraprestación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Contraprestação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Contrepartie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenleistung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תמורה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विचार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">对价</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">対価</skos:altLabel>
        <skos:definition>Consideration refers to the value given in exchange for a promise or performance in a legal contract, often involving the transfer of money, property, or services.</skos:definition>
    </owl:Class>
    


