        <skos:altLabel xml:lang="hi-in">इक्विटी फाइनेंसिंग अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">株式資本調達の実務</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">股权融资实践</skos:altLabel>
        <skos:definition>Equity financing is the method of raising capital by selling company stock to investors. In return for the investment, the shareholders receive ownership interests in the company.</skos:definition>
        <skos:hiddenLabel>FINEQU</skos:hiddenLabel>
        <skos:prefLabel>Equity Offering Practice</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R5nqhj18ZtbrxIfaCVGQVr -->

