        <rdfs:label>Nil Paid Letter</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JH3AMpNUdvp2PWhFEmQkT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JH3AMpNUdvp2PWhFEmQkT">
