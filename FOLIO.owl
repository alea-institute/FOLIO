        <skos:altLabel xml:lang="pt-br">Cláusula de conformidade com as políticas da empresa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cumplimiento de políticas de la empresa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de cumplimiento de políticas de la empresa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Compliance with Company Policies Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Einhaltung der Unternehmensrichtlinien</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף עמיתות עם מדיניות החברה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कंपनी नीतियों के अनुपालन अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">企業ポリシー順守条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">遵守公司政策条款</skos:altLabel>
        <skos:definition>A Compliance with Company Policies Clause is a provision in a contract that requires one or both parties to adhere to the policies and regulations of the company involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R93SGZlivQyshkPtiqtm24G -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R93SGZlivQyshkPtiqtm24G">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RTSI7ogxo4mf2wErPNxZDK"/>
        <rdfs:label>Equilibrium Disorder</rdfs:label>
        <skos:altLabel>Balance Condition</skos:altLabel>
        <skos:altLabel>Dizziness</skos:altLabel>
        <skos:definition>Equilibrium Disorder (also known as Dizziness or a balance condition) encompass a range of disorders that cause sensations of spinning (vertigo), lightheadedness, unsteadiness, or a loss of balance. These conditions often require medical evaluation and treatment to manage symptoms and address underlying causes such as inner ear disorders, neurological conditions, or cardiovascular issues.</skos:definition>
        <skos:prefLabel>Vertigo</skos:prefLabel>
    </owl:Class>
    


