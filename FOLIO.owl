        <skos:altLabel>Payment Slip</skos:altLabel>
        <skos:altLabel>Sales Receipt</skos:altLabel>
        <skos:altLabel>Transaction Confirmation Document</skos:altLabel>
        <skos:definition>A Purchase Receipt is a financial document provided by a seller to a buyer as proof of a completed transaction. It details the goods or services purchased, the amount paid, and often the method of payment.</skos:definition>
        <skos:prefLabel>Receipt</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCwxVWPUdbPjn2tWtFJg6IZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCwxVWPUdbPjn2tWtFJg6IZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D"/>
        <rdfs:label>Trespass</rdfs:label>
        <skos:altLabel xml:lang="de-de">Hausfriedensbruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Intrusión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Intrusión</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Invasão de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trespass</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de propriété</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת גבולות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अतिक्रमण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不法侵入</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法侵入</skos:altLabel>
        <skos:definition>The act of unlawfully entering or interfering with someone else&apos;s property, whether it be real property or personal property, resulting in potential liability for the trespasser.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCwxbPXNA8weZDagHlCea -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCwxbPXNA8weZDagHlCea">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
        <rdfs:label>Collaboration Management</rdfs:label>
        <skos:definition>Collaboration Management refers to the process of coordinating and managing the sharing of information and resources among individuals or groups within a legal context, including the use of extranets, virtual data rooms, and collaboration platforms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCx06H2IQcN5MiSP1I4jpxr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCx06H2IQcN5MiSP1I4jpxr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
        <rdfs:label>Evidence Management</rdfs:label>
        <skos:definition>Evidence Management refers to the process of collecting, organizing, and preserving evidence in a legal case, with the aim of ensuring its admissibility and reliability in court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCx2tj3BatPVAdcOjvc8MEH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCx2tj3BatPVAdcOjvc8MEH">
