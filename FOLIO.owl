        <skos:altLabel xml:lang="zh-cn">美国宪法索赔</skos:altLabel>
        <skos:definition>U.S. Constitutional Claims are claims that a person&apos;s rights guaranteed by the Constitution have been infringed upon by a government entity or individual acting under the authority of the government.</skos:definition>
    </owl:Class>
    


