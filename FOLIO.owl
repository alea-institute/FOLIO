        <rdfs:label>Maine Supreme Court</rdfs:label>
        <skos:definition>The Maine Supreme Court is the highest court in the state of Maine and serves as the final court of appeal for legal cases within the state&apos;s judicial system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYtzibGIkGDjMH5zFGlU8H -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYtzibGIkGDjMH5zFGlU8H">
