    <!-- https://folio.openlegalstandard.org/pqJmuIOvT96q9Lajk_A4xA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/pqJmuIOvT96q9Lajk_A4xA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/1vxa6AN8TJa3-QTPxRNiDA"/>
