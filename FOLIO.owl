        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
        <rdfs:label>Clinic Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle en clinique</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klinikfehler</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em clínica</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クリニックの医療過誤</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">诊所过失</skos:altLabel>
        <skos:definition>Clinic Malpractice refers to a type of medical malpractice claim that arises from negligent actions or omissions by healthcare providers in a clinic setting.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RZsfzywFYpJOHfnZcR9Leg -->

