        <rdfs:label>ODR - Machine Facilitation</rdfs:label>
        <skos:definition>ODR - Machine Facilitation refers to the use of technology to assist in resolving disputes through an online platform, within the context of an Online Dispute Resolution (ODR) Forum.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qsTGPudSzjxbZQyxDQbPd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qsTGPudSzjxbZQyxDQbPd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWNHtgqXOWSnS2m1dFK5L0"/>
        <rdfs:label>Payroll Tax Payment</rdfs:label>
        <skos:altLabel>Payroll Tax Remittance</skos:altLabel>
        <skos:altLabel>Taxes on Payroll and Workforce</skos:altLabel>
        <skos:altLabel>Wage Tax Payment</skos:altLabel>
        <skos:definition>A Payroll Tax Payment, also known as Taxes on Payroll and Workforce, refers to the taxes an employer withholds from employees&apos; wages and pays on their behalf, as well as the employer&apos;s own contribution to social security and other employee benefits. These payments include income tax withholdings, social security contributions, Medicare taxes, and unemployment insurance taxes.</skos:definition>
        <skos:prefLabel>Workforce Tax Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qsus2EDS3QX2jMpmAQVIH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qsus2EDS3QX2jMpmAQVIH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RouKBMqFNMZxi21EPh6JJ6"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Future Earning Capacity</rdfs:label>
        <skos:altLabel xml:lang="es-es">Capacidad de ingresos futuros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Capacidad de ingresos futuros</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Capacidade de ganho futuro</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Capacité de gains futurs</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Future Earning Capacity</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zukünftige Erwerbsfähigkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">יכולת הרווחה עתידית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भविष्य की कमाई क्षमता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">将来の収益能力</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未来收入能力</skos:altLabel>
        <skos:definition>The concept of &quot;Future Earning Capacity&quot; refers to the potential income that an individual could have earned in the future, had they not been injured or suffered damages, and is used to calculate economic damages in legal cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qtGVrRkHrukFbMI54recX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qtGVrRkHrukFbMI54recX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Additional Insured Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Additional Insured Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;assuré supplémentaire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Asegurado Adicional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Asegurado Adicional</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de segurado adicional</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zusatzversicherungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מבוטח נוסף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अतिरिक्त बीमाकृत शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">追加被保険者条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">附加被保险人条款</skos:altLabel>
        <skos:definition>An Additional Insured Clause is a provision in a contract that extends insurance coverage to a party who is not originally named as an insured under the policy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7quKu2uOiDPbRllssTf8v0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7quKu2uOiDPbRllssTf8v0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.canb.uscourts.gov/ecf/efiling-manual/motions-general"/>
        <rdfs:label>Motion for Access to Tax Documents</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Zugang zu Steuerdokumenten</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Acceso a Documentos Fiscales</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Access to Tax Documents</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Acesso a Documentos Fiscais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête d&apos;accès aux documents fiscaux</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de Acceso a Documentos Fiscales</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לגישה למסמכי מס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कर दस्तावेजों तक पहुंच के लिए अभियान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">税務書類へのアクセス申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">获取税务文件动议</skos:altLabel>
        <skos:definition>A Motion for Access to Tax Documents is a legal request made in a bankruptcy case seeking permission to obtain and review tax-related records or documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qwFGG4GQtcyJtzRIzPSGN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qwFGG4GQtcyJtzRIzPSGN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Novation Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de novation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Novación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Novación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de novação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Novation Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Novationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף נובציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नोवेशन क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">移転条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">转让条款</skos:altLabel>
        <skos:definition>A novation clause is a provision in a contract that allows for the substitution of a new party for one of the original parties, thereby releasing the original party from their obligations and transferring them to the new party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7qxVfcFITBa22T7miUZb0x -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7qxVfcFITBa22T7miUZb0x">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y"/>
        <rdfs:label>Cattle</rdfs:label>
        <skos:altLabel>Bovines</skos:altLabel>
        <skos:altLabel>Bulls</skos:altLabel>
        <skos:definition>Cattle are domesticated bovine animals that belong to the species Bos taurus, commonly raised for their meat, milk, and hides, as well as for labor. This group includes both cows (females) and bulls (males), and they play a significant role in agriculture and human economies.</skos:definition>
        <skos:prefLabel>Cows</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r0TvVRRmeI8IQTxKXeEwe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r0TvVRRmeI8IQTxKXeEwe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9mf4jHGk1EcEkyTBhfv6Zw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RB0NTk0Fdnf8pBJPUc9Yrw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rte2A8gY3vh8lVIpY5myli"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bail Bondsman</rdfs:label>
        <skos:altLabel>Bail Agent</skos:altLabel>
        <skos:altLabel>Surety Guarantor</skos:altLabel>
        <skos:definition>A Bail Bondsman is a licensed professional who provides bail money for a fee, typically a percentage of the bail amount, to defendants who cannot afford to make bail themselves. The bondsman ensures the court of the defendant&apos;s appearance and may be liable for the full bail amount if the defendant fails to appear for their court date.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r2pu2R5lD1vnROf21tKXP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r2pu2R5lD1vnROf21tKXP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBi5nYq1khAzzGeY5YZ10ya"/>
        <rdfs:label>Leave Law Notice Violation Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abmahnung wegen Verstoßes gegen das Urlaubsrecht</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Avis de violation de la loi sur les congés</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aviso de violação da lei de licença</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Leave Law Notice Violation Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por violación de aviso de ley de permisos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por violación de aviso de ley de permisos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת הודעת חוק של חוק המנוחה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लीव लॉ नोटिस उल्लंघन दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">休暇法通知違反請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">请假法通知违规索赔</skos:altLabel>
        <skos:definition>A leave law notice violation claim is a legal action initiated by an employee against their employer for not providing required notice of an employee&apos;s rights under applicable leave laws. These laws may include the Family and Medical Leave Act (FMLA), the California Family Rights Act (CFRA), or other state and local laws that provide protected leave for certain reasons, such as for the employee&apos;s own serious health condition, to care for a seriously ill family member, or for the birth or adoption of a child. The claim typically arises when an employer fails to provide required notice of an employee&apos;s leave rights, which can result in the employee not being aware of their rights or not being able to take leave to which they are entitled.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r3Fh9SuTv56MbLm90uahg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r3Fh9SuTv56MbLm90uahg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/RN3mWlXZUAt07dYsu6tls2"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBFFfSWsg811UlPoeFkEsZY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Petition for Visa for Nurses and Medical Professionals</rdfs:label>
        <skos:altLabel>H-1A Petition</skos:altLabel>
        <skos:definition>In the United States, this was a petition for the H-1A visa category, which was previously available for foreign nurses coming to the United States to work in healthcare positions that required the skills of a registered nurse. The H-1A program was discontinued in 1995. The Nursing Relief for Disadvantaged Areas (NRDAA) program was created to replace the H-1A program, and foreign nurses are now typically eligible for H-1B visas if they meet the necessary requirements for specialty occupation positions. It&apos;s important to note that the information provided here might not be up-to-date, so it&apos;s recommended to check with official U.S. government sources or legal experts for the most current information regarding visa categories for nurses and healthcare professionals</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r4E6CScXkLjln7BLqS5ZG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r4E6CScXkLjln7BLqS5ZG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RPBEBqN3r4YqvAj19Jw9fU"/>
        <rdfs:label>D.O. (Doctor of Osteopathic Medicine)</rdfs:label>
        <skos:altLabel>Doctor of Osteopathic Medicine</skos:altLabel>
        <skos:definition>A D.O. (Doctor of Osteopathic Medicine) is a medical degree awarded after completing osteopathic medical school, emphasizing a holistic approach to healthcare. It signifies qualifications to practice medicine and perform surgery similar to M.D. (Doctor of Medicine) holders</skos:definition>
        <skos:prefLabel>D.O.</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r4n9m41DwdLMB8pMQYHvo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r4n9m41DwdLMB8pMQYHvo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm"/>
        <rdfs:label>Cruelty to Animals</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Cruauté envers les animaux</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Crueldad hacia los animales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Crueldad hacia los animales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Crueldade contra animais</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cruelty to Animals</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Tierquälerei</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אכזריות לבעלי חיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पशुओं के प्रति क्रूरता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">動物虐待</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">虐待动物</skos:altLabel>
        <skos:definition>The intentional infliction of harm or suffering on animals, including neglect, abuse, and torture, which is prohibited by law and may result in criminal charges and penalties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r8FeqnphadygvNP0XHj84 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r8FeqnphadygvNP0XHj84">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1okJKMvv4mMHv7m4TzwBe"/>
        <rdfs:label>Motorcycle</rdfs:label>
        <skos:definition>A motorcycle is a two-wheeled motorized vehicle typically powered by an internal combustion engine. Motorcycles are designed for personal transportation and come in various styles, including sport bikes, cruisers, touring bikes, and off-road motorcycles.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7r9vjnfkpI0wCKJXlxidAp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7r9vjnfkpI0wCKJXlxidAp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Time and Materials Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de temps et de matériaux</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Tiempo y Materiales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Tiempo y Materiales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de tempo e materiais</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Time and Materials Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeit- und Materialklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זמן וחומרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समय और सामग्री शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">时间和材料条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">時間と材料条項</skos:altLabel>
        <skos:definition>A Time and Materials Clause is a provision in a contract that specifies that the client will pay for the actual time and materials used by the contractor to complete the project, rather than a fixed price.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rEmc9PaAz1JI1YpYZGaDg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rEmc9PaAz1JI1YpYZGaDg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RtSJkLiGzcKx8PVlCAB5q5"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Fee and Employment Practice</rdfs:label>
        <skos:altLabel>Fee and Employment</skos:altLabel>
        <skos:altLabel>Fee and Employment Service</skos:altLabel>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Fee and Employment Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais et pratique de l&apos;emploi</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebühren und Beschäftigungspraxis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Honorarios y Práctica Laboral</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Honorarios y Práctica Laboral</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Taxa e prática de emprego</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תשלום ומעשה עסקי בתחום העסקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शुल्क और रोजगार अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">手数料と雇用慣行</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">费用和就业实践</skos:altLabel>
        <skos:definition>Fee and Employment Practice (Bankruptcy) refers to the legal work related to the compensation of professionals and employment issues in the context of bankruptcy proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rFTVKN1Cc9kDZb75hc6jl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rFTVKN1Cc9kDZb75hc6jl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
        <rdfs:label>Temporary Protected Status</rdfs:label>
        <skos:altLabel>TPS</skos:altLabel>
        <skos:altLabel>Temporary Protected Status (TPS) is a temporary immigration status granted to eligible nationals of designated countries that are experiencing ongoing armed conflict, environmental disaster, or other extraordinary conditions. In the United States, individuals granted TPS are allowed to live and work in the U.S. for a limited period and are protected from deportation.</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rGAr4SqkaXUrTvSBKvJg0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rGAr4SqkaXUrTvSBKvJg0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R06956a0657387D6513A8528"/>
        <rdfs:label>New York Supreme Court - Allegany County</rdfs:label>
        <skos:definition>The New York Supreme Court - Allegany County is a court of general jurisdiction located in Allegany County, New York, with authority to hear and decide a wide range of civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rMU6Js4awTWJdyPKTmK9C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rMU6Js4awTWJdyPKTmK9C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBPehVKHmGilQbPA55VggB6"/>
        <rdfs:label>Alford Plea</rdfs:label>
        <skos:altLabel>Plea of Convenience</skos:altLabel>
        <skos:definition>An Alford plea (aka best-interests plea) is a type of guilty plea in which a defendant maintains their innocence but acknowledges that the prosecution has enough evidence to likely secure a conviction. This plea allows the defendant to accept punishment without admitting guilt.</skos:definition>
        <skos:prefLabel>Best Interests Plea</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rOX0OkBHLnTJ0wxo4bIVk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rOX0OkBHLnTJ0wxo4bIVk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ram7eqYuiBBxhcC5bDy59J"/>
        <rdfs:label>Tax Disclaimer Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-responsabilité fiscale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Isenção de Responsabilidade Tributária</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de descargo de responsabilidad fiscal</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de exención de responsabilidad fiscal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel für Steuern</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tax Disclaimer Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כרטיס אי-אחריות מס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कर अस्वीकरण अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">税务免责声明条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">税務免責事項条項</skos:altLabel>
        <skos:definition>A Tax Disclaimer Clause is a specific type of contractual clause that disclaims any liability or responsibility for tax-related matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rQPa68hcj34ouzYvp14lD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rQPa68hcj34ouzYvp14lD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ri4LGaOgWzMWy2yX79DQi0"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_05"/>
        <rdfs:label>Sickle Cell Disease</rdfs:label>
        <skos:definition>Sickle Cell Disease is a genetic disorder characterized by the production of abnormally shaped red blood cells that resemble a crescent or sickle. These malformed cells can obstruct blood flow, causing pain, anemia, and a range of complications affecting various organs.</skos:definition>
        <skos:prefLabel>Sickle Cell Anemia</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7rQQvx2SzP5GiUEpbCJjjp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7rQQvx2SzP5GiUEpbCJjjp">
