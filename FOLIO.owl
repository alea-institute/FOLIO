        <dc:identifier>D-ADR-ARB</dc:identifier>
        <rdfs:label>Arbitration Practice</rdfs:label>
        <skos:altLabel>Arbitrations</skos:altLabel>
        <skos:altLabel>Arbitration Service</skos:altLabel>
        <skos:altLabel>Arbitration</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Arbitration Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de l&apos;arbitrage</skos:altLabel>
