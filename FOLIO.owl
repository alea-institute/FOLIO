        <skos:altLabel xml:lang="de-de">Aserbaidschanisch</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Azerbaijano</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Azerbaïdjanais</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アゼルバイジャン語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿塞拜疆语</skos:altLabel>
        <skos:definition>Azerbaijani (Language) refers to the written or spoken structured system of communication that consists of grammar and vocabulary specific to the Azerbaijani language, which is a member of the Turkic language family.</skos:definition>
    </owl:Class>
    


