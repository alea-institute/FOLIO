        <rdfs:label>Civic and Social Organizations</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in promoting the civic and social interests of their members. Establishments in this industry may operate bars and restaurants for their members.</skos:definition>
        <skos:example>Alumni associations</skos:example>
        <skos:example>Automobile clubs (except travel)</skos:example>
        <skos:example>Booster clubs</skos:example>
        <skos:example>Ethnic associations</skos:example>
        <skos:example>Fraternal lodges</skos:example>
        <skos:example>Granges</skos:example>
        <skos:example>Parent-teacher associations</skos:example>
        <skos:example>Scouting organizations</skos:example>
        <skos:example>Social clubs</skos:example>
        <skos:example>Veterans&apos; membership organizations</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/GgHPhyqORnyz2eUn8L6dQw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/GgHPhyqORnyz2eUn8L6dQw">
