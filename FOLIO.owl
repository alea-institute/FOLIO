        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCZyrH2dIAtpDh2AzPTekph"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCBtDyjzrPbQyhvU5V64Irn"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Director Compensation and Governance Policy</rdfs:label>
        <skos:altLabel>Director Pay and Governance Protocol</skos:altLabel>
        <skos:altLabel>Executive Oversight and Reward Framework</skos:altLabel>
        <skos:definition>The Director Compensation and Governance Policy outlines the rules and guidelines for how board members are compensated and how governance activities are conducted within an organization. This policy ensures alignment with organizational goals and compliance with relevant laws and regulations.</skos:definition>
        <skos:prefLabel>Board Remuneration Policy</skos:prefLabel>
    </owl:Class>
    


