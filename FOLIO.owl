        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Service Provider Indemnity Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;indemnisation du fournisseur de services</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización del proveedor de servicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización del proveedor de servicios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de indenização do provedor de serviços</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsklausel für Dienstleistungsanbieter</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Service Provider Indemnity Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפצת אחריות לספק שירותים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेवा प्रदाता भरण-पोषण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サービスプロバイダーの免責条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">服务提供商赔偿条款</skos:altLabel>
        <skos:definition>A Service Provider Indemnity Clause is a provision in a contract that requires one party to compensate the other party for any losses or damages resulting from the service provider&apos;s actions or omissions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hREyhf9ibKSa2PGuaLWRr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hREyhf9ibKSa2PGuaLWRr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwNOkyYBQw2SPTqJl6tIjZ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8xgHnZw9VbPFOSxm4zCWWt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>lf_vendor_id</rdfs:label>
        <skos:definition>A value that uniquely identifies the vendor.  Depending on the location of the vendor, this value could be the vendor&apos;s tax id number, the vendor&apos;s VAT registration number, the vendor&apos;s DUNS number, the vendor&apos;s business registration number, or any other number or used by the vendor to uniquely identify itself, preferably to its local taxing or governmental authority.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hTuQBrWujQeiTDrPH1tbQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hTuQBrWujQeiTDrPH1tbQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP"/>
        <dc:identifier>RET-ELAP</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=449"/>
        <rdfs:label>Furniture, Home Furnishings, Electronics, and Appliance Retailers Industry</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Electronics and Appliance Store Industry</skos:altLabel>
        <skos:altLabel>Electronics and Appliance Stores</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Elektronik- und Haushaltsgerätehandel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de tiendas de electrónica y electrodomésticos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de tiendas de electrónica y electrodomésticos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des magasins d&apos;électronique et d&apos;appareils électroménagers</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de lojas de eletrônicos e eletrodomésticos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית חנויות אלקטרוניקה ומכשירי חשמל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इलेक्ट्रॉनिक्स और उपकरण स्टोर उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">电子和家电商店行业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">電子製品および家電店業界</skos:altLabel>
        <skos:definition>Industries in the Furniture, Home Furnishings, Electronics, and Appliance Retailers subsector retail new furniture, home furnishings, electronics, and appliances.  Establishments in this subsector with fixed point-of-sale locations may operate from showrooms or other locations that have substantial areas for the presentation or demonstration of their products.  Establishments in this subsector may provide incidental services, including interior decorating, product assembly, installation, or repair services.</skos:definition>
        <skos:hiddenLabel>ELAP</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hVCI1ADqwS7UUKdavydTM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hVCI1ADqwS7UUKdavydTM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Dxh7cqKFFJ2jKNTvICMhf"/>
        <rdfs:label>Military Reserves</rdfs:label>
        <skos:altLabel>Reserve Forces</skos:altLabel>
        <skos:altLabel>Reserves</skos:altLabel>
        <skos:altLabel>Standby Forces</skos:altLabel>
        <skos:definition>Reserves are a component of the armed forces consisting of individuals who maintain civilian careers but are trained to be called upon in times of need to supplement the active-duty military. This force provides additional manpower and specialized skills to support national defense and respond to emergencies or large-scale military operations.</skos:definition>
    </owl:Class>
    


