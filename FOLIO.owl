    <!-- https://folio.openlegalstandard.org/RvMbV7PbNx2ccGZF1PEjEs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvMbV7PbNx2ccGZF1PEjEs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7gKTQpOKfQ2tOdPu6cLN3w"/>
        <rdfs:label>Notice of Action</rdfs:label>
        <skos:altLabel>Approval Notice</skos:altLabel>
        <skos:altLabel>Receipt Notice</skos:altLabel>
        <skos:definition>A Notice of Action (in the U.S., Form I-797), is a document issued by the government agency (e.g., United States Citizenship and Immigration Services (USCIS)) to communicate specific actions taken on an immigration application or petition. It serves as an official receipt or approval notice for various immigration-related applications, including visa petitions, adjustment of status, and naturalization.</skos:definition>
        <skos:prefLabel>I-797</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RvOCpmr98FwBq1EZ2L86iV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvOCpmr98FwBq1EZ2L86iV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRTsPoZhucp80NJy00WHwY"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Single_transferable_vote"/>
        <rdfs:label>Single Transferable Vote System</rdfs:label>
        <skos:altLabel>STV</skos:altLabel>
        <skos:definition>The Single Transferable Vote (STV) system is a proportional voting method where voters rank candidates in order of preference. Votes are initially allocated to each voter&apos;s first preference, and if a candidate reaches a specified quota, they are elected; any surplus votes are transferred to remaining candidates based on the voters&apos; next preferences, and this process continues until all seats are filled.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RvOk9UP5lfNJm6UJBzGiCO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvOk9UP5lfNJm6UJBzGiCO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds"/>
        <rdfs:label>Uncontentious</rdfs:label>
        <skos:definition>Uncontentious negotiation refers to a negotiation process where parties have aligned interests and work cooperatively to reach an agreement without conflict or adversarial tactics. This approach emphasizes mutual understanding, amicable discussions, and efficient resolution of terms, often resulting in agreements that are satisfactory to all parties involved.</skos:definition>
        <skos:prefLabel>Uncontentious Negotiation</skos:prefLabel>
    </owl:Class>
    


