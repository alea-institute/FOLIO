        <skos:altLabel xml:lang="pt-br">Comunicação privilegiada</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Privileged Communication</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertrauliche Kommunikation</skos:altLabel>
