        <skos:altLabel xml:lang="zh-cn">日支出条款</skos:altLabel>
        <skos:definition>A per diem clause is a provision in a contract that specifies a daily allowance or rate of payment for expenses incurred by one party while performing duties for the other party.</skos:definition>
    </owl:Class>
    


