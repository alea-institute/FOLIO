        <rdfs:isDefinedBy rdf:resource="https://www.canb.uscourts.gov/ecf/manuals/chapter-14-notices"/>
        <rdfs:label>Notice of Appearance and Request for Notice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Avis d&apos;apparition et demande de notification</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aviso de comparecencia y solicitud de notificación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aviso de comparecimento e pedido de notificação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Comparecencia y solicitud de notificación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erscheinungsanzeige und Antrag auf Benachrichtigung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Notice of Appearance and Request for Notice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הודעת הופעה ובקשה להודעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपस्थिति का सूचना और सूचना के लिए अनुरोध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">出庭通知和通知请求</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">出頭通知と通知の要求</skos:altLabel>
        <skos:definition>A Notice of Appearance and Request for Notice is a legal document filed by an attorney to inform the court and opposing counsel that they are representing a party in a case and to request that all future notices and documents related to the case be sent to them.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9z1u2Wr9I7qaJiANllVnpz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9z1u2Wr9I7qaJiANllVnpz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
        <rdfs:label>Warranty of Title Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de garantie de titre</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de garantia de título</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de garantía de título</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de garantía de título</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Gewährleistung des Eigentumsrechts</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Warranty of Title Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אחריות על הכותרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शीर्षक वारंटी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">所有权保证条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">所有権保証条項</skos:altLabel>
        <skos:definition>A Warranty of Title Clause is a provision in a contract that guarantees the seller&apos;s legal ownership of the property being sold and promises to defend the buyer against any claims made by third parties regarding the title.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9z5VX9m1ukVvqp5ltdkSws -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9z5VX9m1ukVvqp5ltdkSws">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDBXUrFP9mCZLCxzqy8nbEX"/>
        <rdfs:label>Judicial Recommendation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Judicial Recommendation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Justizielle Empfehlung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recomendación Judicial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recomendación Judicial</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Recomendação judicial</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Recommandation judiciaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">המלצת משפטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायिक सिफारिश</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">司法建议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">司法推薦</skos:altLabel>
        <skos:definition>A judicial recommendation is a document created by a trial court that provides guidance or advice to a higher court or decision-making body.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9z7SN3H66BpMdMDsPLSxpK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9z7SN3H66BpMdMDsPLSxpK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7YcudBFwMUS1r7BcWje7Ly"/>
        <rdfs:label>Intervening Event - Unknown at Signing</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ereignis während der Vertragslaufzeit - zum Zeitpunkt des Vertragsabschlusses unbekannt</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Evento Interveniente - Desconhecido na Assinatura</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Evento Interviniente - Desconocido en la Firma</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento Interviniente - Desconocido en la Firma</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intervening Event - Unknown at Signing</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement intervenant - Inconnu au moment de la signature</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירוע מתערב - לא ידוע בזמן החתימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हस्ताक्षर करने पर अज्ञात वारदात</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">介入事件 - 签署时未知</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約締結時に不明な介入イベント</skos:altLabel>
        <skos:definition>An &quot;Intervening Event - Unknown at Signing&quot; is a circumstance or occurrence that happens after the signing of a legal agreement, which was not anticipated or known at the time of signing and may affect the performance or outcome of the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9z8gDGK2jOKNXnrWAEwknC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9z8gDGK2jOKNXnrWAEwknC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79B8LEesyOsHoQWVy0OAjJ"/>
        <rdfs:label>Motion for New Trial - Clerical Error</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Neues Verfahren - Schreibfehler</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para un Nuevo Juicio - Error Clerical</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para un Nuevo Juicio - Error Clerical</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for New Trial - Clerical Error</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour un nouveau procès - Erreur de cléricature</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Novo Julgamento - Erro de Escrituração</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למשפט חדש - שגיאה כתיבית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नए न्यायालय के लिए मोशन - क्लरिकल त्रुटि</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">新しい裁判のための動議 - 書記エラー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">新审判动议 - 文书错误</skos:altLabel>
        <skos:definition>A Motion for New Trial - Clerical Error is a legal request made by a party to a case asking the court to reconsider its decision due to a mistake made in the court&apos;s records or paperwork, rather than an error in the trial proceedings themselves.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9z9MTEwhmYDc2N1FraH4tH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9z9MTEwhmYDc2N1FraH4tH">
