    <!-- https://folio.openlegalstandard.org/RB54thk6pdEaSDe954HmeCV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB54thk6pdEaSDe954HmeCV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDETD6YVYGhLGZbM1fBnsfj"/>
        <rdfs:label>Mental Incapacity</rdfs:label>
        <skos:altLabel xml:lang="de-de">Geistige Unfähigkeit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incapacidad Mental</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incapacidad Mental</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Incapacidade mental</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Incapacité mentale</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mental Incapacity</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בעיית יכולת מנטלית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मानसिक अक्षमता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">精神无能力</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">精神的無能力</skos:altLabel>
        <skos:definition>Mental incapacity refers to a condition in which an individual&apos;s mental state affects their ability to understand, reason, or make decisions about their own affairs. Mental incapacity can be temporary or permanent and can result from various factors, including age, injury, illness, or developmental disability. In a legal context, mental incapacity can have important implications for an individual&apos;s ability to enter into contracts, make decisions about medical treatment, or manage their own affairs. In such cases, a court may appoint a guardian or conservator to act on behalf of the individual with mental incapacity, in order to protect their interests and ensure that their affairs are managed appropriately. Legal proceedings involving mental incapacity can be complex and may require medical evaluations, assessments of decision-making capacity, and other expert testimony.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB553c218884f3C8f603F6aa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB553c218884f3C8f603F6aa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R22815eC3Af3bFF0d002Ca58"/>
        <dc:identifier>US-FD-MACPAC</dc:identifier>
        <rdfs:label>U.S. Medicaid and CHIP Payment and Access Commission</rdfs:label>
        <skos:altLabel xml:lang="es-es">Comisión de Acceso y Pago de Medicaid y CHIP de EE. UU.</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Comisión de Acceso y Pago de Medicaid y CHIP de EE. UU.</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Comissão de Pagamento e Acesso ao Medicaid e CHIP dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Commission de paiement et d&apos;accès à Medicaid et CHIP des États-Unis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">U.S. Medicaid and CHIP Payment and Access Commission</skos:altLabel>
        <skos:altLabel xml:lang="de-de">U.S. Medicaid und CHIP Zahlungs- und Zugangskommission</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוועד לתשלומים וגישה ל-Medicaid ו-CHIP של ארצות הברית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूएस मेडिकेड और चिप भुगतान और पहुँच आयोग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">米国医療費負担増大法（Medicaid）及び児童医療保険プログラム（CHIP）支払い及びアクセス委員会</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">美国医疗补助和儿童健康保险计划支付和获取委员会</skos:altLabel>
        <skos:definition>The Medicaid and CHIP Payment and Access Commission (MACPAC) is a non-partisan legislative branch agency that provides policy and data analysis and makes recommendations to Congress, the Secretary of the U.S. Department of Health and Human Services, and the states on a wide array of issues affecting Medicaid and the State Children&apos;s Health Insurance Program (CHIP). The U.S. Comptroller General appoints MACPAC&apos;s 17 commissioners, who come from diverse regions across the United States and bring broad expertise and a wide range of perspectives on Medicaid and CHIP.</skos:definition>
        <skos:hiddenLabel>MACPAC</skos:hiddenLabel>
        <skos:prefLabel>Medicaid and CHIP Payment and Access Commission</skos:prefLabel>
    </owl:Class>
    


