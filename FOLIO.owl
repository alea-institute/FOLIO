        <skos:altLabel xml:lang="ja-jp">ハウサ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">豪萨语</skos:altLabel>
        <skos:definition>A language spoken in West Africa, primarily in Nigeria and Niger, belonging to the Chadic branch of the Afro-Asiatic language family.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzrK4RsgfLScZvC4Z4lCCX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzrK4RsgfLScZvC4Z4lCCX">
