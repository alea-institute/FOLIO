        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm"/>
        <rdfs:label>Endocrine Disorders</rdfs:label>
        <skos:altLabel>Endocrinopathy</skos:altLabel>
        <skos:definition>Endocrine disorders involve conditions that affect the endocrine glands, which produce hormones regulating various physiological processes in the body, including metabolism, growth, and reproduction. These disorders can disrupt hormonal balance, leading to a wide range of symptoms and health issues.</skos:definition>
        <skos:prefLabel>Hormonal Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDu9DwOMBQd0dIKhEhUPKo2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDu9DwOMBQd0dIKhEhUPKo2">
