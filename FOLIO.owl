        <skos:definition>This industry group comprises establishments, such as barber and beauty shops, that provide appearance care services to individual consumers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/eivbEximQa2X6Stzdp0i0A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/eivbEximQa2X6Stzdp0i0A">
