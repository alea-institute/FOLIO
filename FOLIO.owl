        <skos:altLabel xml:lang="es-es">Nombre del beneficiario - Tarifa o gasto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Nombre del beneficiario - Tarifa o gasto</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Nome do beneficiário - Taxa ou despesa</skos:altLabel>
