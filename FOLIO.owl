        <rdfs:label>Sac and Fox Nation of Missouri in Kansas and Nebraska</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiAXVeZj9z8vfXK65zksgN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiAXVeZj9z8vfXK65zksgN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Xkp4FqX83NG5ZI0CDfQ1k"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion to Dismiss Charge</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einstellung des Verfahrens</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Desestimación de Cargos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de sobreseimiento de cargos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Dismiss Charge</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de arquivamento da acusação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en annulation de l&apos;accusation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לדחיית התביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अभियोग खारिज करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销指控动议书</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">起訴棄却請求書</skos:altLabel>
        <skos:definition>A Motion to Dismiss Charge is a formal request made by a party in a legal case to dismiss a specific charge against them, typically due to a lack of evidence or legal basis for the charge.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiBTXGUqnHN38GgNbuc1rq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiBTXGUqnHN38GgNbuc1rq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
        <rdfs:label>Trial Transcripts Expense</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Despesas de transcrição de julgamento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais de transcription de procès</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gastos de transcripción de juicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gastos de transcripción de juicios</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kosten für Prozessprotokolle</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial Transcripts Expense</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאות תמלילי ניסיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल ट्रांसक्रिप्ट व्यय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">庭审记录费用</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判記録費用</skos:altLabel>
        <skos:definition>Trial Transcripts Expense refers to the costs incurred for obtaining a written or recorded verbatim record of the proceedings that took place during a trial, including the testimony of witnesses, arguments of counsel, and rulings of the court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiCXfLKJN3y1Mmr1do46fX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiCXfLKJN3y1Mmr1do46fX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsDXW4XOplruZcWE3sKbal"/>
        <rdfs:label>Monarch</rdfs:label>
        <skos:altLabel>Crown</skos:altLabel>
        <skos:altLabel>Crowned Head</skos:altLabel>
        <skos:altLabel>Her Majesty</skos:altLabel>
        <skos:altLabel>Majesty</skos:altLabel>
        <skos:altLabel>Ruler</skos:altLabel>
        <skos:altLabel>Sovereign</skos:altLabel>
        <skos:altLabel>Sultan</skos:altLabel>
        <skos:definition>A Monarch is a sovereign head of state, typically a king or queen, who reigns over a country or territory by hereditary right or election. This individual holds a position of supreme authority within a monarchy, often serving as both the ceremonial figurehead and, in some cases, an active participant in governance.</skos:definition>
        <skos:prefLabel>Emperor</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiDvnKtdnAMatKQuf0Zdft -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiDvnKtdnAMatKQuf0Zdft">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74eoff0t9bkabhhZR20Z0B"/>
        <rdfs:label>Shadow Docket</rdfs:label>
        <skos:altLabel>Emergency Docket</skos:altLabel>
        <skos:altLabel>Expedited Decisions</skos:altLabel>
        <skos:definition>The Shadow Docket refers to a set of decisions and orders issued by a court (e.g., the Supreme Court of the United States), without full briefing or oral argument. These decisions, often related to emergency appeals and procedural orders, can have significant legal implications but receive less public scrutiny and transparency than cases on the court&apos;s regular docket.</skos:definition>
        <skos:prefLabel>Summary Proceedings</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiLWlRyvnYVMYqBTsAWpvp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiLWlRyvnYVMYqBTsAWpvp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ReDY2v13rer1U8AyOj55L"/>
        <rdfs:label>Matter Commentary</rdfs:label>
        <skos:definition>A Matter Commentary refers to comments or notes provided on a specific legal matter, often related to a filing or application. In the context of immigration, it could involve written remarks, explanations, or clarifications provided alongside documents or submissions to provide additional context or information for the reviewing authorities or parties involved</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiLwtYIecGXBEpLAa0gJKu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiLwtYIecGXBEpLAa0gJKu">
