        <skos:altLabel xml:lang="he-il">טענה מולעלית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मौखिक तर्क</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">口头辩论</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">口頭弁論</skos:altLabel>
