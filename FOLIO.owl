        <skos:altLabel xml:lang="es-es">Interferencia Negligente con la Perspectiva de Beneficio Económico</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interferencia Negligente con la Perspectiva de Beneficio Económico</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligent Interference with Prospective Economic Advantage</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התערבות שגויה בפוטנציאל הכלכלי העתידי</skos:altLabel>
