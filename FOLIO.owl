        <skos:altLabel xml:lang="ja-jp">協力契約</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合作协议</skos:altLabel>
        <skos:definition>A Collaboration Agreement is a legal document that outlines the terms and conditions of a partnership between two or more parties for the purpose of working together towards a common goal.</skos:definition>
    </owl:Class>
    


