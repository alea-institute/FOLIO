            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motions for Preliminary or Provisional Remedies</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anträge auf vorläufige oder provisorische Maßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones para Remedios Preliminares o Provisionales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones para Remedios Preliminares o Provisionales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Moções para Remedios Preliminares ou Provisionais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions en vue de mesures provisoires ou conservatoires</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motions for Preliminary or Provisional Remedies</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות לטיפולים מוקדמים או זמניים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रारंभिक या स्थायी उपचार के लिए याचिकाएं</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">仮処分または暫定的救済のための動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">初步或临时救济动议</skos:altLabel>
        <skos:definition>A Motion for Preliminary or Provisional Remedies is a request made to a court in the early stages of a legal case seeking temporary relief or protection until a final decision can be made.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jPm3N4o1IlVypqeQRFES0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jPm3N4o1IlVypqeQRFES0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rchny3YFXoQyenv6XUbyo0"/>
        <rdfs:label>Receipt of Verdict</rdfs:label>
        <skos:altLabel xml:lang="de-de">Empfang des Urteils</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Recebimento da sentença</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Receipt of Verdict</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recepción de Veredicto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recepción de Veredicto</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réception du verdict</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קבלת פסק דין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फैसले के प्राप्ति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決の受領</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">收到判决书</skos:altLabel>
        <skos:definition>Receipt of Verdict: The formal acceptance and recording of the decision made by a judge or jury at the end of a trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q7GJc1zsYT0P4Xdp6l9Oz"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/R9RiRk1LnffWe0xUY0IHsmL"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDaNIjG3Bz5mnMEssDHDHwf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/R9RiRk1LnffWe0xUY0IHsmL"/>
