        <rdfs:label>Reletting Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de sous-location</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de subarriendo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de subarriendo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de sublocação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reletting Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Weitervermietungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף השכרה מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रीलेटिंग डिलीवरी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">再貸借条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">转租条款</skos:altLabel>
        <skos:definition>A reletting clause is a provision in a contract that allows the landlord to lease the property to a new tenant if the original tenant breaches the lease agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fgXDvA3eg3BASlFzkB85m -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7fgXDvA3eg3BASlFzkB85m">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3AhgdKfrmjLxAZBerfsNx"/>
        <rdfs:label>Business Unit</rdfs:label>
        <skos:definition>A Business Unit is a distinct division or department within an organization that operates with specific objectives and a degree of autonomy. It is often responsible for its own profit and loss, strategy, and operations, allowing it to be evaluated independently for performance and contribution to the overall corporate goals</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fkb1Lb3LAL0J0Ph6kQdNS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7fkb1Lb3LAL0J0Ph6kQdNS">
