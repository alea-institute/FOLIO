        <skos:altLabel xml:lang="es-mx">Acuerdo de Afiliación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Affiliate Agreement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Contrato de afiliação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Partnervertrag</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם שותפים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सहयोगी समझौता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">提携契約</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">联盟协议</skos:altLabel>
        <skos:definition>An affiliate agreement is a legally binding contract between two parties, where one party agrees to promote or sell the products or services of the other party in exchange for a commission or other compensation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBN9zTYlrd1Dt84iS3QO5fp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBN9zTYlrd1Dt84iS3QO5fp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7meQhKYGkcA57UZ7v4JOdA"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCF0BMeSwppddfM6cp6AUBK"/>
        <rdfs:label>Cryptocurrency Law</rdfs:label>
        <skos:altLabel>Crypto Asset Law</skos:altLabel>
        <skos:definition>Cryptocurrency law encompasses the legal rules and regulations governing the use, creation, and exchange of digital currencies, such as Bitcoin and Ethereum. It addresses issues related to security, taxation, and compliance with financial regulations.</skos:definition>
        <skos:prefLabel>Digital Currency Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNAVdQU5MQ2a12j1We7G31 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNAVdQU5MQ2a12j1We7G31">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj"/>
        <rdfs:label>Minority Stake</rdfs:label>
        <skos:altLabel>Minority Shareholding</skos:altLabel>
        <skos:altLabel>Non-Controlling Shareholding</skos:altLabel>
        <skos:altLabel>Non-Controlling Stake</skos:altLabel>
        <skos:definition>A Minority Stake refers to ownership of less than 50% of a company&apos;s shares, which does not provide control over the company but can still offer significant influence. Minority stakeholders often rely on shareholder agreements and other mechanisms to protect their interests.</skos:definition>
        <skos:prefLabel>Minority Interest</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNFgSc7x9V18auT1Br6qQB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNFgSc7x9V18auT1Br6qQB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aNhIN6jIIVcj5Cbh8Bduw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCy69ZSLkXNMIWCj0nv9qzO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Severance Pay</rdfs:label>
        <skos:definition>Severance pay is a monetary compensation provided to employees upon termination of their employment, typically when they are laid off or made redundant. The amount and terms of severance pay can vary based on factors such as the duration of employment, contractual agreements, company policy, and legal regulations in the jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNIcoXeUcBXVeFvlXkbGaS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNIcoXeUcBXVeFvlXkbGaS">
