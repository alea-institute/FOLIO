        <skos:altLabel xml:lang="es-mx">Negligencia de la Compañía de Transporte</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência de empresas de transporte</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence des entreprises de transport</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transport Company Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הזנחת חברת התחבורה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">परिवहन कंपनी की लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">輸送会社の過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">运输公司疏忽</skos:altLabel>
        <skos:definition>Transportation Company Negligence refers to the failure of a common carrier to exercise reasonable care in the transportation of goods or passengers, resulting in harm or injury to those goods or passengers.</skos:definition>
    </owl:Class>
    


