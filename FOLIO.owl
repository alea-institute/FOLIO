    <owl:Class rdf:about="https://folio.openlegalstandard.org/nbJo8kf2RH6SCxduI8LuJg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/AvVeUvUmSmuebjrduK07yA"/>
