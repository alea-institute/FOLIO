        <skos:altLabel xml:lang="de-de">Kündigungsklausel durch eine der Parteien</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Termination by Either Party Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפרדה על ידי כל מצד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दोनों पक्षों द्वारा समाप्ति अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">いずれかの当事者による終了条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">任何一方终止条款</skos:altLabel>
        <skos:definition>A Termination by Either Party Clause is a provision in a contract that allows either party to terminate the agreement without cause or reason.</skos:definition>
    </owl:Class>
    


