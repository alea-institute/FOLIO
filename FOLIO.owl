        <skos:altLabel xml:lang="ja-jp">現行犯逮捕</skos:altLabel>
        <skos:definition>An on-view arrest is a type of arrest made by a law enforcement officer without a warrant, based on their own observation of a crime being committed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCw28DTCZnbpF28eRq1iKm9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCw28DTCZnbpF28eRq1iKm9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3OI7nrib1LEPtUfn5G5CH"/>
        <rdfs:label>Conditional Bequest</rdfs:label>
        <skos:altLabel>Conditional Testamentary Gift</skos:altLabel>
        <skos:altLabel>Contingent Bequest</skos:altLabel>
        <skos:definition>A Conditional Bequest is a provision in a will or trust that designates the transfer of assets or property to a beneficiary only if certain specified conditions or criteria are met. This type of bequest allows the testator to impose requirements that must be fulfilled for the beneficiary to receive the inheritance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCw8ATbsmMIvjOcmGP8pYPT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCw8ATbsmMIvjOcmGP8pYPT">
