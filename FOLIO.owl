        <skos:altLabel xml:lang="es-mx">Privilegio de confidencialidad entre psicoterapeuta y paciente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège du psychothérapeute-patient</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Privilégio do psicoterapeuta-paciente</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Psychotherapeut-Patienten-Privileg</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Psychotherapist-Patient Privilege</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות הסודיות בין מטפל פסיכותרפי למטופל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मनोचिकित्सक-रोगी विशेषाधिकार</skos:altLabel>
