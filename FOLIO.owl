    <!-- https://folio.openlegalstandard.org/RDpPrzyG145FEMbdXJEzPkJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpPrzyG145FEMbdXJEzPkJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9jx1uLGTrB6S8hwGcWVmlT"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Aggravated</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Aggravated</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Agravado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Agravado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">aggravé</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">agravado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">verschärft</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מְכֻהָּן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भड़काऊ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加重的</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な</skos:altLabel>
        <skos:definition>An unlawful attack by one person upon another wherein the offender uses a weapon or displays it in a threatening manner, or the victim suffers obvious severe or aggravated bodily injury involving apparent broken bones, loss of teeth, possible internal injury, severe laceration, or loss of consciousness. This also includes assault with disease (as in cases when the offender is aware that he/she is infected with a deadly disease and deliberately attempts to inflict the disease by biting, spitting, etc.).</skos:definition>
        <skos:example>Aggravated Assault</skos:example>
        <skos:example>Aggravated Battery</skos:example>
        <skos:example>Aggravated Sexual Assault</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpSHREg1iX3oSwUoijD8RQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpSHREg1iX3oSwUoijD8RQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion for Conditional Use of Cash Collateral</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf bedingte Verwendung von Bargeldkollateral</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para el uso condicional de garantía en efectivo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Conditional Use of Cash Collateral</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour l&apos;utilisation conditionnelle de garanties en espèces</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Uso Condicional de Garantia em Dinheiro</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de uso condicional de garantía en efectivo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לשימוש מותנה בערבות מזומנת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नकद जमानत के शर्ती उपयोग के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">动议有条件使用现金抵押品</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現金担保物の条件付使用の申立て</skos:altLabel>
        <skos:definition>A Motion for Conditional Use of Cash Collateral is a request made in a bankruptcy case to allow a debtor to use cash collateral under certain conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpaN9hLN8jGKrKBnQ2kPbN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpaN9hLN8jGKrKBnQ2kPbN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
        <rdfs:label>Conflicts Management</rdfs:label>
        <skos:definition>Conflicts Management refers to the process of identifying and resolving potential conflicts of interest within a law firm or legal department, in order to ensure ethical and professional conduct in the provision of legal services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpdFq22AZ4tOCImIJU4SCm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpdFq22AZ4tOCImIJU4SCm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfOoWbuAOqLv617rVNcHYh"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Avoidant/Restrictive Food Disorder</rdfs:label>
        <skos:altLabel>ARFID</skos:altLabel>
        <skos:definition>Avoidant/Restrictive Food Intake Disorder (ARFID) is an eating disorder characterized by an extreme avoidance or restriction of food intake, which can lead to significant nutritional deficiencies, weight loss, or impairment in social and occupational functioning. Unlike Anorexia Nervosa, ARFID does not involve a distorted body image or an intense fear of gaining weight but may include aversions to certain foods or fear of adverse consequences from eating.</skos:definition>
        <skos:prefLabel>Selective Eating Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpdutTNI2rbLZMnb9oqlOc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpdutTNI2rbLZMnb9oqlOc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo"/>
        <rdfs:label>State Governmental Body</rdfs:label>
        <skos:altLabel>Province</skos:altLabel>
        <skos:altLabel>State</skos:altLabel>
        <skos:definition>A regional governmental body, such as a state or provincial government, operates at a level below the national government but above local governments like cities or municipalities. These bodies have jurisdiction over a specific geographic area and possess their own set of powers and responsibilities, often delineated by a constitution or charter. They typically consist of executive, legislative, and judicial branches, and they manage issues more localized than those of the national government but broader than those of city or town governments. Examples include U.S. state governments, Canadian provincial governments, or Indian state governments.</skos:definition>
        <skos:prefLabel>Provincial Governmental Body</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpg8PAvhGegjDxWexeVTLH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpg8PAvhGegjDxWexeVTLH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Alexander</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDphbylt1EMyB0YxHvM3IR4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDphbylt1EMyB0YxHvM3IR4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Albanian</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Albanais</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Albanisch</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Albanês</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アルバニア語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿尔巴尼亚语</skos:altLabel>
        <skos:definition>A language spoken in Albania and other parts of the Balkans, characterized by its unique grammar and vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDphmWpcqgHRbQbOJeGJinN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDphmWpcqgHRbQbOJeGJinN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED Passive Income, favoring Unearned Income</rdfs:label>
        <skos:definition>Passive Income refers to earnings derived from activities in which the individual is not actively involved. This includes income from investments, rental properties, dividends, interest, royalties, and other sources that do not require continuous effort or direct labor to maintain.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpizZcACsM7yyhWpT5tJaM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpizZcACsM7yyhWpT5tJaM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:label>Forward-looking Material Adverse Effect Standard</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estándar de Efecto Adverso Material Prospectivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándar de Efecto Adverso Material Prospectivo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forward-looking Material Adverse Effect Standard</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel>Material Adverse Effect (MAE) Standard - Forward-looking</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Norme d&apos;effet indésirable matériel prospectif</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Padrão de Efeito Adverso Material Prospectivo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Standard für nach vorne gerichtete wesentliche nachteilige Auswirkungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקן להשפעה נזיפה חומרית מתבטאת במבט קדימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फॉरवर्ड-लुकिंग मटेरियल एडवर्स इफेक्ट स्टैंडर्ड</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">前瞻性实质不利影响标准</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">将来的な重大な不利な影響基準</skos:altLabel>
        <skos:definition>A Forward-looking Material Adverse Effect (MAE) Standard is a legal language used in contracts that refers to a future event or circumstance that could have a negative impact on a party&apos;s ability to fulfill their obligations under the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpjOyejC570NEmEPgJyvuV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpjOyejC570NEmEPgJyvuV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHfeijrOTjaF7qpuoGIGkR"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7LaDc7tLarcbkRoHGyrI3V"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>inv_reference</rdfs:label>
        <skos:definition>&quot;If the firm is submitting a Credit Note (an instrument required by statute or regulation that corrects a previously issued Tax Invoice -- see INVOICE.tax_invoice for more discussion) or is submitting an invoice that corrects an invoice previously rejected by a bill reviewer, enter the inv_id of the original invoice being corrected.  

As described above, law firms are required by regulation to supply the Tax Invoice number being corrected.  It is therefore expected that the receiving system will store this information and display it to bill reviewers.  
  
In addition, in situations where the submission corrects an invoice rejected by a bill reviewer, this field can be used by the receiving system to electronically verify the correction submitted so that these submissions could be approved electronically instead of being routed to a bill reviewer for approval.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpjRd4voHUosNqZM5fkbfF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpjRd4voHUosNqZM5fkbfF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9p98NogvwJk1MnJgYzuiZd"/>
        <rdfs:label>Governmental Monitoring Practice</rdfs:label>
        <skos:altLabel>Governmental Monitoring</skos:altLabel>
        <skos:altLabel>Governmental Monitoring Service</skos:altLabel>
        <skos:altLabel>Public Sector Oversight</skos:altLabel>
        <skos:definition>Governmental Monitoring Practice entails the systematic observation and analysis of activities and decisions across various branches of government to ensure transparency, accountability, and compliance with legal standards. This practice helps organizations and individuals stay informed about legislative, executive, and judicial developments that may impact their interests.</skos:definition>
        <skos:prefLabel>Public Governance Monitoring</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpjbhF3hJ1Ttc3I2Zt3T2X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDpjbhF3hJ1Ttc3I2Zt3T2X">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
