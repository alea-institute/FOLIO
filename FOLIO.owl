        <skos:altLabel xml:lang="de-de">Unfallregulierung ohne Feststellung der Schuld</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה ללא אשמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नो-फॉल्ट दावा</skos:altLabel>
