        <skos:altLabel xml:lang="es-es">Matriz de acreedores</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Matriz de acreedores</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Matriz de credores</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מטריצת נושים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋणदाता मैट्रिक्स</skos:altLabel>
