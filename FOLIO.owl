            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Term Sheet Execution</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ausführung der Term Sheet</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ejecución de la Hoja de Términos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ejecución de la Hoja de Términos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Execução da Planilha de Termos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Exécution de la feuille de termes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Term Sheet Execution</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ביצוע גיליון תנאים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टर्म शीट कार्यान्वयन</skos:altLabel>
