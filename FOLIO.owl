        <skos:altLabel xml:lang="es-es">Gravamen de mecánicos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gravamen de mecánicos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Handwerkerpfandrecht</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Hipoteca Mobiliaria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mechanic&apos;s Lien</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mechanics&apos; Lien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Penhora de Mecânico</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège du mécanicien</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גילוי מכני</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גילוי מכניות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मैकेनिक का लिएन</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मैकेनिक लीन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">工事担保権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">机械留置权</skos:altLabel>
        <skos:definition>A Mechanics&apos; Lien is a type of lien that allows a contractor or supplier to place a claim on a property they have worked on if they have not been paid for their services or materials.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBc09F49xi1kJWJxboFxFhg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBc09F49xi1kJWJxboFxFhg">
