        <skos:altLabel xml:lang="de-de">Fertigungsexperte</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">制造业专家</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">製造業の専門家</skos:altLabel>
        <skos:definition>An expert in the field of manufacturing, including managers and workers with experience in the manufacturing industry. 10 U.S.C. § 2197</skos:definition>
    </owl:Class>
    


