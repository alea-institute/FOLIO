            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ship</rdfs:label>
        <skos:altLabel>Maritime Vessel</skos:altLabel>
        <skos:altLabel>Ocean Liner</skos:altLabel>
        <skos:altLabel>Sea Vessel</skos:altLabel>
        <skos:definition>A Ship is a large watercraft designed for deep-water navigation, typically used for transporting goods, passengers, or military personnel over long distances. Ships are equipped with various facilities and systems for navigation, safety, and cargo handling.</skos:definition>
        <skos:example>Cargo Ship</skos:example>
        <skos:example>Container Ship</skos:example>
        <skos:example>Cruise Ship</skos:example>
        <skos:example>Passenger Ship</skos:example>
        <skos:example>Tanker</skos:example>
        <skos:example>Warship</skos:example>
        <skos:prefLabel>Ocean-Going Vessel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Xog8HfRqeibD6dtbUHdsw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Xog8HfRqeibD6dtbUHdsw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xekNn7K6SxToo5ArjIsTX"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Roi2OUuh5i5gPUoKu8Jyuc"/>
        <rdfs:label>Motion to File Appendix</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einreichung eines Anhangs</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para presentar apéndice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer une annexe</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Appendix</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para arquivar apêndice</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para presentar apéndice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להגשת נספח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपेंडिक्स फ़ाइल करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">付録の提出に関する動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交附录动议</skos:altLabel>
        <skos:definition>A Motion to File Appendix is a formal request made to a court to include additional documents or evidence in the record of a case, beyond what has already been submitted.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XqrkTtzwDo9hrSPrD0ATJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XqrkTtzwDo9hrSPrD0ATJ">
