        <skos:altLabel xml:lang="ja-jp">債券資産</skos:altLabel>
        <skos:definition>A bond is a fixed income instrument that represents a loan made by an investor to a borrower (typically corporate or governmental). A bond could be thought of as an I.O.U. between the lender and borrower that includes the details of the loan and its payment.</skos:definition>
        <skos:hiddenLabel>BONDA</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCwfXHL2fqsZng8Y7YZ0wKP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCwfXHL2fqsZng8Y7YZ0wKP">
