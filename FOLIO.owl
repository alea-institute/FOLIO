        <rdfs:label>Outside Counsel Guidelines</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Directives pour les avocats externes</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Directrices para abogados externos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Directrices para abogados externos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Diretrizes para Advogados Externos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Outside Counsel Guidelines</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Richtlinien für externe Rechtsberater</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הנחיות לייעוץ מחוץ למשרד עו&quot;ד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बाहरी कानून परामर्श दिशानिर्देश</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">外部律师指南</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">外部顧問ガイドライン</skos:altLabel>
        <skos:definition>Outside Counsel Guidelines are a set of expectations set by a company or organization for the external law firms or attorneys it hires, detailing billing, communication, conflicts of interest, confidentiality, and other work-related parameters.</skos:definition>
        <skos:prefLabel>OCG</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9OJlM7qnQBsP6xcryJ9B5M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9OJlM7qnQBsP6xcryJ9B5M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RrCF5zcrzh4jFvAQn6emEB"/>
        <rdfs:label>Adult Entertainer</rdfs:label>
        <skos:definition>An adult entertainer is an individual who performs in sexually-oriented shows or activities, often for an audience at specialized venues like strip clubs. The legal regulations governing adult entertainers vary by jurisdiction but commonly include age restrictions, licensing requirements, and zoning laws for the venues where they perform.</skos:definition>
        <skos:prefLabel>Stripper</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9OPLmJsjNEC1np84qWsrXY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9OPLmJsjNEC1np84qWsrXY">
