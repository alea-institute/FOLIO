        <rdfs:label>Digital Transformation Services</rdfs:label>
        <skos:definition>Digital Transformation Services refer to consulting and management services that help organizations adopt and integrate digital technologies and processes to improve their business operations and customer experiences.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTHHNY7rlRxTEG0OoZYv7d -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBTHHNY7rlRxTEG0OoZYv7d">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNUBxUepOEIOvagLHcD3N0"/>
        <rdfs:label>O-3 Visa</rdfs:label>
        <skos:altLabel>Family Visa For Extraordinary Talent Holders</skos:altLabel>
        <skos:definition>An O-3 visa is issued to the immediate family members of O-1 and O-2 visa holders, allowing them to accompany or join the primary visa holder in the U.S. This visa category includes spouses and unmarried children under the age of 21.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTLd8JvrBUbYcywr5KqpH6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBTLd8JvrBUbYcywr5KqpH6">
