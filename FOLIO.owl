        <rdfs:label>Arkansas Circuit Court - Independence Cty.</rdfs:label>
        <skos:definition>Arkansas Circuit Court - Independence County is a specific court within the Arkansas Circuit Court system that has jurisdiction over legal matters within Independence County, Arkansas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9mmoUsDKGTyjfuOcuvUlSM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9mmoUsDKGTyjfuOcuvUlSM">
