            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDh0fUeo8oXmuCf3hN337nf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Divorce Claims</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Demandas de divorcio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demandes de divorce</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Divorce Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de divorcio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de divórcio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Scheidungsansprüche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות גירושין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तलाक दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">离婚索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">離婚請求</skos:altLabel>
        <skos:definition>Divorce Claims refer to legal actions taken by a party to end a marriage and obtain a legal dissolution of the marital relationship, including issues related to property division, spousal support, and child custody.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7wjSxFeGSnGHBA4sop8v3G -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7wjSxFeGSnGHBA4sop8v3G">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ibMTtrBCWGIGOeFjTLtL0"/>
        <rdfs:label>Jail</rdfs:label>
        <skos:altLabel>Detention Center</skos:altLabel>
        <skos:altLabel>Holding Facility</skos:altLabel>
        <skos:definition>A Jail is a local government-run facility designed to detain individuals who are awaiting trial, sentencing, or serving short-term sentences typically for minor offenses. It serves as a temporary holding place for pretrial detainees and inmates convicted of misdemeanors, emphasizing security, custody, and limited rehabilitation services.</skos:definition>
        <skos:prefLabel>Short-Term Detention Facility</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7wpO1Qu9qmPRI8VFoLyPlB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7wpO1Qu9qmPRI8VFoLyPlB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  Clearfield County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Clearfield County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering legal proceedings in Clearfield County, Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7wrI57WaogjWdkpozaYZyV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7wrI57WaogjWdkpozaYZyV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NuHbXZluNRzq9D1bLM716"/>
        <rdfs:label>Oral Agreement</rdfs:label>
        <skos:altLabel>Parol Contract</skos:altLabel>
        <skos:altLabel>Spoken Contract</skos:altLabel>
        <skos:altLabel>Verbal Agreement</skos:altLabel>
        <skos:definition>An Oral Agreement is a contract or agreement that is spoken and not written, where the parties express their mutual intentions and promises through verbal communication. While enforceable in many legal contexts, proving the terms and existence of an oral agreement can be more challenging than a written one.</skos:definition>
        <skos:prefLabel>Verbal Contract</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7wsLtBraH6Dx1GyHgB0h0x -->

