    <!-- https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <dc:source rdf:resource="https://seer.cancer.gov/statfacts/html/common.html"/>
        <dc:source rdf:resource="https://www.cancer.gov/types/common-cancers"/>
        <rdfs:label>Cancer</rdfs:label>
        <skos:altLabel>Malignant Tumor</skos:altLabel>
        <skos:definition>Cancer is a group of diseases characterized by the uncontrolled growth and spread of abnormal cells, which can invade and destroy healthy body tissue. If not treated, cancer can result in serious illness or death, often requiring extensive medical intervention including surgery, chemotherapy, and radiation.</skos:definition>
        <skos:prefLabel>Malignant Neoplastic Diseases</skos:prefLabel>
    </owl:Class>
    


