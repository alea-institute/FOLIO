                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R767niCLQVC5zIcO5WDQMSl"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Invoice Total Net Due</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Invoice Total Net Due</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechnungsbetrag Netto Fällig</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Total de la facture nette due</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Total líquido devido da fatura</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Total neto adeudado de la factura</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Total neto adeudado de la factura</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סך הכל לתשלום לפני הנחת מס</skos:altLabel>
