        <skos:altLabel xml:lang="es-es">Cláusula de Suministros Operativos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Suministros Operativos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de suprimentos operacionais</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für Betriebsbedarf</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Operating Supplies Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ציוד הפעלה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऑपरेटिंग सप्लाइज क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">运营用品条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">運用物資条項</skos:altLabel>
        <skos:definition>An Operating Supplies Clause is a provision in a contract that outlines the terms and conditions related to the provision and use of supplies necessary for the operation of a business or organization.</skos:definition>
    </owl:Class>
    


