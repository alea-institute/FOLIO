        <skos:altLabel xml:lang="es-es">Mala conducta bancaria al confiar en el poder de representación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mala conducta bancaria al confiar en el poder notarial</skos:altLabel>
