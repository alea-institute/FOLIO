        <skos:altLabel xml:lang="pt-br">Desembolso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disbursement</skos:altLabel>
        <skos:altLabel>Distribution</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Décaissement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वितरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">支出</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">支払い</skos:altLabel>
        <skos:definition>The concept of Disbursement (Distribution) refers to the act of distributing funds or assets to the intended recipients, often as part of a larger event or phase.</skos:definition>
        <skos:prefLabel>Distribution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NcEcKGyel5bjJtbeSaJpa -->

