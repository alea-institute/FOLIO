        <skos:altLabel xml:lang="es-mx">Moción para referir el caso a mediación</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para remitir el caso a mediación</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion de renvoi de l&apos;affaire à la médiation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Refer Case to Mediation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para encaminhar o caso à mediação</skos:altLabel>
