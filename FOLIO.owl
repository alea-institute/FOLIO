        <rdfs:label>Illinois Circuit Court - Sangamon County (7th Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcRpGHlBPQA4Z6MaK5qMF8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcRpGHlBPQA4Z6MaK5qMF8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>No Default Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-défaut</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não padrão</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Keine Standardklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Default Clause</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Sin Cláusula por Defecto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sin Cláusula por Defecto</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אין סעיף ברירת מחדל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कोई डिफ़ॉल्ट क्लॉज नहीं</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">デフォルトなし条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无默认条款</skos:altLabel>
        <skos:definition>A &quot;No Default Clause&quot; is a provision in a contract that specifies that neither party can be considered in default unless a specific event or condition occurs, as defined in the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcS1UIoBII6T64BpylJueo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcS1UIoBII6T64BpylJueo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEWWtS3nM8GE8R4en1abRz"/>
        <rdfs:label>Arkansas Circuit Court - Little River Cty.</rdfs:label>
        <skos:definition>A court located in Little River County, Arkansas that has jurisdiction over certain legal matters within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcTA2iQmrtqOnX3WrjJIp8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcTA2iQmrtqOnX3WrjJIp8">
