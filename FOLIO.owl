        <skos:altLabel xml:lang="pt-br">Cheque certificado ou de caixa injustamente devolvido</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Chèque certifié ou de caissier injustement rejeté</skos:altLabel>
