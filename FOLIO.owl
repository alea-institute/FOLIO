            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Electoral Petition</rdfs:label>
        <skos:altLabel>Election Petition</skos:altLabel>
        <skos:definition>A formal legal document filed with a court or tribunal in some jurisdictions, such as the United Kingdom, to challenge the validity or outcome of an election, often based on alleged irregularities, violations of election laws, or misconduct by candidates or election officials. Electoral petitions serve as a mechanism for aggrieved parties to seek legal redress and ensure the integrity of the electoral process.</skos:definition>
        <skos:prefLabel>Electoral Challenge</skos:prefLabel>
    </owl:Class>
    


