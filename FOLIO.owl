        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Possessing Stolen Property</rdfs:label>
        <skos:altLabel xml:lang="de-de">Besitz gestohlener Sachen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Posesión de Propiedad Robada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Posse de propriedade roubada</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Possessing Stolen Property</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Recel de biens volés</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tenencia de Bienes Robados</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בעלות על רכוש גנוב</skos:altLabel>
