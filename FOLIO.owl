        <rdfs:label>New York Supreme Court - Putnam County</rdfs:label>
        <skos:definition>The New York Supreme Court - Putnam County is a court of general jurisdiction located in Putnam County, New York, which is a subordinate court of the New York Supreme Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsKDUbw0wJYWl8RVC0O5TG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsKDUbw0wJYWl8RVC0O5TG">
