        <skos:altLabel xml:lang="de-de">Antrag auf Abweisung wegen fehlender Gerichtsbarkeit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Desestimación por Falta de Jurisdicción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Incompetencia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Dismiss for Lack of Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de arquivamento por falta de jurisdição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en irrecevabilité pour défaut de juridiction</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לדחיית התביעה עקב חוסר סמכות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिकरण की कमी के कारण खारिजी करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">管轄権の欠如による却下請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">管辖权不足驳回动议</skos:altLabel>
        <skos:definition>A Motion to Dismiss for Lack of Jurisdiction is a formal request made to a court to dismiss a case due to the court lacking the authority to hear and decide the matter at hand.</skos:definition>
    </owl:Class>
    


