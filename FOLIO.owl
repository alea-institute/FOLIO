        <rdfs:label>Data Breach</rdfs:label>
        <skos:definition>A &quot;Data Breach&quot; refers to an incident in which unauthorized individuals gain access to confidential data, often resulting in the exposure or theft of sensitive information. Such breaches can compromise personal, financial, or business-related data, posing risks to individuals, organizations, and stakeholders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RawJ8s5nRdIt85WOvY1Orq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RawJ8s5nRdIt85WOvY1Orq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8"/>
        <rdfs:label>Abuse of Process</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Abus de procédure</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Abuse of Process</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Abuso de Procedimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Abuso de Proceso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Abuso de processo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtsmissbrauch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שימוש לרעה בתהליך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रक्रिया का दुरुपयोग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">手続き乱用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">程序滥用</skos:altLabel>
        <skos:definition>The concept of &quot;Abuse of Process&quot; refers to the misuse of legal procedures or the justice system for an ulterior motive, such as to harass or intimidate someone, rather than for the legitimate pursuit of justice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Raye9wszOl53QEcjEACnQR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Raye9wszOl53QEcjEACnQR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDN8CVqeiDlOeHJO8Oeltq6"/>
        <rdfs:label>Polar Market Segment</rdfs:label>
        <skos:altLabel>Antarctic Market Segment</skos:altLabel>
        <skos:altLabel>Arctic Market Segment</skos:altLabel>
        <skos:definition>The Polar Market Segment targets consumers or businesses situated in regions experiencing extremely cold temperatures, such as polar and subpolar zones. Products and services in this segment are designed to address the challenges of living in frigid climates, including insulation, heating solutions, and specialized clothing.</skos:definition>
        <skos:prefLabel>Frigid Climate Market Segment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rb1azCsSHRLiyTTBbwGbEiQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rb1azCsSHRLiyTTBbwGbEiQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RK0ttjFyyS0ytN62EJVzSZg"/>
        <rdfs:label>X202 Patent and Trademark Searching and Monitoring</rdfs:label>
        <skos:definition>Any searching and monitoring costs, including any monitoring or watch service for a trademark, brand or domain name. Excludes on-line legal research (X111) or discovery/eDiscovery culling and filtering (X302).</skos:definition>
        <skos:prefLabel>X202 Patent and Trademark Searching and Monitoring</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rb33ejPtclmIHJbqwTN12C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rb33ejPtclmIHJbqwTN12C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ro1RKRYnlciGrhgC4NjuDV"/>
