        <skos:altLabel xml:lang="es-es">Moción para solicitar la publicación de la disposición de memorándum</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para solicitar la publicación de la disposición de memorándum</skos:altLabel>
