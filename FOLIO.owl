        <skos:altLabel xml:lang="de-de">Totschlag</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过失杀人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">過失致死</skos:altLabel>
        <skos:definition>The unlawful killing of a human being without malice aforethought, but with either intent to cause harm or reckless disregard for human life.</skos:definition>
    </owl:Class>
    


