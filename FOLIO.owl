        <skos:altLabel xml:lang="ja-jp">スンダ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">巽他语</skos:altLabel>
        <skos:definition>Sundanese (Language) is a structured system of communication that consists of grammar and vocabulary specific to the Sundanese people of West Java, Indonesia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSyBCrobkgiOYQQYtjUx3n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSyBCrobkgiOYQQYtjUx3n">
