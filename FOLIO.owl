            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Correctional Facility Official</rdfs:label>
        <skos:altLabel>Correctional Facility Staff</skos:altLabel>
        <skos:altLabel>Jail Official</skos:altLabel>
        <skos:definition>A Prison Official is an individual responsible for the management, oversight, and operation of a correctional facility, ensuring security, order, and compliance with regulations. These officials oversee the staff, inmate population, and administrative functions, playing a critical role in maintaining the safety and rehabilitation efforts within the prison.</skos:definition>
        <skos:prefLabel>Prison Official</skos:prefLabel>
    </owl:Class>
    


