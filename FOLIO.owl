            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Private Right of Action</rdfs:label>
        <skos:definition>A private right of action refers to the legal authority granted to an individual or private party to file a lawsuit for violations of law that have affected them. Essentially, it enables citizens to enforce statutes or regulations by taking alleged violators to court, rather than relying solely on government agencies for enforcement.</skos:definition>
        <skos:prefLabel>Private Enforcement Right</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7oZYoHPjrvOgl09T5WKFGI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7oZYoHPjrvOgl09T5WKFGI">
