        <skos:altLabel xml:lang="zh-cn">组织代表</skos:altLabel>
        <skos:definition>An Organization Representation is a statement made by a party in a legal matter regarding the status, structure, or operations of a company or other entity, which is supported by a warranty that the information provided is accurate and complete.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI">
