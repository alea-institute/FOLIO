        <skos:definition>A Nanny Visa authorizes a foreign national to enter and work in a host country as a live-in or live-out caregiver, primarily for children of certain non-immigrant workers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7VndJ6w4w2Y0TR0pz5AX5k -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7VndJ6w4w2Y0TR0pz5AX5k">
