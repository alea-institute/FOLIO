        <rdfs:label>Texas District Court - Denton County</rdfs:label>
        <skos:definition>A Texas District Court located in Denton County, which has jurisdiction over civil and criminal cases within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBdQwJbHbzdLDrA5dnYjzoI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBdQwJbHbzdLDrA5dnYjzoI">
