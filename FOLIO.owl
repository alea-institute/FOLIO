        <skos:altLabel xml:lang="ja-jp">文書の識別に関する実践</skos:altLabel>
        <skos:definition>Identification of Documents Practice refers to the process of locating and selecting relevant documents for a legal matter, which is a subset of the broader Document Collection and Production Practice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fCP2EQY8XQ5fxqiYaKPQA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7fCP2EQY8XQ5fxqiYaKPQA">
