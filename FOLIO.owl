        <skos:altLabel>Anti-Religious Material</skos:altLabel>
        <skos:altLabel>Profane Material</skos:altLabel>
        <skos:altLabel>Religious Offense Content</skos:altLabel>
        <skos:definition>Blasphemous Material refers to content that shows disrespect or irreverence toward religious beliefs, figures, deities, or sacred symbols. This type of material often leads to significant controversy and legal actions in jurisdictions where blasphemy laws are enforced.</skos:definition>
        <skos:prefLabel>Sacrilegious Content</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7nAdEIoau71IKNfRbVollw -->

