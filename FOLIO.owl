        <skos:altLabel xml:lang="es-mx">Licenciatario</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Licencié</skos:altLabel>
        <skos:altLabel>Licensee</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Licensee</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lizenznehmer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נושה רשיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लाइसेंसी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ライセンシー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">被许可人</skos:altLabel>
        <skos:definition>A licensee is a person or entity to whom a license is granted. A licensee has the license to use someone else&apos;s specified property such as a building, a land or intellectual property.</skos:definition>
        <skos:hiddenLabel>LICE</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZdShYeyerlOOUlB0f64SY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZdShYeyerlOOUlB0f64SY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RM8uFdNbkVDabwW32Bv8E"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9Mw0y1sYeTkDl6Po3b4ViW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Islamic Law System</rdfs:label>
        <skos:altLabel>Fiqh Law System</skos:altLabel>
        <skos:altLabel>Islamic Jurisprudence</skos:altLabel>
        <skos:altLabel>Muslim Law</skos:altLabel>
        <skos:definition>Sharia Law is a legal system based on Islamic principles derived from the Quran, Hadith (sayings of Prophet Muhammad), and other Islamic texts. This system governs both personal and communal aspects of life, integrating moral and legal guidelines.</skos:definition>
        <skos:prefLabel>Sharia Law System</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZdcJFiGdJRQaK9DBMuCjS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZdcJFiGdJRQaK9DBMuCjS">
