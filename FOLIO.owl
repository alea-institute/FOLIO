        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDspRIwoJTlopUDjSgLRduf"/>
        <rdfs:label>Causation</rdfs:label>
        <skos:altLabel xml:lang="es-es">Causalidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Causalidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Causalidade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Causalité</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Causation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kausalität</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גורמיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कारण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因果关系</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">因果関係</skos:altLabel>
        <skos:definition>The concept of Causation refers to the relationship between an action or event and the resulting injury or harm, and is an essential element of a legal claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkZYUUCh1HYX007hux78Rl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkZYUUCh1HYX007hux78Rl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:label>Fail-to-Pay-Timely Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf verspätete Zahlung</skos:altLabel>
        <skos:altLabel>Fail to Pay Timely Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Fail-to-Pay-Timely Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por falta de pago oportuno</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por falta de pago oportuno</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de falha em pagar pontualmente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de non-paiement en temps voulu</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על כשל בתשלום במועד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समय पर भुगतान न करने की दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">支払い遅延請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未能及时支付索赔</skos:altLabel>
        <skos:definition>A fail-to-pay-timely claim is a legal action initiated by an employee against their employer for not providing timely payment of wages or other compensation. The claim typically arises when an employer does not comply with applicable laws, which require employers to pay employees their earned wages at regular intervals, such as weekly or bi-weekly. The claim can also include allegations of employers not paying earned commissions, bonuses, or other forms of compensation in a timely manner.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkaY1XWFWVtT4quk3y4oxw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkaY1XWFWVtT4quk3y4oxw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Metrolina Native American Association</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkbIrzj6HiYQSEnDLqeHsh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkbIrzj6HiYQSEnDLqeHsh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDVQLifN70TJSPCRJJLBgPY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Police Misconduct</rdfs:label>
        <skos:definition>Police misconduct refers to wrongful or inappropriate actions committed by law enforcement officers while performing their duties. This misconduct can encompass a range of behaviors, including excessive use of force, racial profiling, false arrest, bribery, or other violations of laws, policies, or ethical standards. Cases of police misconduct may result in legal action against the officers involved, civil lawsuits, or disciplinary measures within the police department.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkbsRmxlCHsKFrpTNqzA1D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkbsRmxlCHsKFrpTNqzA1D">
