        <skos:altLabel xml:lang="pt-br">Conduta criminosa do autor</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Plaintiff&apos;s Felonious Conduct</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafbares Verhalten des Klägers</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התנהגות פלונית של התובע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिवादी का अपराधी आचरण</skos:altLabel>
