            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Involuntary Bankruptcy Petition</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf unfreiwillige Insolvenz</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Involuntary Bankruptcy Petition</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Petición de quiebra involuntaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Petición de quiebra involuntaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de falência involuntária</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pétition en faillite involontaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לחיוביות פשוטה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनजब्दा दिवालियापन याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自己破産申請</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非自愿破产申请</skos:altLabel>
        <skos:definition>An Involuntary Bankruptcy Petition is a legal request filed by creditors against a debtor who has not paid their debts, seeking to force the debtor into bankruptcy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RxH7lIaJncEJ3TCqMq2mJj -->

