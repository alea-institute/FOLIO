    <owl:Class rdf:about="https://folio.openlegalstandard.org/RTRiaL5f3fTMDVviJJvWmF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSwOCeFhWxUA3fOiTvlja4"/>
        <rdfs:label>Welfare Payments</rdfs:label>
        <skos:altLabel>Income Support</skos:altLabel>
        <skos:altLabel>Public Assistance</skos:altLabel>
        <skos:altLabel>Social Assistance Payments</skos:altLabel>
        <skos:altLabel>Welfare Income</skos:altLabel>
        <skos:definition>Welfare Payments are financial assistance provided by the government to individuals and families in need, aiming to ensure a minimum standard of living. These payments are designed to support basic necessities such as food, housing, and healthcare for low-income and vulnerable populations.</skos:definition>
        <skos:prefLabel>Social Welfare Benefits</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RTSI7ogxo4mf2wErPNxZDK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RTSI7ogxo4mf2wErPNxZDK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC9rPAii8f99I7p4Hi5Qdia"/>
        <rdfs:label>Vestibular Disorder</rdfs:label>
        <skos:definition>Disturbance of labyrinthine-vestibular function involves a condition characterized by frequent episodes of balance disturbances, tinnitus (ringing in the ears), and progressive hearing loss. Diagnosis typically requires evidence of impaired vestibular function through tests such as caloric or other vestibular assessments, as well as documented hearing loss established by audiometry.</skos:definition>
        <skos:prefLabel>Disturbance of Labyrinthine-Vestibular Function</skos:prefLabel>
    </owl:Class>
    


