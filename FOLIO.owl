&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuFYyZorYWUSsV5u02JBYb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuFYyZorYWUSsV5u02JBYb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Avoid Lien</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Vermeidung von Pfandrechten</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Evitar un Gravamen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Evitar un Gravamen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour éviter une hypothèque</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Avoid Lien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para evitar ônus</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להימנע מגילוי משיכה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लिएन से बचने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">抵当権回避申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">避免留置权动议</skos:altLabel>
        <skos:definition>A Motion to Avoid Lien is a legal request made in a bankruptcy case to remove a creditor&apos;s lien on a debtor&apos;s property, allowing the debtor to keep the property free and clear of the creditor&apos;s claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuFa1wrcj6X39EQTjEVAxY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuFa1wrcj6X39EQTjEVAxY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_07"/>
        <rdfs:label>Cerebral Palsy</rdfs:label>
        <skos:altLabel>CP</skos:altLabel>
        <skos:definition>Cerebral Palsy (CP) is a group of neurological disorders that affect movement, muscle tone, and posture, caused by damage to the developing brain either during pregnancy, childbirth, or shortly after birth. This condition leads to varying degrees of motor impairment and may also impact speech, vision, and cognitive abilities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuGCUgu3KSRqVu9XKcPIYbg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuGCUgu3KSRqVu9XKcPIYbg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtpnOBk4lRnWigpEBBKYUDQ"/>
        <rdfs:label>X122 Late Fees</rdfs:label>
        <skos:definition>Any late fee imposed by a governmental or quasi-governmental agency in any type of matter in order to have a document entered into record past the initial deadline. For IP matters, includes including Petition for Extension of Time and Information Disclosure Statement fees in the US. Excludes any late fee or finance charge on overdue legal bills.</skos:definition>
        <skos:prefLabel>X122 Late Fees</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuGrZGUFfiswzSZww3VhH2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuGrZGUFfiswzSZww3VhH2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3SDQBy4KfjSgp3bgpb4Fx"/>
        <rdfs:label>Intestate Status</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estado Intestado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estado Intestado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intestate Status</skos:altLabel>
        <skos:altLabel xml:lang="de-de">gesetzlicher Erbfolge</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">status de herdeiro legítimo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">statut d&apos;héritier légal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מצב חסר צוואה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिविरासत स्थिति</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无遗嘱继承人身份</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法定相続人の地位</skos:altLabel>
        <skos:definition>The state of having died without a valid will or testamentary disposition of property, resulting in the distribution of the deceased&apos;s assets according to the laws of intestacy.</skos:definition>
        <skos:prefLabel>Intestacy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuIG2rEI5t49RfIVJsH0IX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuIG2rEI5t49RfIVJsH0IX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7eVYpVEsDqKqMUL2HL23Zr"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Demand Futility</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Demand Futility</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Futilidad de la Demanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Futilidad de la Demanda</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Futilidade da demanda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Futilité de la demande</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nachfrageaussichtslosigkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פסולת דרישה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मांग निष्फलता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">需求无效</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">需要の無効</skos:altLabel>
        <skos:definition>Demand futility is a legal concept within corporate and partnership liability claims that allows shareholders to bring a lawsuit on behalf of the company without first making a demand on the board of directors if doing so would be futile.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuJballS0a7fp0UeRUTFgF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuJballS0a7fp0UeRUTFgF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5NlX3MRKQ0Ispm4G4jHuT"/>
        <rdfs:label>Animal Authorship</rdfs:label>
        <skos:definition>Animal Authorship in copyright law addresses the concept of works created by animals, questioning whether such creations can qualify for copyright protection. It challenges traditional notions of authorship by considering the legal status and intellectual property rights of works produced by non-human beings.</skos:definition>
    </owl:Class>
    


