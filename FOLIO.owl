        <rdfs:label>Motion for Misjoinder of Parties</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss von Parteien</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Desestimación por Multitud de Partes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Desestimación por Multitud de Partes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Misjoinder of Parties</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour irrecevabilité de parties</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Impugnação de Partes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין עקב חריגה במספר הצדדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पक्षियों के गलत जुड़े होने के लिए आंदोलन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">当事者の誤参加排除請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除当事人动议</skos:altLabel>
        <skos:definition>A Motion for Misjoinder of Parties is a legal document filed by a party in response to a complaint, requesting the court to dismiss the case due to improper joinder of parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8lZOWTlcK5fZVxv30qlETY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8lZOWTlcK5fZVxv30qlETY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R99F253EB4991DD4767D3f46"/>
        <rdfs:label>Louisiana Department of Labor - Office of Workers&apos; Compensation</rdfs:label>
        <skos:definition>The Louisiana Department of Labor - Office of Workers&apos; Compensation is a government agency responsible for administering workers&apos; compensation proceedings in Louisiana State Courts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8laa4RmOrW4EmaV7FXEsq5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8laa4RmOrW4EmaV7FXEsq5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
        <dc:source rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32011L0061"/>
        <dc:source rdf:resource="https://www.investopedia.com/terms/a/alternative-investment-fund-managers-directive-aifmd.asp"/>
        <rdfs:label>Alternative Investment Fund Managers Directive Claim</rdfs:label>
        <skos:altLabel>AIFMD Compliance Claim</skos:altLabel>
        <skos:altLabel>Alternative Investment Fund Managers Regulation Claim</skos:altLabel>
        <skos:definition>An Alternative Investment Fund Managers Directive (AIFMD) Claim refers to a legal action or regulatory complaint arising from the alleged breach or non-compliance with the AIFMD, which regulates managers of alternative investment funds (AIFs) in the European Union. These claims often involve issues related to investor protection, transparency, and the marketing and management of AIFs.</skos:definition>
        <skos:prefLabel>AIFMD Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8lbOgBIHIIDXw31RR7sNxQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8lbOgBIHIIDXw31RR7sNxQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBoyPCQL9cRuwbjeNvSO55y"/>
        <rdfs:label>Supremacy Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Vorherrschaftsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Parliamentary Sovereignty Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Supremacía</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Supremacía</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Supremacia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la clause de suprématie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף הגמות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">श्रेष्ठता धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">至上主義条項主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">至高无上条款主张</skos:altLabel>
        <skos:definition>A Supremacy Clause claim refers to a legal argument based on the Supremacy Clause of the United States Constitution, asserting that federal law prevails over conflicting state or local laws when they are in direct conflict. It establishes the principle that the Constitution, federal laws, and treaties take precedence over inconsistent state laws, ensuring a consistent and unified legal framework throughout the United States.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ld5fuznk2KgKLafAENQsH -->

