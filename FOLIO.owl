                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDkIRpvtzD5THQGcZfEul3u"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prospectus</rdfs:label>
        <skos:altLabel>Public Offering Statement</skos:altLabel>
        <skos:definition>A Prospectus is a formal document filed with securities regulators that provides details about an investment offering for sale to the public. It usually includes the terms of the offering, risks, and financial statements among other critical information.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RHDWYB8AvApZyPoBsWSOP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8RHDWYB8AvApZyPoBsWSOP">
