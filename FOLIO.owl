    <!-- https://folio.openlegalstandard.org/RDcQ2WqIyuInoKQbithTsL2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDcQ2WqIyuInoKQbithTsL2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NB9WJzAFK6tIIGmfIj5Ay"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
        <dc:source>Fed. R. Evid. 403</dc:source>
        <dc:source>Fed. R. Evid. 611</dc:source>
        <rdfs:label>Cumulative Objection</rdfs:label>
        <skos:altLabel>Asked and Answered Objection</skos:altLabel>
        <skos:altLabel>Redundant Evidence Objection</skos:altLabel>
        <skos:altLabel>Repetitious Objection</skos:altLabel>
        <skos:altLabel>Repetitive Evidence Objection</skos:altLabel>
        <skos:definition>An Objection to Cumulative Evidence is raised when a party in a legal proceeding believes that the evidence being presented is repetitive and does not add any new information to the case. This objection aims to prevent the unnecessary prolongation of the proceeding and to avoid undue emphasis on certain evidence.</skos:definition>
        <skos:prefLabel>Objection to Repetitious Evidence</skos:prefLabel>
    </owl:Class>
    


