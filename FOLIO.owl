        <rdfs:label>Guaranty Claim</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Garantia</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Garantie</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Garantie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Garantía</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Garantía</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Guaranty</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ערבות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गारंटी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保証</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保证</skos:altLabel>
        <skos:definition>A guaranty claim is a cause of action over a legal promise made by one party to be responsible for the debt or obligation of another party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBHsUy15guQC3jWrIYrwRsH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBHsUy15guQC3jWrIYrwRsH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsWDLg5JUKHPw6my6QzmoU"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Risk</rdfs:label>
        <skos:definition>Regulatory Risk refers to the potential for negative consequences arising from an organization&apos;s noncompliance with laws, regulations, or industry standards that govern its operations, products, or services. These risks can stem from various sources, such as changes in regulatory requirements, lack of clarity on compliance obligations, or failure to implement adequate controls, potentially leading to legal penalties, reputational damage, or operational disruptions, ultimately impacting the organization&apos;s overall performance and sustainability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBHxBQRUlBK0J0bY3TFCTzH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBHxBQRUlBK0J0bY3TFCTzH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKBlQ2mgZn3CTwBfUYIM7s"/>
        <rdfs:label>Progressive Bulbar Palsy</rdfs:label>
        <skos:definition>Progressive bulbar palsy (PBP) is a neurodegenerative disorder characterized by the progressive degeneration of motor neurons in the brainstem, leading to progressive weakness and atrophy of the muscles involved in speech, swallowing, and breathing. This condition often overlaps with Amyotrophic Lateral Sclerosis (ALS) but primarily affects the bulbar muscles.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBHxaoG50eKk8vBltedqqt4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBHxaoG50eKk8vBltedqqt4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KRLFkDC6ycyN3FyXivt7D"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:label>Fair Debt Collection Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Fair Debt Collection Act</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Fair Debt Collection Act Claim</skos:altLabel>
        <skos:altLabel>Fair Debt Collection Practices Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Cobranza Justa de Deudas</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Colección de Deudas Justas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de acordo com a Lei de Coleta Justa de Dívidas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la collecte équitable des dettes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק אגר חובות הוגנת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फेयर डेब्ट कलेक्शन एक्ट दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公平债务收取法索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正な債務回収法クレーム</skos:altLabel>
        <skos:definition>A Fair Debt Collection Act Claim is a legal claim made by a consumer against a debt collector for violating the Fair Debt Collection Practices Act, which sets standards for debt collection activities and prohibits certain abusive and deceptive practices.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBHzq2yqYL8JEktmzbPwYOP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBHzq2yqYL8JEktmzbPwYOP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCQCiKMTNRjrI3JbFdOhXu2"/>
        <rdfs:label>Trade Safeguards Dispute</rdfs:label>
        <skos:altLabel>Import Protection Dispute Resolution</skos:altLabel>
        <skos:altLabel>Trade Defense Litigation</skos:altLabel>
        <skos:altLabel>Trade Safeguard Legal Proceedings</skos:altLabel>
        <skos:definition>Trade Safeguards Disputes involve legal proceedings related to the application of safeguard measures, which are temporary restrictions on imports to protect domestic industries from serious injury caused by increased imports. This practice includes representing clients in disputes before international trade bodies and ensuring compliance with international trade agreements.</skos:definition>
        <skos:prefLabel>International Trade Protection Litigation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBI1GgQFGHi8jZxymdj6eTL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBI1GgQFGHi8jZxymdj6eTL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8fcGNgScyMlOAFxW5Omw5Y"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Statutory Rape</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Statutory Rape</skos:altLabel>
        <skos:altLabel>Unlawful Sexual Intercourse</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Violación Estatutaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Violación Estatutaria</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אונס סטטוטורי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी बलात्कार</skos:altLabel>
        <skos:definition>Nonforcible sexual intercourse with a person who is under the statutory age of consent.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBI4hGnxdB0Ct4ffwBQprM2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBI4hGnxdB0Ct4ffwBQprM2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoOnTANPIS6LCYx2SVkLJL"/>
        <rdfs:label>Tort Claimants Committee</rdfs:label>
        <skos:definition>A Tort Claimants Committee is typically established within bankruptcy proceedings or large-scale litigation contexts to represent the interests of individuals who have tort claims against the debtor or defendant. This committee works to ensure that the rights and recovery opportunities of tort claimants are protected and maximized during the legal process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBI5p2rdv7JzHTtGyObrIcl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBI5p2rdv7JzHTtGyObrIcl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R73hoH1RXYjBTYiGfolpsAF"/>
        <rdfs:label>Bankruptcy and Restructuring Events</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bankruptcy and Restructuring Events</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Eventos de bancarrota y reestructuración</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Eventos de falência e reestruturação</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Eventos de quiebra y reestructuración</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Insolvenz- und Restrukturierungsereignisse</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événements de faillite et de restructuration</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירועי חד-פעמיות ומבנה מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन और पुनर्गठन घटनाएं</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产和重组事件</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産および再編イベント</skos:altLabel>
        <skos:definition>Bankruptcy and Restructuring Events: The various legal proceedings and actions that occur during the process of bankruptcy and restructuring, including confirmation of a bankruptcy plan, asset sales, installment payments, joinder, auctions, creditor voting, initial meetings, disbursements, automatic stays, and financial management courses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBIArpOds7Q2NJALC0vvS7Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBIArpOds7Q2NJALC0vvS7Y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
        <rdfs:label>Federated Learning</rdfs:label>
        <skos:altLabel>Collaborative AI Training</skos:altLabel>
        <skos:altLabel>Decentralized Learning</skos:altLabel>
        <skos:altLabel>Distributed Machine Learning</skos:altLabel>
        <skos:altLabel>Privacy-Preserving Learning</skos:altLabel>
        <skos:definition>Federated learning is an approach to machine learning that addresses data governance and privacy concerns by enabling the collaborative training of algorithms without transferring data to a central location. In this model, each device trains on data locally and shares its local model parameters instead of sharing the training data, and different federated learning systems have various topologies for parameter sharing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBIFXKDu8dbhar4s1v98c01 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBIFXKDu8dbhar4s1v98c01">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkc9fh6vYvZbJc7ERuIJCf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R87Iipm8ZcQkj7DnCeCY5uK"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>L440 Other Trial Preparation and Support</rdfs:label>
        <skos:definition>The concept of L440 Other Trial Preparation and Support refers to activities and tasks related to trial preparation and support that do not fall under any other specific category within the broader concept of trial preparation and trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBIMYRtoYl1X28gAWrBS9z8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBIMYRtoYl1X28gAWrBS9z8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9tcJG7qZwVBNNlGIEkOy8A"/>
        <rdfs:label>Harmful Bias</rdfs:label>
        <skos:altLabel>Discriminatory Bias</skos:altLabel>
        <skos:definition>Harmful bias in an AI system refers to biases that create negative impacts, such as unfair or discriminatory outcomes. These biases can emerge from various factors, including human or system decisions across the AI lifecycle, pre-existing cultural and social biases in training data, technical limitations like non-representative data, or the use of AI systems in unanticipated contexts</skos:definition>
        <skos:prefLabel>Negative Bias</skos:prefLabel>
    </owl:Class>
    


