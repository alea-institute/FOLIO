    <!-- https://folio.openlegalstandard.org/R9vHzoqLH5KeerPLf5PkBnC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9vHzoqLH5KeerPLf5PkBnC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJM7d52FqDzFaBbtRdhECs"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWS7oVs9s2563KGt41Lsta"/>
        <rdfs:label>Equitable Tolling</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Equitable Tolling</skos:altLabel>
        <skos:altLabel xml:lang="he-il">Equitable Tolling</skos:altLabel>
        <skos:altLabel>Equitable tolling is designed to prevent unjust and technical forfeitures of rights and may delay the running of the statute of limitations in certain circumstances if a lack of prejudice to the defendant can be shown.</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gerechte Verlängerung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Prorogation équitable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prorrogação equitativa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Término de derecho estadounidense que se refiere a la suspensión del plazo de prescripción de una demanda debido a circunstancias excepcionales y equitativas.</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Término de derecho estadounidense que se refiere a la suspensión del plazo de prescripción de una demanda debido a circunstancias excepcionales y equitativas.</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इक्विटेबल टोलिंग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公平豁免</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正な時効停止</skos:altLabel>
        <skos:definition>Equitable Tolling is a legal doctrine that allows for the extension of a statute of limitations in certain circumstances to prevent unfair forfeitures of rights, provided that the defendant is not prejudiced by the delay.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9vJchiEBHNEBTJemS4uw2w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9vJchiEBHNEBTJemS4uw2w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
        <rdfs:label>Putable Asset</rdfs:label>
        <skos:altLabel>Put Option Asset</skos:altLabel>
        <skos:definition>A Putable Asset is a financial instrument that grants the holder the right to sell the asset back to the issuer at a specified price before its maturity date. This feature provides investors with the flexibility to exit the investment under certain conditions, often mitigating potential losses and reducing risk.</skos:definition>
        <skos:prefLabel>Put Option Financial Instrument</skos:prefLabel>
    </owl:Class>
    


