        <rdfs:label>Changes in Target&apos;s Industry Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cambios en el lenguaje de la industria del objetivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cambios en el lenguaje de la industria del objetivo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Changements dans la langue de l&apos;industrie cible</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Changes in Target&apos;s Industry Language</skos:altLabel>
