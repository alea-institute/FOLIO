    <!-- https://folio.openlegalstandard.org/R9CPDrfJ7JlM6AylZm3RngF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CPDrfJ7JlM6AylZm3RngF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
        <rdfs:label>Not Work Authorized</rdfs:label>
        <skos:definition>In the context of immigration law, &quot;Not Work Authorized&quot; refers to an individual who does not have the legal permission to be employed in a specific country. Under U.S. law, individuals in certain visa categories or those without legal status are considered &quot;not work authorized,&quot; and employers could face penalties for employing such individuals.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CPJK9GY42oQZFTPL3DyA1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CPJK9GY42oQZFTPL3DyA1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RA3C143EB06fcBA8f410Fd50"/>
        <rdfs:label>Michigan Circuit Court</rdfs:label>
        <skos:definition>The Michigan Circuit Court is a court of general jurisdiction in the state of Michigan that hears civil and criminal cases at the trial level.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CPTzQXRonakaswNB7cgH9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CPTzQXRonakaswNB7cgH9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9r2XYxmAiksCgeIwOht0sP"/>
        <rdfs:label>Audiobook</rdfs:label>
        <skos:altLabel>Audio Literature</skos:altLabel>
        <skos:altLabel>Narrated Book</skos:altLabel>
        <skos:altLabel>Recorded Book</skos:altLabel>
        <skos:altLabel>Spoken Book</skos:altLabel>
        <skos:definition>An Audiobook is a spoken word recording of a book or other written material, narrated and often enhanced with sound effects or music, intended for playback on digital devices, CDs, or other media. Protected under copyright law, audiobooks grant the narrators and producers exclusive rights to reproduce, distribute, and publicly perform the recorded content.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CPxIWpjoDhSn7CTzkpcB5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CPxIWpjoDhSn7CTzkpcB5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBfGu0dj7U3Vhx97y84qzKq"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDYUxkPiLp2EZ5uutWcTC0I"/>
        <rdfs:label>Motion to Compel Response</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Erzwingung einer Antwort</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Obligar una Respuesta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Obligar una Respuesta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Compel Response to Disclosure Request</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para compelir resposta</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de contraindre une réponse</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לכפיית תגובה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जवाब देने के लिए बल देने की याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">回答強制執行請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制回应动议</skos:altLabel>
        <skos:definition>A Motion to Compel Response is a formal request made to a court to require the opposing party to provide a response to a discovery request that has been previously made and not answered.</skos:definition>
        <skos:prefLabel>Motion to Compel Response to Discovery</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CVPHajerdkWrt3R77smqg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CVPHajerdkWrt3R77smqg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZm4akQHkbU4y4YWTSSjrO"/>
        <rdfs:label>Interjurisdictional Child Custody and Jurisdiction Claim</rdfs:label>
        <skos:altLabel>UCCJEA Claim</skos:altLabel>
        <skos:definition>An Interjurisdictional Child Custody and Jurisdiction Claim pertains to legal proceedings in cases involving child custody and which state&apos;s court has authority to make custody decisions. When parents live in different states, jurisdictional rules defined by the Uniform Child Custody Jurisdiction and Enforcement Act (UCCJEA) or other relevant laws determine which state&apos;s court can handle the custody case. These claims are essential in ensuring that custody disputes are resolved appropriately and in compliance with interstate legal frameworks.</skos:definition>
        <skos:prefLabel>Interstate Child Custody and Jurisdiction Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CVzEeaWrAlqPlPGv5TPjl -->

