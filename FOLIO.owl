        <skos:altLabel xml:lang="es-es">Fraude Postal Federal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fraude Postal Federal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fraude postal federal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fraude postale fédérale</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הונאת דואר פדרלית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फेडरल मेल धोखाधड़ी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">联邦邮件欺诈</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">連邦郵便詐欺</skos:altLabel>
        <skos:definition>The concept of Federal Mail Fraud refers to a criminal act of using the United States Postal Service or other interstate mail carrier to carry out a fraudulent scheme or plan with the intent to deceive or defraud another person or entity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Zfrb3QY4Pk4E7DQnFEpyZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Zfrb3QY4Pk4E7DQnFEpyZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7fCP2EQY8XQ5fxqiYaKPQA"/>
        <rdfs:label>Hate Speech</rdfs:label>
        <skos:altLabel>Incendiary Speech</skos:altLabel>
        <skos:definition>Hate Speech refers to communication, whether spoken, written, or behavioral, that attacks or discriminates against a person or group based on attributes such as race, religion, ethnicity, sexual orientation, disability, or gender. This type of speech is intended to incite hatred, violence, or prejudice against the targeted group and is often subject to legal restrictions and penalties.</skos:definition>
        <skos:example>A public speech inciting violence against a minority ethnic group, resulting in legal action for inciting racial hatred.</skos:example>
        <skos:example>Social media posts that demean and spread false information about a religious community, leading to platform bans and legal repercussions.</skos:example>
    </owl:Class>
    


