        <skos:altLabel xml:lang="es-es">Evento Interviniente - Razonablemente Previsible en la Firma</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento Interviniente - Razonablemente Previsible en la Firma</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intervening Event - Reasonable Foreseeable at Signing</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement intervenant - Raisonnablement prévisible lors de la signature</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירוע מתערב - ניתן לצפות בו בצורה סבירה בעת החתימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हस्ताक्षर करने पर संभावित तर्कसंगत घटना - विधिगत</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">介入するイベント-署名時に合理的に予見可能</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">干预事件 - 在签署时合理可预见</skos:altLabel>
        <skos:definition>An &quot;Intervening Event - Reasonable Foreseeable at Signing&quot; refers to a circumstance that occurs after the signing of a legal agreement, which was reasonably foreseeable at the time of signing and may affect the terms of the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Qj3vVE60T2ayHgCD8V4S0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Qj3vVE60T2ayHgCD8V4S0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7qicnAOVCTYIaiJHt9KmIy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RNVukeUKKKNxWuboyhfRlO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Blood Test</rdfs:label>
        <skos:definition>A Blood Test is a medical procedure where a sample of blood is taken from an individual&apos;s body, typically from a vein in the arm, to be analyzed for various purposes. These purposes can range from assessing general health, detecting diseases and infections, to evaluating organ function or checking for specific conditions like anemia or diabetes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Qlu8j6378wRwqtVUxZJFg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Qlu8j6378wRwqtVUxZJFg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89ziIl0nXs5c4ONtS7qXTP"/>
        <rdfs:label>Public Information</rdfs:label>
        <skos:altLabel>Open Information</skos:altLabel>
        <skos:altLabel>Publicly Accessible Data</skos:altLabel>
        <skos:altLabel>Unrestricted Information</skos:altLabel>
        <skos:definition>Public Information refers to information that is openly available to anyone and does not require any form of authorization or clearance for access. This type of information is intended for widespread dissemination and does not necessarily pose a risk of harm to the organization (e.g., company, nonprofit, nation) if disclosed.</skos:definition>
        <skos:prefLabel>Publicly Available Information</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QpNAiaNNvHJkLDYV01x3P -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8QpNAiaNNvHJkLDYV01x3P">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3SDQBy4KfjSgp3bgpb4Fx"/>
        <rdfs:label>Gifts Causa Mortis</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Doações Causa Mortis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Donaciones Causa Mortis</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Donaciones Causa Mortis</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dons Causa Mortis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Gifts Causa Mortis</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Todesfallgeschenke</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מתנות קוזה מורטיס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मृत्यु के कारण उपहार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">死亡原因礼物</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">死因贈与</skos:altLabel>
        <skos:definition>A gift causa mortis is a transfer of property made by a person who is anticipating their imminent death, and is made with the expectation that the gift will only take effect if the donor dies from the illness or peril that they are facing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QtE84BGxDxytWklafIHdM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8QtE84BGxDxytWklafIHdM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
        <dc:source>Fed. R. Evid. 601</dc:source>
        <rdfs:label>Lack of Competency Objection</rdfs:label>
        <skos:altLabel>Inadequate Expertise Objection</skos:altLabel>
        <skos:altLabel>Incompetence Objection</skos:altLabel>
        <skos:altLabel>Insufficient Qualifications Objection</skos:altLabel>
        <skos:altLabel>Lacks Competency Objection</skos:altLabel>
        <skos:altLabel>Objection to Unqualified Witness Testimony</skos:altLabel>
        <skos:definition>A Lack of Competency Objection is raised when a party in a legal proceeding believes that a witness does not possess the necessary qualifications, knowledge, or mental capacity to provide reliable testimony. This objection aims to ensure that testimony is provided only by individuals who are deemed competent to testify under the law.</skos:definition>
        <skos:prefLabel>Lack of Memory Objection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8R1yLVmTPfF0G3vYNkwCUr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8R1yLVmTPfF0G3vYNkwCUr">
