    <!-- https://folio.openlegalstandard.org/RCtVfpt9Z1mctdNNYHgbCAv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCtVfpt9Z1mctdNNYHgbCAv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_11"/>
        <rdfs:label>Post-Polio Syndrome</rdfs:label>
        <skos:altLabel>Late Sequelae of Polio</skos:altLabel>
        <skos:altLabel>Post-Poliomyelitis Sequelae</skos:altLabel>
        <skos:definition>Post-Polio Syndrome (PPS) is a condition that affects polio survivors years after recovery from the initial poliomyelitis infection. It is characterized by new or worsening muscle weakness, fatigue, and pain, often developing 15 to 40 years after the original polio illness.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCtVq1uma9QpsVZHKZuLBkJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCtVq1uma9QpsVZHKZuLBkJ">
