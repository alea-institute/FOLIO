        <skos:altLabel xml:lang="ja-jp">生存条項</skos:altLabel>
        <skos:definition>A Survivability Clause is a provision in a contract that specifies which obligations and rights of the parties will continue to be in effect after the termination or expiration of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rh1ZmkKI6R73nnYwrfXJ8C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rh1ZmkKI6R73nnYwrfXJ8C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sIRvD8VHcXHmMNAc5QUlC"/>
        <rdfs:label>Beans</rdfs:label>
        <skos:altLabel>Leguminous Seeds</skos:altLabel>
        <skos:definition>Beans are seeds from various species of the legume family (Fabaceae), known for their high protein, fiber, and nutrient content. They are consumed worldwide in a variety of culinary applications and are valued for their ability to improve soil fertility through nitrogen fixation.</skos:definition>
    </owl:Class>
    


