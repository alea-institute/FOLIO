        <rdfs:label>Clear and Convincing Evidence</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Clear and Convincing Evidence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klare und überzeugende Beweise</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Preuve claire et convaincante</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prova clara e convincente</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Prueba clara y convincente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Prueba clara y convincente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ראיות ברורות ומשכנעות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्पष्ट और प्रभावशाली साक्ष्य</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">明确有力的证据</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">明確かつ説得力のある証拠</skos:altLabel>
        <skos:definition>Clear and Convincing Evidence is a standard of proof that requires evidence to be highly and substantially more probable to be true than not, and leaves no serious or substantial doubt in the mind of the factfinder.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rnjzm9w9RiDAQij6gPrM5w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rnjzm9w9RiDAQij6gPrM5w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
        <rdfs:label>&quot;&apos;Required to comply&apos; with fiduciary duties&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">&apos;Obligado a cumplir&apos; con los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">&apos;Obligado a cumplir&apos; con los deberes fiduciarios fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">&apos;Required to comply&apos; with fiduciary duties</skos:altLabel>
        <skos:altLabel xml:lang="he-il">&apos;נדרש לעמוד ב&apos; חובות פידוסיאריות</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erforderlich, um Treuepflichten zu erfüllen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Exigido para cumprir deveres fiduciários</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requis pour se conformer aux devoirs fiduciaires</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फिडुशियरी दायित्वों के साथ &apos;अनुपालन करने&apos; के लिए आवश्यक</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">受託義務を遵守する必要がある</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">需要遵守受托责任</skos:altLabel>
        <skos:definition>The concept of &quot;&apos;Required to comply&apos; with fiduciary duties&quot; Language refers to the specific language used in legal agreements, particularly in relation to No-Shop Covenants and the Fiduciary Standard, that outlines the obligation of parties to act in the best interest of their clients or beneficiaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnkhSB6O0qmb4oImr6NQcE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnkhSB6O0qmb4oImr6NQcE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>The Osage Nation</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnklbMBLuq1tIievGuBNbm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnklbMBLuq1tIievGuBNbm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RYnZ1GpjlQaMwVkwCyCss"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Intervenor Brief</rdfs:label>
        <skos:altLabel xml:lang="es-es">Escrito de Intervención</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Escrito de Intervención</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intervenor Brief</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Memorial do Interveniente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mémoire d&apos;intervention</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Stellungnahme des Intervenienten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מסמך התערבות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हस्तक्षेप ब्रीफ</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">介入者意見書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">干预人简述</skos:altLabel>
        <skos:definition>A written submission to a court by a third party who seeks to participate in a case in order to protect their interests, which is filed during the appellate stage of the proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnmmbswQcOryRPEoDnHIbC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnmmbswQcOryRPEoDnHIbC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_05"/>
        <rdfs:label>Intellectual Disorder</rdfs:label>
        <skos:altLabel>Cognitive Disability</skos:altLabel>
        <skos:altLabel>Developmental Disability</skos:altLabel>
        <skos:altLabel>Intellectual Developmental Disorder</skos:altLabel>
        <skos:altLabel>Intellectual Disability</skos:altLabel>
        <skos:altLabel>Mental Retardation (outdated)</skos:altLabel>
        <skos:definition>Intellectual Disability (ID) is a developmental disorder characterized by significant limitations in both intellectual functioning (e.g., learning, reasoning, problem-solving) and adaptive behavior (e.g., social and practical skills), originating before the age of 18. Individuals with ID may experience difficulties in daily activities and require varying levels of support to live independently. This disorder is characterized by significantly subaverage general intellectual functioning, significant deficits in current adaptive functioning, and manifestation of the disorder before age 22. Signs may include, but are not limited to, poor conceptual, social, or practical skills evident in your adaptive functioning. Disorders in this category may be described in the evidence as intellectual disability, intellectual developmental disorder, or historically used terms such as “mental retardation.”</skos:definition>
        <skos:prefLabel>Cognitive Impairment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnnJLAzGV4emQlsf4z80ci -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnnJLAzGV4emQlsf4z80ci">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rj1p7FbFSLxlWfUlSPZxhX"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCrkuhfEvrGj2ITZSLQCqYW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Expired Registration</rdfs:label>
        <skos:definition>An Expired Registration violation occurs when a vehicle is operated or parked on public roads with an expired registration tag. The individual may face penalties such as fines or impoundment of the vehicle, depending on jurisdictional laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnoxgqP0cg3orWcTt0bOTY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnoxgqP0cg3orWcTt0bOTY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RIxZRp4UxyqiBeFnokFhrA"/>
        <rdfs:label>Oranges</rdfs:label>
        <skos:altLabel>Citrus Sinensis</skos:altLabel>
        <skos:altLabel>Navel Oranges</skos:altLabel>
        <skos:definition>Oranges are sweet citrus fruits from the Citrus sinensis species, known for their vibrant orange color, juicy segments, and aromatic rind. They are widely consumed fresh, juiced, or used in culinary applications, and are valued for their high vitamin C content, antioxidants, and dietary fiber.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rnp7I2NuVr1j0OUm0UcryA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rnp7I2NuVr1j0OUm0UcryA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDK3ploePpyFDgIkSzbOCtX"/>
        <rdfs:label>Mirror Will</rdfs:label>
        <skos:altLabel>Complementary Will</skos:altLabel>
        <skos:altLabel>Matching Will</skos:altLabel>
        <skos:altLabel>Parallel Testamentary Documents</skos:altLabel>
        <skos:definition>Mirror Wills are separate but virtually identical wills made by two people, typically spouses or partners, that reflect each other&apos;s wishes. These documents contain reciprocal provisions, usually leaving everything to each other and then to agreed-upon beneficiaries, but remain legally distinct and individually revocable.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnrOyBeY7Q-SHU1oD_MSe4w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnrOyBeY7Q-SHU1oD_MSe4w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2etzY8EzTfSM3lnjARkdpg"/>
        <rdfs:label>P270 Regulatory Reviews</rdfs:label>
        <skos:definition>This task includes fact investigation/due diligence from a regulatory perspective not covered elsewhere. Includes review of agency filings (e.g., FCC, FTC, and State analogues) by a party to or the subject of the transaction or project. Also includes consumer credit reviews.</skos:definition>
        <skos:prefLabel>P270 Regulatory Reviews</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rnru8Ihfcco6PerhMz0EId -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rnru8Ihfcco6PerhMz0EId">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Full and Final Release Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de libération complète et définitive</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de liberación total y definitiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de liberación total y definitiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de liberação completa e final</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Full and Final Release Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur vollständigen und endgültigen Freistellung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שחרור מלא וסופי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्ण और अंतिम रिलीज क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">全面终止条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">完全かつ最終的な解放条項</skos:altLabel>
        <skos:definition>A Full and Final Release Clause is a provision in a contract that releases all parties from any further obligations or claims related to the subject matter of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RnuLwNuTI14dlELybEWuWD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RnuLwNuTI14dlELybEWuWD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sMcpQMoO3EOWAx73lpZ16"/>
        <rdfs:label>Hindu Religion</rdfs:label>
        <skos:altLabel>Sanatana Dharma</skos:altLabel>
        <skos:definition>The Hindu Religion, or Hinduism, is a diverse and ancient religious tradition that originated in the Indian subcontinent. It encompasses a wide range of beliefs, practices, and rituals, including the worship of multiple deities, adherence to various philosophical schools, and observance of numerous festivals and ceremonies.</skos:definition>
        <skos:example>Shaivism</skos:example>
        <skos:example>Shaktism</skos:example>
        <skos:example>Vaishnavism</skos:example>
        <skos:prefLabel>Hinduism</skos:prefLabel>
    </owl:Class>
    


