        </rdfs:subClassOf>
        <rdfs:label>Proceeding Removed</rdfs:label>
        <skos:altLabel>Case Removed</skos:altLabel>
        <skos:definition>Case Removed refers to a legal matter that has been transferred from one court to another, resulting in the case being removed from the original court&apos;s jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhgXR1QTGCoXNCPkTUgOdV -->

