        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:label>Freedom of Information Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Informationsfreiheitsgesetz</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Freedom of Information Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Acceso a la Información Pública</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Libertad de Información</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Liberdade de Informação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la liberté d&apos;information</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק חופש המידע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सूचना की आज़ादी एक्ट दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">信息自由法申请</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">情報公開請求</skos:altLabel>
        <skos:definition>A Freedom of Information Act (FOIA) Claim is a legal claim made under the FOIA statute, which allows individuals to request access to federal agency records and information.</skos:definition>
        <skos:prefLabel>FOIA Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yPMgoH5NMUuEp5UXPgmZo -->

