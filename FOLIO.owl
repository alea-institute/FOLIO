        <skos:altLabel>Creation of Reasonable Fear</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Menace de coups et blessures</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Threatened Battery Assault</skos:altLabel>
