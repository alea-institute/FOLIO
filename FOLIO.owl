        <rdfs:label>Texas County Court</rdfs:label>
        <skos:definition>A Texas County Court is a court of limited jurisdiction within the Texas State Courts system that handles civil and criminal cases at the county level.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB4wzors3lwuJhitD5uuVLS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB4wzors3lwuJhitD5uuVLS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCtVq1uma9QpsVZHKZuLBkJ"/>
        <rdfs:label>Insurance Form</rdfs:label>
        <skos:definition>An Insurance Form is a standardized document used by an insurance provider for capturing relevant information to evaluate, administer, or process an insurance policy. This could be for applications, claims, renewals, or any other insurance-related activities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB4xFS3h1kCQDdyRNn6SjMz -->

