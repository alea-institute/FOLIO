    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/B-J7lSkrQZCQo5uqOadw1Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/B-J7lSkrQZCQo5uqOadw1Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1Ba5YP8y1uxOkQF7LsVU8"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=7111"/>
        <rdfs:label>Performing Arts Companies</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in producing live presentations involving the performances of actors and actresses, singers, dancers, musical groups and artists, and other performing artists.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/B01S6KdyTYqg4DnfBk2oXg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/B01S6KdyTYqg4DnfBk2oXg">
