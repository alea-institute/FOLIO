        <rdfs:label>White Mountain Apache Tribe of the Fort Apache Reservation, Arizona</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7c3kyqYBWFm2mNaEiUdb7r -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7c3kyqYBWFm2mNaEiUdb7r">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCcONOqbeZp3iIDXbl7spOT"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RvITJ74ynBH2zCNG0vfksY"/>
        <rdfs:label>Employment Mandatory Training</rdfs:label>
        <skos:altLabel>Required Training</skos:altLabel>
        <skos:definition>Employment Mandatory Training is a compulsory educational program required by an employer to address specific skills, knowledge gaps, or compliance issues among employees. This training aims to improve performance, ensure adherence to company policies, or meet legal and regulatory requirements.</skos:definition>
        <skos:prefLabel>Compulsory Training</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7c5BcqV4pI9L9rPupIV17C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7c5BcqV4pI9L9rPupIV17C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
        <rdfs:label>Wildlife Crimes</rdfs:label>
        <skos:definition>Wildlife Crimes involve illegal activities that harm wildlife species, including poaching, trafficking, and illegal trade. These crimes violate national and international laws aimed at protecting endangered and protected species.</skos:definition>
        <skos:prefLabel>Wildlife Offenses</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7c5xnS2tbutTeFZrfsypMr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7c5xnS2tbutTeFZrfsypMr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RyP4THD1q0s9GhYijVhWuf"/>
        <rdfs:label>New York Civil Court - New York County</rdfs:label>
        <skos:definition>A court located in New York County that handles civil legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7cA2M3JFNKEs6U3BP4qDej -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7cA2M3JFNKEs6U3BP4qDej">
