        <rdfs:label>Georgia Superior Court - Tattnall County</rdfs:label>
        <skos:definition>A court of general jurisdiction in the state of Georgia that has authority over legal matters within Tattnall County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDNoThgrXS0EUafEvLbdLbU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDNoThgrXS0EUafEvLbdLbU">
