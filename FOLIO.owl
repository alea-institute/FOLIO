        <rdfs:label>190 Other Contract (PACER NoS)</rdfs:label>
        <skos:definition>Action primarily based on rights and obligations under a contract not classifiable elsewhere under the specific natures of suit under “Contract.”</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9MAmKUW0E9lsFshkR1PYdK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9MAmKUW0E9lsFshkR1PYdK">
