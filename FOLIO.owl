        <rdfs:label>Motion for Summary Adjudication</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf summarische Entscheidung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Adjudicación Sumaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Adjudicación Sumaria</skos:altLabel>
