        <skos:altLabel xml:lang="es-es">Información de contacto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Información de contacto</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Informações de contato</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kontaktinformationen</skos:altLabel>
