        <rdfs:label>New York City Court - Mechanicville</rdfs:label>
        <skos:definition>A court located in Mechanicville, New York City that has jurisdiction over legal disputes and cases related to mechanics.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hdJfF8TO1kOvUijgwk9k -->

