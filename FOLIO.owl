        <skos:altLabel xml:lang="pt-br">Cláusula de Pagamento por Serviços Prestados</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Pago por Servicios Prestados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Pago por Servicios Prestados</skos:altLabel>
