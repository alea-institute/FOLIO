            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Diplomat</rdfs:label>
        <skos:definition>A diplomat is an individual appointed by a state to conduct negotiations, represent interests, and maintain diplomatic relations with other states or international organizations. Diplomats often enjoy certain privileges and immunities under international law, which allow them to perform their duties more effectively while residing in a foreign country</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HoOEFkLqTzYCpeYoLCNo8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HoOEFkLqTzYCpeYoLCNo8">
