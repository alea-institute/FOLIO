        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Mutual Limitation of Liability Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de limitation mutuelle de responsabilité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Limitación Mutua de Responsabilidad</skos:altLabel>
