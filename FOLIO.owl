        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89e7t0wDXgx7mBu9rn271g"/>
        <rdfs:label>Constructive Eviction of Tenant</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Constructive Eviction of Tenant</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Desalojo Constructivo del Arrendatario</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Desalojo Constructivo del Inquilino</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Despejo construtivo do inquilino</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Expulsion constructive du locataire</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Konstruktive Kündigung des Mieters</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פינוי בנוי של שוכר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">किरायेदार के निर्माणात्मक उन्माद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">テナントの建設的な立ち退き</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房客的建设性驱逐</skos:altLabel>
        <skos:definition>The Constructive Eviction of Tenant is a legal concept that occurs when a landlord&apos;s actions or omissions make a rental property uninhabitable, forcing the tenant to move out, and is considered a form of Unlawful Eviction of Tenant.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8miiXZzcMCmlChCuhliRzS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8miiXZzcMCmlChCuhliRzS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KhmyuiGXDz10apLAPbLJV"/>
        <rdfs:label>AIDS</rdfs:label>
        <skos:altLabel>Immune Deficiency Syndrome</skos:altLabel>
        <skos:definition>AIDS (Acquired Immunodeficiency Syndrome) is the advanced stage of HIV infection, characterized by a severely weakened immune system due to the significant loss of CD4 cells. This condition makes the body highly susceptible to opportunistic infections and certain cancers, requiring intensive medical treatment and supportive care.</skos:definition>
        <skos:prefLabel>Acquired Immunodeficiency Syndrome</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mmaJHaK9fyr6FuVUq7VMJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mmaJHaK9fyr6FuVUq7VMJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxwfbvWrxjdHqJhrBu3RWT"/>
        <rdfs:label>Physical Elder Abuse</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Abuso físico de adultos mayores</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Abuso físico de idosos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Abuso físico de personas mayores</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Maltraitance physique des personnes âgées</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Physical Elder Abuse</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Physischer Missbrauch von älteren Menschen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התעללות פיזית בקשישים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शारीरिक बुढ़ापे का उत्पीड़न</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">老年人身体虐待</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">高齢者の身体的虐待</skos:altLabel>
        <skos:definition>Physical Elder Abuse: The intentional use of force against an elderly person that results in physical pain, injury, or impairment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8moeCg3i0lZQ5CEjooCIAY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8moeCg3i0lZQ5CEjooCIAY">
