        <rdfs:label>Electrical Patent</rdfs:label>
        <skos:altLabel>Electronic Patent</skos:altLabel>
        <skos:definition>An electrical patent is a legal protection granted to inventors of new and useful electrical inventions, such as circuits, electrical devices, and systems.</skos:definition>
        <skos:prefLabel>Electrical Engineering Patent</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCur49RAT1EIW8XTjJBYSmL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCur49RAT1EIW8XTjJBYSmL">
