        <rdfs:label>Savings Institutions and Other Depository Credit Intermediation Industry</rdfs:label>
        <skos:definition>See industry description for 522180.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/4aVTFB2KRyiXg_2OC2xxKg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/4aVTFB2KRyiXg_2OC2xxKg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_GX1xrnES226fbq1FpHXxw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=113210"/>
        <rdfs:label>Forest Nurseries and Gathering of Forest Products</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in (1) growing trees for reforestation and/or (2) gathering forest products, such as gums, barks, balsam needles, rhizomes, fibers, Spanish moss, ginseng, and truffles.</skos:definition>
    </owl:Class>
    


