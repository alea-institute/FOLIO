        <rdfs:label>B240 Tax Issues</rdfs:label>
        <skos:definition>Analyses and advice regarding tax-related issues, including the preservation of net operating loss carry forwards</skos:definition>
        <skos:prefLabel>B240 Tax Issues</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJC40G3TxG4CIj1rBvhWoF -->

