        <skos:altLabel xml:lang="ja-jp">管轄選択条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">管辖地选择条款</skos:altLabel>
        <skos:definition>A Choice of Venue Clause is a provision in a contract that specifies the location or jurisdiction where any disputes arising from the contract will be resolved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBEhnztyBTDVuAPjkFAjVzN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBEhnztyBTDVuAPjkFAjVzN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9AX4LAp7IfL4nFnLZeugyY"/>
        <rdfs:label>UK Serious Fraud Office</rdfs:label>
        <skos:altLabel>Fraud Office</skos:altLabel>
        <skos:altLabel>SFO</skos:altLabel>
        <skos:definition>The UK Serious Fraud Office is a governmental department responsible for investigating and prosecuting serious or complex fraud, bribery, and corruption. Operating independently, the SFO combines the functions of police and prosecutor to tackle high-level economic crimes affecting the United Kingdom.</skos:definition>
    </owl:Class>
    


