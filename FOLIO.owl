        <rdfs:label>Florida Circuit Court - Franklin County - 2nd Circuit Court</rdfs:label>
        <skos:definition>A court located in Franklin County, Florida that is part of the larger Florida Circuit Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMyij9l5xLR8ADhbI3BrTf -->

