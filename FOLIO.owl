        <skos:altLabel xml:lang="es-es">Acuerdo de Formación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de Formación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bildungsvereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Formation Agreement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם יצירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गठन समझौता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">培训协议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">教育契約</skos:altLabel>
        <skos:definition>A Formation Agreement is a type of legal agreement that outlines the terms and conditions of a business arrangement between parties, specifically related to the creation or formation of a new entity or venture.</skos:definition>
    </owl:Class>
    


