        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Failure to State a Cause of Action</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Failure to State a Cause of Action</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de Alegación de una Causa de Acción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Omisión de Alegar una Causa de Acción</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Omission de mentionner un fondement d&apos;action</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Omissão de Causa de Pedir</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unterlassung der Angabe eines Klagegrundes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר הצגת נגישות לתביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार्यवाही के कारण का उल्लेख न करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">原因の主張の不十分</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未说明诉因</skos:altLabel>
        <skos:definition>The failure to state a cause of action is a defense in civil litigation where the plaintiff&apos;s complaint does not contain sufficient facts to support a legal claim.</skos:definition>
        <skos:prefLabel>Failure to State a Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt7TTPXJ7WX1Jrjufs0Mdr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rt7TTPXJ7WX1Jrjufs0Mdr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8VN5tK4TtD0GqDw2NCbaLr"/>
        <rdfs:label>Beneficiary</rdfs:label>
        <skos:definition>A beneficiary is an individual or entity designated to receive benefits, assets, or proceeds from a legal matter, including those of an estate, trust, insurance policy, or other financial or legal instruments. The term is commonly used in legal and financial contexts to specify who will benefit from a particular financial arrangement or legal structure.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt7y5QJoXmShB4OEPQ8Ysl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rt7y5QJoXmShB4OEPQ8Ysl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC"/>
        <rdfs:label>Nutrition Market Segment</rdfs:label>
        <skos:definition>The nutrition market segment refers to a division of the market that is specifically targeted towards consumers who are interested in dietary and nutritional health. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek to maintain or improve their health through balanced and healthy eating habits, dietary supplements, and nutrition-focused products.</skos:definition>
        <skos:example>Allergy-Friendly Foods</skos:example>
        <skos:example>Dietary Supplements</skos:example>
        <skos:example>Gluten-Free Products</skos:example>
        <skos:example>Health Food Stores</skos:example>
        <skos:example>Nutrition Counseling Programs</skos:example>
        <skos:prefLabel>Dietary Health Market</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt9cgsg6l3EtGbkJ5yFvBP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rt9cgsg6l3EtGbkJ5yFvBP">
