        <rdfs:label>Breach of Implied Warranty of Title</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Title</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de garantía implícita de título</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de garantía implícita de título</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung des Eigentumstitels</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite de titre</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de título</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת אחריות מתיחסת לכותר משתמעת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शीर्षक की निहित वारंटी का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">暗黙の権利保証違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反隐含的所有权保证</skos:altLabel>
        <skos:definition>The Breach of Implied Warranty of Title is a legal concept that occurs when a seller of property fails to transfer clear and marketable title to the buyer, despite not making any express warranties about the title.</skos:definition>
    </owl:Class>
    


