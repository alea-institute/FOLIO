    <!-- https://folio.openlegalstandard.org/R85Imx70Iv0XY38PT8gfM6z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85Imx70Iv0XY38PT8gfM6z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7"/>
        <rdfs:label>Intracompany Transferee Petition</rdfs:label>
        <skos:definition>An Intracompany Transferee Petition, also known as an L Petition in the U.S., allows a U.S. employer to transfer an executive, manager, or employee with specialized knowledge from one of its affiliated foreign offices to an office in the U.S. This petition facilitates the entry of qualified employees under the L-1 visa category for intracompany transfers.</skos:definition>
        <skos:prefLabel>L Petition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R85KF7WOMgBk9bjFeyXU56z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85KF7WOMgBk9bjFeyXU56z">
