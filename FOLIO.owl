                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7Ur5AilEpfkfmgpJhSX73"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>U.S. House of Representatives</rdfs:label>
        <skos:altLabel>House of Congress</skos:altLabel>
        <skos:altLabel>Lower House</skos:altLabel>
        <skos:definition>The U.S. House of Representatives is the lower chamber of Congress, responsible for initiating revenue-related legislation and representing the population of the states based on proportional representation. The House exercises legislative power, oversight, and the authority to impeach federal officials.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bhPKiJf79yZ1HaV0g6wFE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bhPKiJf79yZ1HaV0g6wFE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Slovak</rdfs:label>
        <skos:altLabel xml:lang="de-de">Slowakisch</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">eslovaco</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">slovaque</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スロバキア語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">斯洛伐克语</skos:altLabel>
        <skos:definition>Slovak (Language) is a structured system of communication consisting of grammar and vocabulary used in Slovakia and by Slovak communities around the world.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bhjitWs33sxa4vxTGam27 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bhjitWs33sxa4vxTGam27">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSrukbySsHLNTSeIzryIrD"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R97apJidWmx520LzKBIhkc1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Standby Guardianship of Minor</rdfs:label>
        <skos:definition>Standby Guardianship of a Minor allows parents to designate an individual to care for their child in the event of sudden incapacity, death, immigration actions, or other unforeseen circumstances. While this arrangement permits temporary guardianship, parents retain their parental rights and can revoke the guardianship consent at any time.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bj4QiszIaV8oN4T5yWP9j -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bj4QiszIaV8oN4T5yWP9j">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Option to Renew Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;option de renouvellement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Opción de Renovación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Opción de Renovación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Opção de Renovação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Verlängerungsoption</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Option to Renew Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אפשרות לחידוש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नवीनीकरण विकल्प शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">更新オプション条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">续约条款</skos:altLabel>
        <skos:definition>An Option to Renew Clause is a provision in a contract that grants one party the right to extend the term of the agreement for an additional period of time upon the expiration of the initial term.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bkemkms5qzbbCvm5LI82V -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bkemkms5qzbbCvm5LI82V">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
        <rdfs:label>House Arrest</rdfs:label>
        <skos:altLabel xml:lang="es-es">Arresto domiciliario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Arresto domiciliario</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Assignation à résidence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hausarrest</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">House Arrest</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prisão domiciliar</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעצר בית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">घर की हिरासत</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自宅軟禁</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">软禁</skos:altLabel>
        <skos:definition>House Arrest: A criminal penalty that requires an individual to remain confined to their residence, typically with electronic monitoring, as a substitute for imprisonment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bm4SiKlSkdohR9zlNjj6Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bm4SiKlSkdohR9zlNjj6Z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI"/>
        <rdfs:label>Texas District Court - Fannin County</rdfs:label>
        <skos:definition>A court located in Fannin County, Texas that has jurisdiction over civil and criminal cases within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bqVZtzYgCgzxViZwts45b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bqVZtzYgCgzxViZwts45b">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCiwr86zmjFFCLgof7UXAiU"/>
        <dc:source rdf:resource="https://nna.jse.co.za/Help/cfi.htm"/>
        <rdfs:label>Traditional Warrant</rdfs:label>
        <skos:altLabel>Company-Issued Financial Warrant</skos:altLabel>
        <skos:altLabel>Company-Issued Warrant</skos:altLabel>
        <skos:altLabel>Equity Warrant</skos:altLabel>
        <skos:altLabel>Issuer Warrant</skos:altLabel>
        <skos:altLabel>Stock Warrant</skos:altLabel>
        <skos:definition>A Traditional Warrant is a financial instrument issued by the issuer of the underlying asset, granting the holder the right to purchase the underlying asset at a specific price within a certain period. This type of warrant provides the holder with a potential opportunity for profit if the price of the underlying asset rises above the exercise price.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9brxBQlQ4WkVgK7XOOwTca -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9brxBQlQ4WkVgK7XOOwTca">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8YfXog92OHuOj0eFmQBB4"/>
        <rdfs:label>Merkel Cell Carcinoma</rdfs:label>
        <skos:definition>Merkel cell carcinoma (MCC) is a rare and aggressive type of skin cancer that originates in the Merkel cells, which are found at the base of the epidermis and are associated with the sense of touch. It tends to grow quickly and spread to other parts of the body, requiring treatments such as surgery, radiation therapy, and chemotherapy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9btvshawtzxH6CAtLPlWkb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9btvshawtzxH6CAtLPlWkb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Loyalty Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de fidélité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de lealdade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de lealtad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de lealtad</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Loyalty Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Treueklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף נאמנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लॉयल्टी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">忠誠条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">忠诚条款</skos:altLabel>
        <skos:definition>A loyalty clause is a provision in a contract that requires one party to act in the best interest of another party and not engage in activities that may harm the other party&apos;s interests.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bu7L3xOUfbWLaHRhimQa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bu7L3xOUfbWLaHRhimQa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBl2WJxJ69U7TybdQRUInbs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Fr7Djl5US9i-GPKMBW4K7g"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Reinsurer</rdfs:label>
        <skos:definition>A reinsurer is a company that provides financial protection to insurance companies by accepting portions of their insurance liabilities. This process allows the primary insurance company to mitigate risks, ensuring that it can meet its financial obligations to policyholders even in the event of particularly large or numerous claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9bwaRU1JRhdlkHapMmsIe6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9bwaRU1JRhdlkHapMmsIe6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCxI8cqNSzWB8ZAuv6RBHmV"/>
        <rdfs:label>Proceeding Consolidated</rdfs:label>
        <skos:altLabel>Case Consolidated</skos:altLabel>
        <skos:definition>The concept of &quot;Case Consolidated&quot; refers to the legal status of a dispute where multiple cases have been combined into a single case for the purpose of efficiency and convenience in the legal process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9c0VBdLgumNtrmT90Curkb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9c0VBdLgumNtrmT90Curkb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2xwWqnYhIj0tyrPJrmege"/>
        <rdfs:label>Equity Valuation Management</rdfs:label>
        <skos:definition>Equity Valuation Management is the process of determining the value of a company&apos;s stock and managing it accordingly, within the context of Legal Point Solutions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9c14IU1B9rWkxizApLPTKz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9c14IU1B9rWkxizApLPTKz">
