        <skos:altLabel xml:lang="hi-in">खरीदार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买家</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手</skos:altLabel>
        <skos:definition>A buyer or purchaser generally means a person, company or entity contracting with a seller for services or merchandise to be provided or delivered for a named individual. In a strict legal sense, a buyer may also include someone who acquires title to something by deed, devise, execution, prescription, possession, occupancy, or escheat.</skos:definition>
        <skos:hiddenLabel>BUYR</skos:hiddenLabel>
        <skos:prefLabel>Customer</skos:prefLabel>
    </owl:Class>
    


