            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion to Certify the Class</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Zertifizierung der Klasse</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Certificar la Clase</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Certificar la Clase</skos:altLabel>
