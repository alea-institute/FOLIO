    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/4fVv-16LRdSsxCe6ZpTibw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/4fVv-16LRdSsxCe6ZpTibw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/IMG5GjCWTgeRGbpJARBXcQ"/>
