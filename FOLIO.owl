        <skos:altLabel xml:lang="es-mx">Daños por angustia emocional</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dommages-intérêts pour préjudice moral</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Emotional Distress Damages</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schmerzensgeld wegen seelischer Belastung</skos:altLabel>
