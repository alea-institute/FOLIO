        <skos:definition>A Declaratory Judgment (Claim) is a civil claim seeking a court&apos;s declaration of the parties&apos; rights and legal obligations without ordering any specific action or awarding damages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rq6neiK9deZLSfSa41jylg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rq6neiK9deZLSfSa41jylg">
