        <rdfs:label>Tonga</rdfs:label>
        <skos:altLabel xml:lang="de-de">Tonga</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tonga</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tonga</skos:altLabel>
        <skos:altLabel>Tonga Islands</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">トンガ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">汤加</skos:altLabel>
        <skos:definition>A language spoken in the Tonga Islands, characterized by its own grammar and vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ppLbcG1r1qmn9k8nklNEb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ppLbcG1r1qmn9k8nklNEb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jIR8iqxwPvaiF10RkWcgO"/>
        <rdfs:label>Improper Lay Opinion Objection</rdfs:label>
        <skos:altLabel>Inadmissible Lay Testimony Objection</skos:altLabel>
        <skos:altLabel>Objection to Unauthorized Non-Expert Opinion</skos:altLabel>
        <skos:altLabel>Unqualified Non-Expert Opinion Objection</skos:altLabel>
        <skos:definition>An Improper Lay Opinion Objection is raised when a party believes that a non-expert witness is offering an opinion without sufficient basis, exceeding the bounds of their direct perception or not aiding in understanding or determining a fact in issue (e.g., Federal Rule of Evidence 701). Lay witnesses can offer opinions if they have personal knowledge and a rational basis for their conclusions, such as describing someone&apos;s appearance without speculating on their thoughts. However, they may not testify to someone else&apos;s thoughts, specific medical conditions, or other technical matters beyond their knowledge.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7q2TONAogRMuCETWEquQUW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7q2TONAogRMuCETWEquQUW">
