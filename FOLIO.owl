        <rdfs:label>Personal Jurisdiction by Related Property Interests</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par intérêts immobiliers connexes</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Jurisdicción personal por intereses relacionados con la propiedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Jurisdicción personal por intereses relacionados con la propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por interesses relacionados à propriedade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Related Property Interests</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit durch verwandte Sachinteressen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי ענייני רכוש קשורים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संबंधित संपत्ति हितों द्वारा व्यक्तिगत अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">相关财产利益的个人管辖权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">関連財産利益による個人管轄権</skos:altLabel>
        <skos:definition>The concept of &quot;Personal Jurisdiction by Related Property Interests&quot; refers to the authority of a court to hear a case based on a defendant&apos;s connection to a particular property, such as ownership or possession, within the court&apos;s jurisdiction.</skos:definition>
    </owl:Class>
    


