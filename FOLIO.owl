        <skos:altLabel xml:lang="fr-fr">Divorce sans faute</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Divorcio sin culpa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Divorcio sin culpa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Divórcio sem culpa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No-Fault Divorce</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Scheidung ohne Verschulden</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גירושין ללא תלונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नो-फॉल्ट तलाक</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无过错离婚</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無過失離婚</skos:altLabel>
        <skos:definition>A type of divorce where neither party is required to prove fault or wrongdoing in order to obtain a divorce, but rather the marriage is dissolved due to irreconcilable differences or other specified reasons.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jIME6R6CGfg4HVobxUSt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jIME6R6CGfg4HVobxUSt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDGdgxwCGXpkY1zfT2WwGl9"/>
        <rdfs:label>Tax Credits Law</rdfs:label>
        <skos:altLabel>Tax Deduction Law</skos:altLabel>
        <skos:altLabel>Tax Incentives Law</skos:altLabel>
        <skos:definition>Tax Credits Law focuses on the rules, regulations, and application of tax credits within tax systems. It encompasses the interpretation and implementation of laws that allow taxpayers to reduce their tax liability directly through credits for various activities or circumstances deemed beneficial by the government.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jIR8iqxwPvaiF10RkWcgO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jIR8iqxwPvaiF10RkWcgO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBKBnWyBmr5Hmg5T3VdTFxL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Improper Opinion Objection</rdfs:label>
        <skos:definition>An Improper Opinion Objection is raised when a party in a legal proceeding believes that a witness is offering an opinion or conclusion that is not based on their expertise or is not permissible under the rules of evidence. This objection aims to ensure that opinions presented in court are relevant, based on proper expertise, and allowed by law.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jMPIyAf6QTkMSrGDnGYz1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jMPIyAf6QTkMSrGDnGYz1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sHH7RvjZ6aZS7ZExDpYmR"/>
        <rdfs:label>Age</rdfs:label>
        <skos:altLabel xml:lang="de-de">Alter</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Idade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Âge</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">年齢</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">年龄</skos:altLabel>
        <skos:definition>Age refers to the length of time that has elapsed since an individual&apos;s birth, typically measured in years, months, or days. In various contexts, age can be a factor in determining discrimination claims, legal rights, responsibilities, and eligibility for certain benefits or programs, such as voting, obtaining a driver&apos;s license, accessing healthcare, or participating in educational and employment opportunities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jMnS8xwAtETggvD2KgMJF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jMnS8xwAtETggvD2KgMJF">
