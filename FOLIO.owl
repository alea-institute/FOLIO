        <skos:altLabel xml:lang="es-es">Negligencia médica en medicina interna</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia médica en medicina interna</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em medicina interna</skos:altLabel>
