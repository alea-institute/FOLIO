        <skos:altLabel xml:lang="hi-in">पेयी नाम - शुल्क या व्यय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">受取人名 - 手数料または費用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">收款人姓名 - 费用或支出</skos:altLabel>
        <skos:definition>Payee Name - Fee or Expense refers to the specific details of the payment recipient and the type of payment, whether it is a fee or an expense, within the context of an engagement for legal services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSwOCeFhWxUA3fOiTvlja4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSwOCeFhWxUA3fOiTvlja4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLrqGkP9fi5OO2RhpttmVI"/>
        <rdfs:label>Government Benefits</rdfs:label>
        <skos:altLabel>Public Assistance</skos:altLabel>
        <skos:altLabel>Social Benefits</skos:altLabel>
        <skos:altLabel>State Benefits</skos:altLabel>
        <skos:definition>Government Benefits are financial assistance programs provided by the government to individuals in need, designed to support basic living expenses, healthcare, and other essential needs. These benefits include payments such as Social Security, unemployment benefits, and welfare payments, which help to ensure a safety net for the vulnerable and unemployed.</skos:definition>
    </owl:Class>
    


