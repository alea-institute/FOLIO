        <rdfs:label>Buyer Consent Not Unreasonably Delayed</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Buyer Consent Not Unreasonably Delayed</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Consentement de l&apos;acheteur non déraisonnablement retardé</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Consentimento do comprador não atrasado de forma irrazoável</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Consentimiento del comprador no retrasado de manera irrazonable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Consentimiento del comprador no retrasado de manera irrazonable</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Käufer-Einwilligung nicht unangemessen verzögert</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכמת הקונה לא יידחה באופן בלתי סביר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार की सहमति अविच्छेद्य रूप से दे दी नहीं जानी चाहिए</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方同意不得不合理延迟</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手の同意が合理的に遅れないようにする</skos:altLabel>
        <skos:definition>The concept of &quot;Buyer Consent Not Unreasonably Delayed&quot; refers to the requirement that a buyer&apos;s consent to a legal matter must be given in a timely manner, without any unnecessary or unreasonable delays.</skos:definition>
    </owl:Class>
    


