        <rdfs:label>Substantial Performance of Contract Allowing Recovery</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cumplimiento sustancial del contrato que permite la recuperación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cumplimiento sustancial del contrato que permite la recuperación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Execução substancial do contrato permitindo recuperação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Exécution substantielle du contrat permettant la récupération</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Substantial Performance of Contract Allowing Recovery</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wesentliche Vertragserfüllung mit Wiederherstellungsmöglichkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ביצוע משמעותי של החוזה המאפשר החזר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध के विशाल प्रदर्शन जो वसूली की अनुमति देता है</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">允许恢复的合同实质履行</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">回復を許可する契約の実質的な履行</skos:altLabel>
        <skos:definition>The concept of &quot;Substantial Performance of Contract Allowing Recovery&quot; refers to a legal claim that allows a party to recover damages even if they have not fully performed their contractual obligations, as long as their performance was substantial and in good faith.</skos:definition>
    </owl:Class>
    


