            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Creditors&apos; Committee Chair</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Creditors&apos; Committee Chair</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Presidente del Comité de Acreedores</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Presidente del Comité de Acreedores</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Presidente do Comitê de Credores</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Président du comité des créanciers</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorsitzender des Gläubigerausschusses</skos:altLabel>
        <skos:altLabel xml:lang="he-il">יו&quot;ר הועדה של האשראים</skos:altLabel>
