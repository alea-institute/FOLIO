        <rdfs:label>Pennsylvania Court of Common Pleas -  Dauphin County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Dauphin County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering legal proceedings in the state of Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kRX9zgxhy9wJ2cjSLKtwk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kRX9zgxhy9wJ2cjSLKtwk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L4OY7QCBEVJpav2Da6Gef"/>
        <rdfs:label>Fiscal Monopoly Profit Payment</rdfs:label>
        <skos:altLabel>Government-Controlled Profit Transfer</skos:altLabel>
        <skos:altLabel>Public Monopoly Profit Payment</skos:altLabel>
        <skos:altLabel>State Monopoly Revenue Payment</skos:altLabel>
        <skos:definition>Fiscal Monopoly Profit Payment refers to the portion of profits generated by government-controlled monopolies that is transferred to the general government or used to finance government expenditures. These profits are considered part of government revenue and are recorded when they are either transferred to the government or used to cover government expenditures.</skos:definition>
        <skos:prefLabel>Government Monopoly Profit Payment</skos:prefLabel>
        <skos:prefLabel>Profits of Fiscal Monopolies</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kRdeC3m6NEz0zOxotAueb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kRdeC3m6NEz0zOxotAueb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
        <rdfs:label>Lack of Capacity</rdfs:label>
        <skos:definition>In criminal law, a &quot;lack of capacity&quot; refers to a defendant&apos;s inability, due to mental illness, cognitive impairment, or other factors, to understand the nature and consequences of their actions or to conform their behavior to the requirements of the law. If proven, this lack of capacity can be a defense in some cases, as it may negate the defendant&apos;s criminal responsibility for the alleged actions.</skos:definition>
        <skos:prefLabel>Incompetence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kWq43BdxAFNgSpfcTPkTR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kWq43BdxAFNgSpfcTPkTR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Kannada</rdfs:label>
        <skos:altLabel xml:lang="de-de">Kannada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Kannada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Kannada</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">カンナダ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">卡纳达语</skos:altLabel>
        <skos:definition>Kannada (Language) is a structured system of communication consisting of grammar and vocabulary used in the Indian state of Karnataka and by Kannada-speaking communities around the world.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kXNc5SC2yZdt763ePWdtk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kXNc5SC2yZdt763ePWdtk">
