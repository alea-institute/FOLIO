        <rdfs:label>Stipulation to Convert Case from Chapter 13 to Chapter 7</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estipulación para convertir el caso del Capítulo 13 al Capítulo 7</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estipulación para convertir el caso del Capítulo 13 al Capítulo 7</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stipulation to Convert Case from Chapter 13 to Chapter 7</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם להמרת תיק מפרק 13 לפרק 7</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अध्याय 13 से अध्याय 7 में मामला बदलने के लिए समझौता</skos:altLabel>
        <skos:definition>A Stipulation to Convert Case from Chapter 13 to Chapter 7 is a legal agreement between a debtor and creditor that allows the debtor to change their bankruptcy case from Chapter 13 to Chapter 7.</skos:definition>
    </owl:Class>
    


