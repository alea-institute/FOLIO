        <skos:definition>See industry description for 561920.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/WOfxK3YRQUuLiPIcuhpAig -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/WOfxK3YRQUuLiPIcuhpAig">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L2shTy2cnDMS1sImF2PBy"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3343"/>
        <rdfs:label>Audio and Video Equipment Manufacturing</rdfs:label>
