        <rdfs:label>Florida Circuit Court - Hillsborough County - 13th Circuit Court</rdfs:label>
        <skos:definition>The Florida Circuit Court - Hillsborough County (13th Circuit Court) is a specific court within the Florida Circuit Court system that has jurisdiction over legal proceedings in Hillsborough County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBK5utQVzoZvBPojqtUrVZX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBK5utQVzoZvBPojqtUrVZX">
