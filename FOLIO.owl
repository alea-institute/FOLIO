        <rdfs:label>Oregon Circuit Court - Morrow County</rdfs:label>
        <skos:definition>Oregon Circuit Court - Morrow County: A specific court within the Oregon Circuit Court system that has jurisdiction over legal proceedings in Morrow County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgMu5ynvcgBz5w6ozBAgRO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgMu5ynvcgBz5w6ozBAgRO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBkzNeCV70lWNDKaIVq358i"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9PyPzEUehPGahqJymgzEgR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Canon Law</rdfs:label>
        <skos:definition>Canon Law is the body of laws and regulations developed by the Catholic Church for its own governance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgOXRVxJ9KhF9dAmoPxIaO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgOXRVxJ9KhF9dAmoPxIaO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxLV9XEaDWbDIA8N1fl2fM"/>
        <rdfs:label>Minnesota District Court - Steele County</rdfs:label>
        <skos:definition>Minnesota District Court - Steele County: A specific court within the Minnesota District Court system located in Steele County, responsible for administering legal proceedings within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgPB4rjIkAlnYP6um4QOJq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgPB4rjIkAlnYP6um4QOJq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoABbJ9kEFzmBvBSGmbAyq"/>
        <dc:source>Fed. R. Evid. 1001</dc:source>
        <dc:source>Fed. R. Evid. 1007</dc:source>
        <rdfs:label>Original Writings Objection</rdfs:label>
        <skos:altLabel>Collateral Matter Objection</skos:altLabel>
        <skos:altLabel>Duplicate Document Objection</skos:altLabel>
        <skos:altLabel>Independent Facts Objection</skos:altLabel>
        <skos:altLabel>Non-genuine Original Objection</skos:altLabel>
        <skos:altLabel>Secondary Evidence Objection</skos:altLabel>
        <skos:altLabel>Unauthentic Copy Objection</skos:altLabel>
        <skos:definition>An Original Writings Objection, also known as the Best Evidence Rule Objection, is raised when a party attempts to introduce a copy or other secondary evidence of a document when the original document is available and required. This objection asserts that the party offering the evidence must provide the original document, as it is the best evidence of its content.</skos:definition>
        <skos:prefLabel>Best Evidence Rule Objection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgTDM8gLXmYS83lryg8xV0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgTDM8gLXmYS83lryg8xV0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsQrw7ploG6C5BFKKNiJc"/>
        <rdfs:label>No Third Party Beneficiary Rights Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-reconnaissance de droits de tiers bénéficiaires</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de no derechos de beneficiarios de terceros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no derechos de beneficiarios de terceros</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não reconhecimento de direitos de terceiros beneficiários</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Keine Klausel zu Rechten von Dritten als Begünstigte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Third Party Beneficiary Rights Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ללא זכויות רווחה של צד שלישי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तीसरे पक्ष के लाभार्थी अधिकार नहीं हैं शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无第三方受益人权利条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第三者受益権条項なし</skos:altLabel>
        <skos:definition>A No Third Party Beneficiary Rights Clause is a provision in a contract that explicitly states that no third party, other than the parties involved in the contract, has any rights or benefits under the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgUkOdOjwvB2yJwL59gBUf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgUkOdOjwvB2yJwL59gBUf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t7u58Bmu2hmFFto8S64nx"/>
        <rdfs:label>Auditor</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Auditeur</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Auditor</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Auditor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Auditor</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Auditor</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wirtschaftsprüfer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רוֹאֶה חֶשְׁבּוֹנוֹת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऑडिटर</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">审计师</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">監査人</skos:altLabel>
        <skos:definition>A person who conducts audits and investigates accounting functions of a private or governmental entity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgV7EJVSCJGEILuJzCYEpz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgV7EJVSCJGEILuJzCYEpz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDa0Qu7gpJEIhpO0REOfc1p"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RdfKnWpXsG2eBmnS3oJNTF"/>
        <rdfs:label>Negotiation Sequence</rdfs:label>
        <skos:altLabel>Negotiation Iteration</skos:altLabel>
        <skos:altLabel>Negotiation Round</skos:altLabel>
        <skos:altLabel>Turn</skos:altLabel>
        <skos:definition>In the context of contract negotiations, a Contractual Turn refers to each sequential exchange or iteration in the negotiation process, typically involving the drafting, reviewing, and revising of the contract. For example, Turn 1 may involve Party A sending the initial draft of the agreement to Party B, and Turn 2 may involve Party B sending a marked-up draft back to Party A.</skos:definition>
        <skos:prefLabel>Contractual Turn</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgWPJFp3h83GkZcWfIPGC8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgWPJFp3h83GkZcWfIPGC8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sBKqCcmlK1Dw9HBvKenYy"/>
        <rdfs:label>Date Signed</rdfs:label>
        <skos:altLabel>Signing Date</skos:altLabel>
        <skos:definition>Date Signed refers to the specific calendar date on which a legal document or contract is executed by the involved parties. This date is crucial as it often marks the commencement of the document’s legal effect and the start of obligations or rights.</skos:definition>
        <skos:prefLabel>Execution Date</skos:prefLabel>
    </owl:Class>
    


