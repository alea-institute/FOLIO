            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBRNVPrymiaUPOuY1n3RDZ3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>Fed. R .Evid. 411</dc:source>
        <rdfs:label>Liability Insurance Evidence Objection</rdfs:label>
        <skos:altLabel>Insurance Coverage Evidence Objection</skos:altLabel>
        <skos:altLabel>Negligence Insurance Objection</skos:altLabel>
        <skos:altLabel>Objection to Evidence of Liability Coverage</skos:altLabel>
        <skos:definition>A Liability Insurance Evidence Objection is raised when a party in a legal proceeding believes that evidence regarding the existence or nonexistence of liability insurance is being used to suggest negligence or wrongful actions. This objection aims to prevent prejudice that may arise from the jury&apos;s knowledge of insurance coverage, ensuring that the case is decided based on the evidence of the actions themselves, not the presence or absence of insurance.</skos:definition>
    </owl:Class>
    


