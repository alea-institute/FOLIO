        <skos:altLabel xml:lang="es-mx">Jurisdicción de la materia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição da matéria</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sachliche Zuständigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Subject-Matter Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט תחום הנושא</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विषय-वस्तु अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">審判権限</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">管辖权</skos:altLabel>
        <skos:definition>Subject-Matter Jurisdiction refers to the authority of a court to hear and decide a particular type of legal dispute, based on the subject matter of the case and the laws governing it.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RetcBT4W2LB4TAp4nLPIbU -->

