    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgODi9ftdYWYOGZpao6M9M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bs2IGOdHj0EAVOmcrj2WO"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9dd6R73IfKyiskT5Jf62R7"/>
