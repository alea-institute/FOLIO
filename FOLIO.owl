        <rdfs:label>Motion to Enforce Stay</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Durchsetzung des Aufschubs</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para hacer cumplir la suspensión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para hacer cumplir la suspensión</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour faire respecter la suspension</skos:altLabel>
        <skos:altLabel>Motion to Enforce Automatic Stay</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Enforce Stay</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para fazer cumprir a suspensão</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאכיפת השהייה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रोक लगाने की याचिका को प्रभावी बनाने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制执行停留动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">滞留執行請求</skos:altLabel>
        <skos:definition>A Motion to Enforce Stay is a legal request made in bankruptcy proceedings to ensure that creditors do not take any action to collect debts from the debtor, as required by the automatic stay provision of the bankruptcy code.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBBJ63wBBDn5PiGzYqJ7yrZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBBJ63wBBDn5PiGzYqJ7yrZ">
