        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541490"/>
        <rdfs:label>Other Specialized Design Services</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in providing professional design services (except architectural, landscape architecture, engineering, interior, industrial, graphic, and computer systems design).</skos:definition>
        <skos:example>Costume design services (except independent theatrical costume designers)</skos:example>
        <skos:example>Fashion design services</skos:example>
        <skos:example>Float design services</skos:example>
        <skos:example>Jewelry design services</skos:example>
        <skos:example>Lighting design services</skos:example>
        <skos:example>Shoe design services</skos:example>
        <skos:example>Textile design services</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ql7Y7yJLSyWsEU_2OYHl4Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ql7Y7yJLSyWsEU_2OYHl4Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/AkoKQRJPSBauQVqI83j4iQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=722511"/>
        <rdfs:label>Full-Service Restaurants</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in providing food services to patrons who order and are served while seated (i.e., waiter/waitress service) and pay after eating. These establishments may provide this type of food service to patrons in combination with selling alcoholic beverages, providing carryout services, or presenting live nontheatrical entertainment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/qoPJYboFQlSF1qULFOLaEA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/qoPJYboFQlSF1qULFOLaEA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/uWOA_M6CQQaGGo4Y88CnuA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=532281"/>
        <rdfs:label>Formal Wear and Costume Rental</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in renting clothing, such as formal wear, costumes (e.g., theatrical), or other clothing (except laundered uniforms and work apparel).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/qqEeRT1-TuyKC1GqHCOp8g -->

