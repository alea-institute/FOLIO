        <rdfs:label>Key Employee Incentive Program Motion</rdfs:label>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel>KEIP</skos:altLabel>
        <skos:altLabel>KEIP Motion</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Key Employee Incentive Program Motion</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Programa de incentivo para funcionários-chave</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Programa de incentivos para empleados clave</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Programa de incentivos para empleados clave</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Programm zur Anreizierung von Schlüsselmitarbeitern</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Programme d&apos;incitation pour les employés clés</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תוכנית תגמולים למובילי מפתח תנועה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कुंजी कर्मचारी प्रोत्साहन कार्यक्रम मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">主要従業員インセンティブプログラムモーション</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">关键员工激励计划动议</skos:altLabel>
        <skos:definition>A Key Employee Incentive Program Motion (KEIP) is a request made in a bankruptcy case to provide incentives to key employees to remain with the company during the bankruptcy process.</skos:definition>
    </owl:Class>
    


