        <rdfs:label>Reckless Involuntary Manslaughter</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fahrlässige Tötung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Homicide involontaire imprudent</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Homicidio Involuntario Imprudente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Homicidio Involuntario Imprudente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Homicídio culposo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reckless Involuntary Manslaughter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רצח לא מתכוון ברשלנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लापरवाह अवश्यक हत्या</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过失杀人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">過失致死</skos:altLabel>
        <skos:definition>The unlawful killing of a person without intent, caused by a reckless disregard for human life.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwKZmUGcjAuR74XG4wWAPP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwKZmUGcjAuR74XG4wWAPP">
