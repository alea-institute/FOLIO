        <skos:altLabel xml:lang="es-es">Estipulación para Evitar un Gravamen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estipulación para Evitar un Gravamen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Estipulação para evitar o privilégio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Stipulation pour éviter le privilège</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stipulation to Avoid Lien</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzicht auf Pfandrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם למניעת שעבודה עם משכנתא</skos:altLabel>
