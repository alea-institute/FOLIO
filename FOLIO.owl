    <!-- https://folio.openlegalstandard.org/RohAeYKXr1pmALLpxYmABs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RohAeYKXr1pmALLpxYmABs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>Antitrust Representation Language</rdfs:label>
        <skos:definition>Antitrust Language refers to provisions in merger and acquisition agreements that address compliance with antitrust and competition laws. These clauses ensure that the proposed transaction does not result in anti-competitive practices or market concentration that would violate regulatory standards. They may also stipulate conditions or steps to be taken if regulatory approval is required or if there are potential antitrust concerns, such as divestitures or behavioral commitments.</skos:definition>
    </owl:Class>
    


