        <rdfs:label>Mortgage Holder Breaching Escrow Obligations</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Mortgage Holder Breaching Escrow Obligations</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Titular de hipoteca incumpliendo obligaciones de depósito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Titular de hipoteca incumpliendo obligaciones de fideicomiso</skos:altLabel>
