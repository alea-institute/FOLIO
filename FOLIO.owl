        <skos:altLabel xml:lang="es-es">Cláusula de Terminación del Contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Terminación del Contrato</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de rescisão de contrato</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kündigungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Termination of Contract Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפסקת החוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध समाप्ति धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合同终止条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約解除条項</skos:altLabel>
        <skos:definition>A Termination of Contract Clause is a provision in a contract that outlines the circumstances under which the agreement may be ended by one or both parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uY9MW34wyc3LEsvENNxak -->

