            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RFBFa05A797a0E88e0a5F580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Unfair Labor Practice Claim</rdfs:label>
        <skos:definition>An Unfair Labor Practice Claim is a legal claim filed by an individual, union, or labor organization alleging that an employer or union has engaged in activities prohibited by labor laws, such as discriminating against employees for union activities or refusing to bargain in good faith.</skos:definition>
        <skos:prefLabel>ULP Claim</skos:prefLabel>
    </owl:Class>
    


