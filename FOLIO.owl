        <rdfs:label>Financial Reporting Law</rdfs:label>
        <skos:altLabel>Accounting Standards Law</skos:altLabel>
        <skos:altLabel>Financial Disclosure Law</skos:altLabel>
        <skos:definition>Financial Reporting Law encompasses the regulations and standards governing the disclosure of financial information by entities. It ensures transparency, accuracy, and consistency in financial statements, facilitating informed decision-making by stakeholders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Xh6kVAQjF7V8TKbrDTK1f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Xh6kVAQjF7V8TKbrDTK1f">
