            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Mediation Agreement</rdfs:label>
        <skos:definition>A Mediation Agreement is a contract that parties enter into, agreeing to resolve their disputes through mediation: a process where a neutral third-party mediator assists the parties in reaching a voluntary settlement. The agreement outlines the terms of the mediation process and any resultant decisions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QBuMoK1uPFeLW0sg40CdA -->

