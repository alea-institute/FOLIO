        <skos:altLabel xml:lang="es-mx">Motivo de abuso de sucesiones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Motivo de abuso de sucessão</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Probate Reason of Abuse</skos:altLabel>
