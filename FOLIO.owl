        <skos:altLabel>Bill of Exchange</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cheque Payment</skos:altLabel>
        <skos:definition>Check Payment involves transferring funds from one party to another by writing a physical or electronic check that authorizes the withdrawal of a specific amount from the payer’s bank account. It is a paper-based method of payment but can also exist in digital formats like e-checks.</skos:definition>
    </owl:Class>
    


