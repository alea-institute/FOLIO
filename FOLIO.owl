        <skos:altLabel xml:lang="es-es">Cláusula de medidas cautelares</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de medidas cautelares</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de tutela de urgência</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Injunctive Relief Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur einstweiligen Verfügung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף רישום פקודתי</skos:altLabel>
