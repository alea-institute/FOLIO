                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RMZ6lNihK8TG4Flhco1yTy"/>
            </owl:Restriction>
