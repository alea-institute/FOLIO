        <skos:altLabel xml:lang="es-es">Subarrendatario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Subarrendatario</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sublocatário</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Subtenant</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Untermieter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שוכר משנה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपकिरायेदार</skos:altLabel>
