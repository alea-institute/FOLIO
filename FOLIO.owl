        <rdfs:label>New York Supreme Court - Cattaraugus County</rdfs:label>
        <skos:definition>The New York Supreme Court - Cattaraugus County is a court of general jurisdiction located in Cattaraugus County, New York, with authority to hear and decide legal disputes within its geographic jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RdZJlb5KMjwBivyzqy8oSW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RdZJlb5KMjwBivyzqy8oSW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R07tQM5sYugYGBPQS571s5"/>
        <dc:identifier>CIVR-POLR</dc:identifier>
        <rdfs:label>Political Rights Law</rdfs:label>
        <skos:altLabel xml:lang="de-de">Gesetz über politische Rechte</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei de Direitos Políticos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ley de Derechos Políticos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Derechos Políticos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Loi sur les droits politiques</skos:altLabel>
        <skos:altLabel>Political</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Political Rights Law</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק זכויות פוליטיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">राजनीतिक अधिकार कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">政治权利法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">政治的権利法</skos:altLabel>
        <skos:definition>Political rights include natural justice (procedural fairness) in law, such as the rights of the accused, including the right to a fair trial; due process; the right to seek redress or a legal remedy; and rights of participation in civil society and politics such as freedom of association, the right to assemble, the right to petition, the right of self-defense, and the right to vote.</skos:definition>
        <skos:hiddenLabel>POLR</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rda1ZRiT8b4PHJQncWMMaJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rda1ZRiT8b4PHJQncWMMaJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R49sp0iRvML6Mzkr06Bimd"/>
        <rdfs:label>Tortious Breach of Implied Covenant of Good Faith and Fair Dealing</rdfs:label>
        <skos:altLabel xml:lang="de-de">Vertragsbruch aus unerlaubter Handlung durch implizite Treuepflicht und fairen Umgang</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation délictuelle de l&apos;obligation implicite de bonne foi et de loyauté</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação culposa da obrigação implícita de boa-fé e lealdade</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">善意と公正な取引の暗黙の契約違反による不法行為</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反默示的善意和公平原则的侵权行为</skos:altLabel>
        <skos:definition>The Tortious Breach of Implied Covenant of Good Faith and Fair Dealing refers to a legal claim that arises when one party to a contract violates the implied duty of good faith and fair dealing, resulting in harm or damages to the other party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RdeqNhAsNWbConbs3LES52 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RdeqNhAsNWbConbs3LES52">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:label>Minimum Wage Violation Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Mindestlohnverletzung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Minimum Wage Violation Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por violación del salario mínimo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação de violação do salário mínimo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por violación del salario mínimo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de violation du salaire minimum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת שכר מינימום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यूनतम मजदूरी उल्लंघन दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">最低工资违规索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">最低賃金違反請求</skos:altLabel>
        <skos:definition>A minimum wage violation claim is a legal action initiated by an employee against their employer for not paying the required minimum wage for the work performed. The minimum wage is the lowest hourly rate that employers are legally required to pay to their employees, and the claim typically arises when an employer pays less than the applicable minimum wage rate set by federal, state, or local law, or fails to properly calculate the employee&apos;s regular rate of pay when determining minimum wage.</skos:definition>
    </owl:Class>
    


