        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=485111"/>
        <rdfs:label>Mixed Mode Transit Systems</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in operating local and suburban ground passenger transit systems using more than one mode of transport over regular routes and on regular schedules within a metropolitan area and its adjacent nonurban areas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/d10Dt8WZRmK_hxh62XpRvQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/d10Dt8WZRmK_hxh62XpRvQ">
