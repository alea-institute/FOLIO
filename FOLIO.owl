        <skos:altLabel xml:lang="ja-jp">メンデ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">门德</skos:altLabel>
        <skos:definition>Mende (Language) is a structured system of communication that belongs to the Niger-Congo language family and is primarily spoken in Sierra Leone and Liberia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBdZZfuS18u3l5YY0rChmEN -->

