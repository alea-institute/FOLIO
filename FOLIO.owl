        <rdfs:label>Miscellaneous Provisions Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de dispositions diverses</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Disposiciones Varias</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Disposiciones Varias</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Disposições Diversas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für sonstige Bestimmungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Miscellaneous Provisions Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תנאים משונים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विविध प्रावधान शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">その他の規定条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">其他条款</skos:altLabel>
        <skos:definition>A Miscellaneous Provisions Clause is a contractual clause that includes additional terms and conditions that are not covered by other clauses in the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDnIuhbbvS0zCuqfgntnzRW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDnIuhbbvS0zCuqfgntnzRW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9WRFGVqE913fnyJVUGR8Xg"/>
        <rdfs:label>Rice</rdfs:label>
        <skos:altLabel>Oryza</skos:altLabel>
        <skos:definition>Rice is a cereal crop belonging to the species Oryza sativa (Asian rice) or Oryza glaberrima (African rice), known for its edible starchy grains that are a staple food for more than half of the world&apos;s population. Cultivated primarily in flooded fields called paddies, rice provides essential carbohydrates, proteins, and vitamins, and is used in a variety of culinary dishes.</skos:definition>
    </owl:Class>
    


