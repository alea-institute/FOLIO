        <rdfs:label>Military Court</rdfs:label>
        <skos:definition>A Military Court is a specialized court within the jurisdiction of the military that has the authority to hear and decide cases involving military personnel and offenses related to military service.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7TMX2dw9IzNIC3bpUZEFRP -->

