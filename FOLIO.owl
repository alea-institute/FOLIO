        <rdfs:label>Motion to Exclude Fact Witness</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss eines Tatsachenzeugen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Excluir Testigo de Hechos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Excluir Testigo de Hechos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour exclure un témoin de fait</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Exclude Fact Witness</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Excluir Testemunha de Fato</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאפשרות הוצאת עד עדות על עובדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">याचिका तथ्य साक्षी को निकालने के लिए</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">事実証人の排除を求める請願</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除事实证人动议</skos:altLabel>
        <skos:definition>A Motion to Exclude Fact Witness is a legal request to prevent a witness from testifying in court based on the fact that their testimony is not relevant or admissible as evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsPUOLWGb8TO0FXuAuSWPO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsPUOLWGb8TO0FXuAuSWPO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Winnebago Tribe of Nebraska</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsQrw7ploG6C5BFKKNiJc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsQrw7ploG6C5BFKKNiJc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>No Third Party Beneficiaries Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-bénéficiaires tiers</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Ausência de Beneficiários Terceiros</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel über das Fehlen von Begünstigten Dritter</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无第三方受益人条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第三者受益者条項なし</skos:altLabel>
        <skos:definition>A No Third Party Beneficiaries Clause is a provision in a contract that specifies that the agreement is only between the parties involved and does not confer any rights or benefits to any third party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsUlVQxaIAflOYepmX1kjU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsUlVQxaIAflOYepmX1kjU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
        <rdfs:label>Bicyclist Liability</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftung des Fahrradfahrers</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade do ciclista</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité du cycliste</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">自行车骑行者责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自転車乗りの責任</skos:altLabel>
        <skos:definition>The legal responsibility of a person riding a bicycle for any harm or injury caused to others, as part of a claim for personal injury.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsWDLg5JUKHPw6my6QzmoU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsWDLg5JUKHPw6my6QzmoU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
        <rdfs:label>Risk Management Objective</rdfs:label>
        <skos:altLabel>Risk Mitigation Objective</skos:altLabel>
        <skos:definition>Risk Management Objective refers to a specific goal or target that an organization aims to achieve through the identification, assessment, and prioritization of potential risks and the implementation of strategies to mitigate or manage those risks.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsXFlhl3SWyKzTqYbFEOP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsXFlhl3SWyKzTqYbFEOP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsA0EjhyOEG9HBBGLsyj0G"/>
        <dc:source>Fed. R. Evid. 803(1)</dc:source>
        <rdfs:label>Present Sense Impression</rdfs:label>
        <skos:altLabel>Contemporaneous Statement</skos:altLabel>
        <skos:altLabel>Spontaneous Statement</skos:altLabel>
        <skos:definition>A Present Sense Impression is a statement describing or explaining an event or condition made while or immediately after the declarant perceived it. This hearsay exception is based on the belief that statements made in the moment, without time for reflection or fabrication, are inherently reliable.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsaH0AuQk6sV9PUheDPXBv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsaH0AuQk6sV9PUheDPXBv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDi7A9GutlkahNHpXCklGRc"/>
        <rdfs:label>International Organization Meeting Visa</rdfs:label>
        <skos:altLabel>International Conference Representative Visa</skos:altLabel>
        <skos:altLabel>Meeting Attendee Visa</skos:altLabel>
        <skos:definition>A International Organization Meeting Visa (in the U.S., a G-2 visa) is issued to representatives of recognized foreign governments traveling to the U.S. temporarily to attend meetings of designated international organizations. This visa category also includes their immediate family members.</skos:definition>
        <skos:prefLabel>G-2 Visa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDshNH0y5Y0Etqyds8qUrq2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDshNH0y5Y0Etqyds8qUrq2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI"/>
        <rdfs:label>Texas District Court - Williamson County</rdfs:label>
        <skos:definition>A Texas District Court located in Williamson County, which is a trial court of general jurisdiction in Texas, responsible for hearing civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


