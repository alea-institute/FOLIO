        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3Q1HDu5jO8nvhdbr2Uj0c"/>
        <rdfs:label>Florida Circuit Court - Bradford County - 8th Circuit Court</rdfs:label>
        <skos:definition>A court located in Bradford County, Florida that is part of the 8th Circuit Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCK2q9Berv6NhaZtuQfbzTv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCK2q9Berv6NhaZtuQfbzTv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7pZSuLowh1QRBeGOhk6zEr"/>
        <rdfs:label>Motion to Extend Time to File Bill of Costs</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung der Frist zur Einreichung der Kostenrechnung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender el plazo para presentar la liquidación de costos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour prolonger le délai de dépôt de la note de frais</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Time to File Bill of Costs</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para prorrogar o prazo para apresentação da conta de custas</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de prórroga del plazo para presentar la liquidación de costas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת הזמן להגשת חשבון עלויות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बिल ऑफ कॉस्ट फाइल करने के लिए समय बढ़ाने की मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长提交费用清单的时间动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">費用の請求書提出期限延長の申立て</skos:altLabel>
        <skos:definition>A Motion to Extend Time to File Bill of Costs is a request made to the appellate court to allow additional time beyond the original deadline for a party to submit a statement of costs incurred during the legal proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCK3CpDatAXMdSVuclvPE17 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCK3CpDatAXMdSVuclvPE17">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBdfRQ5rUdtTOqtJMbgLqSh"/>
        <rdfs:label>Hemp</rdfs:label>
        <skos:altLabel>Hemp Fiber</skos:altLabel>
        <skos:definition>Hemp is a versatile plant species cultivated for its strong and durable fibers, seeds, and oil, with applications ranging from textiles and construction to food and personal care products. Known for its environmental benefits, hemp is also used in bioplastics, paper, and as a sustainable alternative to traditional raw materials.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCKA83wC3pxWrNvsyMlmrDp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCKA83wC3pxWrNvsyMlmrDp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/REFC692441d584AA9b849464"/>
        <rdfs:label>Oregon Land Use Board of Appeals</rdfs:label>
        <skos:definition>The Oregon Land Use Board of Appeals is a specialized court within the Oregon State Courts system that hears appeals related to land use decisions made by local governments.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCKELbeNBph8a01OLRSUtBw -->

