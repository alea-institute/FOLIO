        <rdfs:label>Village of Kalskag</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCx9GuPni9uwMsDX2m5EXxB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCx9GuPni9uwMsDX2m5EXxB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
        <rdfs:label>Negligent Operation of Activity Requiring Franchise or License</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Exploitation négligente d&apos;une activité nécessitant une franchise ou une licence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fahrlässiger Betrieb einer Tätigkeit, die eine Franchise oder Lizenz erfordert</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligent Operation of Activity Requiring Franchise or License</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Operación negligente de actividad que requiere franquicia o licencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Operación negligente de actividad que requiere franquicia o licencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Operação negligente de atividade que requer franquia ou licença</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעולה שלא יסודית של פעילות הדורשת רישיון או רישיון ייצור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फ्रैंचाइज़ या लाइसेंस की आवश्यकता वाली गतिविधि के लिए लापरवाह ऑपरेशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フランチャイズまたはライセンスを必要とする活動の過失操作</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">需要特许经营或许可证的活动的疏忽操作</skos:altLabel>
        <skos:definition>Negligent Operation of Activity Requiring Franchise or License refers to a legal claim for damages resulting from the careless or reckless operation of a business or activity that requires a franchise or license to operate, such as a taxi service or a liquor store.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCxESJf8hEmdCOJRnruaFr4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCxESJf8hEmdCOJRnruaFr4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R957mHhJSapbowW1nGWXSwT"/>
        <rdfs:label>Asset Turnover Practice</rdfs:label>
        <skos:altLabel>Asset Turnover</skos:altLabel>
        <skos:altLabel>Asset Turnover Service</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Asset Turnover Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de rotation des actifs</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de rotación de activos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de rotación de activos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de giro de ativos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vermögensumschlagpraxis</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול סיבוב נכסים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एसेट टर्नओवर अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">資産回転実践</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">资产周转实践</skos:altLabel>
        <skos:definition>Asset Turnover Practice refers to the legal analysis and evaluation of a company&apos;s asset turnover ratio, which measures the efficiency of a company&apos;s use of its assets to generate revenue.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCxF1lchaeaQxEwQDoGq6J0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCxF1lchaeaQxEwQDoGq6J0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDeWjTZogrlt1XvduSP1R8s"/>
        <rdfs:label>Short-term Spousal Support</rdfs:label>
        <skos:altLabel>Temporary Alimony</skos:altLabel>
        <skos:altLabel>Temporary Maintenance</skos:altLabel>
        <skos:definition>Short-term Spousal Support, also known as temporary alimony or maintenance, is financial support paid by one spouse to the other for a limited and predefined duration. It is typically awarded during the divorce process to provide financial assistance to a lower-earning spouse until a final divorce settlement is reached or until they can achieve financial self-sufficiency. The duration and amount of short-term spousal support are determined by court orders or agreements between the parties and are designed to address immediate financial needs during the divorce proceedings.</skos:definition>
        <skos:prefLabel>Temporary Spousal Support</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCxI8cqNSzWB8ZAuv6RBHmV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCxI8cqNSzWB8ZAuv6RBHmV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rx69EnEj3H3TpcgTfUSoYx"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDFhtJuTWcY7UZGV9F5yOoA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Proceeding Status</rdfs:label>
        <skos:definition>&quot;Proceeding Status&quot; refers to the current stage or status of a legal or regulatory process, whether it&apos;s a court proceeding or a regulatory proceeding. It signifies whether the proceeding is open, closed, consolidated, inactive, or has had filing fees waived.</skos:definition>
        <skos:prefLabel>Court Case Status</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCxLE66Z39mew1tC3jMP1kn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCxLE66Z39mew1tC3jMP1kn">
