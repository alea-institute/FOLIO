        <rdfs:label>Severance Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abfindungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de séparation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de rescisão</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de separabilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de separación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Severance Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פירוד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विभाजन धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">解除条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">解雇条項</skos:altLabel>
        <skos:definition>A severance clause is a provision in a contract that outlines the terms and conditions under which the agreement may be terminated by one or both parties, typically addressing issues such as notice requirements, compensation, and benefits.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RmqysGFQ1RYW3F9lv5u3hu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RmqysGFQ1RYW3F9lv5u3hu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:label>Offering Document</rdfs:label>
        <skos:definition>An Offering Document is a comprehensive legal document provided by a company or financial entity to potential investors, detailing the terms, conditions, and risks of the investment offering. This document, often used in private placements and public offerings, includes key information such as the company&apos;s business model, financial statements, management background, and details of the security being offered.</skos:definition>
    </owl:Class>
    


