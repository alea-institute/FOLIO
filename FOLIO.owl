        <rdfs:label>Term Extension Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;extension de terme</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Extensión de Plazo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Extensión de Término</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Extensão de Prazo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Verlängerung der Frist</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Term Extension Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הארכת תקופה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शब्द विस्तार शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">期間延長条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">期限延长条款</skos:altLabel>
        <skos:definition>A Term Extension Clause is a provision in a contract that allows for the extension of the agreement beyond its original expiration date.</skos:definition>
    </owl:Class>
    


