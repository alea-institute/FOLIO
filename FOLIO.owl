        <skos:definition>The Total Tax on Fees is a subcategory of Tax Detail in the Engagement Terms ontology, referring to the complete amount of tax imposed on legal service fees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDN8CVqeiDlOeHJO8Oeltq6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDN8CVqeiDlOeHJO8Oeltq6">
