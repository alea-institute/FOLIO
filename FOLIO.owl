        <skos:altLabel xml:lang="es-mx">Principio de Limitación de Uso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Princípio da Limitação de Uso</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Prinzip der Verwendungseinschränkung</skos:altLabel>
