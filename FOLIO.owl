        <skos:altLabel xml:lang="es-mx">Cesión de Derechos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Cession de créance</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cessão de crédito</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Forderungsübertragung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transfer of Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">העברת טענה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा का स्थानांतरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">债权转让</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債権譲渡</skos:altLabel>
        <skos:definition>The Transfer of Claim is a legal document that allows a creditor to transfer their right to receive payment from a debtor to another party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8O16bYOWvNPglI4VNRpsde -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8O16bYOWvNPglI4VNRpsde">
