        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=522"/>
        <rdfs:label>Credit Intermediation and Related Activities Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bank- und Kreditwirtschaft</skos:altLabel>
        <skos:altLabel>Banking and Credit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Banking and Credit Industry</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria Bancaria y de Crédito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria Bancaria y de Crédito</skos:altLabel>
