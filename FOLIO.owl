        <rdfs:label>Malt Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing malt from barley, rye, or other grains.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fTIDLtCYS9muxX5bppBxuA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fTIDLtCYS9muxX5bppBxuA">
