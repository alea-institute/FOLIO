                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R24Fe8aF4D15b46F6031E543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD2vaiwKNk2goDk9bXXTgt1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Registered Securities</rdfs:label>
        <skos:altLabel>Recorded Securities</skos:altLabel>
        <skos:altLabel>Registered Financial Instruments</skos:altLabel>
        <skos:altLabel>Registered Instruments</skos:altLabel>
        <skos:definition>Registered Securities are financial instruments recorded in the name of the owner on the books of the issuer or the issuer&apos;s registrar. Normally, these securities can only be transferred to another owner when endorsed by the registered owner, ensuring a clear record of ownership.</skos:definition>
        <skos:prefLabel>Registered Assets</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKBHehSWDsJ1u1ZjfM2lob -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDKBHehSWDsJ1u1ZjfM2lob">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HuNkpWm24qMFuntuug6RB"/>
        <rdfs:label>Testimonial Evidence</rdfs:label>
        <skos:definition>Testimonial Evidence is a type of evidence that is presented in the form of a witness&apos;s oral or written statement under oath, which is offered to prove the truth of the matter asserted. This evidence is based on the witness&apos;s personal knowledge or experience and is subject to cross-examination by the opposing party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKBHoHNUVY6QiBEKD5TZdf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDKBHoHNUVY6QiBEKD5TZdf">
