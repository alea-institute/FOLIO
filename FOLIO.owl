        <rdfs:label>Sophisticated User of Product</rdfs:label>
        <skos:altLabel xml:lang="de-de">Erfahrener Benutzer des Produkts</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sophisticated User of Product</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Usuario sofisticado del producto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Usuario sofisticado del producto</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Usuário experiente do produto</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Utilisateur expérimenté du produit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משתמש מתקדם במוצר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्कृष्ट उत्पाद का उपयोगकर्ता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">产品熟练用户</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">製品の熟練ユーザー</skos:altLabel>
        <skos:definition>A sophisticated user of a product is a defense in product liability cases that asserts that the user had knowledge and experience with the product and therefore assumed the risk of any potential harm.</skos:definition>
    </owl:Class>
    


