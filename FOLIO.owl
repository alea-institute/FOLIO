        <skos:altLabel xml:lang="fr-fr">Rapport d&apos;état</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Relatório de status</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reporte de Estado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Status Report</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Statusbericht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דו&quot;ח מצב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्थिति रिपोर्ट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ステータスレポート</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">状态报告</skos:altLabel>
        <skos:definition>A status report is a written document that provides an update on the current state of a particular matter or situation, typically used in the context of legal proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkj6GTtRxusz974SJZt7xP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkj6GTtRxusz974SJZt7xP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8uoc2fGReblZYERcaEgDBS"/>
        <rdfs:label>Hostile Work Environment</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Ambiente de trabalho hostil</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ambiente laboral hostil</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ambiente laboral hostil</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Environnement de travail hostile</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Feindselige Arbeitsumgebung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Hostile Work Environment</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סביבת עבודה מתוחה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शत्रुतापूर्ण कार्य स्थल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">敌对工作环境</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">敵対的な職場環境</skos:altLabel>
        <skos:definition>A Hostile Work Environment is a type of work environment harassment where an employee is subjected to unwelcome and discriminatory behavior or conduct that is severe or pervasive enough to create an intimidating, hostile, or offensive work environment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkjjpRFIJCel5zDSHiNo4c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkjjpRFIJCel5zDSHiNo4c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Telugu</rdfs:label>
        <skos:altLabel xml:lang="de-de">Telugu</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">telugu</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">télougou</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">テルグ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">泰卢固语</skos:altLabel>
        <skos:definition>Telugu is a structured system of communication, consisting of grammar and vocabulary, used in legal matters, which is a member of the Language class and is primarily spoken in the Indian states of Andhra Pradesh and Telangana.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkk8gcmuzzzVELKIaofrAd -->

