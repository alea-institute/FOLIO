        <skos:altLabel xml:lang="es-mx">Presentación de documentos judiciales propuestos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Proposed Court Filings</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorgeschlagene Gerichtsunterlagen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגשת תביעה מתוכננת</skos:altLabel>
