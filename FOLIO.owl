        <skos:altLabel xml:lang="en-gb">Role in Document</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rolle im Dokument</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Rôle dans le document</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תפקיד במסמך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दस्तावेज़ में भूमिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">文件中的角色</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書内の役割</skos:altLabel>
        <skos:definition>A &quot;Role in Document&quot; is a specific position or responsibility held by an individual, such as a Filer, Editor, or Author, in relation to a legal document or matter.</skos:definition>
    </owl:Class>
    


