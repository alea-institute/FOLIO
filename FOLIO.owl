    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7WKt0VAzs1NaH3XvbaWYIZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_10"/>
        <rdfs:label>Disorders of Bone Marrow Failure</rdfs:label>
        <skos:definition>Bone Marrow Dysfunction</skos:definition>
        <skos:definition>Disorders of bone marrow failure refer to a range of conditions where the bone marrow does not produce sufficient blood cells, including red blood cells, white blood cells, and platelets. These disorders can lead to anemia, increased susceptibility to infections, and bleeding problems due to the inadequate production of these critical blood components.</skos:definition>
        <skos:prefLabel>Hematopoietic Failure</skos:prefLabel>
    </owl:Class>
    


