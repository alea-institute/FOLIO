        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332431"/>
        <rdfs:label>Metal Can Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing metal cans, lids, and ends.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/AsDGUP8kTO2Y6Vb94LiQdQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/AsDGUP8kTO2Y6Vb94LiQdQ">
