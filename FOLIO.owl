        <rdfs:label>Delaware (Lenni-Lenape)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ran9Td9F5ssMVQpnWaHKU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ran9Td9F5ssMVQpnWaHKU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Kru languages</rdfs:label>
        <skos:altLabel xml:lang="de-de">Kru-Sprachen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langues krou</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas kru</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クル語族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">克鲁语系</skos:altLabel>
        <skos:definition>The Kru languages are a group of languages that belong to the Language top-level class and are spoken by the Kru people in West Africa.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RgfP9So7I6U6ug0d6MSHA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RgfP9So7I6U6ug0d6MSHA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
        <rdfs:label>Compliance Management</rdfs:label>
        <skos:definition>Compliance Management refers to the process of ensuring that an organization adheres to all relevant laws, regulations, and industry standards.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RiXZqMydsIhwYefHH8dA6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RiXZqMydsIhwYefHH8dA6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoOnTANPIS6LCYx2SVkLJL"/>
        <rdfs:label>Trade Creditors Committee</rdfs:label>
        <skos:definition>A Trade Creditors Committee is formed primarily in bankruptcy proceedings to represent the interests of trade creditors, who are suppliers and vendors that have provided goods or services to the bankrupt entity on credit. This committee negotiates claims and settlements to ensure fair treatment and maximization of recoverable assets for its members during the reorganization or liquidation process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RmYNaBlJrTZYoBAWubnfL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RmYNaBlJrTZYoBAWubnfL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Discharge for Cause Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de licenciement pour motif</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de despido por causa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de despido por causa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de dispensa por justa causa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Discharge for Cause Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kündigungsklausel aus wichtigem Grund</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שחרור בגין סיבה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कारण के लिए डिस्चार्ज क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因原因解雇条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">正当な理由による解雇条項</skos:altLabel>
        <skos:definition>A Discharge for Cause Clause is a provision in a contract that allows one party to terminate the agreement if the other party breaches a material term or engages in specified misconduct.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ro1IJpyd8q4U0UCIK4Plg -->

