        <skos:altLabel xml:lang="es-mx">Cláusula de leyendas de acciones</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu Aktienlegenden</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stock Legends Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אגדות מניות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्टॉक लेजेंड्स क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">株式伝説条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">股票传奇条款</skos:altLabel>
        <skos:definition>A Stock Legends Clause is a provision in a contract that requires the disclosure of certain information related to the sale or transfer of securities, such as restrictions on resale or ownership.</skos:definition>
    </owl:Class>
    


