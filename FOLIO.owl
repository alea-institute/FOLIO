        <skos:altLabel xml:lang="he-il">הפרת חובת רופא</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चिकित्सक लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">医師の過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">医生疏忽</skos:altLabel>
        <skos:definition>Physician Negligence refers to the failure of a medical practitioner to provide the standard of care expected of them, resulting in harm or injury to a patient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RICvcZa71w8UKH411jzdmf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RICvcZa71w8UKH411jzdmf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDWrlAT5y1sm1PdlKJzlEwj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prosecutorial Misconduct</rdfs:label>
        <skos:definition>Prosecutorial misconduct refers to unethical or illegal actions committed by a prosecutor during a criminal case. This misconduct can include hiding evidence, making false statements, engaging in improper witness coaching, or other actions that violate a defendant&apos;s rights or the rules of legal ethics. When proven, prosecutorial misconduct can lead to the dismissal of charges, mistrial, or disciplinary action against the prosecutor.</skos:definition>
        <skos:prefLabel>Prosecutor Misconduct</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RICy8SUXTTEByxkvAQVIpE -->

