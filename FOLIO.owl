        <skos:altLabel xml:lang="pt-br">Abandono</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Aufgabe</skos:altLabel>
        <skos:altLabel>Divorce</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הַפְקָרָה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">त्याग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">放弃</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">放棄</skos:altLabel>
