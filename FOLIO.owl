        <rdfs:label>Corn Farming</rdfs:label>
        <skos:definition>See industry description for 111150.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/jg5c-R4cS86XqGCBBXdNbg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/jg5c-R4cS86XqGCBBXdNbg">
