    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/jKvjgwZ_Sy2_QGsr2tR2TQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/jKvjgwZ_Sy2_QGsr2tR2TQ">
