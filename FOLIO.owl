        <skos:altLabel>LOI</skos:altLabel>
        <skos:altLabel>Pre-Contractual Statement</skos:altLabel>
        <skos:definition>A Letter of Intent is a formal document that outlines the preliminary terms and conditions of an agreement between two or more parties. While generally not legally binding, it serves as a roadmap for future negotiations or agreements.</skos:definition>
        <skos:prefLabel>Preliminary Agreement</skos:prefLabel>
    </owl:Class>
    


