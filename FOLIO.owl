        <skos:altLabel xml:lang="es-es">Cláusula de Promoción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Promoción</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de promoção</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Förderungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Promotion Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף קידום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पदोन्नति धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">昇進条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">晋升条款</skos:altLabel>
        <skos:definition>A promotion clause is a provision in a contract that outlines the terms and conditions for an individual or entity to receive a promotion or advancement in their position or status.</skos:definition>
    </owl:Class>
    


