        <skos:altLabel xml:lang="es-es">Unidad por tarea</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Unidad por tarea</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Unidade por tarefa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unit per Task</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Unité par tâche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">יחידה למשימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टास्क प्रति इकाई</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">タスクあたりの単位</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">单位每个任务</skos:altLabel>
        <skos:definition>A &quot;Unit per Task&quot; is a type of unit used to measure the cost of a specific task or activity within a legal engagement, such as drafting a contract or attending a hearing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rb4Aaey0eiCsa2j1UthsI8 -->

