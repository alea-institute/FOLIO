        <skos:altLabel xml:lang="en-gb">Motion to Extend Time - Trial Court</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de prorrogação de prazo - Tribunal de primeira instância</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en prorogation de délai - Tribunal de première instance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de prórroga de plazo - Tribunal de juicio</skos:altLabel>
