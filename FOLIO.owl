    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6mWlc1WihUbnT7ztVcao5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm"/>
        <rdfs:label>Digestive Disorders</rdfs:label>
        <skos:altLabel>Digestive System Disorders</skos:altLabel>
        <skos:altLabel>GI Disorders</skos:altLabel>
        <skos:definition>Digestive disorders encompass a broad range of conditions affecting the digestive system, including the esophagus, stomach, intestines, liver, and pancreas. These disorders can result in significant functional limitations, impacting nutrient absorption, digestion, and overall health, and may require ongoing medical management or surgical intervention.</skos:definition>
        <skos:prefLabel>Gastrointestinal Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6muzMjHlcRf1pBVLWZkr -->

