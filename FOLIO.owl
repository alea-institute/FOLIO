        <skos:altLabel xml:lang="ja-jp">ワロン語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">瓦隆语</skos:altLabel>
        <skos:definition>A dialect of French spoken in Wallonia, Belgium.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCsgBzhoO77TRUSo5O757qS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCsgBzhoO77TRUSo5O757qS">
