        <skos:altLabel xml:lang="es-es">Acuerdo de Colaboración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de Colaboración</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Collaboration Agreement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kooperationsvereinbarung</skos:altLabel>
