        <rdfs:label>Application for Entry of Final Decree</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Eintragung des endgültigen Urteils</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Application for Entry of Final Decree</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande d&apos;inscription du jugement final</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Registro de Decisão Final</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de inscripción de sentencia definitiva</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de inscripción de sentencia firme</skos:altLabel>
