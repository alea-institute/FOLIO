        <rdfs:label>Advertising Agencies</rdfs:label>
        <skos:definition>See industry description for 541810.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/JYwsG2GBTKKgKnPalOVRgQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/JYwsG2GBTKKgKnPalOVRgQ">
