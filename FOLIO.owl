    <owl:Class rdf:about="https://folio.openlegalstandard.org/R6GdImTfvAkLWGgffIApLX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5bITZZ0taJOXwcwS314VU"/>
        <rdfs:label>Disposing Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Disposing Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de cláusula de disposición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de cláusula de disposición</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de disposição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de clause de disposition</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verfügungsklauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף השטחה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विनियोजन धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">処分条項請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">处置条款索赔</skos:altLabel>
        <skos:definition>A Disposing Clause claim refers to a legal argument based on a disposing clause within a legal document, such as a contract or will, asserting the authority or power granted to dispose of property or assets. It focuses on interpreting and applying the specific language or provision that governs the distribution, transfer, or allocation of rights or interests in the document.</skos:definition>
    </owl:Class>
    


