        <skos:altLabel xml:lang="es-mx">Cláusula de arrendamiento de forma corta</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de locação de curto prazo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kurzfristige Mietvertragsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Short Form Lease Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף השכרת טופס קצר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">छोटी फॉर्म किराया शर्त</skos:altLabel>
