        <skos:altLabel xml:lang="es-mx">Cláusula de empleo a voluntad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de emprego a qualquer momento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur freien Kündigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף עסקת עבודה לפי רצון המעסיק</skos:altLabel>
