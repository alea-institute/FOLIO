        <skos:altLabel xml:lang="pt-br">Petição de Exclusão de Documento em Liminar</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאפשר רק חלק מהמסמכים להצגה במשפט</skos:altLabel>
