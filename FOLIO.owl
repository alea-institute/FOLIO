            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Energy Infrastructure - Real Estate Asset</rdfs:label>
        <skos:altLabel>Energy Facility</skos:altLabel>
        <skos:altLabel>Energy Production Asset</skos:altLabel>
        <skos:altLabel>Power Generation Site</skos:altLabel>
        <skos:altLabel>Renewable Energy Site</skos:altLabel>
        <skos:definition>Energy Infrastructure - Real Estate Asset refers to properties and facilities used for the production, storage, and distribution of energy. This includes power plants, solar farms, wind farms, and other installations essential for generating and managing energy resources.</skos:definition>
        <skos:example>Power Plant</skos:example>
        <skos:example>Solar Farm</skos:example>
        <skos:example>Wind Farm</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R86rJJy4filVRDf9cBYXZN2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R86rJJy4filVRDf9cBYXZN2">
