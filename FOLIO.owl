        <skos:altLabel xml:lang="hi-in">केस स्थिति अपडेट पत्र</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">事件状況更新の手紙</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">案件状态更新信</skos:altLabel>
        <skos:definition>A Case Status Update Letter is a type of correspondence that provides information on the current status of a legal case, typically sent by an appellate court to the parties involved in the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsRtyiHal5LpCp4JZhZyCD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsRtyiHal5LpCp4JZhZyCD">
