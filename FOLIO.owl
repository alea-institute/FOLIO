        <skos:altLabel xml:lang="es-es">Amenazado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Amenazado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bedroht</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Menacé</skos:altLabel>
