        <skos:altLabel xml:lang="ja-jp">事実証言の実践</skos:altLabel>
        <skos:definition>Fact Deposition Practice refers to the specific practice of conducting depositions to gather factual information in a legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBpqLuV50uoz3p04nvnYYYt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBpqLuV50uoz3p04nvnYYYt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
