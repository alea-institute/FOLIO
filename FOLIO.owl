        <rdfs:label>DEPRECATED Debtor’s Fraudulent Conveyance</rdfs:label>
        <skos:definition>Deprecated in favor of Fraudulent Transfer</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYXlQz9Y11XIU520NBWsfw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYXlQz9Y11XIU520NBWsfw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
        <rdfs:label>Personal Jurisdiction by National Personal Jurisdiction</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par juridiction personnelle nationale</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Jurisdicción personal por jurisdicción personal nacional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Jurisdicción personal por jurisdicción personal nacional</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por jurisdição pessoal nacional</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by National Personal Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit nach nationalem Gerichtsstand</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי שיפוט אישי לאומי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">राष्ट्रीय व्यक्तिगत अधिकरण द्वारा व्यक्तिगत अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">国家个人管辖权的个人管辖权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">国家個人管轄権による個人管轄権</skos:altLabel>
        <skos:definition>The concept of &quot;Personal Jurisdiction by National Personal Jurisdiction&quot; refers to the authority of a court to hear a case based on a defendant&apos;s presence or activities within the country&apos;s borders, as opposed to other bases for personal jurisdiction such as consent or minimum contacts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYXueB4WkoL1GFxKIrWyQ5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYXueB4WkoL1GFxKIrWyQ5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
        <rdfs:label>Negligent Security on Property</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fahrlässige Sicherheit auf dem Grundstück</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligent Security on Property</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Segurança negligente na propriedade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Seguridad negligente en la propiedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Seguridad negligente en la propiedad</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Sécurité négligente sur la propriété</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אבטחת נכונות לא מתאימה על הנכס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संपत्ति पर लापरवाह सुरक्षा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不注意な物件のセキュリティ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">财产上的疏忽安全</skos:altLabel>
        <skos:definition>Negligent Security on Property refers to a legal claim that arises when a property owner fails to provide adequate security measures, resulting in harm or injury to a person on the property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYbjN2j0621yMG1BP0Yf81 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYbjN2j0621yMG1BP0Yf81">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Avoidant Personality Disorder</rdfs:label>
        <skos:definition>Avoidant Personality Disorder is characterized by a pervasive pattern of social inhibition, feelings of inadequacy, and hypersensitivity to negative evaluation. Individuals with this disorder typically avoid occupational activities involving significant interpersonal contact due to fears of criticism, disapproval, or rejection.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYclHzy9O5tmiWaGNxNIR8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYclHzy9O5tmiWaGNxNIR8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8OXAl4XER5P7DRJEzq7Hg7"/>
        <rdfs:label>Motion to Adjourn Settlement Conference</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Vertagung der Vergleichskonferenz</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para aplazar la conferencia de conciliación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para aplazar la conferencia de conciliación</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion de clôture de la conférence de règlement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Adjourn Settlement Conference</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de adiamento da conferência de acordo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לדחיית כנס פיצול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समाधान सम्मेलन को टालने के लिए चलान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">中止和解会议动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">和解交渉の延期申立</skos:altLabel>
        <skos:definition>A Motion to Adjourn Settlement Conference is a request made by one party to postpone or reschedule a meeting between parties aimed at resolving a legal dispute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYd9hWOC9DqwjKYvpAuddJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYd9hWOC9DqwjKYvpAuddJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Call Right Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Call Right Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de droit d&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de derecho de llamada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de derecho de llamada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de direito de chamada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kündigungsrecht-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות התקשרות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कॉल राइट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コール権条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">召回权条款</skos:altLabel>
        <skos:definition>A Call Right Clause is a provision in a contract that grants one party the right to purchase an asset or security at a specified price within a certain time frame.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYdDlq7cXsPj2kB0yDsDGF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYdDlq7cXsPj2kB0yDsDGF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSYBzf149Mi5KE0YtmpUmr"/>
        <rdfs:label>Agriculture Law</rdfs:label>
        <skos:altLabel>Agribusiness Law</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Agriculture Law</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Derecho Agrario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho Agrícola</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito Agrícola</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit agricole</skos:altLabel>
        <skos:altLabel>Farm Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Landwirtschaftsrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוקי החקלאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कृषि कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">农业法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">農業法</skos:altLabel>
        <skos:definition>Agriculture Law refers to the collection of laws and regulations that govern activities related to farming and agribusiness. It covers a broad range of matters such as land use, environmental protection, labor laws, food production and safety, animal welfare, and international trade of agricultural products.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYehmm3LZTmCeOeVsilwXH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYehmm3LZTmCeOeVsilwXH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQZfWGxOZnZAvQ3ghLRvae"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Pocket Picking Theft</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Furto de carteira</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pickpocketing</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Robo de bolsillo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Robo de carterista</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Taschendiebstahl</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vol à la tire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גניבת כיסים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पॉकेट चुराई चोरी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ポケットピッキング窃盗</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">扒窃</skos:altLabel>
        <skos:definition>The theft of articles from another person’s physical possession by stealth where the victim usually does not become immediately aware of the theft.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYfCDMTKlj1rPkaougIbI7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYfCDMTKlj1rPkaougIbI7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUBVBTCdh2Pbwc0lQCuZo9"/>
        <rdfs:label>Townhouse</rdfs:label>
        <skos:altLabel>Attached Residential Unit</skos:altLabel>
        <skos:altLabel>Row House</skos:altLabel>
        <skos:altLabel>Terrace House</skos:altLabel>
        <skos:definition>A Townhouse is a multi-story residential building that shares one or more walls with adjacent units, featuring individual entrances and often private outdoor spaces such as a patio or garden. Townhouses are typically part of a planned community or row, offering a blend of urban living and private homeownership.</skos:definition>
        <skos:prefLabel>Townhome</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYhdC2tLD6aExrszJuSLZm -->

