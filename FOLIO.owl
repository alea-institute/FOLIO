        <skos:altLabel xml:lang="de-de">Privilegien-Logbuch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Registro de privilegios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Registro de privilegios</skos:altLabel>
