        <rdfs:label>Motion/Brief Exhibit</rdfs:label>
        <skos:altLabel xml:lang="de-de">Beweisführungsschriftstück</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Exibição de petição/movimento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción/Exhibición breve</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción/Exhibición breve</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion/Brief Exhibit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pièce justificative de mouvement/requête</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה / מצגת קצרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मोशन / ब्रीफ एक्सिबिट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">モーション/ブリーフ展示</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">动议/简要陈述展示</skos:altLabel>
        <skos:definition>A Motion/Brief Exhibit is a type of Exhibit that is presented to a court or other legal authority in support of a motion or brief, typically containing evidence or arguments in favor of a particular position.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vFZmDq3YytR7qotGijkXT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vFZmDq3YytR7qotGijkXT">
