        <skos:altLabel xml:lang="en-gb">Motion for Contempt</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Desacato</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en mépris de cour</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לבית משפט על מנת להגיש תביעה</skos:altLabel>
