            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion for Jury Trial</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Geschworenenverfahren</skos:altLabel>
        <skos:altLabel>Demand for Jury Trial</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Juicio con Jurado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Juicio con Jurado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Jury Trial</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Julgamento pelo Júri</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête pour un procès devant jury</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למשפט עם לועזים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ज्यूरी ट्रायल के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">陪审团审判动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">陪審裁判の請求</skos:altLabel>
        <skos:definition>A Motion for Jury Trial is a formal request made by a party in a legal case to have a trial by jury rather than a trial by judge.</skos:definition>
        <skos:prefLabel>Jury Request</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83p0RbC6qaA2IK7dGerjye -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83p0RbC6qaA2IK7dGerjye">
