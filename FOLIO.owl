        <rdfs:label>Public Disclosure of Acquisition Disclosure</rdfs:label>
        <skos:altLabel xml:lang="es-es">Divulgación pública de divulgación de adquisición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Divulgación pública de divulgación de adquisición</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Divulgation publique des divulgations d&apos;acquisition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Divulgação pública de divulgação de aquisição</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Public Disclosure of Acquisition Disclosure</skos:altLabel>
