        <skos:altLabel xml:lang="es-mx">Moción para Compeler el Descubrimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Obligar al Descubrimiento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Compel Disclosure</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Cumprimento de Descoberta</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de contraindre la divulgation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לכפיית חשיפה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खोज को बल देने के लिए मोशन</skos:altLabel>
