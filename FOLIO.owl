        <skos:altLabel xml:lang="ja-jp">禁止令状</skos:altLabel>
        <skos:definition>A Writ of Prohibition is a legal order issued by a higher court to prevent a lower court or tribunal from exceeding its jurisdiction or acting outside the scope of its authority.</skos:definition>
    </owl:Class>
    


