                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R90NrgGaQuqXwEQv8evJNR2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion for Reaffirmation Agreement</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Bestätigung einer Vereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Acuerdo de Reafirmación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Acuerdo de Reafirmación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Reaffirmation Agreement</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour l&apos;Accord de Réaffirmation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Acordo de Reafirmação</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להסכם האימוץ מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पुनर्स्थापन समझौते के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">再確認合意の申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">重申协议动议</skos:altLabel>
        <skos:definition>A Motion for Reaffirmation Agreement is a legal request made in a bankruptcy case to reaffirm a debt that would otherwise be discharged, allowing the debtor to continue making payments on the debt.</skos:definition>
        <skos:prefLabel>Application for Reaffirmation Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8etCsd1CHh9aGsjvWAgKrR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8etCsd1CHh9aGsjvWAgKrR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Earnout Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;earnout</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de earnout</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de earnout</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula earnout</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Earnout Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Earnout-Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ארנאוט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अर्नआउट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アーノート条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">业绩补偿条款</skos:altLabel>
        <skos:definition>An earnout clause is a provision in a contract that allows for additional payments to be made based on the performance of the subject of the contract, typically a business or asset.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8evMeNsxochHY3GkdiS2As -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8evMeNsxochHY3GkdiS2As">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Compensation for Damages Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de compensation des dommages</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de compensación por daños</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de compensación por daños</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de compensação por danos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Compensation for Damages Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schadensersatzklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצוי עבור נזקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नुकसान के लिए मुआवजा धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">损害赔偿条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">損害賠償条項</skos:altLabel>
        <skos:definition>A Compensation for Damages Clause is a provision in a contract that outlines the terms and conditions for payment to be made in the event of a breach or violation of the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8exTZxE4ux82IWH1RA2EB0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8exTZxE4ux82IWH1RA2EB0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7uq2Mq8qLUybQoDhVczzZ5"/>
        <rdfs:label>Indiana Superior Court - Wells County</rdfs:label>
        <skos:definition>Indiana Superior Court - Wells County refers to a specific court within the Indiana Superior Court system that has jurisdiction over legal matters in Wells County, Indiana.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8eyrMKsBdxrPX1h0KIqExG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8eyrMKsBdxrPX1h0KIqExG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Sweeping Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de revendication globale</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur umfassenden Anspruchserhebung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Cláusula General</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula General</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula abrangente</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sweeping Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף כללי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वीपिंग क्लॉज क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">全面条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">包括的な条項主張</skos:altLabel>
        <skos:definition>A Sweeping Clause claim is a legal argument asserting that a law or action exceeds the authority granted by a broad clause in a constitution or statute, contending that it goes beyond what is expressly stated or implied. The claim challenges the constitutionality or validity of the law or action based on the interpretation that it exceeds the scope of the sweeping clause.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ezLeUxKn57GcBMnoo3Sul -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ezLeUxKn57GcBMnoo3Sul">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sUDELy5on1lYCNXZpaaRE"/>
        <rdfs:label>Transactional Deliverables</rdfs:label>
        <skos:definition>Transactional Deliverables: The specific items or outputs that are expected to be produced or provided as part of a transactional engagement scope.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8f088bmlfkWDbXdJj9nQD9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8f088bmlfkWDbXdJj9nQD9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzvtNXIrDJF8xkmOoc6JKH"/>
        <dc:identifier>LEMP-DSCE</dc:identifier>
        <rdfs:label>Employment Discrimination Law</rdfs:label>
        <skos:altLabel xml:lang="de-de">Arbeitsdiskriminierungsgesetz</skos:altLabel>
        <skos:altLabel>Employment Discrimination</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Employment Discrimination Law</skos:altLabel>
        <skos:altLabel xml:lang="en-ca">Human Rights Law</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei de Discriminação no Emprego</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ley de Discriminación Laboral</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Discriminación Laboral</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Loi sur la discrimination en matière d&apos;emploi</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק הפלילה בתחום העסקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रोजगार भेदभाव कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">就业歧视法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">雇用差別禁止法</skos:altLabel>
        <skos:definition>Law relating to protected class employment discrimination including retaliation and harassment</skos:definition>
        <skos:hiddenLabel>DSCE</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8f0duqVgrVUJnvbYp3QQwu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8f0duqVgrVUJnvbYp3QQwu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RPBEBqN3r4YqvAj19Jw9fU"/>
        <rdfs:label>M.A. (Master of Arts)</rdfs:label>
        <skos:altLabel>Master of Arts</skos:altLabel>
        <skos:definition>An M.A. (Master of Arts) is an advanced academic degree typically requiring one to two years of study beyond a bachelor&apos;s degree, often focused on humanities or social sciences. It signifies expertise and specialization in a particular field</skos:definition>
        <skos:prefLabel>M.A.</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8f4qGdjxuiQary8OBpq8W9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8f4qGdjxuiQary8OBpq8W9">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Industry and Market</rdfs:label>
        <skos:definition>Industry and markets refer to the collective sectors and segments within an economy that produce, distribute, and sell goods and services. This encompasses various industries such as agriculture, technology, and finance, as well as different market segments like luxury goods, budget services, and regional businesses</skos:definition>
