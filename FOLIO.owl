        <skos:altLabel xml:lang="es-es">Cláusula de supervivencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de supervivencia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Survivability Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Überlebensklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הישרדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जीवित रहने की शर्त</skos:altLabel>
