    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/olyubYKMS-ijBYzsgFPdEg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/olyubYKMS-ijBYzsgFPdEg">
