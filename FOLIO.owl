        <rdfs:label>B420 Restructurings</rdfs:label>
        <skos:definition>Analysis, consultation and drafting in connection with the restructuring of agreements, including financing agreements, where no bankruptcy case has been filed</skos:definition>
        <skos:prefLabel>B420 Restructurings</skos:prefLabel>
    </owl:Class>
    


