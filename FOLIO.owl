        <rdfs:label>Pueblo of Zia</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTGZhd0HEVyJY9l5ymZ2gt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBTGZhd0HEVyJY9l5ymZ2gt">
