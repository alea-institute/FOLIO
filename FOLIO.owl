        <rdfs:label>Indiana Superior Court - Jasper County</rdfs:label>
        <skos:definition>Indiana Superior Court - Jasper County refers to a specific court within the Indiana Superior Court system that has jurisdiction over legal matters in Jasper County, Indiana.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCXGOMXoLDBe0RSRTpdgHHR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCXGOMXoLDBe0RSRTpdgHHR">
