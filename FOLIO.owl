        <rdfs:label>Cosmetics, Beauty Supplies, and Perfume Retailers</rdfs:label>
        <skos:definition>See industry description for 456120.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/4nnlMdLORISJT8Hkcz6Mgg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/4nnlMdLORISJT8Hkcz6Mgg">
