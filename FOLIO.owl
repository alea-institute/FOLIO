        <skos:altLabel xml:lang="es-es">Cantidad base - Gasto</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Montant de base - Dépense</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Monto base - Gasto</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Valor Base - Despesa</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סכום בסיס - הוצאה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बेस राशि - व्यय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ベース金額 - 費用</skos:altLabel>
