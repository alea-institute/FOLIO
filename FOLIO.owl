    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d8gxYFiDIcnalCApKnt5F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d8gxYFiDIcnalCApKnt5F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDeH9slXtJOmFPiZhIzsDUg"/>
        <rdfs:label>NATO-3 Visa</rdfs:label>
        <skos:altLabel>International Military Alliance Clerical Staff Visa</skos:altLabel>
        <skos:altLabel>NATO Assistant Visa</skos:altLabel>
        <skos:altLabel>NATO Support Staff Visa</skos:altLabel>
        <skos:definition>A NATO-3 visa is issued to official clerical staff accompanying a NATO-1 visa holder, allowing them to enter the U.S. to perform their duties. This visa category includes support staff essential for the operation of NATO-1 personnel.</skos:definition>
        <skos:prefLabel>NATO Clerical Staff Visa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dE4BPmN0MCepUzKAD5umn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7dE4BPmN0MCepUzKAD5umn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rj8CP6YnshKY7MmCXaiuY1"/>
        <rdfs:label>Visa for Temporary Non-Agricultural Workers</rdfs:label>
        <skos:altLabel xml:lang="en-us">H-2B Visa</skos:altLabel>
        <skos:definition>A Temporary Non-Agricultural Workers Visa, such as the U.S. H-2B Visa, is a category of visa that permits foreign nationals to work temporarily in non-agricultural sectors of a host country. This type of visa is often used to fill temporary labor shortages in industries such as hospitality, construction, landscaping, or seasonal businesses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dIoqwvQvmYE03eXBHmcO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7dIoqwvQvmYE03eXBHmcO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
        <rdfs:label>Adjustment of Status Pending</rdfs:label>
        <skos:altLabel>AOS Pending</skos:altLabel>
        <skos:altLabel>In immigration law, &quot;Adjustment of Status Pending&quot; refers to the interim period during which an individual&apos;s application to adjust their immigration status, often from a non-immigrant to an immigrant status (permanent resident), is under review by the immigration authorities (e.g., U.S. Citizenship and Immigration Services (USCIS)). During this time, the applicant is generally authorized to remain in the destination country (e.g., U.S.) and may be eligible for work authorization and other interim benefits while awaiting a final decision</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dMopV2KulQjmsX11wqbG0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7dMopV2KulQjmsX11wqbG0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDVdjLF5bcB64xE1k3fVCV1"/>
        <rdfs:label>Unlimited Ruleset</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Conjunto de regras ilimitado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ensemble de règles illimité</skos:altLabel>
        <skos:altLabel>Rules of General Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unbegrenztes Regelwerk</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无限规则集</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無制限ルールセット</skos:altLabel>
        <skos:definition>A set of rules that applies to all cases within a particular jurisdiction, without any limitations or exceptions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dRBB6fzEje3xDDZLOaE3h -->

