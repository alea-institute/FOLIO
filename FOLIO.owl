        <rdfs:label>Virginia Supreme Court</rdfs:label>
        <skos:definition>The Virginia Supreme Court is the highest court in the state of Virginia, responsible for hearing appeals and making final decisions on legal disputes within the state&apos;s court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBdfRQ5rUdtTOqtJMbgLqSh -->

