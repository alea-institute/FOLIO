    <!-- https://folio.openlegalstandard.org/RCzlWFvfjmjFHvFcoPwlR4t -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCzlWFvfjmjFHvFcoPwlR4t">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RpiyvcnyPAZ5hygNt0zO3j"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_16"/>
        <rdfs:label>Lumbar Stenosis with Cauda Equina Compromise</rdfs:label>
        <skos:definition>Lumbar spinal stenosis resulting in compromise of the cauda equina is a condition where narrowing of the spinal canal in the lumbar region causes compression of the cauda equina, a bundle of nerve roots located at the end of the spinal cord. This compression can lead to severe symptoms such as lower back pain, numbness, weakness, and loss of bowel or bladder function.</skos:definition>
        <skos:prefLabel>Lumbar Spinal Stenosis Resulting in Compromise of the Cauda Equina</skos:prefLabel>
    </owl:Class>
    


