    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Vs3LVBAqNWZCJXCy3gd20">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
        <rdfs:label>Radiology Negligence</rdfs:label>
        <skos:altLabel xml:lang="es-es">Negligencia en Radiología</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia en Radiología</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência em radiologia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence en radiologie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Radiologie-Nachlässigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Radiology Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת זהירות ברדיולוגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रेडियोलॉजी लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">放射学疏忽</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">放射線診断の過失</skos:altLabel>
        <skos:definition>Radiology Negligence refers to a type of medical malpractice claim that arises when a radiologist fails to provide the appropriate standard of care in interpreting medical images, resulting in harm to the patient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9W0NMUyWpXHCRvgmDkBnfR -->

