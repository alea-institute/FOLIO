        <rdfs:label>Motion to Dissolve Preliminary Injunction</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Aufhebung der einstweiligen Verfügung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Disolver la Injunction Preliminar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Disolver la Injunction Preliminar</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Dissolve Preliminary Injunction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Dissolução de Injunção Preliminar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de la levée de l&apos;injonction préliminaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפירוק צו אישור זמני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रारंभिक अवरोध को विलय करने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">仮処分解除申立書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">解除初步禁令动议</skos:altLabel>
        <skos:definition>A Motion to Dissolve Preliminary Injunction is a formal request made to the court to lift a temporary court order that prohibits a party from taking certain actions until a final decision is made in the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDzPYy9bDUVld7uHMs6YtWx -->

