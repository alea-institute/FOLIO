        <rdfs:label>Landlord Indemnification Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;indemnisation du propriétaire bailleur</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización del arrendador</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización del arrendador</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de indenização do locador</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Haftungsfreistellung des Vermieters</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Landlord Indemnification Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצויי בעל הנכס</skos:altLabel>
