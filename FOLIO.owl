        <rdfs:label>Skiing Facilities</rdfs:label>
        <skos:definition>See industry description for 713920.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rCYGyonUSDWKUFsIJzZAfA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rCYGyonUSDWKUFsIJzZAfA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/q3pcMPfGTb2iqjdD1wPe5g"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=48699"/>
        <rdfs:label>All Other Pipeline Transportation</rdfs:label>
        <skos:definition>See industry description for 486990.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rFxiFFIgR0e-HtHVgb0d9Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rFxiFFIgR0e-HtHVgb0d9Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/k2PELw1fQ1Skibbx-oujJg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11119"/>
        <rdfs:label>Other Grain Farming</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in (1) growing grain(s) and/or producing grain seeds (except wheat, corn, and rice) or (2) growing a combination of grain(s) and oilseed(s) with no one grain (or family of grains) or oilseed (or family of oilseeds) accounting for one-half of the establishment&apos;s agricultural production (i.e., value of crops for market).  Combination grain(s) and oilseed(s) establishments may produce oilseed(s) and grain(s) seeds and/or grow oilseed(s) and grain(s).</skos:definition>
        <skos:example>Barley farming</skos:example>
        <skos:example>Milo farming</skos:example>
        <skos:example>Oat farming</skos:example>
        <skos:example>Oilseed and grain combination farming</skos:example>
        <skos:example>Rye farming</skos:example>
        <skos:example>Sorghum farming</skos:example>
        <skos:example>Wild rice farming</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rJxdDS7UTfiYMYYjMy0x5A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rJxdDS7UTfiYMYYjMy0x5A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/XmPn9qdqRNCrNlvwItWVMw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=322211"/>
        <rdfs:label>Corrugated and Solid Fiber Box Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in laminating purchased paper or paperboard into corrugated or solid fiber boxes and related products, such as pads, partitions, pallets, and corrugated paper without manufacturing paperboard. These boxes are generally used for shipping.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/rL76OmlVTRquklsstlOlHg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/rL76OmlVTRquklsstlOlHg">
