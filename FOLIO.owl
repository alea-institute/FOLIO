        <skos:altLabel>Autonomous Air Vehicle</skos:altLabel>
        <skos:altLabel>Remote-Controlled Aircraft</skos:altLabel>
        <skos:altLabel>UAV</skos:altLabel>
        <skos:altLabel>Unmanned Aircraft</skos:altLabel>
        <skos:definition>A Drone, or Unmanned Aerial Vehicle (UAV), is an aircraft that operates without a human pilot on board, controlled either autonomously by onboard computers or by a remote control. Drones are utilized in various fields including military operations, commercial delivery services, aerial photography, and recreational activities.</skos:definition>
        <skos:prefLabel>Unmanned Aerial Vehicle</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkjsY1yFc66NU0A4nVd7XM -->

