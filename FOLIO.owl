        <rdfs:label>Cloverdale Rancheria of Pomo Indians of California</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROUpQdhkPSoD6KqAyy7fOp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROUpQdhkPSoD6KqAyy7fOp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBI5p2rdv7JzHTtGyObrIcl"/>
        <rdfs:label>Automatic Stay</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Automatic Stay</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Automatischer Aufschub</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ficar automaticamente suspenso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Suspension automatique</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Suspensión automática</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Suspensión automática</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עצירה אוטומטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वचालित रोक</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">自动停留</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自動停止</skos:altLabel>
        <skos:definition>An Automatic Stay is a legal concept that arises in the context of bankruptcy and restructuring events, which prohibits creditors from taking certain actions against the debtor or the debtor&apos;s property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROVoteNIJhmVHBMrDVSfEX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROVoteNIJhmVHBMrDVSfEX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ihoRPcnCIxjpGoNYzMi2Y"/>
        <rdfs:label>Social Health Insurance (SHI)</rdfs:label>
        <skos:definition>Social Health Insurance is a healthcare system funded by contributions from employers and employees, rather than general taxation. This model is commonly found in European countries like Germany, and it generally offers a wide range of healthcare services to contributors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROW7qlXG8U8BEevfun7JT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROW7qlXG8U8BEevfun7JT">
