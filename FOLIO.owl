        <skos:altLabel xml:lang="es-mx">Violaciones de toque de queda, vagancia y merodeo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violations de couvre-feu, d&apos;errance et de vagabondage</skos:altLabel>
