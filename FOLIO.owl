        <rdfs:label>Lipan Apache</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJ8EngDwntEBRaXr7xm8Pj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJ8EngDwntEBRaXr7xm8Pj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCz0OhGJQscjwPvw2jQBP63"/>
        <rdfs:label>New York City Court - Jamestown</rdfs:label>
        <skos:definition>A court located in Jamestown, New York that operates under the jurisdiction of the New York City Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJ9rfob4mvVArjZbsEtoHS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJ9rfob4mvVArjZbsEtoHS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9jGsr6LEcgGQxDRMlckOMm"/>
        <rdfs:label>Non-metallic Mineral Rights</rdfs:label>
        <skos:definition>These pertain to the ownership and extraction of non-metallic minerals, such as coal, limestone, and gravel, from specific plots of land. As with metallic minerals, these rights can be leased, sold, or transferred.</skos:definition>
    </owl:Class>
    


