        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8YEKFiYkowitD7dlvVs9Dj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Limited Guardianship of Adult</rdfs:label>
        <skos:altLabel xml:lang="de-de">Begrenzte Vormundschaft für Erwachsene</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Guarda limitada de adultos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Limited Guardianship of Adult</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tutela limitada de adultos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tutela limitada de adultos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tutelle limitée des adultes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אפוטרופוס מוגבל של מבוגר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वयस्क की सीमित अभिभावकता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">成年人有限监护</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">成年後見の限定</skos:altLabel>
        <skos:definition>A Limited Guardianship of Adult is a legal arrangement where a guardian is appointed to make decisions for an adult who is unable to make decisions for themselves, but only in specific areas as determined by the court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsOpfSABvJyDKct77tAagx -->

