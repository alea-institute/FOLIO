        <rdfs:label>Lease Obligations</rdfs:label>
        <skos:definition>Lease Obligations refer to the financial and contractual responsibilities that a lessee must fulfill as part of a lease agreement. These often include timely payment of rent, adherence to maintenance and use provisions, and compliance with any terms for lease termination or renewal</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDMiMuoKB1tpvbIZ4A4PQQe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDMiMuoKB1tpvbIZ4A4PQQe">
