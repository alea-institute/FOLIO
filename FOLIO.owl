        <rdfs:label>Election Claims</rdfs:label>
        <rdfs:seeAlso>Ballot Controversies</rdfs:seeAlso>
        <skos:altLabel>Electoral Allegations</skos:altLabel>
        <skos:altLabel>Voting Disputes</skos:altLabel>
        <skos:definition>Election Claims refer to allegations or assertions made regarding the integrity, conduct, or results of an electoral process. These claims can include accusations of voter fraud, election interference, vote suppression, or procedural errors and are often investigated to ensure the fairness and legitimacy of the election.</skos:definition>
        <skos:prefLabel>Electoral Integrity Claims</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9L8for79Fum92Mnj3AXvoX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9L8for79Fum92Mnj3AXvoX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9H8B4LW9PpywsdO2cXejL9"/>
        <rdfs:label>Synchronous Broadcast Transmission</rdfs:label>
        <skos:altLabel>Live Media Transmission</skos:altLabel>
        <skos:altLabel>Live Transmission</skos:altLabel>
        <skos:altLabel>Livestreaming</skos:altLabel>
        <skos:altLabel>Real-Time Broadcast</skos:altLabel>
        <skos:altLabel>Real-Time Streaming</skos:altLabel>
        <skos:definition>A Synchronous Broadcast Transmission, also known as &quot;Live&quot; transmission, is the real-time dissemination of audio and/or video content to an audience as the events occur. This form of broadcasting includes live TV and radio, providing immediate coverage of events, news, sports, and other live performances.</skos:definition>
        <skos:prefLabel>Live Broadcast</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9L9Wx0aMach3Vcq9rgrt2w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9L9Wx0aMach3Vcq9rgrt2w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
        <rdfs:label>Data Augmentation</rdfs:label>
        <skos:altLabel>Augmented Data Generation</skos:altLabel>
        <skos:altLabel>Data Enhancement</skos:altLabel>
        <skos:altLabel>Dataset Expansion</skos:altLabel>
        <skos:definition>Data Augmentation is a technique used to enhance the size and quality of a training dataset by applying various transformations and alterations to existing data. This process helps in creating diverse training examples, which improves the robustness and performance of machine learning models.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9LAXPgIieD4a2eVmXhMGWs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9LAXPgIieD4a2eVmXhMGWs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBtDyjzrPbQyhvU5V64Irn"/>
        <rdfs:label>Bylaws</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Byelaws</skos:altLabel>
        <skos:altLabel>Company Bylaws</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Corporate Byelaws</skos:altLabel>
        <skos:definition>Bylaws are internal regulations adopted by an organization to manage its operations and procedures. They detail roles of officers, meeting protocols, and other organizational rules.</skos:definition>
        <skos:prefLabel>Corporate Bylaws</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9LBsMo1i6vrjdqZMZJ3mmq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9LBsMo1i6vrjdqZMZJ3mmq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_16"/>
        <rdfs:label>Esophagus or Stomach Cancer</rdfs:label>
        <skos:altLabel>Upper GI Tract Cancer</skos:altLabel>
        <skos:altLabel>Upper Gastrointestinal Cancer</skos:altLabel>
        <skos:definition>Esophagus or stomach cancer refers to malignant tumors that originate in the esophagus or stomach, significantly impacting the digestive system. These cancers can affect swallowing, digestion, and nutrient absorption, often requiring a combination of treatments such as surgery, chemotherapy, and radiation therapy.</skos:definition>
        <skos:prefLabel>Gastroesophageal Cancer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9LFpbbSQYInrAdT45K8jPS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9LFpbbSQYInrAdT45K8jPS">
