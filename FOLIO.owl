    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8gUF7khUy3AXeuz2SIFj6P">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Nondisturbance Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-dégradation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de no perturbación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no perturbación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não perturbação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nichtstörungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nondisturbance Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוראת חסינות מפני הפרעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नॉनडिस्टर्बेंस क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不妨害条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不干扰条款</skos:altLabel>
        <skos:definition>A Nondisturbance Clause is a provision in a contract that ensures that a tenant&apos;s rights to occupy a property will not be disturbed by a third party, such as a landlord&apos;s lender or a buyer of the property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8gVw3PYPaZJ9kce3wE60ag -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8gVw3PYPaZJ9kce3wE60ag">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Liquidated Damages Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de pénalités</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Daños y Perjuicios Liquidados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Daños y Perjuicios Liquidados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de penalidades</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Liquidated Damages Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertragsstrafenklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצויים מקובלים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लिक्विडेटेड डैमेज क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违约赔偿条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">違約金条項</skos:altLabel>
        <skos:definition>A liquidated damages clause is a provision in a contract that specifies the amount of damages that will be paid in the event of a breach of contract, where the actual damages are difficult to determine.</skos:definition>
    </owl:Class>
    


