        <skos:altLabel xml:lang="de-de">Limburgisch</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Limburguês</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リンブルフ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">林堡语</skos:altLabel>
        <skos:definition>A regional language spoken in the Limburg province of the Netherlands, Belgium, and Germany, characterized by its distinct grammar and vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBU1Gc9qX3aN9NO6DsQX5pj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBU1Gc9qX3aN9NO6DsQX5pj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVG1zLys64KOCQFR2MhzS7"/>
        <rdfs:label>European Court of Justice</rdfs:label>
        <skos:altLabel>CJEU</skos:altLabel>
        <skos:altLabel>Court of Justice of the European Union</skos:altLabel>
        <skos:altLabel>ECJ</skos:altLabel>
        <skos:definition>The European Court of Justice (ECJ) is the highest court in the European Union, tasked with interpreting EU law and ensuring its uniform application across all member states. It has the authority to settle legal disputes between EU institutions, member states, businesses, and individuals.</skos:definition>
        <skos:prefLabel>EU Court</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBU1MPZclWmAITpDAoWCKm1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBU1MPZclWmAITpDAoWCKm1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89ziIl0nXs5c4ONtS7qXTP"/>
        <dc:source rdf:resource="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf#page=401&amp;zoom=100,124,477"/>
        <rdfs:label>Confidential</rdfs:label>
        <skos:altLabel>Protected Data</skos:altLabel>
        <skos:altLabel>Restricted Information</skos:altLabel>
        <skos:altLabel>Sensitive Information</skos:altLabel>
        <skos:definition>Confidential is a security classification level used for information that requires protection because its unauthorized disclosure could cause damage to the organization (e.g., company, nation). Access to confidential information is restricted to individuals with the appropriate security clearance and a demonstrated need to know.</skos:definition>
        <skos:prefLabel>Secure Information</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBU1z7AUARMHEr7RMR6feWY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBU1z7AUARMHEr7RMR6feWY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV"/>
        <rdfs:label>Undeveloped - Real Estate Asset</rdfs:label>
        <skos:altLabel>Raw Land</skos:altLabel>
        <skos:altLabel>Undeveloped</skos:altLabel>
        <skos:altLabel>Vacant Land</skos:altLabel>
        <skos:definition>An &quot;Undeveloped Real Estate Asset&quot; refers to parcels of land that have not yet been altered or improved for specific use. The associated legal matters typically involve zoning laws, land use rights, environmental assessments, and property taxation.</skos:definition>
        <skos:prefLabel>Unimproved Property</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBU9zZzHpiivyY3EFmul3Ja -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBU9zZzHpiivyY3EFmul3Ja">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_11"/>
        <rdfs:label>Neurodevelopmental Disorders</rdfs:label>
        <skos:definition>Neurodevelopmental Disorders are characterized by onset during the developmental period, that is, during childhood or adolescence, although sometimes they are not diagnosed until adulthood. Symptoms and signs may include, but are not limited to, underlying abnormalities in cognitive processing (for example, deficits in learning and applying verbal or nonverbal information, visual perception, memory, or a combination of these); deficits in attention or impulse control; low frustration tolerance; excessive or poorly planned motor activity; difficulty with organizing (time, space, materials, or tasks); repeated accidental injury; and deficits in social skills. Symptoms and signs specific to tic disorders include sudden, rapid, recurrent, non-rhythmic, motor movement or vocalization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUBqjNCYBI4CtLUcdAVYwy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUBqjNCYBI4CtLUcdAVYwy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCYl3LbuEyYdPvG9kHxRa3a"/>
        <dc:identifier>INTPTA</dc:identifier>
        <rdfs:label>Intellectual Property Assets</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Actifs de propriété intellectuelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Activos de Propiedad Intelectual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Activos de Propiedad Intelectual</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ativos de propriedade intelectual</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geistiges Eigentum</skos:altLabel>
        <skos:altLabel>Intellectual Property</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intellectual Property Assets</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נכסי קניין רוחניים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बौद्धिक संपदा संपत्तियाँ</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">知的財産資産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">知识产权资产</skos:altLabel>
        <skos:definition>Intellectual property is a broad categorical description for the set of intangibles owned and legally protected by a company from outside use or implementation without consent. Intellectual property can consist of patents, trade secrets, copyrights, franchises, and trademarks or simply ideas.</skos:definition>
        <skos:hiddenLabel>INTPTA</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUIl9w9F1OVEwbY7I80rCX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUIl9w9F1OVEwbY7I80rCX">
