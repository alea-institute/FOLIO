        <rdfs:label>Motion for Judgment</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Urteil</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Judgment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Julgamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Recurso de Sentencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Recurso de Sentencia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en jugement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फैसले के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">判决动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決の申立て</skos:altLabel>
        <skos:definition>A Motion for Judgment is a request made by a party in a trial court asking the judge to make a decision in their favor based on the evidence presented, without the need for a trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rj3zmGrjca6Tz79Qb6VNPZ -->

