        <skos:altLabel xml:lang="ja-jp">更新オプション条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">续约选项条款</skos:altLabel>
        <skos:definition>A Renewal Option Clause is a provision in a contract that grants one or both parties the right to extend the term of the agreement for an additional period of time upon the expiration of the initial term.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R85ejLDDS4Dy9Dwr5erdBtQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85ejLDDS4Dy9Dwr5erdBtQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7VHEoDUFVEwkyvRY96BMGR"/>
        <rdfs:label>Bankruptcy Initial Routine Motions</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bankruptcy Initial Routine Motions</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones iniciales rutinarias de bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones iniciales rutinarias de quiebra</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Moções iniciais rotineiras de falência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions initiales de routine en faillite</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Routineanträge im Insolvenzverfahren</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועות רגילות ראשוניות בהתפשטות פשיטת רגל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन प्रारंभिक रूटीन मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产初始例行动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産初期のルーチンモーション</skos:altLabel>
        <skos:definition>Bankruptcy Initial Routine Motions refer to the standard motions filed at the beginning of a bankruptcy case, such as motions for relief from automatic stay or to use cash collateral, which are typically granted without a hearing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R85iYdxQksiMhbanDehHPNn -->

