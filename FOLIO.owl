        <rdfs:label>Virgin Islands Territorial Court</rdfs:label>
        <skos:definition>The Virgin Islands Territorial Court is a court system within the Virgin Islands Territory Courts that has jurisdiction over certain legal matters in the United States Virgin Islands.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDNOTESvIFXoyO4t8nSz2xD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDNOTESvIFXoyO4t8nSz2xD">
