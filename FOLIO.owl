        <rdfs:label>B200 Operations</rdfs:label>
        <skos:definition></skos:definition>
        <skos:prefLabel>B200 Operations</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YvDQ0MFsIxCp9axP8Cb2y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YvDQ0MFsIxCp9axP8Cb2y">
