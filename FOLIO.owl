        <skos:altLabel xml:lang="hi-in">लिटिगेशन दस्तावेज़ संख्या</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴訟書類番号</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">诉讼文件号</skos:altLabel>
        <skos:definition>A Litigation Document Number is a specific identifier assigned to a document related to a legal dispute, used to track and reference the document within the litigation process.</skos:definition>
    </owl:Class>
    


