        <rdfs:label>Family &amp; Parenting Market Segment</rdfs:label>
        <skos:altLabel>Family Services Market Segment</skos:altLabel>
        <skos:definition>The family &amp; parenting market segment refers to a division of the market that is specifically targeted towards consumers who are parents or caregivers, focusing on products and services that cater to the needs of families and children. This segment encompasses a wide range of offerings, from child-rearing essentials to family-oriented activities, all designed to support the well-being, development, and enjoyment of family life.</skos:definition>
        <skos:example>Adoption Market</skos:example>
        <skos:example>Daycare and Preschool Market</skos:example>
        <skos:example>Eldercare Market</skos:example>
        <skos:example>Family Entertainment Market (e.g., family movies, amusement parks)</skos:example>
        <skos:example>Parenting Resources Market (e.g., parenting books, online forums)</skos:example>
        <skos:example>Pregnancy Market</skos:example>
        <skos:example>Special Needs Market</skos:example>
        <skos:prefLabel>Parenting Products Market</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iT6lOJFRf3RRgQvWcSXdT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iT6lOJFRf3RRgQvWcSXdT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7p8xRy14cVNnXyHxD92nQk"/>
        <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
        <rdfs:label>Tutoring</rdfs:label>
        <skos:altLabel xml:lang="de-de">Nachhilfeunterricht</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tutorat</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tutoria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tutoring</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tutoría</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tutoría</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מורה פרטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्यूटोरिंग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家庭教師</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">辅导</skos:altLabel>
        <skos:definition>Tutoring refers to the provision of educational assistance or instruction by a tutor to a student, as a condition of a criminal disposition imposed on the student&apos;s parents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iUJ1YX0zK3V9D0RbQKTP4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iUJ1YX0zK3V9D0RbQKTP4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
        <rdfs:label>Equitable Relief</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Equitable Relief</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ermessensmaßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Medidas equitativas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Medidas equitativas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mesures équitables</skos:altLabel>
        <skos:altLabel>Non-Pecuniary Remedies</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Remédio equitativo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיוע משפטי הוגן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायसंगत सहायता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公平救济</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正な救済</skos:altLabel>
        <skos:definition>Equitable Relief refers to a type of legal remedy sought in civil cases that aims to provide fairness and justice to the parties involved, often through actions such as injunctions, specific performance, or rescission.</skos:definition>
        <skos:prefLabel>Equitable Damages</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iX0KAluRjh1SUSjFzLl44 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iX0KAluRjh1SUSjFzLl44">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85BLSakJPEy7c7KvxZyOe"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD22PX6hiObnrRSM3c6bXdR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RXglkHnO0P9PdVdDRHi9wJ"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Workers&apos; Compensation Court</rdfs:label>
        <skos:definition>A Workers&apos; Compensation Court is a specific type of administrative proceeding forum that handles disputes related to workers&apos; compensation claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iX9jIngIBBPMjNmKBVNtc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iX9jIngIBBPMjNmKBVNtc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMlfBHhw2Mfk0FBrVCQJY9"/>
        <rdfs:label>Whole Life Insurance</rdfs:label>
        <skos:definition>Whole life insurance is a type of permanent life insurance that provides coverage for the insured&apos;s entire lifetime. The policy includes a death benefit and typically a cash value component that grows over time, and the premiums are generally fixed and paid for the life of the policy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9igUrMQ39uK36v8plilzhG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9igUrMQ39uK36v8plilzhG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq7yrbwVSqS8fuRtnzDx6g"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7BZzP16LxkLJjYqRNwWXP"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Entertainment Law</rdfs:label>
        <skos:definition>Entertainment Law encompasses the legal services and regulations that govern the entertainment industry, including film, television, music, theater, and digital media. It deals with matters such as intellectual property, contracts, labor relations, and litigation related to entertainment activities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ihoRPcnCIxjpGoNYzMi2Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ihoRPcnCIxjpGoNYzMi2Y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCjgFvO2VxpIklnhZMbSD9k"/>
        <rdfs:label>Public Health Insurance Policy</rdfs:label>
        <skos:definition>Public health insurance is a government-sponsored program designed to provide healthcare coverage to eligible individuals or populations. Examples in the United States include Medicare, for older adults, and Medicaid, for low-income individuals. Coverage and eligibility criteria are determined by the government.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ikrznaQwm4RUsMzP9KXFR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ikrznaQwm4RUsMzP9KXFR">
