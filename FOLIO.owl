        <skos:altLabel xml:lang="en-gb">Superior Offer</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Überlegenes Angebot</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעה עליונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्कृष्ट ऑफर</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">优越报价</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">優れたオファー</skos:altLabel>
        <skos:definition>&quot;Superior Offer&quot; Language refers to the specific language used in legal matters to describe a situation where a party has made an offer that is deemed to be better than any other offers available, and may trigger a change in recommendation by a fiduciary.</skos:definition>
    </owl:Class>
    


