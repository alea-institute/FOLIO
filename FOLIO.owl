        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_02"/>
        <rdfs:label>Neurocognitive Disorders</rdfs:label>
        <skos:definition>Neurocognitive Disorders are characterized by a clinically significant decline in cognitive functioning that impacts memory, executive functions, language, visual-spatial abilities, and other cognitive domains. Symptoms may include disturbances in memory, planning, perception, and social judgment, with various conditions falling under this category due to medical, neurological, or substance-related causes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/REGIc9ijYjLLPaOjzHgyZO -->

