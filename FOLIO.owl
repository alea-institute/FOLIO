        <skos:altLabel xml:lang="pt-br">Processo de Sentença</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Procédure de condamnation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sentencing Proceeding</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafverfahren</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הליך דיני של מתן עונש</skos:altLabel>
