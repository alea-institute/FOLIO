        <skos:altLabel xml:lang="fr-fr">Clause de travail pour embauche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de trabajo por encargo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de trabajo por encargo</skos:altLabel>
