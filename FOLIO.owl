    <!-- https://folio.openlegalstandard.org/R7Vs0DoddY29OqKW1QRuTkm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Vs0DoddY29OqKW1QRuTkm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ffI3iiU2HojmiTTtoGwZP"/>
        <rdfs:label>Motion for Relief due to Newly Discovered Evidence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Erleichterung aufgrund neu entdeckter Beweise</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Alivio debido a Nueva Evidencia Descubierta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Alivio debido a Nueva Evidencia Descubierta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Relief due to Newly Discovered Evidence</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour soulagement en raison de nouvelles preuves découvertes</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Alívio devido a Novas Provas Descobertas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לסיוע עקב חומרה חדשה שנמצאה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नई खोजी गई साक्ष्य के कारण राहत के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因新发现证据而提出的救济动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">新たに発見された証拠に基づく救済のための動議</skos:altLabel>
        <skos:definition>A Motion for Relief due to Newly Discovered Evidence is a legal request made to the court to reconsider a previous decision or judgment based on new evidence that was not available at the time of the original decision.</skos:definition>
    </owl:Class>
    


