    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RyKcIn62llXcjUfXlSsx1M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RyKcIn62llXcjUfXlSsx1M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ0dgV4Z2Xk7aGfJt2nSj7"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_00D1"/>
        <rdfs:label>Systemic Lupus Erythematosus</rdfs:label>
        <skos:altLabel>Disseminated Lupus Erythematosus</skos:altLabel>
        <skos:definition>Systemic lupus erythematosus (SLE) is a chronic inflammatory disease that can affect any organ or body system. It is frequently, but not always, accompanied by constitutional symptoms such as severe fatigue, fever, malaise, and involuntary weight loss, and involves major organ or body system manifestations including respiratory, cardiovascular, renal, hematologic, skin, neurologic, mental, and immune system disorders.</skos:definition>
        <skos:prefLabel>Lupus</skos:prefLabel>
    </owl:Class>
    


