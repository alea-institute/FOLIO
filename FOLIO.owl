        <skos:altLabel xml:lang="es-mx">Cláusula de Consideración Futura</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de consideração futura</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Future Consideration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur zukünftigen Berücksichtigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף התחשבנות עתידית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भविष्य की विचारणीय शर्त</skos:altLabel>
