    <!-- https://folio.openlegalstandard.org/RDQ8w43q2ST3z8GpDUIacM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDQ8w43q2ST3z8GpDUIacM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UZkDXz7Wg2AtyHFQEeySC"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <dc:source>International Bill of Human Rights</dc:source>
        <rdfs:label>Freedom of Assembly</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Freedom of Assembly Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de libertad de reunión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de libertad de reunión</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da liberdade de reunião</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la liberté de réunion</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versammlungsfreiheitsanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת חופש התכנסות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सभा की स्वतंत्रता दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">集会の自由主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">集会自由权利主张</skos:altLabel>
        <skos:definition>A freedom of assembly claim is a legal action initiated by an individual or group alleging that their right to freedom of assembly, as protected by the First Amendment of the United States Constitution, has been violated by the government or a government actor. The First Amendment guarantees that the government shall not abridge the freedom of assembly, which includes the right to peacefully gather, protest, or associate with others for the expression of ideas, beliefs, and collective action. A freedom of assembly claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts assembly, when a permit for a peaceful protest or gathering is unfairly denied, or when an assembly is disbanded or interfered with by law enforcement without just cause.</skos:definition>
    </owl:Class>
    


