    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCQuJ7q1lQ1WIJ2kx5jJk3v">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
        <rdfs:label>Piercing the Corporate Veil</rdfs:label>
        <skos:altLabel>Avoiding the Corporate Liability Shield</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Desconsideração da personalidade jurídica</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Desestimación de la personalidad jurídica</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Disolución del velo corporativo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Durchbrechung der Unternehmensschleier</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lifting the Corporate Veil</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Percer le voile corporatif</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Piercing the Corporate Veil</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נקיטת המסך התאגידי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कॉर्पोरेट वेल को छेदना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法人格の透過</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">穿透公司法人格</skos:altLabel>
        <skos:definition>Piercing the Corporate Veil is a legal concept that allows a court to disregard the limited liability protection of a corporation or partnership and hold its shareholders or partners personally liable for the entity&apos;s actions or debts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCQuYZJ8DVirpE9BFiYBoC4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCQuYZJ8DVirpE9BFiYBoC4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC8JmK2y8Na9Itkk0MCtMS4"/>
        <rdfs:label>Military Discharge</rdfs:label>
        <skos:definition>Military Discharge is the formal release of a service member from their obligation to continue service in the armed forces. The discharge can occur for various reasons, such as the completion of a service term, medical reasons, or disciplinary actions, and may be classified as honorable, general, or other types, affecting future veteran benefits.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCQzzPmqVSk0G56dX8Mj2Ch -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCQzzPmqVSk0G56dX8Mj2Ch">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RChEjOHUONk1Yp2qm3OHJdc"/>
        <rdfs:label>Washington Superior Court - Chelan County</rdfs:label>
        <skos:definition>Washington Superior Court - Chelan County is a specific court located in Chelan County, Washington that operates under the jurisdiction of the Washington Superior Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCR0Wfb4Zz9V56W2ri7JeTU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCR0Wfb4Zz9V56W2ri7JeTU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVaHiNBU68DENmeHicnzro"/>
        <rdfs:label>Audiovisual Work</rdfs:label>
        <skos:altLabel>AV Work</skos:altLabel>
        <skos:altLabel>Audio-Visual Creation</skos:altLabel>
        <skos:altLabel>Audiovisual Media</skos:altLabel>
        <skos:altLabel>Multimedia Work</skos:altLabel>
        <skos:definition>An Audiovisual Work is a creation that combines both visual and auditory elements, such as films, television shows, and videos, intended to be experienced simultaneously. Protected under copyright law, audiovisual works grant the creator exclusive rights to reproduce, distribute, and publicly display the content.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCR2daagM0vMiqCGhsBrZrE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCR2daagM0vMiqCGhsBrZrE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrctN8FUd3Tj5gi4DWHTZx"/>
        <rdfs:label>General Relief Benefit</rdfs:label>
        <skos:definition>General Relief Benefit, also known as a general assistance program, refers to a form of public assistance provided by local or state governments to individuals or families who do not qualify for specialized aid programs, such as unemployment or disability benefits. The aim is to offer temporary financial support for basic needs like food, housing, and medical care.</skos:definition>
        <skos:prefLabel>General Assistance Program Benefit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCR5aQ6oh3HUQyzL2hoCEv5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCR5aQ6oh3HUQyzL2hoCEv5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Alatna Village</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9m8Wz6rX8oJIJfhFFncV5x"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Immunity and Privilege</rdfs:label>
        <skos:altLabel>Immunity</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Immunity and Privilege</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Immunität und Privileg</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Immunité et privilège</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imunidade e privilégio</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inmunidad y Privilegio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad y Privilegio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות ופריבילגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवरोध और विशेषाधिकार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">免責特権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">豁免和特权</skos:altLabel>
        <skos:definition>Immunity and Privilege refers to legal defenses that protect individuals or entities from being held liable or from having to disclose certain information in a legal proceeding. These defenses can include governmental immunity, parental immunity, and various types of privileges such as attorney-client privilege or fair and true reporting privilege.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCR9dUNNWhfQwdzq3isTiY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCR9dUNNWhfQwdzq3isTiY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7nqxxlAfhYqqSA2UQ5UxpX"/>
        <rdfs:label>Negligence Per Se</rdfs:label>
