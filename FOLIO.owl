        <skos:altLabel xml:lang="he-il">Discrimination by race</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Discrimination raciale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Discriminação racial</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Race Discrimination</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rassendiskriminierung</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जाति भेदभाव</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">人種差別</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">种族歧视</skos:altLabel>
        <skos:definition>The concept of Race Discrimination refers to the unfair treatment or prejudice against an individual or group based on their race or ethnicity, which is prohibited by law and can be the basis for a discrimination claim.</skos:definition>
        <skos:prefLabel>Racial Discrimination</skos:prefLabel>
    </owl:Class>
    


