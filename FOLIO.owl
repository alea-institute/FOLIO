        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423410"/>
        <rdfs:label>Photographic Equipment and Supplies Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of photographic equipment and supplies (except office equipment).</skos:definition>
        <skos:example>Photofinishing equipment merchant wholesalers</skos:example>
        <skos:example>Photographic camera equipment and supplies merchant wholesalers</skos:example>
        <skos:example>Photographic film and plates merchant wholesalers</skos:example>
        <skos:example>Television cameras merchant wholesalers</skos:example>
        <skos:example>Video cameras (except household-type) merchant wholesalers</skos:example>
    </owl:Class>
    


