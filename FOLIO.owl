            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RWb1ilIw9ru5NEHVikYIfy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Avoidance Action Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Acciones de evitación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acciones de evitación</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Actions en annulation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ansprüche aus Anfechtungsklagen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Avoidance Action Claims</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de ação de evitação</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות פעולת חריגה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टालने वाली कार्रवाई दावे</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">回避訴訟請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">回避诉讼索赔</skos:altLabel>
        <skos:definition>Avoidance Action Claims refer to legal claims made in bankruptcy and restructuring cases that seek to recover property or assets that were transferred or paid out in a way that is considered fraudulent or preferential, and may include actions such as turnover of property, setoff, and avoidance of statutory liens.</skos:definition>
    </owl:Class>
    


