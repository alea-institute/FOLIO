        <rdfs:label>Arkansas Circuit Court - Jefferson Cty.</rdfs:label>
        <skos:definition>A court located in Jefferson County, Arkansas that has jurisdiction over civil and criminal cases within its designated geographical area.</skos:definition>
    </owl:Class>
    


