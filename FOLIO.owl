        <skos:altLabel xml:lang="es-mx">Inmunidad del Gobierno</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Regierungsimmunität</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות ממשלתית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सरकारी सुरक्षा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">政府免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">政府豁免权</skos:altLabel>
