    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB7hgxlMMem5iytisrGDeJn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJgy4NDLgsP7qaqied5k5c"/>
        <rdfs:label>Social Media</rdfs:label>
        <skos:definition>Social Media includes online services or sites that facilitate the creation, sharing, and interaction of user-generated content through virtual communities and networks. These platforms enable users to communicate, collaborate, and engage with content in real-time, fostering social connections and information exchange.</skos:definition>
        <skos:example>Facebook</skos:example>
        <skos:example>Instagram</skos:example>
        <skos:example>LinkedIn</skos:example>
        <skos:example>Snapchat</skos:example>
        <skos:example>TikTok</skos:example>
        <skos:example>Tumblr</skos:example>
        <skos:example>Twitter</skos:example>
        <skos:example>YouTube</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB7j6BtO4UzgzjH2pwD3XDi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB7j6BtO4UzgzjH2pwD3XDi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDWZFPdf6vWiJ2dOzUIfCvb"/>
        <rdfs:label>Bankruptcy Prepack</rdfs:label>
        <skos:definition>A bankruptcy prepack, or prepackaged bankruptcy, is a type of bankruptcy filing where the debtor negotiates and obtains creditor approval for a reorganization plan before filing for bankruptcy. This streamlined process aims to expedite the bankruptcy proceedings and minimize disruptions to the debtor&apos;s operations.</skos:definition>
    </owl:Class>
    


