        <skos:altLabel xml:lang="en-gb">Solar Energy Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Solarrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק אנרגיה סולארית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सौर ऊर्जा कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">太阳能法律</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">太陽光発電法</skos:altLabel>
        <skos:definition>Laws pertaining to solar power.</skos:definition>
        <skos:hiddenLabel>SOLARE</skos:hiddenLabel>
    </owl:Class>
    


