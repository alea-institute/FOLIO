        <skos:altLabel xml:lang="zh-cn">未遂电池</skos:altLabel>
        <skos:definition>Attempted Battery is a criminal offense that involves the intent to cause bodily harm to another person, but falls short of actual physical contact.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8GXZxWsugTGgVmMyhrFO20 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8GXZxWsugTGgVmMyhrFO20">
