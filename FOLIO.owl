        <rdfs:label>Investigation and Personal Background Check Services</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in providing investigation, detective, and personal background check services.</skos:definition>
        <skos:example>Fingerprint services</skos:example>
        <skos:example>Polygraph services</skos:example>
        <skos:example>Private detective services</skos:example>
        <skos:example>Private investigative services (except credit)</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/8ZDvZMxUT8WVjf16o4gwfw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/8ZDvZMxUT8WVjf16o4gwfw">
