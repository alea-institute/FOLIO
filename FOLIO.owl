        <skos:altLabel xml:lang="de-de">Eilbewegung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Emergency Motion</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de emergencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de emergencia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion d&apos;urgence</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de medida urgente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה דחופה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आपातकालीन याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">紧急动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">緊急モーション</skos:altLabel>
        <skos:definition>An Emergency Motion is a type of legal request made in an appellate court that seeks immediate relief due to an urgent situation or circumstance.</skos:definition>
    </owl:Class>
    


