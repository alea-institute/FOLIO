        <rdfs:label>Escrow Agent Improperly Disbursing Funds</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Agent de séquestre distribuant incorrectement des fonds</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Agente de custodia que distribuye fondos de manera incorrecta</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Agente de custódia distribuindo fundos indevidamente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Agente de fideicomiso que distribuye fondos de manera incorrecta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Escrow Agent Improperly Disbursing Funds</skos:altLabel>
