        <skos:altLabel xml:lang="pt-br">Sociedade de Responsabilidade Limitada</skos:altLabel>
        <skos:altLabel>Society with Limited Responsibility</skos:altLabel>
        <skos:altLabel xml:lang="fr">Société à Responsabilité Limitée</skos:altLabel>
