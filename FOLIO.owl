        <rdfs:label>New Jersey Court of Common Pleas</rdfs:label>
        <skos:definition>The New Jersey Court of Common Pleas is a trial court within the New Jersey State Courts system that handles civil and criminal cases at the county level.</skos:definition>
    </owl:Class>
    


