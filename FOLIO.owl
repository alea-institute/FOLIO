        <rdfs:label>Annual Report</rdfs:label>
        <skos:altLabel>Year-end Report</skos:altLabel>
        <skos:definition>An Annual Report is a comprehensive document produced by a company each year to report its financial and operational status. It is aimed at shareholders, potential investors, and regulatory authorities.</skos:definition>
    </owl:Class>
    


