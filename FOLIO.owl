        <skos:altLabel xml:lang="en-gb">Fraudulent Transfers</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Transferencias fraudulentas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Transferencias fraudulentas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Transferts frauduleux</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Transferências fraudulentas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">העברות מטעות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">धोखाधड़ी से हुए हस्तांतरण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不正な譲渡</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">欺诈性转移</skos:altLabel>
        <skos:definition>Fraudulent Transfers refer to the transfer of assets made with the intent to hinder, delay, or defraud creditors. This concept falls under the broader category of Fraud Claims, Avoidance Action Claims, Banking, Commercial Paper, and Creditor Claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCNnMT64k77F35KmpeW2Zbs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCNnMT64k77F35KmpeW2Zbs">
