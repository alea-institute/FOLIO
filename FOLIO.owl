        <rdfs:label>A105 Communicate - in firm</rdfs:label>
        <skos:definition>The concept A105 Communicate (in firm) refers to the act of exchanging information or ideas within a law firm or legal organization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzS5fzbXo1pMyaKJCee7s5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzS5fzbXo1pMyaKJCee7s5">
