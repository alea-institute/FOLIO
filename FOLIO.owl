        <skos:altLabel xml:lang="en-gb">Jury Selection / Voire Dire Practice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Jury-Auswahl / Voire Dire-Praxis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Selección del jurado / Práctica de Voire Dire</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Selección del jurado / Práctica de Voire Dire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Seleção do júri / Prática do Voire Dire</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Sélection du jury / Pratique du Voire Dire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בחירת השופט / תרגול וואואיר דירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ज्यूरी चयन / व्होइर डायर अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">陪审团筛选/ Voire Dire实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">陪審員選出/ Voire Dire実践</skos:altLabel>
        <skos:definition>Jury Selection / Voire Dire Practice refers to the process of selecting a jury for a trial, which involves questioning potential jurors to determine their suitability for serving on the jury.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7athlXhsUuRtg7LvK0uUaF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7athlXhsUuRtg7LvK0uUaF">
