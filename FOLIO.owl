        <skos:altLabel xml:lang="es-mx">Creencia razonable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Crença razoável</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Croyance raisonnable</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reasonable Belief</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אמון סביר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उचित विश्वास</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合理信念</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合理的信念</skos:altLabel>
        <skos:definition>A reasonable belief is a standard of proof in litigation where a party must demonstrate that they held a belief that was objectively reasonable under the circumstances, in order to meet their burden of proof.</skos:definition>
    </owl:Class>
    


