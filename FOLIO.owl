        <skos:altLabel xml:lang="es-es">Evento de cierre</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento de clausura</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Evento de encerramento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement de clôture</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירוע סגירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समापन घटना</skos:altLabel>
