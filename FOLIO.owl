        <skos:altLabel xml:lang="fr-fr">Ordonnance de planification</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Scheduling Order</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Terminplanungsanordnung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צו תזמון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुसूची आदेश</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スケジュールオーダー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排期令</skos:altLabel>
        <skos:definition>A scheduling order is a type of court order that sets deadlines and timelines for the parties involved in a legal case to complete certain tasks or actions, such as filing motions or submitting evidence.</skos:definition>
    </owl:Class>
    


