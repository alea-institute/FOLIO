        <skos:altLabel xml:lang="es-es">Servicio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Servicio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Serviço</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेवा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サービス</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">服务</skos:altLabel>
        <skos:definition>The legal work performed, usually by a Legal Services Provider, in the course of a legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDK1m7oO4kL4ZQ5IhOoZHRd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDK1m7oO4kL4ZQ5IhOoZHRd">
