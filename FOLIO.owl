        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=322120"/>
        <rdfs:label>Paper Mills</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in manufacturing paper from pulp. These establishments may manufacture or purchase pulp. In addition, the establishments may convert the paper they make. The activity of making paper classifies an establishment into this industry regardless of the output.</skos:definition>
    </owl:Class>
    


