            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Judicial Finding of Fact</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Constatation judiciaire de faits</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Constatação judicial de fatos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gerichtliche Feststellung von Tatsachen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Hallazgo de hecho judicial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Hallazgo de hecho judicial</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Judicial Finding of Fact</skos:altLabel>
