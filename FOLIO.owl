        <skos:altLabel xml:lang="pt-br">Fornecimento tardio de informações de arquivo de crédito</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Late Provision of Credit-File Information</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Provisión tardía de información de archivo de crédito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Provisión tardía de información de archivo de crédito</skos:altLabel>
