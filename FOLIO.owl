    <!-- https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Public Benefits Objectives</rdfs:label>
        <skos:definition>Public benefits objectives refer to legal services related to the accurate and efficient distribution of public assistance to eligible recipients. For example, underpayment objectives focus on identifying and rectifying instances where beneficiaries receive less than they are entitled to, often due to administrative errors or oversight. Overpayment objectives aim to detect and recover funds that have been erroneously disbursed in excess of eligibility, to maintain the integrity and sustainability of the benefit program.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79ZnCKDSoLOn17LGjAF6G6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79ZnCKDSoLOn17LGjAF6G6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzy5rvrKtuL8AwKrBTFfBQ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8W98AqFMMolqQMvARHGyoP"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Patent Subject-Matter Classifications</rdfs:label>
        <skos:definition>Patent Subject-Matter Classifications are a system of categorizing patents and patent applications based on the technical fields or subject matter they pertain to, such as chemical, mechanical, electrical, and life sciences. This classification system facilitates the organization, search, and examination of patents by grouping similar inventions together.</skos:definition>
    </owl:Class>
    


