        <dc:identifier>AQRE</dc:identifier>
        <rdfs:label>Acquiree</rdfs:label>
        <skos:altLabel>Acquiree</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Acquiree</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Adquirido</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Adquirido</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Cible d&apos;acquisition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Empresa adquirida</skos:altLabel>
        <skos:altLabel>Target Company</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Übernahmekandidat</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נכס מקונן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिग्रही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">被收购方</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買収対象</skos:altLabel>
        <skos:definition>An acquiree is a company or entity that is being acquired or purchased in a merger or acquisition transaction. The acquiree is also known as the target firm during a takeover scenario.</skos:definition>
        <skos:hiddenLabel>AQRE</skos:hiddenLabel>
    </owl:Class>
    


