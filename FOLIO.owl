        <skos:altLabel xml:lang="de-de">Prakrit-Sprachen</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プラークリット語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">梵语次语</skos:altLabel>
        <skos:definition>Prakrit languages are a group of ancient Indian languages that were spoken in the Indian subcontinent before the emergence of Sanskrit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTnKyetea0PXI9vvAMBrHq -->

