        <rdfs:label>Museums, Historical Sites, and Similar Institutions Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de Museos y Sitios Históricos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Museos y Sitios Históricos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des musées et des sites historiques</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de Museus e Sítios Históricos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Museen und historische Stätten Branche</skos:altLabel>
        <skos:altLabel>Museums and Historical Sites</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Museums and Historical Sites Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית מוזיאונים ואתרי היסטוריה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संग्रहालय और ऐतिहासिक स्थल उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">博物館・史跡産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">博物馆和历史遗址行业</skos:altLabel>
        <skos:definition>Industries in the Museums, Historical Sites, and Similar Institutions subsector engage in the preservation and exhibition of objects, sites, and natural wonders of historical, cultural, and/or educational value.</skos:definition>
        <skos:hiddenLabel>MUSM</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkarukhII43Ov0AvgW3ODC -->

