        <rdfs:label>Breach of Loan Contract</rdfs:label>
        <skos:altLabel>Borrower Default</skos:altLabel>
        <skos:altLabel>Debt Default</skos:altLabel>
        <skos:altLabel>Loan Agreement Breach</skos:altLabel>
        <skos:altLabel>Loan Payment Default</skos:altLabel>
        <skos:definition>A Loan Default occurs when a borrower fails to meet the legal obligations or conditions of a loan agreement, typically involving missed payments or breach of other terms. This default triggers legal consequences and can lead to actions such as foreclosure, repossession, or litigation.</skos:definition>
        <skos:prefLabel>Loan Default</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7U11pwkJfQSG7FGXqyIrTE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7U11pwkJfQSG7FGXqyIrTE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1EbxjQwzgikspixQygdfK"/>
        <dc:source>Fed. R. Evid. 803(4)</dc:source>
        <rdfs:label>Medical Treatment Statement</rdfs:label>
        <skos:altLabel>Statement for Purposes of Medical Diagnosis or Treatment</skos:altLabel>
        <skos:definition>A Medical Treatment Statement is a hearsay exception that allows the admission of statements made for purposes of medical diagnosis or treatment. This exception is based on the belief that statements made to medical professionals are likely to be truthful because the declarant has a strong motivation to provide accurate information to receive proper care.</skos:definition>
        <skos:prefLabel>Medical Diagnosis Statement</skos:prefLabel>
    </owl:Class>
    


