        <rdfs:label>DEPRECATED SANDBOX VERSION: Contractual Clause Types</rdfs:label>
        <skos:definition>This concept refers to types of clauses that are commonly found in contracts, but this version is no longer in use and has been replaced by newer versions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBKAS83jA4f4XBIS5lAUOt8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBKAS83jA4f4XBIS5lAUOt8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5jFFdAx82IJWPe4JDkFqg"/>
        <rdfs:label>Incitement</rdfs:label>
        <skos:altLabel>Abetment</skos:altLabel>
        <skos:altLabel>Instigation</skos:altLabel>
        <skos:altLabel>Provocation</skos:altLabel>
        <skos:definition>Incitement is the act of encouraging or persuading another person to commit a crime or unlawful act. It involves speech or conduct that is intended to provoke imminent illegal action.</skos:definition>
        <skos:prefLabel>Provocation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBKAwwAzIOYxNJwmaMS0h9L -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBKAwwAzIOYxNJwmaMS0h9L">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE"/>
        <rdfs:label>Stand Your Ground Law</rdfs:label>
        <skos:altLabel>No Duty to Retreat</skos:altLabel>
        <skos:definition>Stand Your Ground Law is a type of legislation that permits individuals to use force, including deadly force, to defend themselves without any obligation to retreat or flee if they believe they are in imminent danger of serious harm or death.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBKBnWyBmr5Hmg5T3VdTFxL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBKBnWyBmr5Hmg5T3VdTFxL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8jIR8iqxwPvaiF10RkWcgO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>Fed. R. Evid. 602</dc:source>
        <rdfs:label>Lacks Personal Knowledge Objection</rdfs:label>
        <skos:altLabel>Beyond Experience Objection</skos:altLabel>
        <skos:altLabel>No Direct Knowledge Objection</skos:altLabel>
        <skos:altLabel>Objection to Testimony Without Personal Experience</skos:altLabel>
        <skos:definition>A Lacks Personal Knowledge Objection is raised when a party in a legal proceeding believes that a witness is testifying about matters beyond their direct experience or observation. This objection aims to ensure that testimony is based on firsthand knowledge and is reliable.</skos:definition>
    </owl:Class>
    


