        <rdfs:label>LAW_FIRM_MATTER_ID</rdfs:label>
        <skos:definition>A LAW_FIRM_MATTER_ID is a unique identifier assigned by a law firm to a specific matter, and is defined within the context of the LEDES98BI V5 Format Rev 1-2020 standard for electronic billing.</skos:definition>
    </owl:Class>
    


