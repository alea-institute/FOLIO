        <rdfs:label>Legal Verification Management</rdfs:label>
        <skos:definition>Legal Verification Management refers to the process of ensuring the accuracy and validity of legal information and documents, typically through the use of technology and specialized software, within the context of Legal Point Solutions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RoA3iT57OSgVnM982fPGUE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RoA3iT57OSgVnM982fPGUE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
        <rdfs:label>Rebuttal of Presumption of Undue Hardship</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Rebuttal of Presumption of Undue Hardship</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Refutación de la Presunción de Dificultad Excesiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Refutación de la Presunción de Dificultad Excesiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Refutação da Presunção de Dificuldade Excessiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réfutation de la présomption de difficultés excessives</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Widerlegung der Vermutung unangemessener Härte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרעון של הנחת הקשיים המופרזים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुचित कठिनाई के प्रति अनुमान का खंडन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">過度な困難の推定の反論</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">驳回不当困难推定</skos:altLabel>
        <skos:definition>The Rebuttal of Presumption of Undue Hardship is a legal argument made in the context of bankruptcy and restructuring proceedings by a debtor seeking to prove that they are not able to repay their debts without experiencing undue hardship, despite the presumption that they are able to do so.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RoABbJ9kEFzmBvBSGmbAyq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RoABbJ9kEFzmBvBSGmbAyq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
        <rdfs:label>Inadmissible Documentary Evidence Objection</rdfs:label>
        <skos:definition>An Inadmissible Documentary Evidence Objection is raised when a party attempts to introduce a document into evidence that fails to meet the necessary legal requirements for admissibility. This objection encompasses various grounds, such as lack of proper authentication or failure to provide the original document when required by the &quot;original writings&quot; rule (also known as the best evidence rule).</skos:definition>
        <skos:prefLabel>Documentary Evidence Admissibility Objection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RoAfIWi25j1SiaSU9TjqGM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RoAfIWi25j1SiaSU9TjqGM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8u7CAB2KmMvx0wpzJ73n97"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvV18Mbbb9FYFXbHt1inuL"/>
        <rdfs:label>Tax Audit</rdfs:label>
        <skos:altLabel>Tax Compliance Audit</skos:altLabel>
        <skos:altLabel>Tax Examination</skos:altLabel>
        <skos:definition>A Tax Audit is an official examination of an individual&apos;s or organization&apos;s tax returns and financial records by tax authorities to verify compliance with tax laws and accuracy in reporting. This event aims to identify discrepancies, ensure proper tax payments, and address potential tax liabilities.</skos:definition>
    </owl:Class>
    


