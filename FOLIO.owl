        <rdfs:label>Order Granting in Part, Denying in Part</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Ordem Concedendo em Parte, Negando em Parte</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Orden que concede en parte, deniega en parte</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Orden que concede en parte, deniega en parte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Order Granting in Part, Denying in Part</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ordonnance accordant en partie, refusant en partie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Teilweise gewährender, teilweise ablehnender Beschluss</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צו המעניק בחלקו, מכחיש בחלקו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भाग में अनुदान देना, भाग में अस्वीकार करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">一部を認め、一部を否認する命令</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">部分准许，部分否决的命令</skos:altLabel>
        <skos:definition>An &quot;Order Granting in Part, Denying in Part&quot; is a legal decision issued by a court that approves some requests made by a party and denies others.</skos:definition>
    </owl:Class>
    


