        <rdfs:label>Due Diligence Period Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de période de diligence raisonnable</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de período de diligencia debida</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de período de diligencia debida</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de período de diligência prévia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Due Diligence Period Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Sorgfaltspflichtfrist</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תקופת דיליגנס דיו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ड्यू डिलिजेंस पीरियड क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">デューデリジェンス期間条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">尽职调查期条款</skos:altLabel>
        <skos:definition>A Due Diligence Period Clause is a provision in a contract that allows a party a specified amount of time to conduct investigations and assessments to ensure that the terms of the contract are acceptable before finalizing the agreement.</skos:definition>
    </owl:Class>
    


