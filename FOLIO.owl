        <skos:altLabel xml:lang="de-de">Überlebensanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת הישרדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बचता हुआ दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">生存権請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">生存索赔</skos:altLabel>
        <skos:definition>A Survival Claim is a legal claim made on behalf of a deceased person&apos;s estate for damages or losses that the person suffered before their death and that survived them.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9J5Z30cBGCGWc6EmoO3nBI -->

