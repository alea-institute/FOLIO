        <rdfs:label>Drive-In Motion Picture Theaters</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in operating drive-in motion picture theaters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fXRPKQTLS6yoORCGCvg-Tw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fXRPKQTLS6yoORCGCvg-Tw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_mjVg2KLTnuxW-OeHUOnsQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424440"/>
        <rdfs:label>Poultry and Poultry Product Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of poultry and/or poultry products (except canned and packaged frozen).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/f_1Sn1YlQJS215L0tflkyw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/f_1Sn1YlQJS215L0tflkyw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/KMmINX7IS6WBvugBKOU0rw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424590"/>
        <rdfs:label>Other Farm Product Raw Material Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of farm products (except grain and field beans, livestock, raw milk, live poultry, and fresh fruits and vegetables).</skos:definition>
        <skos:example>Chicks, live, merchant wholesalers</skos:example>
        <skos:example>Hemp merchant wholesalers</skos:example>
        <skos:example>Hides merchant wholesalers</skos:example>
        <skos:example>Horses merchant wholesalers</skos:example>
        <skos:example>Leaf tobacco merchant wholesalers</skos:example>
        <skos:example>Mules merchant wholesalers</skos:example>
        <skos:example>Nuts, unprocessed or shelled only, merchant wholesalers</skos:example>
        <skos:example>Raw cotton merchant wholesalers</skos:example>
        <skos:example>Raw pelts merchant wholesalers</skos:example>
        <skos:example>Sod merchant wholesalers</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/fadc774VQCqpSPzpFfiiOA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/fadc774VQCqpSPzpFfiiOA">
