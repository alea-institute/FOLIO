        <skos:altLabel xml:lang="pt-br">Cláusula de bônus de assinatura</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Unterzeichnungsprämie</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Signing Bonus Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף בונוס חתימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साइनिंग बोनस क्लॉज</skos:altLabel>
