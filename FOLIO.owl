        <rdfs:label>Robbery</rdfs:label>
        <skos:altLabel xml:lang="de-de">Raub</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Robbery</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Robo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Robo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Roubo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vol à main armée</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גניבה עם אלימות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लूट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">強盗</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">抢劫</skos:altLabel>
        <skos:definition>The taking, or attempting to take, anything of value under confrontational circumstances from the control, custody, or care of another person by force or threat of force or violence and/or by putting the victim in fear of immediate harm.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9lG834KhCW6GlZ3PKTHhDD -->

