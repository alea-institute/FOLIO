        <rdfs:label>Washington Superior Court - Skagit County</rdfs:label>
        <skos:definition>Washington Superior Court - Skagit County refers to a specific court within the Washington Superior Court system that has jurisdiction over legal matters in Skagit County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgh8aeCoXYHW9gkTUXwjDQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgh8aeCoXYHW9gkTUXwjDQ">
