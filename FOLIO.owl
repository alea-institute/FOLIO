        <skos:altLabel xml:lang="es-es">Orden sobre Resolución Alternativa de Disputas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Orden sobre la Resolución Alternativa de Disputas</skos:altLabel>
