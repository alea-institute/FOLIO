                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8AskLnQPiMPqirI390zrab"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Secrecy</rdfs:label>
        <skos:altLabel xml:lang="de-de">Geheimhaltung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Secrecy</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Secret</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Secretismo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Secretismo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sigilo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוֹדִיוּת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गोपनीयता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保密</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">秘密保持</skos:altLabel>
        <skos:definition>The concept of Secrecy refers to the legal defense strategy of withholding information or evidence from the opposing party in a legal matter, typically to protect confidential or privileged information.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d4mcNjgBosSzJeS9zgSLG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d4mcNjgBosSzJeS9zgSLG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_22"/>
        <rdfs:label>Bladder Cancer</rdfs:label>
        <skos:altLabel>Bladder Carcinoma</skos:altLabel>
        <skos:altLabel>Bladder cancer is a type of cancer that starts in the cells of the bladder, the organ responsible for storing urine. It often presents with symptoms such as blood in the urine and requires treatments including surgery, chemotherapy, radiation therapy, and immunotherapy.</skos:altLabel>
        <skos:altLabel>Urothelial Cancer</skos:altLabel>
        <skos:prefLabel>Urinary Bladder Cancer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d56RLiMdHTmkRxNzG2hzN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d56RLiMdHTmkRxNzG2hzN">
