        <rdfs:label>New York Supreme Court - Cortland County</rdfs:label>
        <skos:definition>The New York Supreme Court - Cortland County is a court of general jurisdiction in the state of New York, with authority to hear and decide a wide range of legal disputes within its geographic jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9qNwyOrzjiccsqggU9qkhh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9qNwyOrzjiccsqggU9qkhh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RgcYpZhkBQt5qL99YT6jP7"/>
        <rdfs:label>Inactive Employment Status</rdfs:label>
        <skos:definition>Inactive Employment refers to a temporary or prolonged period during which an employee remains on the payroll but is not actively performing job duties. This can occur for various reasons such as medical leave, furlough, or sabbatical, and usually entails a change in benefits or compensation during the inactive period.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9qPz8wiiMNjtoH6mWAzUxl -->

