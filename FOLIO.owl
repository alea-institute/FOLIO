        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtmRdqzdG4lddVrtCToiL1"/>
        <rdfs:label>Fiduciary Breaching Duty</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Fiduciary Breaching Duty</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento del deber fiduciario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento del deber fiduciario</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der Treuepflicht</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation du devoir fiduciaire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação do dever fiduciário</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת האמון הפידוסיארית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फिडुशियरी भ्रमण ड्यूटी उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">信託違反義務</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反信托责任</skos:altLabel>
        <skos:definition>The failure of a fiduciary to fulfill their legal obligation to act in the best interest of their client or beneficiary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfQDuzbpTal3OSnNsEpKOX -->

