    <!-- https://folio.openlegalstandard.org/R9zHtGhiACIwYWhVohRlrbo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9zHtGhiACIwYWhVohRlrbo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KRLFkDC6ycyN3FyXivt7D"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R72F4bf9E30d76B8d05ED438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7OJQHant3Dx172WXuPbWgx"/>
            </owl:Restriction>
        </rdfs:subClassOf>
