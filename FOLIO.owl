            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Time Entry Narrative</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Narrativa de entrada de tempo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Narrativa de entrada de tiempo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Narrativa de entrada de tiempo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Récit de saisie de temps</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Time Entry Narrative</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeiteintragserzählung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיפור כניסת זמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समय प्रविष्टि कथा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">时间记录叙述</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">時間入力ナラティブ</skos:altLabel>
        <skos:definition>A Time Entry Narrative is a description of the work performed by a lawyer or legal professional for a specific client, used for billing purposes and categorized under Invoice Data.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R91pWaQviYCOFMSnuzZosu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R91pWaQviYCOFMSnuzZosu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBZL31YCqZA1E1vlIkzRRqw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R153Tv1X1AyYIr4xBxbE2l"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tax_rate_percent</rdfs:label>
        <skos:definition>&quot;Percentage tax rate against charge, i.e. 7.2516% tax_rate_percent would be represented as &quot;&quot;0.072516&quot;&quot;. 

The value in this field is always positive.  In some countries, tax could be a negative number (for example, Brazil has a negative withholding tax), in which case TAX.increase_decrease = Decrease. 

If a Tiered Tax, the value in this field should be null.  The tax rates associated with a Tiered Tax are defined in the TAX_TIER_DETAIL segment.&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R91rkMLuvkkfI4380vXkveh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R91rkMLuvkkfI4380vXkveh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/List_of_major_stock_exchanges"/>
        <rdfs:label>Stock Exchanges</rdfs:label>
        <skos:altLabel>Bourse</skos:altLabel>
        <skos:altLabel>Equity Market</skos:altLabel>
        <skos:altLabel>Financial Exchange</skos:altLabel>
        <skos:altLabel>Securities Exchange</skos:altLabel>
        <skos:definition>Stock Exchanges are organized markets where securities such as stocks, bonds, and other financial instruments are bought and sold. These exchanges provide a regulated and transparent environment for trading, ensuring fair pricing and facilitating liquidity for investors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R91uNeQK1sUtDgZDxYVlMS7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R91uNeQK1sUtDgZDxYVlMS7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7"/>
        <rdfs:label>Adjustment of Status Application</rdfs:label>
        <skos:altLabel>AOS Application</skos:altLabel>
        <skos:altLabel>Adjustment of Status Application (Standalone)</skos:altLabel>
        <skos:altLabel>Form I-485</skos:altLabel>
        <skos:definition>The Adjustment of Status application, commonly referred to as Form I-485 in the United States, is used by eligible individuals who are already present in the U.S. on a non-immigrant visa and wish to apply for lawful permanent resident status (green card) without leaving the country. This process allows the applicant to transition from a temporary visa holder to a permanent resident without the need to undergo consular processing outside the U.S. The I-485 application requires various supporting documents and fees, and its approval results in the issuance of a green card, granting the applicant the right to live and work permanently in the U.S.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R91wXCIbETmMbVGyeJFdyeU -->

