        <skos:altLabel xml:lang="pt-br">Identificadores de documentos de litígio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Identifikatoren für Prozessdokumente</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Litigation Document Identifiers</skos:altLabel>
