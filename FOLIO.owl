        <skos:altLabel xml:lang="ja-jp">ビニ; エド</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">比尼; 埃多</skos:altLabel>
        <skos:definition>A language spoken in Nigeria, specifically in the Edo State, by the Bini people.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jGpN7qLoTzazjzwCUdsfz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jGpN7qLoTzazjzwCUdsfz">
