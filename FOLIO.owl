        <rdfs:label>Probate due to Medical Condition</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Inventário devido a condição médica</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nachlassabwicklung aufgrund medizinischer Bedingungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Probate due to Medical Condition</skos:altLabel>
