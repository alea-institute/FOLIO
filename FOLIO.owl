        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RB5BLG1zQJq0HkrAIYCLZty"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>RICO Claims</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Demandas RICO</skos:altLabel>
        <skos:altLabel xml:lang="de-de">RICO-Ansprüche</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">RICO索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">RICO請求</skos:altLabel>
        <skos:altLabel>Racketeer Influenced and Corrupt Organization Act Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones RICO</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações RICO</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations RICO</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Serious Crimes Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות RICO</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आरआईसीओ दावे</skos:altLabel>
        <skos:definition>A claim brought under the Racketeer Influenced and Corrupt Organization Act (RICO), which is a federal law that provides for extended criminal penalties and a civil cause of action for acts performed as part of an ongoing criminal organization.</skos:definition>
        <skos:inScheme>UK</skos:inScheme>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9cXK0KfDcfq4Tr3Xaa0OF0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9cXK0KfDcfq4Tr3Xaa0OF0">
