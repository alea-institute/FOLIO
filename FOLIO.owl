        <skos:altLabel xml:lang="es-mx">Cláusula General de Liberación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de liberação geral</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">General Release Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שחרור כללי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य रिलीज क्लॉज</skos:altLabel>
