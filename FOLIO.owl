        <skos:altLabel xml:lang="en-gb">Caution Claim</skos:altLabel>
        <skos:inScheme>UK</skos:inScheme>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7oWyxtB6MtD5SutNOJyn6b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7oWyxtB6MtD5SutNOJyn6b">
