    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkRMPTPEu06hA4xUSOSGlf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkRMPTPEu06hA4xUSOSGlf">
