        <skos:altLabel xml:lang="ja-jp">税金の税金</skos:altLabel>
        <skos:definition>Tax on Tax refers to a tax levied on another tax, resulting in an increased tax liability for the taxpayer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RPBEBqN3r4YqvAj19Jw9fU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RPBEBqN3r4YqvAj19Jw9fU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RyazUr0HwLdeSIiJjwsbgP"/>
        <rdfs:label>Higher Education Degree</rdfs:label>
        <skos:definition>A Post-secondary Degree Level refers to the education attained after completing high school or its equivalent. This encompasses a range of academic qualifications including associate&apos;s degrees, bachelor&apos;s degrees, master&apos;s degrees, doctoral degrees (e.g., PhD), and professional degrees (e.g., MD, JD), which are awarded by colleges, universities, and professional schools after successful completion of specific courses or programs of study.</skos:definition>
        <skos:prefLabel>Post-secondary Degree</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RPBMYOdZCFTe7DFkGlFGmi -->

