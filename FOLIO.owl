        <skos:altLabel xml:lang="en-gb">Extortion</skos:altLabel>
        <skos:altLabel xml:lang="he-il">איומי חמסין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्पीड़न</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">恐喝</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">敲诈勒索</skos:altLabel>
        <skos:definition>To unlawfully obtain money, property, or any other thing of value, either tangible or intangible, through the use or threat of force, misuse of authority, threat of criminal prosecution, threat of destruction of reputation or social standing, or through other coercive means.</skos:definition>
    </owl:Class>
    


