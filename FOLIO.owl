        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
        <rdfs:label>Tender Offer</rdfs:label>
        <skos:altLabel xml:lang="es-es">Oferta Pública de Adquisición (OPA)</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oferta Pública de Adquisición (OPA)</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Oferta pública de aquisição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Offre publique d&apos;achat</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tender Offer</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Übernahmeangebot</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת רכישה ציבורית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टेंडर ऑफर</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">株式公開買付け</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">要约收购</skos:altLabel>
        <skos:definition>A tender offer is a type of M&amp;A deal structure where the acquiring company offers to purchase a significant portion or all of the target company&apos;s shares at a premium price, usually with the goal of gaining control of the target company.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ww9HussHVxgA1tC5lTXfJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ww9HussHVxgA1tC5lTXfJ">
