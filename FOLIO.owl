            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Uniform Dispute Resolution Service Provider</rdfs:label>
        <skos:definition>A Uniform Dispute Resolution Service Provider (UDRSP) is an organization accredited by the Internet Corporation for Assigned Names and Numbers (ICANN) to administer dispute resolution proceedings for domain name disputes under the Uniform Domain-Name Dispute-Resolution Policy (UDRP). These providers facilitate the resolution of conflicts between domain name registrants and trademark owners over domain name registrations.</skos:definition>
        <skos:prefLabel>UDRP Provider</skos:prefLabel>
    </owl:Class>
    


