            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Commerce Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Commerce Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Handelsklauselanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Cláusula de Comercio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Cláusula de Comercio</skos:altLabel>
