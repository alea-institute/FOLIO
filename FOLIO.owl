        <skos:prefLabel>L639 Quality assurance and control</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RgHKgBYfidbNNddNK2ube4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgHKgBYfidbNNddNK2ube4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG"/>
        <rdfs:label>Individualized Restructuring</rdfs:label>
        <skos:altLabel>Contract-Based Restructuring</skos:altLabel>
        <skos:altLabel>Contractual Debt Adjustment</skos:altLabel>
        <skos:altLabel>Private Debt Restructuring</skos:altLabel>
        <skos:altLabel>Private Negotiated Restructuring</skos:altLabel>
        <skos:definition>Individualized restructuring involves private negotiations between a debtor and one or more creditors to modify the terms of existing debt agreements. This process allows parties to tailor solutions to their specific needs without court intervention, often resulting in revised payment schedules, reduced interest rates, or partial debt forgiveness.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RgHUj7ZKoJL0s6JURcX8OI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgHUj7ZKoJL0s6JURcX8OI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8fFf9YNTCtz4Q15Jjj7AXF"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9WUFEb3p0Ep21EQ8yBptxD"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RhBvOCNsTuHs1L1cRSwWuL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Suspension of Sentence</rdfs:label>
        <skos:altLabel>Stay of Execution</skos:altLabel>
        <skos:definition>A Suspension of Sentence is a legal provision where a court imposes a sentence but delays or refrains from executing it, typically on certain conditions. This approach allows the offender to remain in the community under supervision, with the understanding that violating the conditions may result in the original sentence being imposed.</skos:definition>
        <skos:prefLabel>Suspended Sentence</skos:prefLabel>
    </owl:Class>
    


