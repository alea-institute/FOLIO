    <!-- https://folio.openlegalstandard.org/R7KnhbKXnWBeCBhayT7e9BY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KnhbKXnWBeCBhayT7e9BY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg"/>
        <rdfs:label>Supply Agreement</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Accord d&apos;approvisionnement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Acordo de fornecimento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acuerdo de suministro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Contrato de suministro</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Liefervereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Supply Agreement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם אספקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आपूर्ति समझौता</skos:altLabel>
