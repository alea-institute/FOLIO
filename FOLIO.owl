    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/jgjsC1tRSeaotz9lSA-7Vw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/jgjsC1tRSeaotz9lSA-7Vw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/t6LCSPCiSt2qUvN4Wgk3ng"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423420"/>
        <rdfs:label>Office Equipment Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of office machines and related equipment (except computers and computer peripheral equipment).</skos:definition>
        <skos:example>Automated teller machines (ATM) merchant wholesalers</skos:example>
        <skos:example>Calculators and calculating machines merchant wholesalers</skos:example>
        <skos:example>Cash registers merchant wholesalers</skos:example>
        <skos:example>Copying machines merchant wholesalers</skos:example>
        <skos:example>Paper shredders merchant wholesalers</skos:example>
        <skos:example>Point of sale terminals merchant wholesalers</skos:example>
        <skos:example>Security safes merchant wholesalers</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/jh-ErWyRTkueRPEgvmFLdw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/jh-ErWyRTkueRPEgvmFLdw">
