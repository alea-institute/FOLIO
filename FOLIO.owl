        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
        <rdfs:label>Personal Jurisdiction by Appearance</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par comparution</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Jurisdicción personal por comparecencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Jurisdicción personal por comparecencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por comparecimento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Appearance</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Persönliche Zuständigkeit durch Erscheinen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי הופעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपस्थिति द्वारा व्यक्तिगत अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">出庭个人管辖权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">出廷による個人管轄権</skos:altLabel>
        <skos:definition>The concept of &quot;Personal Jurisdiction by Appearance&quot; refers to the authority of a court to hear a case against a defendant who has voluntarily appeared before the court, even if they do not have a physical presence in the court&apos;s jurisdiction.</skos:definition>
    </owl:Class>
    


