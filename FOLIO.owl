                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8qItBwG2pRMFhUq1HQEMnb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9dd6R73IfKyiskT5Jf62R7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Trial Events</rdfs:label>
        <skos:altLabel xml:lang="es-es">Eventos de juicio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Eventos de juicio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Eventos de julgamento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Prozessereignisse</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial Events</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événements de procès</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירועי ניסיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल इवेंट्स</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">审判事件</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判イベント</skos:altLabel>
        <skos:definition>Trial Events refer to the specific events that occur during a trial, such as opening statements, witness testimony, and the receipt of a verdict.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcjE7ZFthlfdvlhZ5GCJyj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcjE7ZFthlfdvlhZ5GCJyj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDeWjTZogrlt1XvduSP1R8s"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Spousal Support Claim</rdfs:label>
        <skos:definition>A Spousal Support Claim is a legal request made by one spouse to receive financial assistance from the other spouse following a divorce or separation. This claim is typically based on factors such as income disparity, the length of the marriage, and each spouse&apos;s financial needs and contributions during the marriage. Spousal support, also known as alimony, is designed to provide financial support to the lower-earning spouse to help them maintain their standard of living or become financially independent.</skos:definition>
        <skos:prefLabel>Alimony Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rck2jHWol8s1ZYn5aZWzk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rck2jHWol8s1ZYn5aZWzk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEWWtS3nM8GE8R4en1abRz"/>
        <rdfs:label>Arkansas Circuit Court - Pike Cty.</rdfs:label>
        <skos:definition>A court located in Pike County, Arkansas that has jurisdiction over certain legal matters within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rco6IwncDRI2APcwt3kC7aA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rco6IwncDRI2APcwt3kC7aA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6P7wyMvVTo6CR9AJqe-HSg"/>
        <rdfs:label>WC410 Fact Witnesses</rdfs:label>
        <skos:definition>Preparing for examination of witness, Interview/meeting with witness, Preparing for cross-examination of witness, Review &amp; analysis of deposition/trial transcripts</skos:definition>
        <skos:prefLabel>WC410 Fact Witnesses</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <rdfs:label>Respiratory Disorder</rdfs:label>
        <skos:altLabel>Respiratory Condition</skos:altLabel>
        <skos:altLabel>Respiratory Illness</skos:altLabel>
        <skos:definition>Respiratory disorders are a group of conditions that affect the respiratory system, including the lungs and airways, leading to symptoms such as difficulty breathing, chronic cough, and reduced oxygen intake. These disorders can range from acute conditions like asthma attacks to chronic diseases like cystic fibrosis, requiring varied treatments and management strategies to improve respiratory function and quality of life.</skos:definition>
        <skos:prefLabel>Pulmonary Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcsmW8Wmu47y1GzwWHiFl1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcsmW8Wmu47y1GzwWHiFl1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/RCDOABUr8ZTMQ7N7Rydeius"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDK3ploePpyFDgIkSzbOCtX"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Testator</rdfs:label>
        <skos:altLabel>Testatrix</skos:altLabel>
        <skos:altLabel>Will-maker</skos:altLabel>
        <skos:definition>A Testator is an individual who creates and executes a valid will, specifying how their estate should be distributed after their death. This person must have the legal capacity to make a will and clearly express their intentions regarding the disposition of their property and assets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcutwK5AAUoSsZbULJMTlE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcutwK5AAUoSsZbULJMTlE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFED426F2C97b94Fa28DA94e"/>
        <rdfs:label>Delaware Justice of the Peace Court</rdfs:label>
        <skos:definition>The Delaware Justice of the Peace Court is a court within the Delaware State Courts system that has jurisdiction over civil and criminal cases involving minor offenses and disputes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcwQtGZrohiyAqPHf1j0JE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcwQtGZrohiyAqPHf1j0JE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Ov4MbOJULZY0aLe1KoP3Z"/>
        <rdfs:label>Personally Identifiable Information</rdfs:label>
        <skos:definition>Personally Identifiable Information (PII) is any data that can be used to identify, contact, or locate a specific individual. This includes names, addresses, phone numbers, email addresses, social security numbers, and other identifiers that can be linked to a particular person.</skos:definition>
        <skos:prefLabel>PII</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcwSTa6ZMTuG8LfCIF2UPTg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcwSTa6ZMTuG8LfCIF2UPTg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RYJ-vctjLRKG6Ekn5d1-frA"/>
        <rdfs:label>X401 Subscription Fee</rdfs:label>
        <skos:definition>Delivery of information via a subscription fee as opposed to a per user license fee or on a transaction basis. Indicate # of subscriptions as units; if different rates depending on type of subscription, split into multiple expense lines by rate.</skos:definition>
        <skos:prefLabel>X401 Subscription Fee</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rcwn8msRtDqTFPXcgrpN7A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rcwn8msRtDqTFPXcgrpN7A">
