            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCidddiy9X9fqxmBCyYguuE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Family and Medical Leave Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über Familien- und Krankenpflegezeit</skos:altLabel>
        <skos:altLabel>FMLA Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Family and Medical Leave Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Ausencia Familiar y Médica</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Licencia Familiar y Médica</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Licença Familiar e Médica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation au titre de la loi sur le congé familial et médical</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק החופשה המשפחתית והרפואית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">परिवार और चिकित्सा अवकाश अधिनियम दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">家庭和医疗假法索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家族・医療休暇法請求</skos:altLabel>
        <skos:definition>A Family and Medical Leave Act (FMLA) Claim is a legal claim made by an employee against their employer for violating their rights under the FMLA, which provides eligible employees with up to 12 weeks of unpaid leave per year for certain family and medical reasons.</skos:definition>
    </owl:Class>
    


