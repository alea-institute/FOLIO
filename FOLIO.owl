        <rdfs:label>Metal Can, Box, and Other Metal Container (Light Gauge) Manufacturing</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in forming light gauge metal containers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Uo4w8-vaTXe50UVioBCk1w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Uo4w8-vaTXe50UVioBCk1w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/q5EsLEDvRtayd-FvF3UGlw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=238290"/>
        <rdfs:label>Other Building Equipment Contractors</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in installing or servicing building equipment (except electrical, plumbing, heating, cooling, or ventilation equipment). The repair and maintenance of miscellaneous building equipment is included in this industry. The work performed may include new work, additions, alterations, maintenance, and repairs.</skos:definition>
        <skos:example>Automated and revolving door installation</skos:example>
        <skos:example>Boiler and pipe insulation installation</skos:example>
        <skos:example>Commercial-type door installation</skos:example>
        <skos:example>Conveyor system installation</skos:example>
        <skos:example>Dismantling large-scale machinery and equipment</skos:example>
        <skos:example>Elevator installation</skos:example>
        <skos:example>Escalator installation</skos:example>
        <skos:example>Gasoline pump, service station, installation</skos:example>
        <skos:example>Lightning protection equipment (e.g., lightning rod) installation</skos:example>
        <skos:example>Machine rigging</skos:example>
        <skos:example>Millwrights</skos:example>
        <skos:example>Overhead door, commercial- or industrial-type, installation</skos:example>
        <skos:example>Revolving door installation</skos:example>
        <skos:example>Satellite dish, household-type, installation</skos:example>
        <skos:example>Vacuum cleaning system, built-in, installation</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UrGyvt2fSYCnoBa8-ddxGA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UrGyvt2fSYCnoBa8-ddxGA">
