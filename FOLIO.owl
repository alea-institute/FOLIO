        <rdfs:label>Georgia Magistrate Court - Lowndes County</rdfs:label>
        <skos:definition>A court in Lowndes County, Georgia that has limited jurisdiction over certain civil and criminal cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d8AfbpUHoJd9WlsAzeOi6 -->

