        <rdfs:label>Eminent Domain</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Compulsory Purchase</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Desapropriação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Domaine éminent</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Dominio eminente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Dominio eminente</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Enteignung</skos:altLabel>
        <skos:altLabel>Fifth Amendment Takings Claim</skos:altLabel>
        <skos:altLabel>Taking</skos:altLabel>
        <skos:altLabel>Takings Claim</skos:altLabel>
        <skos:altLabel>Unlawful Taking</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רשות חקלאית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिष्ठित डोमेन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公有化</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">征用</skos:altLabel>
        <skos:definition>The concept of Eminent Domain (Taking) refers to the power of the government to take private property for public use, with just compensation to the owner, as authorized by the Constitution.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwd5PDZ9zTHHMKlx2ypxmf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwd5PDZ9zTHHMKlx2ypxmf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7iR8rxIoymNuxMi7I0oh1d"/>
        <rdfs:label>Auditability of an AI System</rdfs:label>
        <skos:altLabel>AI Assessability</skos:altLabel>
        <skos:altLabel>AI Evaluation Capability</skos:altLabel>
        <skos:altLabel>AI System Auditability</skos:altLabel>
        <skos:altLabel>AI System Inspectability</skos:altLabel>
        <skos:altLabel>AI System Reviewability</skos:altLabel>
        <skos:definition>Auditability refers to the ability of an AI system to undergo an assessment of its algorithms, data, and design processes to determine whether the system is functioning as intended. Auditability does not necessarily imply that information about business models and intellectual property must always be openly available, but ensuring traceability and logging mechanisms from the early design phase can help enable the system&apos;s auditability</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwlKpb9IShLYudIGwWGwoi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwlKpb9IShLYudIGwWGwoi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R83spgNoduHRVfnLcxe6nO5"/>
        <rdfs:label>oasis:LogicalFormula</rdfs:label>
        <skos:definition>A logical formula is a statement in legal language that expresses a relationship between different elements, such as conditions, actions, or outcomes, and is defined within the LegalXML OASIS SCHEMA.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwmq7JOH4W6fDC0SxZW4HS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwmq7JOH4W6fDC0SxZW4HS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Adyghe; Adygei</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Adiguês</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Adygeer</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Adyguéens</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アディゲ人</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿迪格人</skos:altLabel>
        <skos:definition>Adyghe or Adygei is a language belonging to the Language top-level class, spoken by the Adyghe people in the North Caucasus region of Russia, and is used in legal matters as a means of communication or evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwq7PYH0atP5hCMh8Bi2KQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwq7PYH0atP5hCMh8Bi2KQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
        <rdfs:label>Equitable Estoppel</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Equitable Estoppel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Estoppel Equitativo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Estoppel por equidade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Estoppel équitable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Impedimento Equitativo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Treu und Glauben basierte Verwirkung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אסטופל חוקי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायसंगत रोक</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公平制止</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正な制止</skos:altLabel>
        <skos:definition>Equitable Estoppel is a legal principle that prevents a party from denying or asserting a right, claim, or fact that is inconsistent with their previous conduct or representations, when such denial or assertion would result in injustice or harm to another party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwrtWEQ5TXWvWsESfmm7SL -->

