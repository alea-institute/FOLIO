        <skos:altLabel xml:lang="pt-br">Agente de auxílio ao obrigado deslealdade ao principal</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Agente de ayuda al obligado a la deslealtad con el principal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Agente de ayuda al obligado a la deslealtad con el principal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Obligor Aiding Agent Disloyalty to Principal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verpflichteter Beistandsagent Untreue gegenüber dem Prinzipal</skos:altLabel>
