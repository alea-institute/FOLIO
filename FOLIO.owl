        <skos:altLabel xml:lang="pt-br">Negligência do topógrafo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence du géomètre</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Surveyor Negligence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vermessungsfehler</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת הזהירות של המונח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सर्वेक्षक लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">测量师疏忽</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">測量士の過失</skos:altLabel>
        <skos:definition>Surveyor Negligence is a legal claim of negligence against a surveyor who fails to exercise reasonable care and skill in the performance of their duties, resulting in harm or loss to their client.</skos:definition>
    </owl:Class>
    


