        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCy69ZSLkXNMIWCj0nv9qzO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Terminated Employment Status</rdfs:label>
        <skos:definition>Terminated Employment Status indicates that an employee&apos;s relationship with an organization has formally ended, either due to resignation, layoffs, or dismissal. In this status, the employee is no longer on the payroll and usually loses eligibility for company-provided benefits, with the termination often documented for record-keeping and compliance purposes</skos:definition>
    </owl:Class>
    


