    <!-- https://folio.openlegalstandard.org/RF6A6cdB07cf150C9ec6683c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RF6A6cdB07cf150C9ec6683c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92xsHpdHu6BJjtepuRu"/>
        <dc:identifier>AGR-FORL</dc:identifier>
        <rdfs:label>Forestry and Logging Industry</rdfs:label>
        <skos:altLabel>Forestry and Logging</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forestry and Logging Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Forst- und Holzwirtschaft</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria Forestal y de la Madera</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria Forestal y de la Tala</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie forestière et d&apos;exploitation forestière</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de Silvicultura e Exploração Florestal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית יערות וכריתת עצים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वन और लॉगिंग उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">林业和采伐业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">林業および伐採業</skos:altLabel>
        <skos:definition>Industries in this group grow and harvest timber on a long production cycle (i.e., of 10 years or more). Long production cycles use different production processes than short production cycles, which require more horticultural interventions prior to harvest, resulting in processes more similar to those found in the Crop Production subsector. Consequently, Christmas tree production and other production involving production cycles of less than 10 years, are classified in the Crop Production group.</skos:definition>
        <skos:hiddenLabel>FORL</skos:hiddenLabel>
        <skos:prefLabel>Forestry and Logging</skos:prefLabel>
    </owl:Class>
    


