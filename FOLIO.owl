        <rdfs:label>Consent Judgment</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Consent Order</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Jugement par consentement mutuel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Sentencia de Consentimiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sentencia de Consentimiento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sentença consensual</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergleichsurteil</skos:altLabel>
