        <skos:altLabel xml:lang="de-de">Norwegisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ノルウェー語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">挪威语</skos:altLabel>
        <skos:definition>Norwegian (Language) is a structured system of communication consisting of grammar and vocabulary used in Norway and other Norwegian-speaking regions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8P1ofmH8rlGJmCYCSYvJuJ -->

