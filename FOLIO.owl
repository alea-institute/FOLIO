        <rdfs:label>Massachusetts Superior Court - Hampshire County</rdfs:label>
        <skos:definition>The Massachusetts Superior Court - Hampshire County is a court of general jurisdiction in Massachusetts that hears civil and criminal cases within Hampshire County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBczrcMtukvPo5IMjYt3e6k -->

