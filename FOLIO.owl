        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoltD3dXNzHF23P50ZXh6v"/>
        <rdfs:label>Legal Fraud</rdfs:label>
        <skos:altLabel>Fraud by Legal Service Provider</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fraude Legal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fraude Legal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fraude juridique</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fraude jurídica</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Legal Fraud</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtsbetrug</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הונאה משפטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी धोखाधड़ी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律欺诈</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法的詐欺</skos:altLabel>
        <skos:definition>Fraud committed by a legal service provider, which involves intentional deception or misrepresentation of facts to gain an unfair advantage or benefit in a legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KT28JDYyoIznmDdBft2Di -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KT28JDYyoIznmDdBft2Di">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGby6vUcfplpGBjYXaIo8i"/>
        <rdfs:label>General Release</rdfs:label>
        <skos:altLabel xml:lang="de-de">Allgemeine Freigabe</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">General Release</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lançamento geral</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Liberación General</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Liberación General</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Libération générale</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שחרור כללי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य रिलीज़</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">一般リリース</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">总发布</skos:altLabel>
        <skos:definition>A General Release is a legal document that releases a party from all known and unknown claims, demands, and liabilities arising from a particular matter, without specifying the particular claims or demands being released.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KYATnZcNxJsZ1MQBADZ0x -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KYATnZcNxJsZ1MQBADZ0x">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRfuF3AuewVT4SR15di375"/>
        <dc:identifier>ENVT-WATR</dc:identifier>
        <rdfs:label>Water Resources and Wetlands Law</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Droit des ressources en eau et des zones humides</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei de Recursos Hídricos e Áreas Úmidas</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ley de Recursos Hídricos y Humedales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Recursos Hídricos y Humedales</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wasserressourcen- und Feuchtgebietsrecht</skos:altLabel>
        <skos:altLabel>Water Resources and Wetlands</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Water Resources and Wetlands Law</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק משאבי מים ואגמים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जल संसाधन और झीलों कानून</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">水資源および湿地法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">水资源和湿地法</skos:altLabel>
        <skos:definition>Laws governing the ownership and use of water resources, including surface water and groundwater, oceans and seas.</skos:definition>
        <skos:hiddenLabel>WATR</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KYfSpf0bnFF3LV3RL3YU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KYfSpf0bnFF3LV3RL3YU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RFBFa05A797a0E88e0a5F580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>National Labor Relations Act Claim</rdfs:label>
        <skos:altLabel>NLRA Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">National Labour Relations Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Ley Nacional de Relaciones Laborales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Ley Nacional de Relaciones Laborales</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק הקשרי עבודה לאומי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">राष्ट्रीय श्रम संबंधी अधिनियम दावा</skos:altLabel>
        <skos:definition>A National Labor Relations Act (NLRA) claim is a legal action initiated by an employee or group of employees against an employer, alleging that the employer has violated their rights under the NLRA, which is a federal law enacted in 1935 to protect employees&apos; rights to engage in collective bargaining, join or form labor unions, and participate in other concerted activities related to their employment conditions. The NLRA also prohibits employers from interfering with these rights or retaliating against employees for exercising them. An NLRA claim may be filed with the National Labor Relations Board (NLRB), which investigates the allegations and can impose legal remedies, such as reinstatement, back pay, or policy changes, to ensure compliance with the law and the protection of employees&apos; rights.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KZwhAGHfOZiJ3JU4whCT4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KZwhAGHfOZiJ3JU4whCT4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWNAwJemBq0gDs7LXfCjnE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDFykS6WHtTXBe9eTuwqAqk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Railroad Negligence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Eisenbahnnachlässigkeit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia Ferroviaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia Ferroviaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência ferroviária</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence ferroviaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Railway Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת זהירות ברכבת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रेलवे लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">鉄道過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">铁路过失</skos:altLabel>
        <skos:definition>The concept of Railroad Negligence refers to the legal responsibility of a common carrier, such as a railroad company, to exercise reasonable care in the operation and maintenance of its equipment and facilities to prevent harm to passengers and others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KdA9imirXtH3TmNJAYhL8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KdA9imirXtH3TmNJAYhL8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NSnFDAuKIakuxCUbcQ2A2"/>
        <rdfs:label>Escrow Instructions Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;instructions d&apos;entiercement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Instruções de Custódia</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de instrucciones de depósito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de instrucciones de fideicomiso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Escrow Instructions Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Treuhandschaftsanweisungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הוראות אסקרו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एस्क्रो निर्देश शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エスクロー指示条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">托管指令条款</skos:altLabel>
        <skos:definition>An Escrow Instructions Clause is a provision in a contract that outlines the terms and conditions for the delivery of funds or property to a third-party escrow agent for safekeeping until certain conditions are met.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KdQLWwrvkyzohDgf48st7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KdQLWwrvkyzohDgf48st7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBCzyIAi2Hjl80hfQr8wAMR"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBUBqjNCYBI4CtLUcdAVYwy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RJL4HDUmZp1VEEZ7lCwSSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Intellectual Property Regulatory Documents</rdfs:label>
        <skos:altLabel>IP Applications</skos:altLabel>
        <skos:altLabel>IP Regulatory Document</skos:altLabel>
        <skos:definition>An Intellectual Property Regulatory Document, such as a Patent Application, Trademark Application, or Copyright Application, is a formal submission to a governmental body to secure legal protection for a specific piece of intellectual property. It outlines the details of the intellectual property, provides evidence of its originality or distinctiveness, and serves as the basis for granting or denying the intellectual property rights</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KfGheIupP0PG2C1rTmpgc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KfGheIupP0PG2C1rTmpgc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
        <rdfs:label>Common Law System</rdfs:label>
        <skos:altLabel>Case-Based Law</skos:altLabel>
        <skos:definition>Common Law is a legal system characterized by case law developed by judges through decisions in individual cases, rather than through legislative statutes or executive branch action. This system relies heavily on the doctrine of precedent, where past judicial decisions are authoritative in future cases.</skos:definition>
        <skos:prefLabel>Anglo-American Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KhOsYwbnspBGTPBjtzmKw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7KhOsYwbnspBGTPBjtzmKw">
