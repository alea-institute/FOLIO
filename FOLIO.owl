        <rdfs:label>International Development Cooperation Agency</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Agence de coopération pour le développement international</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Agencia de Cooperación para el Desarrollo Internacional</skos:altLabel>
