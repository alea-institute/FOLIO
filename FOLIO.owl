        <skos:altLabel xml:lang="ja-jp">ベルベル語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">柏柏尔语</skos:altLabel>
        <skos:definition>Berber languages are a group of languages spoken by various ethnic groups in North Africa, characterized by their unique grammar and vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCPQ0v8HMVppL2pm6EAcqOq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCPQ0v8HMVppL2pm6EAcqOq">
