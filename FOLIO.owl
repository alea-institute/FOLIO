        <skos:altLabel xml:lang="pt-br">Marwari</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">マールワーリー語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">马尔瓦里语</skos:altLabel>
        <skos:definition>Marwari is a language spoken in the Indian state of Rajasthan and surrounding areas.</skos:definition>
    </owl:Class>
    


