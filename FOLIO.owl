        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Tic Disorders</rdfs:label>
        <skos:definition>Tic Disorders involve the presence of repetitive, involuntary movements or vocalizations. They may include simple motor tics, such as blinking or head jerking, and complex tics, such as jumping or uttering words or phrases.</skos:definition>
        <skos:prefLabel>Motor and Vocal Tic Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwKxHFcrBZNohdOalDtvuZ -->

