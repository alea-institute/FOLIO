        <rdfs:label>Medical Provider Liability to Third Parties</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftung von medizinischen Dienstleistern gegenüber Dritten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Medical Provider Liability to Third Parties</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad de los proveedores médicos hacia terceros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad de los proveedores médicos hacia terceros</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade de provedores de serviços médicos para terceiros</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité des prestataires de soins médicaux envers les tiers</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות ספקי רפואה כלפי צדדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तृतीय पक्षों के लिए चिकित्सा प्रदाता दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">医疗服务提供者对第三方的责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第三者に対する医療提供者の責任</skos:altLabel>
        <skos:definition>The legal responsibility of a medical provider to compensate third parties for harm caused by their actions or omissions, including situations where the provider is not directly at fault but may be held liable under agency or vicarious liability principles.</skos:definition>
    </owl:Class>
    


