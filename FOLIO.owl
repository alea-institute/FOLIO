        <rdfs:label>Native Village of Gakona</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIGjHuSyrXSIgY9BHO5L0o -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIGjHuSyrXSIgY9BHO5L0o">
