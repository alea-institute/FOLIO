    <!-- https://folio.openlegalstandard.org/-6FDm3tWRequJ90cvT0ySQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/-6FDm3tWRequJ90cvT0ySQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/SMxNxWmNRdaY3reO9Yl_2A"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=111336"/>
        <rdfs:label>Fruit and Tree Nut Combination Farming</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in growing a combination of fruit(s) and tree nut(s) with no one fruit (or family of fruit) or family of tree nuts accounting for one-half of the establishment&apos;s agricultural production (i.e., value of crops for market).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/-7Pf8WICQOGniC9cMZ_Cvg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/-7Pf8WICQOGniC9cMZ_Cvg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ohVoZyP5T5evUBYNm7bTfQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561440"/>
        <rdfs:label>Collection Agencies</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in collecting payments for claims and remitting payments collected to their clients.</skos:definition>
        <skos:example>Account or delinquent account collection services</skos:example>
        <skos:example>Bill or debt collection services</skos:example>
        <skos:example>Tax collection services on a contract or fee basis</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/0BVYczFOT-KvS9TMwDMefQ -->

