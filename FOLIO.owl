        <rdfs:label>Motion to Disqualify Counsel</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ablehnung des Anwalts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para descalificar al abogado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para descalificar al abogado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour disqualifier l&apos;avocat</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Disqualify Counsel</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para desqualificar o advogado</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפטר את היועץ המשפטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वकील को अस्थायी रूप से हटाने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">弁護士の資格を停止する動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销律师资格动议</skos:altLabel>
        <skos:definition>A Motion to Disqualify Counsel is a legal request to remove an attorney from a case due to a conflict of interest or other ethical violation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7nS49EDFV5ikI46xI7eHx1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7nS49EDFV5ikI46xI7eHx1">
