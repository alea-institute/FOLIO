            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Unauthorized Practice of Law</rdfs:label>
        <skos:altLabel>Unlicensed Legal Practice</skos:altLabel>
        <skos:definition>The Unauthorized Practice of Law occurs when an individual or entity engages in legal activities without being licensed or authorized to practice law in a specific jurisdiction. This typically includes offering legal advice, representing clients in legal proceedings, or preparing legal documents for others without the requisite legal qualifications or accreditation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rs8klnT0vntAbsg0p8rLwn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rs8klnT0vntAbsg0p8rLwn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBxw7BF15bDA0Ifn2vOrC8h"/>
        <rdfs:label>Georgia District Court - Coffee County</rdfs:label>
        <skos:definition>Georgia District Court - Coffee County: A specific court within the Georgia District Court system that has jurisdiction over legal matters within Coffee County, Georgia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rs9t8ypW3DzT0VtG9RIAfi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rs9t8ypW3DzT0VtG9RIAfi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RyXFkz3behDLKJusiUFxnh"/>
        <rdfs:label>Riparian Real Estate Asset</rdfs:label>
        <skos:altLabel>Lakeside Estate</skos:altLabel>
        <skos:altLabel>Riparian Property</skos:altLabel>
        <skos:altLabel>Riverfront Property</skos:altLabel>
        <skos:altLabel>Waterside Land</skos:altLabel>
        <skos:definition>A Riparian Real Estate Asset refers to property that is situated along the banks of a natural watercourse, such as a river, stream, or lake. These assets often come with specific water rights and obligations related to the use, conservation, and management of the adjoining water body.</skos:definition>
        <skos:prefLabel>Waterfront Real Estate</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsAMZy74rL2SqcTNjPKZJZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsAMZy74rL2SqcTNjPKZJZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:label>Debtor&apos;s Election of Small Business Designation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Debtor&apos;s Election of Small Business Designation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Elección del Deudor de la Designación de Pequeña Empresa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Elección del Deudor de la Designación de Pequeña Empresa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Eleição de Designação de Pequena Empresa do Devedor</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kleine-Unternehmen-Bezeichnungswahl des Schuldners</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Élection de désignation de petite entreprise du débiteur</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בחירת החייב של תיעוד עסק קטן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">देयकारी की छोटे व्यवसाय निर्देशन के चुनाव</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">债务人选择小企业认定</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債務者の小規模事業者指定の選択</skos:altLabel>
        <skos:definition>The Debtor&apos;s Election of Small Business Designation is a legal document filed in bankruptcy and restructuring cases by a debtor who qualifies as a small business under the Bankruptcy Code, allowing them to take advantage of certain provisions and procedures specific to small businesses.</skos:definition>
    </owl:Class>
    


