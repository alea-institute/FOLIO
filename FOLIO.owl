        <skos:altLabel xml:lang="de-de">Kasachisch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Kazakh</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">カザフ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">哈萨克语</skos:altLabel>
