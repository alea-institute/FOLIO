        <skos:altLabel xml:lang="es-mx">Cláusula de compensación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de compensação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right of Set Off Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות הפיכת חובות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेट ऑफ क्लॉज का अधिकार</skos:altLabel>
