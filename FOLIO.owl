        <skos:altLabel xml:lang="es-es">Impuesto total sobre las tarifas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Impuesto total sobre las tarifas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Taxe totale sur les frais</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Total Tax on Fees</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מס כללי על עמלות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फीस पर कुल कर</skos:altLabel>
