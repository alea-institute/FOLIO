        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP"/>
        <rdfs:label>&quot;Materiality&quot; Based Antitrust Standard</rdfs:label>
        <skos:altLabel xml:lang="zh-cn">&apos;实质性&apos;反垄断标准</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Estándar Antimonopolio Basado en la Materialidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándar Antimonopolio Basado en la Materialidad</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kartellrechtlicher Standard der &apos;Materialität&apos;</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Materiality Based Antitrust Standard</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Norme antitrust de &apos;Matérialité&apos;</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Padrão antitruste de &apos;Materialidade&apos;</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקן נגד- trust המבוסס על חומריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पदार्थता आधारित विपणि नीति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">「実質性」に基づく独占禁止法基準</skos:altLabel>
        <skos:definition>A &quot;Materiality&quot; Based Antitrust Standard is a legal concept that sets a threshold for determining whether certain conduct or information is significant enough to be considered in antitrust analysis, and only conduct or information that meets this threshold will be taken into account.</skos:definition>
    </owl:Class>
    


