        <rdfs:label>Specific Bequest</rdfs:label>
        <skos:altLabel>Designated Gift</skos:altLabel>
        <skos:definition>A Specific Bequest is a provision in a will or trust that designates a particular item or specific piece of property to be given to a designated beneficiary. This type of bequest clearly identifies the asset to ensure the precise distribution of that item upon the testator&apos;s death.</skos:definition>
        <skos:prefLabel>Specific Testamentary Gift</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDEuCSt5UIdpDBrjybVyOEE -->

