        <skos:altLabel xml:lang="he-il">אירוע נדחה / מתוזמן מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इवेंट स्थगित / पुनर्निर्धारित</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">イベント延期 / 再スケジュール</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">活动延期 / 重新安排</skos:altLabel>
