    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Ffvitj4GS7KCnvlsGsMJwQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Ffvitj4GS7KCnvlsGsMJwQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8q7pmb15BQ563KmqZxMC3W"/>
