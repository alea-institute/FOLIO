        <skos:altLabel xml:lang="pt-br">Litigância conjunta</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verfahrensverbindung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צפיפות תביעות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जोइंडर</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">共同訴訟</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加入诉讼</skos:altLabel>
        <skos:definition>The concept of Joinder refers to the legal process of combining two or more legal cases or parties into a single action, typically to promote efficiency and avoid inconsistent outcomes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8edEC4B9Q4JOiWbVNvi30n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8edEC4B9Q4JOiWbVNvi30n">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBYQBHCTDnnpanK0HJ0I7w"/>
        <rdfs:label>Echinoderms</rdfs:label>
        <skos:definition>Echinoderms are a phylum of marine invertebrates known as Echinodermata, characterized by their radial symmetry, a water vascular system, and a calcareous endoskeleton. This group includes starfish, sea urchins, sand dollars, and sea cucumbers, and they play vital roles in marine ecosystems.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8efwamQixCS0ygmspRxWGF -->

