        <rdfs:label>Advertising, Public Relations, and Related Services</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in advertising, public relations, and related services, such as media buying, independent media representation, indoor and outdoor display advertising, direct mail advertising, advertising material distribution services, and other services related to advertising.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/S1DzIgwxSme60dIu3gySXg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/S1DzIgwxSme60dIu3gySXg">
