            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>False Designation of Origin</rdfs:label>
        <skos:altLabel xml:lang="de-de">Falsche Herkunftsbezeichnung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Indication de provenance fausse ou erronée</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indicação Falsa de Origem</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">虚假原产地标识</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">誤った原産地表示</skos:altLabel>
        <skos:definition>A False Designation of Origin claim may be filed when an entity falsely represents the origin of their goods or services, misleading consumers and potentially causing damage to the business or reputation of the rightful owner of the trademark. In the United States, this type of claim is typically brought under the Lanham Act.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jRjFoJccMwxrgHu0uUPQb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jRjFoJccMwxrgHu0uUPQb">
