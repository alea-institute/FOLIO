        <rdfs:label>Retroactive Effectiveness Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;effet rétroactif</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Efectividad Retroactiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Efectividad Retroactiva</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Eficácia Retroativa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Retroactive Effectiveness Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rückwirkungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תוקף חזרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्ववत प्रभावशीलता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">追溯效力条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">追認効力条項</skos:altLabel>
        <skos:definition>A Retroactive Effectiveness Clause is a provision in a contract that makes it effective from a date before it was actually signed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8lSNI0PHUoSSYL7VtPBoM8 -->

