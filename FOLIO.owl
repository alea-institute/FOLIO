    <!-- https://folio.openlegalstandard.org/RKppctNnwfRJlk3uGTiJ5M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKppctNnwfRJlk3uGTiJ5M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
        <rdfs:label>Professional Conduct Claims</rdfs:label>
        <skos:definition>Professional Conduct Claims refer to legal claims or allegations made against laypersons or professionals, asserting that they have breached established standards of practice, ethics, or legal requirements for a field. These claims can encompass a range of violations, including malpractice, unauthorized practice, and other breaches of professional duties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKqMtq4VODwvUGdxe07Jf6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKqMtq4VODwvUGdxe07Jf6">
