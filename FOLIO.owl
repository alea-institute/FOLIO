        <skos:altLabel xml:lang="ja-jp">アッサム語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿萨姆语</skos:altLabel>
        <skos:definition>Assamese (Language) refers to a structured system of communication that consists of grammar and vocabulary specific to the Assam region of India.</skos:definition>
    </owl:Class>
    


