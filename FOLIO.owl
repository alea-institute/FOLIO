    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6bIH76tDZ6TdfHvYdbyj0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6bIH76tDZ6TdfHvYdbyj0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E107 Delivery services/messengers</rdfs:label>
        <skos:definition>Delivery services/messengers refer to expenses incurred for the transportation of documents or packages from one location to another, and are a subcategory of expenses in legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6dekjtZI0W9W2K6JJ2jcO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6dekjtZI0W9W2K6JJ2jcO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:label>Retirement Plan Disclosure</rdfs:label>
        <skos:altLabel>Employee Pension Report</skos:altLabel>
        <skos:definition>A Retirement Plan Disclosure, known in the U.S. as a Form 11-K, is an annual report detailing the financial statements and other information regarding an employee benefit plan sponsored by a publicly traded company. The 11-K provides transparency into the assets, liabilities, income, expenses, and operations of the retirement plan. Form 11-K is a specialized financial disclosure document filed with the U.S. Securities and Exchange Commission (SEC), detailing the financial status of a company&apos;s employee benefit plans, such as 401(k) plans. It is an American regulatory requirement aimed at providing transparency concerning the financial health of these plans.</skos:definition>
        <skos:prefLabel>11-K</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6ePdof62o3oIWPXS4Iezm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6ePdof62o3oIWPXS4Iezm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC6vjtn3GZLRw0qRl5YjMwV"/>
        <rdfs:label>Individual Retirement Account</rdfs:label>
        <skos:definition>An Individual Retirement Account (IRA) is a personal savings account that offers tax advantages for individuals to save money for retirement. It allows contributions to grow tax-deferred until withdrawal, either in traditional IRAs (pre-tax contributions) or Roth IRAs (after-tax contributions), with different tax implications depending on the type chosen</skos:definition>
        <skos:prefLabel>IRA</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6gYuqS2Q7GVQz2VN2ivEr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6gYuqS2Q7GVQz2VN2ivEr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion for Moratorium</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Moratorium</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Moratoria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Moratoria</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Moratorium</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour un moratoire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Moratória</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת עצירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवरोध के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">モラトリアムの申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">暂停令动议</skos:altLabel>
        <skos:definition>A Motion for Moratorium is a legal request made in a bankruptcy case to temporarily halt or suspend certain actions or proceedings, such as debt collection or foreclosure, in order to provide the debtor with relief and an opportunity to reorganize their finances.</skos:definition>
    </owl:Class>
    


