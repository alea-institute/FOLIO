    <!-- https://folio.openlegalstandard.org/R7Nem8wZFI0MFQYNxH1VhwT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Nem8wZFI0MFQYNxH1VhwT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9g0tsF68ZfL1dvdj4jdg1t"/>
        <rdfs:label>Non-Standard Contractual Terms</rdfs:label>
        <skos:altLabel>Bespoke Contract Terms</skos:altLabel>
        <skos:altLabel>Custom Contract Terms</skos:altLabel>
        <skos:definition>Non-Standard Contractual Terms refer to contract specifications that are variable and customized, differing from the standard predefined terms. These contracts include options traded on exchanges with non-standard delivery or expiry terms, tailored to meet specific needs and preferences of the contracting parties.</skos:definition>
        <skos:prefLabel>Customized Financial Terms</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NhrfIR7xbRa4UTFkToqsY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NhrfIR7xbRa4UTFkToqsY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3E5f6b5B7244860b4e4B5e3"/>
        <rdfs:label>Florida Court of Appeals - 1st District</rdfs:label>
        <skos:definition>The Florida Court of Appeals - 1st District is a specific court within the Florida District Court of Appeals that hears appeals from trial courts in its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Nidnq88zIxptlouGMZNg1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Nidnq88zIxptlouGMZNg1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xekNn7K6SxToo5ArjIsTX"/>
        <rdfs:label>Motion to File Complaint</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einreichung einer Beschwerde</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Presentar una Queja</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer une plainte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Complaint</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para apresentar queixa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para Presentar una Denuncia</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להגשת תלונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शिकायत दाखिल करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交投诉动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">苦情申立の提出</skos:altLabel>
        <skos:definition>A Motion to File Complaint is a formal request made to a court to allow a plaintiff to submit a complaint or petition for legal action.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NkMt6XJKd4fSolKqqOy5B -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NkMt6XJKd4fSolKqqOy5B">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7f6bqEjMQDMYjlvg0WINGf"/>
        <rdfs:label>General Sales and Consumption Tax Payment</rdfs:label>
        <skos:altLabel>Comprehensive Sales Tax Payment</skos:altLabel>
        <skos:altLabel>General Taxes</skos:altLabel>
        <skos:altLabel>General Transaction Tax Payment</skos:altLabel>
        <skos:definition>General Sales and Consumption Tax Payment includes all taxes, other than import and export duties, levied on the production, leasing, transfer, delivery, or sale of a wide range of goods and the rendering of a wide range of services. These taxes apply to both domestically produced and imported goods, irrespective of the stage of production or distribution at which they are levied. This category covers value-added taxes, sales taxes, and multi-stage cumulative taxes, including adjustments for border transactions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NkdM8YhcmzfiWmRifZdxG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NkdM8YhcmzfiWmRifZdxG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9dPGGL1IRXLLjb1323qtj6"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RkDm9J359mc6mQ5uj6uiXq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Director’s Liability to Shareholders</rdfs:label>
        <skos:definition>The legal responsibility of a director to act in the best interests of the shareholders of a corporation, and the potential consequences if they fail to do so.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Noco0WzoPRAfLQ1iJkI2t -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Noco0WzoPRAfLQ1iJkI2t">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmiYQJshZzYvIsqEWLjj1x"/>
        <rdfs:label>International Traffic in Arms Regulations (ITAR) Claim</rdfs:label>
        <skos:altLabel>Arms Export Control Claim</skos:altLabel>
        <skos:altLabel>Defense Export Violation Claim</skos:altLabel>
        <skos:altLabel>ITAR Claim</skos:altLabel>
        <skos:altLabel>ITAR Violation Claim</skos:altLabel>
        <skos:definition>An ITAR Claim arises when an individual or entity violates the International Traffic in Arms Regulations, which control the export and import of defense-related articles and services. This claim involves allegations of unauthorized export, re-export, or transfer of defense articles or technical data to foreign nationals or countries.</skos:definition>
        <skos:prefLabel>International Arms Control Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NramUMccSNnkd1qOVw4ay -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NramUMccSNnkd1qOVw4ay">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUuDgbKnORPEWWjF69P5dO"/>
        <rdfs:label>Certified Integration Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Certified Integration Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;intégration certifiée</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Integración Certificada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Integración Certificada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de integração certificada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zertifizierte Integrationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אינטגרציה מאושר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रमाणित एकीकरण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">認定統合条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">认证集成条款</skos:altLabel>
        <skos:definition>A Certified Integration Clause is a specific type of Integration Clause in a legal contract that confirms the completeness of the agreement and prevents any prior or contemporaneous agreements from being considered part of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NuHbXZluNRzq9D1bLM716 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NuHbXZluNRzq9D1bLM716">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ4HPUl2DrL4G30lmoFKJN"/>
        <rdfs:label>Agreement Attributes</rdfs:label>
        <skos:altLabel>Agreement Characteristics</skos:altLabel>
        <skos:altLabel>Contractual Attributes</skos:altLabel>
        <skos:definition>Agreement Attributes refer to the characteristics and forms in which agreements can exist, defining how they are communicated and understood between parties (e.g., whether the is agreement is oral or written). These attributes determine the enforceability and clarity of the agreements within legal contexts.</skos:definition>
        <skos:prefLabel>Contract Attributes</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NwY5UT07qF3VkI8MYarxj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NwY5UT07qF3VkI8MYarxj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8"/>
        <rdfs:label>Spoliation of Evidence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Beweismittelunterdrückung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Destrucción de pruebas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Destruction de preuves</skos:altLabel>
        <skos:altLabel>Destruction of Evidence</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Destruição de provas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Deterioro de pruebas</skos:altLabel>
        <skos:altLabel>Spoliation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Spoliation of Evidence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגיעה בראיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साक्ष्यों का नष्ट करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証拠隠滅</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">证据毁灭</skos:altLabel>
        <skos:definition>The intentional or negligent destruction or alteration of evidence by a party in a legal matter, which may result in sanctions or adverse inferences against that party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <rdfs:label>Blood Disorders</rdfs:label>
        <skos:altLabel>Hematopathy</skos:altLabel>
        <skos:definition>Hematological Disorders encompass a range of conditions affecting the blood and its components, including red blood cells, white blood cells, platelets, and plasma. These disorders can impact blood production, function, and composition, leading to symptoms such as anemia, bleeding, or increased risk of infection.</skos:definition>
        <skos:prefLabel>Hematological Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7O4HXKi7dDm0Q2urKsQLoE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7O4HXKi7dDm0Q2urKsQLoE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mCB7w7tqtq6yOWvTxdMJI"/>
        <rdfs:label>Radio Broadcast</rdfs:label>
        <skos:altLabel>Radio Broadcasting</skos:altLabel>
        <skos:altLabel>Radio Transmission</skos:altLabel>
        <skos:definition>A Radio Broadcast is the transmission of audio content via radio waves to reach a wide audience, typically through AM or FM frequencies. This medium delivers a variety of programming such as news, music, talk shows, and advertisements, and can be received on radios, car stereos, and internet streaming platforms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7O7as1yRGQddK7A38HaPOM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7O7as1yRGQddK7A38HaPOM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9OVY5GWczMSrxKsf8cfgpq"/>
        <rdfs:label>Lease Abstract</rdfs:label>
        <skos:altLabel>Lease Digest</skos:altLabel>
        <skos:altLabel>Tenancy Contract Overview</skos:altLabel>
        <skos:definition>A Lease Abstract is a summary document that highlights the key terms, conditions, and provisions of a lease agreement. It serves as a quick reference guide for both landlords and tenants, often utilized for portfolio management or due diligence.</skos:definition>
        <skos:prefLabel>Lease Summary</skos:prefLabel>
    </owl:Class>
    


