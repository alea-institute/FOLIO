        <skos:altLabel xml:lang="en-gb">Guide</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Guide</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Guía</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Guía</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Leitfaden</skos:altLabel>
        <skos:altLabel>Practice Note</skos:altLabel>
        <skos:altLabel>Standard Form</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מדריך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गाइड</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ガイド</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">指南</skos:altLabel>
        <skos:definition>Document describing how to do a particular legal process, often containing links to other documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBwVZgUU1nbWTCfkaoaMilD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBwVZgUU1nbWTCfkaoaMilD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pssJwbQ89wfcLFqq9DWIw"/>
        <rdfs:label>Asset-Backed Commercial Paper</rdfs:label>
        <skos:definition>ABCP is a type of short-term debt instrument that is backed by a pool of financial assets, such as trade receivables, auto loans, credit card debt, residential mortgages, or other asset-backed securities (ABS). The maturity of ABCP typically ranges from 1 to 270 days, with an average of around 30 days.</skos:definition>
        <skos:prefLabel>ABCP</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBwZjjQmoJgjgi1yx1YBOm7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBwZjjQmoJgjgi1yx1YBOm7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8Eoebh7pvPtkWrkUTgecmu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCwT0yMShmi5V0Q2Y9Yn070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Unpaid Wages Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf unbezahlten Lohn</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de salarios impagados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação de salários não pagos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de salarios no pagados</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de salaires impayés</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unpaid Wages Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על שכר לא משולם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवैतनिक वेतन दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未付工资索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">未払い賃金請求</skos:altLabel>
        <skos:definition>An unpaid wages claim is a legal action initiated by an employee against their employer for not paying the employee their earned wages. The claim typically arises when an employer does not comply with applicable laws, which require employers to pay employees for all hours worked and to pay at least the minimum wage rate. The claim can include allegations of employers failing to pay the employee their regular pay, overtime pay, earned commissions, or other forms of compensation. Employees may also bring unpaid wages claims for non-payment of bonuses or other benefits owed to them.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBwcQUr7RyVgoK5QL9jKsEy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBwcQUr7RyVgoK5QL9jKsEy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>No Delegation Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-délégation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de No Delegación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de No Delegación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não delegação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Keine Delegationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Delegation Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוראת אי העברה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिकार अनुबंध नहीं है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">委任禁止条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无授权条款</skos:altLabel>
        <skos:definition>A &quot;No Delegation Clause&quot; is a provision in a contract that prohibits one party from transferring their obligations or responsibilities to another party without the consent of the other party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBweKrw4uyPC8etlC1XjxkG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBweKrw4uyPC8etlC1XjxkG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7l492OzFfZUEluIFBwy3xI"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAoFbSK8WP6xJyVrgQd5PZ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Assumption of Risk</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Assomption de risque</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Assumption of Risk</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Assunção de risco</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Asunción del riesgo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Asunción del riesgo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Risikoverteilung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הנחת סיכון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जोखिम उतारना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リスクの仮定</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">风险承担</skos:altLabel>
        <skos:definition>Assumption of Risk is a legal defense that asserts that the plaintiff voluntarily and knowingly assumed the risks associated with a particular activity or situation, and therefore cannot hold the defendant liable for any resulting harm or injury.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBweqaHNxwkEbdKlg1Wthoc -->

