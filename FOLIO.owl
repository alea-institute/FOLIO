        <skos:altLabel xml:lang="de-de">Verzichts- und Zurückverweisungsvereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם להתחמק ולהחזיר לדיון מחדש</skos:altLabel>
