        <rdfs:label>245 Tort Product Liability (PACER NoS)</rdfs:label>
        <skos:definition>Action alleging harm by an unsafe product based on negligence, breach of warranty, misrepresentation, and strict tort liability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RxEOWl1tQm6lA3cA2DswXL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RxEOWl1tQm6lA3cA2DswXL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9zfbONJISnRjpI4gufgjAU"/>
        <rdfs:label>Remote Employment</rdfs:label>
        <skos:altLabel>Offsite Employment</skos:altLabel>
        <skos:definition>Remote Employment refers to a work arrangement where the employee performs job tasks from a location outside the employer&apos;s physical facilities, often from home or another suitable environment. This setup provides greater flexibility but may require specific technologies and self-discipline to maintain productivity and communication with the team.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RxFJJ2HOrihyVsEGc2lKsa -->

