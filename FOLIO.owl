        <skos:altLabel xml:lang="ja-jp">弁護士の辞任申立書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤回律师申请书</skos:altLabel>
        <skos:definition>A Motion to Withdraw as Counsel is a formal request made by an attorney to be removed from representing a client in a legal matter.</skos:definition>
        <skos:prefLabel>Motion to be Relieved As Counsel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCI91rMkAOuTZDm7urpOuEX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCI91rMkAOuTZDm7urpOuEX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7yKB3SkQ5bQZsUOV5R0jT1"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Concealing Stolen Property</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Concealing Stolen Property</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Encubrimiento de bienes robados</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ocultación de bienes robados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ocultação de propriedade roubada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Recel de biens volés</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verbergen von gestohlenem Eigentum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">החבאת רכוש מגנוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चोरी की संपत्ति छिपाना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">盗品隠匿</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">隐瞒赃物</skos:altLabel>
        <skos:definition>The act of hiding or keeping stolen property secret, with the intention of preventing its discovery or recovery by the rightful owner or authorities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCI9k29ZPLoeUrnsjMQT1DS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCI9k29ZPLoeUrnsjMQT1DS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ZlXt0J1JMbXm6T0xEg2SO"/>
        <rdfs:label>Participating Dividend Payment</rdfs:label>
        <skos:altLabel>Participating Dividend Payment</skos:altLabel>
        <skos:definition>Participating Dividend Payment refers to a type of dividend income where preferred shareholders, in addition to receiving their fixed rate of prior dividend, also share in further dividend distributions and capital distributions with common shareholders. This feature allows preferred shareholders to benefit from the company&apos;s profitability beyond the fixed dividend rate.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCIBJRAcSodX6OGvtioSZLY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCIBJRAcSodX6OGvtioSZLY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Rdvjz7Q76QLZXnSJ66z40"/>
        <rdfs:label>Privatization</rdfs:label>
        <skos:altLabel>Denationalization</skos:altLabel>
        <skos:altLabel>Private Sector Takeover</skos:altLabel>
        <skos:definition>Privatization is the process of transferring ownership and management of a business, enterprise, or public service from the government to private individuals or entities. This often aims to improve efficiency, foster competition, and reduce public sector burden.</skos:definition>
        <skos:prefLabel>Private Sector Integration</skos:prefLabel>
    </owl:Class>
    


