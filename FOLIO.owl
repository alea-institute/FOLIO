        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCTnebwmInNgHYwFLgAOf0z"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Failure to Provide Employment Records Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Vorlage von Beschäftigungsunterlagen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Failure to Provide Employment Records Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por falta de entrega de registros de empleo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por falta de entrega de registros de empleo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de Falha em Fornecer Registros de Emprego</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation pour non-fourniture de dossiers d&apos;emploi</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על כשל בספק רשומות עסקיות של עובדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रोजगार रिकॉर्ड प्रदान न करने का दावा फेल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未能提供就业记录索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">雇用記録提供不履行請求</skos:altLabel>
        <skos:definition>A failure to provide employment records claim is a legal action initiated by an employee against their employer for not furnishing access to, or copies of, certain employment documents as required by law. These documents may include payroll records, timekeeping data, or personnel files, and the claim typically arises when an employer either refuses or neglects to provide the requested information within the specified time frame mandated by applicable laws.</skos:definition>
    </owl:Class>
    


