        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#before"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RB2sCkb5dZ38tzkavJZPazV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Production of Documents Practice</rdfs:label>
        <skos:altLabel>Production of Documents</skos:altLabel>
        <skos:altLabel>Production of Documents Service</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de production de documents</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Praxis der Dokumentenproduktion</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Production of Documents Practice</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de producción de documentos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de producción de documentos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de produção de documentos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ייצור מסמכים פרקטיקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दस्तावेज़ उत्पादन प्रैक्टिस</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">文件制作实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書作成の実践</skos:altLabel>
        <skos:definition>The Production of Documents Practice refers to the specific legal practice of collecting and producing documents in the course of a legal matter, which falls under the broader category of Document Collection and Production Practice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbn4C7kOPV11Bo2PwVp3IL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbn4C7kOPV11Bo2PwVp3IL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCtUZjZqZ1lszDFiDOLUuTh"/>
        <rdfs:label>Illinois Circuit Court - Monroe County (20th Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
        <rdfs:label>Recognition of Foreign Restructuring Objectives</rdfs:label>
        <skos:altLabel>Foreign Insolvency Recognition</skos:altLabel>
        <skos:altLabel>International Bankruptcy Recognition</skos:altLabel>
        <skos:definition>Recognition of foreign restructuring involves the acknowledgment and enforcement of a foreign insolvency proceeding by domestic courts. In the U.S., Chapter 15 of the Bankruptcy Code facilitates this process, allowing foreign debtors to access U.S. courts to protect their assets and restructure their debts under international cooperation principles.</skos:definition>
        <skos:prefLabel>Chapter 15 Objectives</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbwTZhFW2BCJ7Svgudx63U -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbwTZhFW2BCJ7Svgudx63U">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDOzei3yd81OLmFKtURxjZx"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Reverse Mortgage Foreclosure</rdfs:label>
        <skos:definition>Reverse Mortgage Foreclosure is the legal process in which a lender takes possession of a property after the borrower, typically an older homeowner, fails to meet the conditions of the reverse mortgage agreement. This can occur due to reasons like the death of the borrower, failure to pay property taxes or insurance, or permanently moving out of the home. The property is then sold to repay the loan balance and any associated costs</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbyX1SuwIsejbZGgdJSKaT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbyX1SuwIsejbZGgdJSKaT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
        <rdfs:label>Agent’s Liability for Principal’s Obligation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Agent’s Liability for Principal’s Obligation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftung des Agenten für die Verpflichtungen des Prinzipals</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad del agente por la obligación del principal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad del agente por la obligación del principal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade do agente pelas obrigações do principal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité de l&apos;agent pour les obligations du mandant</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות הסוכן על התחייבות המנהל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रधान के अधिकार के लिए एजेंट की जिम्मेदारी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">代理人の委託者の義務に対する責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">代理人对委托人义务的责任</skos:altLabel>
        <skos:definition>The concept of &quot;Agent&apos;s Liability for Principal&apos;s Obligation&quot; refers to the legal responsibility of an agent to fulfill the obligations of their principal, such as paying debts or fulfilling contracts, and being held liable for any failure to do so.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsJ6DupkWKlUlCHH0Ycxvp"/>
        <rdfs:label>Civil Remedies / Relief Sought</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Civil Remedies / Relief Sought</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Recours civils / Mesures de réparation demandées</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Remedios Civiles / Alivio Solicitado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Remedios Civiles / Alivio Solicitado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Remédios / Alívio Civil Solicitado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zivilrechtliche Abhilfe / beantragte Entlastung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיצויים אזרחיים / עזרה מבוקשת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नागरिक उपाय / राहत अर्जित</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民事救济/寻求救济</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">民事救済/求められる救済</skos:altLabel>
        <skos:definition>Civil Remedies/Relief Sought refers to the legal actions or requests made by a party in a civil litigation case to obtain a specific remedy or relief, such as monetary damages, injunctions, or declaratory judgments.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDc0eHNQ19MPBBKXzPjzhX8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDc0eHNQ19MPBBKXzPjzhX8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8J1Ftzgc2Gsee7MqAQEMM"/>
        <rdfs:label>Retaliatory Constructive Discharge</rdfs:label>
        <skos:altLabel xml:lang="es-es">Despido Constructivo Retaliatorio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dispensa construtiva retaliatória</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Licenciement constructif de représailles</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Retaliatory Constructive Discharge</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Terminación Laboral Constructiva Retaliatoria</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergeltung durch konstruktive Entlassung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים בנימה מוקדמת ונקמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिशोधात्मक रचनात्मक नौकरी छोड़ देना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">報復的構成解雇</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">报复性构造性解雇</skos:altLabel>
        <skos:definition>An employer&apos;s action of making working conditions intolerable for an employee with the intention of forcing them to quit, in response to the employee&apos;s protected activity, such as reporting discrimination or harassment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDc18tvw80m2XZa1y9Q1pGq -->

