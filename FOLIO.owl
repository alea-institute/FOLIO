    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RWYR2MYY5JsW5YkzH1kx0M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RWYR2MYY5JsW5YkzH1kx0M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RpiyvcnyPAZ5hygNt0zO3j"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_21"/>
        <rdfs:label>Chronic Soft Tissue Surgical Intervention</rdfs:label>
        <skos:definition>A soft tissue injury or abnormality under continuing surgical management involves damage or dysfunction affecting non-bone structures such as muscles, tendons, ligaments, or skin that requires ongoing surgical intervention. This management is aimed at repairing or reconstructing the damaged soft tissues and addressing any related complications or functional impairments.</skos:definition>
        <skos:prefLabel>Soft Tissue Injury or Abnormality Under Continuing Surgical Management</skos:prefLabel>
    </owl:Class>
    


