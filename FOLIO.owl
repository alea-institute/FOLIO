        </rdfs:subClassOf>
        <rdfs:label>Small Claims</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Demandas de pequeñas reclamaciones / Demandas de conciliación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kleine Forderungen / Schlichtungsansprüche</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pequenas causas / Reivindicações de conciliação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Petites créances / Demandes de conciliation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de pequeñas cuantías / Reclamaciones de conciliación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Small Claims / Conciliation Claims</skos:altLabel>
        <skos:altLabel>Warrant in Debt</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות קטנות / תביעות פיוס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">छोटे दावों / सुलह के दावे</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">小額訴訟 / 調停請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">小额索赔 / 调解索赔</skos:altLabel>
        <skos:definition>A type of civil claim that involves disputes of a relatively low monetary value and is resolved through a simplified and informal process known as conciliation.</skos:definition>
        <skos:prefLabel>Conciliation Claims</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhkRzl30PudT2hM5OESMlu -->

