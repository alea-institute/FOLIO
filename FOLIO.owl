        <rdfs:label>Wasting Another&apos;s Property or Inheritance</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Desperdiciar la propiedad o herencia de otro</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Desperdício da propriedade ou herança de outra pessoa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Gaspillage des biens ou de l&apos;héritage d&apos;autrui</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Malgastar la propiedad o herencia de otro</skos:altLabel>
