        <rdfs:label>Buginese</rdfs:label>
        <skos:altLabel xml:lang="de-de">Buginesisch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Bugis</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Bugis</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ブギ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">布吉语</skos:altLabel>
        <skos:definition>Buginese is a structured system of communication, both written and spoken, that belongs to the Language top-level class and is used in legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMJlgPsFOJLiurc5NOuHDe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMJlgPsFOJLiurc5NOuHDe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7gFwngdoBeiYXxslm69WNk"/>
        <rdfs:label>State-run Pension Account</rdfs:label>
        <skos:altLabel>Government Pension Plan</skos:altLabel>
        <skos:altLabel>Government-Administered Pension Plan</skos:altLabel>
        <skos:altLabel>National Pension Fund</skos:altLabel>
        <skos:altLabel>National Pension Plan</skos:altLabel>
        <skos:altLabel>Public Pension Savings Account</skos:altLabel>
        <skos:altLabel>Public Pension System</skos:altLabel>
        <skos:definition>A state-run pension account is a retirement savings program managed by the government, funded through taxation or mandatory contributions. These accounts typically provide defined benefits upon retirement, ensuring a basic income for retirees.</skos:definition>
        <skos:example>National Pension Fund: Japan National Pension Fund</skos:example>
        <skos:example>State Pension Scheme: UK Basic State Pension</skos:example>
        <skos:prefLabel>State Pension Scheme</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMLusAf4cAxrOTTs872NeQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMLusAf4cAxrOTTs872NeQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdz3J6xqNZfHwiRt3aSLCr"/>
        <rdfs:label>Right of Superficies</rdfs:label>
        <skos:definition>Building Right</skos:definition>
        <skos:definition>The Right of Superficies is a legal concept that allows an individual to own structures or plantings on land owned by someone else. This right typically enables the holder to build on, cultivate, or otherwise use the land&apos;s surface for a specified period, subject to conditions outlined in an agreement or governing laws, without owning the land itself.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMNEplYHAKvBDsVzSt7Ldh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMNEplYHAKvBDsVzSt7Ldh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3Q1HDu5jO8nvhdbr2Uj0c"/>
        <rdfs:label>Florida Circuit Court - Escambia County - 1st Circuit Court</rdfs:label>
        <skos:definition>Florida Circuit Court - Escambia County (1st Circuit Court) is a specific court within the Florida Circuit Court system that has jurisdiction over legal proceedings in Escambia County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMP8teNWekcggwsU6bJpPd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMP8teNWekcggwsU6bJpPd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9kmGZf5FSmFdouXWQ1Nndm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDHJ4Q5iyZp6K8oJKI45Lq2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Transferred Matter</rdfs:label>
        <skos:altLabel>Transferred Case</skos:altLabel>
        <skos:definition>A transferred matter refers to a legal case or issue that has been moved from one law firm or jurisdiction to another. This transfer may occur due to various reasons, such as a change in legal representation, conflicts of interest, or the need for specialized expertise.</skos:definition>
        <skos:prefLabel>Incoming Matter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMRPEiZaE5KKv6sC0IbGgS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMRPEiZaE5KKv6sC0IbGgS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8NbbZM7ESWmrKMGuKGoGJx"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKOcs51IQGZ9MeUqtONIlc"/>
        <rdfs:label>Rental Payment</rdfs:label>
        <skos:altLabel>Lease Income</skos:altLabel>
        <skos:altLabel>Property Rental Earnings</skos:altLabel>
        <skos:altLabel>Rent Receipts</skos:altLabel>
        <skos:altLabel>Rental Revenue</skos:altLabel>
        <skos:definition>Rental Payment, also known as Rental Income, refers to the income received by a property owner from tenants in exchange for the use of the property. This income is typically derived from residential, commercial, or industrial real estate and is received on a regular basis, such as monthly or annually.</skos:definition>
        <skos:prefLabel>Rental Income</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMRcO5cVT30xWV0xnl4iW1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMRcO5cVT30xWV0xnl4iW1">
