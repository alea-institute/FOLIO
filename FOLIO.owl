        <rdfs:label>Pennsylvania Magisterial District Court - Monroe County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court located in Monroe County, which is responsible for handling minor criminal offenses, traffic violations, and civil cases within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLZy6MF5nrxWaeidziMJQU -->

