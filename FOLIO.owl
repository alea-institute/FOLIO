        <dc:identifier>RES-REAL</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=531"/>
        <rdfs:label>Real Estate Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Immobilienbranche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria Inmobiliaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria Inmobiliaria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie immobilière</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria imobiliária</skos:altLabel>
        <skos:altLabel>Real Estate</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Real Estate Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית נדלן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रियल एस्टेट उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不動産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房地产行业</skos:altLabel>
        <skos:definition>Industries in the Real Estate group are primarily engaged in renting or leasing real estate to others; managing real estate for others; selling, buying, or renting real estate for others; and providing other real estate related services, such as appraisal services. This subsector includes equity Real Estate Investment Trusts (REITs) that are primarily engaged in leasing buildings, dwellings, or other real estate property to others.</skos:definition>
        <skos:hiddenLabel>REAL</skos:hiddenLabel>
    </owl:Class>
    


