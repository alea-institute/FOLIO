        <rdfs:label>Tennessee Circuit Court</rdfs:label>
        <skos:definition>The Tennessee Circuit Court is a court within the Tennessee State Courts system that has jurisdiction over certain civil and criminal cases within a specific geographic area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RJwzx3Fza5eNYF8zRdaUE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RJwzx3Fza5eNYF8zRdaUE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEWWtS3nM8GE8R4en1abRz"/>
        <rdfs:label>Arkansas Circuit Court - Marion Cty.</rdfs:label>
        <skos:definition>A court located in Marion County, Arkansas that has jurisdiction over civil and criminal cases within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RKKV89o69CwHCRTa8p3Fz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RKKV89o69CwHCRTa8p3Fz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Legal Effect Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;effet juridique</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Efecto Legal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Efecto Legal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de efeito legal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Legal Effect Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtswirkungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף השפעה משפטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी प्रभाव वाली धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律效力条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法的効力条項</skos:altLabel>
        <skos:definition>A Legal Effect Clause is a clause within a contract that has the power to create legal obligations or rights for the parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ROaRQTFgM9oWtVX4k6v6I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ROaRQTFgM9oWtVX4k6v6I">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBUe0cQF64tyOYgN6tqTSLm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBLzDQdY5M3AjVUpILnB95K"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Accessibility Claim</rdfs:label>
        <skos:altLabel>ADA Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Anspruch auf Barrierefreiheit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disability Access Claim</skos:altLabel>
        <skos:altLabel>Public Accommodation Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Acceso para Discapacitados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de Acceso para Personas con Discapacidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de Acesso para Pessoas com Deficiência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation d&apos;accès pour les personnes handicapées</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת גישה לנכים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विकलांगता एक्सेस दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">残疾人士通行权利要求</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">障害者アクセス請求</skos:altLabel>
        <skos:definition>A disability access claim, also known as an accessibility claim, is a legal action initiated by a person with a disability against a business or property owner for not complying with disability access laws. These laws require that public accommodations, such as stores, restaurants, and other businesses, be accessible to individuals with disabilities, and provide accommodations such as accessible parking, ramps, and signage. The claim typically arises when a business does not comply with applicable disability access laws, which can result in barriers to access for individuals with disabilities. Businesses can face liability for violating disability access laws, which can result in significant damages for the affected individual and required changes to make the premises accessible.</skos:definition>
        <skos:prefLabel>Disability Access Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RQF21F6SP0PftBtoEDzgU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RQF21F6SP0PftBtoEDzgU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Wintun</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RRPbKQt5nv8xAhzgey6c4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RRPbKQt5nv8xAhzgey6c4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBeOt3YZjlGxyEqD6VfyKrj"/>
        <rdfs:label>Musical Composition</rdfs:label>
        <skos:altLabel>Music Composition</skos:altLabel>
        <skos:definition>A Musical Composition is a creation that combines melodies, harmonies, rhythms, and lyrics (if any) to form a complete musical piece intended for performance or recording. Unlike a sound recording, the musical composition is a song&apos;s underlying composition (e.g., notated melodies, harmonies, rhythms, lyrics).</skos:definition>
        <skos:prefLabel>Score</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RRyCC6w6V3oGeHdAUkdAo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RRyCC6w6V3oGeHdAUkdAo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/R9RiRk1LnffWe0xUY0IHsmL"/>
                <owl:hasValue rdf:resource="https://folio.openlegalstandard.org/R7X8F5SP8MRxLzCPHA54vDa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Summary Judgment in Lieu of Complaint</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Jugement sommaire en lieu et place de la plainte</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Julgamento sumário em vez de queixa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Sentencia sumaria en lugar de demanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sentencia sumaria en lugar de demanda</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Summary Judgment in Lieu of Complaint</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zusammenfassendes Urteil anstelle einer Klage</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צו פסק דין סיכום במקום תביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा के स्थान पर सारांश निर्णय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">代替起诉的总结判决</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">苦情の代わりに要約判決</skos:altLabel>
        <skos:definition>A Summary Judgment in Lieu of Complaint is a legal procedure in which a plaintiff seeks a judgment without filing a formal complaint, typically used in cases involving banking, commercial paper, and creditor claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RShJ920RqbSd7rDVrV7z5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RShJ920RqbSd7rDVrV7z5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8A2f18n9G7OkKnD3C0K5O"/>
        <rdfs:label>Asset Restricted Voting Right</rdfs:label>
        <skos:altLabel>Limited Voting Share</skos:altLabel>
        <skos:altLabel>Partial Voting Right</skos:altLabel>
        <skos:altLabel>Reduced Voting Equity</skos:altLabel>
        <skos:definition>An Asset Restricted Voting Right refers to a limited voting entitlement associated with certain classes of shares, where the shareholder may possess fewer voting rights compared to standard voting shares, often less than one vote per share. This attribute allows for differentiated control mechanisms within a company&apos;s equity structure, balancing economic interest with limited decision-making power.</skos:definition>
        <skos:prefLabel>Restricted Voting Share</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RVn3ZEypkVHdM51TaSxh9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RVn3ZEypkVHdM51TaSxh9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCNdhIWpodXkmuDPUE0YLKX"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R70UKIyaOuSXRR5xa6Vjm2e"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7NkdM8YhcmzfiWmRifZdxG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RkDm9J359mc6mQ5uj6uiXq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Shareholders Agreement</rdfs:label>
        <skos:definition>A Shareholders Agreement is a contract among the shareholders of a company, defining their rights, obligations, and protections, as well as the management and operational procedures of the company.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RWwdyMp12ldMe0u2EZjhO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RWwdyMp12ldMe0u2EZjhO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
        <rdfs:label>Pricing Management</rdfs:label>
        <skos:definition>Pricing Management refers to the process of setting and adjusting the fees charged by a law firm for its services, and is a subcategory of the broader Business of Law concept.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RaBAQnybVTUza8DHcLCSK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RaBAQnybVTUza8DHcLCSK">
