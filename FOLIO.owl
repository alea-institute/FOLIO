        <rdfs:label>TIMEKEEPER_CLASSIFICATION</rdfs:label>
        <skos:definition>A classification system used in the LEDES98BI V5 Format Rev 1-2020 standard for categorizing timekeepers based on their roles and responsibilities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9R6jYZWiRpyAYjh9YxnmYN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9R6jYZWiRpyAYjh9YxnmYN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UELEvq0EkRnKE9zMt5IfZ"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:label>Absence of Litigation</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Absence de litiges</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Absence of Litigation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Abwesenheit von Rechtsstreitigkeiten</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ausencia de Litigios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ausencia de Litigios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ausência de litígio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר תביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मुकदमों की अनुपस्थिति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴訟の不在</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">诉讼缺席</skos:altLabel>
        <skos:definition>The absence of litigation refers to the state of not having any ongoing legal disputes or lawsuits related to a particular matter, which is a condition that must be met in order to close a legal transaction or agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9R6qFcWEHy3ahOWT3zTMl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9R6qFcWEHy3ahOWT3zTMl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Suspect</rdfs:label>
        <skos:definition>A suspect is an individual believed to have committed a crime or offense, based on preliminary evidence, witness statements, or other indications. However, until proven guilty through due legal process, a suspect retains the presumption of innocence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RCdjvhu6yHEs582uKchlL -->

