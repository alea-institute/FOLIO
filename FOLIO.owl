        <skos:altLabel xml:lang="en-gb">Applicable Margin</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Marge applicable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Margem aplicável</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Margen aplicable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Margen aplicable</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מרווח רלוונטי</skos:altLabel>
