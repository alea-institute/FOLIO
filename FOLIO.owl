        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=713940"/>
        <rdfs:label>Fitness and Recreational Sports Centers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in operating fitness and recreational sports facilities featuring exercise and other active physical fitness conditioning or recreational sports activities, such as swimming, skating, or racquet sports.</skos:definition>
        <skos:example>Aerobic dance or exercise centers</skos:example>
        <skos:example>Gymnasiums</skos:example>
        <skos:example>Handball, racquetball, or tennis club facilities</skos:example>
        <skos:example>Ice or roller skating rinks</skos:example>
        <skos:example>Physical fitness centers</skos:example>
        <skos:example>Swimming or wave pools</skos:example>
    </owl:Class>
    


