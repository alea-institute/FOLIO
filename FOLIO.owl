    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDs4RXqtrzif7ulCp2kI0mO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDs4RXqtrzif7ulCp2kI0mO">
