            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Request for Physical or Mental Examination</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf körperliche oder geistige Untersuchung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande d&apos;examen physique ou mental</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Exame Físico ou Mental</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Request for Physical or Mental Examination</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de examen físico o mental</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de examen físico o mental</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לבדיקת פיזית או מנטלית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शारीरिक या मानसिक परीक्षण के लिए अनुरोध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">身体または精神検査の依頼</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">身体或精神检查请求</skos:altLabel>
        <skos:definition>A Request for Physical or Mental Examination is a type of Discovery Document that asks for an individual to undergo a medical examination to provide evidence in a legal case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDWJGEB9ZSIFtiudFTT9PZw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDWJGEB9ZSIFtiudFTT9PZw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Dxh7cqKFFJ2jKNTvICMhf"/>
        <rdfs:label>Volunteers</rdfs:label>
        <skos:altLabel>Enlistees</skos:altLabel>
        <skos:definition>Volunteers, in a military context, are individuals who willingly enlist or offer their services to the armed forces without being conscripted or otherwise compelled. This category encompasses those who join the military of their own accord, often driven by patriotism, career opportunities, or a desire to serve their country.</skos:definition>
        <skos:prefLabel>Enlistment Personnel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDWJZrq8Da9VyYjZnQ2JqqI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDWJZrq8Da9VyYjZnQ2JqqI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E116 Trial transcripts</rdfs:label>
        <skos:definition>Trial transcripts (E116) are a type of expense (E100) incurred during legal proceedings, which involve a written or recorded record of the trial proceedings.</skos:definition>
    </owl:Class>
    


