        <skos:altLabel xml:lang="en-gb">Work for Hire Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף עבודה עבור שכירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">काम के लिए भाड़े की शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">聘用条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">雇用契約条項</skos:altLabel>
        <skos:definition>A Work for Hire Clause is a provision in a contract that specifies that any work created by an individual in the course of their employment or under a contract belongs to the employer or the contracting party, rather than the individual who created it.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBsoKzIgyNkEeQX7ln7C4Qm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBsoKzIgyNkEeQX7ln7C4Qm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8yT48TVCNCeeyY7WXNjCt3"/>
        <rdfs:label>Gay</rdfs:label>
        <skos:definition>Gay refers to a sexual orientation in which an individual is attracted to members of the same sex. It is a term commonly used to describe men who are attracted to other men, but it can also be used more broadly to describe anyone attracted to individuals of the same sex.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBsqO7iW9SmBHyROk4SL1Y0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBsqO7iW9SmBHyROk4SL1Y0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKOcs51IQGZ9MeUqtONIlc"/>
        <rdfs:label>Royalty Payment</rdfs:label>
        <skos:altLabel>Intellectual Property Compensation</skos:altLabel>
        <skos:altLabel>Intellectual Property Payment</skos:altLabel>
        <skos:altLabel>License Payment</skos:altLabel>
        <skos:altLabel>Royalty Distribution</skos:altLabel>
        <skos:definition>A Royalty Payment is a payment made to the owner of a patent, copyright, trademark, or other intellectual property for the right to use, produce, or sell the owner&apos;s creation. These payments are typically a percentage of the revenue generated from the use of the intellectual property or a fixed amount per unit sold.</skos:definition>
        <skos:prefLabel>Royalties</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBsqRUFBCnbsERzdeQtc8rZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBsqRUFBCnbsERzdeQtc8rZ">
