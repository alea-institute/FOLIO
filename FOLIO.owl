                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RC219sYxwzJe2ULgTU8qyXA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Public Utility Liability</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftung für öffentliche Versorgungsunternehmen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Public Utility Liability</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad civil de empresas de servicios públicos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad civil de empresas de servicios públicos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade das empresas de serviços públicos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité des services publics</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות ציבורית של חברות תשתיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक उपयोगिता दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共公益事業の責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公用事业责任</skos:altLabel>
        <skos:definition>Public Utility Liability is the legal responsibility of a utility company for any harm caused to the public due to their actions or negligence, and falls under the categories of agency and vicarious liability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDFVNGSUecNr2IRWrumr5nK -->

