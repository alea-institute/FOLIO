        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8V9Ma3IrggNq0pxeXl8Re5"/>
        <rdfs:label>Cash Payment</rdfs:label>
        <skos:definition>Cash Payment involves the physical transfer of paper money or coins between parties to settle a financial obligation. It is one of the oldest and simplest forms of payment, often used for in-person transactions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCZdG7bztfQT8BuzFadwgir -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCZdG7bztfQT8BuzFadwgir">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
        <rdfs:label>Opacity</rdfs:label>
        <skos:definition>Opacity in an AI system refers to the condition where one or more features, such as processes, the provenance of datasets, functions, output, or behavior, are unavailable or incomprehensible to all stakeholders. Opacity is usually considered an antonym for transparency and can hinder understanding, trust, and accountability in AI systems.</skos:definition>
    </owl:Class>
    


