            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>DEPRECATED: Supplement (in favor of &quot;Amended Document&quot;)</rdfs:label>
        <skos:definition>A Supplement in legal and financial contexts refers to an additional document that amends, updates, or adds to the information contained in a primary document. It is commonly used in the realm of legal contracts, investment documents, and regulatory filings to incorporate new information or reflect changes without superseding the original document.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8bKmNoeGW2vJO6CxTuWIwo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8bKmNoeGW2vJO6CxTuWIwo">
