        <skos:altLabel xml:lang="en-gb">Breach of Covenant Not to Compete</skos:altLabel>
        <skos:altLabel>Breach of Noncompete</skos:altLabel>
        <skos:altLabel>Breach of Noncompete Convenant</skos:altLabel>
        <skos:altLabel>Competition With Employer or Principal</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de convenio de no competencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de convenio de no competencia</skos:altLabel>
        <skos:altLabel>Noncompete Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der Verpflichtung zur Nicht-Konkurrenz</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de l&apos;obligation de non-concurrence</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação da obrigação de não concorrência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת הבטחת אי-התחרות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध उल्लंघन नहीं करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">競業禁止契約違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反不竞争条款</skos:altLabel>
        <skos:definition>The Breach of Covenant Not to Compete refers to a violation of an agreement between an employee and employer or principal, where the employee agrees not to engage in competitive activities with the employer or principal after leaving their employment or business relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <rdfs:label>Neurological Disorders</rdfs:label>
        <skos:altLabel>Nervous System Disorders</skos:altLabel>
        <skos:altLabel>Neurologic Conditions</skos:altLabel>
        <skos:definition>Neurological disorders encompass a broad range of conditions that affect the nervous system, including the brain, spinal cord, and peripheral nerves. These disorders can result in a variety of symptoms, such as muscle weakness, coordination issues, seizures, and cognitive impairments, requiring tailored medical and therapeutic interventions.</skos:definition>
        <skos:prefLabel>Neurophysiological Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7MAzHUZtwmTtToqN57q7V6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7MAzHUZtwmTtToqN57q7V6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
        <rdfs:label>Neural Network</rdfs:label>
        <skos:altLabel>Artificial Neural Network</skos:altLabel>
        <skos:altLabel>Deep Neural Network</skos:altLabel>
        <skos:definition>A neural network consists of one or more layers of neurons connected by weighted links with adjustable weights. Neural networks receive input data and produce an output by passing it through the network, with each neuron performing a simple computation. Although some neural networks aim to simulate the functioning of biological neurons in the nervous system, most neural networks in artificial intelligence are engineering tools that draw only loose inspiration from biology.</skos:definition>
        <skos:prefLabel>Connectionist Model</skos:prefLabel>
    </owl:Class>
    


