        <skos:altLabel xml:lang="en-gb">Additional Matching Rights Period</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Periodo adicional de derechos de emparejamiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Periodo adicional de derechos de emparejamiento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Período adicional de direitos de correspondência</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Période de droits de correspondance supplémentaires</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zusätzlicher Matching-Rechte-Zeitraum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקופת זכויות התאמה נוספות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अतिरिक्त मिलान अधिकार अवधि</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">追加マッチング権利期間</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">额外匹配权利期间</skos:altLabel>
        <skos:definition>A period of time granted to a party in a legal matter, allowing them the opportunity to match the terms of a proposed transaction before it is finalized, in addition to the previously established matching rights period.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHpE6T1bTO65UNmJqVSDhQ -->

