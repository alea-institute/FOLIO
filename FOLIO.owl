        <skos:altLabel xml:lang="ja-jp">宣誓申立</skos:altLabel>
        <skos:definition>A sworn complaint is a formal written statement made under oath by a person alleging wrongdoing by another party, typically used in legal proceedings.</skos:definition>
    </owl:Class>
    


