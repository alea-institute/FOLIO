        <rdfs:label>WC130 Experts/Consultants</rdfs:label>
        <skos:definition>Identify medical experts and vocational experts, developing/reviewing Expert/Consultant Reports, communication with expert /consultants adjuster/employer/ nurse case manager regarding expert opinions.</skos:definition>
        <skos:prefLabel>WC130 Experts/Consultants</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8nKj8jCoF7tXLyAvph4qQI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8nKj8jCoF7tXLyAvph4qQI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5GqV01EclTMMUtFKVLSZD"/>
        <rdfs:label>AI Accuracy</rdfs:label>
        <skos:definition>AI Accuracy is a metric within AI measurement that quantifies an AI system&apos;s proportion of correct (intended) predictions, compared to the total number of predictions. It serves as an indicator of how well an AI system performs in making accurate predictions, based on Ground Truth, encompassing both precision and recall, providing a comprehensive assessment of model performance.</skos:definition>
    </owl:Class>
    


