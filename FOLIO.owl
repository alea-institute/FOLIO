        <skos:altLabel xml:lang="es-es">Cláusula de plazo indefinido</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de plazo indefinido</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de prazo indeterminado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Indefinite Term Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für unbestimmte Laufzeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תקופה בלתי מוגבלת</skos:altLabel>
