        <skos:altLabel xml:lang="fr-fr">Motion pour jugement en tant que question de droit</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de julgamento como questão de direito</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין כנגד עניין משפטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानून के रूप में फैसले के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法律問題に関する判決の動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律问题判决动议</skos:altLabel>
        <skos:definition>A Motion for Judgment as a Matter of Law (JAML) is a post-trial motion that requests the court to enter a judgment in favor of the moving party because the evidence presented at trial was insufficient to support the opposing party&apos;s claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6RkCof1vnOthsmkdUtFAV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6RkCof1vnOthsmkdUtFAV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RdJQsU95Vq3NCs4Q7326F5"/>
        <rdfs:label>Idea Misappropriation - Property Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Appropriation d&apos;idées - Revendication de propriété</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Apropiación indebida de ideas - Reclamación de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Apropiación indebida de ideas - Reclamación de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Apropriação indébita de ideias - Reivindicação de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Idea Misappropriation - Property Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ideenunterschlagung - Eigentumsanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התאגדות רעיונות - טענת קניין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विचार अनुचित अपहरण - संपत्ति दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アイデアの不正使用 - 財産請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">创意侵占 - 财产主张</skos:altLabel>
        <skos:definition>The wrongful taking or use of someone else&apos;s idea or intellectual property, with a legal claim made specifically regarding ownership of the idea.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6SBVnraWtLcE6nmqAHikB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6SBVnraWtLcE6nmqAHikB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ro1RKRYnlciGrhgC4NjuDV"/>
        <rdfs:label>Unit per Result</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einheit pro Ergebnis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Unidad por resultado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Unidad por resultado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Unidade por resultado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unit per Result</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Unité par résultat</skos:altLabel>
        <skos:altLabel xml:lang="he-il">יחידה לתוצאה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">परिणाम प्रति इकाई</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">单位每个结果</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">結果ごとの単位</skos:altLabel>
        <skos:definition>A &quot;Unit per Result&quot; is a type of unit for measuring fees or expenses in legal services, where the cost is based on the outcome achieved rather than the time spent or resources used.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RB6SCzZbAqqmRhIB6DPk2Kn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB6SCzZbAqqmRhIB6DPk2Kn">
