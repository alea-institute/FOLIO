        <skos:altLabel xml:lang="ja-jp">条約</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">条约</skos:altLabel>
        <skos:definition>A signed agreement or arrangement made by negotiation between by two political authorities (usually states or sovereign governments), and usually ratified by the states&apos; lawmaking authorities.</skos:definition>
    </owl:Class>
    


