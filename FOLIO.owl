        <rdfs:label>Paramedic Negligence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fehlerhaftes Verhalten von Rettungssanitätern</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia del paramédico</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia del paramédico</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência de paramédicos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence des ambulanciers</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Paramedic Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת זהירות של פרמדיק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पैरामेडिक लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">医护人员疏忽</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">救急救命士の過失</skos:altLabel>
        <skos:definition>Paramedic Negligence refers to a legal claim of medical negligence against a paramedic or emergency medical technician for failing to provide the appropriate standard of care during emergency medical treatment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8bDmXMD1WGlcc5OPjZsysk -->

