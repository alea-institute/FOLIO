        <skos:altLabel xml:lang="pt-br">Cláusula de disposições de indenização</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Indemnification Provisions Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu Entschädigungsbestimmungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפצדה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भरपाई विधान धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">賠償規定条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">赔偿条款</skos:altLabel>
