    <!-- https://folio.openlegalstandard.org/RClEPD3LQVJMcRPGY9oXVXU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RClEPD3LQVJMcRPGY9oXVXU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Guarantee Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de garantie</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de garantia</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de garantía</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de garantía</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Garantieklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Guarantee Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הבטחה</skos:altLabel>
