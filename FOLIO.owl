        <skos:altLabel xml:lang="zh-cn">收购披露的公开披露</skos:altLabel>
        <skos:definition>The Public Disclosure of Acquisition Disclosure refers to the requirement of disclosing information related to the acquisition of a company or its assets to the public, triggered by a specific event or condition, such as the Tail Period Fee.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yo65qSNd6fmLhDiMiHAld -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8yo65qSNd6fmLhDiMiHAld">
