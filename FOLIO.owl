        <skos:altLabel xml:lang="zh-cn">提审</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">提訴</skos:altLabel>
        <skos:definition>Arraignment is a legal event that involves the defendant being brought before a court to hear the charges against them and to enter a plea.</skos:definition>
    </owl:Class>
    


