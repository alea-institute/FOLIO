    <!-- https://folio.openlegalstandard.org/RCfOoWbuAOqLv617rVNcHYh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCfOoWbuAOqLv617rVNcHYh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_13"/>
        <rdfs:label>Eating Disorders</rdfs:label>
        <skos:definition>Eating Disorders are characterized by disturbances in eating behavior and preoccupation with, and excessive self-evaluation of, body weight and shape. Symptoms and signs may include, but are not limited to, restriction of energy consumption when compared with individual requirements; recurrent episodes of binge eating or behavior intended to prevent weight gain, such as self-induced vomiting, excessive exercise, or misuse of laxatives; mood disturbances, social withdrawal, or irritability; amenorrhea; dental problems; abnormal laboratory findings; and cardiac abnormalities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCfQRpRfV3qAA0eRlZOvCGB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCfQRpRfV3qAA0eRlZOvCGB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8V9Ma3IrggNq0pxeXl8Re5"/>
        <rdfs:label>Money Order Payment</rdfs:label>
        <skos:altLabel>Postal Money Order</skos:altLabel>
        <skos:definition>Money Order Payment involves the use of a money order, a pre-funded paper document resembling a check, to transfer funds between parties. Money orders are typically issued by financial institutions, post offices, or retail stores and offer a secure method of payment.</skos:definition>
        <skos:prefLabel>Cashier’s Check Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCfQprqaO3Nb7M6GPJxCBgm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCfQprqaO3Nb7M6GPJxCBgm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8MlNUtcvkICqPmpS1Sm1QD"/>
        <rdfs:label>Disinhibited Social Engagement Disorder</rdfs:label>
        <skos:definition>Disinhibited Social Engagement Disorder (DSED) is a condition in children characterized by overly familiar behavior with strangers and a lack of appropriate reticence in new social situations. It often arises from severe neglect or inconsistent caregiving during early childhood, leading to indiscriminate social interactions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCfRIysIHRumFT5rXKOjvlc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCfRIysIHRumFT5rXKOjvlc">
