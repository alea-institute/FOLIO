        <skos:altLabel xml:lang="es-es">Manos sucias</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Manos sucias</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unclean Hands</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">manquement à l&apos;équité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">mãos sujas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">unreine Hände</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ידיים מגונות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गंदे हाथ</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不正な手段</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不洁之手</skos:altLabel>
        <skos:definition>The concept of &quot;Unclean Hands&quot; refers to a legal defense in civil litigation where the plaintiff&apos;s own wrongful conduct or bad faith actions are used to argue against their claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72LbiQHtFaePDS4dcDiUgm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72LbiQHtFaePDS4dcDiUgm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion for Continuation of Utility Service</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Fortsetzung des Versorgungsdienstes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Continuation of Utility Service</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour la continuation du service public</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Continuação do Serviço de Utilidade Pública</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de Continuación del Servicio de Utilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de Continuación del Servicio de Utilidad</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה להמשך שירות תועלת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपयोगिता सेवा के लिए जारी रखने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公益事業サービスの継続に関する請願</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">维持公用事业服务的动议</skos:altLabel>
        <skos:definition>A Motion for Continuation of Utility Service is a request made in a bankruptcy case to continue receiving essential utility services, such as electricity or water, despite the debtor&apos;s inability to pay for them.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72ULMEBCEpSYhjWfvYgtew -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72ULMEBCEpSYhjWfvYgtew">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Ov4MbOJULZY0aLe1KoP3Z"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBU1MPZclWmAITpDAoWCKm1"/>
        <rdfs:label>Sensitive Personal Information</rdfs:label>
        <skos:definition>Sensitive Personal Information refers to personal data that requires greater protection due to its nature and the potential harm that could result from its unauthorized disclosure. This includes data such as health records, financial information, racial or ethnic origin, political opinions, religious beliefs, and biometric data.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72XhyLUz5P5kgI2yKvVMwO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72XhyLUz5P5kgI2yKvVMwO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8wEzsnWA30YRmdfZKRkFuH"/>
        <rdfs:label>Trial Brief</rdfs:label>
        <skos:altLabel xml:lang="es-es">Escrito de Alegatos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Escrito de Alegatos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Memorial de defesa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mémoire en défense</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Prozessbrief</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial Brief</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מסמך תביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल ब्रीफ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">审判简报</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判前書面意見</skos:altLabel>
        <skos:definition>A trial brief is a written document submitted to a court that summarizes the legal arguments and relevant facts of a case, typically prepared by an attorney for a trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72Y9BPx1wipL5w2AWiGaPx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72Y9BPx1wipL5w2AWiGaPx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8R7UAZpzIQTdqNtctKj3XY"/>
        <dc:source>Fed. R. Evid. 406</dc:source>
        <rdfs:label>Improper Habit Evidence Objection</rdfs:label>
        <skos:altLabel>Habitual Behavior Objection</skos:altLabel>
        <skos:altLabel>Objection to Inadmissible Habit Evidence</skos:altLabel>
        <skos:altLabel>Routine Practice Evidence Objection</skos:altLabel>
        <skos:definition>An Improper Habit Evidence Objection is raised when a party in a legal proceeding believes that evidence being presented is being used to unfairly suggest that a person&apos;s actions in a specific incident were consistent with their habitual behavior or routine practice. This objection aims to prevent the misuse of habit evidence that may not be relevant or may lead to unfair conclusions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72agwLlTURJmjaX75g8G5b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72agwLlTURJmjaX75g8G5b">
