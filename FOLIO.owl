    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/pj3FNkmuSWW-DymQXdCGvQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/pj3FNkmuSWW-DymQXdCGvQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NwpC-AVOSrGS91q0HJPhaw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334510"/>
        <rdfs:label>Electromedical and Electrotherapeutic Apparatus Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing electromedical and electrotherapeutic apparatus, such as magnetic resonance imaging equipment, medical ultrasound equipment, pacemakers, hearing aids, electrocardiographs, and electromedical endoscopic equipment.</skos:definition>
    </owl:Class>
    


