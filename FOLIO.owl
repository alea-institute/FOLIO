        <skos:altLabel xml:lang="es-es">Adquirente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Adquirente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Adquiriente</skos:altLabel>
