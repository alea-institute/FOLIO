        <skos:altLabel xml:lang="es-mx">Reclamaciones de Contratos de Consumo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de contrato do consumidor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations de contrat de consommation</skos:altLabel>
