        <skos:altLabel xml:lang="zh-cn">判决后利息</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決後利息</skos:altLabel>
        <skos:definition>Post-Judgment Interest refers to the interest that accrues on a monetary award after a judgment has been entered by a court.</skos:definition>
    </owl:Class>
    


