        <rdfs:label>Clothing and Clothing Accessories Retailers</rdfs:label>
        <skos:definition>See industry description for 458110.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/O-vt7yS3S3C8qVjTbZLXHw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/O-vt7yS3S3C8qVjTbZLXHw">
