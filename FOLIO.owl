        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R1lCp75IEE0Ktih8rYlIK5"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7i00MVak7HQPsePKrHq2WF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8pNPutX0TN6DlEqkyZuxSw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Lessee’s Default on Lease of Goods</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Défaut du locataire sur la location de biens</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Inadimplemento do arrendatário no arrendamento de bens</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento del arrendatario en el arrendamiento de bienes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento del arrendatario en el arrendamiento de bienes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lessee’s Default on Lease of Goods</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mietvertragsverletzung des Mieters bei Leasing von Waren</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התעלמות השוכר מההסכם להשכרת רכוש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान के लीज से लेसी की अवधारणा के अनुरूप व्यवहार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">承租人违约租赁物品</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">賃貸物件の借主による契約違反</skos:altLabel>
        <skos:definition>The Lessee&apos;s Default on Lease of Goods refers to the situation where the lessee fails to fulfill their obligations under a lease agreement for goods, resulting in a breach of contract and potential legal action by the lessor or creditor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBi5nYq1khAzzGeY5YZ10ya -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBi5nYq1khAzzGeY5YZ10ya">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8TmxqBbWaNgdm0lJQdY6D4"/>
        <rdfs:label>Leave-Related Claims</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ansprüche im Zusammenhang mit Urlaub</skos:altLabel>
        <skos:altLabel>Leave Claims</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Leave-Related Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamaciones relacionadas con licencias</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones relacionadas con permisos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações relacionadas a licenças</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations liées aux congés</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות הקשורות לחופשה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">छुट्टी संबंधी दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">与休假有关的索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">休暇関連請求</skos:altLabel>
        <skos:definition>Leave-related claims are legal actions initiated by an employee against their employer for not complying with applicable laws or the terms of an employment agreement regarding various types of leave, such as medical leave, family leave, or military leave. These claims can involve issues such as denial of leave, interference with the employee&apos;s right to take leave, or retaliation against the employee for taking leave. Employees may also bring leave-related claims if their employer fails to provide required notice or fails to provide benefits or protections required by law during the leave period.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBi5ofe7gF0hhcbHBfn8pIb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBi5ofe7gF0hhcbHBfn8pIb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROkZDnVdIp3LYIkTizMpjw"/>
        <rdfs:label>Motion to Bifurcate</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Bifurkation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Bifurcación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Bifurcación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Bifurcate</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Bifurcação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en bifurcation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפיצול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">द्विभाजन के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">分割動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分裂动议</skos:altLabel>
        <skos:definition>A Motion to Bifurcate is a legal request to separate a trial into two parts, typically to address liability and damages separately.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBi8gDlUW4dD0dzNi9SXOEr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBi8gDlUW4dD0dzNi9SXOEr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bMYvmc0V2rQJJWiaIW9QP"/>
        <rdfs:label>DEPRECATED Attorney-Client Discussions</rdfs:label>
        <skos:definition>Deprecated Attorney-Client Discussions refer to the communication between a lawyer and their client that is no longer in use or recommended. It falls under the broader category of Deprecated Budgeting and Project Management.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBiAoOzwEwAA8rSExNEECk -->

