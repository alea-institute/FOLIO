        <rdfs:label>Mohawk</rdfs:label>
        <skos:altLabel xml:lang="de-de">Mohawk</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mohawk</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Mohawk</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">モホーク</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">莫霍克</skos:altLabel>
        <skos:definition>A Native American language spoken by the Mohawk people, characterized by its complex grammar and unique phonetics.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RHS60Cj8fDtECBoRLSvPm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8RHS60Cj8fDtECBoRLSvPm">
