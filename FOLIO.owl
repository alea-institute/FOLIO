        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ra8NCYdJb9YwmAxaOmLDbI"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Drug Equipment Violation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Drug Equipment Violation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verstoß gegen das Betäubungsmittelgesetz</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Violación de equipo de drogas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Violación de equipo de drogas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de l&apos;équipement de drogue</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de equipamento de drogas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת ציוד סמים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ड्रग उपकरण उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">毒品设备违规</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">麻薬器具違反</skos:altLabel>
        <skos:definition>The unlawful manufacture, sale, purchase, possession, or transportation of equipment or devices utilized in preparing and/or using drugs or narcotics.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhkx3dQ6MLH4RmvBj4nBaz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhkx3dQ6MLH4RmvBj4nBaz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCB1peNZ9PAXPle3bpVvvBe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Whistleblower&apos;s Claims</rdfs:label>
        <skos:altLabel xml:lang="de-de">Hinweisgeberansprüche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones del denunciante</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamaciones del informante</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de denunciantes</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendications des lanceurs d&apos;alerte</skos:altLabel>
        <skos:altLabel>Whistleblower Claims</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Whistleblower&apos;s Claims</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות הסועדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्हिसलब्लोअर के दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">举报者的索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">告発者の請求</skos:altLabel>
        <skos:definition>A Whistleblower&apos;s Claim is a legal action brought by an individual who reports illegal or unethical activities within an organization, seeking protection from retaliation and potentially receiving a portion of any resulting financial penalties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhlqsBpfB5omRpLMcS7PEq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhlqsBpfB5omRpLMcS7PEq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HwOtYn3EIoiEsllF0moF2"/>
        <rdfs:label>JA10 Funding (UK J-CODE)</rdfs:label>
        <skos:definition>All work relating to reviewing funding options and securing funding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhmDmdZWNMpZfSRDHWVP2v -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhmDmdZWNMpZfSRDHWVP2v">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Remedies Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de recours</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Remedios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Remedios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de remédios</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu Abhilfemaßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Remedies Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף תיקונים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपचार धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">救济条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">救済条項</skos:altLabel>
        <skos:definition>A Remedies Clause is a provision in a contract that outlines the available legal remedies in the event of a breach of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhmNTbNSiBiFUVXzhaBQss -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhmNTbNSiBiFUVXzhaBQss">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85MNuBfi7N5JNU93i6kTl0"/>
        <rdfs:label>Concealed Handgun License</rdfs:label>
        <skos:altLabel>Concealed Firearm Permit</skos:altLabel>
        <skos:altLabel>Concealed Pistol License</skos:altLabel>
        <skos:altLabel>Concealed Weapons Permit</skos:altLabel>
        <skos:altLabel>Hidden Handgun License</skos:altLabel>
        <skos:altLabel>Personal Protection Weapon Permit</skos:altLabel>
        <skos:definition>A concealed handgun license (CHL), also known as a concealed carry permit or license, is an official authorization granted by a governing authority that permits an individual to carry a concealed firearm, typically a handgun, on their person in public areas. The process to obtain a CHL usually includes a background check, firearms training, and demonstration of proficiency, though specific requirements vary by jurisdiction.</skos:definition>
        <skos:prefLabel>Concealed Carry Permit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhmyZbvflQwHNAMGevDgZ3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhmyZbvflQwHNAMGevDgZ3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGby6vUcfplpGBjYXaIo8i"/>
        <rdfs:label>Voidable Release</rdfs:label>
        <skos:altLabel xml:lang="es-es">Liberación anulable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Liberación anulable</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Voidable Release</skos:altLabel>
        <skos:altLabel xml:lang="de-de">anfechtbare Freigabe</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">liberação anulável</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">libération annulable</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שחרור בלתי תקף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वॉयडेबल रिलीज़</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">可撤销的释放</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">無効化可能なリリース</skos:altLabel>
        <skos:definition>A voidable release is a legal agreement that can be cancelled or made invalid by one of the parties involved due to certain circumstances, such as fraud or duress.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhn3Bx6FfU7CdpXPltImCf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhn3Bx6FfU7CdpXPltImCf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcW4pUMnXuufMtnyvdX0dB"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCF0BMeSwppddfM6cp6AUBK"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Joint Filing Agreement</rdfs:label>
        <skos:definition>A Joint Filing Agreement is an agreement between parties that allows them to file certain documents jointly, especially with regulatory agencies. Often seen in securities law, it signifies that the filers have collaborated on the document but may not agree on all points or share the same views.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhpxuVP1KPa3qKKM4U0LlL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhpxuVP1KPa3qKKM4U0LlL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RClEPD3LQVJMcRPGY9oXVXU"/>
        <rdfs:label>Guaranteed Maximum Price Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de prix maximum garanti</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Precio Máximo Garantizado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Precio Máximo Garantizado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de preço máximo garantido</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Garantierte Höchstpreisklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Guaranteed Maximum Price Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מחיר מקסימלי מובטח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गारंटीड मैक्सिमम प्राइस क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保証最高価格条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保证最高价格条款</skos:altLabel>
        <skos:definition>A Guaranteed Maximum Price Clause is a provision in a contract that sets a limit on the amount that a party will be required to pay for a project, ensuring that the cost will not exceed a certain amount.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhqGEhorn8LYtI4et31HMJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhqGEhorn8LYtI4et31HMJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>As Is Purchase Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">As Is Purchase Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;achat en l&apos;état</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de compra como está</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de compra tal cual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de compra tal cual</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kaufklausel wie gesehen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף רכישה כפי שהוא</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जैसा कि खरीद अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">按现状购买条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現状有姿勢購入条項</skos:altLabel>
        <skos:definition>A provision in a contract that states the buyer accepts the property in its current condition, without any warranties or guarantees from the seller.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhvWpwrRplNF3R3i1O0gT1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhvWpwrRplNF3R3i1O0gT1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7O8JOzD2AiH9GOb3VZ226"/>
        <rdfs:label>Interim Trustee</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Curador interino</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Curateur provisoire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fideicomisario Interino</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fideicomisario Provisional</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interim Trustee</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zwischenverwalter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אמן ביניים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अंतरिम विश्वासपत्र</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">临时受托人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">暫定管理人</skos:altLabel>
        <skos:definition>A trustee appointed temporarily, usually until the appointment of a permanent trustee.</skos:definition>
        <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhy5xMH5J79KIvhUTDqn5C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhy5xMH5J79KIvhUTDqn5C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Visa for Intermittent Intra-Company Transferee</rdfs:label>
        <skos:altLabel>L-1A Visa</skos:altLabel>
        <skos:definition>Visas for intermittent intra-company transferees (in the United States, L-1A Visa) is designed for managers, executives, or specialized knowledge employees who need to travel back and forth between affiliated companies in their home country and the destination country (e.g., U.S.). In the United States, the intermittent L-1 allows the individual to stay in the U.S. for shorter periods without affecting the maximum allowable period of stay, which is typically seven years for L-1A visas and five years for L-1B visas</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBi3jsUnIBZpoGWaXQ3BXas -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBi3jsUnIBZpoGWaXQ3BXas">
