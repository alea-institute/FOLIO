    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/TpUCSATGTp6qfgMpsOT7Gg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/TpUCSATGTp6qfgMpsOT7Gg">
