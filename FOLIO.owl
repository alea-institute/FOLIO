        <rdfs:label>Bowling Centers</rdfs:label>
        <skos:definition>This industry comprises establishments engaged in operating bowling centers. These establishments often provide food and beverage services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/9pyyPJpOTTG5F3DnQ4NyFQ -->

