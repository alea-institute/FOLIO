    <!-- https://folio.openlegalstandard.org/RDmOUUaUXvrBRDI0fdcrYSo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDmOUUaUXvrBRDI0fdcrYSo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJxZ2vqqnde5q8ti6PKfnF"/>
        <rdfs:label>Shoeprint Evidence</rdfs:label>
        <skos:definition>Shoeprint evidence consists of marks or impressions left by shoes on various surfaces. These impressions can reveal patterns, sizes, and unique characteristics or wear of the shoe. Forensic experts analyze shoeprints to determine the type and brand of shoe, and sometimes even link it back to a specific pair of shoes or individual.</skos:definition>
    </owl:Class>
    


