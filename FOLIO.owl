    <owl:Class rdf:about="https://folio.openlegalstandard.org/RrcCXlGpVB5y2DhQaori9M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>French</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Francês</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Französisch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Français</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フランス語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法语</skos:altLabel>
        <skos:definition>French (Language) is a structured system of communication consisting of grammar and vocabulary, used in legal matters as a means of document, artifact, evidence, testimony, proceeding, or any other legal aspect, and is a subcategory of the Language top-level class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RreSXkk2lBT5QOHsP8UQCC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RreSXkk2lBT5QOHsP8UQCC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
        <rdfs:label>Waiver of Damages Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation aux dommages et intérêts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia a daños y perjuicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a daños y perjuicios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renúncia a danos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waiver of Damages Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פטור מפיצויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हानि के अनुबंध से इनकार करना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">损害赔偿豁免条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">損害賠償免責条項</skos:altLabel>
        <skos:definition>A Waiver of Damages Clause is a provision in a contract where one party agrees to waive their right to seek damages from the other party in the event of a breach of contract or other specified circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rrg4cyS943amEafmkgc879 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rrg4cyS943amEafmkgc879">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>General Welfare Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf die Klausel zum allgemeinen Wohlstand</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">General Welfare Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Bienestar General</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Bienestar General</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula do Bem-Estar Geral</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la clause du bien-être général</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף הרווחה הכללית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य कल्याण शर्त दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">一般福利条款主张</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">一般福祉条項主張</skos:altLabel>
        <skos:definition>A General Welfare Clause claim refers to a legal argument challenging the constitutionality of a law or government action based on the interpretation and application of the General Welfare Clause found in the United States Constitution. This claim asserts that the law or action exceeds the scope of the federal government&apos;s authority by not promoting the general welfare of the people, as mandated by the Clause, and therefore may be unconstitutional.</skos:definition>
    </owl:Class>
    


