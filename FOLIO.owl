        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=71394"/>
        <rdfs:label>Fitness and Recreational Sports Centers</rdfs:label>
        <skos:definition>See industry description for 713940.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/MqWEcgH5RMG9ckiQOcktnw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/MqWEcgH5RMG9ckiQOcktnw">
