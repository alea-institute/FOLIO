        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4872"/>
        <rdfs:label>Scenic and Sightseeing Transportation, Water</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BWPuh4YOSEqfI3IWii_ywQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BWPuh4YOSEqfI3IWii_ywQ">
