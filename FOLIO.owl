        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
        <rdfs:label>Negligent Interference with Contractual Relationship</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fahrlässige Störung des Vertragsverhältnisses</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ingérence négligente dans une relation contractuelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Interferencia Negligente con la Relación Contractual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interferencia Negligente en la Relación Contractual</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interferência negligente em relação contratual</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligent Interference with Contractual Relationship</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התערבות שגויה בקשר חוזי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">असावधान अनुबंध संबंध में हस्तक्षेप</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約関係に対する過失による妨害</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过失干涉合同关系</skos:altLabel>
        <skos:definition>Negligent Interference with Contractual Relationship is a legal claim that arises when a third party&apos;s careless actions cause a breach of contract between two parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7gKTQpOKfQ2tOdPu6cLN3w"/>
        <rdfs:label>Immigration Petitions and Applications</rdfs:label>
        <skos:definition>Immigration petitions and applications are formal requests submitted to immigration authorities for specific immigration benefits, such as visas, green cards, or naturalization. In the United States, for example, forms like the I-130 (Petition for Alien Relative) or the I-485 (Application to Register Permanent Residence or Adjust Status) are commonly used for family-based immigration, while the I-129 (Petition for a Nonimmigrant Worker) is used for employment-based visas.</skos:definition>
    </owl:Class>
    


