        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlDwAh4h0X7Sosy5SLccvX"/>
        <rdfs:label>Common Benefit Fee Methodology</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Common Benefit Fee Methodology</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Methodik der gemeinsamen Nutzengebühr</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Metodologia de taxa de benefício comum</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Metodología de tarifa de beneficio común</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Metodología de tarifa de beneficio común</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Méthodologie de frais d&apos;avantages communs</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מתודולוגיית עמלת תועלת משותפת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामान्य लाभ शुल्क विधि</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">共同利益费用方法论</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">共通利益料金方式</skos:altLabel>
        <skos:definition>A Common Benefit Fee Methodology is a method of calculating attorney fees in a legal matter where the outcome of the case provides a benefit to a group of individuals, and the fees are divided among the group based on their proportionate share of the benefit received.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7oOBypnPAAA47zUxyQzBh6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7oOBypnPAAA47zUxyQzBh6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5bITZZ0taJOXwcwS314VU"/>
        <rdfs:label>Privileges &amp; Immunities Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf die Klausel zu Vorrechten und Immunitäten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Privileges &amp; Immunities Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Privilegios e Inmunidades</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Privilegios e Inmunidades</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Privilégios e Imunidades</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de la clause des privilèges et immunités</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף הזכויות והחריגים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विशेषाधिकार और अवरोधों धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">特权和豁免条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">特権および免除条項の主張</skos:altLabel>
        <skos:definition>A Privileges &amp; Immunities Clause claim refers to a legal argument based on the Privileges and Immunities Clause of the United States Constitution, asserting that states cannot discriminate against citizens of other states by denying them fundamental rights and privileges. It aims to protect the rights and equal treatment of individuals traveling or residing in different states within the United States.</skos:definition>
    </owl:Class>
    


