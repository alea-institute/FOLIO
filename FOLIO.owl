        <skos:altLabel xml:lang="es-mx">Incarceración por tiempo cumplido</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Incarceration for Time Served</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Inhaftierung für verbüßte Zeit</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prisão por tempo cumprido</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הכלאה עבור זמן שהושהה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समय के लिए कारावास</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">已服刑入狱</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">既に服役したための収監</skos:altLabel>
        <skos:definition>The concept of &quot;Incarceration for Time Served&quot; refers to the legal practice of releasing a prisoner from custody after they have served the full length of their sentence, including any time spent in pre-trial detention or custody.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R783351768f732C2badC6a0e -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R783351768f732C2badC6a0e">
