        <skos:altLabel xml:lang="ja-jp">改訂および再締結された契約条項</skos:altLabel>
        <skos:definition>An Amended and Restated Agreement Clause is a provision in a legal document that outlines the changes made to an existing agreement and replaces it in its entirety with a new agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDTPef6LjCeQg2TUb7aY88W -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDTPef6LjCeQg2TUb7aY88W">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RiYwKEna4NZ311TVYJ2yCj"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
