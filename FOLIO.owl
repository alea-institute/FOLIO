    <!-- https://folio.openlegalstandard.org/RCVY0cWq1dTHKAIL8c1kYqH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCVY0cWq1dTHKAIL8c1kYqH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsDXW4XOplruZcWE3sKbal"/>
        <rdfs:label>Prime Minister</rdfs:label>
        <skos:definition>A prime minister is the head of government in many parliamentary systems, responsible for running the country&apos;s day-to-day operations and leading the executive branch. Typically appointed from the majority party or coalition in the legislature, the prime minister sets government policy, oversees the cabinet, and represents the country domestically and internationally.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCVcM3sOcvblrq6S72cHY4f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCVcM3sOcvblrq6S72cHY4f">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RE87FC04LhlDc7FmnhrM5g"/>
        <rdfs:label>Utility Patent Registration Document</rdfs:label>
        <skos:definition>A utility patent registration document is a legal certificate issued by a patent office that grants the holder exclusive rights to a new and useful invention, such as a process, machine, manufacture, or composition of matter, for a certain period. It includes detailed information about the invention, its utility, and the scope of protection granted.</skos:definition>
    </owl:Class>
    


