        <skos:altLabel xml:lang="de-de">Kapitalisierte Begriffe Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מונחים באותיות ראשיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कैपिटलाइज्ड टर्म्स क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">大写字母术语条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">大文字用語条項</skos:altLabel>
        <skos:definition>A Capitalized Terms Clause is a specific clause within a contract that identifies and defines capitalized terms used throughout the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RXYs8ARlSsDYANh0mkR3r5 -->

