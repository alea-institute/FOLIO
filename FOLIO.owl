        <rdfs:label>Motion to Impose Automatic Stay</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf automatische Aufschubanordnung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Imponer la Suspensión Automática</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Imponer la Suspensión Automática</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour imposer un séjour automatique</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Impose Automatic Stay</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Impor Ficar Automático</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להטבעת השהיית אוטומטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वचालित रोक लगाने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提议实施自动停留</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自動停止を課す動議</skos:altLabel>
        <skos:definition>A Motion to Impose Automatic Stay is a request made in a bankruptcy case to stop creditors from taking any further collection actions against the debtor or the debtor&apos;s property without first obtaining permission from the bankruptcy court.</skos:definition>
    </owl:Class>
    


