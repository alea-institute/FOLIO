        <skos:altLabel xml:lang="es-es">Gastos de otros profesionales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gastos de otros profesionales</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Other Professionals Expense</skos:altLabel>
