        <rdfs:label>Flat Antitrust Efforts Standard</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estándar de Esfuerzos Antimonopolio Planos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándar de Esfuerzos Antimonopolio Planos</skos:altLabel>
