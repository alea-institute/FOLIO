        <skos:altLabel xml:lang="zh-cn">要求合同条款</skos:altLabel>
        <skos:definition>A requirements contract clause is a provision in a contract that obligates one party to purchase goods or services exclusively from the other party for a specified period of time, based on the buyer&apos;s needs.</skos:definition>
    </owl:Class>
    


