        <skos:altLabel>Direct Debit Transaction</skos:altLabel>
        <skos:altLabel>PIN-based Transaction</skos:altLabel>
        <skos:definition>Debit Card Payment is a transaction that transfers funds electronically from the cardholder&apos;s bank account to a merchant’s account, facilitated through a debit card network. Unlike credit cards, this form of payment is funded by existing money in the cardholder’s account.</skos:definition>
        <skos:prefLabel>Bank Card Payment</skos:prefLabel>
    </owl:Class>
    


