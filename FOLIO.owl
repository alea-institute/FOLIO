        <skos:altLabel xml:lang="ja-jp">対価 - 知的財産資産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">考虑因素 - 知识产权资产</skos:altLabel>
        <skos:definition>Intellectual property (IP) consideration refers to the valuation and transfer of intangible assets, such as patents, trademarks, copyrights, and trade secrets, from the seller to the buyer as part of the deal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RH0L3Ly427nlRy8H0l2qy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8RH0L3Ly427nlRy8H0l2qy">
