        <skos:altLabel xml:lang="fr-fr">Calendriers de divulgation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cronogramas de divulgação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disclosure Schedules</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Offenlegungspläne</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לוחות חשיפה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डिस्क्लोजर शेड्यूल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">披露计划</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">開示スケジュール</skos:altLabel>
        <skos:definition>Disclosure Schedules are documents that provide detailed information about a company&apos;s assets, liabilities, contracts, and other important information that is relevant to a merger or acquisition transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKexhdVzZjFztyyADrmDCf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RKexhdVzZjFztyyADrmDCf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8WhsyEOse5TvMLfnHDYfTY"/>
        <rdfs:label>Apricots</rdfs:label>
        <skos:altLabel>Prunus Armeniaca</skos:altLabel>
        <skos:definition>Apricots are small, golden-orange stone fruits from the Prunus armeniaca species, characterized by their smooth, velvety skin and sweet-tart flavor. They are consumed fresh, dried, or processed into jams, juices, and desserts, valued for their high vitamin A and fiber content, as well as their antioxidant properties.</skos:definition>
    </owl:Class>
    


