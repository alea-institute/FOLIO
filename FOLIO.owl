        <rdfs:label>Thyroid Gland Cancer</rdfs:label>
        <skos:altLabel>Endocrine Cancer</skos:altLabel>
        <skos:altLabel>Thyroid Carcinoma</skos:altLabel>
        <skos:definition>Thyroid cancer is a type of cancer that originates in the thyroid gland, which is located at the base of the neck and produces hormones that regulate metabolism. It is typically treatable and often requires treatments such as surgery, radioactive iodine therapy, and hormone therapy.</skos:definition>
        <skos:prefLabel>Thyroid Cancer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R3JSBxP8r1OUSNgxHhgv9 -->

