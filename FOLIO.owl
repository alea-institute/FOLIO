    <!-- https://folio.openlegalstandard.org/RCB0KbeObg1BkFvPTjiDVgw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCB0KbeObg1BkFvPTjiDVgw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBNTLgdEoQpfLgYExWmsFao"/>
