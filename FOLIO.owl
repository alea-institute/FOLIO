    <owl:Class rdf:about="https://folio.openlegalstandard.org/R745pVbLIY0Z6vrFh0V8OoD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Luba-Lulua</rdfs:label>
        <skos:altLabel xml:lang="de-de">Luba-Lulua</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Luba-Lulua</skos:altLabel>
