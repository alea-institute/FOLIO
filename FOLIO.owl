        <rdfs:label>Claim Construction Practice</rdfs:label>
        <skos:altLabel>Claim Construction</skos:altLabel>
        <skos:altLabel>Claim Construction Service</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Auslegungspraxis von Ansprüchen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Claim Construction Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de construction de revendications</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de construcción de reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de construcción de reivindicaciones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de construção de reivindicações</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פרקטיקת בניית טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा निर्माण अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クレーム解釈の実務</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">权利要求解释实践</skos:altLabel>
        <skos:definition>Claim Construction Practice refers to the process of analyzing and interpreting the language used in patent claims to determine the scope of the invention, and is a subset of Fact Investigation and Development.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuQrjxxvpOmozofPFu0LZ2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuQrjxxvpOmozofPFu0LZ2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs"/>
        <rdfs:label>Non-Main Proceeding (Foreign Insolvency)</rdfs:label>
        <skos:definition>A non-main proceeding in foreign insolvency is an ancillary insolvency case initiated in a jurisdiction other than where the debtor&apos;s center of main interests (COMI) is located. This proceeding handles local assets and operations, complementing the main proceeding by addressing regional concerns and facilitating cooperation in cross-border insolvency cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuRxGOKd3SAaEl1onp3VV3Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuRxGOKd3SAaEl1onp3VV3Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R325XgE86TFi0q8WvxwrJ4w"/>
        <rdfs:label>X300 Discovery/eDiscovery Collection-Forensic</rdfs:label>
        <skos:definition>Any costs associated with the retrieval of collection materials for forensic purposes when billed as an expense instead of a service</skos:definition>
        <skos:prefLabel>X300 Discovery/eDiscovery Collection-Forensic</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuTiqSJ76kL8qUWS8cae3Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuTiqSJ76kL8qUWS8cae3Z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9u4hHZJYFWdtdGcgkoqz1x"/>
        <rdfs:label>Noncompete Agreement</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Accord de non-concurrence</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Acordo de não concorrência</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acuerdo de no competencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de no competencia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Noncompete Agreement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wettbewerbsverbot-Vereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם לא להתחרות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गैर-प्रतिस्पर्धा समझौता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ノンコンペティション契約</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">竞业禁止协议</skos:altLabel>
        <skos:definition>A Noncompete Agreement is a legal contract between an employer and an employee that restricts the employee from working for a competitor or starting a competing business for a certain period of time after leaving the employer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuUeDwicdR6OBqs9C9vMpd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuUeDwicdR6OBqs9C9vMpd">
