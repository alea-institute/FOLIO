        <skos:altLabel xml:lang="de-de">Anspruch auf Ressourcenschonung und -rückgewinnung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de conservación y recuperación de recursos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de conservación y recuperación de recursos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de conservação e recuperação de recursos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Resource Conservation and Recovery Claim</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de conservation et de récupération des ressources</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת שימור ומחזור משאבים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संसाधन संरक्षण और पुनर्प्राप्ति दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">資源保全および回収請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">资源保护和回收索赔</skos:altLabel>
        <skos:definition>A Resource Conservation and Recovery Claim is a legal claim related to the management and disposal of hazardous waste, aimed at ensuring the protection of human health and the environment.</skos:definition>
        <skos:prefLabel>Hazardous Waste Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBdvVmVo4DBFTBGCs5es5gp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBdvVmVo4DBFTBGCs5es5gp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDN8CVqeiDlOeHJO8Oeltq6"/>
        <rdfs:label>Temperate Market Segment</rdfs:label>
        <skos:definition>The temperate market segment refers to consumers or businesses located in regions characterized by moderate temperatures, typically experiencing distinct seasonal changes. This segmentation allows businesses to cater to the needs of individuals living in areas with a temperate climate, offering products and services suitable for varying weather conditions throughout the year.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBdx2EE9c4xHSypmLdJ2QrA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBdx2EE9c4xHSypmLdJ2QrA">
