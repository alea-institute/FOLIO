        <dc:identifier>DEFT</dc:identifier>
        <rdfs:label>Defendant</rdfs:label>
        <skos:altLabel xml:lang="de-de">Beklagter</skos:altLabel>
        <skos:altLabel>Defendant</skos:altLabel>
        <skos:altLabel>Defense</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Defendant</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Demandado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Demandado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Défendeur</skos:altLabel>
        <skos:altLabel>Respondent</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Réu</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נאשם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिवादी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">被告</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">被告人</skos:altLabel>
        <skos:definition>A defendant or respondent is a person or group against whom a criminal or civil action is brought. Actions include dispute matters (litigation, arbitration or mediation) or bankruptcy matters.</skos:definition>
        <skos:hiddenLabel>DEFT</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rijn2Efl5I4ixKTA86MDfT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rijn2Efl5I4ixKTA86MDfT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_08"/>
        <rdfs:label>Spinal Cord Disorders</rdfs:label>
        <skos:altLabel>Spinal Cord Disease</skos:altLabel>
        <skos:altLabel>Spinal Cord Injury</skos:altLabel>
        <skos:definition>Spinal cord disorders involve conditions that affect the spinal cord, impairing its function and potentially causing a range of neurological and physical disabilities. These disorders can result from trauma, disease, or degeneration, impacting the transmission of nerve signals between the brain and the rest of the body.</skos:definition>
        <skos:prefLabel>Myelopathy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RijoEB1Jm3daO9tu8Xcirj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RijoEB1Jm3daO9tu8Xcirj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Mitchell County</rdfs:label>
        <skos:definition>Georgia Superior Court - Mitchell County: A court of general jurisdiction in the state of Georgia that has the authority to hear and decide civil and criminal cases within Mitchell County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rijz2yDnioeblXoMdxow8K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rijz2yDnioeblXoMdxow8K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsWDLg5JUKHPw6my6QzmoU"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9q7GJc1zsYT0P4Xdp6l9Oz"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBDhSx7fl9qS0ezDVJuZHX4"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Litigation Risk</rdfs:label>
        <skos:definition>Litigation Risk refers to the potential for negative consequences arising from legal disputes, claims, or lawsuits involving an organization or its representatives. This can result from contractual breaches, regulatory noncompliance, intellectual property infringement, or negligence, potentially leading to financial losses, reputational damage, or operational disruptions, ultimately impacting the organization&apos;s overall performance, credibility, and sustainability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RikjKAB2GQa9wClhzmpv5z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RikjKAB2GQa9wClhzmpv5z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
        <rdfs:label>Rent Control Claim</rdfs:label>
        <skos:altLabel>Rent Control</skos:altLabel>
        <skos:definition>A rent control claim typically involves a dispute or legal action related to rent control regulations imposed by local or state governments. These claims can arise when landlords or tenants believe that the rent control policies have been violated, whether through excessive rent increases, failure to provide required services, or other alleged breaches of rent control laws. The resolution of such claims often involves legal proceedings, where the rights and responsibilities of landlords and tenants are assessed in light of applicable rent control regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RinXl4urWx7TwIp2BkkFVF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RinXl4urWx7TwIp2BkkFVF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9d2DkaIPGh2tQoNNOoEBMu"/>
        <rdfs:label>UTBMS MH00 Closing Matters</rdfs:label>
        <skos:definition>The UTBMS MH00 Closing Matters is a subcategory of the UTBMS Mergers and Acquisitions (M&amp;A) code set, which pertains to the legal tasks and activities involved in finalizing a merger or acquisition transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RinkUCYEWeC702L4eg88JJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RinkUCYEWeC702L4eg88JJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8HLLl44Pya8Fp0uN3ewKRW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RXYs8ARlSsDYANh0mkR3r5"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
        <rdfs:label>Knowledge Management Risk</rdfs:label>
        <skos:definition>The threats and opportunities associated with an organization&apos;s collection and management of knowledge, including intellectual property, organizational or operational information and records, and scientific data. This includes the potential for negative consequences arising from an organization&apos;s inability to effectively capture, store, share, and leverage its collective knowledge and expertise. This can result from poor knowledge management practices, inadequate systems, or employee turnover, potentially leading to inefficiencies, loss of intellectual capital, or reduced innovation and competitiveness.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RinqHf65TtUhr762WKqN6R -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RinqHf65TtUhr762WKqN6R">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIuHPBKs3x9tZ0vRBJ76AI"/>
        <rdfs:label>Personal Jurisdiction</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Juridiction personnelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Jurisdicción Personal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Jurisdicción Personal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição pessoal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Personal Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט אישי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यक्तिगत अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">个人管辖权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">個人管轄権</skos:altLabel>
        <skos:definition>The concept of Personal Jurisdiction refers to the power of a court to hear and decide a case involving a particular defendant, based on the defendant&apos;s connection to the forum state, as determined by the legal rules and principles governing jurisdiction.</skos:definition>
    </owl:Class>
    


