        <rdfs:label>Mistake in Contract</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Erreur de contrat</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Erro no contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Error en el contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Error en el contrato</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mistake in Contract</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertragsfehler</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טעות בחוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध में गलती</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合同错误</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約上の誤り</skos:altLabel>
        <skos:definition>A Mistake in Contract is a legal claim that arises when one or both parties to a contract make an error in the terms of the agreement, which can render the contract void or unenforceable.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJGMnN7yTc0q47GdgOfZfP -->

