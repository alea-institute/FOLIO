            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Incumbency Certificate</rdfs:label>
        <skos:definition>An Incumbency Certificate is a legal document issued by a corporation or organization, certifying the names and positions of its current officers, directors, and, in some cases, key employees. It serves as official evidence of the authority of specific individuals to act on behalf of the corporation or organization in legal and financial transactions.</skos:definition>
        <skos:prefLabel>Certificate of Incumbency</skos:prefLabel>
    </owl:Class>
    


