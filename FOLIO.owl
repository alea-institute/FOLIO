        <skos:altLabel xml:lang="es-es">Sentencia Administrativa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sentencia Administrativa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sentença administrativa</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verwaltungsurteil</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פסק דין מנהלתי</skos:altLabel>
