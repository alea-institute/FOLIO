        <rdfs:label>Longshore and Harbor Workers’ Compensation Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Longshore and Harbor Workers&apos; Compensation Act</skos:altLabel>
        <skos:altLabel>LHWCA Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Longshore and Harbor Workers’ Compensation Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Compensación de Trabajadores de la Costa y el Puerto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Compensación de Trabajadores de la Costa y el Puerto</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de indenização de acordo com a Lei de Compensação de Trabalhadores de Longshore e Harbor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la compensation des travailleurs des ports et des quais</skos:altLabel>
