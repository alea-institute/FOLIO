        <rdfs:label>Oregon Circuit Court - Polk County</rdfs:label>
        <skos:definition>The Oregon Circuit Court - Polk County is a specific court within the Oregon Circuit Court system that has jurisdiction over legal proceedings in Polk County, Oregon.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMhdMQiopYIhY2KHOUANIZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBMhdMQiopYIhY2KHOUANIZ">
