    <!-- https://folio.openlegalstandard.org/R8JM6rpfa00K75qJEo3ghVb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JM6rpfa00K75qJEo3ghVb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/REFNhmFYG6yk3W0RPLFV6g"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_09"/>
        <rdfs:label>Multiple Sclerosis</rdfs:label>
        <skos:altLabel>MS</skos:altLabel>
        <skos:definition>Multiple Sclerosis (MS) is a chronic autoimmune disease that affects the central nervous system (CNS), leading to the destruction of the protective myelin sheath covering nerve fibers. This demyelination disrupts nerve signals, resulting in symptoms such as muscle weakness, coordination problems, visual disturbances, and cognitive impairments.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JQFdoJa70Do7hIAD4wEWZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JQFdoJa70Do7hIAD4wEWZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCTnebwmInNgHYwFLgAOf0z"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDroRAFhNybTCHv1WlHGerL"/>
        <rdfs:label>Employment Written Warning</rdfs:label>
        <skos:altLabel>Official Warning</skos:altLabel>
        <skos:altLabel>Written Reprimand</skos:altLabel>
        <skos:definition>An Employment Written Warning is a formal document issued by an employer to an employee, outlining specific instances of misconduct or performance issues. It serves as an official notice that continued violations may result in further disciplinary action, including termination.</skos:definition>
        <skos:prefLabel>Documented Reprimand</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JVOGBEzEQHWl2bYk4uQam -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JVOGBEzEQHWl2bYk4uQam">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3LBDAXqjURNXVGHaWXf7s"/>
        <rdfs:label>Patent Assessment Process</rdfs:label>
        <skos:definition>The patent assessment process is a systematic investigation conducted to ascertain the novelty and non-obviousness of an invention by examining existing patents and other relevant technical literature. This process is crucial for determining the likelihood of obtaining a patent and avoiding infringement of existing patents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JWsBlOUIiJEyedJWcxIeU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JWsBlOUIiJEyedJWcxIeU">
