        <skos:altLabel xml:lang="es-es">Acuerdo de asunción de arrendamiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de asunción de arrendamiento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lease Assumption Agreement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Übernahmevereinbarung für Mietverträge</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם להנחת שכירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लीज़ असमंजस मसला</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リースアサンプション契約</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">租赁承接协议</skos:altLabel>
        <skos:definition>A Lease Assumption Agreement is a legal contract that allows a new tenant to take over the lease of a property from the original tenant, with the consent of the landlord, and outlines the terms and conditions of the transfer.</skos:definition>
    </owl:Class>
    


