        <rdfs:label>Contracts Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Contracts Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Contratos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Contratos</skos:altLabel>
