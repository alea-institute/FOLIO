        <rdfs:label>DUPLICATE Motion to Use Cash Collateral</rdfs:label>
        <skos:definition>A &quot;Duplicate Motion to Use Cash Collateral&quot; refers to a request made by a party in a bankruptcy case to use cash collateral that has already been requested by another party, and is no longer valid due to being a duplicate.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4bKZgiRrzNCvtcrGEiPaM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R4bKZgiRrzNCvtcrGEiPaM">
