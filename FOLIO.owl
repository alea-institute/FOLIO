        <rdfs:label>Investment Assets</rdfs:label>
        <skos:altLabel>Financial Instruments</skos:altLabel>
        <skos:definition>Investment assets are financial instruments or physical assets acquired with the expectation that they will generate returns or appreciate in value over time. These can include stocks, bonds, real estate, mutual funds, and other forms of financial or tangible properties.</skos:definition>
        <skos:prefLabel>Securities Assets</skos:prefLabel>
    </owl:Class>
    


