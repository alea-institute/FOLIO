    <!-- https://folio.openlegalstandard.org/RCAIUgUHLdwFdtdPTruyEgL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCAIUgUHLdwFdtdPTruyEgL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQR64SI6XmYz5JlNaDUOZN"/>
