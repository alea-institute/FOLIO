        <skos:altLabel>Family-Owned Business</skos:altLabel>
        <skos:definition>A closely held company is a business entity in which a small group of shareholders controls the majority of shares. Typically, these shareholders are family members or close associates, and the company&apos;s shares are not publicly traded.</skos:definition>
        <skos:prefLabel>Closely Held Enterprise</skos:prefLabel>
        <skos:prefLabel>Family Wealth Entity</skos:prefLabel>
    </owl:Class>
    


