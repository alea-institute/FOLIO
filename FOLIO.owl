    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wTjG87inLToLVFOswXIr1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9wTjG87inLToLVFOswXIr1">
