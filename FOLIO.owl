        <skos:altLabel xml:lang="es-es">Mociones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motions</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mouvements</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Movimentos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आवाज़</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">モーション</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">动议</skos:altLabel>
        <skos:definition>A motion is a written request made to a court asking for a specific action to be taken in a legal case, such as a request for a ruling or a request for evidence to be excluded.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79l2IoqX4ogtsb5ZRVMWG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79l2IoqX4ogtsb5ZRVMWG">
