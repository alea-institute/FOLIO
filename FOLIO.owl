    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/C1U0eLMZRz6-1FBYu3FNbQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/C1U0eLMZRz6-1FBYu3FNbQ">
