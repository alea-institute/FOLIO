        <skos:altLabel xml:lang="fr-fr">Prestataire de services juridiques</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Proveedor de servicios legales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Proveedor de servicios legales</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtsdienstleister</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ספק שירותי משפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी सेवा प्रदाता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法務サービスプロバイダー</skos:altLabel>
