        <rdfs:label>Duala</rdfs:label>
        <skos:altLabel xml:lang="de-de">Duala</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Duala</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Duala</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ドゥアラ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">杜阿拉</skos:altLabel>
        <skos:definition>Duala is a structured system of communication consisting of grammar and vocabulary, and is a member of the language family.</skos:definition>
    </owl:Class>
    


