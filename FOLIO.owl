        <rdfs:label>By Calendar Time Period</rdfs:label>
        <skos:altLabel xml:lang="en-gb">By Calendar Time Period</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nach Kalenderzeitraum</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Par période de temps calendrier</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Por período de tempo calendário</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Por período de tiempo del calendario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Por período de tiempo del calendario</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לפי תקופת זמן בלוח השנה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कैलेंडर समय अवधि द्वारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">カレンダー期間別</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">按日历时间段</skos:altLabel>
        <skos:definition>A fixed fee for a calendar time range (e.g., each month, for six months, each calendar year) is also known as a &quot;Subscription Fee&quot;.</skos:definition>
        <skos:prefLabel>By Subscription Fee</skos:prefLabel>
    </owl:Class>
    


