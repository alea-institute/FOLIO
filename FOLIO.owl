            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Statement of Executive Compensation</rdfs:label>
        <skos:altLabel>Senior Management Remuneration Disclosure</skos:altLabel>
        <skos:definition>A Statement of Executive Compensation is a disclosure detailing the remuneration packages of a company&apos;s key executives and directors. It is usually included in annual proxy statements and is required by securities regulators.</skos:definition>
        <skos:prefLabel>Executive Pay Report</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCJxT8owExowpSyNfFH8M1b -->

