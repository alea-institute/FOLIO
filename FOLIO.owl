    <!-- https://folio.openlegalstandard.org/RD0aZP7ft4vKJPvLQnZ6tNP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RD0aZP7ft4vKJPvLQnZ6tNP">
