        <rdfs:label>Pennsylvania Court of Common Pleas -  Cambria County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Cambria County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering civil and criminal proceedings at the county level in Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIJdsy4FtlIY1Dfn4jL7xl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIJdsy4FtlIY1Dfn4jL7xl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Samoan</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Samoan</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Samoanisch</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Samoano</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サモア語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">萨摩亚语</skos:altLabel>
        <skos:definition>A language spoken in Samoa and other Pacific islands, characterized by a unique phonology and grammar.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIKYiLwdzOMJsPyy5ui5Eo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIKYiLwdzOMJsPyy5ui5Eo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
        <rdfs:label>Employee Fraud</rdfs:label>
        <skos:definition>Employee Fraud refers to the deliberate act of deception by an employee aimed at obtaining unauthorized benefits, such as stealing assets, manipulating financial statements, or misappropriating company funds, often resulting in financial loss and legal liability for the organization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RILQypXcjvqd1GxNIcqsb7 -->

