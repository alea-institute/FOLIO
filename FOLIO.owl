        <rdfs:label>Health Insurance Portability and Accountability Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über die Portabilität und Rechenschaftspflicht von Krankenversicherungen</skos:altLabel>
        <skos:altLabel>HIPAA</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Health Insurance Portability and Accountability Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Portabilidad y Responsabilidad del Seguro Médico</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Portabilidad y Responsabilidad del Seguro de Salud</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Portabilidade e Responsabilidade do Seguro de Saúde</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la portabilité et la responsabilité de l&apos;assurance maladie</skos:altLabel>
