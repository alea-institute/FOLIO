        <rdfs:label>Motions Regarding Litigation Scope</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anträge zur Prozessumfang</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones sobre el alcance del litigio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones sobre el alcance del litigio</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motions Regarding Litigation Scope</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions concernant la portée du litige</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petições sobre o escopo do litígio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות בנושא תיחום ההליך המשפטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मुकदमे की दायरे की बारें में याचिकाएं</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">关于诉讼范围的动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴訟範囲に関する動議</skos:altLabel>
        <skos:definition>A Motion Regarding Litigation Scope is a formal request made to a trial court to determine the boundaries and extent of a legal case, including which issues will be addressed and which parties will be involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4">
