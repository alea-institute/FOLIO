        <skos:altLabel xml:lang="es-es">Petición de regalía continua</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Royalty Contínuo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de redevances continues</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לגבי זכויות יוצרים קבועות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लगातार रॉयल्टी के लिए मोशन</skos:altLabel>
