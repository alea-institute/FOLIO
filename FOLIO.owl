        <skos:altLabel xml:lang="fr-fr">Diffamation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Libel</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verleumdung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגיעה במוניטין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपमान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">名誉毀損</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">诽谤</skos:altLabel>
