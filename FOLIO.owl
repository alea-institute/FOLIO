            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Failure to Prevent Discrimination</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Défaut de prévention de la discrimination</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Failure to Prevent Discrimination</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha na prevenção da discriminação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de prevención de la discriminación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta de prevención de la discriminación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versäumnis der Diskriminierungsprävention</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כשל במניעת הפלילה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भेदभाव रोकने में विफलता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">差別の防止義務違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未能防止歧视</skos:altLabel>
        <skos:definition>Failure to prevent discrimination refers to a situation in which an employer, organization, or entity neglects to take appropriate steps to address and deter discriminatory actions or practices within their environment. This may include not establishing and enforcing clear policies, failing to provide training or education on discrimination and harassment, or neglecting to investigate and remedy complaints of discrimination.</skos:definition>
    </owl:Class>
    


