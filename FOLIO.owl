        <rdfs:label>WC530 Oral Argument</rdfs:label>
        <skos:definition>Preparing for oral argument, Argue an appeal, Travel to &amp; from, Pre and post argument communication re appeal.</skos:definition>
        <skos:prefLabel>WC530 Oral Argument</skos:prefLabel>
    </owl:Class>
    


