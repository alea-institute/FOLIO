        <dc:source rdf:resource="https://nna.jse.co.za/Help/cfi.htm"/>
        <rdfs:label>Degree of Payment Completeness</rdfs:label>
        <skos:altLabel>Payment Completion Degree</skos:altLabel>
        <skos:altLabel>Payment Fulfillment Level</skos:altLabel>
        <skos:altLabel>Payment Progress</skos:altLabel>
        <skos:definition>Degree of Payment Completeness refers to the extent to which a financial obligation or transaction has been fulfilled. This attribute encompasses varying levels of payment completion, such as nothing paid, partial payment (including installment payments), and full payment.</skos:definition>
        <skos:prefLabel>Payment Status</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCqEOIQE7piF24rITlbKn6q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCqEOIQE7piF24rITlbKn6q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVaHiNBU68DENmeHicnzro"/>
        <rdfs:label>Literary Work</rdfs:label>
        <skos:altLabel>Literary Creation</skos:altLabel>
        <skos:altLabel>Textual Composition</skos:altLabel>
        <skos:altLabel>Textual Work</skos:altLabel>
        <skos:altLabel>Written Material</skos:altLabel>
        <skos:altLabel>Written Work</skos:altLabel>
        <skos:definition>A Literary Work is a written or printed creation that conveys ideas, stories, or information through text. Protected under copyright law, literary works grant the author or creator exclusive rights to reproduce, distribute, and adapt the content.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCqNh1E2F3Sm3oLqcQtSISm -->

