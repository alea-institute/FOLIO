        <skos:altLabel xml:lang="de-de">Einschließlich ohne Einschränkungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Including Without Limitation Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כולל ללא הגבלה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सीमा के बिना समेत क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">制限なし条項を含む</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">包括无限制条款</skos:altLabel>
        <skos:definition>An &quot;Including Without Limitation Clause&quot; is a provision in a contract that clarifies that the listed items are not an exhaustive list and that other items may also be included.</skos:definition>
    </owl:Class>
    


