    <!-- https://folio.openlegalstandard.org/R7AmeNgjfQZpQke0m4cLKYq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7AmeNgjfQZpQke0m4cLKYq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_18"/>
        <rdfs:label>Persistent Hematological Complications</rdfs:label>
        <skos:altLabel>Chronic Complications of Hematologic Conditions</skos:altLabel>
        <skos:altLabel>Recurring Blood Disorder Complications</skos:altLabel>
        <skos:definition>Repeated complications of hematological disorders refer to persistent or recurring health issues that arise from chronic or severe blood disorders. These complications may include repeated infections, bleeding episodes, or other serious health effects that require ongoing medical intervention and can significantly impact a patient&apos;s quality of life.</skos:definition>
        <skos:prefLabel>Repeated Complications of Hematological Disorders</skos:prefLabel>
    </owl:Class>
    


