        <rdfs:label>Procedural Motions - Trial Court</rdfs:label>
        <skos:altLabel xml:lang="es-es">Mociones Procesales - Tribunal de Primera Instancia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones Procesales - Tribunal de Primera Instancia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Motions processuais - Tribunal de primeira instância</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions procédurales - Tribunal de première instance</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Procedural Motions - Trial Court</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verfahrensanträge - erstinstanzliches Gericht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועות תהליכיות - בית המשפט לניסיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रक्रियात्मक याचिकाएं - ट्रायल कोर्ट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">手続き上の動議 - 初審裁判所</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">程序动议 - 初审法院</skos:altLabel>
        <skos:definition>A Procedural Motion in Trial Court refers to a formal request made by a party to the court during a trial, seeking a specific action or decision from the court, such as a request for sanctions or attorney fees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yR81Wc2emCwiLUzBFFyyg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8yR81Wc2emCwiLUzBFFyyg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9o2vztaSaUUlhhynoAcieJ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8g9E8c4U6pZQefIjUNRuDd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Personal Care Products</rdfs:label>
        <skos:definition>In the context of bankruptcies and monthly spending budgets, Personal Care Products refer to non-medical goods purchased for hygiene or beautification, such as toiletries, cosmetics, and grooming supplies. These are generally considered non-discretionary expenses, but their allocation may be scrutinized during a bankruptcy process to determine reasonable living expenses for the debtor</skos:definition>
    </owl:Class>
    


