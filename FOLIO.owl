        <skos:altLabel xml:lang="ja-jp">署名ボーナス条項</skos:altLabel>
        <skos:definition>A signing bonus clause is a provision in a contract that provides for an additional payment to be made to an individual upon signing the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ks4EFK3G3kUjRP4Fu5gtK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ks4EFK3G3kUjRP4Fu5gtK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8lhhP1c4Hm9RruhEpWMrJW"/>
        <rdfs:label>Death</rdfs:label>
        <skos:definition>Death, in a legal context, marks the end of a person&apos;s life, as well as the termination of an individual&apos;s legal rights and duties. It initiates the probate process, where a deceased&apos;s estate is settled, debts are paid, and assets are distributed to heirs or beneficiaries according to a will or intestate laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ktJqdQifgzEaV2DJkdMZa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ktJqdQifgzEaV2DJkdMZa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
        <rdfs:label>expense segment</rdfs:label>
        <skos:definition>Expense segment refers to a specific component within the LEDES XML E-Billing Ver. 2.2 standard, which includes information such as charge date, units, work location, expense code, and total amount for billing purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8kuuSDAoKCp6Qf5r0rX3Qj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8kuuSDAoKCp6Qf5r0rX3Qj">
