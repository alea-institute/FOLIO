    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/kGtkq19FQUKHxUs5jHd0wQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/kGtkq19FQUKHxUs5jHd0wQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/fQ5YI_QERnedTJ3dq7HMiA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=62161"/>
        <rdfs:label>Home Health Care Services</rdfs:label>
