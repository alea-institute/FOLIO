        <rdfs:label>Relay and Industrial Control Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing relays, motor starters and controllers, and other industrial controls and control accessories.</skos:definition>
    </owl:Class>
    


