        <skos:altLabel xml:lang="es-mx">Pagador</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pagador</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Payer</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Payeur</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zahler</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משלם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भुगतानकर्ता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">付款人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">支払人</skos:altLabel>
        <skos:definition>A person legally obligated to pay.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XbDT15o2VgPwJQmeNM4Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XbDT15o2VgPwJQmeNM4Y">
