        <skos:altLabel xml:lang="es-mx">Tasa base</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Taux de base</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Taxa básica</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tipo de interés base</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שער בסיס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बेस रेट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ベースレート</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">基准利率</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Cj1A31dy70CbB8b6Uzqh9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Cj1A31dy70CbB8b6Uzqh9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RhUwaBjg0AFfnJkZgYorpG"/>
        <rdfs:label>Entrepreneurial Buyer</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Acheteur entrepreneur</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Comprador Emprendedor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Comprador Emprendedor</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Comprador empreendedor</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Entrepreneurial Buyer</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unternehmerischer Käufer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קונה יזמותי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उद्यमी खरीदार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">创业买家</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">起業家バイヤー</skos:altLabel>
        <skos:definition>An entrepreneurial buyer is an individual or entity that engages in mergers and acquisitions with the primary goal of acquiring a business to actively manage and grow. These buyers often possess industry-specific knowledge, skills, or experience that enable them to identify opportunities and add value to the target company. Unlike financially driven buyers who focus mainly on generating financial returns, entrepreneurial buyers are more likely to take a hands-on approach, seeking to build and develop the acquired business for the long term, often driven by a strategic vision or passion for the industry.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CjPGdKf66GPkEst2jYGk8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CjPGdKf66GPkEst2jYGk8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCz0OhGJQscjwPvw2jQBP63"/>
        <rdfs:label>New York City Court - Yonkers</rdfs:label>
        <skos:definition>A court located in Yonkers, New York that operates under the jurisdiction of the New York City Court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CkwL8sW1mOa5qWVeJb7i3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CkwL8sW1mOa5qWVeJb7i3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROEhQluRR7rfqDyDYvJ3Dd"/>
        <rdfs:label>Travel Document Number</rdfs:label>
        <skos:definition>A Travel Document Number refers to a unique identifier assigned to a travel document, such as a visa or refugee travel document, by the issuing authority. This number is used for verification and identification purposes during international travel and border crossings, and it is required for various legal and administrative processes related to travel.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CnOvmitM11ptxXIxgCDYT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CnOvmitM11ptxXIxgCDYT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBIXc4MqHYUkxA0MXlxno1u"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Foreign Corporation Financial Disclosure</rdfs:label>
        <skos:definition>A Foreign Corporation Financial Disclosure, known in the U.S. as a Form 20-F, is an annual report submitted to the governmental entity (e.g., Securities and Exchange Commission) by foreign private issuers with securities listed on domestic (e.g., U.S.) exchanges. In the United States, the 20-F provides a comprehensive overview of the company&apos;s financial position and business operations, including audited financial statements, executive compensation, major shareholders, material risks, and other information required by the SEC.</skos:definition>
        <skos:prefLabel>20-F</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CppF8ctgc9584B4NEsb7Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CppF8ctgc9584B4NEsb7Y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkVEfL4H41pColicGhkXJb"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_05"/>
        <rdfs:label>Hodgkin Lymphoma</rdfs:label>
        <skos:altLabel>Reed-Sternberg Cell Lymphoma</skos:altLabel>
        <skos:definition>Hodgkin lymphoma is a type of cancer that originates in the lymphatic system, characterized by the presence of Reed-Sternberg cells. It typically begins in the lymph nodes and can spread to other organs, requiring specific treatment approaches distinct from those for non-Hodgkin lymphomas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CqXAX7bebNhN67uNZpBGk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CqXAX7bebNhN67uNZpBGk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RI5hwGjH6o0HX7MTQbZm3Q"/>
        <rdfs:isDefinedBy>From National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
        <rdfs:label>Probate Reason of Restoration</rdfs:label>
        <skos:altLabel xml:lang="es-es">Motivo de restauración de testamentaría</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Motivo de restauración de testamentaría</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Motivo de restauração do inventário</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Probate Reason of Restoration</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Raison de restauration de la succession</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wiederherstellungsgrund des Nachlasses</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיבת שחזור צו ירושה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रोबेट बहाली का कारण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">遗产恢复原因</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">遺産復元の理由</skos:altLabel>
        <skos:definition>Probate Reason of Restoration refers to the legal basis for filing a subsequent probate case to restore a previously revoked or invalidated will or trust.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CsDr2C4jiZvVKIrb12R4A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CsDr2C4jiZvVKIrb12R4A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSK8CbOPdmMwMyMIlw8pdO"/>
        <rdfs:label>New Mexico Magistrate Court - Eddy County</rdfs:label>
        <skos:definition>A court located in Eddy County, New Mexico that has limited jurisdiction over certain types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9CviKLACLe1HEP2cShDoPW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9CviKLACLe1HEP2cShDoPW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4nwMYlRLa9aP9pKWIZEE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rh51oMpYnnkIQkUt41V76O"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Non-Hearsay Document Objective</rdfs:label>
        <skos:altLabel>Document Reliability Principle</skos:altLabel>
        <skos:definition>The non-hearsay document objective is the legal principle that certain documents are admissible as evidence in court without being considered hearsay, due to their inherent reliability. These documents, such as business records, public records, and learned treatises, are deemed trustworthy because they are created and maintained in the regular course of activities and are used for important purposes.</skos:definition>
        <skos:prefLabel>Reliable Document Standard</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Cw8CmXhnaMRuej3PNXdDA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Cw8CmXhnaMRuej3PNXdDA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Presentment Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch aus der Vorlageklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Presentment Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Presentación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Presentación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Apresentação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de la clause de présentation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף ההצגה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रस्तुति धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">呈现条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">提示条項請求</skos:altLabel>
        <skos:definition>A Presentment Clause claim refers to a legal argument challenging the constitutionality of a law based on the requirements outlined in the Presentment Clause of the United States Constitution. This claim asserts that a law is invalid because it was not properly presented to the President for signature or veto, violating the constitutional process for enacting legislation and potentially rendering it unconstitutional.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Cy2HyrxJFo8tk0VgAkLKi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Cy2HyrxJFo8tk0VgAkLKi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RkvRD1NfpM4aO12DEEarGf"/>
        <rdfs:label>Friedreich’s Ataxia</rdfs:label>
        <skos:altLabel>Friedreich Ataxia</skos:altLabel>
        <skos:altLabel>Hereditary Spinocerebellar Degeneration</skos:altLabel>
        <skos:definition>Friedreich’s ataxia is a rare, inherited degenerative disorder that primarily affects the nervous system and the spinal cord. It is characterized by progressive loss of coordination, muscle weakness, and gait disturbances due to the degeneration of spinal cord pathways and cerebellum.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9D00mxrkbEo2ZeuWmb92Aw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9D00mxrkbEo2ZeuWmb92Aw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwdLsWxoa7TqpUv5hIYwzW"/>
        <rdfs:label>Corporate President</rdfs:label>
        <skos:altLabel>President</skos:altLabel>
        <skos:definition>A Corporate President is a senior executive often responsible for overseeing the day-to-day operations of a company and implementing strategic initiatives set by the board of directors. The President often acts as the second-highest-ranking officer in a company, reporting directly to the Chief Executive Officer (CEO) or, in some cases, the board.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9D2DdL2g2cYvFl3DpG9oxR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9D2DdL2g2cYvFl3DpG9oxR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Assignability Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abtretbarkeitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Assignability Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de cessibilité</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de asignación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de cedibilidade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cesión</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הקצאה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">असाइनेबिलिटी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">可转让条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">譲渡可能条項</skos:altLabel>
        <skos:definition>An Assignability Clause is a provision in a contract that allows one party to transfer their rights and obligations to another party without the consent of the other party.</skos:definition>
    </owl:Class>
    


