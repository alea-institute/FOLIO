        <rdfs:label>Non Waiver Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-renonciation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de no renuncia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no renuncia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de não renúncia</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Nichtverzichtserklärung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Non Waiver Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף לא וויר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गैर-वेवर क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不放弃条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">非放棄条項</skos:altLabel>
        <skos:definition>A non-waiver clause is a contractual provision that states that the failure to enforce a right or remedy under the contract does not constitute a waiver of that right or remedy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7YXMd6n1Pa9dmpBWmbf7tI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7YXMd6n1Pa9dmpBWmbf7tI">
