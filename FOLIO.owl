            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7ngAC5KMKiOazWcp35APHI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RyNiu4sHJoI3Rc5VGodCvc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Arrival / Departure Record</rdfs:label>
        <skos:altLabel>Entry/Exit Record</skos:altLabel>
        <skos:definition>Arrival / Departure Record (in the U.S., I-94 form) is a document used by the national immigration agency (e.g., U.S. Customs and Border Protection (CBP)) to track the arrival and departure dates of foreign visitors entering and leaving the destination country (e.g, United States). It contains information such as the visitor&apos;s name, birth date, country of citizenship, visa classification, and the authorized period of stay.</skos:definition>
        <skos:prefLabel>I-94</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCKc7w2R9XQ37PUQEkpe1CD -->

