        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkYo3iSgwRUW6XZnWD2PzD"/>
        <rdfs:label>Motion to Strike Complaint</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Streichung der Klage</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Rechazar la Demanda</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Strike Complaint</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de exclusão da petição inicial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Promoción de Incompetencia de la Autoridad</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en radiation de la plainte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להסרת תביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा हटाने की याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴状の棄却申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">驳回起诉状动议</skos:altLabel>
        <skos:definition>A Motion to Strike Complaint is a legal document filed by a party in a lawsuit requesting the court to remove or strike certain allegations or claims made by the opposing party in their complaint.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Q9yB6dZBNqz25bJG8azVc -->

