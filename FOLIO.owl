        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ffI3iiU2HojmiTTtoGwZP"/>
        <rdfs:label>Motion for Relief due to Earlier Judgment&apos;s Release or Vacation</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Erleichterung aufgrund der Freilassung oder Aufhebung eines früheren Urteils</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de alivio debido a la liberación o anulación de una sentencia anterior</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Relief due to Earlier Judgment&apos;s Release or Vacation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour soulagement en raison de la libération ou de l&apos;annulation d&apos;un jugement antérieur</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Alívio devido à Liberação ou Anulação de Julgamento Anterior</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de alivio debido a la liberación o anulación de una sentencia anterior</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להקלה עקב שחרור או ביטול פסק דין קודם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्व निर्णय के रिहाई या छुट्टी के कारण राहत के लिए मोशन</skos:altLabel>
