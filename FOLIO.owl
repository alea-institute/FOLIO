        <skos:altLabel>Congresswoman</skos:altLabel>
        <skos:altLabel>Member of Parliament</skos:altLabel>
        <skos:definition>A National Lower House Legislator is an elected official who serves as a member of the lower chamber in a bicameral national legislature. This individual is typically responsible for initiating legislation, representing local constituencies, and providing democratic accountability through more frequent elections compared to the upper house.</skos:definition>
        <skos:example>U.S. Representative</skos:example>
        <skos:prefLabel>U.S. Representative</skos:prefLabel>
    </owl:Class>
    


