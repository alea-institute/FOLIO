            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Wrongful Foreclosure Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf unrechtmäßige Zwangsvollstreckung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Ejecución Hipotecaria Improcedente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Ejecución Hipotecaria Injusta</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de Execução Hipotecária Indevida</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de forclusion abusive</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wrongful Repossession Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על מימוש משכנתא בלתי חוקי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गलत फॉरेक्लोजर दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不当な差し押さえ請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法查封索赔</skos:altLabel>
        <skos:definition>A wrongful foreclosure claim is a legal action brought by a borrower against a lender or creditor alleging that the foreclosure of their property was conducted improperly or unlawfully.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8xwNRZSntBjDSHWTLTABhP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8xwNRZSntBjDSHWTLTABhP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
        <rdfs:label>Country Risk</rdfs:label>
        <skos:definition>The risk that a foreign government will default on its bonds or other financial commitments. Country risk also refers to the broader notion of the stability of the country&apos;s financial system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8xwdTd5TVO5L4W2Dd5FUQf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8xwdTd5TVO5L4W2Dd5FUQf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ROaRQTFgM9oWtVX4k6v6I"/>
        <rdfs:label>Communication Accessibility Claim</rdfs:label>
        <skos:definition>This claim pertains to barriers that prevent individuals with disabilities from receiving or conveying information effectively. Examples include lack of sign language interpreters, inaccessible formats for the visually impaired, or lack of captioning for audio content.</skos:definition>
    </owl:Class>
    


