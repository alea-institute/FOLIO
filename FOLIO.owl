        <skos:altLabel xml:lang="de-de">Haftung für Vertragsbruchklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Liability for Breach of Contract Clause</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad por Cláusula de Incumplimiento de Contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad por Cláusula de Incumplimiento de Contrato</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade por cláusula de quebra de contrato</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité pour clause de rupture de contrat</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות על סעיף הפרת החוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध उल्लंघन शर्त के लिए दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約違反条項の責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违约条款的责任</skos:altLabel>
        <skos:definition>Liability for Breach of Contract Clause refers to the legal responsibility that arises when a party fails to fulfill their obligations as outlined in a specific clause within a contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbm4Kfsl4eSMWiwIMsQt0i -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbm4Kfsl4eSMWiwIMsQt0i">
