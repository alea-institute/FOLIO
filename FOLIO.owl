    <!-- https://folio.openlegalstandard.org/R66kux3H2uERxPz0E7KxtN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R66kux3H2uERxPz0E7KxtN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sHH7RvjZ6aZS7ZExDpYmR"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Emotion_classification#Plutchik.27s_wheel_of_emotions"/>
        <rdfs:label>Emotion</rdfs:label>
        <skos:definition>Emotions are complex psychological states involving subjective feelings, physiological arousal, and expressive behaviors, often triggered by external or internal events. They play a significant role in human behavior, decision-making, and interpersonal interactions, including legal contexts.</skos:definition>
        <skos:note>This is helpful for classifying various legal texts. For example, deposition testimony might state that the person was angry, leading to the murder. Other testimony might state that the person was fearful for their life, therefore the killing was justified.</skos:note>
    </owl:Class>
    


