        <rdfs:label>Doyon</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiQmbZDVlZqfNLx9f4O1Gn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiQmbZDVlZqfNLx9f4O1Gn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCLxFZZvTWZmKpUYJa6UMmO"/>
        <rdfs:label>400 State Reapportionment (PACER NoS)</rdfs:label>
        <skos:definition>Action filed under the Reapportionment Act of 1929 Ch. 28, 46 Stat. 21, 2 U.S.C. § 2a.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiRZCIYSrlWbUE4T76ifCF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiRZCIYSrlWbUE4T76ifCF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RMIoMi1OqwHKqsjgrjdaHj"/>
        <rdfs:label>Law Firm</rdfs:label>
        <skos:altLabel>External Counsel</skos:altLabel>
        <skos:altLabel>Solicitors&apos; Firm</skos:altLabel>
        <skos:definition>A law firm is a business entity with one or more lawyers and allied legal professionals to engage in the practice of law. It provides legal services to clients, including legal advice, representation in legal proceedings, and assistance with various legal matters.</skos:definition>
        <skos:prefLabel>Firm</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiSet6MT9RLX2H3PCqChrR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiSet6MT9RLX2H3PCqChrR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Retainage Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de rétention</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de retención</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de retención</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de retenção</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Retainage Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzugszinsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף החזקת כסף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रिटेनेज क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保留条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保留条項</skos:altLabel>
        <skos:definition>A retainage clause is a provision in a contract that allows the withholding of a portion of payment until the completion of the project or fulfillment of certain conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiTUO750LAdgZQOGZoxdsE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiTUO750LAdgZQOGZoxdsE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCjgFvO2VxpIklnhZMbSD9k"/>
        <rdfs:label>Catastrophic Health Insurance Policy</rdfs:label>
        <skos:definition>Catastrophic health insurance is a type of health coverage geared towards young adults under 30 and some low-income individuals who are exempt from other insurance requirements. These policies usually have lower premiums but higher out-of-pocket costs and are designed to protect the insured from major medical expenses, such as those incurred from severe accidents or illnesses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiTkrM68hmHkcFV06ncP2G -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiTkrM68hmHkcFV06ncP2G">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBZsudYglnckzDiIt6LK2fk"/>
        <rdfs:label>Antidumping Duty Payment</rdfs:label>
        <skos:altLabel>An Antidumping Duty Payment refers to the payment made by importers to the government as a result of antidumping duties imposed on imported goods sold below fair market value. These payments are collected to offset the effects of dumping and protect domestic industries from unfair competition.</skos:altLabel>
        <skos:altLabel>Antidumping Levy Payment</skos:altLabel>
        <skos:altLabel>Antidumping Tariff Payment</skos:altLabel>
        <skos:altLabel>Dumping Duty Payment</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiU7G7CzsM0qszsqDm4YXI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiU7G7CzsM0qszsqDm4YXI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Irrevocable Power of Attorney Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de procuration irrévocable</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de poder notarial irrevocable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de poder notarial irrevocable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de procuração irrevogável</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Irrevocable Power of Attorney Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für unwiderrufliche Vollmacht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כוח מניעה לא חוזרת של עו&quot;ד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपरिवर्तनीय वकालतानामा धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不可撤回の委任状条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不可撤销授权书条款</skos:altLabel>
        <skos:definition>An irrevocable power of attorney clause is a provision in a contract that grants authority to act on behalf of another person that cannot be revoked by the grantor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiV5HHhaHN0pKJWDG4PW7o -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiV5HHhaHN0pKJWDG4PW7o">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xekNn7K6SxToo5ArjIsTX"/>
        <rdfs:label>Motion to Supplement Pleading</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ergänzung der Klageschrift</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Escrito de ampliación de la demanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Escrito de ampliación de la demanda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion en vue de compléter la requête</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Supplement Pleading</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para complementar a petição inicial</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להוספת תביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">याचिका को संशोधित करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">补充起诉状动议书</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">訴状補充の申立て</skos:altLabel>
        <skos:definition>A Motion to Supplement Pleading is a formal request to add additional information or documents to a previously filed legal document, such as a complaint or answer, in order to provide more complete or accurate information to the court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiVfZ7BP4PauSUimCUXgI6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiVfZ7BP4PauSUimCUXgI6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCYi6mS48NndWCB54a2jYhR"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8jMnS8xwAtETggvD2KgMJF"/>
