        <skos:altLabel xml:lang="fr-fr">Application de la loi</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Law Enforcement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafverfolgung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אכיפת החוק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानूनी कार्रवाई</skos:altLabel>
