    <!-- https://folio.openlegalstandard.org/RSoAiGPfiabUiYu7kiUMpT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSoAiGPfiabUiYu7kiUMpT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Evergreen Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de reconduction tacite</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renovación automática</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renovación automática</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renovação automática</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Evergreen Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verlängerungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אברגרין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एवरग्रीन क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">常青条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自動更新条項</skos:altLabel>
        <skos:definition>An evergreen clause is a provision in a contract that automatically renews the agreement at the end of its term unless one of the parties gives notice to terminate.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSq6tKFNaCWBuzwBECDXiS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSq6tKFNaCWBuzwBECDXiS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLrqGkP9fi5OO2RhpttmVI"/>
        <rdfs:label>Household Income</rdfs:label>
        <skos:altLabel>Family Income</skos:altLabel>
        <skos:definition>Household income is the combined total income of all people living in a single household, regardless of their relationship to each other. This metric is often used for demographic, tax, and social services analysis to assess the economic status of a household.</skos:definition>
        <skos:prefLabel>Household Earnings</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSrWbfWvuIGTmJfHfS69Ja -->

