        <rdfs:label>Arkansas Circuit Court - Dallas Cty.</rdfs:label>
        <skos:definition>A court located in Dallas County, Arkansas that has jurisdiction over civil and criminal cases within its designated geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCwhWgOANCG4Vft4IxJLUdS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCwhWgOANCG4Vft4IxJLUdS">
