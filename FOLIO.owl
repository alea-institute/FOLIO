        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rub2xErcJ0t8GToQfoaVG1"/>
        <rdfs:label>Fruit Vegetables</rdfs:label>
        <skos:altLabel>Seed-Bearing Vegetables</skos:altLabel>
        <skos:definition>Fruit vegetables are a category of vegetables that develop from the flowering part of the plant and contain seeds, technically classifying them as fruits. They are consumed in savory dishes and valued for their diverse flavors, textures, and nutritional content, including vitamins, minerals, and antioxidants.</skos:definition>
    </owl:Class>
    


