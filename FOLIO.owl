        <skos:altLabel xml:lang="ja-jp">オセット語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">奥塞梯语</skos:altLabel>
        <skos:definition>A language spoken by the Ossetian people, primarily in the Caucasus region, which belongs to the Language top-level class in legal matters.</skos:definition>
    </owl:Class>
    


