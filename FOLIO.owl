        <skos:altLabel xml:lang="zh-cn">调解事件</skos:altLabel>
        <skos:definition>A Mediation Event is a specific type of Alternative Dispute Resolution (ADR) Event that involves a neutral third party facilitating communication and negotiation between parties in conflict, with the goal of reaching a mutually acceptable resolution.</skos:definition>
    </owl:Class>
    


