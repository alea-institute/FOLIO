        <skos:altLabel>Right of Way</skos:altLabel>
        <skos:altLabel>Right to Access</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Servidumbre</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Servidumbre</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Servidão</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Servitude</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות עבר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इज़ाफ़ा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">地役权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">地役権</skos:altLabel>
        <skos:definition>An easement is a legal right to use someone else&apos;s property for a specific purpose, such as accessing a neighboring property or using a shared driveway.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R93W1OsrC06bWnzo81FJ0PC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R93W1OsrC06bWnzo81FJ0PC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDWDi7o4XYIl6YajH1XLGU1"/>
        <rdfs:label>Closed-End Assets</rdfs:label>
        <skos:definition>Closed-End Assets refer to investment funds where units are sold on an organized exchange or in the over-the-counter market and are typically not redeemed by the issuing entity. These funds have a fixed number of units, and their capital remains constant, unlike open-end funds.</skos:definition>
        <skos:prefLabel>Closed-End Funds</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R93ZAZlATVYIKqfv3OkJFRI -->

