            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Employee Strike</rdfs:label>
        <skos:definition>Employee strike refers to a coordinated work stoppage by employees to protest against conditions like low wages, poor working conditions, or unfair labor practices. Strikes are generally organized by labor unions and aim to pressure employers into negotiations to address grievances.</skos:definition>
        <skos:prefLabel>Labor Strike</skos:prefLabel>
    </owl:Class>
    


