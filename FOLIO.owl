        <skos:altLabel xml:lang="de-de">Moderne Vergewaltigung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Viol moderne</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Violación moderna</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Violación moderna</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אונס מודרני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आधुनिक बलात्कार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">现代强奸</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現代レイプ</skos:altLabel>
        <skos:definition>Non-consensual sexual intercourse that involves physical force, coercion, or the inability to give consent, and which is prosecuted under contemporary legal definitions and standards.</skos:definition>
    </owl:Class>
    


