        <rdfs:label>New Mexico Magistrate Court - Roosevelt County</rdfs:label>
        <skos:definition>A court located in Roosevelt County, New Mexico that has limited jurisdiction over certain types of cases, such as traffic violations and misdemeanors.</skos:definition>
    </owl:Class>
    


