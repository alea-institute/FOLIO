        <skos:altLabel xml:lang="zh-cn">第13章收入申报</skos:altLabel>
        <skos:definition>A Declaration of Chapter 13 Income is a written statement that discloses the income of an individual who has filed for Chapter 13 bankruptcy.</skos:definition>
    </owl:Class>
    


