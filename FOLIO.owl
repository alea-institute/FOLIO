    <!-- https://folio.openlegalstandard.org/OJe1W2MTTxy1KIsdTSzAOg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/OJe1W2MTTxy1KIsdTSzAOg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/8FwY1QS9TE-QSEn2Mk_U4g"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3121"/>
        <rdfs:label>Beverage Manufacturing</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in manufacturing soft drinks and ice; purifying and bottling water; and manufacturing brewery, winery, and distillery products.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/OL-7f0qtQPKcHs9SKsi1DA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/OL-7f0qtQPKcHs9SKsi1DA">
