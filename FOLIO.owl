        <rdfs:label>L654 Second pass document review</rdfs:label>
        <skos:definition>Activities and actions related to second pass QC of data and documents coded for relevancy, issue codes, tagging, and initial privilege determination during the first pass review.</skos:definition>
        <skos:prefLabel>L654 Second pass document review</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIbkyG0mW87iAWUYXnIjnl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIbkyG0mW87iAWUYXnIjnl">
