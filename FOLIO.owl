        <rdfs:label>Tuition Reimbursement Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de remboursement des frais de scolarité</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Reembolso de Colegiatura</skos:altLabel>
