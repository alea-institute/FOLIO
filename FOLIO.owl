        <skos:altLabel xml:lang="fr-fr">Appels statutaires</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gesetzliche Berufungen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Recursos estatutários</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法定上訴</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法定上诉</skos:altLabel>
        <skos:definition>A statutory appeal is a type of appeal that is specifically authorized by a statute or law, and allows a party to challenge a decision made by a lower court or administrative agency.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wMn80MhrS9iqfKdQdH1A3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9wMn80MhrS9iqfKdQdH1A3">
