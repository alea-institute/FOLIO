        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm#5_05"/>
        <rdfs:label>Chronic Liver Disease</rdfs:label>
        <skos:altLabel>Long-Term Liver Disease</skos:altLabel>
        <skos:altLabel>Persistent Liver Dysfunction</skos:altLabel>
        <skos:definition>Chronic liver disease is a long-term condition characterized by persistent inflammation, damage, or dysfunction of the liver. This condition can result from various etiologies, including viral infections, alcohol abuse, or metabolic disorders, and may progress to more severe stages such as cirrhosis or liver failure, necessitating ongoing medical management.</skos:definition>
        <skos:prefLabel>Chronic Hepatic Disease</skos:prefLabel>
    </owl:Class>
    


