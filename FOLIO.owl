        <skos:altLabel xml:lang="ja-jp">税番号 - クライアント</skos:altLabel>
        <skos:definition>A Tax ID - Client is a specific type of Tax Detail that refers to the unique identification number assigned to a client for tax purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NLKPDCyexTiBJCz8mdsjz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NLKPDCyexTiBJCz8mdsjz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVoyN9hN3m5gy3So01ZEZ8"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RC2FDHzvt4NxqxLRzYtdPtp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RvlaTy71CtvBP85MiBpG8O"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Indenture</rdfs:label>
        <skos:definition>An Indenture is a formal legal document that sets forth the terms and conditions governing a relationship, usually involving debt securities such as bonds. It specifies the obligations of the issuer, the rights of the bondholders, and the responsibilities of the trustee, who acts as an intermediary between the two parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NOhFstiXFl3rquUpFNbjX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NOhFstiXFl3rquUpFNbjX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ4HPUl2DrL4G30lmoFKJN"/>
        <rdfs:label>Officer&apos;s Certificate</rdfs:label>
        <skos:altLabel>Corporate Attestation Document</skos:altLabel>
        <skos:altLabel>Secretary&apos;s Certificate</skos:altLabel>
        <skos:definition>An Officer&apos;s Certificate is a formal document executed by a company officer attesting to the accuracy of certain facts or figures, often in relation to the company&apos;s financials or compliance status. It is commonly used to validate representations made in contracts or agreements.</skos:definition>
        <skos:prefLabel>Certification of Authority</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NPkydcpHTaxlbO73SJZMd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NPkydcpHTaxlbO73SJZMd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NuHbXZluNRzq9D1bLM716"/>
        <rdfs:label>Explicit Agreement</rdfs:label>
        <skos:altLabel>An Explicit Agreement is a contract or agreement where the terms and conditions are clearly stated and agreed upon by all parties involved, leaving no room for ambiguity. This type of agreement can be either oral or written, provided the terms are clearly articulated and mutually understood.</skos:altLabel>
        <skos:altLabel>Clearly Defined Contract</skos:altLabel>
        <skos:altLabel>Direct Agreement</skos:altLabel>
        <skos:altLabel>Express Agreement</skos:altLabel>
        <skos:altLabel>Openly Stated Agreement</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NS2clrdzMdZxaKZRr45Tj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NS2clrdzMdZxaKZRr45Tj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRfuF3AuewVT4SR15di375"/>
        <dc:identifier>ENVT-FORR</dc:identifier>
        <rdfs:label>Forest Resources Law</rdfs:label>
        <skos:altLabel>Forest Resources</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forest Resources Law</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei de Recursos Florestais</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ley de Recursos Forestales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Recursos Forestales</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Loi sur les ressources forestières</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Waldressourcengesetz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק משאבי יער</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वन संसाधन विधि</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">森林資源法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">森林资源法</skos:altLabel>
        <skos:definition>Laws governing activities in designated forest lands, most commonly with respect to forest management and timber harvesting.</skos:definition>
        <skos:hiddenLabel>FORR</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NSvW60V29sGAOjRQtZDZy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NSvW60V29sGAOjRQtZDZy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDrgrPYJPo0Rj0YG5xJ2OMX"/>
        <rdfs:label>Business Intelligence Management</rdfs:label>
        <skos:definition>Business Intelligence Management refers to the systematic process of collecting, analyzing, and managing data to support strategic decision-making for a particular business. It involves the use of tools and techniques to transform raw data into meaningful insights that can inform business strategies and operations.</skos:definition>
        <skos:prefLabel>Business Analytics</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NUIwfAJqCZ01KNqq2Uj5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NUIwfAJqCZ01KNqq2Uj5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Mandatory Arbitration Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;arbitrage obligatoire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Arbitraje Obligatorio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Arbitraje Obligatorio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de arbitragem obrigatória</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mandatory Arbitration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verpflichtende Schiedsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חובתי של פתרון סכסוכים בבית המשפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनिवार्य विवाद-सुलझान शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">強制仲裁条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制性仲裁条款</skos:altLabel>
        <skos:definition>A mandatory arbitration clause is a provision in a contract that requires any disputes arising from the contract to be resolved through arbitration rather than through the court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NXBaBIdqkUFrXWxuQCdil -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NXBaBIdqkUFrXWxuQCdil">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCYl3LbuEyYdPvG9kHxRa3a"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RzLNZvmvjHqtxVfg3yhhM9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Goodwill</rdfs:label>
        <skos:altLabel xml:lang="de-de">Firmenwert</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fondo de comercio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fonds commercial</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Goodwill</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Valor intangible</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ágio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכויות סחירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गुणवत्ता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">のれん</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">商誉</skos:altLabel>
        <skos:definition>Goodwill is an intangible asset that represents the value of a business beyond its tangible assets and liabilities. It arises when one company acquires another for a price higher than the fair market value of its net identifiable assets. It also represents elements like excellence of management, customer loyalty, brand recognition, favorable location, or quality of employees and overall business going concern value that are not separately identifiable but contribute to generating future economic benefits.</skos:definition>
        <skos:prefLabel>Reputation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NXqK1uTl4KVVtXDo2R9RV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NXqK1uTl4KVVtXDo2R9RV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0M7MCKgv3PKyjZt8TXYMS"/>
        <rdfs:label>Monetary Inflow</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Afflux monétaire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Entrada monetária</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geldzufluss</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ingreso monetario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ingreso monetario</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Monetary Inflow</skos:altLabel>
        <skos:altLabel>Profit Center</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זרימת מזומנים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मौद्रिक नवीकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">货币流入</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">金銭流入</skos:altLabel>
        <skos:definition>External Actor pays Legal Services Buyer. Money flowing into the Legal Services Buyer. E.g., Litigation proceeds from plaintiff-side litigation. E.g., Legal Services Buyer hires Legal Services Provider to negotiate with a contractual counterparty, resulting in increased funds flowing to Legal Services Buyer. In Accounts Payable systems (e.g., Oracle), this is labeled &quot;Profit Center.&quot;</skos:definition>
    </owl:Class>
    


