        <skos:altLabel xml:lang="hi-in">समय बढ़ाने के लिए मोशन - ट्रायल कोर्ट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长时间动议 - 初审法院</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">期間延長申立て - 初審裁判所</skos:altLabel>
