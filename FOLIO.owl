    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R93hEwIlLdaoQt6jDbdRAIT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R93hEwIlLdaoQt6jDbdRAIT">
