        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=54169"/>
        <rdfs:label>Other Scientific and Technical Consulting Services</rdfs:label>
        <skos:definition>See industry description for 541690.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/O1Q0Ywb7QCmKrwFRSUHl4A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/O1Q0Ywb7QCmKrwFRSUHl4A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Do81p7GqTVSWefgMOcuJzw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=111422"/>
        <rdfs:label>Floriculture Production</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in growing and/or producing floriculture products (e.g., cut flowers and roses, cut cultivated greens, potted flowering and foliage plants, and flower seeds) under cover and in open fields.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/O1sHf7wRR2atFFie2DhDSQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/O1sHf7wRR2atFFie2DhDSQ">
