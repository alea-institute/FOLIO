    <!-- https://folio.openlegalstandard.org/R7oIpRW8ruWV68pwMEj5Z59 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7oIpRW8ruWV68pwMEj5Z59">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHYAaMF4QRHH9QwmNKGN8Y"/>
        <rdfs:label>Dyscalculia</rdfs:label>
        <skos:altLabel>Math Disorder</skos:altLabel>
        <skos:altLabel>Math Impairment</skos:altLabel>
        <skos:altLabel>Numerical Processing Disorder</skos:altLabel>
        <skos:definition>Dyscalculia is a specific learning disability that affects an individual&apos;s ability to understand, remember, and manipulate numbers and mathematical concepts. This condition leads to difficulties in performing arithmetic operations, understanding numerical relationships, and grasping abstract math concepts.</skos:definition>
        <skos:prefLabel>Mathematical Learning Disability</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7oJAhnRY9sc5jyWHuJDcsJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7oJAhnRY9sc5jyWHuJDcsJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCV40j08zvRl2faFV72w9aQ"/>
        <rdfs:label>Non-fundamental Representations and Warranties</rdfs:label>
        <skos:altLabel xml:lang="de-de">Nicht wesentliche Darstellungen und Gewährleistungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Non-fundamental Representations and Warranties</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Representaciones y garantías no fundamentales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Representaciones y garantías no fundamentales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Representações e garantias não fundamentais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Représentations et garanties non fondamentales</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצהרות ואזרויות לא-יסודיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गैर-मौलिक प्रतिनिधित्व और वारंटी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">非基本的表明および保証</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非基本陈述和保证</skos:altLabel>
        <skos:definition>Non-fundamental representations and warranties are the less essential or non-core statements made by a party in a contract, typically pertaining to the condition of a business, assets, or the accuracy of certain information. While important, these representations and warranties are generally considered less critical to the overall transaction than fundamental representations and warranties, which relate to crucial aspects such as the seller&apos;s ownership, authority, and the validity of the contract itself.</skos:definition>
    </owl:Class>
    


