        <skos:altLabel xml:lang="es-es">Receptor de necesidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Receptor de necesidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Receptor de necessidade</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מקבל צורך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आवश्यकता ग्राहक</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आवश्यकता प्राप्तकर्ता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">必要性レシーバー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">必要性接收器</skos:altLabel>
        <skos:definition>A &quot;Necessity&quot; Receiver is a type of receiver appointed by a court to take control of a company or property when it is necessary to prevent harm or damage to the property or its stakeholders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRC3CmU6w2he0zPcqr6J7p -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRC3CmU6w2he0zPcqr6J7p">
