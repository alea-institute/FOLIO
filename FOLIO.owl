        <skos:altLabel xml:lang="en-gb">Stipulation to Approve Document</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vereinbarung zur Genehmigung von Dokumenten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם לאישור מסמך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दस्तावेज़ को स्वीकृति देने के लिए अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">批准文件的规定</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書承認の規定</skos:altLabel>
        <skos:definition>A Stipulation to Approve Document is a legal agreement between parties that acknowledges the acceptance and approval of a written or recorded representation of thought or expression.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rl6PE24BNvgG9lGykrJaA5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rl6PE24BNvgG9lGykrJaA5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
        <rdfs:label>&quot;&apos;Reasonably likely/expected violation&apos; of fiduciary duties&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="de-de">&apos;Angemessen wahrscheinliche/erwartete Verletzung&apos; von Treuepflichten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">&apos;Reasonably likely/expected violation&apos; of fiduciary duties</skos:altLabel>
        <skos:altLabel xml:lang="es-es">&apos;Violación razonablemente probable/esperada&apos; de los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">&apos;Violación razonablemente probable/esperada&apos; de los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="he-il">&apos;הפרת חובות פידוסיאריות&apos; הסבירה והצפויה</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation raisonnablement probable/attendue des devoirs fiduciaires</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação &apos;razoavelmente provável/esperada&apos; de deveres fiduciários</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फिडुशियरी दायित्वों के &apos;यथाशंकित रूप से संभव/प्रत्याशित उल्लंघन&apos;</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">“合理可能/预期”的受托责任违规行为</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">信託義務の「合理的に予想される/予想される」違反</skos:altLabel>
        <skos:definition>A &quot;reasonably likely/expected violation&quot; of fiduciary duties refers to a breach of the legal obligation to act in the best interest of another party, which is anticipated or probable based on the circumstances and facts at hand, and may arise in the context of a no-shop covenant, an intervening event, or a superior offer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rl6fLTEVZYAxbZOGrrO7D8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rl6fLTEVZYAxbZOGrrO7D8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBqllOhzLheS3cnSiDAJ5H0"/>
        <rdfs:label>Food Poisoning Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Food Poisoning Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lebensmittelvergiftungsanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por intoxicación alimentaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação de intoxicação alimentar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por intoxicación alimentaria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation d&apos;intoxication alimentaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על רעלות מזון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खाद्य संबंधी अस्वस्थता का दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">食中毒請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">食物中毒索赔</skos:altLabel>
        <skos:definition>A food poisoning claim is a legal action seeking compensation for harm caused by consuming contaminated food, falling under the broader categories of personal injury claims and food liability claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rl85GSkvaA2yo65Frev9WN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rl85GSkvaA2yo65Frev9WN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBdRbQ6LheYkEvM4LBGBHps"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBPNQSqdDfSS0uPPJ8pfxVL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RlekwKRgprnAW5voZE8ShE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Non-Solicitation of Employees Covenant</rdfs:label>
        <skos:definition>A &quot;Non-Solicitation of Employees Covenant&quot; is a contractual provision where one party agrees not to approach, recruit, or hire the other party&apos;s employees for a specified duration. This type of covenant is often used in employment contracts, business sale agreements, and partnership agreements to prevent the departure of key personnel and to protect an organization&apos;s human resources from being poached by competitors or other entities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rl8MHhn3ljmvtKrI8alE5 -->

