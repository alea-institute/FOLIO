        <skos:altLabel xml:lang="he-il">המועצה הפדרלית לבדיקת מוסדות פיננסיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फेडरल फाइनेंशियल इंस्टीट्यूशंस एग्जामिनेशन कौंसिल</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">联邦金融机构审查委员会</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">連邦金融機関監査委員会</skos:altLabel>
        <skos:definition>The Federal Financial Institutions Examination Council (FFIEC) is a formal U.S. government interagency body composed of five banking regulators that is &quot;empowered to prescribe uniform principles, standards, and report forms to promote uniformity in the supervision of financial institutions&quot;.</skos:definition>
        <skos:hiddenLabel>FFIEC</skos:hiddenLabel>
        <skos:prefLabel>Federal Financial Institutions Examination Council</skos:prefLabel>
    </owl:Class>
    


