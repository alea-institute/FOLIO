        <dc:identifier>US-FD-USDA-APHIS</dc:identifier>
        <rdfs:label>Animal and Plant Health Inspection Service</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Animal and Plant Health Inspection Service</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Dienst für Inspektion von Tier- und Pflanzengesundheit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Service d&apos;inspection de la santé des animaux et des plantes</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Servicio de Inspección de Sanidad Agropecuaria y Forestal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Servicio de Inspección de Sanidad Agropecuaria y Forestal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Serviço de Inspeção de Saúde Animal e Vegetal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שירות הבקרה על בריאות החיות והצמחים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पशु और पौधों की स्वास्थ्य निरीक्षण सेवा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">动植物卫生检验局</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">動植物検疫所</skos:altLabel>
        <skos:definition>The Animal and Plant Health Inspection Service (APHIS) is an agency of the United States Department of Agriculture (USDA) based in Riverdale, Maryland responsible for protecting animal health, animal welfare, and plant health. APHIS is the lead agency for collaboration with other agencies to protect U.S. agriculture from invasive pests and diseases.</skos:definition>
        <skos:hiddenLabel>APHIS</skos:hiddenLabel>
        <skos:prefLabel>Animal and Plant Health Inspection Service</skos:prefLabel>
    </owl:Class>
    


