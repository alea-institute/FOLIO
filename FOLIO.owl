        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtSJkLiGzcKx8PVlCAB5q5"/>
        <rdfs:label>Application to Designate Responsible Individual</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Benennung einer verantwortlichen Person</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Application to Designate Responsible Individual</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande de désignation d&apos;une personne responsable</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Designação de Pessoa Responsável</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para Designar a un Individuo Responsable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud para Designar a un Individuo Responsable</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה למינוי אדם אחראי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जिम्मेदार व्यक्ति नियुक्ति के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">指定负责人申请</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">責任者指定申請書</skos:altLabel>
        <skos:definition>An Application to Designate Responsible Individual is a legal document filed in the context of bankruptcy proceedings, which allows for the appointment of an individual to oversee the administration of the debtor&apos;s estate.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RszUiYFgocCPkuHr4IzSzr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RszUiYFgocCPkuHr4IzSzr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:label>Payment Advices</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Avis de paiement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Avisos de Pagamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Avisos de pago</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Avisos de pago</skos:altLabel>
        <skos:altLabel>Employment Pay Stubs</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Payment Advices</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zahlungsanweisungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עצות לתשלום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भुगतान सलाह</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">付款通知</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">支払通知</skos:altLabel>
        <skos:definition>Payment Advices (Employment Pay Stubs) are written or electronic documents provided by an employer to an employee that show the details of their pay, including deductions and taxes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt0JqQ9ENDi6hglqbWBbJe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rt0JqQ9ENDi6hglqbWBbJe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Treaty Investor Visa</rdfs:label>
        <skos:altLabel xml:lang="en-us">E-2 Visa</skos:altLabel>
        <skos:definition>The Treaty Investor Visa is a type of visa offered by various countries to foreign nationals who intend to invest a significant amount of capital in the host country&apos;s economy. The visa is usually part of bilateral treaties between the host country and the investor&apos;s home country, aimed at encouraging economic cooperation and foreign investment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt1IQ6Xz3xIuCqfEanqIQx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rt1IQ6Xz3xIuCqfEanqIQx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8OXAl4XER5P7DRJEzq7Hg7"/>
        <rdfs:label>Motion to Enforce Agreement</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Durchsetzung einer Vereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para hacer cumplir el acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para hacer cumplir el acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour faire respecter un accord</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Enforce Agreement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para fazer cumprir um acordo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאכיפת הסכם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समझौते को प्रभावी बनाने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合意の履行を求める請願</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制执行协议动议</skos:altLabel>
        <skos:definition>A Motion to Enforce Agreement is a legal request made by one party to a court to compel the other party to comply with the terms of a previously agreed upon settlement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt2AOEEvMbhpF3f4NlujBU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rt2AOEEvMbhpF3f4NlujBU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCua1MtzwNcjfYov8VFcoV3"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9WYIrIeT3fTYMxfW0xZldF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Subsidiary</rdfs:label>
        <skos:altLabel>Affiliate</skos:altLabel>
        <skos:altLabel>Controlled Company</skos:altLabel>
        <skos:altLabel>Daughter Company</skos:altLabel>
        <skos:altLabel>Subordinate Entity</skos:altLabel>
        <skos:definition>A Subsidiary is a company that is owned or controlled by another company, known as the parent company or holding company. The parent company holds a controlling interest in the subsidiary, typically through ownership of more than 50% of its voting stock, allowing it to influence the subsidiary&apos;s management and operations.</skos:definition>
        <skos:example>Audi AG: A subsidiary of Volkswagen Group, specializing in luxury automobiles.</skos:example>
        <skos:example>Instagram, LLC: A subsidiary of Meta Platforms, Inc., focusing on photo and video sharing.</skos:example>
        <skos:example>Warner Bros. Entertainment Inc.: A subsidiary of Warner Bros. Discovery, engaged in the film and entertainment industry.</skos:example>
        <skos:example>YouTube, LLC: A subsidiary of Alphabet Inc., operating as a video-sharing platform.</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rt4K0sTb3lb3Y8vIZb8wzJ -->

