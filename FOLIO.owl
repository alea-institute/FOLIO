            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Expert Interview Practice</rdfs:label>
        <skos:altLabel>Expert Interview</skos:altLabel>
        <skos:altLabel>Expert Interview Service</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Expert Interview Practice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Experteninterview-Praxis</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique d&apos;entretien avec des experts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de entrevista de expertos</skos:altLabel>
