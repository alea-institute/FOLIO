        <rdfs:isDefinedBy rdf:resource="https://www.ohchr.org/en/sexual-orientation-and-gender-identity/intersex-people"/>
        <rdfs:label>Intersex</rdfs:label>
        <skos:definition>Intersex refers to the condition of having physical or genetic features that do not fit typical binary notions of male or female bodies, often involving variations in chromosomes, gonads, sex hormones, or genitalia.</skos:definition>
    </owl:Class>
    


