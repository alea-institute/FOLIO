            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Disturbing the Peace</rdfs:label>
        <skos:altLabel xml:lang="es-es">Alteración del Orden Público</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Alteración del Orden Público</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disturbing the Peace</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Perturbação da ordem pública</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Störung der öffentlichen Ordnung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Trouble à l&apos;ordre public</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת שקט ציבור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शांति को व्यवधान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共の秩序を乱す行為</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">扰乱公共秩序</skos:altLabel>
        <skos:definition>The act of disturbing the peace refers to behavior that disrupts public order and tranquility, and is classified as a criminal misdemeanor offense.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDwGA2wsl0Gd2FDYqr9xyLj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDwGA2wsl0Gd2FDYqr9xyLj">
