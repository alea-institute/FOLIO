    <!-- https://folio.openlegalstandard.org/RDZn9XqGRUL9FjCb0Ftx3gy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDZn9XqGRUL9FjCb0Ftx3gy">
