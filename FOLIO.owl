        <skos:altLabel xml:lang="pt-br">Por sucesso do objetivo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Por éxito en la meta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Por éxito en la meta</skos:altLabel>
