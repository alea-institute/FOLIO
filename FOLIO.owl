        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=92119"/>
        <rdfs:label>Other General Government Support</rdfs:label>
        <skos:definition>See industry description for 921190.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/3Gs52abYTh-gyA2268b5Tw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/3Gs52abYTh-gyA2268b5Tw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ABRVtk2DQFqOsDUoTSOxQQ"/>
