        <skos:altLabel xml:lang="de-de">Haftung des Landkreises</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad del Condado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad del Condado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade do condado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité du comté</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות המחוז</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">काउंटी दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">县责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">郡の責任</skos:altLabel>
        <skos:definition>County Liability refers to the legal responsibility of a county government for any harm or damage caused to individuals or property due to the actions or negligence of the county or its employees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfQSn0sz23OYcxH4Nymc2G -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfQSn0sz23OYcxH4Nymc2G">
