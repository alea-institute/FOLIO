        <skos:altLabel xml:lang="en-gb">Office of Disability Employment Policy</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Política de Empleo para Personas con Discapacidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina de Política de Empleo para Personas con Discapacidad</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משרד מדיניות התעסוקה לאנשים עם מוגבלויות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विकलांग रोजगार नीति कार्यालय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">残疾雇佣政策办公室</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">障害者雇用政策局</skos:altLabel>
