        <skos:altLabel xml:lang="zh-cn">请求法院注意</skos:altLabel>
        <skos:definition>A Motion to Take Judicial Notice is a formal request made to a court asking it to consider certain facts as true without requiring evidence to prove them.</skos:definition>
    </owl:Class>
    


