        <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato de seguro</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung des Versicherungsvertrags</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation du contrat d&apos;assurance</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação do contrato de seguro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חוזה ביטוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बीमा अनुबंध का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保险合同违约</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保険契約違反</skos:altLabel>
        <skos:definition>The Breach of Insurance Contract is a legal claim that arises when an insurance company fails to fulfill its obligations under the terms of an insurance policy, resulting in harm or damages to the policyholder.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOJfsgmKQb0M2RALo9HpDs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOJfsgmKQb0M2RALo9HpDs">
