    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UlA02PR-R3man_0KO_n-2w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UlA02PR-R3man_0KO_n-2w">
