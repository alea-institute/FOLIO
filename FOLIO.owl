        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIuHPBKs3x9tZ0vRBJ76AI"/>
        <rdfs:label>Interpleader</rdfs:label>
        <skos:altLabel xml:lang="de-de">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interpleader</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Interpleader</skos:altLabel>
