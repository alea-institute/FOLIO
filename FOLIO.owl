        </rdfs:subClassOf>
        <rdfs:isDefinedBy>FRCP 11</rdfs:isDefinedBy>
        <rdfs:label>Sanctions</rdfs:label>
        <skos:altLabel xml:lang="es-es">Sanciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sanciones</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sanctions</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Sanctions</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sanktionen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sanções</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סנקציות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">制裁</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">制裁</skos:altLabel>
        <skos:definition>A penalty or punishment imposed by a court or other authority for a violation of a law or rule, typically involving a fine or other restriction on one&apos;s rights or freedoms.</skos:definition>
        <skos:prefLabel>Sanction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rd5clbkJCCyveddDZeKasF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rd5clbkJCCyveddDZeKasF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Certified Rent Roll Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Certified Rent Roll Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de rôle de loyer certifié</skos:altLabel>
