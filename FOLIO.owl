    <!-- https://folio.openlegalstandard.org/RDMUOtKEW0m4knNvedjPQP5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDMUOtKEW0m4knNvedjPQP5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8THIhCQDpX9BgtDhsfKsQ5"/>
        <rdfs:label>Ulcerative Colitis</rdfs:label>
        <skos:altLabel>Colitis Ulcerosa</skos:altLabel>
        <skos:definition>Ulcerative colitis is a chronic inflammatory bowel disease characterized by inflammation and ulceration of the lining of the colon and rectum. This condition primarily affects the mucosal layer, leading to symptoms such as abdominal pain, diarrhea with blood or pus, and weight loss, and may require ongoing medical treatment or surgical intervention, such as colectomy.</skos:definition>
    </owl:Class>
    


