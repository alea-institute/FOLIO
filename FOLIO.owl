    <!-- https://folio.openlegalstandard.org/R7pgWczDcp7em4Tl5BCtMsl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7pgWczDcp7em4Tl5BCtMsl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NB9WJzAFK6tIIGmfIj5Ay"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
        <dc:source>Fed. R. Evid. 403</dc:source>
        <dc:source>Fed. R. Evid. 611</dc:source>
        <rdfs:label>Non-Responsive Objection</rdfs:label>
        <skos:altLabel>Irrelevant Response Objection</skos:altLabel>
        <skos:altLabel>Objection to Unrelated Answer</skos:altLabel>
        <skos:definition>A Non-Responsive Objection is raised when a party in a legal proceeding believes that a witness&apos;s response does not directly address the question asked. This objection seeks to ensure that the testimony remains relevant and focused on the issues at hand.</skos:definition>
        <skos:prefLabel>Objection to Irrelevant Answer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7pjdyhdGIGiBKuLCGTETCx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7pjdyhdGIGiBKuLCGTETCx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNoW92yXeKjoc34E3HzcI1"/>
        <rdfs:label>By Reverse Contingency</rdfs:label>
        <skos:altLabel xml:lang="en-gb">By Reverse Contingency</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Durch umgekehrte Kontingenz</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Par contingence inverse</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Por Contingencia Inversa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Por Contingencia Inversa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Por contingência reversa</skos:altLabel>
        <skos:altLabel xml:lang="he-il">על ידי תנאי הפוך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उलटी आवश्यकता के अनुसार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">逆転的因果関係によって</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">通过反向因果关系</skos:altLabel>
        <skos:definition>Engagement fee model where a client pays a fee represented by the percentage of the amount of money that a client saved in litigation — often expressed as the difference between a third party&apos;s originally demanded amount (from the client) and the client&apos;s ultimate payment amount.</skos:definition>
    </owl:Class>
    


