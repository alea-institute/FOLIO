    <!-- https://folio.openlegalstandard.org/R35766718645c394c2615294 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R35766718645c394c2615294">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/REC6f02781e263496ed08afb"/>
        <dc:identifier>US-FD-DOJ-CRD-OSC</dc:identifier>
        <rdfs:label>Office of Special Counsel for Immigration-Related Unfair Employment Practices</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Bureau du conseiller spécial pour les pratiques d&apos;emploi injustes liées à l&apos;immigration</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro des Sonderberaters für Einwanderungsbezogene Unfaire Beschäftigungspraktiken</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escritório do Conselheiro Especial para Práticas de Emprego Injustas Relacionadas à Imigração</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Office of Special Counsel for Immigration-Related Unfair Employment Practices</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina del Consejero Especial para Prácticas de Empleo Injustas Relacionadas con la Inmigración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina del Consejero Especial para Prácticas de Empleo Injustas Relacionadas con la Inmigración</skos:altLabel>
        <skos:altLabel xml:lang="he-il">המשרד לייעוץ מיוחד לפעילויות עסקיות בתחום ההעסקה עם עובדים זרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विशेष जांच अधिकारी कार्यालय फॉर इमिग्रेशन-संबंधित अन्यायपूर्ण रोजगार प्रथाओं के लिए</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">移民相关不公平就业实践特别顾问办公室</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">移民関連の不当な雇用慣行に関する特別顧問の事務局</skos:altLabel>
        <skos:definition>The Office of Special Counsel for Immigration-Related Unfair Employment Practices (OSC) investigates and prosecutes allegations of national origin and citizenship status discrimination in hiring, firing, and recruitment or referral for a fee, as well as unfair documentary practices during the employment eligibility verification process and retaliation under the anti-discrimination provision of the Immigration and Nationality Act (INA). In addition, OSC conducts outreach aimed at educating employers, workers and the general public about their rights and responsibilities under the INA&apos;s anti-discrimination provision.</skos:definition>
        <skos:hiddenLabel>OSC</skos:hiddenLabel>
        <skos:prefLabel>Office of Special Counsel for Immigration-Related Unfair Employment Practices</skos:prefLabel>
    </owl:Class>
    


