    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsMFBq7uyno1UllIoTny1Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsMFBq7uyno1UllIoTny1Z">
