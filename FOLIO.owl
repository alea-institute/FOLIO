        <rdfs:label>Telephone Answering Services</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in answering telephone calls and relaying messages on behalf of clients or for other establishments of the same enterprise.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/xXwVm2IwRQCJF8K-W4QQdg -->

