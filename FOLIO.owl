        <skos:altLabel xml:lang="es-mx">Acción Prohibida/Omisión Requerida por el Lenguaje del Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Action Prohibited/Omission Required by the Agreement Language</skos:altLabel>
