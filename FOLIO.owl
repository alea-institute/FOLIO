        <skos:altLabel xml:lang="es-es">Requisito de consentimiento del comprador</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Requisito de consentimiento del comprador</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דרישת הסכמת הקונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता</skos:altLabel>
