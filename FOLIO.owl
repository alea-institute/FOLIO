    <!-- https://folio.openlegalstandard.org/R8r67x9DvibBWybkIqxcwjo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8r67x9DvibBWybkIqxcwjo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWuBs7zey8BVg86iZuFUNk"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_23"/>
        <rdfs:label>Uterus Cancer</rdfs:label>
        <skos:altLabel>Endometrial Cancer</skos:altLabel>
        <skos:altLabel>Uterine Cancer</skos:altLabel>
        <skos:altLabel>Uterine Carcinoma</skos:altLabel>
        <skos:altLabel>Uterine Malignancy</skos:altLabel>
        <skos:definition>Uterus cancer refers to malignant tumors originating in the tissues of the uterus, including the endometrium (lining of the uterus) and the myometrium (muscular layer of the uterus). It encompasses various subtypes, with endometrial carcinoma being the most common, and can cause symptoms such as abnormal vaginal bleeding, pelvic pain, and weight loss.</skos:definition>
    </owl:Class>
    


