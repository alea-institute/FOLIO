    <!-- https://folio.openlegalstandard.org/RVHae1yV9vZnwi9C1SUdly -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RVHae1yV9vZnwi9C1SUdly">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnfzkAKrjy32YoweXnzDjp"/>
        <rdfs:label>Customer Lifetime Value</rdfs:label>
        <skos:altLabel>CLV</skos:altLabel>
        <skos:definition>Customer Lifetime Value (CLV) is a metric that represents the total net profit a company expects to earn from a customer throughout their entire relationship. It is calculated by multiplying the average value of a customer transaction by the number of repeat transactions and the average retention time in a specific period.</skos:definition>
    </owl:Class>
    


