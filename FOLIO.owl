        <skos:altLabel xml:lang="fr-fr">Kurukh</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Kurukh</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クルク語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">库鲁克语</skos:altLabel>
        <skos:definition>Kurukh (Language) is a specific written or spoken structured system of communication that consists of grammar and vocabulary, and is a member of the Language top-level class.</skos:definition>
    </owl:Class>
    


