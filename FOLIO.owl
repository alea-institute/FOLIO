        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4921"/>
        <rdfs:label>Couriers and Express Delivery Services</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/FkAaX6VjS2WUjNJarOlrHA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/FkAaX6VjS2WUjNJarOlrHA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/k29SeRbeSnSCZ2dV8f6XVQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=562119"/>
        <rdfs:label>Other Waste Collection</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in collecting and/or hauling waste (except nonhazardous solid waste and hazardous waste) within a local area. Establishments engaged in brush or rubble removal services are included in this industry.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/FmZsXnZHSEmmLHgexa3gcA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/FmZsXnZHSEmmLHgexa3gcA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97XG1bV4Mx6t2B4cpMlF0U"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=425"/>
        <rdfs:label>Wholesale Trade Agents and Brokers Industry</rdfs:label>
        <skos:definition>The Wholesale Trade Agents and Brokers subsector groups establishments that arrange for the sale of goods owned by others, generally on a fee or commission basis. They act on behalf of the buyers and sellers of goods to facilitate wholesale trade.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/FmvTimBbQQ2SBxWhMA7fkA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/FmvTimBbQQ2SBxWhMA7fkA">
