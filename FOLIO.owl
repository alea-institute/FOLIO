        <rdfs:label>Newspaper</rdfs:label>
        <skos:altLabel>Daily Paper</skos:altLabel>
        <skos:definition>A Newspaper is a periodical publication that provides news, information, and advertisements, typically printed on low-cost paper and distributed regularly, such as daily or weekly.</skos:definition>
        <skos:prefLabel>News Publication</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UCLTIIUmqTR6NMojKmKa6 -->

