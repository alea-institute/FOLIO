        <rdfs:label>Platelet Deficiency</rdfs:label>
        <skos:altLabel>Low Platelet Count</skos:altLabel>
        <skos:definition>Thrombocytopenia is a medical condition characterized by a low platelet count in the blood, which can lead to increased bleeding and bruising. It results from either decreased production of platelets, increased destruction of platelets, or sequestration of platelets in the spleen.</skos:definition>
        <skos:prefLabel>Thrombocytopenia</skos:prefLabel>
    </owl:Class>
    


