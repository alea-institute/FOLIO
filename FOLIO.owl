        <rdfs:label>New Mexico Metropolitan Court - Bernalillo County</rdfs:label>
        <skos:definition>The New Mexico Metropolitan Court - Bernalillo County is a specific court within the New Mexico Metropolitan Court system that handles cases within Bernalillo County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7j2VhFvTUGyXvvfg1egQmi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7j2VhFvTUGyXvvfg1egQmi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8viNe7dpcLA9kGH5gl7YE6"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJL4HDUmZp1VEEZ7lCwSSF"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
