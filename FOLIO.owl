        <skos:altLabel xml:lang="pt-br">Presas</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">尖牙</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">牙</skos:altLabel>
