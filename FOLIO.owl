    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzOFq7PmW0UHiOLlVuTVxY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzOFq7PmW0UHiOLlVuTVxY">
