        <skos:altLabel xml:lang="es-es">Robo mediante engaño</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Robo por medio de engaño</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Roubo mediante falsas promessas</skos:altLabel>
        <skos:altLabel>Swindle</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vol sous de faux prétextes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גניבה באמצעות מרמה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">झूठी दावे की चोरी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">偽りの前提による窃盗</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">虚假借口盗窃</skos:altLabel>
        <skos:definition>The intentional misrepresentation of existing fact or condition, or the use of some other deceptive scheme or device, to obtain money, goods, or other things of value.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDxp9uUHxi3LUckz7auDzTj -->

