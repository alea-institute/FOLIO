        <skos:definition>The ACHP promotes the preservation, enhancement, and sustainable use of the nation&apos;s diverse historic resources, and advises the President and Congress on national historic preservation policy.</skos:definition>
        <skos:hiddenLabel>ACHP</skos:hiddenLabel>
        <skos:prefLabel>Advisory Council on Historic Preservation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDD510qM8dM4VnyGZojoClb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDD510qM8dM4VnyGZojoClb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2Kr3kWHR9cR4zALXqt1nM"/>
        <rdfs:label>Twin-Win Certificate</rdfs:label>
        <skos:altLabel>Bidirectional Profit Certificate</skos:altLabel>
        <skos:altLabel>Bidirectional Return Certificate</skos:altLabel>
        <skos:definition>A Twin-Win Certificate is a financial instrument that allows participation in the development of the underlying asset or assets, offering potential profits from both rising and falling asset values. If the underlying asset price falls but does not breach a specified barrier, it converts into profit; however, if the barrier is breached, the product converts into a tracker certificate. This instrument provides a minimum redemption equal to the nominal value, given the barrier remains intact, and with higher risk levels, multiple underlying assets (worst-of) can enable a higher bonus level or lower barrier, thereby reducing the risk compared to a direct investment in the underlying assets.</skos:definition>
    </owl:Class>
    


