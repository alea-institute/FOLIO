        <rdfs:label>Missouri Circuit Court - Greene County</rdfs:label>
        <skos:definition>Missouri Circuit Court - Greene County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Greene County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCKhbqjpsk6Y7reRIOhnbpY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCKhbqjpsk6Y7reRIOhnbpY">
