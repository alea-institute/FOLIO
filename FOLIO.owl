        <rdfs:label>Center for Consumer Information and Insurance Oversight</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Centre for Consumer Information and Insurance Oversight</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Centre pour l&apos;information des consommateurs et la surveillance des assurances</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Centro de Información y Supervisión de Seguros para el Consumidor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Centro de Información y Supervisión de Seguros para el Consumidor</skos:altLabel>
