        <skos:altLabel xml:lang="zh-cn">认证类别动议</skos:altLabel>
        <skos:definition>A Motion to Certify the Class is a formal request made to a court to allow a lawsuit to proceed as a class action, where a group of individuals with similar claims can collectively sue a defendant.</skos:definition>
        <skos:prefLabel>Motion for Class Certification</skos:prefLabel>
    </owl:Class>
    


