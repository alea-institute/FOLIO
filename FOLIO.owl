        <rdfs:label>Motion to Disqualify Judge</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ablehnung des Richters</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para recusar al juez</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para recusar al juez</skos:altLabel>
        <skos:altLabel>Motion for Judge Disqualification</skos:altLabel>
        <skos:altLabel>Motion for Judicial Removal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour disqualifier le juge</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Disqualify Judge</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para desqualificar o juiz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לפסול את השופט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायाधीश को अयोग्य ठहराने का अर्ज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销法官申请书</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判官の拒否申立</skos:altLabel>
        <skos:definition>A Motion to Disqualify Judge is a legal request to remove a judge from a case due to a conflict of interest or bias, which may prevent a fair trial.</skos:definition>
    </owl:Class>
    


