        <rdfs:label>Temporary Restraining Order</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einstweilige Verfügung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interim injunction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ordem de Restrição Temporária</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Orden de protección temporal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Orden de restricción temporal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ordonnance de protection temporaire</skos:altLabel>
        <skos:altLabel>TRO</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צו הגבלה זמני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अस्थायी रोकथाम आदेश</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">一時的差止命令</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">临时限制令</skos:altLabel>
        <skos:definition>A Temporary Restraining Order (TRO) is a provisional legal remedy that prohibits a party from taking certain actions until a court can make a final decision on the matter.</skos:definition>
    </owl:Class>
    


