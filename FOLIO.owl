        <rdfs:label>Probate due to Neglect/Abandonment</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Inventário devido a negligência/abandono</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nachlassverfahren aufgrund von Vernachlässigung/Verlassenheit</skos:altLabel>
