            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>L240 Dispositive Motions</rdfs:label>
        <skos:definition>A dispositive motion is a legal request made by a party in a case, asking the court to make a final decision on a particular issue or the entire case, before a trial takes place.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7M11YumH7mCJwI7JQTWkPv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7M11YumH7mCJwI7JQTWkPv">
