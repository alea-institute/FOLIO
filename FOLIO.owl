        <skos:altLabel xml:lang="es-mx">Mandamiento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ordonnance de mandamus</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Writ of Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צו מנדטורי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मंडमस</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">マンダムス命令</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">强制令</skos:altLabel>
        <skos:definition>A Writ of Mandamus is a legal order issued by a court that commands a government official or agency to perform a specific duty or act that they are legally obligated to do.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HhXTHi0mTgRGnYja0oHa -->

