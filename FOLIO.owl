        <skos:altLabel xml:lang="hi-in">अन्यायपूर्ण प्रतिस्पर्धा दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不正当竞争索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不正競争請求</skos:altLabel>
        <skos:definition>Unfair Competition Claims refer to legal actions taken by businesses against competitors who engage in deceptive or unfair practices that harm their business, such as trademark infringement, trade secret misappropriation, or deceptive trade practices.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vj2bjxO4znRO9ZDWXgn09 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vj2bjxO4znRO9ZDWXgn09">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Security Deposit Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de dépôt de garantie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Depósito de Seguridad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Depósito en Garantía</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de depósito de segurança</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Security Deposit Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sicherheitsleistungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפקדת אטרף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सुरक्षा जमा क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保証金条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保证金条款</skos:altLabel>
        <skos:definition>A Security Deposit Clause is a provision in a contract that requires one party to provide a sum of money to the other party as a guarantee of performance or payment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8voMwZ00WaA8Z9QZbJBQnS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8voMwZ00WaA8Z9QZbJBQnS">
