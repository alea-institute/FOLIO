        <rdfs:label>Motions Regarding Counsel</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anträge bezüglich des Anwalts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones sobre el Abogado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones sobre el Abogado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motions Regarding Counsel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions concernant l&apos;avocat</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petições referentes ao advogado</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועות בנוגע לייעוץ משפטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वकील के संबंध में याचिकाएं</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">关于律师的动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">弁護士に関する動議</skos:altLabel>
        <skos:definition>A Motion Regarding Counsel is a formal request made to an appellate court by a party in a legal case to change or remove their legal representation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7zCjs76iK43kBLxTXUNXlX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7zCjs76iK43kBLxTXUNXlX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDi7A9GutlkahNHpXCklGRc"/>
        <rdfs:label>International Organization Meeting Visa For Non-Member Governments</rdfs:label>
        <skos:altLabel>Unrecognized Government Representative Visa</skos:altLabel>
        <skos:definition>A International Organization Meeting Visa For Non-Member Governments (in the U.S., a G-3 visa) is issued to representatives of non-recognized or non-member foreign governments traveling to the U.S. to attend meetings of designated international organizations. This visa category also includes their immediate family members.</skos:definition>
        <skos:prefLabel>G-3 Visa</skos:prefLabel>
    </owl:Class>
    


