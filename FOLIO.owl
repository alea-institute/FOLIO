        <rdfs:label>Assuming Facts Not in Evidence Objection</rdfs:label>
        <skos:altLabel>Assumes Facts Not in Evidence</skos:altLabel>
        <skos:altLabel>Assuming Facts Not in Evidence</skos:altLabel>
        <skos:altLabel>Inaccurate Hypothetical Objection</skos:altLabel>
        <skos:altLabel>Presumption of Unproven Facts</skos:altLabel>
        <skos:altLabel>Unsubstantiated Facts Assumption</skos:altLabel>
        <skos:definition>Assuming Facts Not in Evidence is an objection raised when a party in a legal proceeding believes that a question or statement implies the existence of facts that have not been formally introduced or established as evidence in the case. This objection aims to prevent the influence of unfounded assumptions on the proceedings.</skos:definition>
        <skos:prefLabel>Assuming Unestablished Facts</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCc7iDhMaikuzxNI08HCgQW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCc7iDhMaikuzxNI08HCgQW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <dc:source>International Bill of Human Rights</dc:source>
        <rdfs:label>Freedom from Torture</rdfs:label>
        <skos:definition>Freedom from torture is a fundamental human right that prohibits the use of torture and other cruel, inhuman, or degrading treatment or punishment against individuals. This right is enshrined in various international treaties, such as the United Nations Convention Against Torture, and is considered a non-derogable right, meaning it cannot be suspended under any circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCc94Vj4Zzg6u1bIiC6OOe0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCc94Vj4Zzg6u1bIiC6OOe0">
