        <skos:altLabel xml:lang="en-gb">Breach of Contract Containing Satisfaction Clause</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de contrato que contiene una cláusula de satisfacción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato que contiene una cláusula de satisfacción</skos:altLabel>
