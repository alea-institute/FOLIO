        <skos:altLabel xml:lang="ja-jp">判決的動議手続き</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">裁定性动议程序</skos:altLabel>
        <skos:definition>Dispositive Motion Practice refers to the legal process of requesting a court to make a final decision on a case before trial, based on the evidence and arguments presented in pretrial motion practice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzytFibFy0n9fSqElg72fi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzytFibFy0n9fSqElg72fi">
