    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HtVIZJS79BdPOUYSR5l5X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HtVIZJS79BdPOUYSR5l5X">
