        <skos:altLabel xml:lang="en-gb">Enforcement of Judgment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Execução da sentença</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Exécution du jugement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vollstreckung des Urteils</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אכיפת פסק דין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फैसले के प्रवर्तन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決の執行</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">执行判决</skos:altLabel>
        <skos:definition>The enforcement of judgment refers to the legal process of ensuring that a court&apos;s decision is carried out, often through methods such as seizing assets or placing liens on property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9pVM1ap8tvlM3l5FYdYl90 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9pVM1ap8tvlM3l5FYdYl90">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDK3ploePpyFDgIkSzbOCtX"/>
        <rdfs:label>Codicil</rdfs:label>
        <skos:altLabel>Testamentary Codicil</skos:altLabel>
        <skos:altLabel>Testamentary Supplement</skos:altLabel>
        <skos:altLabel>Will Addendum</skos:altLabel>
        <skos:altLabel>Will Amendment</skos:altLabel>
        <skos:definition>A Codicil is a legal document that amends, rather than replaces, a previously executed will. It allows an individual to make changes or additions to their existing will without drafting an entirely new one, ensuring that certain provisions are updated or altered while the remainder of the will stays intact.</skos:definition>
    </owl:Class>
    


