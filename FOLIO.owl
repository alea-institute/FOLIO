        <rdfs:label>Motion to Disqualify Arbitrator</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ablehnung des Schiedsrichters</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para descalificar al árbitro</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para descalificar al árbitro</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour disqualifier l&apos;arbitre</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Disqualify Arbitrator</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para desqualificar o árbitro</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לפטור את הבית המכרז מתפקידו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एअर्बिट्रेटर को अयोग्य ठहराने का अभियान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">仲裁人の回避申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销仲裁员的动议</skos:altLabel>
        <skos:definition>A Motion to Disqualify Arbitrator is a legal request to remove an arbitrator from a case due to a conflict of interest or bias, made by one of the parties involved in the arbitration process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8DXDUoCjhdysDnfhvIXZle -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8DXDUoCjhdysDnfhvIXZle">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGFG6LdQMDh5PGrImjEWps"/>
        <rdfs:label>Confession</rdfs:label>
        <skos:definition>A confession is a formal statement made by an individual acknowledging their guilt for a specific crime or offense. It can be given voluntarily or as a result of interrogation, and its validity can be a subject of legal scrutiny, especially if there are concerns about the circumstances under which it was obtained, such as the possibility of coercion or violation of rights.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8DbJjXHZ9Rz6mFOwWU2k2A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8DbJjXHZ9Rz6mFOwWU2k2A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwKZmUGcjAuR74XG4wWAPP"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Tourette Syndrome</rdfs:label>
        <skos:altLabel>Tic Disorder</skos:altLabel>
        <skos:definition>Tourette Syndrome (TS) is a neurological disorder characterized by repetitive, involuntary movements and vocalizations called tics. These tics can range from mild to severe and may involve motor tics, such as blinking or head jerking, and vocal tics, such as grunting or shouting, often impacting daily activities and social interactions.</skos:definition>
        <skos:prefLabel>Gilles de la Tourette Syndrome</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Dm8v3sRyTffINIiFIbzjY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Dm8v3sRyTffINIiFIbzjY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sMcpQMoO3EOWAx73lpZ16"/>
        <rdfs:label>Atheism</rdfs:label>
        <skos:altLabel>Irreligion</skos:altLabel>
        <skos:altLabel>Non-Religious</skos:altLabel>
        <skos:altLabel>Non-theism</skos:altLabel>
        <skos:altLabel>Secularism</skos:altLabel>
        <skos:definition>Atheism is the belief or doctrine that asserts the non-existence of deities or a supreme being. In legal contexts, it may pertain to the protection of non-religious individuals&apos; rights, ensuring freedom from religious impositions, or the recognition of atheism as a legitimate philosophical stance.</skos:definition>
        <skos:example>Secular morality</skos:example>
        <skos:prefLabel>Humanism</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8DntuanM5PpdDaXHJGQPpc -->

