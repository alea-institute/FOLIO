        <rdfs:label>Paint, Varnish, and Supplies Merchant Wholesalers</rdfs:label>
        <skos:definition>See industry description for 424950.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UsuwArHqTi6W7A5ulsZQnw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UsuwArHqTi6W7A5ulsZQnw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/DOF5eLGtSpaHRGsWG7QXJw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33261"/>
        <rdfs:label>Spring and Wire Product Manufacturing</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in (1) manufacturing steel springs by forming, such as cutting, bending, and heat winding, metal rod or strip stock and/or (2) manufacturing wire springs and fabricated wire products from wire drawn elsewhere (except watch and clock springs).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UyDvcUP5RMeHsfUdpVz6Bw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UyDvcUP5RMeHsfUdpVz6Bw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/UmtThKRlSUegdS0VuXOEVg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332439"/>
        <rdfs:label>Other Metal Container Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing metal (light gauge) containers (except cans).</skos:definition>
        <skos:example>Light gauge metal bins manufacturing</skos:example>
        <skos:example>Light gauge metal drums manufacturing</skos:example>
        <skos:example>Light gauge metal garbage cans manufacturing</skos:example>
        <skos:example>Light gauge metal lunch boxes manufacturing</skos:example>
        <skos:example>Light gauge metal mailboxes manufacturing</skos:example>
        <skos:example>Light gauge metal tool boxes manufacturing</skos:example>
        <skos:example>Light gauge metal vats manufacturing</skos:example>
        <skos:example>Metal air cargo containers manufacturing</skos:example>
        <skos:example>Metal barrels manufacturing</skos:example>
        <skos:example>Vacuum bottles and jugs manufacturing</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UyhuRO16TPuwZqArhxSKxA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UyhuRO16TPuwZqArhxSKxA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/JJGh3ImfRBCxSv4HKXG4Uw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=237310"/>
        <rdfs:label>Highway, Street, and Bridge Construction</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the construction of highways (including elevated), streets, roads, airport runways, public sidewalks, or bridges. The work performed may include new work, reconstruction, rehabilitation, and repairs. Specialty trade contractors are included in this industry if they are engaged in activities primarily related to highway, street, and bridge construction (e.g., installing guardrails on highways).</skos:definition>
        <skos:example>Airport runway construction</skos:example>
        <skos:example>Causeway construction</skos:example>
        <skos:example>Culverts, highway, road, and street, construction</skos:example>
        <skos:example>Elevated highway construction</skos:example>
        <skos:example>Guardrail construction</skos:example>
        <skos:example>Highway line painting</skos:example>
        <skos:example>Painting traffic lanes or parking lot lines</skos:example>
        <skos:example>Pothole filling, highway, road, street, or bridge</skos:example>
        <skos:example>Resurfacing, highway, road, street, or bridge</skos:example>
        <skos:example>Sign erection, highway, road, street, or bridge</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UzPdho2sQeOTADiJMpp_gw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UzPdho2sQeOTADiJMpp_gw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/qqEeRT1-TuyKC1GqHCOp8g"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423940"/>
        <rdfs:label>Jewelry, Watch, Precious Stone, and Precious Metal Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of jewelry, precious and semiprecious stones, precious metals and metal flatware, costume jewelry, watches, clocks, silverware, and/or jewelers&apos; findings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/UzwULtdBQpeTiDx3F_iAgQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/UzwULtdBQpeTiDx3F_iAgQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/sAT0ZKM4Rfu7nWNnPxRz9w"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81143"/>
        <rdfs:label>Footwear and Leather Goods Repair</rdfs:label>
        <skos:definition>See industry description for 811430.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/V08LPAsVSCyyK7FP8pQqmQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/V08LPAsVSCyyK7FP8pQqmQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBFLYkta0F7DwegW1FnUX52"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541"/>
        <rdfs:label>Professional, Scientific, and Technical Services Industry</rdfs:label>
        <skos:definition>Industries in the Professional, Scientific, and Technical Services subsector group establishments engaged in processes where human capital is the major input.  These establishments make available the knowledge and skills of their employees, often on an assignment basis, where an individual or team is responsible for the delivery of services to the client.  The individual industries of this subsector are defined on the basis of the particular expertise and training of the services provider.

The distinguishing feature of the Professional, Scientific, and Technical Services subsector is the fact that most of the industries grouped in it have production processes that are almost wholly dependent on worker skills.  Thus, the establishments classified in this subsector sell expertise.  Much of the expertise requires degrees, though not in every case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/V5nDoBfZSPqS3e42Ixt04A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/V5nDoBfZSPqS3e42Ixt04A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tzFads-JQj6WHhHB0AYjyg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=71131"/>
        <rdfs:label>Promoters of Performing Arts, Sports, and Similar Events with Facilities</rdfs:label>
        <skos:definition>See industry description for 711310.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/VCGR6P2jR0q9L_lX5h7f4g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/VCGR6P2jR0q9L_lX5h7f4g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRtrQww7hpTBnO6oSm7Bj1"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=6232"/>
        <rdfs:label>Residential Intellectual and Developmental Disability, Mental Health, and Substance Abuse Facilities</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in providing residential care (but not licensed hospital care) to people with intellectual and developmental disabilities, mental illness, or substance abuse problems.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/VCR9hyfXRGWw0OTw1xQulQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/VCR9hyfXRGWw0OTw1xQulQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tmzg1yQbR9yQeds8CVpg0w"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336212"/>
        <rdfs:label>Truck Trailer Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing truck trailers, truck trailer chassis, cargo container chassis, detachable trailer bodies, and detachable trailer chassis for sale separately.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/VGLJUk4pSieAONjp47ksVg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/VGLJUk4pSieAONjp47ksVg">
