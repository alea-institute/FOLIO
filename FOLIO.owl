        <skos:altLabel xml:lang="pt-br">Oposição a Reivindicação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Opposition à une demande</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התנגדות לתביעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावे के खिलाफ आपत्ति</skos:altLabel>
