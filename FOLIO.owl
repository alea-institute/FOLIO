    <!-- https://folio.openlegalstandard.org/RC9rPAii8f99I7p4Hi5Qdia -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC9rPAii8f99I7p4Hi5Qdia">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <rdfs:label>Sensory Disability</rdfs:label>
        <skos:altLabel>Sensory Deficit</skos:altLabel>
        <skos:altLabel>Sensory Impairment</skos:altLabel>
        <skos:altLabel>Sensory Loss</skos:altLabel>
        <skos:definition>Sensory Disability refers to impairments that affect one or more of the senses, such as sight, hearing, touch, taste, or smell. These disabilities can range from mild to severe and can significantly impact an individual&apos;s ability to interact with their environment and perform daily activities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC9sl7fwZIqz8AKrwcOEx11 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC9sl7fwZIqz8AKrwcOEx11">
