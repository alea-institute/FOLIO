        <skos:altLabel xml:lang="pt-br">Cláusula de Limitação Mútua de Responsabilidade</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur gegenseitigen Haftungsbeschränkung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mutual Limitation of Liability Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הגבלת אחריות משותפת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आपसी दायित्व सीमा अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">相互責任制限条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">相互责任限制条款</skos:altLabel>
        <skos:definition>A mutual limitation of liability clause is a provision in a contract where both parties agree to limit their liability to a certain amount or exclude certain types of damages in case of breach or other legal claims.</skos:definition>
    </owl:Class>
    


