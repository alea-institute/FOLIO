        <rdfs:label>X142 Settlement Costs</rdfs:label>
        <skos:definition>Any settlement costs paid by the law firm or legal vendor on behalf of the client that have not been prepaid by the client</skos:definition>
        <skos:prefLabel>X142 Settlement Costs</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiPvXHeWYaWVdBgIxpcGL0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiPvXHeWYaWVdBgIxpcGL0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_17"/>
        <rdfs:label>Blood Disorders Treated by Transplantation</rdfs:label>
        <skos:altLabel>Blood Disorders Requiring Stem Cell Transplantation</skos:altLabel>
        <skos:altLabel>Hematologic Disorders with Stem Cell Therapy</skos:altLabel>
        <skos:altLabel>Hematological Malignancies Treated by Transplantation</skos:altLabel>
        <skos:definition>Hematological disorders treated by bone marrow or stem cell transplantation involve diseases of the blood or bone marrow that require transplantation as a primary treatment option. These disorders typically include severe cases of leukemia, lymphoma, and other blood cancers, where conventional treatments have proven insufficient or are unsuitable.</skos:definition>
        <skos:prefLabel>Hematological Disorders Treated by Bone Marrow or Stem Cell Transplantation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiQEhL2NxPMLEwsFoUVdnh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiQEhL2NxPMLEwsFoUVdnh">
