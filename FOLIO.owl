        <rdfs:label>Public and Indian Housing Office</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Bureau du logement public et indien</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro für öffentlichen und indischen Wohnungsbau</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escritório de Habitação Pública e Indígena</skos:altLabel>
