        <dc:identifier>CLASS</dc:identifier>
        <rdfs:label>Class</rdfs:label>
        <skos:altLabel>Class</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Classe</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Classe</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klasse</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クラス</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">类</skos:altLabel>
        <skos:definition>All those persons in the same category, level of rights (e.g. heirs of dead person who are related by the same degree), or who were injured by the same incident (e.g., class action lawsuit). Whether a person is part of a class often determines who can sue on behalf of the people who have been similarly damaged or collect his/her share if a class action judgment is entered.</skos:definition>
        <skos:hiddenLabel>CLASS</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ViWeSMYZAYcrPALuruBH3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ViWeSMYZAYcrPALuruBH3">
