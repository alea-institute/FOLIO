        <skos:altLabel xml:lang="pt-br">Falha em dispersar</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fracaso en dispersarse</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fracaso en dispersarse</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nichtauflösung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Refus de dispersion</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כישלון בפיזור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विफलता विस्तार नहीं करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">散開しないこと</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未散去</skos:altLabel>
