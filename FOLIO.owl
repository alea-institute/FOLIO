        <skos:altLabel xml:lang="es-mx">Actividades ultrapeligrosas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Activités ultradangereuses</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Atividades ultraperigosas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ultragefährliche Aktivitäten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Ultrahazardous Activities</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעילויות קיצוניות מאוד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अत्यधिक खतरानक गतिविधियाँ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">超危险活动</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">超危険活動</skos:altLabel>
        <skos:definition>An activity that is so inherently dangerous that the person engaging in it is strictly liable for any resulting harm, regardless of whether they were negligent or not.</skos:definition>
    </owl:Class>
    


