        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm"/>
        <rdfs:label>Pancreatic Gland Disorders</rdfs:label>
        <skos:definition>Pancreatic gland disorders disrupt the production of hormones, including insulin, affecting metabolism and digestion. These disorders can lead to conditions such as diabetes mellitus and digestive enzyme insufficiency.</skos:definition>
        <skos:prefLabel>Pancreatic Dysfunction</skos:prefLabel>
    </owl:Class>
    


