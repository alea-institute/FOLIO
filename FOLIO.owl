    <!-- https://folio.openlegalstandard.org/R7knuzL2Cu6WLdyvQiDMp8F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7knuzL2Cu6WLdyvQiDMp8F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8AUKvbXRK8jOHSQaqxcAtD"/>
