        <skos:altLabel xml:lang="es-mx">Evasión de la detención</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Evasão de prisão</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Flucht vor der Festnahme</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Évasion de l&apos;arrestation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התחמקות ממעצר</skos:altLabel>
