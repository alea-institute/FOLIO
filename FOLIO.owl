        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwA2C5kO5T37PMjFme24ia"/>
        <rdfs:label>Stand Your Ground Claim</rdfs:label>
        <skos:definition>A Stand Your Ground Claim asserts a person&apos;s right to use force, including lethal force, in self-defense without the duty to retreat when faced with a perceived threat. This legal concept is grounded in the broader principle of self-defense and is often associated with gun rights and the use of firearms for personal protection.</skos:definition>
        <skos:prefLabel>No-Duty-to-Retreat Claim</skos:prefLabel>
    </owl:Class>
    


