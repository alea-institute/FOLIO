        <rdfs:label>Hobby, Toy, and Game Retailers</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in retailing new toys, games, and hobby and craft supplies (except needlecraft).</skos:definition>
    </owl:Class>
    


