        <skos:definition>Florida County Court - Walton County is a specific court located in Walton County, Florida that handles civil and criminal cases within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCMZqt2BD3qRRYlj61ssnIZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCMZqt2BD3qRRYlj61ssnIZ">
