        <rdfs:label>Labor Unions and Similar Labor Organizations</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in promoting the interests of organized labor and union employees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/85QiHN14R-m1l6CzKBuxXQ -->

