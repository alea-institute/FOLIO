        <rdfs:label>Control Position</rdfs:label>
        <skos:altLabel>Acquisition Control Stake</skos:altLabel>
        <skos:altLabel>Control Stake</skos:altLabel>
        <skos:altLabel>Controlling Interest</skos:altLabel>
        <skos:definition>An M&amp;A Control Position refers to a stake in a company acquired through mergers and acquisitions that gives the holder significant influence over corporate decisions. This control is often achieved by obtaining a majority of voting shares or a significant minority stake sufficient to influence board decisions.</skos:definition>
        <skos:prefLabel>Dominant Shareholding Position</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDpOssFHxoz2zUvWjIGJ7Pl -->

