        <skos:altLabel xml:lang="en-gb">Motion to Compel Deposition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de compelir depoimento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de contraindre un témoignage</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לכפיית הצהרת עד</skos:altLabel>
