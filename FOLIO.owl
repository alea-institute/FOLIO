        <skos:altLabel xml:lang="es-mx">Moción de Desestimación</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Eliminación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Strike</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de exclusão</skos:altLabel>
