    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDs9eCLoiQpyTdMrksg6z9R -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDs9eCLoiQpyTdMrksg6z9R">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
        <rdfs:label>Neurosurgery Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle en neurochirurgie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia médica en neurocirugía</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia médica en neurocirugía</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em neurocirurgia</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Neurochirurgische Kunstfehler</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Neurosurgery Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה רפואית בנוירוכירורגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यूरोसर्जरी लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">神経外科医療過誤</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">神经外科医疗事故</skos:altLabel>
        <skos:definition>Negligent or wrongful conduct by a neurosurgeon that results in harm or injury to a patient, and which is the subject of a legal claim for damages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsA0EjhyOEG9HBBGLsyj0G -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsA0EjhyOEG9HBBGLsyj0G">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4nwMYlRLa9aP9pKWIZEE"/>
        <rdfs:label>Sense Impression Objectives</rdfs:label>
        <skos:definition>Sense Impression Objectives refer to the purposes for admitting out-of-court statements that describe or explain an event or condition while the declarant was perceiving it or immediately thereafter, as well as statements relating to a startling event or condition made while the declarant was under the stress of excitement caused by the event or condition. These objectives, which include present sense impressions and excited utterances, are exceptions to the hearsay rule due to the reliability of statements made in the moment or under the influence of a startling event.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsAyltQe2aok0szo92bfpx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsAyltQe2aok0szo92bfpx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8JVOGBEzEQHWl2bYk4uQam"/>
        <rdfs:label>Patent Search Process</rdfs:label>
        <skos:definition>The Patent Search Process involves systematically searching through patent databases to identify existing patents and patent applications that are relevant to a particular invention or technology. This process helps determine the novelty and patentability of the invention, guiding subsequent patent application strategies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsCZVkz53SQX78pFJZwxcd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsCZVkz53SQX78pFJZwxcd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R18qjSeTEcA0ftKswAFKWG"/>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Taxing Jurisdiction Country</rdfs:label>
        <skos:altLabel xml:lang="de-de">Besteuerungsland</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pays de juridiction fiscale</skos:altLabel>
        <skos:altLabel xml:lang="es-es">País de jurisdicción fiscal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">País de jurisdicción fiscal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">País de jurisdição tributária</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Taxing Jurisdiction Country</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מדינת סמכות מיסוי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कर अधिक्षेत्र देश</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">征税管辖国家</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">課税管轄国</skos:altLabel>
        <skos:definition>A Taxing Jurisdiction Country is a specific country that has the authority to impose and collect taxes on a particular entity or individual, as defined within the context of Tax Detail.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsDXHKUsZoJfz87jnz7zjj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsDXHKUsZoJfz87jnz7zjj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RClhbl4E1TJp9LygIXewIhn"/>
        <rdfs:label>Violation</rdfs:label>
        <skos:definition>A violation is an act or instance of breaking or failing to comply with a rule, regulation, contract, or law, which can lead to legal consequences.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsG6EEnGfPZ0wI0t2fG0IB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsG6EEnGfPZ0wI0t2fG0IB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:label>Statement of Good Faith</rdfs:label>
        <skos:altLabel xml:lang="es-es">Declaración de buena fe</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Declaración de buena fe</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Declaração de Boa Fé</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déclaration de bonne foi</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erklärung des guten Glaubens</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Statement of Good Faith</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצהרת טובה רצון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अच्छी नीयत का बयान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">善意の声明</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">善意声明</skos:altLabel>
        <skos:definition>A Statement of Good Faith is a written declaration made in a Bankruptcy and Restructuring Document, expressing the honest intention of the declarant to act in good faith towards the other parties involved in the proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsKpwzMbtWv0rHSNo4dYKc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsKpwzMbtWv0rHSNo4dYKc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ"/>
        <rdfs:label>Stuttering</rdfs:label>
        <skos:altLabel>Fluency Disorder</skos:altLabel>
        <skos:altLabel>Speech Dysfluency</skos:altLabel>
        <skos:definition>Stuttering, also known as stammering, is a speech disorder characterized by disruptions in the normal flow of speech, including repetitions of sounds, syllables, or words, prolongations of sounds, and involuntary pauses or blocks. These disruptions can vary in frequency and severity and often cause significant communication challenges and anxiety.</skos:definition>
        <skos:prefLabel>Stammering</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDsNu801voNxdpEeagwicFR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDsNu801voNxdpEeagwicFR">
