        <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - हॉरिजॉन्टल समझौता / साज़िश दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反垄断 - 水平协议/阴谋索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占禁止法 - 横の合意/陰謀主張</skos:altLabel>
        <skos:definition>A claim made under antitrust law alleging an agreement or conspiracy between competitors operating at the same level of the market to restrain trade, limit competition, or fix prices.</skos:definition>
    </owl:Class>
    


