        <skos:altLabel xml:lang="de-de">Betrogener oder ausgebeuteter Versicherungsträger</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Insurance Carrier Defrauded or Exploited</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Seguradora fraudada ou explorada</skos:altLabel>
