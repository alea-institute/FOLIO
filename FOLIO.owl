        <skos:altLabel xml:lang="ja-jp">道徳的権利放棄条項</skos:altLabel>
        <skos:definition>A Waiver of Moral Rights Clause is a provision in a legal agreement where an individual relinquishes their right to be credited as the author of their work or to object to any changes made to their work.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDUGVt1vbpSSIVTdHlaSUPU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDUGVt1vbpSSIVTdHlaSUPU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKBlQ2mgZn3CTwBfUYIM7s"/>
        <rdfs:label>Progressive Muscular Atrophy</rdfs:label>
        <skos:definition>Progressive muscular atrophy (PMA) is a neurodegenerative condition characterized by the gradual degeneration and atrophy of lower motor neurons, leading to progressive muscle weakness and wasting. Unlike Amyotrophic Lateral Sclerosis (ALS), PMA primarily affects lower motor neurons and often has a slower progression.</skos:definition>
    </owl:Class>
    


