    <!-- https://folio.openlegalstandard.org/RCksXAlY9lRN16wERqZZ8Tk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCksXAlY9lRN16wERqZZ8Tk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
        <dc:identifier>FNS</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=52"/>
        <rdfs:label>Finance and Insurance Services Industry</rdfs:label>
        <skos:altLabel>Finance and Insurance Services</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Finance and Insurance Services Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Finanz- und Versicherungsdienstleistungsbranche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de Servicios Financieros y de Seguros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Servicios Financieros y de Seguros</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des services financiers et d&apos;assurance</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de Serviços Financeiros e de Seguros</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית שירותי פיננסים וביטוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वित्त और बीमा सेवा उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">金融・保険サービス業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">金融和保险服务行业</skos:altLabel>
        <skos:definition>The Finance and Insurance industry group comprises establishments primarily engaged in financial transactions (transactions involving the creation, liquidation, or change in ownership of financial assets) and/or in facilitating financial transactions. Three principal types of activities include: raising funds by taking deposits and/or issuing securities and, in the process, incurring liabilities; and pooling of risk by underwriting insurance and annuities; and providing specialized services facilitating or supporting financial intermediation, insurance, and employee benefit programs.</skos:definition>
        <skos:hiddenLabel>FNS</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCktsurmgtZsqgr2mm4Z8av -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCktsurmgtZsqgr2mm4Z8av">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L4OY7QCBEVJpav2Da6Gef"/>
        <rdfs:label>Export Tax Payment</rdfs:label>
        <skos:altLabel>Export Duty Payment</skos:altLabel>
        <skos:altLabel>Export Levies</skos:altLabel>
        <skos:altLabel>Export Levy Payment</skos:altLabel>
        <skos:definition>Export Tax Payment refers to taxes levied on goods and services exported from a country. Historically, these duties have been applied in countries like Australia, Canada, Portugal, and Finland for various economic reasons, including counter-cyclical measures. In the European Union, certain export levies are part of the Monetary Compensation Accounts (MCA) system. This category does not include repayments of general consumption taxes, excises, or customs duties on exported goods, which are deducted from gross receipts in other specific tax categories.</skos:definition>
        <skos:prefLabel>Export Tariff Payment</skos:prefLabel>
        <skos:prefLabel>Taxes on Exports</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCku8MnUeFcXo6OenJPhNAh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCku8MnUeFcXo6OenJPhNAh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
        <rdfs:label>Nursing Negligence</rdfs:label>
        <skos:altLabel xml:lang="es-es">Negligencia de enfermería</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia de enfermería</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência de enfermagem</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nursing Negligence</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence en soins infirmiers</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Pflegefehler</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת טיפול רפואי על ידי אחות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नर्सिंग लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">护理疏忽</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">看護過失</skos:altLabel>
        <skos:definition>Nursing Negligence refers to a breach of duty by a nurse that results in harm or injury to a patient, and is a specific type of Medical Negligence Claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCkvBQiUVULQAdm4v5Me94b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCkvBQiUVULQAdm4v5Me94b">
