        <dc:identifier>TRA-RAIL</dc:identifier>
        <rdfs:label>Rail Transportation Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Eisenbahnverkehrsbranche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria del transporte ferroviario</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria del transporte ferroviario</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie du transport ferroviaire</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de transporte ferroviário</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Rail Transport Industry</skos:altLabel>
        <skos:altLabel>Rail Transportation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית התחבורה ברכבת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रेल परिवहन उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">鉄道輸送産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">铁路运输行业</skos:altLabel>
        <skos:definition>Industries in this group provide rail transportation of passengers and/or cargo using railroad rolling stock. The railroads in this subsector primarily either operate on networks, with physical facilities, labor force, and equipment spread over an extensive geographic area, or operate over a short distance on a local rail line.</skos:definition>
        <skos:hiddenLabel>RAIL</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9UXMB7LO35e1n0zwV2MVmh -->

