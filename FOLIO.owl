            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Breach of Implied Covenant of Good Faith and Fair Dealing</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Implied Covenant of Good Faith and Fair Dealing</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento del Pacto Implícito de Buena Fe y Trato Justo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento del Pacto Implícito de Buena Fe y Trato Justo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Pflicht zur Treu und Glauben</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de l&apos;obligation implicite de bonne foi et de loyauté</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação da obrigação implícita de boa-fé e lealdade</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת הברית המשוררת של אמון טוב והתנהגות הוגנת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंधित नियम का उल्लंघन जो अच्छी नीति और न्यायमय संबंध का होता है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">善意と公正な取引の暗黙の義務違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反隐含的善意和公平原则</skos:altLabel>
        <skos:definition>Breach of Implied Covenant of Good Faith and Fair Dealing refers to a claim made against real estate agents and brokers, alleging that they violated the unwritten obligation to act in good faith and deal fairly with their clients in a contract or quasi-contractual relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R49z2k3XbKC5DpAcwnSGqN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R49z2k3XbKC5DpAcwnSGqN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QtA1XEvYBttW8LUvBN7OB"/>
        <rdfs:label>Release of All Claims Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de libération de toutes les revendications</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Liberación de Todas las Reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Liberación de Todas las Reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de liberação de todas as reivindicações</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Freistellung von Ansprüchen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Release of All Claims Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שחרור מכל טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सभी दावों के विस्तार का निषेध अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">免除所有索赔条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">全請求放棄条項</skos:altLabel>
        <skos:definition>A Release of All Claims Clause is a legal provision that absolves one party from any liability or responsibility for any claims or damages made by the other party, including those that may arise in the future.</skos:definition>
    </owl:Class>
    


