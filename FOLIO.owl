        <skos:altLabel>Entity</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Entität</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Entité</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エンティティ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实体</skos:altLabel>
        <skos:definition>A legal entity is a legal construct through which the law allows a group of natural persons to act as if they were a single person for certain purposes. The most common purposes are lawsuits, property ownership, and contracts. Some examples of legal entities include companies, cooperatives (co-ops), corporations, municipalities, political parties, sovereigns, states, temples, trade unions, and ships or vessels.</skos:definition>
        <skos:hiddenLabel>ENTITY</skos:hiddenLabel>
        <skos:prefLabel>Organization</skos:prefLabel>
    </owl:Class>
    


