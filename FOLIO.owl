        <rdfs:label>Payment Defense</rdfs:label>
        <skos:altLabel xml:lang="es-es">Defensa de Pago</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Defensa de Pago</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Defesa de Pagamento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Défense de paiement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Payment Defence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zahlungsabwehr</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגנת תשלום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भुगतान रक्षा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">付款保护</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">支払い防御</skos:altLabel>
        <skos:definition>A Payment Defense is a legal argument or strategy used by a defendant in a civil litigation case to refute or deny the plaintiff&apos;s claim for payment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jZe5zq22gf2XZO6EWSxuC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jZe5zq22gf2XZO6EWSxuC">
