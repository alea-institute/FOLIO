        <skos:altLabel xml:lang="en-gb">Pretrial Practice</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica Preprocesal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica Preprocesal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática pré-processual</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorverfahrenspraxis</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול לפני המשפט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रीट्रायल अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">事前手続き</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">审前实践</skos:altLabel>
        <skos:definition>Pretrial Practice refers to the legal work and procedures that take place before a trial, including but not limited to motions, pleadings, and discovery.</skos:definition>
    </owl:Class>
    


