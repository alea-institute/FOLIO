    <!-- https://folio.openlegalstandard.org/R9EPdnM3F87jVOjCROdPARe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9EPdnM3F87jVOjCROdPARe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
