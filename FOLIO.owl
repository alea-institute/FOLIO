        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCDSmXwVa56dRfhw74VL2nr"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Sedition</rdfs:label>
        <skos:altLabel xml:lang="de-de">Aufwiegelung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Sedición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sedición</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sedition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Sedição</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Sédition</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סְדִיצְיָה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विद्रोह</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">扇動罪</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">煽动叛乱</skos:altLabel>
        <skos:definition>Sedition is a crime against the government that involves inciting rebellion or resistance against lawful authority.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfdFbicHcYUHpa2L2U2To -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RfdFbicHcYUHpa2L2U2To">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NuHbXZluNRzq9D1bLM716"/>
        <rdfs:label>Implicit Agreement</rdfs:label>
        <skos:altLabel>Inferred Contract</skos:altLabel>
        <skos:altLabel>Tacit Agreement</skos:altLabel>
        <skos:altLabel>Unspoken Agreement</skos:altLabel>
        <skos:definition>An Implicit Agreement is a contract or understanding inferred from the actions, behavior, or circumstances of the parties involved rather than from direct, explicit communication. Such agreements rely on the assumption that the parties have a mutual understanding based on their conduct and the surrounding context.</skos:definition>
        <skos:prefLabel>Implied Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfdN15c44dyYEkhB4tR9Hu -->

