    <!-- https://folio.openlegalstandard.org/RBkiXeTu9Rj1Hq7ISd21CMx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBkiXeTu9Rj1Hq7ISd21CMx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfOoWbuAOqLv617rVNcHYh"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Bulimia Nervosa</rdfs:label>
        <skos:altLabel>Bulimia</skos:altLabel>
        <skos:definition>Bulimia Nervosa is an eating disorder characterized by recurrent episodes of binge eating followed by compensatory behaviors such as vomiting, excessive exercise, or misuse of laxatives to prevent weight gain. Individuals with this disorder often have a preoccupation with body image and weight, leading to a cycle of bingeing and purging.</skos:definition>
        <skos:prefLabel>Bulimic Disorder</skos:prefLabel>
    </owl:Class>
    


