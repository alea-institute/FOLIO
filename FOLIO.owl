        <rdfs:label>Lingala</rdfs:label>
        <skos:altLabel xml:lang="de-de">Lingala</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lingala</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lingala</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リンガラ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">林加拉语</skos:altLabel>
        <skos:definition>Lingala is a structured system of communication consisting of grammar and vocabulary, used in legal matters, that is a member of the language family and is spoken primarily in the Democratic Republic of Congo and the Republic of Congo.</skos:definition>
    </owl:Class>
    


