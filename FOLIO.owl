        <skos:altLabel xml:lang="en-gb">Filer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מזכיר דוחות</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מזכירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फाइलर</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">申报人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">申請者</skos:altLabel>
