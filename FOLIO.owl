        <rdfs:label>oasis:Right</rdfs:label>
        <skos:definition>A right, as defined in the OASIS ontology, is a type of deontic specification.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7d649KKGBfJyGpUlJw50Y1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7d649KKGBfJyGpUlJw50Y1">
