            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RaE0yNxl79wosO0dNpKTnw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Trial Court Practice</rdfs:label>
        <skos:altLabel>Trial Court</skos:altLabel>
        <skos:altLabel>Trial Court Service</skos:altLabel>
        <skos:altLabel>District Court Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de la procédure de première instance</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Praxis des erstinstanzlichen Verfahrens</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de la Corte de Primera Instancia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica del Tribunal de Primera Instancia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática do processo de primeira instância</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial Court Practice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעשה בבית המשפט לניסיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल कोर्ट प्रैक्टिस</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">初审法庭实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">初審裁判所の実務</skos:altLabel>
        <skos:definition>Trial Court Practice refers to the legal work performed by a Legal Services Provider in the course of a legal matter that involves presenting evidence and arguments before a judge or jury in a trial court, including procedures and rules specific to district courts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBgzm9VXuFGCCKU9P2UmV7c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBgzm9VXuFGCCKU9P2UmV7c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBoWiy766xn2DwDMjWqMUbb"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDspRIwoJTlopUDjSgLRduf"/>
        <rdfs:label>Scienter</rdfs:label>
        <skos:altLabel xml:lang="de-de">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Scienter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיינטר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">साइंटर</skos:altLabel>
        <skos:definition>The concept of Scienter refers to the knowledge or intent of wrongdoing by a defendant in a legal claim, which is an essential element of the plaintiff&apos;s case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBh0QM3Ors2HJuox2OtPpU2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBh0QM3Ors2HJuox2OtPpU2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7OQ65vKuOBSSGgSVYnoMfx"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Mixed-member_proportional_representation"/>
        <rdfs:label>Mixed-Member Proportional Representation</rdfs:label>
        <skos:altLabel>MMP</skos:altLabel>
        <skos:definition>Mixed-Member Proportional Representation (MMP) is an electoral system that combines elements of first-past-the-post and proportional representation. Voters typically have two votes: one for a candidate to represent their local constituency and another for a party list, with the overall composition of the legislature reflecting the proportion of party list votes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBh2R6J0MMaUZ59aYJrVwzv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBh2R6J0MMaUZ59aYJrVwzv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Afar</rdfs:label>
        <skos:altLabel xml:lang="de-de">Afar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Afar</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Afar</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アファル語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿法尔语</skos:altLabel>
        <skos:definition>Afar (Language) is a structured system of communication that consists of grammar and vocabulary, and is a member of the Language class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBh4IihdHcd5SdGt2qH2qIx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBh4IihdHcd5SdGt2qH2qIx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHYAaMF4QRHH9QwmNKGN8Y"/>
        <rdfs:label>Dyslexia</rdfs:label>
        <skos:altLabel>Reading Disability</skos:altLabel>
        <skos:altLabel>Reading Disorder</skos:altLabel>
        <skos:definition>Dyslexia is a specific learning disability that affects an individual&apos;s ability to read, spell, write, and sometimes speak, due to difficulties in recognizing and processing written words and symbols. It is a neurological condition that is often hereditary and varies in severity, requiring tailored educational strategies and interventions.</skos:definition>
        <skos:prefLabel>Reading Impairment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBh8j2DJLFLB6DShaW9DyRb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBh8j2DJLFLB6DShaW9DyRb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Waive Credit Counseling</rdfs:label>
        <skos:definition>A Motion to Waive Credit Counseling is a formal request submitted by a debtor to a bankruptcy court to exempt them from the mandatory credit counseling requirement. This requirement is typically necessary before filing for bankruptcy, but the motion may be granted under special circumstances, such as exigency or incapacity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhEKAIRXGRj45kY7Z6eg0y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhEKAIRXGRj45kY7Z6eg0y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R75X7YZe3jw77Sogk8Vz8NT"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R872e3e5kIyoshDoSHVM94B"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDqvWcvBcUV4cKSUqlFKc4k"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Landlord Insurance Policy</rdfs:label>
        <skos:definition>Landlord insurance is designed to provide coverage for property owners who rent out one or more residential homes, apartments, or condos. It generally covers the building structure, and it may also provide coverage for loss of rental income and liability protection. It typically does not cover the personal belongings of the tenants.</skos:definition>
        <skos:prefLabel>Rental Property Insurance</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhGgWIW35Tx2mB2TQPJAIE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhGgWIW35Tx2mB2TQPJAIE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBVPA78WQgUuu6qQ42WBD1D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBwjfSdzaRLqTyzD43IzXmL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD0r8VrjvX5kJXEu110odzx"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Negative Pledge</rdfs:label>
        <skos:altLabel>Covenant Against Encumbrances</skos:altLabel>
        <skos:altLabel>No-Pledge Agreement</skos:altLabel>
        <skos:definition>A Negative Pledge is a covenant in a loan agreement where the borrower agrees not to pledge any assets as collateral if doing so would result in less security for the agreement&apos;s bondholders. This provision aims to protect the interests of the bondholders by ensuring that the borrower does not take actions that would dilute the security or increase the risk associated with the debt.</skos:definition>
        <skos:prefLabel>Non-Encumbrance Covenant</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhOGxYh9EijLWWwCV5Exce -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhOGxYh9EijLWWwCV5Exce">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBSftPgkpTWJ4IzuvXyLBVG"/>
        <rdfs:label>Regional Market Segment</rdfs:label>
        <skos:altLabel>Area Segment</skos:altLabel>
        <skos:definition>The regional segment refers to a portion of the market that is focused on consumers and businesses for a geographical region within a country. This segment tailors its products, services, and marketing strategies to meet the needs and preferences of the regional population, often considering local culture, language, and economic conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhSOojrQ86fo0mJofJzFL9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhSOojrQ86fo0mJofJzFL9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Bucks County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court located in Bucks County, responsible for administering proceedings related to minor criminal offenses, traffic violations, and civil disputes within its jurisdiction.</skos:definition>
    </owl:Class>
    


