        <rdfs:label>Product Disparagement</rdfs:label>
        <skos:altLabel xml:lang="es-es">Difamación de producto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Difamación de producto</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Difamação de produto</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dénigrement de produit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Product Disparagement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Produktabwertung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">השחתת מוצר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्पाद अपमान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">产品诋毁</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">製品の中傷</skos:altLabel>
        <skos:definition>The act of making false or misleading statements about a product or service with the intention of harming its reputation or sales, which falls under the broader category of defamation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RS9mRCkEGyE2dgW38uDMVe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RS9mRCkEGyE2dgW38uDMVe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvD6VheGrBYqJhgQDfMbrV"/>
        <rdfs:label>Double Jeopardy</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Autrefois Acquit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Autrefois Acquit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Doble Jeopardy</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Doble Jeopardy</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Doppelte Strafverfolgung</skos:altLabel>
        <skos:altLabel>Double Jeopardy Claim</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dupla Jeopardia</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סכנת כפולה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डबल जेपर्डी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">二重の危険</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">双重危险</skos:altLabel>
        <skos:definition>The concept of Double Jeopardy refers to the legal principle that prohibits an individual from being prosecuted or punished twice for the same offense after a final judgment has been made.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSAIWX8LNImanB6naIxX5g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSAIWX8LNImanB6naIxX5g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8fFf9YNTCtz4Q15Jjj7AXF"/>
        <rdfs:label>Mandatory Sentence</rdfs:label>
        <skos:altLabel>Compulsory Penalty</skos:altLabel>
        <skos:altLabel>Fixed Sentence</skos:altLabel>
        <skos:altLabel>Legislatively Determined Penalty</skos:altLabel>
        <skos:altLabel>Mandatory Minimum Sentence</skos:altLabel>
        <skos:altLabel>Prescribed Punishment</skos:altLabel>
        <skos:definition>A Mandatory Sentence is a predetermined punishment specified by law for a particular criminal offense, leaving the judge with no discretion to individualize the sentence. This type of sentence requires the court to impose a specific penalty upon conviction, regardless of mitigating factors or the judge&apos;s personal assessment of the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSCPj3Fx9eMWODAmY3A64o -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSCPj3Fx9eMWODAmY3A64o">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
        <rdfs:label>AI Discrimination</rdfs:label>
        <skos:altLabel>Algorithmic Discrimination</skos:altLabel>
        <skos:altLabel>Automated Discrimination</skos:altLabel>
        <skos:altLabel>Computational Discrimination</skos:altLabel>
        <skos:altLabel>Machine-Induced Inequity</skos:altLabel>
        <skos:definition>AI Discrimination refers to the differential treatment of individuals based on factors such as ethnicity, culture, or religion. This discrimination can arise from institutional and individual biases embedded in AI processes, cultural and social biases within the data, technical limitations of hardware or software, or the context of an AI system&apos;s application that results in unequal treatment of groups.</skos:definition>
        <skos:example rdf:resource="https://www.courtlistener.com/docket/66831340/mobley-v-workday-inc/"/>
        <skos:example>Mobley v. Workday, Inc., Case No. 3:23-cv-00770 (N.D. Cal.)</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSCidDameEbWpwdfeB2mhl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSCidDameEbWpwdfeB2mhl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
        <rdfs:label>Claim for Falling on Water</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Sturz auf Wasser</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Claim for Falling on Water</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por caída en el agua</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por caída en el agua</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação por queda na água</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation pour chute sur l&apos;eau</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על נפילה על מים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पानी पर गिरने के लिए दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">水中での転倒に対する請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">跌落水中索赔</skos:altLabel>
        <skos:definition>A claim for falling on water is a legal action brought by a plaintiff who has suffered injury due to slipping and falling on a wet surface, and is based on the legal theory of negligence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSDHiPDqk0hrANSy6LDmXT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSDHiPDqk0hrANSy6LDmXT">
