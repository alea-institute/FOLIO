        </rdfs:subClassOf>
        <rdfs:label>Bearer Securities</rdfs:label>
        <skos:altLabel>Anonymous Securities</skos:altLabel>
        <skos:altLabel>Bearer Financial Instruments</skos:altLabel>
        <skos:altLabel>Bearer Instruments</skos:altLabel>
        <skos:definition>Bearer Securities are financial instruments where the owner&apos;s identity is not recorded on the books of the issuer or the registrar. These securities can be transferred by mere possession, making them highly negotiable and anonymous.</skos:definition>
        <skos:prefLabel>Unregistered Securities</skos:prefLabel>
    </owl:Class>
    


