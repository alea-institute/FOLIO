        <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Mutuo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de acordo mútuo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur gegenseitigen Vereinbarung</skos:altLabel>
