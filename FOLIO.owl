            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Civil Claims</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Actions civiles</skos:altLabel>
        <skos:altLabel>Cause of Action</skos:altLabel>
        <skos:altLabel>Civil Litigation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Civil Claims</skos:altLabel>
        <skos:altLabel xml:lang="en-us">Counts</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Demandas Civiles</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones Civiles</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações civis</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zivilklagen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות אזרחיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नागरिक दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民事索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">民事請求</skos:altLabel>
        <skos:definition>Civil Claims are legal actions brought by one party against another for a non-criminal matter, such as a breach of contract or personal injury, and seek monetary damages or other relief.</skos:definition>
        <skos:prefLabel>Civil Cause of Action</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jcVDnQwdnKGmGiTEDU6a0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jcVDnQwdnKGmGiTEDU6a0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aVRgLAjmuf0OiloIoc9pm"/>
        <rdfs:label>Borda Count Electoral System</rdfs:label>
        <skos:definition>The Borda count electoral system is a voting method where voters rank candidates in order of preference, and points are assigned based on the position in which each candidate is ranked. The candidate with the highest total points across all ballots wins the election, promoting a consensus-based selection rather than a simple majority.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jh45QwNGMf5foqzLlERZs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jh45QwNGMf5foqzLlERZs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Assumption of Liability Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Assumption of Liability Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de prise en charge de la responsabilité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Assunção de Responsabilidade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de asunción de responsabilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de asunción de responsabilidad</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsübernahmeklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף התנגדות לאחריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दायित्व स्वीकरण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">承担责任条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">責任の仮定条項</skos:altLabel>
        <skos:definition>An Assumption of Liability Clause is a provision in a contract where one party agrees to take on the responsibility for any potential legal claims or damages that may arise from the actions of another party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jiyejSsdOkKDAWQ9ZPcjj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jiyejSsdOkKDAWQ9ZPcjj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFPWMbdFLbplboOqvI77Jh"/>
        <rdfs:label>Antitrust - Vertical Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones Verticales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones Verticales</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Antitrust - Revendications verticales</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Antitrust - Vertical Claims</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações verticais</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wettbewerbsrecht - Vertikale Ansprüche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות אנכיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - लंबवत दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反垄断 - 垂直索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占禁止法 - 垂直クレーム</skos:altLabel>
        <skos:definition>Antitrust - Vertical Claims refer to legal claims related to antitrust violations that involve vertical relationships between parties, such as price fixing, market allocation, and tying arrangements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jj3srBAJ1uwSbhFqlt9Y1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jj3srBAJ1uwSbhFqlt9Y1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHbjppawvAlt5WcUyfjeN8"/>
        <rdfs:label>Reasonable Act or Omission</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Acte ou omission raisonnable</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acto u Omisión Razonable</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acto u Omisión Razonable</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Angemessene Handlung oder Unterlassung</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ato ou omissão razoável</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reasonable Act or Omission</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעולה או התעלמות סבירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उचित कार्य या अनुपस्थिति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合理な行為または不作為</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合理行为或不作为</skos:altLabel>
        <skos:definition>An act or failure to act that a reasonable person would or would not do, which is used as a standard to determine liability in cases involving the condition of public property and governmental immunity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8jkTp5friLuBM7MFd6NPRR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8jkTp5friLuBM7MFd6NPRR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77nPY8Gvlle6KPxDEXlNkM"/>
