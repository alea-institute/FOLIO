        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=6213"/>
        <rdfs:label>Offices of Other Health Practitioners</rdfs:label>
        <skos:definition>This industry group comprises establishments of independent health practitioners (except physicians and dentists).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/y9FBouHhRAa0jMB2jUfMAQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/y9FBouHhRAa0jMB2jUfMAQ">
