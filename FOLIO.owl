        <skos:altLabel xml:lang="es-mx">Influencia Indebida Sobre el Testador o el Fideicomitente</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Undue Influence Over Testator or Settlor</skos:altLabel>
        <skos:altLabel xml:lang="he-il">השפעה לא ראויה על הנותן צוואה או המציב תנאי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टेस्टेटर या सेटलर पर अनुचित प्रभाव</skos:altLabel>
        <skos:definition>The concept of &quot;Undue Influence Over Testator or Settlor&quot; refers to the situation where someone exerts pressure or control over a person creating a trust or will, causing them to make decisions that they would not have made otherwise.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RW6LrybdH8vy8EeskNZC6q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RW6LrybdH8vy8EeskNZC6q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMmocc9Ine34BK9vSksb0k"/>
        <rdfs:label>Robust AI</rdfs:label>
        <skos:altLabel>Durable AI</skos:altLabel>
        <skos:definition>Robust AI refers to artificial intelligence systems that are both technically and socially resilient, designed to prevent unintentional harm. Technically robust AI systems are built to handle diverse conditions and adversarial attacks, while socially robust AI systems are designed to function ethically within societal contexts, ensuring safety, reliability, and fairness.</skos:definition>
        <skos:prefLabel>Resilient AI</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RW6nX4aKqrx1jH86AzcQsS -->

