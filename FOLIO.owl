        <skos:altLabel xml:lang="es-es">Responsabilidad de la ciudad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad de la ciudad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade da cidade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité de la ville</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Stadtverantwortlichkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות העיר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शहर की दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">城市责任</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">市の責任</skos:altLabel>
        <skos:definition>City Liability refers to the legal responsibility of a municipality for any harm or damage caused to individuals or property due to the actions or negligence of the city or its employees.</skos:definition>
    </owl:Class>
    


