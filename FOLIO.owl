        <skos:altLabel xml:lang="en-gb">Criminal Homicide Offenses</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Delitos de Homicidio Criminal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Delitos de Homicidio Criminal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Infractions d&apos;homicide criminel</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Straftaten gegen das Leben</skos:altLabel>
