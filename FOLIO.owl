        <skos:altLabel xml:lang="es-es">Cláusula de liberación de obligaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de liberación de obligaciones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de liberação de obrigações</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Freistellung von Verpflichtungen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Release of Obligations Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שחרור מחוייבויות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिभार मुक्ति अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債務免除条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">履行豁免条款</skos:altLabel>
        <skos:definition>A Release of Obligations Clause is a provision in a contract that relieves one party from fulfilling certain obligations or liabilities specified in the agreement.</skos:definition>
    </owl:Class>
    


