        <rdfs:label>Hypothecation Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;hypothèque</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de hipoteca</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de hipoteca</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de hipoteca</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Hypothecation Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hypothekarklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף היפותקציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिकृत गिरवी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">抵当条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">抵押条款</skos:altLabel>
        <skos:definition>A hypothecation clause is a provision in a contract that allows a lender to use the borrower&apos;s property as collateral for a loan, giving the lender the right to seize the property if the borrower defaults on the loan.</skos:definition>
    </owl:Class>
    


