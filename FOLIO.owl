        <rdfs:label>First Amendment Defense</rdfs:label>
        <skos:altLabel>1st Amendment Defense</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Defensa de la Primera Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Defensa de la Primera Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Defesa da Primeira Emenda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Défense du premier amendement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">First Amendment Defense</skos:altLabel>
        <skos:altLabel>Freedom of Expression Defense</skos:altLabel>
        <skos:altLabel>Freedom of Speech Defense</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verteidigung des ersten Verfassungszusatzes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגנת התיקון הראשון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पहला संशोधन रक्षा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第一修正案の防衛</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">第一修正案辩护</skos:altLabel>
        <skos:definition>A First Amendment Defense is a legal strategy used in both criminal and civil litigation to protect an individual&apos;s right to free speech, religion, press, assembly, and petition as guaranteed by the First Amendment of the United States Constitution.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fLMEsGHS8Z3LKqXkoVCQA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7fLMEsGHS8Z3LKqXkoVCQA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD1bQYrjYYQvEqw7Qxv482F"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Stop Sign Violation Claim</rdfs:label>
        <skos:definition>A Stop Sign Violation Claim involves a legal allegation that a driver has failed to make a complete stop at a stop sign as required by traffic regulations, potentially leading to administrative or legal penalties. Such claims are integral to traffic law enforcement and often necessitate evidence review and legal proceedings to resolve.</skos:definition>
        <skos:prefLabel>Failure to Stop Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fPVAgMCjTQpKDG5TgAfrB -->

