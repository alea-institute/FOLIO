        <skos:altLabel xml:lang="es-es">Privilegio de Informe Requerido</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Privilegio de Informe Requerido</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Privilège de rapport requis</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Privilégio de relatório obrigatório</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Required-Report Privilege</skos:altLabel>
