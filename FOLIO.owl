        <skos:definition>The concept of Vagrancy refers to the act of wandering or loitering in public places without a clear purpose or means of support, which may be prohibited by law and subject to penalties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/REH7LVhDnvsOpsMX1a9GqC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/REH7LVhDnvsOpsMX1a9GqC">
