            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Breakup Fee Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Auflösungsgebühr-Klausel</skos:altLabel>
        <skos:altLabel>Break Fee Clause</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Breakup Fee Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de pénalité de rupture</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de penalización por cancelación</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de penalización por ruptura</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de taxa de rescisão</skos:altLabel>
        <skos:altLabel>Termination Fee Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף עמלת התפרדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ब्रेकअप फी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">解除料金条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违约赔偿条款</skos:altLabel>
        <skos:definition>A Breakup Fee Clause is a provision in a contract that requires one party to pay a specified amount of money to the other party if the contract is terminated before completion.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDegO3BIL3RnkKpahVf125n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDegO3BIL3RnkKpahVf125n">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74IJAT8MHMqUZeBJR7txV1"/>
        <rdfs:label>&quot;FATCA&quot; Definition</rdfs:label>
        <skos:altLabel xml:lang="de-de">Definition von FATCA</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de FATCA</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de FATCA</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">FATCAの定義</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">FATCA定义</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDejyPBHivIaQcmk3SJA2oG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDejyPBHivIaQcmk3SJA2oG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBVQj7fYsBw67yNXs4WI6RX"/>
        <rdfs:label>Commodities - Assets</rdfs:label>
        <skos:definition>Commodities are basic goods or raw materials that are interchangeable with other goods of the same type and used as a basis for creating other goods and services. As investment assets, they can be traded on exchanges and include metals, energy resources, agricultural products, and more, offering diversification benefits but also subject to market volatility.</skos:definition>
        <skos:prefLabel>Commodities</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDesaWHAeV52XIBg1EK2z8k -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDesaWHAeV52XIBg1EK2z8k">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBfgMJEBmJrI7Wp0zUjROJ3"/>
        <rdfs:label>Intern</rdfs:label>
        <skos:definition>An intern is an individual, often a student, who works temporarily for an organization to gain practical experience in a specific industry. Internships can be paid or unpaid and are often seen as a stepping stone to full-time employment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDesytbN8TFMKoWlfrwJAdk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDesytbN8TFMKoWlfrwJAdk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9BC2mdYLFmSyLcCkV4odRX"/>
        <rdfs:label>Wetland</rdfs:label>
        <skos:altLabel>Aquatic Ecosystem Zone</skos:altLabel>
        <skos:altLabel>Marshland</skos:altLabel>
        <skos:definition>A Wetland Area is a type of land area characterized by the presence of water, either permanently or seasonally, and hosts specific types of vegetation and wildlife adapted to saturated conditions. Wetland areas are often subject to environmental regulations aimed at their protection, management, and conservation.</skos:definition>
        <skos:prefLabel>Floodplain</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDf1QQsIRXdoXon43LsVRNz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDf1QQsIRXdoXon43LsVRNz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBB5cexM3974afJhhR2yXHA"/>
        <rdfs:label>Indiana Town Court - Marion County, Center Twp.</rdfs:label>
        <skos:definition>A court located in Marion County, Center Township, Indiana that has limited jurisdiction over minor criminal offenses, traffic violations, and small claims cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDf1tfWLrzvdgWUXtzXqY3f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDf1tfWLrzvdgWUXtzXqY3f">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
        <rdfs:label>Dual Capacity Doctrine</rdfs:label>
        <skos:altLabel xml:lang="es-es">Doctrina de la Doble Capacidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Doctrina de la Doble Capacidad</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Doctrine de double capacité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Doutrina da Dupla Capacidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dual Capacity Doctrine</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lehre der doppelten Kapazität</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תאוריה של יכולת כפולה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">द्वित्व क्षमता सिद्धांत</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">二重能力原則</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">双重能力原则</skos:altLabel>
        <skos:definition>The Dual Capacity Doctrine is a legal concept that allows an injured employee to sue their employer in a capacity other than their employer, such as a manufacturer or seller of a defective product, in addition to receiving workers&apos; compensation benefits.</skos:definition>
    </owl:Class>
    


