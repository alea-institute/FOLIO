        <rdfs:label>Workplace Violence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Gewalt am Arbeitsplatz</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violence en milieu de travail</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Violencia en el lugar de trabajo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Violencia en el lugar de trabajo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violência no local de trabalho</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Workplace Violence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אלימות במקום העבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार्यस्थल पर हिंसा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">职场暴力</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">職場暴力</skos:altLabel>
        <skos:definition>Workplace Violence: Any physical or verbal abuse, harassment, intimidation, or threatening behavior that occurs in a work setting, which may result in harm or injury to employees or damage to property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7yue2mtjzJWKBkXpq5y1Mm -->

