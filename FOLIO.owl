        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Jicarilla Apache Nation</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dUDKpLyGbaSRzXEWi1qQO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7dUDKpLyGbaSRzXEWi1qQO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUE4fCCSnGX1wIK324EyiL"/>
        <dc:identifier>TRA-WHST</dc:identifier>
        <rdfs:label>Warehousing and Storage Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de Almacenamiento y Almacenaje</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Almacenamiento y Almacenaje</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de l&apos;entreposage et du stockage</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de armazenagem e armazenamento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lager- und Lagerindustrie</skos:altLabel>
        <skos:altLabel>Warehousing and Storage</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Warehousing and Storage Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית אחסון ואחסון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वेयरहाउसिंग और स्टोरेज उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">仓储和储存行业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">倉庫・保管業</skos:altLabel>
        <skos:definition>Industries in this group are primarily engaged in operating warehousing and storage facilities for general merchandise, refrigerated goods, and other warehouse products. These establishments provide facilities to store goods. They do not sell the goods they handle. These establishments take responsibility for storing the goods and keeping them secure. They may also provide a range of services, often referred to as logistics services, related to the distribution of goods. Logistics services can include labeling, breaking bulk, inventory control and management, light assembly, order entry and fulfillment, packaging, pick and pack, price marking and ticketing, and transportation arrangement. However, establishments in this industry group always provide warehousing or storage services in addition to any logistic services. Furthermore, the warehousing or storage of goods must be more than incidental to the performance of services, such as price marking.</skos:definition>
        <skos:hiddenLabel>WHST</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dUEt2k8bqVAeZR72kHXfO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7dUEt2k8bqVAeZR72kHXfO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:label>Standalone Material Adverse Effect Closing Condition</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bedingung für den Abschluss eines eigenständigen wesentlichen nachteiligen Effekts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Condición de cierre de efecto adverso material independiente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Condición de cierre de efecto adverso material independiente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Condition de clôture d&apos;effet indépendant matériel négatif</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Condição de Fechamento de Efeito Adverso Material Independente</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Standalone Material Adverse Effect Closing Condition</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנאי סגירה של השפעה שלילית חומרית עצמאית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वतंत्र सामग्री विपरीत प्रभाव समापन शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スタンドアロンマテリアルアドバースエフェクトクロージングコンディション</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">独立的实质性不利影响结束条件</skos:altLabel>
        <skos:definition>A Standalone Material Adverse Effect (MAE) Closing Condition, also known as MAE, is a specific language used in legal agreements that outlines the circumstances under which a party can terminate the agreement due to a significant negative change in the financial or operational condition of the other party.</skos:definition>
    </owl:Class>
    


