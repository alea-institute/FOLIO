        <rdfs:label>Fair Use</rdfs:label>
        <skos:altLabel>Fair Dealing</skos:altLabel>
        <skos:inSchema>UK</skos:inSchema>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iCcypHReRP54sT9awbCsA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iCcypHReRP54sT9awbCsA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RE417c6578dfc77Ad721067c"/>
        <rdfs:label>South Carolina Office of the Attorney General</rdfs:label>
        <skos:definition>The South Carolina Office of the Attorney General is a government entity responsible for providing legal advice and representation to the state of South Carolina, operating under the jurisdiction of the South Carolina State Courts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iGqX5xbiOWpsuFDpBLYhU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iGqX5xbiOWpsuFDpBLYhU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHZTIZfN6Fbrf6azRExLaD"/>
        <rdfs:label>Go-Shop Covenant</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Convenio Go-Shop</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Engagement de Go-Shop</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Go-Shop Covenant</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Go-Shop コヴェナント</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Go-Shop 公约</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Go-Shop-Verpflichtung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Pacto Go-Shop</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pacto Go-Shop</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם גו-שופ</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गो-शॉप कवेनेंट</skos:altLabel>
        <skos:definition>A Go-Shop Covenant is a provision in a deal protection agreement that allows the target company to seek out alternative offers from other potential buyers during a specified period of time, while still honoring the original offer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iHPKfEWde46GaHTUpl9L6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iHPKfEWde46GaHTUpl9L6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92ONqcV7UfNfi8C6GrarfD"/>
        <rdfs:isDefinedBy>From National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
        <rdfs:label>Limited Probate</rdfs:label>
        <skos:altLabel xml:lang="de-de">Eingeschränktes Nachlassverfahren</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Limited Probate</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Probate limitado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Probate limitado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Processo de inventário limitado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Procédure de succession limitée</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צוואה מוגבלת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सीमित प्रोबेट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">有限遗产认证</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">限定遺産認定手続き</skos:altLabel>
        <skos:definition>Limited Probate is a type of filing in the probate process that is restricted in scope and typically involves a specific aspect of an estate, such as the distribution of a particular asset or the appointment of a temporary administrator.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iIfKh8looAmJ0pEG5DR9t -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iIfKh8looAmJ0pEG5DR9t">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Blissymbols; Blissymbolics; Bliss</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bliss-Symbole; Bliss-Symbolik; Bliss</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Blissymboles; Blissymbolique; Bliss</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Blissímbolos; Blissímica; Bliss</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ブリスシンボル; ブリス記号論; ブリス</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">布利斯符号; 布利斯符号学; 布利斯</skos:altLabel>
        <skos:definition>A system of symbols used for communication, originally developed for individuals with communication disabilities, now used more broadly for international communication.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iNDKVGzNLRjMfDsSHEhQ6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iNDKVGzNLRjMfDsSHEhQ6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r"/>
        <rdfs:label>Exchange Equity for Equity</rdfs:label>
        <skos:altLabel>Share-for-Share Exchange</skos:altLabel>
        <skos:altLabel>Stock-for-Stock Exchange</skos:altLabel>
        <skos:definition>An asset exchange where a party swaps one type of equity for another. This can occur during mergers or acquisitions to consolidate ownership interests.</skos:definition>
        <skos:prefLabel>Equity Swap</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iQlRknNs4DeBQ9yfW3G4H -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iQlRknNs4DeBQ9yfW3G4H">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDuvu3dUJz2utfkB5G6RviW"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/2.00-SpecialSensesandSpeech-Adult.htm#2_03"/>
        <rdfs:label>Peripheral Vision Loss</rdfs:label>
        <skos:altLabel>Contraction of the Visual Field in the Better Eye</skos:altLabel>
        <skos:definition>Contraction of the visual field in the better eye refers to a significant reduction in the area of vision around the point of fixation. This condition is characterized by one or more specific measurements indicating severe restriction in the visual field.</skos:definition>
        <skos:prefLabel>Visual Field Contraction</skos:prefLabel>
    </owl:Class>
    


