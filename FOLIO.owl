        <skos:definition>The Indiana Circuit Court - St. Joseph County is a specific court within the Indiana Circuit Court system that has jurisdiction over legal proceedings in St. Joseph County, Indiana.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RByhWBQBS3KV6tj8TwFXRPd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RByhWBQBS3KV6tj8TwFXRPd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
        <rdfs:label>fee_item_disc_cred segment</rdfs:label>
        <skos:definition>&quot;All discounts, credits and Alternate Fee Agreement items applied to the parent fee line item.  There will be 0 or more FEE_ITEM_DISC_CRED segments per FEE item.  

Note that the EXTEND_HEADER option was purposely omitted from this segment.
  &quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RByl0iNSHBNmfLanOSBWLSx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RByl0iNSHBNmfLanOSBWLSx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RObTyeuV6yxdWyj5mj108e"/>
        <rdfs:label>Recurrent Use and Permission Tax Payment</rdfs:label>
        <skos:altLabel>Fixed Interval Use Tax</skos:altLabel>
        <skos:altLabel>License Tax Payment</skos:altLabel>
        <skos:altLabel>Periodic Use Tax Payment</skos:altLabel>
        <skos:altLabel>Recurrent Utilization Tax Payment</skos:altLabel>
        <skos:altLabel>Recurrent taxes</skos:altLabel>
        <skos:altLabel>Regular Permission Fee Payment</skos:altLabel>
        <skos:altLabel>Regular Permission Tax Payment</skos:altLabel>
        <skos:definition>Recurrent Use and Permission Tax Payment refers to taxes levied at regular intervals, usually as fixed amounts, for the use of goods or permission to use goods or perform activities. This category includes vehicle license taxes, as well as taxes on permission to hunt, shoot, fish, sell certain products, own dogs, broadcast license fees, and taxes on performing certain services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBylXgiNTTPZ741XMP33dLG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBylXgiNTTPZ741XMP33dLG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ4HPUl2DrL4G30lmoFKJN"/>
        <rdfs:label>Shareholder Letter</rdfs:label>
        <skos:altLabel>CEO Letter to Shareholders</skos:altLabel>
        <skos:altLabel>Equity Holder Correspondence</skos:altLabel>
        <skos:definition>A Shareholder Letter is a formal document, usually penned by a company&apos;s top management, directed towards the shareholders of the company. It often accompanies annual or quarterly reports and aims to provide insights into the company&apos;s performance, strategies, and future plans.</skos:definition>
        <skos:prefLabel>Investor Letter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RByqj7xAcBT7mYPxL41urdQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RByqj7xAcBT7mYPxL41urdQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UB332003aHlAfQeAxehdN"/>
        <rdfs:label>Proprietary Property Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de propriété exclusive</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Propiedad Propietaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Propiedad Propietaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de propriedade exclusiva</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel für Eigentumsvorbehalte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Proprietary Property Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף רכוש פרטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रोप्राइटरी संपत्ति शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专有财产条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占的な財産条項</skos:altLabel>
        <skos:definition>A Proprietary Property Clause is a provision in a contract that grants exclusive ownership rights to a specific property or asset to one party, typically the seller or licensor, and restricts the use or transfer of that property by the other party, typically the buyer or licensee.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RByuwDMI6GCjgMfnfpw1HMg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RByuwDMI6GCjgMfnfpw1HMg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Slave</rdfs:label>
        <skos:altLabel>Athapascan</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Esclave</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escravo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sklave</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">奴隶</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">奴隷</skos:altLabel>
        <skos:definition>A language spoken by the Athapascan people, including the Slavey dialect, used in legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBywI6I3xmyyZ2sqrWKu1Wy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBywI6I3xmyyZ2sqrWKu1Wy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsDNLN3OFdVxc9ZIMb6Noj"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R80nTp0xPWvxkJonwMOIvBA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9ZfQLUD6x5jCYfUMTaf8m9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Gender Change</rdfs:label>
        <skos:definition>A gender change refers to the legal process by which an individual modifies the gender marker on official documentation to align with their gender identity. This process varies by jurisdiction, but typically involves submitting proof of medical or psychological evaluation, undergoing specific medical procedures, or simply making a declaration, followed by the issuance of updated identification documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBz2aCAIZMshK7S6EKsCHmX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBz2aCAIZMshK7S6EKsCHmX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sHH7RvjZ6aZS7ZExDpYmR"/>
        <rdfs:label>Familial Status</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Estado civil</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Familienstand</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Situation familiale</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">家庭状况</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家族構成</skos:altLabel>
        <skos:definition>Familial status refers to the presence of children under the age of 18 in a family, including pregnant women and individuals in the process of adopting or securing legal custody of a child. This classification is protected under various anti-discrimination laws, such as the Fair Housing Act in the United States, which prohibits discrimination in housing based on familial status (among other bases).</skos:definition>
        <skos:prefLabel>Parental Status</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBz3X5A64jBCPpS7z4AumiF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBz3X5A64jBCPpS7z4AumiF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDECjssxw76vdlahxiUTb4L"/>
        <rdfs:label>Missouri Circuit Court - Grundy County</rdfs:label>
        <skos:definition>Missouri Circuit Court - Grundy County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Grundy County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzBDWMpZCOFGTjRpx1wKEH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzBDWMpZCOFGTjRpx1wKEH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG"/>
        <rdfs:label>Assignment for the Benefit of Creditors</rdfs:label>
        <skos:definition>Assignment for the Benefit of Creditors (ABC) is a voluntary liquidation process where a debtor transfers all assets to an assignee, who sells the assets and distributes the proceeds to creditors. This non-judicial alternative to bankruptcy aims to maximize asset value and expedite creditor repayment. Some jurisdictions require court proceedings.</skos:definition>
    </owl:Class>
    


