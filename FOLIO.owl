        <rdfs:label>Governmental Law Division</rdfs:label>
        <skos:altLabel>Government Legal Department</skos:altLabel>
        <skos:definition>A Governmental Law Division is a legal entity within a government, responsible for providing legal services to government agencies, officials, and the public. It ensures legal compliance, represents the government in legal matters, and offers legal advice on policy and administrative issues.</skos:definition>
        <skos:example>Attorney General&apos;s Office</skos:example>
        <skos:example>City Attorney&apos;s Office</skos:example>
        <skos:example>County Attorney&apos;s Office</skos:example>
        <skos:example>Prosecutor&apos;s Office</skos:example>
        <skos:example>Public Defender&apos;s Office</skos:example>
        <skos:example>State Solicitor General&apos;s Office</skos:example>
    </owl:Class>
    


