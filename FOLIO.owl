    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDplPdJJQ6YnEbE1gSXm51T">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
        <rdfs:label>Breach of Implied Contract</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Implied Contract</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de contrato implícito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato implícito</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung eines stillschweigenden Vertrags</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de contrat implicite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de contrato implícito</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חוזה משוער</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मानवाधिकार उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">暗黙の契約違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反默示合同</skos:altLabel>
        <skos:definition>The Breach of Implied Contract is a legal claim that arises when one party fails to fulfill an obligation that was not explicitly stated in a contract, but was understood to be a part of the agreement.</skos:definition>
    </owl:Class>
    


