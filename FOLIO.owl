        <skos:definition>See industry description for 923130.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/VnrDLRseTqq04Iql8QLoMA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/VnrDLRseTqq04Iql8QLoMA">
