        <skos:altLabel xml:lang="zh-cn">文档的预期读者</skos:altLabel>
        <skos:definition>The audience that the author(s) intend to see the document, including potential items as Actors (e.g., Client Name, Provider Organization Name), Forums (e.g., Court), Governmental Body (e.g., Food and Drug Administration, Federal Trade Commission), or Public.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCBYQBHCTDnnpanK0HJ0I7w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCBYQBHCTDnnpanK0HJ0I7w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79xLpY9gRRitoFR3T667If"/>
        <rdfs:label>Invertebrate Animal</rdfs:label>
        <skos:altLabel>Invertebrate</skos:altLabel>
        <skos:altLabel>Non-vertebrate Animal</skos:altLabel>
        <skos:definition>An Invertebrate Animal is a member of the animal kingdom that lacks a backbone or spinal column. Invertebrates encompass a vast array of species including insects, mollusks, crustaceans, arachnids, and echinoderms, and they constitute the majority of animal diversity on Earth.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCBeWPBIIYMC1iYhPz9YA6K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCBeWPBIIYMC1iYhPz9YA6K">
