        <skos:altLabel xml:lang="zh-cn">公司财产归还条款</skos:altLabel>
        <skos:definition>A Return of Company Property Clause is a provision in a contract that requires the return of any property belonging to the company upon termination of the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsKAdFizNZ9p4EIf28s4Dq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsKAdFizNZ9p4EIf28s4Dq">
