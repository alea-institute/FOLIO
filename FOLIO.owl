        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Cumulative Rights Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de droits cumulatifs</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Derechos Acumulativos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Derechos Acumulativos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de direitos acumulativos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cumulative Rights Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kumulative Rechteklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכויות מצטברות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संचयी अधिकार शर्त</skos:altLabel>
