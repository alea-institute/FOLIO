                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8p15egW5el3Go9V1L4obop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBId9f3jW4zEqooPvShqi6Q"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCc50c8MA7S8aeFuufxdksV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Product Liability Representation</rdfs:label>
        <skos:definition>Product Liability Representation is a clause in merger and acquisition agreements where the selling party attests to the absence of product defects or claims arising from sold or distributed products of the target company. It serves to protect the buyer from potential undisclosed liabilities or claims related to product malfunctions, damages, or injuries that may arise after the acquisition.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mv7WPb7PlAl2oknWrjIqa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mv7WPb7PlAl2oknWrjIqa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QiKeEkci1FYlRMv6nDRnv"/>
        <rdfs:label>Employee Benefits Motion</rdfs:label>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande d&apos;avantages sociaux pour les employés</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Employee Benefits Motion</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mitarbeiterleistungsantrag</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Beneficios para Empleados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Beneficios para Empleados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Benefícios para Funcionários</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועת יתרות עובדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कर्मचारी लाभ आंदोलन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">员工福利申请</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">従業員福利申請</skos:altLabel>
        <skos:definition>A request made by a debtor in a bankruptcy case seeking authorization to continue providing employee benefits, such as health insurance and retirement plans, to its employees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mw82M2JL2CAKqkzh6FeSG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mw82M2JL2CAKqkzh6FeSG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDkwyaka1G06Txgxv0pNxqI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>International Bill of Human Rights</dc:source>
        <rdfs:label>Freedom from Discrimination</rdfs:label>
        <skos:definition>Freedom from discrimination is a fundamental human right that entails the equal treatment of all individuals, regardless of race, gender, religion, nationality, disability, or other characteristics. This right is upheld by various international treaties and national laws, aiming to prevent unjust or prejudicial treatment based on a person&apos;s inherent traits or beliefs.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mxTY8cKuN8Sy7FdDhxNb8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mxTY8cKuN8Sy7FdDhxNb8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB3FT9lFNQIjRnFIueLgCa7"/>
        <rdfs:label>Notice of Status Conference</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Avis de conférence de statut</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Aviso de Conferencia de Estado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aviso de Conferencia de Estado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aviso de conferência de status</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mitteilung über den Statuskonferenz</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Notice of Status Conference</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הודעת כנס מצב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्थिति सम्मेलन की सूचना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">状态会议通知</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">状況会議の通知</skos:altLabel>
        <skos:definition>A Notice of Status Conference is a written communication that informs parties involved in a legal case of a scheduled meeting with the judge to discuss the current status of the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mz8xGkeTyOUun1Ua0VnLZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mz8xGkeTyOUun1Ua0VnLZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ihoRPcnCIxjpGoNYzMi2Y"/>
        <rdfs:label>Subsidized Healthcare Coverage Policy for Low-Income Groups</rdfs:label>
        <skos:definition>Subsidized healthcare programs like Medicaid in the U.S. provide medical coverage to low-income individuals and families. These programs are often funded by both state and federal governments, and eligibility criteria can vary by jurisdiction.</skos:definition>
        <skos:prefLabel>Medicaid</skos:prefLabel>
    </owl:Class>
    


