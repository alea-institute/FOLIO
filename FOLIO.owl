        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R56494b95Ebfc1CAdc28355c"/>
        <rdfs:label>Kentucky Supreme Court</rdfs:label>
        <skos:definition>The Kentucky Supreme Court is the highest court in the state of Kentucky, with the power to hear appeals and make final decisions on legal cases within the state court system.</skos:definition>
    </owl:Class>
    


