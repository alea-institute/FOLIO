        <rdfs:label>Flat Buyer Consent Requirement</rdfs:label>
        <skos:altLabel xml:lang="de-de">Erfordernis der Zustimmung des Wohnungskäufers</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Exigence de consentement de l&apos;acheteur d&apos;un appartement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Flat Buyer Consent Requirement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Requisito de consentimento do comprador de apartamento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Requisito de consentimiento del comprador de departamentos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Requisito de consentimiento del comprador de pisos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דרישת הסכמת קונה דירה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फ्लैट खरीदार सहमति आवश्यकता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フラット購入者の同意要件</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">购房者同意要求</skos:altLabel>
        <skos:definition>A Flat Buyer Consent Requirement is a legal concept that refers to the specific requirement for a buyer&apos;s consent in a transaction, without any additional conditions or qualifications.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTOKjYuZWSDY4D5arHFPci -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTOKjYuZWSDY4D5arHFPci">
