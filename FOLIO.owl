        <skos:altLabel xml:lang="es-es">Cláusula de Escalación del Índice de Precios al Consumidor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Escalación del Índice de Precios al Consumidor</skos:altLabel>
