    <!-- https://folio.openlegalstandard.org/HYKR-C2YRNuu8MK0iAyQ-w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/HYKR-C2YRNuu8MK0iAyQ-w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ZGJ1mrkqSjyjrR2qxTgCdA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=922110"/>
        <rdfs:label>Courts</rdfs:label>
        <skos:definition>This industry comprises civilian courts of law (except American Indian and Alaska Native tribal courts). Included in this industry are civilian courts, courts of law, and sheriffs&apos; offices conducting court functions only.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/HcS1VTFWSDWgLMVQBIsSfA -->

