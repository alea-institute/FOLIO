        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7Zwd84vqcynsz8PsQJt7xj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rj8CP6YnshKY7MmCXaiuY1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Support Personnel of Athletes or Entertainers</rdfs:label>
        <skos:altLabel>P-1S Visa</skos:altLabel>
        <skos:definition>This visa (in the U.S., P-1S Visa) is designated for support personnel who are an integral part of the performance of an athlete or entertainer or entertainment group (in the U.S., P1A or P-1B). In the United States, this visa allows these essential support personnel to accompany the principal visa holder for the duration of the event, competition, or performance. The initial period of stay is tied to the P-1 or P-1B visa holder&apos;s duration, with the possibility of extensions</skos:definition>
    </owl:Class>
    


