        <skos:altLabel xml:lang="es-es">Grupo de Defensa Conjunta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Grupo de Defensa Conjunta</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Grupo de Defesa Conjunta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Joint Defence Group</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קבוצת הגנה משותפת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संयुक्त रक्षा समूह</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">共同防衛グループ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">联合防御组</skos:altLabel>
        <skos:definition>A group of parties who participate in a Joint Defense Agreement, usually separate parties (though in a similar position) who are defendants in a civil lawsuit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vomNaX2Wv8mWmUp4WBk3n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8vomNaX2Wv8mWmUp4WBk3n">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RTHm2BxeaziDbm5655G1ki"/>
        <rdfs:label>Variable Costs</rdfs:label>
        <skos:definition>Variable costs are expenses that change in direct proportion to the level of goods or services that a business produces. Examples include raw materials, direct labor, subcontractor fees, and shipping costs, which increase or decrease as production volumes change. This metric is important for scalability analysis.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8vqEh4rOF2zikhi94vU9X9 -->

