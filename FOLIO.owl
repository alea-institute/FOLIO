        <skos:altLabel xml:lang="es-mx">Ley de Prescripción</skos:altLabel>
        <skos:altLabel>Limitation Period</skos:altLabel>
        <skos:altLabel>Limitations Period</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prazo de prescrição</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Statute of Limitations</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verjährungsfrist</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק תקרה זמנית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समय सीमा अधिनियम</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">時効</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">诉讼时效</skos:altLabel>
        <skos:definition>A Statute of Limitations is a legal defense that sets a specific time limit for bringing a lawsuit or criminal charges, after which the claim or charges cannot be pursued.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKNVxICQDLTVRhliBpxNmj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDKNVxICQDLTVRhliBpxNmj">
