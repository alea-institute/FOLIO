                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RkmwkCxidQzeNwqnSEZHyW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source rdf:resource="https://www.cftc.gov/IndustryOversight/Intermediaries/FCMs/fcmib.html"/>
        <dc:source rdf:resource="https://www.investopedia.com/terms/f/fcm.asp"/>
        <dc:source rdf:resource="https://www.nfa.futures.org/registration-membership/who-has-to-register/fcm.html"/>
        <rdfs:label>Futures Commission Merchant</rdfs:label>
        <skos:altLabel>Futures Broker</skos:altLabel>
        <skos:definition>A Futures Commission Merchant (FCM) is a firm or individual that solicits or accepts orders to buy or sell futures contracts, options on futures, retail foreign exchange contracts, or swaps and accepts money or other assets from customers to support such orders. FCMs are registered and regulated by financial authorities to ensure compliance with trading regulations and the safeguarding of customer funds.</skos:definition>
        <skos:prefLabel>FCM</skos:prefLabel>
    </owl:Class>
    


