    <!-- https://folio.openlegalstandard.org/RBNLtCtiehXHqrqSiI8me4X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNLtCtiehXHqrqSiI8me4X">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMCyg29yJdESbSXnNRLABk"/>
        <rdfs:label>Preferred Shares</rdfs:label>
        <skos:altLabel>Priority Shares</skos:altLabel>
        <skos:definition>Preferred Shares represent a class of ownership in a company that confers preferential treatment regarding dividend payments and asset distribution in the event of liquidation. These shares typically do not carry voting rights but offer a fixed dividend that must be paid before any dividends are distributed to common shareholders.</skos:definition>
        <skos:prefLabel>Preferred Stock</skos:prefLabel>
    </owl:Class>
    


