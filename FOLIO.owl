        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Accord and Satisfaction Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Accord and Satisfaction Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;accord et de satisfaction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Acordo e Satisfação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Conformidad y Satisfacción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Conformidad y Satisfacción</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Erfüllung und Befriedigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הסכמה והפרעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंध और संतोष बंधन धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">和解および満足条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">和解与满足条款</skos:altLabel>
        <skos:definition>An Accord and Satisfaction Clause is a provision in a contract that allows parties to settle a dispute by agreeing to different terms than originally agreed upon.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9SAKPHWeGi7uZqUG6EMlt -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9SAKPHWeGi7uZqUG6EMlt">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
