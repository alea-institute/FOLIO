        <skos:definition>Missouri Circuit Court - Dent County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters in Dent County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsMZCIpNr75CMlyiRfV5kP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsMZCIpNr75CMlyiRfV5kP">
