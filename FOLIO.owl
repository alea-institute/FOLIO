    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCmS4MUteORrZ5pqw5FsObZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCmS4MUteORrZ5pqw5FsObZ">
