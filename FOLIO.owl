        <rdfs:label>Piece Goods, Notions, and Other Dry Goods Merchant Wholesalers</rdfs:label>
        <skos:definition>See industry description for 424310.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/WDvs-ij5QFqS5OP9Bat39g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/WDvs-ij5QFqS5OP9Bat39g">
