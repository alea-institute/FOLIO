        <skos:altLabel xml:lang="es-es">Negligencia Comparada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia Comparativa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência comparativa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence comparative</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergleichende Fahrlässigkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה משותפת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तुलनात्मक लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">比較過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">比较过失责任</skos:altLabel>
        <skos:definition>A legal theory that allows for the apportionment of damages between parties based on their respective degrees of fault or negligence in causing harm or injury.</skos:definition>
    </owl:Class>
    


