        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:label>Federal Employers Liability Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Bundesgesetz über die Haftung von Arbeitgebern</skos:altLabel>
        <skos:altLabel>FELA Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Federal Employers Liability Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação de acordo com a Lei Federal de Responsabilidade dos Empregadores</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Ley Federal de Responsabilidad del Empleador</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Ley Federal de Responsabilidad del Empleador</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi fédérale sur la responsabilité des employeurs</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק האחריות של מעסיקים פדרליים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फेडरल एम्प्लॉयर्स लायबिलिटी एक्ट क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">根据联邦雇主责任法提出的索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">連邦雇用者責任法に基づく請求</skos:altLabel>
        <skos:definition>A Federal Employers Liability Act Claim is a legal claim brought by an employee against their employer for injuries sustained on the job due to the employer&apos;s negligence, and is governed by federal law.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9zfbONJISnRjpI4gufgjAU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9zfbONJISnRjpI4gufgjAU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGOU62BPz1QTVsWRE2Nodz"/>
        <rdfs:label>Employment Location Type</rdfs:label>
        <skos:definition>Employment Location Type describes where an employee performs their job duties and can include categories such as onsite, offsite, remote, roving, or third-party placement. These classifications help define the employee&apos;s working environment and may impact job responsibilities, oversight, and eligibility for certain benefits or allowances</skos:definition>
    </owl:Class>
    


