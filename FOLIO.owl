        <skos:altLabel xml:lang="es-mx">El demandante habría consentido</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kläger hätte zugestimmt</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Le plaignant aurait consenti</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">O autor teria consentido</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Plaintiff Would Have Consented</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התובע היה מסכים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिवादी सहमत हो जाता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">原告は同意したであろう</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">原告会同意</skos:altLabel>
        <skos:definition>Defendant is not liable where defendant proves plaintiff would have consented, even though a reasonable person in plaintiff&apos;s position might not have consented to the procedure had he been given enough information about its risks.</skos:definition>
    </owl:Class>
    


