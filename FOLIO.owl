        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it"/>
        <rdfs:label>Indemnification by Service Provider Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;indemnisation par le fournisseur de services</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización por parte del proveedor de servicios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización por parte del proveedor de servicios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de indenização pelo provedor de serviços</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsfreistellungsklausel des Dienstleisters</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Indemnification by Service Provider Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצויים על ידי ספק השירותים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सेवा प्रदाता द्वारा भरपाई शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">サービスプロバイダーによる補償条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">服务提供商赔偿条款</skos:altLabel>
        <skos:definition>A provision in a contract where a service provider agrees to compensate the other party for any losses or damages incurred as a result of the service provider&apos;s actions or omissions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCEvn4X1QQvn9BjOTtKwPzC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCEvn4X1QQvn9BjOTtKwPzC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrshoNA9Tc4Xswrj0v8nqX"/>
        <rdfs:label>&quot;Constructive Knowledge - Knowledge Limited to Identified Persons&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje &quot;Conocimiento Limitado a Personas Identificadas&quot;</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje &quot;Conocimiento Limitado a Personas Identificadas&quot;</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Effekts - Sprache &quot;Wissen beschränkt auf identifizierte Personen&quot;</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Linguagem &quot;Conhecimento Limitado a Pessoas Identificadas&quot;</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de l&apos;effet indésirable important - Langue &quot;Connaissance limitée aux personnes identifiées&quot;</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - &quot;Knowledge Limited to Identified Persons&quot; Language</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת השפעה נזיקה חומרית - שפת &quot;ידיעה מוגבלת לאנשים מזוהים&quot;</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मददगार विपरीत प्रभाव परिभाषा - &quot;पहचानी गई व्यक्तियों तक सीमित ज्ञान&quot; भाषा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质不利影响定义 - &quot;知识仅限于已确定人员&quot;语言</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-「特定の人物に限定された知識」言語</skos:altLabel>
        <skos:definition>&quot;Knowledge Limited to Identified Persons&quot; Language refers to a clause in a legal agreement that limits the scope of knowledge to only those individuals who have been identified in the agreement, and defines the circumstances under which a material adverse effect can occur.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCEwcs4nsUh0DCVWnr8zAtZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCEwcs4nsUh0DCVWnr8zAtZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bS3yb1nTD8lCzWFVFMZ0c"/>
        <rdfs:label>Deal Collaboration Management</rdfs:label>
        <skos:definition>Deal Collaboration Management refers to the process of coordinating and managing the collaboration between parties involved in a legal transaction. It falls under the broader category of Legal Transaction Management.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
        <rdfs:label>Foundation and Competency Objections</rdfs:label>
        <skos:definition>Foundation and Competency Objections are raised when a party in a legal proceeding believes that evidence lacks the necessary groundwork for admissibility (foundation) or when a witness lacks the qualifications to provide reliable testimony (competency). These objections aim to ensure that evidence and testimony meet legal standards for relevance, reliability, and expertise.</skos:definition>
    </owl:Class>
    


