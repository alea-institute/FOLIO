        <rdfs:label>South Asian Association for Regional Cooperation</rdfs:label>
        <skos:definition>SAARC (South Asian Association for Regional Cooperation): An economic and geopolitical organization of eight countries in South Asia, aimed at fostering mutual understanding and improving the quality of life for the peoples of the member states.</skos:definition>
        <skos:prefLabel>SAARC</skos:prefLabel>
    </owl:Class>
    


