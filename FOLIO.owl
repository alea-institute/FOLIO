        <skos:altLabel xml:lang="de-de">Fehlerhafte Psychotherapie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia profesional del psicoterapeuta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia profesional del psicoterapeuta</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência do psicoterapeuta</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Psychotherapist Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חוקי המקצוע של מטפל פסיכותרפי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मनोचिकित्सक दोष</skos:altLabel>
