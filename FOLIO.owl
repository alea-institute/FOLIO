        <skos:altLabel xml:lang="pt-br">Cláusula de subsídio de melhoria do inquilino</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Mieterverbesserungszulage</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">テナント改善手当条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">承租人装修津贴条款</skos:altLabel>
        <skos:definition>A Tenant Improvement Allowance Clause is a provision in a contract that specifies the amount of money a landlord will contribute towards the cost of improving a tenant&apos;s leased space.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Roek5y4wjsrQS7glQQpCuy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Roek5y4wjsrQS7glQQpCuy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E103 Word processing</rdfs:label>
        <skos:definition>The concept of E103 Word processing refers to the expense incurred for the use of software or services that allow for the creation, editing, and formatting of text documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RoekcnKsfxrjTlYTWXSIab -->

