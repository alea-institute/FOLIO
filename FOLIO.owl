    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUnNw8sfeBEjhgetMIP653">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
        <rdfs:label>Waiver of Subrogation Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation à la subrogation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia a la subrogación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a la subrogación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renúncia à sub-rogação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzicht auf Subrogationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waiver of Subrogation Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פטור מסברוגציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपस्थिति के अधिकार से वंचित करने की शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">代位放棄条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">放弃代位权条款</skos:altLabel>
        <skos:definition>A Waiver of Subrogation Clause is a provision in a contract where one party agrees to waive their right to seek reimbursement from another party&apos;s insurance company for damages covered by the insurance policy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUo8nSV4wEEjMST5pS8RTz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUo8nSV4wEEjMST5pS8RTz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8D6zCNSxUO8g0ZstLxnK28"/>
        <rdfs:label>Emphysema</rdfs:label>
        <skos:altLabel>Chronic Airspace Disease</skos:altLabel>
        <skos:altLabel>Pulmonary Emphysema</skos:altLabel>
        <skos:definition>Emphysema is a chronic respiratory condition characterized by the progressive destruction of the alveoli (air sacs) in the lungs, leading to reduced gas exchange and difficulty in breathing. This destruction results in the enlargement of the air spaces and loss of elastic tissue, causing symptoms such as shortness of breath, chronic cough, and wheezing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBUrLeB41YB8Kf0vx0ndhWj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBUrLeB41YB8Kf0vx0ndhWj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zijLH2GH0SxOhIdzeDOs3"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9ABG3dfhVDQUvRmg24IImI"/>
            </owl:Restriction>
