        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
        <rdfs:label>Confidential Informant Privilege</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Privilège de confidentialité des informateurs</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Privilégio de Informante Confidencial</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertraulichkeitsprivileg für Informanten</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保密线人特权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">機密情報提供者特権</skos:altLabel>
        <skos:definition>The Confidential Informant Privilege is a legal protection that allows individuals who provide information to law enforcement agencies to remain anonymous and keep their identities confidential.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Yea2Gt9pMvk7i9XaHT66f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Yea2Gt9pMvk7i9XaHT66f">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCQuYZJ8DVirpE9BFiYBoC4"/>
        <rdfs:label>Other Than Honorable Discharge</rdfs:label>
        <skos:altLabel>OTH</skos:altLabel>
        <skos:definition>An Other Than Honorable Discharge typically results from a pattern of behavior that falls below the military&apos;s accepted standards but is not severe enough to warrant a dishonorable discharge. It may disqualify the individual from receiving certain veteran benefits.</skos:definition>
    </owl:Class>
    


