    <owl:Class rdf:about="https://folio.openlegalstandard.org/RHUIfd8WQSMckRB0AAypAX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Monthly Retainer Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de retenue mensuelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Retenedor Mensual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Retenedor Mensual</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Retenção Mensal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur monatlichen Pauschale</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Monthly Retainer Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף רטיינר חודשי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मासिक रिटेनर क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">月保留条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">月額保証条項</skos:altLabel>
        <skos:definition>A Monthly Retainer Clause is a provision in a contract that requires one party to pay a fixed amount of money to the other party on a monthly basis in exchange for services or goods provided.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHVF9rBHDyMHmpGYQyjAUu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RHVF9rBHDyMHmpGYQyjAUu">
