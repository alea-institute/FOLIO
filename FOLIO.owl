        <skos:altLabel xml:lang="fr-fr">Clause de durée de l&apos;accord et de résiliation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Prazo e Rescisão do Acordo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Vereinbarungsdauer und Kündigung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Plazo del Acuerdo y Cláusula de Terminación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Plazo del Acuerdo y Cláusula de Terminación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Term of Agreement and Termination Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנאי תקופת ההסכם וסעיף הפירוק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समझौते की अवधि और समाप्ति धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">协议期限和终止条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約期間および終了条項</skos:altLabel>
        <skos:definition>A Term of Agreement and Termination Clause is a provision in a contract that outlines the conditions under which the agreement can be ended by either party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RvvvSrhxhsCCUkfpr6eyvp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvvvSrhxhsCCUkfpr6eyvp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRpJk0pctY0wgArzOcbc3q"/>
        <rdfs:label>Laryngitis</rdfs:label>
        <skos:definition>Laryngitis is an inflammation of the larynx (voice box), often causing hoarseness or loss of voice, and may be accompanied by throat pain and coughing. This condition can be acute, typically resulting from viral infections or vocal strain, or chronic, caused by persistent irritation from factors such as smoking, GERD, or prolonged vocal overuse.</skos:definition>
    </owl:Class>
    


