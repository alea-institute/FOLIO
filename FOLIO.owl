        <skos:altLabel xml:lang="fr-fr">Ensemble de règles pilotes</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Pilot-Regelsatz</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パイロットルールセット</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">试点规则集</skos:altLabel>
        <skos:definition>A Pilot Ruleset is a specific type of legal rule that is used for testing or experimental purposes before being fully implemented.</skos:definition>
