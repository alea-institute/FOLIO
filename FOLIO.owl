        </rdfs:subClassOf>
        <rdfs:label>Nursing Home Liability</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftung von Pflegeheimen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nursing Home Liability</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad de la casa de reposo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad de la residencia de ancianos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade de casas de repouso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité des maisons de retraite</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות בית אבות ובתי חולים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नर्सिंग होम दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">介護施設の責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">养老院责任</skos:altLabel>
        <skos:definition>Nursing Home Liability refers to the legal responsibility of a nursing home for any harm caused to its residents due to negligence or misconduct, specifically in cases where the nursing home is managed by a third-party entity.</skos:definition>
    </owl:Class>
    


