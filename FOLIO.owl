        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RZEqJK4a9m78r45Opn703C"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Unlawful Detainer</rdfs:label>
        <skos:altLabel xml:lang="es-es">Desahucio ilegal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Desalojo ilegal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unlawful Detainer</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">detenção ilegal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">détention illégale</skos:altLabel>
        <skos:altLabel xml:lang="de-de">unbefugtes Festhalten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת מניעה חוקית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवैध रोकथाम</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不法拘束</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法拘留</skos:altLabel>
        <skos:definition>An unlawful detainer is a summary proceeding for a landlord to recover possession of a leased premises from a tenant wrongfully withholding or &quot;detaining&quot; the property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wO0KkQsV21vmDQgWAbdjc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9wO0KkQsV21vmDQgWAbdjc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <rdfs:label>Cancer of Unknown Primary Site</rdfs:label>
        <skos:altLabel>Cancer of Unknown Primary Origin</skos:altLabel>
        <skos:altLabel>Malignancy of Unknown Origin</skos:altLabel>
        <skos:definition>Cancer where the primary site is unknown after appropriate search refers to a malignant neoplasm for which the origin remains unidentified despite comprehensive diagnostic testing. This condition, also known as carcinoma of unknown primary (CUP), requires tailored treatment approaches due to the uncertainty of its origin and may involve symptoms affecting various organs or systems.</skos:definition>
        <skos:prefLabel>Carcinoma of Unknown Primary</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wOozhrGHQP0kgC7KaCx6O -->

