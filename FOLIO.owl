        <rdfs:label>East of the River Shawnee</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo">
