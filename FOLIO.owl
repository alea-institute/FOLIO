        <skos:altLabel xml:lang="en-gb">Motion for Summary Adjudication</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Julgamento Sumário</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפסק דין סיכום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सारांश न्यायिक निर्णय के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">略式判決の申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">裁定摘要动议</skos:altLabel>
        <skos:definition>A Motion for Summary Adjudication is a legal request made by a party in a bankruptcy or civil case, asking the court to rule in their favor without a trial, based on the evidence presented in the motion.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9wUQCNfdSnHyqxrNwDFp1t -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9wUQCNfdSnHyqxrNwDFp1t">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8YpJBaF5zesoc0jtaNESdQ"/>
        <rdfs:label>Binding Precedent</rdfs:label>
        <skos:altLabel>Compulsory Precedent</skos:altLabel>
        <skos:definition>Binding Precedent is a legal principle established in a previous case that must be followed by all lower courts in the same jurisdiction when deciding subsequent cases with similar facts or legal issues. It is a fundamental aspect of common law legal systems and ensures consistency and predictability in the application of law.</skos:definition>
        <skos:prefLabel>Mandatory Authority</skos:prefLabel>
    </owl:Class>
    


