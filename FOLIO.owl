        <dc:identifier>US-FD-DOL-MSHA</dc:identifier>
        <rdfs:label>Mine Safety and Health Administration</rdfs:label>
        <skos:altLabel xml:lang="es-es">Administración de Seguridad y Salud en Minas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Administración de Seguridad y Salud en Minas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Administration de la sécurité et de la santé des mines</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Administração de Segurança e Saúde em Minas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bergbau-Sicherheits- und Gesundheitsverwaltung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mine Safety and Health Administration</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מנהלת בטיחות ובריאות במכרסמים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">माइन सुरक्षा और स्वास्थ्य प्रशासन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">矿业安全与健康管理局</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">鉱山安全衛生管理局</skos:altLabel>
        <skos:definition>The Mine Safety and Health Administration (MSHA) is an agency of the United States Department of Labor which administers the provisions of the Federal Mine Safety and Health Act of 1977 (Mine Act) to enforce compliance with mandatory safety and health standards as a means to eliminate fatal accidents, to reduce the frequency and severity of nonfatal accidents, to minimize health hazards, and to promote improved safety and health conditions in the nation&apos;s mines.</skos:definition>
        <skos:hiddenLabel>MSHA</skos:hiddenLabel>
        <skos:prefLabel>Mine Safety and Health Administration</skos:prefLabel>
    </owl:Class>
    


