    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC7lPEWMGP3nYZ7PhzT6nbD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMZqt2BD3qRRYlj61ssnIZ"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Closed_list"/>
        <rdfs:label>Party-List Proportional Representation System - Closed List</rdfs:label>
        <skos:definition>A Closed List Party-List Proportional Representation System is an electoral method where voters cast their ballots for a party, and the party determines the order of candidates on its list. Seats are allocated to each party based on the proportion of votes received, and candidates are selected in the predetermined order.</skos:definition>
        <skos:example>National Closed List: Spain&apos;s Congreso de los Diputados elections</skos:example>
        <skos:example>Regional Closed List: South Africa&apos;s National Assembly elections</skos:example>
        <skos:prefLabel>Party-Determined List System</skos:prefLabel>
    </owl:Class>
    


