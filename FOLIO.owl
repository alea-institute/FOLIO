        <rdfs:label>Erzya</rdfs:label>
        <skos:altLabel xml:lang="de-de">Erzya</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Erzya</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Erzya</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エルジャ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">厄尔兹亚语</skos:altLabel>
        <skos:definition>Erzya is a Finno-Ugric language spoken by the Erzya people in Russia and is a subcategory of the Language class in the ontology.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiQHdRDZfaAIOlPy9vfwB8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiQHdRDZfaAIOlPy9vfwB8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RdfKnWpXsG2eBmnS3oJNTF"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R73DJPQnmrqO90OL7OBDZJU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bid</rdfs:label>
        <skos:altLabel>Offer</skos:altLabel>
        <skos:altLabel>Proposal</skos:altLabel>
        <skos:altLabel>Tender</skos:altLabel>
        <skos:definition>A Bid refers to a formal offer submitted by an individual or entity to undertake a specific project or provide certain goods or services at a stated price, often in response to an invitation to bid or request for proposal. This process is commonly used in public and private sector procurement to ensure competitive and fair selection of contractors or suppliers.</skos:definition>
        <skos:prefLabel>Procurement Proposal</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RiQa4qRzRTL1GMHsHETrbd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RiQa4qRzRTL1GMHsHETrbd">
