            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Court Appointed</rdfs:label>
        <skos:definition>&quot;Court-appointed&quot; refers to an attribute where a judge selects and assigns an Actor (e.g., attorney, expert, professional), often to an individual who cannot afford legal representation. These appointments are often made in criminal cases or civil matters involving indigent parties to ensure access to legal counsel.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9WRFGVqE913fnyJVUGR8Xg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9WRFGVqE913fnyJVUGR8Xg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70EVLsDqbyH67OcMFU5d1p"/>
        <rdfs:label>Cereal Crops</rdfs:label>
        <skos:altLabel>Grains</skos:altLabel>
        <skos:definition>Cereal Crops are a category of cultivated grasses grown primarily for their edible grains or seeds, which are staple foods for a significant portion of the global population. These crops provide essential carbohydrates, proteins, and other nutrients, forming the basis of many diets and playing a vital role in food security and agriculture.</skos:definition>
        <skos:prefLabel>Grain Crops</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9WS9J0VaRUh2M0PNSt5CE0 -->

