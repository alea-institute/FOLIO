        <rdfs:label>Makasar</rdfs:label>
        <skos:altLabel xml:lang="de-de">Makassar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Makassar</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Makassar</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">マカッサル</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">望加锡</skos:altLabel>
        <skos:definition>Makasar is a language that belongs to the Austronesian language family and is primarily spoken in the South Sulawesi province of Indonesia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RLS5ckaqGABRJiaZXihz9W -->

