        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9GEy8ufSRnWtGcuIbYIULS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tax_point_date</rdfs:label>
        <skos:definition>&quot;The tax point is generally the invoice date.  In instances where the tax point date is different from the invoice date, the tax point date indicates the financial period in which the tax applies.  
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8OEfInNABpFtfoUyqegn9p -->

