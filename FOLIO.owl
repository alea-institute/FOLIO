    <!-- https://folio.openlegalstandard.org/RyEzP1KUrLaS4mGjIh4Tgh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RyEzP1KUrLaS4mGjIh4Tgh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HYiwtnrCegkpzpKHbJSRW"/>
        <rdfs:label>Estate and Inheritance Tax Payment</rdfs:label>
        <skos:altLabel>Death Tax Payment</skos:altLabel>
        <skos:altLabel>Estate Duty Settlement</skos:altLabel>
        <skos:altLabel>Inheritance Duty Remittance</skos:altLabel>
        <skos:altLabel>Succession Tax Payment</skos:altLabel>
        <skos:definition>Estate and Inheritance Tax Payment refers to the settlement of taxes levied on the transfer of assets from a deceased person&apos;s estate to their beneficiaries. Estate tax is usually paid by the estate itself before distribution, while inheritance tax is usually paid by the recipients of the estate assets based on the value they receive.</skos:definition>
    </owl:Class>
    


