        <skos:altLabel xml:lang="es-mx">Denuncia juramentada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Eidesstattliche Beschwerde</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Plainte sous serment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Queixa Juramentada</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sworn Complaint</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תלונה נשבעת</skos:altLabel>
