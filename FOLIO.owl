    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/O2uxsJDHRoWW0VDtau7I3g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/O2uxsJDHRoWW0VDtau7I3g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/xD6MyKIjSTKFdr9q1ayrZw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=337910"/>
        <rdfs:label>Mattress Manufacturing</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in manufacturing innerspring, box spring, and noninnerspring mattresses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/OA1Hry17Tq6KcLnb-iJafw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/OA1Hry17Tq6KcLnb-iJafw">
