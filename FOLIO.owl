        <rdfs:label>Prime Brokerage Agreement</rdfs:label>
        <skos:altLabel>Prime Brokerage Services Agreement</skos:altLabel>
        <skos:definition>A Prime Brokerage Agreement is a contract between a prime brokerage firm and a client, usually a large institutional investor such as a hedge fund, wherein the firm agrees to provide a range of services. These services often include securities lending, leveraged trade execution, cash management, and custodial services, tailored to support the client&apos;s investment operations and risk management strategies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDc9DVnOHM4a1xADu1lh9lz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDc9DVnOHM4a1xADu1lh9lz">
