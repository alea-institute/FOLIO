    <!-- https://folio.openlegalstandard.org/R46972a4D65c352Cf7eC275f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R46972a4D65c352Cf7eC275f">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R15Bf89EBBcdd05Ca4462a0b"/>
        <dc:identifier>US-FD-DOL-DOLARB</dc:identifier>
        <rdfs:label>DOL Administrative Review Board</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Conseil de révision administrative du Département américain du travail</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Conselho de Revisão Administrativa do Departamento de Trabalho dos EUA</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">DOL Administrative Review Board</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Junta de Revisión Administrativa del DOL</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Junta de Revisión Administrativa del DOL</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verwaltungsrat für Arbeitsrechtliche Angelegenheiten des US-amerikanischen Arbeitsministeriums</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ועדת ערעורים מנהלית של משרד העבודה של ארצות הברית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डीओएल प्रशासनिक समीक्षा बोर्ड</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">米国労働省行政審査委員会</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">美国劳工部行政复议委员会</skos:altLabel>
        <skos:definition>The Administrative Review Board issues final agency decisions for the Secretary of Labor in cases arising under a wide range of worker protection laws, primarily involving environmental, transportation, and securities whistleblower protection; H-1B immigration provisions; child labor; employment discrimination; job training; seasonal and migrant workers; and federal construction and service contracts.</skos:definition>
        <skos:hiddenLabel>DOLARB</skos:hiddenLabel>
        <skos:prefLabel>Department of Labor Administrative Review Board</skos:prefLabel>
    </owl:Class>
    


