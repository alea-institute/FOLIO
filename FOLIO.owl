        <rdfs:label>Pennsylvania Magisterial District Court - Chester County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Chester County is a specific court within the Pennsylvania Magisterial District Court system that handles minor criminal offenses, traffic violations, and civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RD1gM37TNzqcVTb6DLOlF8j -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RD1gM37TNzqcVTb6DLOlF8j">
