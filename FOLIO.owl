    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Ljvt9iz93S74Ug74kynw8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Ljvt9iz93S74Ug74kynw8">
