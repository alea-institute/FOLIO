        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561622"/>
        <rdfs:label>Locksmiths</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) selling mechanical or electronic locking devices, safes, and security vaults, along with installation, repair, rebuilding, or adjusting services or (2) installing, repairing, rebuilding, and adjusting mechanical or electronic locking devices, safes, and security vaults.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/xcK989Y3QB6kHwRG4uDYBw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/xcK989Y3QB6kHwRG4uDYBw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/SGahJEz_Tfqwxxi7eSpqlA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=221115"/>
        <rdfs:label>Wind Electric Power Generation</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in operating wind electric power generation facilities. These facilities use wind power to drive a turbine and produce electric energy. The electric energy produced in these establishments is provided to electric power transmission systems or to electric power distribution systems.</skos:definition>
    </owl:Class>
    


