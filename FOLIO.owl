    <!-- https://folio.openlegalstandard.org/RCTZcVDmicdOgwzJEomIiH4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTZcVDmicdOgwzJEomIiH4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Reservation of Rights Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de réserve de droits</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Reserva de Derechos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Reserva de Derechos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de reserva de direitos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reservation of Rights Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorbehalt der Rechte Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שמירת זכויות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधिकार आरक्षण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">权利保留条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">権利留保条項</skos:altLabel>
        <skos:definition>A Reservation of Rights Clause is a provision in a contract that allows a party to retain certain rights or defenses even after entering into the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCThJJxvpYzIQdmsefCOhNO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCThJJxvpYzIQdmsefCOhNO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ"/>
        <rdfs:label>Articulation Disorder</rdfs:label>
        <skos:altLabel>Phonetic Disorder</skos:altLabel>
        <skos:altLabel>Pronunciation Disorder</skos:altLabel>
        <skos:altLabel>Speech Sound Disorder</skos:altLabel>
        <skos:definition>An Articulation Disorder is a speech disorder characterized by difficulties in correctly producing speech sounds, leading to mispronunciations that can affect intelligibility. This condition can result from various factors, including developmental delays, structural anomalies, neurological impairments, or hearing loss.</skos:definition>
        <skos:example>Phonetic articulation disorder, where a child consistently substitutes one sound for another, such as saying &quot;wabbit&quot; instead of &quot;rabbit,&quot; due to difficulty in producing the correct sound.</skos:example>
        <skos:prefLabel>Speech Articulation Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTi5ncHpG7fN8DcDwgfMwN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTi5ncHpG7fN8DcDwgfMwN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R519e1c1BE7657EB2eeDDfb5"/>
        <rdfs:label>New Jersey Special Statutory Court</rdfs:label>
        <skos:definition>A New Jersey Special Statutory Court is a specialized court within the New Jersey State Courts system that is created by statute to handle specific types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTiU3W5CpVCeWnO9Enu73A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTiU3W5CpVCeWnO9Enu73A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8DuEmmnbcptnIZhPdF2Tvx"/>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Fee Increase or Decrease</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Augmentation ou diminution des frais</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Aumento o disminución de tarifas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aumento o disminución de tarifas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aumento ou redução de taxas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Fee Increase or Decrease</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebührenerhöhung oder -senkung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגברת או הפחתת עמלות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शुल्क वृद्धि या कमी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">料金の増減</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">费用增加或减少</skos:altLabel>
        <skos:definition>A Fee Increase or Decrease is a type of discount or credit that modifies the original cost of legal services provided, resulting in either an increase or decrease in the overall fee charged.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTmoU2BbiIxrDeGj7ql4Ge -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTmoU2BbiIxrDeGj7ql4Ge">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Walton County</rdfs:label>
        <skos:definition>Georgia Superior Court - Walton County: A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Walton County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTnebwmInNgHYwFLgAOf0z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTnebwmInNgHYwFLgAOf0z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1FD6ezZdf7ZABmyDWmeg7"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R981K5l1Ju5uHj4jVRSUCJQ"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Employment Record</rdfs:label>
        <skos:definition>An &quot;Employment Record&quot; is a structured historical record that documents an individual&apos;s employment-related information, including details about their work history, positions held, employers, dates of employment, and relevant achievements.</skos:definition>
        <skos:prefLabel>Work Record</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTshAosx8ku4YGMpA0UXzA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTshAosx8ku4YGMpA0UXzA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Current Policy Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Aktuelle Richtlinienklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de politique actuelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Política Actual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Política Actual</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de política atual</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Current Policy Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מדיניות נוכחי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वर्तमान नीति शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">当前政策条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現行のポリシー条項</skos:altLabel>
        <skos:definition>A current policy clause is a provision in a contract that requires the parties to comply with the most up-to-date policies and regulations related to the subject matter of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTyWuwAAdk4X3BrHs0kara -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTyWuwAAdk4X3BrHs0kara">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Akkadian</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Acádio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Akkadien</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Akkadisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アッカド語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿卡德语</skos:altLabel>
        <skos:definition>Akkadian is an ancient language used in Mesopotamia, characterized by its cuneiform script and grammar, and is considered a predecessor to modern-day Semitic languages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTynzAwJhrTUyUakE3LRhm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTynzAwJhrTUyUakE3LRhm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKXEdlGEMzeuinxEdRGBF5"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Consideration - Real Estate Assets</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Consideration - Real Estate Assets</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Contraprestación - Activos Inmobiliarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Contraprestación - Activos Inmobiliarios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Contraprestação - Ativos imobiliários</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Contrepartie - Actifs immobiliers</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenleistung - Immobilienvermögen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תמורה - נכסי נדלן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विचार - रियल एस्टेट संपत्ति</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">对价 - 房地产资产</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">対価 - 不動産資産</skos:altLabel>
        <skos:definition>Consideration of real estate assets refer to the land, buildings, and other property-related resources that are transferred from the one party to another as part of the deal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCTzTfQ8g3oId4ykzTyYH3b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCTzTfQ8g3oId4ykzTyYH3b">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8LxIR1bsgFd3td2G24G3mq"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnmmbswQcOryRPEoDnHIbC"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/10.00-MultipleBody-Adult.htm"/>
        <rdfs:label>Fetal Alcohol Syndrome</rdfs:label>
        <skos:altLabel>Alcohol-Induced Birth Defects</skos:altLabel>
        <skos:altLabel>Alcohol-Related Birth Defects</skos:altLabel>
        <skos:altLabel>Alcohol-Related Neurodevelopmental Disorder (ARND)</skos:altLabel>
        <skos:altLabel>FAS</skos:altLabel>
        <skos:definition>Fetal Alcohol Syndrome (FAS) is a severe form of Fetal Alcohol Spectrum Disorders (FASD) resulting from prenatal alcohol exposure. It is characterized by growth deficiencies, distinctive facial anomalies, and central nervous system dysfunction, leading to intellectual disabilities, behavioral problems, and learning difficulties.</skos:definition>
        <skos:prefLabel>Prenatal Alcohol Syndrome</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU0BYJMl0DPrYYohwA8Uto -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU0BYJMl0DPrYYohwA8Uto">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
        <rdfs:label>Perpetual Asset</rdfs:label>
        <skos:altLabel>Indefinite Duration Asset</skos:altLabel>
        <skos:altLabel>No Maturity Asset</skos:altLabel>
        <skos:altLabel>Perpetual Instrument</skos:altLabel>
        <skos:altLabel>Perpetual Security</skos:altLabel>
        <skos:definition>A Perpetual Asset is a financial instrument that does not have a fixed maturity date, allowing it to exist indefinitely without a predetermined end. This attribute is common in certain types of equity and debt instruments, providing ongoing returns or obligations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU0diyqr2PcjtNSiEvCzRN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU0diyqr2PcjtNSiEvCzRN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8MRtBMmrg5epp6WfJx4lSW"/>
        <rdfs:label>Smart Contracts Management</rdfs:label>
        <skos:definition>Smart Contracts Management refers to the process of overseeing and administering the creation, execution, and enforcement of digital contracts that are self-executing and self-enforcing, utilizing blockchain technology and computer code to automate the performance of contractual obligations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU0vhYMGrdY9EsjmN2mkqQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU0vhYMGrdY9EsjmN2mkqQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
        <rdfs:label>Data Leakage</rdfs:label>
        <skos:altLabel>Data Contamination</skos:altLabel>
        <skos:altLabel>Model Contamination</skos:altLabel>
        <skos:altLabel>Unintended Data Inclusion</skos:altLabel>
        <skos:definition>In the context of AI, data leakage refers to the introduction of information into the training data that the system is expected to infer but should not legitimately have access to during model training. This results in a model that appears to perform well during evaluation on the test set but demonstrates poor performance during deployment when evaluated on new data sets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU1FrfEgIGJ9hxZXDbeSRh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU1FrfEgIGJ9hxZXDbeSRh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Gbaya</rdfs:label>
        <skos:altLabel xml:lang="de-de">Gbaya</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Gbaya</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Gbaya</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Gbaya</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Gbaya</skos:altLabel>
        <skos:definition>Gbaya is a structured system of communication that consists of grammar and vocabulary, and is a specific language within the context of legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU2QNIenbG6BiZ0IcYmSHr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU2QNIenbG6BiZ0IcYmSHr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Allow Payment Arrearages</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Genehmigung von Zahlungsrückständen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para permitir atrasos en el pago</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para permitir atrasos en el pago</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour autoriser les arriérés de paiement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Allow Payment Arrearages</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de autorização para pagamento de atrasos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת תנועה לאפשר ארנונות תשלום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भुगतान अधिग्रहण की अनुमति देने के लिए चलान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">允许支付欠款动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">支払いの滞納を許可する動議</skos:altLabel>
        <skos:definition>A Motion to Allow Payment Arrearages is a request made in a bankruptcy case to permit the debtor to pay off missed payments over time, rather than in a lump sum.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU6ReSCEN31kllOAIaq5Ut -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU6ReSCEN31kllOAIaq5Ut">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RiYwKEna4NZ311TVYJ2yCj"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RX4IL0dBTdT6NybOqieEPR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Overtime Pay</rdfs:label>
        <skos:definition>Overtime pay refers to the additional compensation provided to employees who work hours in excess of what is considered standard or regular for a given period, typically a workweek. The rate for overtime pay is often higher than the employee&apos;s regular hourly wage, commonly set at one and a half times the standard rate or more, depending on labor laws and employment contracts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU6cL02zgQvulp4Vx8Q0Hc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU6cL02zgQvulp4Vx8Q0Hc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Preparer</rdfs:label>
        <skos:definition>A Preparer is an individual or entity responsible for completing and submitting documentation on behalf of someone else, typically for a specific legal or financial process. Examples include immigration preparers, who assist with immigration paperwork, and bankruptcy preparers, who help file bankruptcy documents, although their roles may be limited by law in providing legal advice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCU7t1b9rWuUjGuFf81VQOE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCU7t1b9rWuUjGuFf81VQOE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGm7jrTspmRi606c5XWZ1z"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9Q9CszYRTjTgwQ8JRqVZ0x"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Insurance Broker Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle de courtier en assurance</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Insurance Broker Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia profesional del corredor de seguros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia profesional del corredor de seguros</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência de corretor de seguros</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Versicherungsmakler-Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאת מקצוע של סוכן ביטוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बीमा ब्रोकर लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保险经纪人过失</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保険ブローカーの過失</skos:altLabel>
        <skos:definition>Insurance Broker Malpractice refers to a type of malpractice claim that arises from the actions or omissions of an insurance broker in the course of providing insurance services to a client.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUAcLSyxeRKsnkjTydl6sM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUAcLSyxeRKsnkjTydl6sM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rx69EnEj3H3TpcgTfUSoYx"/>
        <rdfs:label>Engagement Service Status</rdfs:label>
        <skos:altLabel>Legal Service Status</skos:altLabel>
        <skos:altLabel>Matter Status</skos:altLabel>
        <skos:altLabel>Service Status</skos:altLabel>
        <skos:definition>The Service Status concept refers to the current state or condition of a particular legal service, such as whether it is open, closed/ended, or canceled.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUEkyjCqG7yCPQB6OZopyD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUEkyjCqG7yCPQB6OZopyD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Necessary and Proper Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf die notwendige und angemessene Klausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Necessary and Proper Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Necesario y Adecuado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Necesario y Adecuado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula Necessária e Adequada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la clause nécessaire et appropriée</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף הנחוץ והמתאים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आवश्यक और उपयुक्त धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">必要かつ適切な条項の主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">必要和适当条款要求</skos:altLabel>
        <skos:definition>A Necessary &amp; Proper Clause claim is a legal argument asserting that a particular law or action exceeds the authority granted to Congress by the Necessary and Proper Clause of the United States Constitution. This claim is based on the interpretation that the Necessary and Proper Clause empowers Congress to pass laws that are necessary and proper for carrying out its enumerated powers, and that any law or action must be directly linked to an enumerated power in order to be constitutionally valid.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUIB6wyjoiIrYc2gTKCbtn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUIB6wyjoiIrYc2gTKCbtn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Turner County</rdfs:label>
        <skos:definition>Georgia Superior Court - Turner County refers to a specific court within the Georgia Superior Court system that has jurisdiction over legal matters in Turner County, Georgia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUIlUpsVsyQs46CyHTJLMq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUIlUpsVsyQs46CyHTJLMq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDVdjLF5bcB64xE1k3fVCV1"/>
        <rdfs:label>Local Ruleset</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Conjunto de regras locais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ensemble de règles locales</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lokaler Regelungssatz</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ローカルルールセット</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">本地规则集</skos:altLabel>
        <skos:definition>A Local Ruleset is a specific set of rules that govern a particular jurisdiction or court, typically created by the court itself or a local governing body.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUKwheT0x2k2ltyleh5jT1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUKwheT0x2k2ltyleh5jT1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  Philadelphia County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - Philadelphia County is a specific court within the Pennsylvania Court of Common Pleas system that has jurisdiction over civil and criminal cases within Philadelphia County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUP1bJBitIbJFQ1SXl2Zai -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUP1bJBitIbJFQ1SXl2Zai">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBpPod3eNjfLujqcKrmjwq9"/>
        <rdfs:label>Input VAT Payment</rdfs:label>
        <skos:altLabel>Input Tax Deduction</skos:altLabel>
        <skos:altLabel>Purchase VAT Remittance</skos:altLabel>
        <skos:definition>Input VAT Payment refers to the Value Added Tax paid on purchases of goods and services that a business can reclaim or offset against the VAT collected on sales. This mechanism ensures that VAT is ultimately paid only on the value added at each stage of production.</skos:definition>
        <skos:prefLabel>Recoverable VAT</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUPRwxWXJ35yaRIp8mP8Sh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUPRwxWXJ35yaRIp8mP8Sh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xqVevh0JKSwX977TRIZQV"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8x0u39yCNHqlqk08vu3PPb"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCAIUgUHLdwFdtdPTruyEgL"/>
        <rdfs:label>Convertible Note</rdfs:label>
        <skos:altLabel>Convertible Debt</skos:altLabel>
        <skos:definition>A Convertible Note is a form of short-term debt that converts into equity, usually in conjunction with a future financing round. The investor lends money to a startup and instead of getting the money back with interest, the investor receives equity in the company. Each convertible note is usually an unsecured, short-term debt instrument that converts into equity — typically preferred shares — under specified conditions, such as a future funding round. The conversion to equity can be mandatory in some conditions or elective in others.</skos:definition>
        <skos:prefLabel>Convertible Loan</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCURuJy4wKMhRt77swaJ4j0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCURuJy4wKMhRt77swaJ4j0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Duwamish</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUSvXaOqGr627CnjhRYKQu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUSvXaOqGr627CnjhRYKQu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrctN8FUd3Tj5gi4DWHTZx"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Cash Public Benefit</rdfs:label>
        <skos:definition>Cash public benefit refers to government programs that provide direct financial assistance to individuals or families who meet certain eligibility criteria, such as income level or employment status. These cash benefits, which can include unemployment compensation, welfare payments, or emergency relief funds, are intended to help recipients meet basic living expenses like housing, utilities, and food.</skos:definition>
        <skos:prefLabel>Welfare Benefit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUXIdFpIxrgm2u6Xlk9ywc -->

