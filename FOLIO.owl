        <rdfs:label>Heterosexual</rdfs:label>
        <skos:definition>Heterosexual refers to a sexual orientation in which an individual is attracted to members of the opposite sex. It is often considered the societal norm, although it is just one of many sexual orientations.</skos:definition>
        <skos:prefLabel>Straight</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBpfS0CtCgihBKnNguxJ9W0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBpfS0CtCgihBKnNguxJ9W0">
