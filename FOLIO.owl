        <skos:altLabel xml:lang="en-gb">Proprietary Agreement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הסכם בעלות פרטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रोप्राइटरी समझौता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专有协议条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占契約条項</skos:altLabel>
        <skos:definition>A Proprietary Agreement Clause is a provision in a contract that restricts the use or disclosure of confidential information by one party to the other party, typically in the context of a business relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8CRocu4czjQ5mseqDWSeWC -->

