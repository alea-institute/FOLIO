        <skos:altLabel xml:lang="ja-jp">計画の確認に対する異議</skos:altLabel>
        <skos:definition>An Objection to Confirmation of the Plan is a formal statement made by a party in a bankruptcy case, expressing opposition to the approval of a proposed plan for reorganization or liquidation of the debtor&apos;s assets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8bEuMqtr7n0BYQL4AzJaNK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8bEuMqtr7n0BYQL4AzJaNK">
