        <dc:identifier>US-FD-FTC-BCP</dc:identifier>
        <rdfs:label>Bureau of Consumer Protection</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Bureau de la protection des consommateurs</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bureau of Consumer Protection</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro für Verbraucherschutz</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Departamento de Proteção ao Consumidor</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Protección al Consumidor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina de Protección al Consumidor</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משרד הגנת הצרכן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपभोक्ता संरक्षण ब्यूरो</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">消費者保護局</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">消费者保护局</skos:altLabel>
        <skos:definition>The Bureau of Consumer Protection&apos;s mandate is to protect consumers against unfair or deceptive acts or practices in commerce. With the written consent of the Commission, Bureau attorneys enforce federal laws related to consumer affairs and rules promulgated by the Federal Trade Commission.</skos:definition>
        <skos:hiddenLabel>BCP</skos:hiddenLabel>
        <skos:prefLabel>Bureau of Consumer Protection</skos:prefLabel>
    </owl:Class>
    


