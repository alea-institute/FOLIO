        <rdfs:label>Kasigluk Traditional Elders Council</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ictcp1iwOnYdrf1bxOTVA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ictcp1iwOnYdrf1bxOTVA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7zvYKadqTXgMZV8ghLsloR"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXx1zuWf6YAl8qcKgzeMai"/>
        <rdfs:label>Application</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anwendung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Aplicación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aplicación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aplicativo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Application</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Application</skos:altLabel>
        <skos:altLabel xml:lang="he-il">יישום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एप्लिकेशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アプリケーション</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">应用程序</skos:altLabel>
        <skos:definition>In the context of litigation, an Application refers to a formal request or motion submitted to a court or judicial body, seeking a specific order, relief, or direction as part of legal proceedings. This procedural instrument is fundamental in advocating for a party&apos;s interests, setting the stage for judicial review and decision-making.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Idcfy3k3uRwC4XohbcMAg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Idcfy3k3uRwC4XohbcMAg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RrwKWn7PQLCSscgstTNLqf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7PPywVywQYcT4GloerUeuh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCIcMbQuMKCvFPcrqmuH7DY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Evidentiary Objection</rdfs:label>
        <skos:altLabel>Admissibility challenge</skos:altLabel>
        <skos:definition>An evidentiary objection is a formal protest raised by a party in a legal proceeding, challenging the admissibility of specific evidence. Common grounds for such objections include lack of foundation, hearsay, irrelevance, and prejudicial nature.</skos:definition>
        <skos:prefLabel>Evidence Challenge</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IfEJ1qwXzk6iw5gd9sUn6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9IfEJ1qwXzk6iw5gd9sUn6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7oBWHStfmqTLn2MypkW3Pj"/>
        <rdfs:label>Trade Association</rdfs:label>
        <skos:altLabel>Business Association</skos:altLabel>
        <skos:altLabel>Industry Association</skos:altLabel>
        <skos:altLabel>Industry Group</skos:altLabel>
        <skos:altLabel>Trade Organization</skos:altLabel>
        <skos:definition>A trade association is an organization founded and funded by businesses that operate in a specific industry. These associations advocate for the interests of their members, provide industry standards, and offer networking opportunities.</skos:definition>
        <skos:example>American Medical Association</skos:example>
        <skos:example>Automotive Trade Association</skos:example>
        <skos:example>Healthcare Trade Association</skos:example>
        <skos:example>International Air Transport Association (IATA)</skos:example>
        <skos:example>National Association of Manufacturers (NAM)</skos:example>
        <skos:example>Retail Trade Association</skos:example>
        <skos:example>Technology Trade Association</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ih5zyGAU2AsCpVmsB7pN5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ih5zyGAU2AsCpVmsB7pN5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
        <rdfs:label>Credit Risk</rdfs:label>
        <skos:definition>The risk that a borrower will not repay a loan or that a counterparty will not meet its financial obligations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ">
