        <rdfs:label>Interference with Economic Relations</rdfs:label>
        <skos:altLabel>Interference with Business Relationship</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interference with Economic Relations</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Interferencia con las Relaciones Económicas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interferencia con las Relaciones Económicas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interferência nas relações econômicas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Störung von Wirtschaftsbeziehungen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Trouble des relations économiques</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרעה בקשרי כלכליים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आर्थिक संबंधों में हस्तक्षेप</skos:altLabel>
