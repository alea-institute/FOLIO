        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/10.00-MultipleBody-Adult.htm"/>
        <rdfs:label>Trisomy X Syndrome</rdfs:label>
        <skos:altLabel>Trisomy X</skos:altLabel>
        <skos:definition>Trisomy X Syndrome, also known as XXX Syndrome, is a genetic condition where a female has three X chromosomes instead of the usual two. This extra chromosome affects development and can lead to a range of physical, cognitive, and behavioral symptoms.</skos:definition>
        <skos:prefLabel>XXX Syndrome</skos:prefLabel>
    </owl:Class>
    


