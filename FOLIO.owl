        <skos:definition>New York Town Court is a court of limited jurisdiction within the New York State Courts system that handles minor civil and criminal matters at the local level.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R3pDZshEsgzcL5fOhCMpBy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R3pDZshEsgzcL5fOhCMpBy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBi5nYq1khAzzGeY5YZ10ya"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7dcZJLuYutSG7vbZRwstAC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCmAarh6Wj8m6lLe6lJJBmj"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Leave Eligibility Miscalculation Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Entschädigung bei fehlerhafter Berechnung der Urlaubsberechtigung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Leave Eligibility Miscalculation Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por cálculo erróneo de la elegibilidad de permisos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por cálculo erróneo de la elegibilidad de permisos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cálculo incorreto de elegibilidade de licença</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation pour calcul erroné de l&apos;éligibilité aux congés</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על טעות בחישוב זכאות לחופשה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">छुट्टी पात्रता गणना विवाद दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">休暇資格の誤計算請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">请假资格计算索赔</skos:altLabel>
        <skos:definition>A leave eligibility miscalculation claim is a legal action initiated by an employee against their employer for improperly calculating their eligibility for protected leave under applicable laws. These laws may include the Family and Medical Leave Act (FMLA), the California Family Rights Act (CFRA), or other state and local laws that provide protected leave for certain reasons, such as for the employee&apos;s own serious health condition, to care for a seriously ill family member, or for the birth or adoption of a child. The claim typically arises when an employer miscalculates an employee&apos;s eligibility for protected leave, which can result in the employee being denied leave or having their leave prematurely terminated.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R3uq0eVSfEpZbTNkX6Mzcc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R3uq0eVSfEpZbTNkX6Mzcc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds"/>
        <rdfs:label>Collaborative</rdfs:label>
        <skos:altLabel>Cooperative Bargaining</skos:altLabel>
        <skos:definition>Collaborative negotiation is a negotiation approach where parties work together cooperatively to find mutually beneficial solutions, emphasizing communication, trust, and problem-solving. This style focuses on creating value and fostering long-term relationships, often characterized by open dialogue and a willingness to understand and accommodate each party&apos;s interests.</skos:definition>
        <skos:prefLabel>Win-Win Negotiation</skos:prefLabel>
    </owl:Class>
    


