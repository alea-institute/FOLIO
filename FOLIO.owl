            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion to Extend Time to File Amendment</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung der Frist zur Einreichung einer Änderung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Ampliar el Plazo para Presentar una Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Ampliar el Plazo para Presentar una Enmienda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour prolonger le délai de dépôt d&apos;un amendement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Time to File Amendment</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de prorrogação do prazo para apresentação de emenda</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת הזמן להגשת תיקון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संशोधन फाइल करने के लिए समय बढ़ाने की मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">修正案提出期限延長の申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长提交修正案的时间动议</skos:altLabel>
        <skos:definition>A Motion to Extend Time to File Amendment is a request made to a trial court to allow additional time beyond the original deadline to file an amendment to a legal document.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ObFXssh9mBYuezsOzMwJd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ObFXssh9mBYuezsOzMwJd">
