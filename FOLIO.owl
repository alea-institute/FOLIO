        <rdfs:label>Minnesota District Court - Wabasha County</rdfs:label>
        <skos:definition>Minnesota District Court - Wabasha County: A specific court within the Minnesota District Court system located in Wabasha County, responsible for administering legal proceedings within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9iACm6sQxg0GsvpieU6StG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9iACm6sQxg0GsvpieU6StG">
