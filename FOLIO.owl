    <!-- https://folio.openlegalstandard.org/RBvkyGNXJdg8pV3aykCKOeN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBvkyGNXJdg8pV3aykCKOeN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBVCwr551O94R7T2y8aKsPS"/>
        <rdfs:label>Wealth Tax Payment</rdfs:label>
        <skos:altLabel>Asset-Based Tax Payment</skos:altLabel>
        <skos:altLabel>Capital Tax Payment</skos:altLabel>
        <skos:altLabel>Recurrent Taxes on Net Wealth</skos:altLabel>
        <skos:altLabel>Wealth Levy</skos:altLabel>
        <skos:altLabel>Wealth Taxation</skos:altLabel>
        <skos:definition>Taxes levied regularly (in most cases annually) on net wealth, i.e. taxes on a wide range of movable and immovable property, net of debt. It is sub-divided into taxes paid by individuals, and taxes paid by corporate enterprises, according to the criteria set out in §31(a) above. If separate figures exist for receipts paid by institutions, the tax payments involved are added to those paid by corporations.</skos:definition>
        <skos:definition>Wealth Tax Payment, also known as Recurrent Taxes on Net Wealth, refers to the periodic payment of taxes levied on an individual&apos;s or entity&apos;s total net worth. This tax is typically assessed annually and is based on the value of assets such as real estate, investments, and personal property, minus liabilities.</skos:definition>
        <skos:prefLabel>Net Wealth Tax Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBvpEzZpYd3kw7DyUZ9A2wW -->

