        <rdfs:label>Motion to Extend Time to Appeal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung der Frist zur Berufung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender el plazo para apelar</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Time to Appeal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de prorrogação do prazo para apelação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en prorogation du délai d&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de prórroga de plazo para apelar</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת הזמן להגיש ערעור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपील करने के लिए समय बढ़ाने की मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长上诉期限动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴期限延長申立書</skos:altLabel>
        <skos:definition>A Motion to Extend Time to Appeal is a request made to a higher court to allow additional time beyond the deadline for filing an appeal, typically made by a party who missed the original deadline due to circumstances beyond their control.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7gxzXTW69iDjlT4tGVUOvl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7gxzXTW69iDjlT4tGVUOvl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB6mWlc1WihUbnT7ztVcao5"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm#5_09"/>
        <rdfs:label>Liver Transplantation</rdfs:label>
        <skos:definition>Liver transplantation is a surgical procedure in which a diseased liver is replaced with a healthy donor liver to restore normal liver function. This procedure is typically performed for patients with end-stage liver disease, acute liver failure, or certain liver cancers, and requires lifelong immunosuppressive therapy to prevent organ rejection.</skos:definition>
        <skos:prefLabel>Hepatic Transplantation</skos:prefLabel>
    </owl:Class>
    


