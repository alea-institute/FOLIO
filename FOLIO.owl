        <skos:definition>A court located in Rio Arriba County, New Mexico that has limited jurisdiction over certain types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYopp0bN3TW4xbtSSXiQ53 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RYopp0bN3TW4xbtSSXiQ53">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
