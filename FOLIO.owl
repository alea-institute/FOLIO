        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - &quot;Actual Knowledge&quot; Language</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת תוקף פגיעה חומרית - שפת &quot;ידיעה בפועל&quot;</skos:altLabel>
