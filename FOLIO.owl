        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
        <rdfs:label>Independent Creation</rdfs:label>
        <skos:definition>Independent Creation in copyright law refers to the creation of a work without copying from other sources, relying solely on the author&apos;s own skill, judgment, and creativity. It emphasizes the requirement that a work must originate from the author and not be replicated from existing materials.</skos:definition>
    </owl:Class>
    


