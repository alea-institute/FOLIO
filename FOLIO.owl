    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RXeHqH3kjWyPOUS0Ur826I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RXeHqH3kjWyPOUS0Ur826I">
