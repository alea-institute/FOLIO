        <skos:altLabel xml:lang="pt-br">Resumo das programações</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Résumé des horaires</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Summary of Schedules</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zusammenfassung der Zeitpläne</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיכום לוחות זמנים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुसूचियों का सारांश</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スケジュールの概要</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">时间表摘要</skos:altLabel>
        <skos:definition>A Summary of Schedules is a document that provides a condensed overview of a debtor&apos;s assets, liabilities, and other financial information, and is typically filed as part of a bankruptcy or restructuring proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMrWiofB1FOTYJxccL0cPq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBMrWiofB1FOTYJxccL0cPq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ry9hX7PSumXkvA5dFwO49X"/>
        <rdfs:label>Financial Services Commission</rdfs:label>
        <skos:definition>A commission for financial services refers to a fee or percentage-based compensation that financial professionals, such as investment advisors or brokers, receive for providing financial services to clients. This compensation can be earned for services such as managing investments, providing financial advice, executing trades, or facilitating financial transactions</skos:definition>
    </owl:Class>
    


