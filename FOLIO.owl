        <rdfs:label>LINE_ITEM_TAX_TOTAL</rdfs:label>
        <skos:definition>The LINE_ITEM_TAX_TOTAL concept refers to the total amount of taxes associated with a specific line item in the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzSkPHO0UuQ0ceZyBCWnLL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzSkPHO0UuQ0ceZyBCWnLL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wjSxFeGSnGHBA4sop8v3G"/>
        <rdfs:label>Juvenile Detention Center</rdfs:label>
        <skos:altLabel>Adolescent Detention Facility</skos:altLabel>
        <skos:altLabel>Young Offender Facility</skos:altLabel>
        <skos:altLabel>Youth Correctional Facility</skos:altLabel>
        <skos:altLabel>Youth Detention Facility</skos:altLabel>
        <skos:altLabel>Youth Offender Institution</skos:altLabel>
        <skos:definition>A Juvenile Detention Center is a secure facility designed to detain minors who are awaiting court hearings or have been adjudicated for juvenile offenses. These centers focus on rehabilitation and education, providing programs tailored to the developmental needs of young offenders.</skos:definition>
        <skos:example>A short-term juvenile detention center holds minors temporarily while they await court proceedings</skos:example>
        <skos:example>Less-secure juvenile facilities focus are less-restrictive environments, often incorporating community-based programs.</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzTGTYEpaITpqfkIAWjK5A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzTGTYEpaITpqfkIAWjK5A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Brantley County</rdfs:label>
        <skos:definition>A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Brantley County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzTYMdPGeM2JsutnZtT7Fi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzTYMdPGeM2JsutnZtT7Fi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2Kr3kWHR9cR4zALXqt1nM"/>
        <rdfs:label>Outperformance Bonus Certificate</rdfs:label>
        <skos:definition>An Outperformance Bonus Certificate is a financial instrument that allows disproportionate participation in the positive performance of the underlying asset or assets above a certain strike level, combined with protective features. The minimum redemption value is equal to the nominal value, provided a specified barrier has not been breached; if the barrier is breached, the product converts into an outperformance certificate. With greater risk, multiple underlying assets (worst-of) allow for a higher bonus level or lower barrier, offering reduced risk compared to a direct investment in the underlying assets.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzjwBSp9Tz4d58hZNnqYqL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzjwBSp9Tz4d58hZNnqYqL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E113 Subpoena fees</rdfs:label>
        <skos:definition>Subpoena fees are expenses incurred in the process of serving a subpoena.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBzn2SojKRH5ENzfzDxyxsS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBzn2SojKRH5ENzfzDxyxsS">
