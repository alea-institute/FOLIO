            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Capitalization Table</rdfs:label>
        <skos:altLabel xml:lang="de-de">Beteiligungstabelle</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Capitalisation Table</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tabela de capitalização</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tabla de capitalización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tabla de capitalización</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tableau de capitalisation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טבלת הון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूंजी तालिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">股本结构表</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">資本構成表</skos:altLabel>
        <skos:definition>A Capitalization Table (Cap Table) is a document that outlines the ownership structure of a company, including the number and type of shares held by each shareholder.</skos:definition>
        <skos:prefLabel>Cap Table</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZifrYlfXzRuNkG6RIiKzE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZifrYlfXzRuNkG6RIiKzE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDECjssxw76vdlahxiUTb4L"/>
        <rdfs:label>Missouri Circuit Court - Schuyler County</rdfs:label>
        <skos:definition>A Missouri Circuit Court in Schuyler County is a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Schuyler County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZk3zcuOoUUGWYC5W6TB5c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZk3zcuOoUUGWYC5W6TB5c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Greek, Ancient</rdfs:label>
        <skos:altLabel xml:lang="de-de">Altgriechisch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Grec ancien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Grego antigo</skos:altLabel>
        <skos:altLabel>to 1453</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">古代ギリシャ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">古希腊语</skos:altLabel>
        <skos:definition>The language used in ancient Greece up to the year 1453, including its grammar and vocabulary, as it relates to legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZkKQpHNkm2vdQEmj3tOXW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZkKQpHNkm2vdQEmj3tOXW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Montgomery County</rdfs:label>
        <skos:definition>Georgia Superior Court - Montgomery County: A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Montgomery County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZn0IX2NtrfPkzFcRdMLwg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZn0IX2NtrfPkzFcRdMLwg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKBlQ2mgZn3CTwBfUYIM7s"/>
        <rdfs:label>Primary Lateral Sclerosis</rdfs:label>
        <skos:definition>Primary lateral sclerosis (PLS) is a rare neurodegenerative disorder characterized by the gradual degeneration of upper motor neurons in the brain and spinal cord. This condition leads to progressive muscle stiffness, spasticity, and weakness, primarily affecting voluntary movements while sparing lower motor neurons.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZsudYglnckzDiIt6LK2fk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZsudYglnckzDiIt6LK2fk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L4OY7QCBEVJpav2Da6Gef"/>
        <rdfs:label>Customs and Import Duty Payment</rdfs:label>
        <skos:altLabel>Border Tax Payment</skos:altLabel>
        <skos:altLabel>Customs Levy Payment</skos:altLabel>
        <skos:altLabel>Customs Tax Payment</skos:altLabel>
        <skos:altLabel>Customs and Import Duties</skos:altLabel>
        <skos:altLabel>Import Duty Payment</skos:altLabel>
        <skos:altLabel>Import Surcharge Payment</skos:altLabel>
        <skos:definition>Customs and Import Duty Payment refers to taxes, stamp duties, and surcharges levied exclusively on imported products. This includes specific levies on agricultural imports in European Union member countries and payments under the Monetary Compensation Accounts (MCA) system. Customs duties collected by EU member states on behalf of the European Union are also reported under this heading. These taxes are distinct from general goods and services taxes or excises that apply to both imported and domestically produced goods.</skos:definition>
        <skos:prefLabel>Import Tariff Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZvzjymwe5Jdu4nFAuDUNO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZvzjymwe5Jdu4nFAuDUNO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Duty to Mitigate Damages Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de devoir de mitigation des dommages</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de deber de mitigar daños</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de deber de mitigar daños</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de dever de mitigação de danos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Duty to Mitigate Damages Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Pflicht zur Schadensminderung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חובת הקטנת נזקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नुकसान कम करने का दायित्व अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">减轻损失责任条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">損害軽減義務条項</skos:altLabel>
        <skos:definition>A Duty to Mitigate Damages Clause is a provision in a contract that requires the injured party to take reasonable steps to minimize their losses or damages resulting from a breach of contract by the other party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBZyQS180oRBbk6avg3889Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBZyQS180oRBbk6avg3889Y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzQzQSPRAB9cLkvDtBJFn"/>
        <rdfs:label>Riparian Rights</rdfs:label>
        <skos:definition>Rooted in common law, riparian rights refer to the rights of landowners whose property borders a natural watercourse. Under riparian doctrine, these landowners have the right to make reasonable use of the water adjacent to or flowing over their land, provided they don&apos;t unreasonably interfere with the rights of downstream users.</skos:definition>
    </owl:Class>
    


