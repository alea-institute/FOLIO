        <rdfs:label>Winner-Take-All - Multi-Winner System</rdfs:label>
        <skos:altLabel>Block Voting</skos:altLabel>
        <skos:altLabel>Multi-Winner Voting</skos:altLabel>
        <skos:altLabel>Multiple-Winner Voting System</skos:altLabel>
        <skos:altLabel>Plurality-at-Large Voting</skos:altLabel>
        <skos:definition>A winner-take-all multi-winner system is an electoral method where multiple candidates are elected from a single district, and the candidates with the highest number of votes win the available seats. This system can lead to one party or group dominating the representation, often marginalizing minority party voters.</skos:definition>
        <skos:prefLabel>Multi-Winner Plurality System</skos:prefLabel>
    </owl:Class>
    


