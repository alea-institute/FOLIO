        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32212"/>
        <rdfs:label>Paper Mills</rdfs:label>
        <skos:definition>See industry description for 322120.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/42JL-2LmRkyOB6I22vDukA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/42JL-2LmRkyOB6I22vDukA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/MGbTrlW7Q266Siq293Zsjg"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=522130"/>
        <rdfs:label>Credit Union Industry</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in accepting members&apos; share deposits in cooperatives that are organized to offer consumer loans to their members.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/42SQEIlkSua466-FrBCwSA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/42SQEIlkSua466-FrBCwSA">
