        <rdfs:label>Survey</rdfs:label>
        <skos:definition>A survey in a legal context refers to a comprehensive review or analysis of laws, regulations, or practices. It aims to identify trends to inform legal strategy, compliance, or research.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDs5asGGt5TxuJZasFdOUJf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDs5asGGt5TxuJZasFdOUJf">
