        <skos:altLabel>Individual</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Individual Rights Law</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ley de Derechos Individuales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ley de Derechos Individuales</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht der individuellen Rechte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק זכויות אישיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यक्तिगत अधिकार कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">个人权利法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">個人権利法</skos:altLabel>
        <skos:definition>Individual rights such as privacy and the freedom of thought, speech, religion, press, assembly, and movement.</skos:definition>
        <skos:hiddenLabel>INDV</skos:hiddenLabel>
    </owl:Class>
    


