        <skos:altLabel xml:lang="es-mx">Negligencia médica en oncología</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em oncologia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Oncology Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Onkologie-Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאה רפואית באונקולוגיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऑन्कोलॉजी लापरवाही</skos:altLabel>
