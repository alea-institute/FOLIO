        <skos:altLabel>Master of Engineering</skos:altLabel>
        <skos:definition>An M.Eng. (Master of Engineering) is a postgraduate degree focused on engineering studies, emphasizing technical and applied knowledge. It signifies advanced expertise in engineering principles and practices.</skos:definition>
        <skos:prefLabel>M.Eng.</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RUWO4SzoPWpYF7vZ3XAxEq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RUWO4SzoPWpYF7vZ3XAxEq">
