            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>L400 Trial Preparation and Trial</rdfs:label>
        <skos:definition>L400 Trial Preparation and Trial refers to the process of preparing for and conducting a trial, including tasks such as drafting written motions, preparing expert witnesses, attending hearings, and making post-trial submissions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkcKVfaV3t8ah0WJGdJSAQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkcKVfaV3t8ah0WJGdJSAQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBuYThXwp8tJjNWkTeuFvAZ"/>
        <rdfs:label>No Parking Zone Violation</rdfs:label>
        <skos:altLabel>Unauthorized Parking Zone Violation</skos:altLabel>
        <skos:definition>This infraction takes place when a vehicle is parked in an area explicitly designated as a &quot;No Parking&quot; zone, usually marked by signs or pavement markings. The driver is generally subject to a fine and may also have their vehicle towed.</skos:definition>
        <skos:prefLabel>Illegal Parking Violation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkcbxTTJZnhBvdqxhxMXsf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkcbxTTJZnhBvdqxhxMXsf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6KiJE1p0Wdu1UXAXMTgZJ"/>
        <rdfs:label>Analysis of Vendor Communications</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Analyse des communications des fournisseurs</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Analyse von Lieferantenkommunikation</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Analysis of Vendor Communications</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Análise de comunicações de fornecedores</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Análisis de las comunicaciones del proveedor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Análisis de las comunicaciones del proveedor</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניתוח של תקשורות ספקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विक्रेता संचार का विश्लेषण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ベンダーのコミュニケーション分析</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">供应商沟通分析</skos:altLabel>
        <skos:definition>The concept of Analysis of Vendor Communications refers to the examination and evaluation of communications between a company and its vendors in order to assess the legal implications and potential risks associated with their commercial arrangements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkeXkYjY816eSnxFpPcvvm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkeXkYjY816eSnxFpPcvvm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
        <rdfs:isDefinedBy rdf:resource="http://oecdprivacy.org/"/>
        <rdfs:label>Purpose Specification Principle</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Principe de finalité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Principio de Especificación del Propósito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Principio de Especificación del Propósito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Princípio da finalidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Purpose Specification Principle</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zweckbindungsprinzip</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עקרון הצהרת המטרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उद्देश्य विनिर्देशन सिद्धांत</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">目的明确原则</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">目的明示の原則</skos:altLabel>
        <skos:definition>Purpose Specification is the privacy principle that the purposes for which personal data are collected should be specified not later than at the time of data collection and the subsequent use limited to the fulfilment of those purposes or such others as are not incompatible with those purposes and as are specified on each occasion of change of purpose.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkgSuo1lKCSb4OpDS1gvIm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkgSuo1lKCSb4OpDS1gvIm">
