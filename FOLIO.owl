        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJEhNjPDXIeJRMwifVraDk"/>
        <rdfs:label>Mutual Mistake in Contract</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Erreur mutuelle dans le contrat</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Erro mútuo no contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Error mutuo en el contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Error mutuo en el contrato</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenseitiger Irrtum im Vertrag</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mutual Mistake in Contract</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טעות משותפת בחוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संयुक्त भूल से अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合同中的相互错误</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約上の相互誤り</skos:altLabel>
        <skos:definition>A mutual mistake in contract is a type of mistake made by both parties in a contract, where they both have a mistaken understanding of a material fact that is essential to the agreement, and as a result, the contract may be voidable or rescinded.</skos:definition>
    </owl:Class>
    


