        <rdfs:label>Enforcement of Visitation Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Durchsetzung des Umgangsrechts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Ejecución de la reclamación de visitas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Ejecución de la reclamación de visitas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Enforcement of Visitation Claim</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Execução do direito de visitas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Exécution du droit de visite</skos:altLabel>
        <skos:altLabel xml:lang="he-il">יישום תביעת ביקור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दौरे के दावे का प्रवर्तन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">执行探视权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">面会請求の強制執行</skos:altLabel>
        <skos:definition>The Enforcement of Visitation Claim is the legal process of ensuring that a parent&apos;s right to visit their child is upheld, typically through court orders and legal remedies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79ooHwjGKqjqJTzhOxe0To -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79ooHwjGKqjqJTzhOxe0To">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2BaikN50BQY375QT0PEWD"/>
        <rdfs:label>Personal Day</rdfs:label>
        <skos:altLabel>Flexible Day Off</skos:altLabel>
        <skos:altLabel>PTO</skos:altLabel>
        <skos:altLabel>Personal Leave Day</skos:altLabel>
        <skos:definition>A Personal Day is a type of paid time off provided by employers that allows employees to take leave for personal reasons without specifying the nature of the absence. This benefit is typically separate from vacation days or sick leave, offering flexibility for employees to address personal matters, appointments, or mental health needs without detailed explanation.</skos:definition>
        <skos:prefLabel>Personal Time Off</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79pcBIgWKI09DkRMGF3LCC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79pcBIgWKI09DkRMGF3LCC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t5CSqYvG6L6Cl86vQeMRA"/>
        <rdfs:subClassOf>
