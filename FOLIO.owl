        <rdfs:label>Extendible Asset</rdfs:label>
        <skos:altLabel>Extendable Security</skos:altLabel>
        <skos:definition>An Extendible Asset is a financial instrument that allows the redemption date to be extended at the option of the issuer or the holder. This feature provides additional flexibility, enabling the extension of the asset&apos;s maturity under predefined conditions.</skos:definition>
        <skos:prefLabel>Flexible Maturity Asset</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XxCPX0obhOk013uLpX58K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XxCPX0obhOk013uLpX58K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Default Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause par défaut</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula padrão</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula por defecto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula predeterminada</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Default Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Standardklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ברירת מחדל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डिफ़ॉल्ट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">デフォルト条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">默认条款</skos:altLabel>
        <skos:definition>A default clause is a provision in a contract that specifies the consequences if one party fails to fulfill their obligations under the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Y9sDLe5XeFbzoBt8dPTGK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Y9sDLe5XeFbzoBt8dPTGK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Efik</rdfs:label>
        <skos:altLabel xml:lang="de-de">Efik</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Efik</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Efik</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エフィック語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">埃菲克语</skos:altLabel>
        <skos:definition>Efik is a structured system of communication that consists of grammar and vocabulary, and is a member of the Language class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YA4v37gGvqOV4PG5iNn6j -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YA4v37gGvqOV4PG5iNn6j">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97XG1bV4Mx6t2B4cpMlF0U"/>
        <dc:identifier>WHT-WHEL</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4236"/>
        <rdfs:label>Household Appliances and Electrical and Electronic Goods Merchant Wholesalers Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Großhandel mit elektronischen Märkten</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de Mercados Electrónicos Mayoristas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Mercados Electrónicos al por Mayor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des marchés électroniques de gros</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de mercados eletrônicos de atacado</skos:altLabel>
        <skos:altLabel>Wholesale Electronic Markets</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wholesale Electronic Markets Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית שווקי מכירה בתפזורת אלקטרוניים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">होलसेल इलेक्ट्रॉनिक मार्केट उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">卸売電子市場産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">批发电子市场行业</skos:altLabel>
        <skos:definition>This industry group comprises establishments primarily engaged in the merchant wholesale distribution of electrical apparatus and equipment, wiring supplies, and related equipment; household appliances, electric housewares, and consumer electronics; and other electronic parts and equipment.</skos:definition>
        <skos:hiddenLabel>WHEL</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YBf8Plir549jdl8lkxO00 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YBf8Plir549jdl8lkxO00">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBDggRpYzbIC7NOvN4KsvUv"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Treaty Skilled Worker Visa</rdfs:label>
        <skos:altLabel>NAFTA Professional Visa</skos:altLabel>
        <skos:altLabel>TN-1 Visa (Canada)</skos:altLabel>
        <skos:altLabel>TN-2 Visa (Mexico)</skos:altLabel>
        <skos:altLabel>USMCA Professional Visa</skos:altLabel>
        <skos:definition>This visa category (in the U.S., TN-2 Visa) applies to skilled professionals in treaty-signatory countries. In the United States, this non-immigrant visa allows the individual to work in the U.S. under the provisions of the North American Free Trade Agreement (NAFTA), which was replaced by the United States-Mexico-Canada Agreement (USMCA). The initial period of stay is up to three years, but extensions can be granted in three-year increments</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YBhfiALaEYcnZJ9DMqye4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YBhfiALaEYcnZJ9DMqye4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cGjHXv3vecVd4ZO6HVjo"/>
        <rdfs:label>Notify Consulate Abroad</rdfs:label>
        <skos:definition>&quot;Notifying Consulate Abroad&quot; involves informing a consulate or embassy in a foreign country about an individual&apos;s intent to apply for a visa or immigration benefit, initiating the process of obtaining the necessary documentation and approval for entry or residency in the destination country.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YEKFiYkowitD7dlvVs9Dj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YEKFiYkowitD7dlvVs9Dj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jMPIyAf6QTkMSrGDnGYz1"/>
        <rdfs:label>Adult</rdfs:label>
        <skos:definition>An adult is an individual who has reached the age of maturity as defined by law, typically marking the transition from childhood to full legal autonomy and responsibility. The specific age at which this transition occurs varies by jurisdiction, but it is commonly 18 or 21 years old.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YHVip80BTyOcnFNfDe3Ix -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YHVip80BTyOcnFNfDe3Ix">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvV18Mbbb9FYFXbHt1inuL"/>
        <rdfs:label>State of Emergency</rdfs:label>
        <skos:altLabel>Emergency Declaration</skos:altLabel>
        <skos:altLabel>Emergency Powers</skos:altLabel>
        <skos:definition>A State of Emergency is a governmental declaration that suspends normal constitutional procedures to address a crisis, disaster, or other extraordinary situation. This status grants special powers to authorities to implement measures necessary to manage the emergency, often involving restrictions on normal civil liberties and government operations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YJTRhHvp1SM1F3trynODK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YJTRhHvp1SM1F3trynODK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC98GOWmR2IGsSWxcwMf82O"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDp8cEr3KYyVDenm1P9ejdx"/>
        <rdfs:label>Real Estate Broker&apos;s Constructive Fraud</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Fraude Constructivo del Corredor Inmobiliario</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fraude Constructivo del Corredor de Bienes Raíces</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fraude constructive de l&apos;agent immobilier</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fraude construtiva do corretor de imóveis</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Konstruktiver Betrug des Immobilienmaklers</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Real Estate Broker&apos;s Constructive Fraud</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הונאה בניהול עסקי של תיווך נדל״ן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रियल एस्टेट ब्रोकर का निर्माणात्मक धोखाधड़ी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不動産ブローカーの建設的詐欺</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">房地产经纪人的建设性欺诈</skos:altLabel>
        <skos:definition>Real Estate Broker&apos;s Constructive Fraud: A type of constructive fraud that occurs when a real estate broker misrepresents or conceals material facts with the intent to deceive, causing harm to the client.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YKevEQMvnDljIgewW3K9D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YKevEQMvnDljIgewW3K9D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Lackawanna County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Lackawanna County is a specific court within the Pennsylvania Magisterial District Court system that has jurisdiction over minor criminal offenses and civil cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YMVMAr8OFlouOGxvnfBrp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YMVMAr8OFlouOGxvnfBrp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ry9hX7PSumXkvA5dFwO49X"/>
        <rdfs:label>Recruitment Commission</rdfs:label>
        <skos:definition>A commission for recruitment refers to a fee or payment that recruiters or staffing agencies receive for successfully finding and placing candidates in job positions for employers. This compensation is typically a percentage of the candidate&apos;s first-year salary and serves as an incentive for recruiters to match suitable candidates with job opportunities</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YOS0RtLYgPopBKbZQzNDR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YOS0RtLYgPopBKbZQzNDR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R99UNWpuiCUIJXZnQbuFLRq"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7LDrNr3UKXymP1c9pj920s"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tax_tier_total_taxable_amount</rdfs:label>
        <skos:definition>&quot;The sum of all TAX_TIERS.tax_tier_taxable_amount for this tx_id expressed in INVOICE.inv_currency.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YPLTfN7GcfLUe561agxu9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YPLTfN7GcfLUe561agxu9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1okJKMvv4mMHv7m4TzwBe"/>
        <rdfs:label>Recreational Vehicle</rdfs:label>
        <skos:definition>A recreational vehicle (RV) is a motorized or towable vehicle equipped with living accommodations, typically including sleeping, cooking, and bathroom facilities. RVs are used for travel, camping, and recreation, providing a mobile home away from home for individuals and families.</skos:definition>
        <skos:prefLabel>RV</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YQkBevCduWpKda55vzcFV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YQkBevCduWpKda55vzcFV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>Actions Taken with Consent or Approval of Buyer Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Acciones Tomadas con el Consentimiento o Aprobación del Comprador</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acciones Tomadas con el Consentimiento o Aprobación del Comprador</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Actions Taken with Consent or Approval of Buyer Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Actions prises avec le consentement ou l&apos;approbation de l&apos;acheteur</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ações tomadas com o consentimento ou aprovação do comprador</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mit Zustimmung oder Genehmigung des Käufers ergriffene Maßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעולות שננקטו עם הסכמת או אישור הקונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार की सहमति या अनुमोदन के साथ लिए गए कार्य</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">在买方同意或批准的情况下采取的行动</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手の同意または承認に基づく措置</skos:altLabel>
        <skos:definition>Actions Taken with Consent or Approval of Buyer Language refers to the specific language in a legal agreement that outlines the actions that can be taken by one party with the consent or approval of the other party, typically in the context of a Material Adverse Effect (MAE) carveout.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Yb5K15AqsVB29ypxH2BGh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Yb5K15AqsVB29ypxH2BGh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xekNn7K6SxToo5ArjIsTX"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motion to File Addendum</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einreichung eines Nachtrags</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para presentar un addendum</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer un addendum</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Addendum</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para arquivar adendo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de presentación de addendum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להגשת נספח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अतिरिक्त फ़ाइल जमा करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">付記を提出するための動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交补充文件动议</skos:altLabel>
        <skos:definition>A Motion to File Addendum is a formal request made to an appellate court to allow the submission of additional information or evidence to be included in the record on appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YbbxhGputEF29Tm5cbWoB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YbbxhGputEF29Tm5cbWoB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBZL31YCqZA1E1vlIkzRRqw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDuzCluPExGae1dWj6QtE8N"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tax_tiers</rdfs:label>
        <skos:definition>&quot;&quot;&quot;tax_tiers&quot;&quot; = Y only where there are different tax rates applicable to billed tiers.   

If Tiered Tax = &quot;&quot;Y&quot;&quot;, the LEDES invoice should contain only one matter; multiple matters/invoice are not allowed for Tiered Taxes.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YfXog92OHuOj0eFmQBB4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YfXog92OHuOj0eFmQBB4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_03"/>
        <rdfs:label>Skin Cancer</rdfs:label>
        <skos:altLabel>Cutaneous Carcinoma</skos:altLabel>
        <skos:altLabel>Dermal Cancer</skos:altLabel>
        <skos:altLabel>Epidermal Carcinoma</skos:altLabel>
        <skos:definition>Skin cancer is a type of cancer that begins in the cells of the skin. It includes various forms, such as basal cell carcinoma, squamous cell carcinoma, and melanoma, each requiring specific treatments like surgery, radiation therapy, chemotherapy, and immunotherapy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YijwyycPV6XzUJaud9SB1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YijwyycPV6XzUJaud9SB1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSYBzf149Mi5KE0YtmpUmr"/>
        <dc:identifier>PUBL</dc:identifier>
        <rdfs:label>Public and Administrative Law</rdfs:label>
        <skos:altLabel xml:lang="es-es">Derecho Público y Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho Público y Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito Público e Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit public et administratif</skos:altLabel>
        <skos:altLabel>Public and Administrative Law</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Public and Administrative Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Öffentliches und Verwaltungsrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משפט ציבורי ומנהלי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक और प्रशासनिक कानून</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公法および行政法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公法和行政法</skos:altLabel>
        <skos:definition>Law which governs relationships between individuals and the government, and the activities of administrative agencies of government including rule making, adjudication, or the enforcement of a specific regulatory agenda.</skos:definition>
        <skos:hiddenLabel>PUBL</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Yn0rpoHNTFiymo0I8CAVf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Yn0rpoHNTFiymo0I8CAVf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_07"/>
        <rdfs:label>Somatic Symptom and Related Disorders</rdfs:label>
        <skos:altLabel>Somatic Disorders</skos:altLabel>
        <skos:definition>These disorders are characterized by physical symptoms or deficits that are not intentionally produced or feigned, and that, following clinical investigation, cannot be fully explained by a general medical condition, another mental disorder, the direct effects of a substance, or a culturally sanctioned behavior or experience. These disorders may also be characterized by a preoccupation with having or acquiring a serious medical condition that has not been identified or diagnosed. Symptoms and signs may include, but are not limited to, pain and other abnormalities of sensation, gastrointestinal symptoms, fatigue, a high level of anxiety about personal health status, abnormal motor movement, pseudoseizures, and pseudoneurological symptoms, such as blindness or deafness.</skos:definition>
        <skos:prefLabel>Somatoform Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YobH67EfCGNLPB1hq7o4n -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YobH67EfCGNLPB1hq7o4n">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCpnqQCzeexk3k9kkbLx1Zu"/>
        <rdfs:label>Substantial Prejudice</rdfs:label>
        <skos:altLabel xml:lang="es-es">Prejuicio sustancial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Prejuicio sustancial</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Substantial Prejudice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">erhebliche Vorurteile</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">prejuízo substancial</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">préjudice substantiel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגיעה משמעותית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ठोस नुकसान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质性偏见</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な偏見</skos:altLabel>
        <skos:definition>Substantial Prejudice: A legal concept used in appellate standards of review that refers to an error or action that had a significant impact on the outcome of a case and resulted in an unfair disadvantage to one of the parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YpJBaF5zesoc0jtaNESdQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YpJBaF5zesoc0jtaNESdQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
        <rdfs:label>Precedent</rdfs:label>
        <skos:definition>Precedent refers to a legal decision or judgment passed in a previous case, used as an authoritative rule or example in subsequent similar cases. It serves as a guiding principle, helping courts decide future cases with similar issues or facts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YpmuUZmn3o9FoTaw5XYwP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YpmuUZmn3o9FoTaw5XYwP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
        <rdfs:label>Punitive Damages</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Danos punitivos / exemplares</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Daños punitivos / ejemplares</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Daños punitivos / ejemplares</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dommages et intérêts punitifs / exemplaires</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Punitive / Exemplary Damages</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Strafschadensersatz / Exemplarische Schadensersatz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיצויים פוניטיביים / מקודדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिकारी / नमूना दाम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">惩罚性/示范性赔偿</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">懲罰的/模範的損害賠償</skos:altLabel>
        <skos:definition>Monetary damages awarded in addition to compensatory damages, intended to punish the defendant for their wrongful conduct and to deter similar conduct in the future.</skos:definition>
        <skos:prefLabel>Exemplary Damages</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Yr9XhT3KzXB5cQ17awsrR -->

