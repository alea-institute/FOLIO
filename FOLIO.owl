        <skos:altLabel xml:lang="es-mx">Difamación comercial</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Difamação comercial</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dénigrement commercial</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geschäftsschädigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">השמצת עסקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यापार अपमान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ビジネスディスパラージュ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">商业诽谤</skos:altLabel>
        <skos:definition>The act of making false or misleading statements about a business or its products or services, with the intention of causing harm to its reputation or financial standing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCVn9Ew2WyR8O4O5WGDlLKO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCVn9Ew2WyR8O4O5WGDlLKO">
