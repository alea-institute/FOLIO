        <dc:identifier>US-FD-EOP-NEC</dc:identifier>
        <rdfs:label>National Economic Council</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Conseil économique national</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Consejo Económico Nacional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Consejo Económico Nacional</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Conselho Econômico Nacional</skos:altLabel>
