                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R765fdd1D03d3269330E964e"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Workplace Safety Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Arbeitssicherheitsanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de seguridad en el lugar de trabajo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de seguridad en el lugar de trabajo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de segurança no local de trabalho</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de sécurité sur le lieu de travail</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Workplace Safety Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת בטיחות במקום העבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार्यस्थल सुरक्षा दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工作场所安全索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">職場安全請求</skos:altLabel>
        <skos:definition>A workplace safety claim is a legal action initiated by an employee against their employer for not providing a safe working environment. The claim typically arises when an employer does not comply with applicable safety regulations, which can result in dangerous or hazardous working conditions for employees. Workplace safety claims can involve issues such as inadequate safety equipment, lack of proper training, or unsafe working conditions. Employees may bring workplace safety claims for injuries or illnesses suffered as a result of their employer&apos;s failure to provide a safe working environment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XBH3o4RfHh4wNHiZElWQS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XBH3o4RfHh4wNHiZElWQS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDrgrPYJPo0Rj0YG5xJ2OMX"/>
        <rdfs:label>IP Analytics Management</rdfs:label>
        <skos:definition>IP Analytics Management refers to the process of organizing and analyzing intellectual property data to make informed business decisions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XEIPN0gdrO2Fgwj05iPvs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XEIPN0gdrO2Fgwj05iPvs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7WKt0VAzs1NaH3XvbaWYIZ"/>
        <rdfs:label>Myelofibrosis</rdfs:label>
        <skos:altLabel>Myelofibrotic Syndrome</skos:altLabel>
        <skos:definition>Myelofibrosis is a rare type of bone marrow disorder characterized by the replacement of normal bone marrow tissue with fibrous scar tissue. This leads to the impaired production of blood cells and can result in anemia, enlarged spleen (splenomegaly), and other systemic symptoms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XI2NPtg7ZMadfULv2SLS0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XI2NPtg7ZMadfULv2SLS0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <rdfs:label>Cultural Rights</rdfs:label>
        <skos:definition>Cultural rights pertain to the freedom and ability of individuals or groups to maintain, develop, and share their culture, language, and heritage. These rights are often protected by international law and may include access to cultural and educational resources, protection of cultural heritage, and freedom to engage in cultural practices</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RuDAbRiNW105SQoqb1XZ4c"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Animal Claims</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Animal Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de animales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamos de animales</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações animais</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendications animales</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Tieransprüche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות בנושא בעלי חיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पशु दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">动物索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">動物の請求</skos:altLabel>
        <skos:definition>Animal Claims refer to legal claims related to harm caused by or to animals, including liability for injury to pets, cruelty to animals, animal attacks, trespassing livestock causing harm, dangerous domesticated animals, injury caused by wild animals, and negligent handling of animals.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XQGAi1N0JWYJ3YT4yfxV5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XQGAi1N0JWYJ3YT4yfxV5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QDC1chH8o0jmTMsmrcaUW"/>
        <rdfs:label>New York Community Justice Center - Redhook</rdfs:label>
        <skos:definition>A specialized court in New York City that aims to reduce crime and improve public trust in the justice system, located in the Redhook neighborhood.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XSHg9bgncgnUB5XdahzNP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XSHg9bgncgnUB5XdahzNP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9jGsr6LEcgGQxDRMlckOMm"/>
        <rdfs:label>Geothermal Rights</rdfs:label>
        <skos:definition>Geothermal rights grant ownership or control over the heat energy stored beneath the earth&apos;s surface in a specific area. The holder of these rights can harness this energy for power generation or other purposes and may lease, sell, or transfer these rights to another entity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XUf1TqJ74SPRoBiopUfNo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XUf1TqJ74SPRoBiopUfNo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motion to Stay the Mandate</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Aussetzung der Anordnung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Suspender el Mandato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Suspender el Mandato</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion de suspension de la décision</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Stay the Mandate</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Suspensão da Ordem</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לעצירת הפקודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मंडेट को रोकने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">執行停止命令申立書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">暂缓执行令申请书</skos:altLabel>
        <skos:definition>A Motion to Stay the Mandate is a request made to a higher court to temporarily suspend the enforcement of a decision made by a lower court until the appeal process is completed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XYr38AveQ9CS79lnOA1H2 -->

