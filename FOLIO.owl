        <skos:altLabel xml:lang="hi-in">प्रोप्राइटरी जानकारी और गोपनीयता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专有信息和保密条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">所有権情報および機密保持条項</skos:altLabel>
        <skos:definition>A Proprietary Information and Confidentiality Clause is a legal provision that restricts the disclosure of confidential information and trade secrets belonging to a company or individual, and is typically included in contracts or agreements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8eLjBdBZvFAiSkedoY0xen -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8eLjBdBZvFAiSkedoY0xen">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
        <rdfs:label>Experts Expense</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Despesas de especialistas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Expertenkosten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Experts Expense</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais d&apos;experts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gastos de expertos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gastos de expertos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאות מומחים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विशेषज्ञ व्यय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专家费用</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">専門家費用</skos:altLabel>
        <skos:definition>The cost incurred by a party in a legal matter for the services of a professional with specialized knowledge or skills, such as a consultant or witness.</skos:definition>
    </owl:Class>
    


