        <rdfs:label>Arkansas District Court - Prairie Cty.</rdfs:label>
        <skos:definition>A court located in Prairie County, Arkansas that has jurisdiction over certain legal matters within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9M9IxtSoHX1iXJWLIlKnrE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9M9IxtSoHX1iXJWLIlKnrE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7z8IPBHMwVOHP53OFYeSZN"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/6.00-Genitourinary-Adult.htm#6_03"/>
        <rdfs:label>Chronic Kidney Disease</rdfs:label>
        <skos:altLabel>Chronic Kidney Failure</skos:altLabel>
        <skos:altLabel>Chronic Renal Disease</skos:altLabel>
        <skos:definition>Chronic Kidney Disease (CKD) is a progressive condition characterized by the gradual loss of kidney function over time. This decline can lead to kidney failure, requiring treatments such as dialysis or kidney transplantation to manage the condition.</skos:definition>
        <skos:prefLabel>Chronic Renal Failure</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9M9TKjQAD0X9AThpviqxJM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9M9TKjQAD0X9AThpviqxJM">
