        <skos:altLabel xml:lang="es-mx">Moción para permitir reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour autoriser les réclamations</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Allow Claims</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para permitir reivindicações</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לאפשר טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावों की अनुमति के लिए चलान</skos:altLabel>
