        <skos:altLabel xml:lang="pt-br">ID fiscal do cliente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Identifiant fiscal du client</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Identificación fiscal del cliente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Identificación fiscal del cliente</skos:altLabel>
        <skos:altLabel>Individual Taxpayer Identification Number</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kundensteuer-ID</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מזהה מס לקוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ग्राहक टैक्स आईडी</skos:altLabel>
