        <rdfs:label>Indiana Circuit Court - Clark County Circuit 1</rdfs:label>
        <skos:definition>The Indiana Circuit Court - Clark County Circuit 1 is a court of general jurisdiction in Indiana that hears civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Oi8U82iOSGoo7aV3lyutT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Oi8U82iOSGoo7aV3lyutT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSepz944v79Sc4zhy0qy2X"/>
        <rdfs:label>Amended Document</rdfs:label>
        <skos:altLabel>Amendment</skos:altLabel>
        <skos:definition>An amended document is a revised version of an original document that incorporates changes, corrections, or additions. The purpose of amending a document is to update or clarify its content, often to reflect new information or agreements between parties involved.</skos:definition>
        <skos:prefLabel>Supplement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OmVvDEkIqcYQBoUjCVOJV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OmVvDEkIqcYQBoUjCVOJV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8DuEmmnbcptnIZhPdF2Tvx"/>
        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Fee Pre or Post Split</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Fee Pre or Post Split</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais avant ou après la division</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebühr vor oder nach der Aufteilung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tarifa antes o después de la división</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tarifa antes o después de la división</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Taxa pré ou pós divisão</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דמי עמלה לפני או לאחר החלוקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फी पूर्व या बाद में विभाजित</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">分割前または後の手数料</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分拆前或后费用</skos:altLabel>
        <skos:definition>A fee that is either paid before or after a split between parties, and is categorized under discounts and credits in legal services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7On4VWw10rNMziVMsyhnz9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7On4VWw10rNMziVMsyhnz9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NB9WJzAFK6tIIGmfIj5Ay"/>
        <dc:source>Fed. R. Evid. 611</dc:source>
        <rdfs:label>Narrative Objection</rdfs:label>
        <skos:altLabel>Narrative Response Objection</skos:altLabel>
        <skos:altLabel>No question before witness</skos:altLabel>
        <skos:altLabel>Objection to Overbroad Testimony</skos:altLabel>
        <skos:definition>An objection to a narrative is raised when a party in a legal proceeding believes that a witness&apos;s response or a question posed by the opposing counsel is too lengthy, lacks focus, or provides information beyond what was requested. This objection aims to prevent the introduction of irrelevant or prejudicial details into the record.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Oohbb58KPtSYRioVTEYtp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Oohbb58KPtSYRioVTEYtp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Bdj1eCxXbeaYx70Wt6JN5"/>
        <rdfs:label>&quot;Entitled to&quot; Specific Performance Language</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf spezifische Leistungssprache</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Derecho a Lenguaje de Cumplimiento Específico</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho a Lenguaje de Cumplimiento Específico</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Entitled to Specific Performance Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langage de la performance spécifique à laquelle on a droit</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Linguagem de desempenho específico ao qual se tem direito</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכאי לשפת ביצוע מסוימת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विशिष्ट प्रदर्शन भाषा का हकदार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">有权要求特定履行语言</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">特定履行言語に権利を有する</skos:altLabel>
        <skos:definition>The &quot;Entitled to&quot; Specific Performance Language refers to a clause in a legal contract that grants a party the right to demand specific performance of the terms of the contract, rather than seeking monetary damages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OsK77qJzadZwNwV39v2XX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OsK77qJzadZwNwV39v2XX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
        <rdfs:label>Faithfully Executed Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf treue Ausführungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Faithfully Executed Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Ejecución Fiel</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Ejecución Fiel</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de execução fiel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de clause d&apos;exécution fidèle</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף ביצוע נאמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ईमानदारी से अंजामित शर्त दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">忠实执行条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">忠実に実行された条項の請求</skos:altLabel>
        <skos:definition>A Faithfully Executed Clause claim is a legal argument asserting that a government official, typically the President, has failed to faithfully execute the laws as required by the Faithfully Executed Clause of the United States Constitution. This claim contends that the official&apos;s actions or omissions in implementing or enforcing the laws are in violation of the constitutional duty to faithfully execute the laws, potentially rendering their actions unconstitutional or invalid.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7OtUosForl1Zon7KU3gQQR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7OtUosForl1Zon7KU3gQQR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDm4rfXgHt9wIDHbrUUGCGL"/>
        <rdfs:label>Real Estate Operator</rdfs:label>
        <skos:altLabel>Property Operator</skos:altLabel>
        <skos:altLabel>Real Estate Manager</skos:altLabel>
        <skos:definition>A Real Estate Operator is a professional or entity responsible for the day-to-day management, maintenance, and operations of real estate properties. This role includes overseeing property functions, ensuring tenant satisfaction, handling leasing activities, and maintaining the physical condition of the property.</skos:definition>
        <skos:prefLabel>Property Manager</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Ovn011buRjUrj091TrGfG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Ovn011buRjUrj091TrGfG">
