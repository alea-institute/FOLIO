            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Criminal Misdemeanor Offenses</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Criminal Misdemeanor Offenses</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Delitos criminais de menor gravidade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Delitos menores penales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Delitos menores penales</skos:altLabel>
