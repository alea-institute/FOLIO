    <!-- https://folio.openlegalstandard.org/RDWn66DRoabJ8uDfGxuuKEQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDWn66DRoabJ8uDfGxuuKEQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDo00CLlnwYJISZbyYUTXTA"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm"/>
        <rdfs:label>Chronic Hyperglycemia</rdfs:label>
        <skos:altLabel>Persistent Hyperglycemia</skos:altLabel>
        <skos:definition>Chronic Hyperglycemia refers to longstanding abnormally high levels of blood glucose, which leads to long-term diabetic complications by disrupting nerve and blood vessel functioning. This disruption affects multiple body systems, resulting in various complications such as diabetic peripheral neurovascular disease, diabetic retinopathy, coronary artery disease, peripheral vascular disease, diabetic gastroparesis, diabetic nephropathy, poorly healing skin infections, diabetic neuropathies, and cognitive impairments, including depression and anxiety.</skos:definition>
        <skos:prefLabel>Long-Term Hyperglycemia</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDWopPyVcjBdC5nr5s8OBWz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDWopPyVcjBdC5nr5s8OBWz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
        <rdfs:label>Material Business Change</rdfs:label>
        <skos:altLabel>Fundamental Enterprise Modifications</skos:altLabel>
        <skos:altLabel>Major Organizational Shifts</skos:altLabel>
        <skos:altLabel>Substantial Corporate Alterations</skos:altLabel>
        <skos:definition>Material Business Changes refer to significant alterations in a company&apos;s structure, operations, or financial position that could substantially impact its value, performance, or risk profile. These changes are often substantial enough to require disclosure to shareholders and potentially regulatory bodies.</skos:definition>
        <skos:example>Adoption Of A New Business Model</skos:example>
        <skos:example>Divestiture Of A Major Business Unit</skos:example>
        <skos:example>Major Relocation Of Operations</skos:example>
        <skos:example>Significant Change In Product Or Service Offerings</skos:example>
        <skos:example>Significant Changes In Financial Structure Or Funding</skos:example>
        <skos:example>Substantial Rebranding Or Corporate Identity Change</skos:example>
        <skos:example>Substantial Shift In Target Market Or Customer Base</skos:example>
    </owl:Class>
    


