        <skos:altLabel xml:lang="de-de">Einwand gegen Anspruch</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Objection to Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oposición a la Reclamación</skos:altLabel>
