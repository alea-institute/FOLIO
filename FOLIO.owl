            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Requests for Admission</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anträge auf Zulassung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demandes d&apos;admission</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedidos de Admissão</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Requerimientos de admisión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Requerimientos de admisión</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Requests for Admission</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשות לכניסה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रवेश के लिए अनुरोध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">承认请求</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">認める請求</skos:altLabel>
        <skos:definition>Requests for Admission are a type of discovery document used in legal proceedings where one party requests that the other party admit or deny certain facts or allegations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHKIxe9zwJeOxIUyiEVQbO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHKIxe9zwJeOxIUyiEVQbO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7IaNyshrHiqug0LlmK6J2"/>
        <dc:identifier>EDU-JUNC</dc:identifier>
        <rdfs:label>Junior Colleges Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fachhochschulindustrie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de Colegios Comunitarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Colegios de Educación Media Superior</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des collèges juniors</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de faculdades comunitárias</skos:altLabel>
        <skos:altLabel>Junior Colleges</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Junior Colleges Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית מכללות קהילתיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">जूनियर कॉलेज उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">大专院校行业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">短期大学産業</skos:altLabel>
        <skos:definition>This industry comprises establishments primarily engaged in furnishing academic, or academic and technical, courses and granting associate degrees, certificates, or diplomas below the baccalaureate level. The requirement for admission to an associate or equivalent degree program is at least a high school diploma or equivalent general academic training.</skos:definition>
        <skos:hiddenLabel>JUNC</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHKKVG38PV9rNF9qs8et19 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHKKVG38PV9rNF9qs8et19">
