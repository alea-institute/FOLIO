        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:label>Materiality Scrapes</rdfs:label>
        <skos:altLabel xml:lang="es-es">Calificación de Efecto Adverso Material</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Calificación de Efecto Adverso Material</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel>Material Adverse Effect Qualification</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Qualification</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Qualification d&apos;un effet défavorable important</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Qualificação de Efeito Adverso Material</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Qualifizierung eines wesentlichen nachteiligen Effekts</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כשל חומרי מוביל לכל השלכות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव योग्यता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质不利影响限定</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の限定</skos:altLabel>
        <skos:definition>Materiality Scrapes (aka Material Adverse Effect (MAE) Qualification) refers to a provision in a contract that allows a party to back out of the agreement if certain negative events or changes occur that would significantly impact the value or profitability of the subject matter of the contract.</skos:definition>
    </owl:Class>
    


