    <!-- https://folio.openlegalstandard.org/R7XpYe4Rz8RjUeP6NgDxbQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7XpYe4Rz8RjUeP6NgDxbQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8A3IWnCF4w7p6lvVLLqAQa"/>
        <rdfs:label>Corporal Punishment Claims</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ansprüche wegen körperlicher Züchtigung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Corporal Punishment Claims</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de Castigo Corporal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamaciones de Castigo Corporal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de punição corporal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations de châtiments corporels</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות על עונש גופני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शारीरिक दंड दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">体罚索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">体罰請求</skos:altLabel>
        <skos:definition>A claim made against an educational institution or its staff for the use of physical discipline on a student, falling under the category of Education Liability and specifically related to Corporal Punishment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7XyscaXi5Cnm09a2Eu2TyI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7XyscaXi5Cnm09a2Eu2TyI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1EbxjQwzgikspixQygdfK"/>
        <dc:source>Fed. R. Evid. 803(3)</dc:source>
        <rdfs:label>Existing Mental, Emotional, Physical Condition</rdfs:label>
        <skos:altLabel>Present State of Mind or Body</skos:altLabel>
        <skos:altLabel>Then-Existing Mental, Emotional, or Physical Condition</skos:altLabel>
        <skos:definition>Existing Mental, Emotional, or Physical Condition is a hearsay exception that allows the admission of statements that describe the declarant&apos;s then-existing state of mind, feeling, sensation, or bodily health. This exception is based on the belief that such statements are reliable because they are made in the moment and are unlikely to be fabricated.</skos:definition>
    </owl:Class>
    


