        <rdfs:label>Grand Jury Privilege</rdfs:label>
        <skos:altLabel xml:lang="de-de">Geheimhaltungspflicht der Geschworenenjury</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Grand Jury Privilege</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Le privilège du grand jury</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Privilegio del Gran Jurado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Privilegio del Gran Jurado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Privilégio do Grande Júri</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פרטיות חקירת הג&apos;ורי הגדול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ग्रैंड ज्यूरी विशेषाधिकार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">大陪审团特权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">大陪審特権</skos:altLabel>
        <skos:definition>The Grand Jury Privilege is a legal protection that allows a grand jury to keep their proceedings and deliberations confidential, even from the court and the public.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDODanJ77wQ3yiVv44B1ZK5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDODanJ77wQ3yiVv44B1ZK5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aoLYQoIooB9xRkhiMtgR4"/>
        <rdfs:label>Blind</rdfs:label>
        <skos:altLabel>Absolute Blindness</skos:altLabel>
        <skos:altLabel>Complete Blindness</skos:altLabel>
        <skos:altLabel>Total Vision Loss</skos:altLabel>
        <skos:altLabel>Total Visual Impairment</skos:altLabel>
        <skos:definition>Total Blindness, also referred to as Blindness, is a condition where an individual has complete loss of vision, with no perception of light or visual images. This severe form of visual impairment significantly impacts daily activities, communication, and mobility, requiring the use of adaptive strategies and assistive technologies.</skos:definition>
        <skos:prefLabel>Total Blindness</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOHs1daxOerAWAOd0WNYpN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOHs1daxOerAWAOd0WNYpN">
