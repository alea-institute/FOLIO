    <!-- https://folio.openlegalstandard.org/RF64b891A8bb116842aAFd4b -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RF64b891A8bb116842aAFd4b">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R15Bf89EBBcdd05Ca4462a0b"/>
        <dc:identifier>US-FD-DOL-DOLCRC</dc:identifier>
        <rdfs:label>Civil Rights Center</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Centre des droits civils</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Centro de Derechos Civiles</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Centro de Derechos Civiles</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Centro de Direitos Civis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Civil Rights Centre</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zentrum für Bürgerrechte</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מרכז זכויות אזרחיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नागरिक अधिकार केंद्र</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">市民権センター</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民权中心</skos:altLabel>
        <skos:definition>The Department of Labor Civil Rights Center (CRC) develops, administers, and enforces Departmental policies, practices, and procedures pursuant to Title VI and Title VII of the Civil Rights Act of 1964, as amended; Section 188 of the Workforce Investment Act (WIA), as amended; the Rehabilitation Act of 1973, as amended; the Age Discrimination Act of 1975, as amended; the Age Discrimination in Employment Act of 1967, as amended; the Equal Pay Act of 1963; Title IX of the Education Amendments of 1972, as amended; Title II of the Americans with Disabilities Act of 1990, as amended; the Civil Service Reform Act of 1978; the Civil Rights Act of 1991; the Notification and Federal Employee Antidiscrimination and Retaliation (No FEAR) Act; and related statutes and Executive Orders.</skos:definition>
        <skos:hiddenLabel>DOLCRC</skos:hiddenLabel>
        <skos:prefLabel>Civil Rights Center</skos:prefLabel>
    </owl:Class>
    


