        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDtF3TBuYodaMEI2cA1Hb4H"/>
        <rdfs:label>Motion for Judge Recusal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ablehnung des Richters</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de recusación del juez</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de recusación del juez</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Judge Recusal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Recusa do Juiz</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en récusation du juge</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לפטור השופט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायाधीश अस्थायी अस्थायीकरण के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法官回避动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判官の回避申立</skos:altLabel>
        <skos:definition>A Motion for Judge Recusal, also known as a Motion to Reassign, is a legal document filed by a party in a case requesting that the presiding judge be removed from the case due to a conflict of interest or bias.</skos:definition>
        <skos:prefLabel>Motion to Reassign</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9LuuJhTSrv1G2TDsBdZMn6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9LuuJhTSrv1G2TDsBdZMn6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Mutual Nondisparagement Clause</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cláusula de no denigración mutua</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de no denigración mutua</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mutual Nondisparagement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף חוזי לא פגיעה משותף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सहमति आधारित अपमानरहित शर्त</skos:altLabel>
        <skos:definition>A mutual nondisparagement clause is a provision in a contract that prohibits both parties from making negative or derogatory statements about each other.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9M1ZkojRm51bye8uZJ4SrQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9M1ZkojRm51bye8uZJ4SrQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3391bdB1A2adE51071C7cf7"/>
        <rdfs:label>New York Court of Claims</rdfs:label>
        <skos:definition>The New York Court of Claims is a specialized court within the New York State Courts system that has jurisdiction over claims against the state, including personal injury and property damage cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9M22nIQgd72E0PSrkHmrxX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9M22nIQgd72E0PSrkHmrxX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7OtUosForl1Zon7KU3gQQR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RcPmc5tXDkOmcv3W8TxwTO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Real Estate Developer</rdfs:label>
        <skos:altLabel>Real Estate Entrepreneur</skos:altLabel>
        <skos:definition>A Real Estate Developer is a professional or company that acquires land, finances real estate deals, builds or renovates properties, and arranges for their sale or lease. This role involves various stages of development, including market research, site selection, obtaining permits, and managing construction projects.</skos:definition>
        <skos:example>A commercial real estate developer renovates an old warehouse into office spaces and leases them to businesses.</skos:example>
        <skos:prefLabel>Property Developer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9M8l3BPpLecmPvxu8DRmPs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9M8l3BPpLecmPvxu8DRmPs">
