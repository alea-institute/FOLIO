        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCSG4k3ah1Pu5YgPexPgOmL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>D.D.S. (Doctor of Dental Surgery)</rdfs:label>
        <skos:altLabel>Doctor of Dental Surgery</skos:altLabel>
        <skos:definition>The suffix &quot;D.D.S.&quot; stands for &quot;Doctor of Dental Surgery&quot; and is used after a person&apos;s name to indicate that they have completed the necessary education and training to practice dentistry. This suffix signifies the individual&apos;s credentials in the field of dental care and is commonly used in medical settings, academic contexts, and formal documents</skos:definition>
        <skos:prefLabel>D.D.S</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgB04vKgOwyurcvRvWsd3I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgB04vKgOwyurcvRvWsd3I">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCZQdKH230Tk1EJrtOxbvqm"/>
        <rdfs:label>Boston Municipal Court</rdfs:label>
        <skos:definition>Boston Municipal Court is a court within the Massachusetts Trial Court system that has jurisdiction over criminal and civil cases within the city of Boston.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgEIRezlC58UiZHZ0GyrDM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgEIRezlC58UiZHZ0GyrDM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLxL22W67GcWCpN6VKZd50"/>
        <rdfs:label>Registration Rights Agreement</rdfs:label>
        <skos:definition>Registration Rights Agreement is a contractual agreement between the issuer of securities and the security holders that obligates the issuer to register the securities under relevant securities laws, allowing for public trading. Typically, it benefits investors by providing liquidity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgHPUjj8sMRl3Do8koXLiG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgHPUjj8sMRl3Do8koXLiG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC0D5sYWEbeH4f6F0f70uMz"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKKRGOkIme6pnG2BSePt1Z"/>
        <rdfs:label>Intellectual Property License Agreement</rdfs:label>
        <skos:definition>An Intellectual Property License Agreement grants a party the right to use a specific intellectual property owned by another party under specified conditions. It doesn&apos;t transfer ownership but allows for certain usages, often in exchange for compensation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCgLTdoBRrLXrkSFViFsMMm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCgLTdoBRrLXrkSFViFsMMm">
