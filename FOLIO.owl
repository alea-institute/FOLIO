        <skos:altLabel xml:lang="hi-in">अनुसूचियों और बयान विस्तार आवाहन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">スケジュールおよび声明の延長動議</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">时间表和声明延期动议</skos:altLabel>
        <skos:definition>A Schedules and Statements Extension Motion is a request made in a bankruptcy case to extend the deadline for filing schedules and statements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRR14Lsvmr2nP6GEOyoZPu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRR14Lsvmr2nP6GEOyoZPu">
