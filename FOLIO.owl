        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Control of Property Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de contrôle de propriété</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Control de Propiedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Control de Propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de controle de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Control of Property Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kontrollklausel für Eigentum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שליטה על נכסים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संपत्ति नियंत्रण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">財産管理条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">财产控制条款</skos:altLabel>
        <skos:definition>A Control of Property Clause is a provision in a contract that grants one party the authority to manage or regulate a specific property or asset, typically for the duration of the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9kj3rbJwO4aZsqQhukBD7y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9kj3rbJwO4aZsqQhukBD7y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RouKBMqFNMZxi21EPh6JJ6"/>
        <rdfs:label>Medical Expenses</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Despesas médicas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais médicaux</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gastos Médicos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gastos Médicos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Medical Expenses</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Medizinische Ausgaben</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאות רפואיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चिकित्सा खर्च</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">医疗费用</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">医療費</skos:altLabel>
        <skos:definition>Medical Expenses refer to the costs incurred for medical treatment and care, including both past and future expenses, as a result of an injury or illness, and are considered a type of economic damage in legal cases.</skos:definition>
    </owl:Class>
    


