        <skos:altLabel xml:lang="pt-br">Reivindicação de roubo de salário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de vol de salaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wage Theft Claim</skos:altLabel>
