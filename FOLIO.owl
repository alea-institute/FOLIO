        <rdfs:label>Minnesota District Court</rdfs:label>
        <skos:definition>The Minnesota District Court is a trial court in the state of Minnesota that has jurisdiction over civil and criminal cases within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RxMGpB33xjOdBX3hTCQF20 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RxMGpB33xjOdBX3hTCQF20">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV"/>
        <rdfs:label>Parking - Real Estate Asset</rdfs:label>
        <skos:altLabel>Car Park</skos:altLabel>
        <skos:altLabel>Parking Facility</skos:altLabel>
        <skos:altLabel>Vehicle Storage Area</skos:altLabel>
        <skos:definition>Parking, in the context of real estate assets, refers to designated areas or structures designed for the temporary storage of vehicles. This type of real estate asset can include surface lots, multi-story garages, or underground facilities, often generating revenue through hourly, daily, or monthly fees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RxMOaT78rtx8cK3CsgGjxp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RxMOaT78rtx8cK3CsgGjxp">
