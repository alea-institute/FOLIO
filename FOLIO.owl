        <skos:altLabel xml:lang="zh-cn">运动设置属性值</skos:altLabel>
        <skos:definition>A motion setting property value is a type of motion filed in a bankruptcy case that seeks to determine the value of a particular property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSrukbySsHLNTSeIzryIrD -->

