        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8WVl8JMk7gYU2NB0NpirR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Affiliate Debtor</rdfs:label>
        <skos:definition>An affiliate debtor is a company or entity that is related to another debtor through common ownership, control, or a significant financial interest. In bankruptcy proceedings, affiliate debtors may file jointly or have their cases consolidated to streamline the process and address interrelated financial issues.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCq95WVL6xiE3A4pfZDOCa6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCq95WVL6xiE3A4pfZDOCa6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hWq9dSn0Su2Y59JE48V3H"/>
        <rdfs:label>Sponsor</rdfs:label>
        <skos:altLabel>Capital Provider</skos:altLabel>
        <skos:altLabel>Equity Sponsor</skos:altLabel>
        <skos:altLabel>Financial Backer</skos:altLabel>
        <skos:altLabel>Funding Partner</skos:altLabel>
        <skos:definition>A Sponsor in a deal (e.g., merger, acquisition) refers to an individual or entity that provides the financial backing needed to complete the deal. Sponsors typically include private equity firms, venture capitalists, or wealthy individuals who supply capital and strategic guidance.</skos:definition>
        <skos:example>Private Equity Firm Funding A Buyout</skos:example>
        <skos:example>Venture Capitalist Backing A Start-Up Acquisition</skos:example>
        <skos:example>Wealthy Individual Providing Capital For An Acquisition</skos:example>
    </owl:Class>
    


