            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Governmental Body</rdfs:label>
        <skos:altLabel>Governmental Body</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Governmental Body</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Organisme gouvernemental</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Organismo gubernamental</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Organismo gubernamental</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Regierungsbehörde</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Órgão governamental</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גוף ממשלתי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सरकारी निकाय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">政府机构</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">政府機関</skos:altLabel>
        <skos:definition>Administrative entities of government or state agency or appointed commission, as a permanent or semi-permanent governmental organization that oversees or administers specific governmental functions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQGv9RRvzwjKHirKBIw4Wg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQGv9RRvzwjKHirKBIw4Wg">
