        <rdfs:label>Countervailing Duty Payment</rdfs:label>
        <skos:altLabel>Countervailing Tariff Payment</skos:altLabel>
        <skos:altLabel>Trade Remedy Duty Payment</skos:altLabel>
        <skos:altLabel>Trade Subsidy Duty Payment</skos:altLabel>
        <skos:definition>A Countervailing Duty (CVD) Payment refers to the payment made by importers to the government as a result of countervailing duties imposed on imported goods that benefit from foreign government subsidies. These payments aim to counteract the effects of such subsidies, ensuring fair competition for domestic producers.</skos:definition>
        <skos:prefLabel>CVD Payment</skos:prefLabel>
    </owl:Class>
    


