        <skos:altLabel xml:lang="es-mx">Cláusula de Reglas y Regulaciones de la Compañía</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Regras e Regulamentos da Empresa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Company Rules and Regulations Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu Unternehmensregeln und -vorschriften</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כללי ותקנות החברה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कंपनी नियम और विनियम धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">企業規則および規定条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公司规章制度条款</skos:altLabel>
        <skos:definition>A Company Rules and Regulations Clause is a provision in a contract that outlines the specific policies and procedures that govern the behavior and actions of employees within a company.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8j2iBp5HjvFDCNuhM0PqQK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8j2iBp5HjvFDCNuhM0PqQK">
