        <skos:altLabel xml:lang="pt-br">sindi</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">シンド語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">信德语</skos:altLabel>
        <skos:definition>Sindhi (Language) is a structured system of communication that consists of grammar and vocabulary, and is spoken in the Sindh province of Pakistan and parts of India.</skos:definition>
    </owl:Class>
    


