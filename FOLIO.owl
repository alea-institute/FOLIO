    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Mw0y1sYeTkDl6Po3b4ViW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBkzNeCV70lWNDKaIVq358i"/>
        <rdfs:subClassOf>
            <owl:Restriction>
