        <rdfs:label>Kaibab Band of Paiute Indians of the Kaibab Indian Reservation</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCs2kzwpPKOdGEpbe0B13Ik -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCs2kzwpPKOdGEpbe0B13Ik">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r"/>
        <rdfs:label>Exchange Debt for Debt</rdfs:label>
        <skos:altLabel>Debt Substitution</skos:altLabel>
        <skos:altLabel>Debt-to-Debt Exchange</skos:altLabel>
        <skos:definition>An asset exchange involving the replacement of one form of debt with another. This often aims to take advantage of better terms or to extend the maturity of the debt.</skos:definition>
        <skos:prefLabel>Debt Refinancing Swap</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCs5oguF0b3mA15pozhbhFu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCs5oguF0b3mA15pozhbhFu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bS3yb1nTD8lCzWFVFMZ0c"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2xwWqnYhIj0tyrPJrmege"/>
        <rdfs:label>Structure Diagram Management</rdfs:label>
        <skos:definition>Structure Diagram Management refers to the management of diagrams that represent the structure of legal transactions and solutions, and is a subcategory of Legal Transaction Management and Legal Point Solutions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCs6PrRlQMVdPf1fvEelIqS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCs6PrRlQMVdPf1fvEelIqS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
        <rdfs:label>Business Visa Exception</rdfs:label>
        <skos:altLabel>Business Waiver</skos:altLabel>
        <skos:altLabel>WB</skos:altLabel>
        <skos:definition>A Business Visa Exemption refers to a special arrangement where nationals from certain countries are allowed to enter another country for short-term business activities without the need for a traditional business visa. This is often part of broader visa-free entry agreements or reciprocal arrangements between countries, and is generally time-limited</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCs6etFXnGmkzFlg08S0aqs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCs6etFXnGmkzFlg08S0aqs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mCB7w7tqtq6yOWvTxdMJI"/>
        <rdfs:label>Satellite Broadcast</rdfs:label>
        <skos:altLabel>Satellite Communication Broadcast</skos:altLabel>
        <skos:altLabel>Satellite Radio Broadcast</skos:altLabel>
        <skos:altLabel>Satellite TV Broadcast</skos:altLabel>
        <skos:definition>A Satellite Broadcast is the transmission of television and radio signals via communication satellites, delivering content to a wide audience across vast geographical areas. This form of broadcasting provides access to various programming, including live events, news, entertainment, and educational shows, typically received through satellite dishes and decoders.</skos:definition>
        <skos:prefLabel>Satellite Transmission</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCsAVtlCawxj4NWI5z3S5mk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCsAVtlCawxj4NWI5z3S5mk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKT1I6J8ce2Gs6xwwFcUTr"/>
        <rdfs:label>Appellate Argument Practice</rdfs:label>
        <skos:altLabel>Oral Argument</skos:altLabel>
        <skos:altLabel>Appellate Argument</skos:altLabel>
        <skos:altLabel>Appellate Argument Service</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Appellate Argument Practice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Berufungsargumentationspraxis</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de l&apos;argumentation en appel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de argumentación de apelación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de argumentación de apelación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de argumentação de apelação</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול טיעוני אפל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपील तर्क अभ्यास</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">上诉辩论实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴論述の実践</skos:altLabel>
        <skos:definition>Appellate Argument Practice refers to the specialized legal practice of preparing and presenting arguments before an appellate court, with the aim of persuading the court to overturn or modify a lower court&apos;s decision.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCsHBFMC8MvFbusiy8vjUpg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCsHBFMC8MvFbusiy8vjUpg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Acceleration Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Acceleration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Beschleunigungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;accélération</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Aceleración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Aceleración</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de aceleração</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף האצת תשלום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">त्वरण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加速条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">加速条項</skos:altLabel>
        <skos:definition>An acceleration clause is a provision in a contract that allows the creditor to demand immediate payment of the entire outstanding balance if the debtor fails to meet certain obligations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCsMg9PSHTWeBjdWc5KTPNf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCsMg9PSHTWeBjdWc5KTPNf">
