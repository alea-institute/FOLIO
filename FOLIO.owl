        <rdfs:label>State Judicial Branch</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCjRBeRG9kQRIW64WMouPTn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCjRBeRG9kQRIW64WMouPTn">
