        <skos:altLabel xml:lang="fr-fr">Documents immobiliers</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Immobilienunterlagen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Real Estate Documents</skos:altLabel>
