        <skos:altLabel xml:lang="es-mx">Umbral de Evento Interviniente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סף אירוע מתערב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हस्तक्षेप घटना अधिकतम सीमा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">“干预事件”门槛</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">介入イベントの閾値</skos:altLabel>
        <skos:definition>Intervening Event Thresholds refer to specific criteria or conditions that must be met in order for an event to be considered an intervening event, which is an event that occurs after the signing of a legal agreement and may affect its performance or outcome.</skos:definition>
    </owl:Class>
    


