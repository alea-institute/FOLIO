        <rdfs:label>No Liens Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause sans privilèges</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula sem ônus</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula sin gravámenes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula sin gravámenes</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel ohne Pfandrechte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Liens Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ללא משיכות</skos:altLabel>
