        <rdfs:label>Motion to Extend Automatic Stay</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung des automatischen Aufschubs</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para extender la suspensión automática</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender la suspensión automática</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour prolonger le séjour automatique</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Automatic Stay</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para prorrogar a suspensão automática</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה להארכת השהיית אוטומטית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वचालित रूप से रोक बढ़ाने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长自动停留动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自動滞在の延長に関する動議</skos:altLabel>
        <skos:definition>A Motion to Extend Automatic Stay is a request made in a bankruptcy case to prolong the period during which creditors are prohibited from taking action against the debtor or the debtor&apos;s property without permission from the bankruptcy court.</skos:definition>
    </owl:Class>
    


