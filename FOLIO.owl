        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RzLNZvmvjHqtxVfg3yhhM9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Reputation Evidence Objective</rdfs:label>
        <skos:altLabel>Character Evidence Purpose</skos:altLabel>
        <skos:altLabel>Character Proof Standard</skos:altLabel>
        <skos:altLabel>Reputation Testimony Goal</skos:altLabel>
        <skos:definition>The reputation evidence objective is the legal principle that allows the use of a person&apos;s or entity&apos;s reputation as evidence in court to prove character or conduct in specific circumstances. This type of evidence is typically used to establish a pattern of behavior or to refute allegations, and is subject to strict rules to prevent unfair prejudice.</skos:definition>
    </owl:Class>
    


