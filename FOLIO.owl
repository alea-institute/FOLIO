    <!-- https://folio.openlegalstandard.org/RDAerGeqJPhby1NWQD5fX4A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDAerGeqJPhby1NWQD5fX4A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RraVbXQhP74EFbW54D6Why"/>
        <rdfs:label>Truancy</rdfs:label>
        <skos:definition>Truancy refers to the act of a student intentionally and regularly missing school without a valid excuse or permission from their parents or guardians. Truancy can have legal consequences, and it is often seen as a concern because it can negatively impact a student&apos;s education and future prospects.</skos:definition>
    </owl:Class>
    


