        <skos:altLabel xml:lang="he-il">סעיף רשימת שכירות מאושרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रमाणित किराया रोल क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">認定賃料ロール条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">认证租金清单条款</skos:altLabel>
        <skos:definition>A Certified Rent Roll Clause is a provision in a contract that requires the landlord to provide a verified list of current tenants and their corresponding rental rates.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rd5fNypp3e7sdvAs1Xmm4O -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rd5fNypp3e7sdvAs1Xmm4O">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCidddiy9X9fqxmBCyYguuE"/>
        <rdfs:label>Emergency Medical Treatment and Active Labor Act Claim</rdfs:label>
        <skos:altLabel>EMTALA Claim</skos:altLabel>
        <skos:altLabel>Emergency Medical Care Claim</skos:altLabel>
        <skos:altLabel>Emergency Medical Treatment Claim</skos:altLabel>
        <skos:definition>An EMTALA Claim arises when a healthcare provider fails to comply with the obligations under the Emergency Medical Treatment and Active Labor Act, which requires hospitals to provide emergency medical treatment to all individuals regardless of their ability to pay. This claim involves allegations that the hospital did not provide appropriate medical screening, necessary stabilizing treatment, or an appropriate transfer of an unstable patient.</skos:definition>
        <skos:prefLabel>EMTALA Violation Claim</skos:prefLabel>
    </owl:Class>
    


