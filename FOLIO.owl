        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11331"/>
        <rdfs:label>Logging</rdfs:label>
        <skos:definition>See industry description for 113310.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/sY75O0vaRV6RjqVlBdJbww -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/sY75O0vaRV6RjqVlBdJbww">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/iBaGk_UVSGu1aNwc9ugg9w"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=238130"/>
        <rdfs:label>Framing Contractors</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in structural framing and sheathing using materials other than structural steel or concrete. The work performed may include new work, additions, alterations, maintenance, and repairs.</skos:definition>
        <skos:example>Building framing (except structural steel)</skos:example>
        <skos:example>Foundation, building, wood, contractors</skos:example>
        <skos:example>Framing contractors</skos:example>
        <skos:example>Post framing contractors</skos:example>
        <skos:example>Steel framing contractors</skos:example>
        <skos:example>Wood frame component (e.g., truss) fabrication on site</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/s_xRj9vTQb-Km9GWHzQQsQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/s_xRj9vTQb-Km9GWHzQQsQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/FU1iai9aRCiAxRE3W8mGEQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=483211"/>
        <rdfs:label>Inland Water Freight Transportation</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in providing inland water transportation of cargo on lakes, rivers, or intracoastal waterways (except on the Great Lakes System).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/sdtUDJUnSnaex6TM9E5nYg -->

