        <rdfs:label>In Forma Pauperis</rdfs:label>
        <skos:altLabel>Court Fee Exemption</skos:altLabel>
        <skos:definition>In forma pauperis (also known as &quot;Fee Waiver&quot;) is a legal status granted to individuals who cannot afford the costs associated with legal proceedings, allowing them to proceed without paying fees. Courts typically require proof of indigency, and if granted, this status may cover court costs and other associated expenses</skos:definition>
        <skos:prefLabel>Fee Waiver</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RrUujWsbn4EF5HyLOudSkR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RrUujWsbn4EF5HyLOudSkR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDlYI2CbQn1u95Hs6otNU2O"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R81vvUfjtIynvagUMuGiDdV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/ReA0gy8mOLrqG7eTtFxnTh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Domestic Partner</rdfs:label>
        <skos:altLabel>Cohabitant</skos:altLabel>
        <skos:altLabel>Significant Other</skos:altLabel>
        <skos:definition>A Domestic Partner is an individual who lives with another person in a committed, intimate relationship akin to marriage but without legal recognition as a spouse. This status often provides certain legal benefits and responsibilities, such as healthcare decision-making rights and inheritance, similar to those available to married couples.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RrVGQBVLYqjSaNx4RPgCsw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RrVGQBVLYqjSaNx4RPgCsw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Dxh7cqKFFJ2jKNTvICMhf"/>
        <rdfs:label>Air Force</rdfs:label>
        <skos:altLabel>Air Corps</skos:altLabel>
        <skos:definition>An Air Force is the aerial warfare branch of a nation&apos;s armed forces, primarily responsible for military operations in the air and space domains. This organization maintains, trains, and equips air and space forces to defend national airspace, provide air support, and conduct strategic air operations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RrYc14SDMHyXfplFhiI2Ok -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RrYc14SDMHyXfplFhiI2Ok">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7PHFZzZmVmczzNQl6iZKsa"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDJ5gLF3diEDjeGSux0X4TJ"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>CRED-UCRD</dc:identifier>
        <rdfs:label>Unsecured Creditor</rdfs:label>
        <skos:altLabel xml:lang="es-es">Acreedor no garantizado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acreedor quirografario</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Credor quirografário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Créancier non garanti</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unbesicherter Gläubiger</skos:altLabel>
        <skos:altLabel>Unsecured Creditor</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unsecured Creditor</skos:altLabel>
        <skos:altLabel>Unsecured Lender</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גורם יוצא מן הכלל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">असुरक्षित ऋणदाता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无抵押债权人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">未担保債権者</skos:altLabel>
        <skos:definition>An unsecured creditor is an individual or institution that lends money without obtaining specified assets as collateral. If a borrower fails to make payment on debt that is unsecured, the creditor cannot take any of the borrower&apos;s assets without winning a lawsuit first.</skos:definition>
        <skos:hiddenLabel>UCRD</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RrZ8GeZZWg1PSJ3c7SqMwn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RrZ8GeZZWg1PSJ3c7SqMwn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5mVKmojg3FKSzxupI6FLy"/>
        <rdfs:label>Rights Offering Practice</rdfs:label>
        <skos:altLabel>Rights Offering</skos:altLabel>
        <skos:altLabel>Rights Offering Service</skos:altLabel>
        <skos:definition>Rights Offering Practice is a method of equity financing in which a company offers its existing shareholders the right to purchase additional shares of stock, typically at a discounted price, before the shares are offered to the general public. This practice allows companies to raise capital while giving current shareholders the opportunity to maintain their proportional ownership.</skos:definition>
        <skos:prefLabel>Rights Issue</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RraVbXQhP74EFbW54D6Why -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RraVbXQhP74EFbW54D6Why">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvV18Mbbb9FYFXbHt1inuL"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD13zMDizrkliKHQU6IzISt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDeZlellOVEkUBkTSbLgxUC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>School Disciplinary Event</rdfs:label>
        <skos:definition>School disciplinary events, such as suspension and expulsion, are actions taken by educational institutions in response to student misconduct or rule violations. Suspension typically involves a temporary removal of a student from school for a specific period, while expulsion is a more severe action resulting in the student&apos;s permanent removal from the school. These measures are intended to maintain a safe and conducive learning environment but must adhere to legal and due process requirements.</skos:definition>
    </owl:Class>
    


