        <rdfs:label>Independent Medical Examination</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Exame médico independente</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Examen Médico Independiente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Examen Médico Independiente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Examen médical indépendant</skos:altLabel>
        <skos:altLabel>IME</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Independent Medical Examination</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unabhängige medizinische Untersuchung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בדיקת רפואית עצמאית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वतंत्र चिकित्सा परीक्षण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">独立医学检查</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独立医療検査</skos:altLabel>
        <skos:definition>An Independent Medical Examination (IME) is a medical evaluation performed by a neutral third-party physician to assess an individual&apos;s injuries or medical condition, often used in legal proceedings.</skos:definition>
    </owl:Class>
    


