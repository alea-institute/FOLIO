        <rdfs:label>Motion to Proceed in Forma Pauperis</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Fortsetzung in Forma Pauperis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para proceder en forma pauperis</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para proceder en forma pauperis</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour procéder en forma pauperis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Proceed in Forma Pauperis</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para prosseguir em forma pauperis</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להמשך בפורמה פופריס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फॉर्मा पॉवेरिस में आगे बढ़ने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">以贫穷申请程序继续动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">貧困者による手続き継続の申立て</skos:altLabel>
        <skos:definition>A Motion to Proceed in Forma Pauperis is a legal request made by an individual who is unable to afford the fees associated with a court case, asking the court to waive or defer those fees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9JZE1Cazcu0al05drMcaez -->

