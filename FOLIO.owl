        </rdfs:subClassOf>
        <rdfs:label>Condominium Real Estate Asset</rdfs:label>
        <skos:altLabel>Condo</skos:altLabel>
        <skos:definition>A condominium real estate asset refers to a type of property ownership where an individual owns a unit within a larger building or complex and shares ownership of common areas with other unit owners. Unlike a single-family home, where the owner controls the entire property, in a condominium, the individual unit ownership is coupled with a proportional interest in communal facilities like hallways, gardens, and amenities.</skos:definition>
        <skos:prefLabel>Strata Title Unit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83sNnwSvTMsV9jowtvS2cv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83sNnwSvTMsV9jowtvS2cv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:label>Large Trader Identification Form</rdfs:label>
        <skos:definition>A Large Trader Identification Form is a filing required by the financial regulator (e.g., U.S. Securities and Exchange Commission (SEC)) from large traders, defined as those whose transactions in National Market System (NMS) securities equal or exceed specified thresholds. The form provides the financial regulator with information about the large trader&apos;s identity, business activities, and affiliates to enhance market surveillance and analyze the impact of large traders on the securities market.</skos:definition>
        <skos:prefLabel>Form 13H</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83spgNoduHRVfnLcxe6nO5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83spgNoduHRVfnLcxe6nO5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB4cFSLB4xvycDlKv73dOg6"/>
        <rdfs:label>LegalXML OASIS SCHEMA</rdfs:label>
        <skos:definition>A LegalXML OASIS Schema is a standardized format for representing legal information and documents, developed by the Organization for the Advancement of Structured Information Standards (OASIS), and is a component of the Standards Compatibility ontology.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83u2PaBNXclAGLdTJGeFiG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83u2PaBNXclAGLdTJGeFiG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aVRgLAjmuf0OiloIoc9pm"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Limited_voting"/>
        <rdfs:label>Limited Voting System</rdfs:label>
        <skos:altLabel>Minority Representation Voting</skos:altLabel>
        <skos:altLabel>Partial Voting System</skos:altLabel>
        <skos:definition>The limited voting system is an electoral method where voters have fewer votes than the number of available seats, allowing for the possibility of minority representation. This system is designed to prevent any single group from winning all the seats and is often used to promote more diverse representation.</skos:definition>
        <skos:example>Alabama State Board of Education Elections: Limited voting used to ensure minority representation</skos:example>
        <skos:example>Gibraltar&apos;s Parliamentary Elections: Voters have ten votes for seventeen seats</skos:example>
        <skos:example>Spain&apos;s Senate Elections: Voters have two or three votes for four seats in each province</skos:example>
        <skos:prefLabel>Partial Block Voting</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83uKCuShO8KiSdAlJZg8Ie -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83uKCuShO8KiSdAlJZg8Ie">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UELEvq0EkRnKE9zMt5IfZ"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:label>CFIUS Clearance</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Autorisation CFIUS</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Autorización CFIUS</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Autorización CFIUS</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Autorização CFIUS</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">CFIUS Clearance</skos:altLabel>
        <skos:altLabel xml:lang="de-de">CFIUS-Freigabe</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">CFIUSクリアランス</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">CFIUS清算</skos:altLabel>
        <skos:altLabel>Committee on Foreign Investment in the United States</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אישור CFIUS</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सीएफआईयूएस क्लियरेंस</skos:altLabel>
        <skos:definition>CFIUS Clearance is the approval granted by the Committee on Foreign Investment in the United States for a foreign investment in a US business, which is subject to review and scrutiny to ensure that it does not pose a threat to national security.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83xGWKEv7xbcWq5sWqtxMB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83xGWKEv7xbcWq5sWqtxMB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rh51oMpYnnkIQkUt41V76O"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBCzyIAi2Hjl80hfQr8wAMR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>Fed. R. Evid. 803(6).</dc:source>
        <rdfs:label>Business Record Document</rdfs:label>
        <skos:altLabel>Commercial Record</skos:altLabel>
        <skos:definition>A business record document is a written or electronic record created and maintained by a business organization in the regular course of its activities, which can be used as evidence in legal proceedings. These records are considered reliable and admissible in court under the business records exception to the hearsay rule.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83yUF8cXJjshBdF83Knjbh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83yUF8cXJjshBdF83Knjbh">
