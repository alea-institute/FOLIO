    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7x6g9iAXmUiJlXphvLtQcO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7x6g9iAXmUiJlXphvLtQcO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8A4jLWkG2KpI6wfAznsSCx"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Additur</rdfs:label>
        <skos:altLabel>Court-Ordered Damages Increase</skos:altLabel>
        <skos:altLabel>Enhanced Damages Award</skos:altLabel>
        <skos:altLabel>Judicial Increase In Damages</skos:altLabel>
        <skos:definition>Additur refers to a court&apos;s power to increase the amount of damages awarded by a jury if the judge finds the award insufficient. This practice is primarily used in the United States and is not recognized in federal courts due to constitutional concerns regarding the Seventh Amendment.</skos:definition>
    </owl:Class>
    


