        <skos:altLabel xml:lang="zh-cn">执法事件跟踪号码</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法執行事件追跡番号</skos:altLabel>
        <skos:definition>The unique tracking number associated with the incident that initiated the case; distinct from the arrest tracking number.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hLmvLzjaXGJaLWOfzhGnD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hLmvLzjaXGJaLWOfzhGnD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Matinecock</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hMLiAtJxKxraEG4xHqW1w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8hMLiAtJxKxraEG4xHqW1w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBEXxc9B6kR2p0BMwGjhWGW"/>
        <dc:description>An immigration lottery is a system used by some countries, including the United States, to allocate visas or permits to foreign nationals based on a random selection process. In the U.S., the H1B lottery is a well-known example, where a limited number of H1B visas for skilled workers are distributed through a random selection process due to high demand exceeding the annual cap.</dc:description>
        <rdfs:label>Immigration Lottery</rdfs:label>
        <skos:example>Diversity Lottery</skos:example>
        <skos:example>H1B Visa Lottery</skos:example>
        <skos:example>Visa Lottery</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8hMUBQl1QqffJy84kbpvQ0 -->

