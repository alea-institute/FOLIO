        <rdfs:label>Pohnpeian</rdfs:label>
        <skos:altLabel xml:lang="de-de">Pohnpeianisch</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pohnpeiano</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Ponapéen</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ポンペイア語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">波纳佩语</skos:altLabel>
        <skos:definition>A language spoken in the Federated States of Micronesia, specifically on the island of Pohnpei.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R72akMxd6pB03DZBIZ4eCxL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R72akMxd6pB03DZBIZ4eCxL">
