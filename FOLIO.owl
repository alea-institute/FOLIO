        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnfzkAKrjy32YoweXnzDjp"/>
        <rdfs:label>Gross Revenue</rdfs:label>
        <skos:altLabel>Gross Income</skos:altLabel>
        <skos:definition>The aggregate income generated from all forms of engagement before any costs, taxes, or deductions, offering a preliminary look at financial performance.</skos:definition>
    </owl:Class>
    


