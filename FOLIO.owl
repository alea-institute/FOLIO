        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
        <rdfs:label>AI Model</rdfs:label>
        <skos:altLabel>Computational Model</skos:altLabel>
        <skos:altLabel>Machine Learning Model</skos:altLabel>
        <skos:definition>An AI Model is a core component of an AI system used to make inferences from inputs to produce outputs. It characterizes an input-to-output transformation designed to perform a specific computational task of the AI system, such as classifying an image, predicting the next word in a sequence, or selecting a robot&apos;s next action based on its state and goals.</skos:definition>
    </owl:Class>
    


