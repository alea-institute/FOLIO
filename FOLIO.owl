    <owl:Class rdf:about="https://folio.openlegalstandard.org/R85616946C0e47A2bb35Ea2d">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0DB70442Cf8b73D9275F14a"/>
        <dc:identifier>US-FD-DOJ-BOP</dc:identifier>
        <rdfs:label>Bureau of Prisons</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bundesgefängnisbehörde</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Bureau de Prisiones</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Bureau fédéral des prisons</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bureau of Prisons</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Departamento de Prisões</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Prisiones</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משרד הכלאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ब्यूरो ऑफ़ प्रिसन्स</skos:altLabel>
