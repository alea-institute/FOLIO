        <skos:altLabel xml:lang="ja-jp">制裁請求書</skos:altLabel>
        <skos:definition>A Motion for Sanctions is a formal request made to a court asking for punishment or penalties to be imposed on a party for failing to comply with discovery or other procedural rules during a legal proceeding.</skos:definition>
    </owl:Class>
    


