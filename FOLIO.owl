        <dc:identifier>US-FD-DOJ-DEA-ONSI</dc:identifier>
        <rdfs:label>Office of National Security Intelligence</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Bureau du renseignement de sécurité nationale</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro für nationale Sicherheitsintelligenz</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escritório de Inteligência de Segurança Nacional</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Office of National Security Intelligence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Inteligencia de Seguridad Nacional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina de Inteligencia de Seguridad Nacional</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משרד המודיעין לביטחון לאומי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">राष्ट्रीय सुरक्षा खुफिया ब्यूरो</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">国家安全情報局</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">国家安全情报办公室</skos:altLabel>
        <skos:definition>The Office of National Security Intelligence of the United States Drug Enforcement Administration (DEA) helps initiate new investigations of major drug organizations, strengthens ongoing ones and subsequent prosecutions, develops information that leads to seizures and arrests, and provides policy makers with illegal drug trade trend information upon which programmatic decisions can be based.</skos:definition>
        <skos:hiddenLabel>ONSI</skos:hiddenLabel>
        <skos:prefLabel>Office of National Security Intelligence</skos:prefLabel>
    </owl:Class>
    


