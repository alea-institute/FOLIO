        <skos:altLabel xml:lang="pt-br">Limiares de Evento Interveniente</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schwellenwerte für &apos;Einschreitendes Ereignis&apos;</skos:altLabel>
