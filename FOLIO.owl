        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/3.00-Respiratory-Adult.htm#3_03"/>
        <rdfs:label>Asthma</rdfs:label>
        <skos:altLabel>Bronchial Asthma</skos:altLabel>
        <skos:altLabel>Chronic Asthmatic Bronchitis</skos:altLabel>
        <skos:altLabel>Pulmonary Hyperreactivity</skos:altLabel>
        <skos:altLabel>Reactive Airway Disease</skos:altLabel>
        <skos:definition>Asthma is a chronic respiratory condition characterized by inflammation and narrowing of the airways, leading to recurrent episodes of wheezing, shortness of breath, chest tightness, and coughing. It requires long-term management through medication, lifestyle changes, and avoidance of triggers to control symptoms and prevent attacks.</skos:definition>
    </owl:Class>
    


