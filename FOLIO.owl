        <rdfs:label>ADR Summary Jury Trial Forum</rdfs:label>
        <skos:definition>An ADR Summary Jury Trial Forum is a type of Alternative Dispute Resolution (ADR) Forum where parties present their case to a panel of jurors who then provide a non-binding verdict to help the parties reach a settlement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9XQBfujFslMMKIqHWCknld -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9XQBfujFslMMKIqHWCknld">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9xgvrUWmxGlvR7ooOgWvo7"/>
        <rdfs:label>Buyer Consent Requirement Applies Only to Specified Negative Covenants</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Buyer Consent Requirement Applies Only to Specified Negative Covenants</skos:altLabel>
        <skos:altLabel xml:lang="es-es">El requisito de consentimiento del comprador se aplica solo a convenios negativos especificados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">El requisito de consentimiento del comprador se aplica solo a convenios negativos especificados</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Käufer-Zustimmungsanforderung gilt nur für bestimmte negative Verpflichtungen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">L&apos;exigence de consentement de l&apos;acheteur ne s&apos;applique qu&apos;aux engagements négatifs spécifiés</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Requisito de consentimento do comprador se aplica apenas a determinadas obrigações negativas especificadas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דרישת ההסכמה של הקונה חלה רק על הבטחונות השליליים המסוימים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता केवल निर्दिष्ट नकारात्मक अधिबंधों के लिए लागू होती है</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方同意要求仅适用于指定的负面契约</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買手の同意要件は特定の否定的契約にのみ適用されます</skos:altLabel>
        <skos:definition>A provision in a contract that requires the buyer&apos;s approval only for certain restrictions on the property, rather than all restrictions, as specified in the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9XZ7K8HJWXLILivJp6es7a -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9XZ7K8HJWXLILivJp6es7a">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWuBs7zey8BVg86iZuFUNk"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_23"/>
        <rdfs:label>Vulva or Vagina Cancer</rdfs:label>
        <skos:altLabel>Vaginal Cancer</skos:altLabel>
        <skos:altLabel>Vulvar Cancer</skos:altLabel>
        <skos:definition>Vulva or vagina cancer refers to malignant tumors originating in the external female genitalia (vulva) or the vaginal canal. These cancers can cause symptoms such as abnormal bleeding, itching, and pain, and often require a combination of treatments including surgery, radiation, and chemotherapy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9XbvULiDU6Lhqax71LzThw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9XbvULiDU6Lhqax71LzThw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RgQLVqqo23cFKNa2n4P7wp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Overpayment of Public Benefit</rdfs:label>
        <skos:definition>Overpayment of public benefit occurs when an individual or family receives more financial assistance or services than they are entitled to under a specific public benefit program. This can happen due to administrative errors, fraud, or changes in the recipient&apos;s eligibility status, and often necessitates actions like repayment plans or legal proceedings to recover the excess funds.</skos:definition>
    </owl:Class>
    


