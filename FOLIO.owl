        <skos:altLabel xml:lang="es-es">Sujeto de Datos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Titular de Datos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Titular dos dados</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נושא נתונים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डेटा विषय</skos:altLabel>
