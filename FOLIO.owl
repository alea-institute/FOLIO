        <rdfs:label>tk_id</rdfs:label>
        <skos:definition>&quot;Unique ID of a person billing on this matter. The same tk_id may appear multiple times if the timekeeper&apos;s name, level or rate changes during the billing period. This value is assigned by the firm and should remain the same for a biller across all work done by the biller within the firm (could be biller initials if the biller initials will be unique across that firm)  
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCMSQlIlz0NHmtx7TtG2IGx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCMSQlIlz0NHmtx7TtG2IGx">
