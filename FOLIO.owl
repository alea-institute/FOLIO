        <rdfs:label>A118 Collection-Forensic</rdfs:label>
        <skos:definition>For discovery and eDiscovery, the forensic acquisition and analysis of data that includes active files, deleted files and file fragments using specialized software or hardware</skos:definition>
        <skos:prefLabel>A118 Collection-Forensic</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaaV6cOHBcFdUd7UxJyluV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaaV6cOHBcFdUd7UxJyluV">
