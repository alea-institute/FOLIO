    <!-- https://folio.openlegalstandard.org/R8sskZUTqRM7drGfBsKJGDp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8sskZUTqRM7drGfBsKJGDp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHI06ZAbtF2eveFVFadYwb"/>
        <rdfs:label>Asset Depreciation</rdfs:label>
        <skos:altLabel>Valuation Loss</skos:altLabel>
        <skos:altLabel>Value Reduction</skos:altLabel>
        <skos:altLabel>Write-Down</skos:altLabel>
        <skos:definition>Asset Depreciation is the systematic decrease in the recorded value of an asset over time, typically due to wear and tear, obsolescence, or the passage of time. This accounting method allocates the cost of tangible assets over their useful life, reflecting the reduction in the asset&apos;s economic value.</skos:definition>
        <skos:prefLabel>Capital Consumption</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8t29mcCgDnprofEh5VP2LX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8t29mcCgDnprofEh5VP2LX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
        <rdfs:label>Tail Period Fee Triggers</rdfs:label>
        <skos:altLabel xml:lang="es-es">Disparadores de tarifas de período de cola</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Disparadores de tarifas de período de cola</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Disparadores de taxa de período final</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déclencheurs de frais de période de clôture</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebührenauslöser für den Schlusszeitraum</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tail Period Fee Triggers</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מפעילי עמלת תקופת הזנב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टेल पीरियड फी ट्रिगर्स</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">尾期费用触发器</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">最終期間料金トリガー</skos:altLabel>
        <skos:definition>Tail Period Fee Triggers: A provision in a deal protection agreement that entitles the target company to receive a fee if a potential acquirer makes a bid within a certain period after the termination of the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8t3vR9aRVG8h1UgWT0EuYc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8t3vR9aRVG8h1UgWT0EuYc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
        <rdfs:label>Real Property Defect Concealed by Seller</rdfs:label>
        <skos:altLabel xml:lang="es-es">Defecto de propiedad inmobiliaria oculto por el vendedor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Defecto de propiedad inmobiliaria oculto por el vendedor</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Defeito imobiliário oculto pelo vendedor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Défaut immobilier dissimulé par le vendeur</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Real Property Defect Concealed by Seller</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verdeckter Mangel an Immobilien durch den Verkäufer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגם בנכסי נדל״ן המוסתר על ידי המוכר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विक्रेता द्वारा छिपा रहा वास्तविक संपत्ति का दोष</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">卖方隐瞒的房地产缺陷</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">売主によって隠された不動産の欠陥</skos:altLabel>
        <skos:definition>The concept of &quot;Real Property Defect Concealed by Seller&quot; refers to a situation in which a seller of real estate fails to disclose a known defect in the property to the buyer, which can result in legal claims related to the property and potential liability for the seller.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8t5CSqYvG6L6Cl86vQeMRA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8t5CSqYvG6L6Cl86vQeMRA">
