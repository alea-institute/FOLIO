            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Immigration Court</rdfs:label>
        <skos:definition>Immigration Court is an administrative forum that handles legal proceedings related to immigration matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJ5qwfxRAfTOLboWpZp5bL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJ5qwfxRAfTOLboWpZp5bL">
