        <skos:altLabel xml:lang="fr-fr">Langage des exigences de consentement de l&apos;acheteur</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lenguaje de Requisito de Consentimiento del Comprador</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lenguaje de Requisito de Consentimiento del Comprador</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Linguagem de requisitos de consentimento do comprador</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שפת דרישת הסכמת הקונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता भाषा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">バイヤー同意要件言語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方同意要求语言</skos:altLabel>
        <skos:definition>A requirement for the buyer&apos;s explicit agreement to certain terms or conditions, which is included in an affirmative covenant.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBbmAr7UZlvBSjbTLZeA5I9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBbmAr7UZlvBSjbTLZeA5I9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB5irrjea9ZzesLNnhYPQ1D"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7OJQHant3Dx172WXuPbWgx"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/ROjlFsq58MnIV2nxc0IvNu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Unlawful Wage Garnishment Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf unrechtmäßige Lohnpfändung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de embargo de salario ilegal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de embargo de salario ilegal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de penhora de salário ilegal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de saisie de salaire illégale</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unlawful Wage Garnishment Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למחיקת שכר עבודה בלתי חוקי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवैध वेतन गार्निशमेंट दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">違法な賃金差し押さえ請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法工资扣押索赔</skos:altLabel>
        <skos:definition>An unlawful wage garnishment claim is a legal action initiated by an employee against their employer for not complying with the legal requirements for wage garnishment. Wage garnishment occurs when a creditor obtains a court order to deduct a portion of an employee&apos;s wages to satisfy a debt. The claim typically arises when an employer improperly withholds too much of an employee&apos;s wages or does not follow the proper legal procedures for wage garnishment, which can result in financial harm to the employee. Employers can also face liability for not protecting employees from unlawful garnishment orders.</skos:definition>
    </owl:Class>
    


