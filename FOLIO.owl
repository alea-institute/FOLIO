                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RjM80CC0FA0G2sKxmlbaJF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Sale of Goods Breached by Buyer</rdfs:label>
        <skos:altLabel xml:lang="es-es">Incumplimiento del comprador en la venta de bienes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento del comprador en la venta de bienes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sale of Goods Breached by Buyer</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Venda de bens violada pelo comprador</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vente de marchandises rompue par l&apos;acheteur</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verkauf von Waren durch Käufer gebrochen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מכירת סחורות שנופצה על ידי הקונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वस्तुओं की बिक्री खराब खरीदार द्वारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方违反货物销售</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手による商品の売買違反</skos:altLabel>
        <skos:definition>The Sale of Goods Breached by Buyer refers to a legal concept where a buyer fails to fulfill their obligations under a contract for the sale of goods, resulting in a breach of the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79qPoDow3GBrkzxNk69riq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79qPoDow3GBrkzxNk69riq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED Matter Identifier, in favor of `Matter ID` https://folio.openlegalstandard.org/RUgWyAVlkn9ysIUzCG1Ahb</rdfs:label>
        <skos:definition>Matter identifier (e.g., IRIs, UUIDs, GUIDs) within the systems of stakeholders (e.g., vendors, sellers, buyers, courts).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79rOnHd0QSHnD78a0WUK1J -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79rOnHd0QSHnD78a0WUK1J">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Tourist Visa</rdfs:label>
        <skos:altLabel xml:lang="en-us">B-2 Visa</skos:altLabel>
        <skos:altLabel>Visa for Leisure Visitor</skos:altLabel>
        <skos:definition>A visa for leisure visitors, often referred to as a tourist visa, is a short-term visa that allows individuals to enter a foreign country for the purpose of tourism, recreation, or visiting friends and family. This type of visa typically does not permit the holder to engage in employment or business activities and is usually valid for a limited period, ranging from a few weeks to several months.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79uvw3nIwtdShCWTu6D5SS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79uvw3nIwtdShCWTu6D5SS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfOoWbuAOqLv617rVNcHYh"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Binge-Eating Disorder</rdfs:label>
        <skos:altLabel>BED</skos:altLabel>
        <skos:definition>Binge-Eating Disorder is an eating disorder characterized by recurrent episodes of eating large quantities of food in a short period, accompanied by feelings of loss of control during the binge and significant distress or impairment. Unlike Bulimia Nervosa, individuals with Binge-Eating Disorder do not regularly engage in compensatory behaviors such as vomiting or excessive exercise to offset the binge eating.</skos:definition>
        <skos:prefLabel>Compulsive Overeating</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79vPJOLnvcMwQKMXN8m5Z3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79vPJOLnvcMwQKMXN8m5Z3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Sitka Tribe of Alaska</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79vl3f3MRqpgqROWlkh68r -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79vl3f3MRqpgqROWlkh68r">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>No Conflict of Interest Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de non-conflit d&apos;intérêts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de No Conflicto de Intereses</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de No Conflicto de Intereses</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Não Conflito de Interesses</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Vermeidung von Interessenkonflikten</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Conflict of Interest Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ללא התנגדות עניינים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हुआ नहीं है हितधर्म से विरोधिता की क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">利益相反条項なし</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">无利益冲突条款</skos:altLabel>
        <skos:definition>A &quot;No Conflict of Interest Clause&quot; is a provision in a contract that prohibits any conflicting interests that may interfere with the parties&apos; ability to fulfill their obligations under the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79xLpY9gRRitoFR3T667If -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R79xLpY9gRRitoFR3T667If">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ax95LqcYtqPK458D1g7aP"/>
        <rdfs:label>Zoological Taxonomy</rdfs:label>
        <skos:altLabel>Zoological Classification</skos:altLabel>
        <skos:definition>Zoological Taxonomy is the scientific classification of animals based on their evolutionary relationships, anatomical structures, and genetic similarities, organizing them into hierarchical categories such as phyla, classes, orders, families, genera, and species. This system helps in understanding the diversity of animal life and their biological characteristics.</skos:definition>
        <skos:prefLabel>Animal Taxonomy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R79xc5zAwyWmOjHbe5m6p26 -->

