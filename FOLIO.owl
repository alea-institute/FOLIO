        <skos:altLabel xml:lang="hi-in">मैटर फीस डिस्काउंट या क्रेडिट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">物料费用折扣或信用</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">物質費用の割引またはクレジット</skos:altLabel>
