    <owl:Class rdf:about="https://folio.openlegalstandard.org/R22MXEaAUz9zxXdjgRoYOv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED - Material Adverse Effect Definition - Applies to Target&apos;s Prospects</rdfs:label>
        <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Aplica a las Perspectivas del Objetivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Aplica a las Perspectivas del Objetivo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition eines wesentlichen nachteiligen Effekts - gilt für die Aussichten des Ziels</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Aplica-se às Perspectivas do Alvo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de l&apos;effet indésirable matériel - s&apos;applique aux perspectives de la cible</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - Applies to Target&apos;s Prospects</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת השפעה שלילית חומרית - חל על הנפגע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - लक्ष्य के अवसरों पर लागू होती है</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质性不利影响定义-适用于目标前景</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-ターゲットの見通しに適用される</skos:altLabel>
        <skos:definition>SUPERCEDED BY ACQUIROR AND ACQUIREE TAGS. A Material Adverse Effect (MAE) Definition - Applies to Target Prospects is a term used in legal matters to describe a negative change or event that significantly impacts the future prospects or potential of a specific target company or entity.</skos:definition>
    </owl:Class>
    


