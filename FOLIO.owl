        <skos:definition>Minnesota District Court - Blue Earth County: A specific court within the Minnesota District Court system located in Blue Earth County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RuDAbRiNW105SQoqb1XZ4c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RuDAbRiNW105SQoqb1XZ4c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBila9ckW95W84Tk54tGfZO"/>
