        <rdfs:label>General Warehousing and Storage</rdfs:label>
        <skos:definition>See industry description for 493110.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/8pr6nCqQSDSxa934CCtrfw -->

