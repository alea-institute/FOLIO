        <rdfs:label>Judgment Notwithstanding the Verdict</rdfs:label>
        <skos:altLabel>JNOV</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Judgment Notwithstanding the Verdict</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Jugement nonobstant le verdict</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Julgamento não obstante o veredicto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Sentencia no obstante el veredicto</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Sentencia no obstante la veredicto</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Urteil trotz des Urteils</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פסק דין לא משקף את ההחלטה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फैसला विरोध विचार के बावजूद</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">判决不顾裁决</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判決にもかかわらず判決</skos:altLabel>
        <skos:definition>JNOV or Judgment Notwithstanding the Verdict is a legal concept that allows a judge to overturn a jury&apos;s verdict if it is deemed unreasonable or unsupported by the evidence presented at trial.</skos:definition>
    </owl:Class>
    


