        <rdfs:label>Full Payment</rdfs:label>
        <skos:altLabel>Complete Payment</skos:altLabel>
        <skos:altLabel>Paid in Full</skos:altLabel>
        <skos:altLabel>Payment in Full</skos:altLabel>
        <skos:definition>Full Payment refers to a financial transaction where the total amount due has been paid in its entirety. This status indicates that the current financial obligation has been completely satisfied, leaving no outstanding balance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yM28KbgnCjsYivcHvUPoQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8yM28KbgnCjsYivcHvUPoQ">
