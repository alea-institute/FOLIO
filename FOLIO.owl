        <skos:altLabel xml:lang="hi-in">नाममात्र नुकसान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">名义损害赔偿</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">名目損害賠償</skos:altLabel>
