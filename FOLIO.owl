    <!-- https://folio.openlegalstandard.org/R48nDUrzCrSIizIRDNfkr7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R48nDUrzCrSIizIRDNfkr7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBqyMMilyJsOelem8C8QQRu"/>
        <rdfs:label>Intentional Interference with Contractual Relationship</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Intentional Interference with Contractual Relationship</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Interferencia intencional en la relación contractual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interferencia intencional en la relación contractual</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interferência intencional em relação contratual</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Obstruction intentionnelle des relations contractuelles</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorsätzliche Beeinträchtigung vertraglicher Beziehungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרעה מכוונת בקשר חוזי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुबंधिक संबंध के साथ जानबूझकर हस्तक्षेप</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約関係に対する意図的な妨害</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">故意干涉合同关系</skos:altLabel>
        <skos:definition>Intentional Interference with Contractual Relationship refers to the intentional and unjustified interference with a contractual relationship between two parties by a third party, resulting in a breach of the contract and causing damages to the affected party.</skos:definition>
    </owl:Class>
    


