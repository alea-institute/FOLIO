        <skos:altLabel xml:lang="hi-in">रखी गई नियंत्रण के अनुरूप लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保留された制御の不注意な行使</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保留控制的疏忽行使</skos:altLabel>
        <skos:definition>On a multi-employer work site, a person or entity may be civilly liable if it negligently exercised control so as to have &quot;affirmatively contributed in any way&quot; to the injury.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcKu6XW304hK2ONeNuXgkS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcKu6XW304hK2ONeNuXgkS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Pueblo</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcLuFIVZBrM4AhteZ4Jqkq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcLuFIVZBrM4AhteZ4Jqkq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROEhQluRR7rfqDyDYvJ3Dd"/>
        <rdfs:label>Travel Document Issuing Country</rdfs:label>
        <skos:definition>The Travel Document Issuing Country refers to the country that has issued the travel document or other identification suitable for international travel. This country is usually responsible for the traveler&apos;s consular needs and is the authority to which foreign governments will refer for identification and verification purposes</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcMZgiwSAaHpqXMO4nq3sU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcMZgiwSAaHpqXMO4nq3sU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLNlm7nXyJQLJmk8qYnaPQ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
        <rdfs:label>Implied Indemnification</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Implied Indemnification</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Implizite Entschädigung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Indemnisation implicite</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Indemnización implícita</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Indemnización implícita</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indenização implícita</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיצויים משוחררים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुमति द्वारा भरपाई</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">暗黙の補償</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">默示赔偿</skos:altLabel>
        <skos:definition>A legal concept where one party is obligated to compensate another party for damages or losses, even if there is no explicit agreement to do so, due to actions or statements that created a reasonable expectation of indemnification.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcNOyJszNQ5uDl1st0SLL5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcNOyJszNQ5uDl1st0SLL5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Organized Village of Kake</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcNTXUIeabR8yZj0GiomxT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcNTXUIeabR8yZj0GiomxT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Nonacquiescence</rdfs:label>
        <skos:definition>Nonacquiescence refers to the practice where a government agency chooses not to follow or implement a court ruling that directly affects the agency&apos;s actions or policies. This may happen when the agency disagrees with the decision or believes that it only applies to the specific case and not to its general procedures or regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcP9tLiIhGT0pZaCrB0Qih -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcP9tLiIhGT0pZaCrB0Qih">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Contract Duration Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de durée de contrat</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de duración del contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de duración del contrato</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de duração do contrato</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Contract Duration Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertragsdauerklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף משך החוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवधि शर्त शब्द</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合同期限条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約期間条項</skos:altLabel>
        <skos:definition>A Contract Duration Clause is a provision in a contract that specifies the length of time that the contract will remain in effect.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcPCCRQUx0nlNBGvI8Keh0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcPCCRQUx0nlNBGvI8Keh0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w"/>
        <rdfs:label>Obviousness</rdfs:label>
        <skos:definition>Obviousness in legal terms refers to the lack of novelty and inventiveness in an invention, making it ineligible for a patent. An invention is considered obvious if a person with ordinary skill in the field would find the invention predictable based on prior art.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcPmc5tXDkOmcv3W8TxwTO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcPmc5tXDkOmcv3W8TxwTO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hWq9dSn0Su2Y59JE48V3H"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7OtUosForl1Zon7KU3gQQR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9M22nIQgd72E0PSrkHmrxX"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Real Estate Investor</rdfs:label>
        <skos:definition>Entities or individuals that invest in real property, either directly or through a real estate investment trust (REIT).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcR2xKteHARvohhigcdAjx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcR2xKteHARvohhigcdAjx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:label>Seating Claim</rdfs:label>
        <skos:altLabel xml:lang="es-es">Reclamación de asientos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de asientos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de assento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de siège</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Seating Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sitzplatzanspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת מושבים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बैठक का दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">座位索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">座席請求</skos:altLabel>
        <skos:definition>A seating claim is a legal action initiated by an employee against their employer for not providing reasonable seating to employees who perform tasks that can be done while seated. The claim typically arises when an employer does not comply with applicable laws, which require employers to provide seating to employees when the nature of their work reasonably permits the use of seats. Employers can face liability for failing to provide seating when required, which can result in physical discomfort or injury to employees who are required to stand for long periods of time.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcR3bv1hvkJ6eLZsLcmaFY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcR3bv1hvkJ6eLZsLcmaFY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rchny3YFXoQyenv6XUbyo0"/>
        <rdfs:label>Closing Arguments / Summation</rdfs:label>
        <skos:altLabel xml:lang="es-es">Alegatos de cierre / Resumen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Alegatos de clausura / Resumen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Alegações Finais / Sumário</skos:altLabel>
        <skos:altLabel>Closing Argument</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Closing Arguments / Summation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Plaidoirie finale / Résumé</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schlussplädoyer / Zusammenfassung</skos:altLabel>
        <skos:altLabel>Summation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סיכום טענות / סיכום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अंतिम बयान / सारांश</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クロージングアーギュメント/サマリー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">结案陈词 / 总结陈词</skos:altLabel>
        <skos:definition>Closing Arguments/Summation is a trial event where each party presents their final arguments to the jury or judge before a verdict is reached.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RcR44zE8HiytJQD20uNqzy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RcR44zE8HiytJQD20uNqzy">
