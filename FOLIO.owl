        <rdfs:label>Antitrust - Horizontal Merger Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de fusiones horizontales</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de fusiones horizontales</skos:altLabel>
