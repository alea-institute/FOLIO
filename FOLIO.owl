        <rdfs:label>&quot;Entitled to Seek&quot; Specific Performance Language</rdfs:label>
        <skos:altLabel xml:lang="hi-in">&quot;विशिष्ट प्रदर्शन भाषा&quot; के अधिकारी होना</skos:altLabel>
