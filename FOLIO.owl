        <skos:altLabel xml:lang="zh-cn">听证通知</skos:altLabel>
        <skos:definition>A Notice of Hearing is a written communication that informs a party of a scheduled hearing or proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDTRvcsDvO0p9ngadut1B5j -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDTRvcsDvO0p9ngadut1B5j">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9salgO5L9Ssp5nE8uBWXjP"/>
        <rdfs:label>Pharmacovigilance</rdfs:label>
        <skos:altLabel>Drug Safety Monitoring</skos:altLabel>
        <skos:altLabel>Post-Market Surveillance</skos:altLabel>
        <skos:definition>Pharmacovigilance is the scientific and systematic process of monitoring, assessing, detecting, and preventing adverse effects or any other drug-related problems, primarily focusing on the safety of pharmaceutical products after they have been released on the market. It aims to enhance patient care and safety in relation to the use of medicines and to support public health programs by providing reliable, balanced information for the effective assessment of the risk-benefit profile of medicinal products.</skos:definition>
    </owl:Class>
    


