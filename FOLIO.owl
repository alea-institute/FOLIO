        <rdfs:label>Antitrust - Tying Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de ataduras</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de ataduras</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Antitrust - Accusations de liens</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Antitrust - Tying Claims</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Antitruste - Alegações de Vínculo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wettbewerbsbeschränkung - Koppelungsvorwürfe</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנטיטרוסט - טיינג טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - टाईंग दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反垄断 - 捆绑索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占禁止法 - 結合主張</skos:altLabel>
        <skos:definition>A tying claim in antitrust law refers to a situation where a seller requires a buyer to purchase a second product or service as a condition of purchasing the first product or service, which may be considered anti-competitive behavior.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKoMhHeiuDB6Js7z1UVM7x -->

