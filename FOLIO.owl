        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RC2pPwetBTxjVcH4DJq4S6M"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>zip_postal_code</rdfs:label>
        <skos:definition>&quot;The postal code of parent.  Required except in countries without an equivalent address component.  
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQJ0H8haMYmsQGXG1Vl4tf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQJ0H8haMYmsQGXG1Vl4tf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8FLbODQd9k85hPERve6IN7"/>
        <rdfs:label>Climate Stability Rights</rdfs:label>
        <skos:definition>Climate Stability Rights pertain to the legal entitlements and principles recognizing the fundamental right of present and future generations to a stable and healthy climate. This concept underscores the obligation of governments, industries, and other entities to take proactive measures to mitigate climate change, reduce greenhouse gas emissions, and preserve the planet&apos;s ecological balance. These rights emphasize the importance of intergenerational equity, sustainable development, and global cooperation to ensure a habitable environment for all.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQNpXNwVMANC1qr7dblWHA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQNpXNwVMANC1qr7dblWHA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3Q1HDu5jO8nvhdbr2Uj0c"/>
        <rdfs:label>Florida Circuit Court - Okaloosa County - 1st Circuit Court</rdfs:label>
        <skos:definition>Florida Circuit Court - Okaloosa County (1st Circuit Court) is a specific court within the Florida Circuit Court system that has jurisdiction over legal proceedings in Okaloosa County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQQdyAblpiT87dhhTg7LGK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQQdyAblpiT87dhhTg7LGK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Ute</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBlWM6X0yqMrb4z4JQYaEP2"/>
        <rdfs:label>Right to a Fair Trial</rdfs:label>
        <skos:altLabel xml:lang="es-es">Derecho a un Juicio Justo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho a un Juicio Justo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito a um julgamento justo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit à un procès équitable</skos:altLabel>
        <skos:altLabel>Fair Trial</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Recht auf ein faires Verfahren</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right to a Fair Trial</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הזכות למשפט הוגן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायपूर्ण तरीके से न्यायाधीश के सामने अपनी बात रखने का अधिकार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正な裁判の権利</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公正审判权</skos:altLabel>
        <skos:definition>The right to a fair trial is a fundamental legal principle that ensures individuals facing legal proceedings are treated impartially, justly, and in accordance with established legal procedures. This right, which is protected by various international human rights instruments and national constitutions, includes elements such as the presumption of innocence, the right to counsel, the right to a speedy and public trial, the right to an impartial judge or jury, and the right to confront witnesses and present evidence</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQUxdVkxYCRp3CYhe9qnyS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQUxdVkxYCRp3CYhe9qnyS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70"/>
        <rdfs:label>American Call Option Style</rdfs:label>
        <skos:definition>An American Call Option Style is an option contract that grants the holder the right to purchase the underlying asset at a specified strike price at any time between the purchase date and the expiration date. This flexibility allows the holder to benefit from favorable price movements in the underlying asset at any point during the option&apos;s life.</skos:definition>
        <skos:prefLabel>American-Style Call Option</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQX9bzOrJ0seTWU1ApWvG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQX9bzOrJ0seTWU1ApWvG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9AX4LAp7IfL4nFnLZeugyY"/>
        <rdfs:label>UK Electoral Commission</rdfs:label>
        <skos:definition>The UK Electoral Commission is an independent regulatory body responsible for overseeing and ensuring the integrity and fairness of elections and referendums in the United Kingdom. It regulates political party funding, monitors compliance with electoral laws, provides guidance and support for voters and electoral administrators, and conducts public awareness campaigns to promote democratic participation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBQXVSSPZE36fkwBeXb4YBe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBQXVSSPZE36fkwBeXb4YBe">
