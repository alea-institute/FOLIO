        <skos:altLabel xml:lang="pt-br">Ação Proibida/Omissão Requerida pela Linguagem do Acordo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Handlung verboten/Unterlassung erforderlich durch die Vertragssprache</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעולה אסורה / התחייבות לחסר פעולה על פי שפת ההסכם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समझौते भाषा द्वारा कार्रवाई प्रतिबंधित / अनुपस्थिति आवश्यक</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">协议语言禁止行动/要求不作为</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約言語による行為禁止/不作為要求</skos:altLabel>
        <skos:definition>A requirement to refrain from certain actions or to perform certain omissions as specified in the language of an agreement, which is a carveout from the definition of Material Adverse Effect (MAE).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkwyaka1G06Txgxv0pNxqI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkwyaka1G06Txgxv0pNxqI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R07tQM5sYugYGBPQS571s5"/>
        <dc:identifier>CIVR-DISC</dc:identifier>
        <rdfs:label>Discrimination Law</rdfs:label>
        <skos:altLabel>Discrimination</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Diskriminierungsrecht</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit de la discrimination</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei de Discriminação</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">差別禁止法</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">歧视法</skos:altLabel>
        <skos:definition>Protection from discrimination on grounds such as race, gender, sexual orientation, national origin, color, age, political affiliation, ethnicity, religion, and disability.</skos:definition>
        <skos:hiddenLabel>DISC</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB4cFSLB4xvycDlKv73dOg6"/>
        <dc:source rdf:resource="https://ledes.org/ledes-98bi-format/"/>
        <dc:source rdf:resource="https://ledes.org/wp-content/uploads/2020/02/LEDES98BI-V5-Format-Rev-1-2020-w-Changes-Marked-from-98BI-Rev-7-2014.xlsx"/>
        <rdfs:label>LEDES98BI V5 Format Rev 1-2020</rdfs:label>
        <skos:definition>LEDES98BI V5 Format Rev 1-2020 is a standardized format for electronic legal invoices, including specific data elements such as invoice date, client name, matter name, timekeeper information, and line item details.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkxy1u3kzfwPuVV7mW0nv7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkxy1u3kzfwPuVV7mW0nv7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:label>Private Attorneys General Act Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Action en vertu de la loi sur les procureurs généraux privés</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klage nach dem Gesetz über private Staatsanwälte</skos:altLabel>
        <skos:altLabel>PAGA Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Private Attorneys General Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Abogados Generales Privados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Abogados Generales Privados</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Procuradores Gerais Privados</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק עורכי דין כלליים פרטיים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निजी वकील महानियांकन अधिनियम दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プライベート・アトーニーゼネラル法クレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">私人检察官法案索赔</skos:altLabel>
        <skos:definition>The Private Attorneys General Act (PAGA) is a California law that allows employees to bring claims on behalf of the state against their employers for labor code violations. By acting as private attorneys general, employees can seek penalties for themselves and their co-workers, thereby helping to enforce labor laws when government agencies may lack the resources to do so.</skos:definition>
    </owl:Class>
    


