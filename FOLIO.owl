        <skos:altLabel xml:lang="ja-jp">正誤表</skos:altLabel>
        <skos:definition>Errata refers to a document filed with a court that corrects errors or omissions in a previously filed document, and is categorized under Trial Court Practice Documents and Appellate Practice Documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HTLbEXSzD7fXO9Hu6mTmb -->

