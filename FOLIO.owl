        <skos:altLabel xml:lang="de-de">Antrag auf Neues Verfahren - Format und Taktiken</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para un nuevo juicio - formato y tácticas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para un nuevo juicio - formato y tácticas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for New Trial - Format and Tactics</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour un Nouveau Procès - Format et Tactiques</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Novo Julgamento - Formato e Táticas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למשפט חדש - פורמט וטקטיקות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नए न्यायालय के लिए मोशन - फॉर्मेट और टैक्टिक्स</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">新しい裁判のための動議 - フォーマットと戦術</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">新审判动议 - 格式和策略</skos:altLabel>
        <skos:definition>A Motion for New Trial - Format and Tactics is a specific type of legal document filed by a party after a trial, requesting the court to set aside the verdict and order a new trial based on specific grounds and strategies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBTF6cCyE3OsMy8YPpLRqq9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBTF6cCyE3OsMy8YPpLRqq9">
