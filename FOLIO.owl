    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIdM5DPqxstxxdcx26hOSU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIdM5DPqxstxxdcx26hOSU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
