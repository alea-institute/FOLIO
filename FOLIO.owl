    <!-- https://folio.openlegalstandard.org/RkotJU6BE634ODFcg1SgCK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkotJU6BE634ODFcg1SgCK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxWrCyEH6sVtwYoR6elPPp"/>
        <rdfs:label>Canola</rdfs:label>
        <skos:altLabel>Brassica Napus</skos:altLabel>
        <skos:definition>Canola is a type of oilseed crop derived from varieties of rapeseed (Brassica napus and Brassica rapa) that have been selectively bred to be low in erucic acid and glucosinolates. It is primarily grown for its oil, which is valued for its low saturated fat content and versatility in cooking and food production, as well as its use in biodiesel and industrial applications.</skos:definition>
    </owl:Class>
    


