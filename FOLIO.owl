        <rdfs:label>Cross-Defendant</rdfs:label>
        <skos:altLabel xml:lang="es-es">Co-demandado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Co-demandado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cross-Defendant</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מטען-הגנה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रॉस-डिफेंडेंट</skos:altLabel>
        <skos:definition>A person against who a cross-claim is brought.</skos:definition>
        <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
    </owl:Class>
    


