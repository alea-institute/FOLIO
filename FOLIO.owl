        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCBP9N5ER7Y6inNQdjggrKt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Estate Administration Practice</rdfs:label>
        <skos:altLabel>Estate Administration</skos:altLabel>
        <skos:altLabel>Estate Administration Service</skos:altLabel>
        <skos:altLabel>Estate Execution Practice</skos:altLabel>
        <skos:altLabel>Estate Settlement Practice</skos:altLabel>
        <skos:definition>Estate Administration Practice refers to the process of managing and settling an individual&apos;s estate after their death, including distributing assets to beneficiaries, paying debts, and handling legal and tax obligations. It involves probate proceedings, inventorying assets, and ensuring the deceased&apos;s wishes as outlined in their will are fulfilled.</skos:definition>
        <skos:prefLabel>Probate Administration</skos:prefLabel>
    </owl:Class>
    


