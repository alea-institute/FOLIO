        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCua1MtzwNcjfYov8VFcoV3"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzxVprwB3RwZ8EMewt18Jt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RxPxADB12qeAIDAFEgWRsz"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Hedge Fund</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Fonds spéculatif</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fundo de cobertura</skos:altLabel>
        <skos:altLabel>Hedge Fund Firm</skos:altLabel>
        <skos:altLabel>Hedge Fund Investor</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hedgefonds</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ヘッジファンド</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">对冲基金</skos:altLabel>
        <skos:definition>A hedge fund is a type of investment vehicle that pools capital from accredited individuals or institutional investors and invests in a variety of assets, often using complex strategies with the goal of generating high returns. Unlike mutual funds, hedge funds are subject to fewer regulations and often employ more aggressive strategies, including short selling, leverage, and derivatives.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7eA650PR6dC0aiyzxuIut5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7eA650PR6dC0aiyzxuIut5">
