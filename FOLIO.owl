        <rdfs:label>Proprietary Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de propriété</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula Propietaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula Propietaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Eigentumsvorbehalt</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Proprietary Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פרופרייטרי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रोप्राइटरी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专有条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">所有権条項</skos:altLabel>
        <skos:definition>A Proprietary Clause is a provision in a contract that establishes ownership rights over certain property or information, and restricts its use or disclosure by others.</skos:definition>
    </owl:Class>
    


