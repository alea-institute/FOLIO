        <rdfs:label>Texas District Court - Parker County</rdfs:label>
        <skos:definition>Texas District Court - Parker County: A court of law in Texas that has jurisdiction over legal cases within Parker County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R84jjonxY8dXzTqGKO7hk0Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R84jjonxY8dXzTqGKO7hk0Z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDi7A9GutlkahNHpXCklGRc"/>
        <rdfs:label>International Organization Representative Visa</rdfs:label>
        <skos:altLabel>Foreign Government Representative Visa</skos:altLabel>
        <skos:definition>An International Organization Representative Visa (in the U.S., a G-1 visa) is issued to principal resident representatives of foreign governments recognized by the U.S. to international organizations, their staff, and immediate family members. It allows them to enter and remain in the U.S. to perform official duties related to their organization.</skos:definition>
        <skos:prefLabel>G-1 Visa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R84qDF0yi68eK1S8E8ul6ii -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R84qDF0yi68eK1S8E8ul6ii">
