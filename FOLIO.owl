        <skos:altLabel xml:lang="pt-br">Umbundu</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ウンブンドゥ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">翁本杜语</skos:altLabel>
        <skos:definition>A Bantu language spoken in Angola, characterized by its use of click consonants and other unique phonetic features.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDNBuSf0mzFPvmzSa1ZfABG -->

