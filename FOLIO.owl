    <!-- https://folio.openlegalstandard.org/R7iaC6og9UtwSdkJJ64AiWK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7iaC6og9UtwSdkJJ64AiWK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCuhulltRlDN8kiH5sooyW9"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/4.00-Cardiovascular-Adult.htm#4_12"/>
        <rdfs:label>Peripheral Arterial Disease</rdfs:label>
        <skos:altLabel>Claudication</skos:altLabel>
        <skos:altLabel>Peripheral Vascular Disease</skos:altLabel>
        <skos:definition>Peripheral arterial disease (PAD) is a condition characterized by the narrowing or blockage of peripheral arteries, typically in the legs, due to atherosclerosis or other vascular issues. PAD can cause symptoms such as claudication (pain during walking), decreased limb perfusion, and can lead to severe complications including ulcers or gangrene if untreated.</skos:definition>
    </owl:Class>
    


