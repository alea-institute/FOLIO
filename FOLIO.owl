        <skos:altLabel xml:lang="en-gb">Pain and Suffering</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schmerzen und Leiden</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כאב וסבל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दर्द और पीड़ा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">痛みと苦しみ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">痛苦和折磨</skos:altLabel>
        <skos:definition>Pain and Suffering refers to the physical and emotional distress experienced by a person as a result of an injury or harm caused by another party, for which compensation may be sought in a legal proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCC6FvCiFeSijk47glfD3ZX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCC6FvCiFeSijk47glfD3ZX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNw3wCvXyyjEPknfOpicmf"/>
        <rdfs:label>Marriage Market Segment</rdfs:label>
        <skos:definition>The marriage market refers to a division of the market that is specifically targeted towards individuals and couples who are married or planning to get married. This segment encompasses products and services that support the various aspects of married life, from wedding planning to financial and relationship counseling.</skos:definition>
        <skos:example>Financial Planning for Couples (e.g., joint bank accounts, estate planning)</skos:example>
        <skos:example>Marriage Counseling Services (e.g., couples therapy, relationship workshops)</skos:example>
        <skos:prefLabel>Married Couples Market</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCC6qZKk4vInl0VVZfVhnNp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCC6qZKk4vInl0VVZfVhnNp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBuYThXwp8tJjNWkTeuFvAZ"/>
        <rdfs:label>Bus Lane Violation Claim</rdfs:label>
        <skos:altLabel>Bus-Only Lane Infringement Claim</skos:altLabel>
        <skos:altLabel>Mass Transit Violation Claim</skos:altLabel>
        <skos:definition>A Bus Lane Violation Claim involves allegations that a driver has unlawfully used a bus lane designated solely for buses, potentially impeding public transport efficiency and violating traffic regulations. These claims aim to uphold the integrity of public transit lanes and typically result in fines or other penalties to enforce compliance.</skos:definition>
        <skos:prefLabel>Mass Transit Lane Violation Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCC7p40tc21kf22JJDdEwbC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCC7p40tc21kf22JJDdEwbC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:label>Government Contract Labor Standards Claim</rdfs:label>
        <skos:definition>A Government Contract Labor Standards Claim (in the U.S., a Service Contract Act claim) is a legal assertion that an employer has failed to pay prevailing wages and benefits to employees working on federal service contracts. In the U.S., those are required by the McNamara-O&apos;Hara Service Contract Act. Such claims typically seek compensation for underpaid wages and benefits, as well as enforcement of labor standards.</skos:definition>
        <skos:prefLabel>Service Contract Act Claim</skos:prefLabel>
    </owl:Class>
    


