        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_02"/>
        <rdfs:label>Epilepsy</rdfs:label>
        <skos:altLabel>Convulsive Disorder</skos:altLabel>
        <skos:altLabel>Epileptic Disorder</skos:altLabel>
        <skos:definition>Epilepsy is a neurological disorder characterized by recurrent, unprovoked seizures resulting from abnormal electrical activity in the brain. It requires long-term management with medications, lifestyle adjustments, and sometimes surgical intervention to control seizure activity and improve quality of life.</skos:definition>
        <skos:prefLabel>Seizure Disorder</skos:prefLabel>
    </owl:Class>
    


