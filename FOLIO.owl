        <rdfs:label>Cross Indemnity Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de garantie croisée</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización cruzada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización cruzada</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de indenização cruzada</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cross Indemnity Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kreuzhaftungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הפצת סיכונים מצטברים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रॉस इंडेम्निटी क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">交叉赔偿条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">相互補償条項</skos:altLabel>
        <skos:definition>A Cross Indemnity Clause is a provision in a contract where each party agrees to indemnify and hold harmless the other party from any claims or damages arising from the other party&apos;s actions or omissions.</skos:definition>
    </owl:Class>
    


