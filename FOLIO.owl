        <skos:altLabel xml:lang="en-gb">Binding Arbitration Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause compromissoire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Arbitraje Vinculante</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Arbitraje Vinculante</skos:altLabel>
