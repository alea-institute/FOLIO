        <skos:altLabel xml:lang="fr-fr">Droit désavoué</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Lei desautorizada</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">否認された法律</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">否认法律</skos:altLabel>
        <skos:definition>The previously effective law has been disavowed by some authority (e.g., appellate court, judge).</skos:definition>
    </owl:Class>
    


