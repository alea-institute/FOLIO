        <skos:altLabel xml:lang="en-gb">Binding Effect Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bindungswirkungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;effet contraignant</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Efecto Vinculante</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Efecto Vinculante</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de efeito vinculante</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף התחייבות מחייבת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बाध्यकारी प्रभाव धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">拘束力条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">约束力条款</skos:altLabel>
        <skos:definition>A Binding Effect Clause is a clause in a contract that ensures that the terms and obligations of the contract are legally enforceable by all parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDhvWIsvqcsGHZCNoyqb9OQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDhvWIsvqcsGHZCNoyqb9OQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7epmKzXnQGUjQ78UEKxoTG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDEuNPJBSNIARaYTXJwi86w"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Investigation</rdfs:label>
        <skos:altLabel>Compliance Investigation</skos:altLabel>
        <skos:definition>A regulatory investigation is a formal inquiry conducted by a governmental or regulatory agency to examine whether laws, regulations, or industry standards have been violated. It aims to ensure compliance, enforce rules, and protect public interests in various sectors such as finance, healthcare, and environmental protection.</skos:definition>
        <skos:prefLabel>Regulatory Inquiry</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDi3Lq2bR8EsG5eTnSk9xkC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDi3Lq2bR8EsG5eTnSk9xkC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxWrCyEH6sVtwYoR6elPPp"/>
        <rdfs:label>Sunflowers</rdfs:label>
        <skos:altLabel>Helianthus Annuus</skos:altLabel>
        <skos:definition>Sunflowers are flowering plants from the Helianthus annuus species, known for their large, bright yellow blooms and edible seeds. They are cultivated for their seeds, which are used to produce oil, snacks, and bird feed, and are valued for their high nutritional content, including healthy fats and vitamins.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDi7A9GutlkahNHpXCklGRc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDi7A9GutlkahNHpXCklGRc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>International Organization Employee Visa</rdfs:label>
        <skos:altLabel>NATO Personnel Visa</skos:altLabel>
        <skos:altLabel>NATO Visa</skos:altLabel>
        <skos:altLabel>World Bank Visa</skos:altLabel>
        <skos:definition>International Organization Employee Visa is a visa category for employees of designated international organizations (e.g., NATO, World Bank), allowing them to enter the U.S. to perform official duties. This category includes G-1 to G-5 visas, each corresponding to different levels and types of employees.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDi9IBe3fXekAYxFM4plZn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDi9IBe3fXekAYxFM4plZn">
