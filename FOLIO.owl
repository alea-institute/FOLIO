        <skos:altLabel xml:lang="pt-br">Napolitano</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Neapolitanisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ナポリの</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">那不勒斯的</skos:altLabel>
        <skos:definition>A dialect of Italian spoken in the region of Naples and surrounding areas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Z1hy33okTgXPKS0rmNAG1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Z1hy33okTgXPKS0rmNAG1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://folio.openlegalstandard.org/RN3mWlXZUAt07dYsu6tls2"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R76UTCrg8DDzlFkZCPjrdqe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Petition for Skilled Workers - Bachelor&apos;s Cap</rdfs:label>
        <skos:altLabel>H-1B Bachelor&apos;s Cap Petition</skos:altLabel>
        <skos:definition>In the United States, the H-1B Bachelor&apos;s cap petition involves employers filing Form I-129 on behalf of prospective H-1B employees with a bachelor&apos;s degree who are subject to the annual H-1B visa cap, typically requiring a random lottery if the cap is exceeded. This process determines the selection of beneficiaries who can receive H-1B visas for specialty occupation employment in the U.S.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Z563RYBLIDWaiRo7Jvsmx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Z563RYBLIDWaiRo7Jvsmx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Draw Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de tirage</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de saque</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de sorteo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de sorteo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Draw Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeichnungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף משיכה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खींचना अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">开票条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">引出条項</skos:altLabel>
        <skos:definition>A Draw Clause is a provision in a contract that allows a party to withdraw funds from a specified account or line of credit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Z6u7UqLhlDqUPKI9Ts8t6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Z6u7UqLhlDqUPKI9Ts8t6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w"/>
        <rdfs:label>Prior Art</rdfs:label>
        <skos:definition>Prior Art refers to any evidence that your invention is already known. It includes everything made public in any form before a given date that might be relevant to a patent&apos;s claims of originality.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Z8mgzQJKr4AXj2mEJg2ST -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Z8mgzQJKr4AXj2mEJg2ST">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ddsah86bL3tQ5OmO9B7PB"/>
        <rdfs:label>Debt Settlement Agreement</rdfs:label>
        <skos:definition>A Debt Settlement Agreement is a legally binding contract between a debtor and a creditor that outlines the terms for resolving a debt for less than the original amount owed. The agreement specifies the reduced amount to be paid, the schedule for payment, and conditions under which the remaining debt will be forgiven or considered settled.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZBAOuDZuT00whwiIrlKle -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZBAOuDZuT00whwiIrlKle">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
        <rdfs:label>Reinvestment Risk</rdfs:label>
        <skos:definition>The risk that an investor will be unable to reinvest cash flows (like interest payments) at a rate comparable to their current rate of return.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZE8hspTJXjhYdr6k5qRM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZE8hspTJXjhYdr6k5qRM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rhpdjd9p358e9Rkel80dvQ"/>
        <rdfs:label>Employee Matters Agreement</rdfs:label>
        <skos:definition>An Employee Matters Agreement is a legal document that outlines various aspects of the employment relationship between a company and its executives or key employees. It typically covers matters such as job responsibilities, compensation, benefits, confidentiality, non-competition clauses, and dispute resolution procedures. This agreement is designed to define the rights, obligations, and expectations of both the employer and the employee in a clear and legally binding manner.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZGJBg8pD5gtT39tN2qNKH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZGJBg8pD5gtT39tN2qNKH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rjco9ohucVSJ0XxprM5Opb"/>
        <rdfs:label>Demand Letter</rdfs:label>
        <skos:altLabel xml:lang="es-es">Carta de Demanda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Carta de Demanda</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Carta de cobrança</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Demand Letter</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lettre de mise en demeure</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mahnbrief</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מכתב דרישה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डिमांड पत्र</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">請求書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">追讨信</skos:altLabel>
        <skos:definition>A demand letter is a written document sent by one party to another, typically in a legal context, requesting specific action or payment to resolve a dispute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZHACvzZdA3axSYEi5zcAO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZHACvzZdA3axSYEi5zcAO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCezn96rpy4oRcZgzT9ULlh"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9Mw0y1sYeTkDl6Po3b4ViW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBZdShYeyerlOOUlB0f64SY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Cash Interest Payment (for Sukuk Certificates)</rdfs:label>
        <skos:altLabel>Islamic Investment Return</skos:altLabel>
        <skos:altLabel>Profit Distribution Payment</skos:altLabel>
        <skos:altLabel>Sukuk Periodic Distribution</skos:altLabel>
        <skos:definition>A Cash Interest Payment, in the context of sukuk certificates, refers to the distribution of profits generated from Sharia-compliant investments to certificate holders. This payment structure involves the periodic distribution of actual cash returns derived from the underlying assets or business activities, as opposed to interest in the conventional sense, ensuring compliance with Islamic finance principles.</skos:definition>
        <skos:prefLabel>Sharia-Compliant Yield Distribution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZJAxXACB6wigGHS2vGE2g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZJAxXACB6wigGHS2vGE2g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Centre County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Centre County is a specific court within the Pennsylvania Magisterial District Court system that handles minor criminal offenses, traffic violations, and civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZLnFhKZS8OgGr2T8Euz1D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZLnFhKZS8OgGr2T8Euz1D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSK8CbOPdmMwMyMIlw8pdO"/>
        <rdfs:label>New Mexico Magistrate Court - Grant County</rdfs:label>
        <skos:definition>A court located in Grant County, New Mexico that has limited jurisdiction over certain types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZMBn02TENynBiqOlzG7yE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZMBn02TENynBiqOlzG7yE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBbkOoA0Hp0UmEnkGJOjs6D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/8.00-Skin-Adult.htm#8_07"/>
        <rdfs:label>Genetic Photosensitivity Disorders</rdfs:label>
        <skos:definition>Genetic photosensitivity disorders are conditions where an individual&apos;s genetic makeup causes an abnormal sensitivity to ultraviolet (UV) light, leading to skin damage upon exposure. These disorders often result in symptoms such as skin lesions, rashes, or an increased risk of skin cancer.</skos:definition>
        <skos:prefLabel>Hereditary Photosensitivity Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZQ0Km97U2Wut7s0UERyPR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZQ0Km97U2Wut7s0UERyPR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKm1RXP9FfvhLzWjynAfpS"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R6NLFwVRdI5dCvtQ1dm4f2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R731bb1FD96e6725c1113315"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RcVabDAyOfCmuIYjaqoxHf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Levy</rdfs:label>
        <skos:definition>A Levy is a legal seizure of property to satisfy a debt, usually initiated by a governmental authority such as the Internal Revenue Service (IRS) for unpaid taxes. The process involves officially taking possession of assets like bank accounts, wages, or physical property, and is typically executed after a court order or other legal authorization</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZSZfd5EPb3WU2lcwOC8jR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZSZfd5EPb3WU2lcwOC8jR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rCNhUCohkUGbQyd1C3uzz"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RhPVhnve1MQnjMzFXHwMrG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Capitalization - Other Representation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Capitalisation - Other Representation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Capitalização - Outra representação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Großschreibung - Andere Darstellung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Majuscule - Autre représentation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mayúsculas - Otra Representación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mayúsculas - Otra Representación</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כתיב ראשוני - תצוגה אחרת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कैपिटलाइजेशन - अन्य प्रतिनिधित्व</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">大写 - 其他表示</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">大文字 - その他の表現</skos:altLabel>
        <skos:definition>The concept of &quot;Capitalization - Other Representation&quot; refers to a statement made in a legal agreement regarding the ownership structure of a company, which may include information about the number and type of shares issued, outstanding debts, and other financial details, but is not specifically covered by the representations and warranties clause.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZWmwqI1Q3joUfVrV1icjU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZWmwqI1Q3joUfVrV1icjU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7oBWHStfmqTLn2MypkW3Pj"/>
        <dc:identifier>ENTITY-SOVST</dc:identifier>
        <rdfs:label>Sovereign State</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Estado soberano</skos:altLabel>
        <skos:altLabel>Sovereign State</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Staat</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">État souverain</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">主权国家</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">主権国家</skos:altLabel>
        <skos:definition>In international law, a sovereign state, sovereign country, or simply state, is a nonphysical juridical entity that is represented by one centralized government that has sovereignty over a geographic area.</skos:definition>
        <skos:hiddenLabel>SOVST</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZYx37m3oxpGunpx48tCOK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZYx37m3oxpGunpx48tCOK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:label>Foreign Ownership, Control, or Influence Claim</rdfs:label>
        <skos:altLabel>Foreign Influence Claim</skos:altLabel>
        <skos:altLabel>International Control Claim</skos:altLabel>
        <skos:altLabel>National Security Ownership Claim</skos:altLabel>
        <skos:definition>A Foreign Ownership, Control, or Influence (FOCI) Claim arises when a company or entity is alleged to be under foreign ownership, control, or influence, potentially compromising national security. This claim involves evaluating the extent of foreign involvement and its impact on the entity&apos;s operations, particularly in sectors critical to national security.</skos:definition>
        <skos:prefLabel>FOCI Violation Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZZ3NsCK0vyOmGji7SpKkW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZZ3NsCK0vyOmGji7SpKkW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RLvhxz3b1k2IU3MaAgeRtF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Illegal Dumping</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Despejo ilegal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dépôt illégal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Illegal Dumping</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tirar basura ilegalmente</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unerlaubtes Abladen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Vertido ilegal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זריקת פסולת בלתי חוקית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवैध डंपिंग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不法投棄</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法倾倒</skos:altLabel>
        <skos:definition>The act of disposing of waste materials in an unauthorized or illegal manner, which is classified as a minor criminal offense.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ZatpkyD1JTD0K3PqgGSQe -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZatpkyD1JTD0K3PqgGSQe">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R80nTp0xPWvxkJonwMOIvBA"/>
        <dc:source rdf:resource="https://www.nih.gov/nih-style-guide/sex-gender-sexuality"/>
        <rdfs:label>Two Spirit</rdfs:label>
        <skos:definition>Two Spirit is a term used within some Indigenous cultures in North America to describe a person who embodies characteristics of both masculine and feminine genders, or holds a unique gender role within their community. Legally, Two Spirit individuals may encounter unique challenges or require specific recognition and protection under laws pertaining to gender, cultural identity, and Indigenous rights.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Zct945cKp3L4WWrLxWWwu -->

