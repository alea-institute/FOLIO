        <skos:altLabel xml:lang="en-gb">Firm Disclosure Personnel</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mitarbeiter für die Entdeckung von Unternehmen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Personal de descubrimiento de la firma</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Personal de descubrimiento de la firma</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Personnel de découverte d&apos;entreprise</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pessoal de descoberta de empresas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צוות גילוי החברה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फर्म डिस्कवरी कर्मचारी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">企業発見の人員</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公司发现人员</skos:altLabel>
        <skos:definition>Firm Discovery Personnel refers to individuals within a legal service provider who are responsible for conducting discovery activities on behalf of the firm, but who are not billable timekeepers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9WHk620ZVZfEcaWa77fZ9p -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9WHk620ZVZfEcaWa77fZ9p">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zx0Z5V6kJy0JWEnLV91S8"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbAyL0ru5m8CyqAShGVq0e"/>
        <rdfs:label>Motion for Bail Pending Appeal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Kaution während des Berufungsverfahrens</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de libertad bajo fianza pendiente de apelación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Bail Pending Appeal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de liberdade provisória durante o recurso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en liberté sous caution en attendant l&apos;appel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de libertad bajo fianza pendiente de apelación</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לשחרור בערבון בהמתנה לערעור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपील के बेल के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保释候审动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴審判前保釈請求</skos:altLabel>
        <skos:definition>A Motion for Bail Pending Appeal is a request made to an appellate court to release a defendant from custody while their appeal is pending, allowing them to remain free until a final decision is made on their case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9WIzSXUBJgCc1GwyT1LZla -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9WIzSXUBJgCc1GwyT1LZla">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JJWlci2GwDGSMqF9e5IiW"/>
        <rdfs:label>Tinted Windows Violation Claim</rdfs:label>
        <skos:altLabel>Excessive Tinting Claim</skos:altLabel>
        <skos:altLabel>Unlawful Window Tinting Claim</skos:altLabel>
        <skos:altLabel>Window Tint Infraction Claim</skos:altLabel>
        <skos:definition>A Tinted Windows Violation Claim involves allegations that a vehicle&apos;s window tinting exceeds the legally allowed darkness or reflectivity, violating regulations that ensure driver visibility and law enforcement&apos;s ability to see inside vehicles for safety reasons. Such claims typically result in fines and may require the removal or replacement of the window tint.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9WJlyszPUEuaMnfLlhKx4Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9WJlyszPUEuaMnfLlhKx4Y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxLV9XEaDWbDIA8N1fl2fM"/>
        <rdfs:label>Minnesota District Court - Anoka County</rdfs:label>
        <skos:definition>A court located in Anoka County, Minnesota that has jurisdiction over certain legal matters within its geographical area.</skos:definition>
    </owl:Class>
    


