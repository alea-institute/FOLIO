        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332911"/>
        <rdfs:label>Industrial Valve Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing industrial valves and valves for water works and municipal water systems.</skos:definition>
        <skos:example>Complete fire hydrants manufacturing</skos:example>
        <skos:example>Industrial-type ball valves manufacturing</skos:example>
        <skos:example>Industrial-type butterfly valves manufacturing</skos:example>
        <skos:example>Industrial-type check valves manufacturing</skos:example>
        <skos:example>Industrial-type gate valves manufacturing</skos:example>
        <skos:example>Industrial-type globe valves manufacturing</skos:example>
        <skos:example>Industrial-type plug valves manufacturing</skos:example>
        <skos:example>Industrial-type solenoid valves (except fluid power) manufacturing</skos:example>
        <skos:example>Industrial-type steam traps manufacturing</skos:example>
        <skos:example>Valves for nuclear applications manufacturing</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/diWuW6jcRmyt0AiiCTgOlQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/diWuW6jcRmyt0AiiCTgOlQ">
