        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKppctNnwfRJlk3uGTiJ5M"/>
        <rdfs:label>Unauthorized Practice Claims</rdfs:label>
        <skos:definition>Unauthorized Practice Claims refer to legal allegations or complaints asserting that an individual or entity has engaged in professional activities without the required licensure or authorization in a specific field. These claims are commonly associated with regulated professions such as law and medicine, where practicing without proper credentials can pose significant risks to the public.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCbIs82TvJdzuch0zpH1cOx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCbIs82TvJdzuch0zpH1cOx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBrSWvfPR3YZFl63qupzFML"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_20"/>
        <rdfs:label>Coma</rdfs:label>
        <skos:definition>A coma is a deep state of unconsciousness in which an individual cannot be awakened and fails to respond to external stimuli or internal needs. It is a medical condition that can result from various causes, including brain injury, stroke, or illness, and has significant legal implications for decision-making and guardianship.</skos:definition>
        <skos:prefLabel>Comatose State</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCbLjaI2HGm94nXmkypxmaf -->

