        <skos:altLabel xml:lang="pt-br">Faixa de imposto percentual de imposto</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Porcentaje de impuestos por nivel de impuestos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Porcentaje de impuestos por nivel de impuestos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Steuerstufe Steuerprozentsatz</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tax Tier Tax Percent</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tranche fiscale pourcentage d&apos;imposition</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחוז המס לשכבת המס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टैक्स टियर टैक्स प्रतिशत</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">税收层次税收百分比</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">税金ティア税金パーセント</skos:altLabel>
        <skos:definition>Tax Tier Tax Percent refers to the percentage of tax applied to a specific tier of income or value, as a part of the Tax Tier Detail concept in legal services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8tPYphBPF4fzyL7swXcykq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8tPYphBPF4fzyL7swXcykq">
