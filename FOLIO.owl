    <!-- https://folio.openlegalstandard.org/R9Bu0U5ru3yBeWZ0x4zE6XA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Bu0U5ru3yBeWZ0x4zE6XA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Public Benefit Diversion Objective</rdfs:label>
        <skos:definition>Public Benefit Diversion Objective refers to policy goals aimed at reducing dependency on long-term public assistance by encouraging alternative means of support, such as employment or private aid. Methods can include offering lump-sum payments, vouchers, or services like job training and placement to encourage individuals to transition away from ongoing public benefit programs.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Bw5UbGSMoWIOSQwhD9igL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Bw5UbGSMoWIOSQwhD9igL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1PpxLN7jiSIvJVou8IjDG"/>
        <rdfs:label>By Time with Collar</rdfs:label>
        <skos:altLabel xml:lang="en-gb">By Time with Collar</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nach Zeit mit Kragen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Par temps avec collier</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Por tempo com colarinho</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Por tiempo con collar</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Por tiempo con cuello</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לפי זמן עם כרום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कॉलर के साथ समय द्वारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">カラー付きの時間別</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">按时间计算带领子</skos:altLabel>
        <skos:definition>Engagement fee model where client and provider specify a range, and (1) if the ultimate fees are within that range, the fee becomes final, (2) if the ultimate fees are below that range, then the savings are shared, and (3) if the ultimate fees are above that range, then the client pays the provider a percentage of the excess.</skos:definition>
    </owl:Class>
    


