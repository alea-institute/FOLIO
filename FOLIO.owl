        <skos:altLabel xml:lang="fr-fr">Indications raisonnables</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Indicios Razonables</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Indicios Razonables</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indícios razoáveis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Reasonable Indications</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מפניות סבירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">योग्य संकेत</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合理的な示唆</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合理迹象</skos:altLabel>
        <skos:definition>Reasonable Indications refer to the level of evidence required to shift the burden of proof in a legal matter, specifically in litigation, where the party with the burden of proof must provide evidence to support their claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8J90LOzSrAGxmeAYLlrnXZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8J90LOzSrAGxmeAYLlrnXZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDECjssxw76vdlahxiUTb4L"/>
        <rdfs:label>Missouri Circuit Court - Bollinger County</rdfs:label>
        <skos:definition>Missouri Circuit Court - Bollinger County: A specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Bollinger County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JAi8C4J0QARz3c14SHh3I -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JAi8C4J0QARz3c14SHh3I">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
        <rdfs:label>Commercial Property Foreclosure</rdfs:label>
        <skos:definition>Commercial Property Foreclosure is the legal procedure through which a lender seizes a commercial property, such as an office building or retail space, due to the borrower&apos;s failure to meet financial obligations specified in the mortgage contract. The property is then sold, usually through a public auction, to recoup the unpaid loan amount and any additional costs incurred during the foreclosure process</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JD1lDUH8pAfEjRdeKJ5xF -->

