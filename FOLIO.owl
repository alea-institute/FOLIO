        <skos:altLabel xml:lang="ja-jp">無効分析の実践</skos:altLabel>
        <skos:definition>Invalidity Analysis Practice is a legal service that involves investigating and developing facts related to the invalidity of a legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RbtZExft9n6SUAnvrTrmO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8RbtZExft9n6SUAnvrTrmO">
