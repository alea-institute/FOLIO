        <rdfs:label>Fee Adjustment Note</rdfs:label>
        <skos:altLabel>Fee Adjustment</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Fee Adjustment Note</skos:altLabel>
        <skos:altLabel>Fee Credit Note</skos:altLabel>
        <skos:altLabel>Fee Discount Note</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebührenanpassungsnotiz</skos:altLabel>
