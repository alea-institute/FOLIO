    <!-- https://folio.openlegalstandard.org/R84O5MFBD4yVpz5EoTditqc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R84O5MFBD4yVpz5EoTditqc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJ0dgV4Z2Xk7aGfJt2nSj7"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_03"/>
        <rdfs:label>Systemic Vasculitis</rdfs:label>
        <skos:altLabel>Multi-Organ Vascular Inflammation</skos:altLabel>
        <skos:altLabel>Systemic Vasculitic Syndrome</skos:altLabel>
        <skos:altLabel>Vascular Inflammatory Disease</skos:altLabel>
        <skos:definition>Vasculitis is an inflammation of blood vessels. It may occur acutely in association with adverse drug reactions, certain chronic infections, and occasionally, malignancies. More often, it is chronic and the cause is unknown. Symptoms vary depending on which blood vessels are involved. Systemic vasculitis may also be associated with other autoimmune disorders; for example, SLE or dermatomyositis.</skos:definition>
    </owl:Class>
    


