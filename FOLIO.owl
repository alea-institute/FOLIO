        <dc:identifier>RET-BMGD</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=444"/>
        <rdfs:label>Building Material and Garden Equipment and Supplies Dealers Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Baumaterial- und Gartenbauindustrie</skos:altLabel>
        <skos:altLabel>Building Material and Garden Equipment</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Building Material and Garden Equipment Industry</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de materiales de construcción y equipos de jardinería</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de materiales de construcción y equipos de jardinería</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des matériaux de construction et des équipements de jardin</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de materiais de construção e equipamentos de jardim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית חומרי בניין וציוד גינון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भवन सामग्री और बागवानी उपकरण उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">建材・園芸機器産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">建筑材料和园艺设备行业</skos:altLabel>
        <skos:definition>Industries in the Building Material and Garden Equipment and Supplies Dealers subsector retail new building materials, hardware, paint, and garden and outdoor power equipment and supplies.  Establishments in this subsector with fixed point-of-sale locations, including home centers and retail lumber yards, may display merchandise either indoors or outdoors under covered areas.  The staff is usually knowledgeable in the use of the specific products being retailed in the construction, repair, and maintenance of the home and associated grounds.</skos:definition>
        <skos:hiddenLabel>BMGD</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC9hKRPbfUdQjXfAQBLwpGO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC9hKRPbfUdQjXfAQBLwpGO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_11"/>
        <rdfs:label>Skeletal System Cancer</rdfs:label>
        <skos:altLabel>Bone Malignancy</skos:altLabel>
        <skos:altLabel>Osseous Neoplasm</skos:altLabel>
        <skos:definition>Skeletal system cancer, also known as bone cancer, refers to malignant tumors that originate in the bones, including both primary bone cancers like osteosarcoma and secondary cancers that have metastasized from other body parts. These cancers can cause severe pain, fractures, and impaired mobility, necessitating comprehensive treatment and management.</skos:definition>
        <skos:prefLabel>Bone Cancer</skos:prefLabel>
    </owl:Class>
    


