    <!-- https://folio.openlegalstandard.org/RbNdxLlwhsOPsmRLO2nN7Q -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RbNdxLlwhsOPsmRLO2nN7Q">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
        <rdfs:label>Orthodontics Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle en orthodontie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kieferorthopädische Kunstfehler</skos:altLabel>
