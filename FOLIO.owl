        <skos:altLabel xml:lang="ja-jp">請求を許可する動議</skos:altLabel>
        <skos:definition>A Motion to Allow Claims is a request made in a bankruptcy case to permit creditors to assert their claims against the debtor&apos;s estate.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Revs4g1weWrrjVNT9CQSy3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Revs4g1weWrrjVNT9CQSy3">
