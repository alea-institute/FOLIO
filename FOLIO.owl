        <skos:altLabel xml:lang="en-gb">Amortisation Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Amortisationsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;amortissement</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Amortización</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Amortización</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de amortização</skos:altLabel>
