        <rdfs:label>Kimbundu</rdfs:label>
        <skos:altLabel xml:lang="de-de">Kimbundu</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Kimbundu</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Kimbundu</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">キンブンド語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">金邦杜语</skos:altLabel>
        <skos:definition>Kimbundu (Language) is a structured system of communication that consists of grammar and vocabulary, specifically referring to the language spoken by the Kimbundu people in Angola.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHYAaMF4QRHH9QwmNKGN8Y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHYAaMF4QRHH9QwmNKGN8Y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBU9zZzHpiivyY3EFmul3Ja"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Specific Learning Disorder</rdfs:label>
        <skos:altLabel>Academic Disability</skos:altLabel>
        <skos:altLabel>Cognitive Learning Disorder</skos:altLabel>
        <skos:altLabel>Learning Disorder</skos:altLabel>
        <skos:altLabel>Learning Impairment</skos:altLabel>
        <skos:definition>Specific Learning Disorder is a neurodevelopmental condition characterized by persistent difficulties in learning and using academic skills. These difficulties manifest in areas such as reading, writing, or mathematics, and are not attributable to intellectual disabilities, sensory impairments, or inadequate educational opportunities. It affects an individual&apos;s ability to process and comprehend information, leading to difficulties in reading, writing, math, or other cognitive skills essential for academic performance. These disabilities are lifelong conditions that can vary in severity and often require specialized teaching methods and accommodations to support learning.</skos:definition>
        <skos:prefLabel>Learning Disability</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHbjppawvAlt5WcUyfjeN8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHbjppawvAlt5WcUyfjeN8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV"/>
        <rdfs:label>Governmental Immunity for Condition of Public Property</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Governmental Immunity for Condition of Public Property</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Immunité gouvernementale pour l&apos;état des biens publics</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imunidade governamental para condição de propriedade pública</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inmunidad gubernamental por la condición de la propiedad pública</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad gubernamental por la condición de la propiedad pública</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Regierungsimmunität für den Zustand öffentlicher Einrichtungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות ממשלתית עבור מצב הנכס הציבורי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक संपत्ति की स्थिति के लिए सरकारी संविदा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共財産の状態に対する政府免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公共财产状况的政府豁免权</skos:altLabel>
        <skos:definition>Governmental Immunity for Condition of Public Property: A legal concept that shields government entities from liability for injuries or damages caused by the condition of public property, unless the government entity failed to take reasonable steps to correct the dangerous condition.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHblIffFKKYufvvopGuD8D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHblIffFKKYufvvopGuD8D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDu2iPpQAdciNSirAd52mw4"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm"/>
        <rdfs:label>Pituitary Gland Disorders</rdfs:label>
        <skos:altLabel>Hypophyseal Disorders</skos:altLabel>
        <skos:altLabel>Pituitary Disorders</skos:altLabel>
        <skos:altLabel>Pituitary Gland Dysfunction</skos:altLabel>
        <skos:definition>Pituitary gland disorders involve conditions affecting the pituitary gland, an endocrine organ responsible for regulating various bodily functions through hormone production. These disorders can lead to hormonal imbalances and impact growth, metabolism, and reproductive functions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHbsDvJdqhGThl6Kx4V0xI -->

