        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCba8uyTZCMHkiU7hlS4xNq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion for New Trial - Excessive Damages</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Neues Verfahren - Überhöhte Schadensersatzforderungen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Nuevo Juicio - Daños Excesivos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Nuevo Juicio - Daños Excesivos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for New Trial - Excessive Damages</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour un Nouveau Procès - Dommages Excessifs</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Novo Julgamento - Danos Excessivos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למשפט חדש - נזקים יתר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नए न्यायिक प्रक्रिया के लिए याचिका - अत्यधिक नुकसान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">新しい裁判のための動議 - 過剰な損害賠償</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">新审判动议 - 过高的损害赔偿</skos:altLabel>
        <skos:definition>A Motion for New Trial - Excessive Damages is a legal request made by a party to a lawsuit asking the court to set aside a previous verdict and order a new trial due to the excessive amount of damages awarded.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KiY8F9Txea9UFAm4jnDx6 -->

