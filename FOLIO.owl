        <rdfs:label>Debt Investment Assets</rdfs:label>
        <skos:definition>Debt investment assets are financial instruments where an investor lends money to an entity with the expectation of receiving periodic interest payments and the return of the principal amount at a specified maturity date. Examples include bonds, certificates of deposit, and promissory notes</skos:definition>
    </owl:Class>
    


