        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=531312"/>
        <rdfs:label>Nonresidential Property Managers</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in managing nonresidential real estate for others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/or0GbPZLRVCU3cGGZ5fUfA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/or0GbPZLRVCU3cGGZ5fUfA">
