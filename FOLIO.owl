        <rdfs:label>Denial</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Denial</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Refus</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verweigerung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כחול לבן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">इनकार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">否認</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">否认</skos:altLabel>
        <skos:definition>Denial is a response to a claim where the defendant asserts that the allegations made against them are false or invalid.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yKOOYKMPmdNJDygmz2Enh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8yKOOYKMPmdNJDygmz2Enh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8R7UAZpzIQTdqNtctKj3XY"/>
        <rdfs:label>Medical Payment Evidentiary Objection</rdfs:label>
        <skos:altLabel>Health Expense Evidence Objection</skos:altLabel>
        <skos:altLabel>Medical Bill Payment Objection</skos:altLabel>
        <skos:definition>A Medical Payment Evidentiary Objection is raised when a party in a legal proceeding believes that evidence of payments made for medical expenses is being used to prove liability or fault. This objection aims to prevent the prejudicial impact of such evidence, as the payment of medical bills does not necessarily indicate an admission of liability.</skos:definition>
        <skos:prefLabel>Objection to Evidence of Medical Expense Payments</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8yLInPLDkY42ZVxcL1ButZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8yLInPLDkY42ZVxcL1ButZ">
