        <skos:altLabel xml:lang="pt-br">Evento adiado / reagendado</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Evento pospuesto / reprogramado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento pospuesto / reprogramado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Veranstaltung verschoben / neu terminiert</skos:altLabel>
