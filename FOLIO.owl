        <skos:altLabel>Direct Debt Placement</skos:altLabel>
        <skos:altLabel>Self-Managed Debt Issuance</skos:altLabel>
        <skos:definition>A Direct Debt Offering refers to the issuance of debt securities by a borrower directly to investors, without the involvement of underwriters or intermediaries. This approach allows the issuer to raise capital efficiently, often at a lower cost, by bypassing traditional financial institutions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeBJGHSTNvkUHCeiTpMjv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeBJGHSTNvkUHCeiTpMjv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Tsonga</rdfs:label>
        <skos:altLabel xml:lang="de-de">Tsonga</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Tsonga</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tsonga</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ツォンガ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">聪萨语</skos:altLabel>
        <skos:definition>Tsonga is a structured system of communication consisting of grammar and vocabulary, and is a specific language within the context of legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7tKtki2tvT0I1cpSLJSWRF"/>
        <rdfs:label>Allied Legal Professional</rdfs:label>
        <skos:altLabel>Legal Support Staff</skos:altLabel>
        <skos:definition>An allied legal professional supports the delivery of legal services through specialized skills and knowledge. These professionals work in various roles, such as paralegals, law librarians, and legal marketing personnel, all enabling legal service providers (e.g., law firms) to deliver legal services.</skos:definition>
        <skos:prefLabel>Non-Lawyer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeG3mRd2kFDSwM398NuhrV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeG3mRd2kFDSwM398NuhrV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzVJL7xHCPdcNwnHbt71AD"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Supplementary Papers</rdfs:label>
        <skos:altLabel xml:lang="es-es">Documentos complementarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Documentos complementarios</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Ergänzungspapiere</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Papiers supplémentaires</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Papéis suplementares</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Supplementary Papers</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מסמכים נלווים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूरक पेपर्स</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">补充文件</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">補足資料</skos:altLabel>
        <skos:definition>Supplementary Papers refer to additional documents submitted to a court after the initial filing of an appeal, specifically in relation to requests for rehearing or further supplements to the original filing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeKmVl4PL78uA2J5r53a2C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeKmVl4PL78uA2J5r53a2C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
        <rdfs:label>Political Questions</rdfs:label>
        <skos:definition>Political questions refer to issues that courts deem inappropriate for judicial review because they involve decisions best made by the legislative or executive branches of government. In such cases, the judiciary typically refrains from ruling, citing a lack of judicially manageable standards and the need to respect the separation of powers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeMeMkbzNzWOKmp6XaitcC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeMeMkbzNzWOKmp6XaitcC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxq2qQYpdo9stHOBIQhub7"/>
        <rdfs:label>Roadway Dedication</rdfs:label>
        <skos:definition>Roadway Dedication is the legal process by which a private entity or individual transfers land to a public entity for the specific purpose of constructing or expanding a public road. This act typically requires formal documentation, legal agreements, and may involve negotiations between private and public parties to meet local planning and zoning requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeRtGBTwYZfFytTgBAbLti -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeRtGBTwYZfFytTgBAbLti">
