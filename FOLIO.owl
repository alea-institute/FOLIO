    <!-- https://folio.openlegalstandard.org/RCO0bQHRPXZEgZEAXRIi8PM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCO0bQHRPXZEgZEAXRIi8PM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVu433XojPQPseoDXhidgO"/>
        <rdfs:label>Rural Market Segment</rdfs:label>
        <skos:definition>The rural market segment consists of consumers or businesses located in countryside areas or small towns, typically characterized by lower population density and distinct lifestyle and consumption patterns compared to urban areas. Businesses targeting this segment often adapt their products and marketing strategies to cater to the needs and preferences of rural consumers, who may have limited access to certain goods and services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCO3L5hcD4bjMazJRF882MA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCO3L5hcD4bjMazJRF882MA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Mutual Confidentiality Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de confidentialité mutuelle</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de confidencialidad mutua</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de confidencialidad mutua</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de confidencialidade mútua</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenseitige Vertraulichkeitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mutual Confidentiality Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף סודיות משותף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सहयोगी गोपनीयता शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">相互保密条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">相互機密保持条項</skos:altLabel>
        <skos:definition>A mutual confidentiality clause is a provision in a contract that requires both parties to keep certain information confidential and not disclose it to third parties without consent.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCO44KDjbrsXWrfx78yL53K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCO44KDjbrsXWrfx78yL53K">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rchny3YFXoQyenv6XUbyo0"/>
        <rdfs:label>Jury Deliberation</rdfs:label>
        <skos:altLabel xml:lang="de-de">Beratung der Geschworenen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Deliberación del jurado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Deliberación del jurado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Deliberação do júri</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Délibération du jury</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Jury Deliberation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התיישנות השופטים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ज्यूरी विचार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">陪审团商议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">陪審員の審議</skos:altLabel>
        <skos:definition>Jury Deliberation refers to the process by which a group of jurors discuss and analyze evidence presented during a trial in order to reach a verdict.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCO5FBZfgN8P43sMsRpTesd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCO5FBZfgN8P43sMsRpTesd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDS8DPtuFReTFfJ5nGCczD5"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RVaHiNBU68DENmeHicnzro"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Art</rdfs:label>
        <skos:altLabel>Artwork</skos:altLabel>
        <skos:altLabel>Creative Expression</skos:altLabel>
        <skos:altLabel>Creative Work</skos:altLabel>
        <skos:altLabel>Fine Art</skos:altLabel>
        <skos:altLabel>Visual Art</skos:altLabel>
        <skos:definition>Art refers to the expression or application of human creative skill and imagination, typically in a visual form such as painting or sculpture, producing works to be appreciated primarily for their beauty or emotional power. It encompasses various mediums, techniques, and styles, which are often subject to cultural and historical context.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCO7veX8H4s4WJfdrKC61N6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCO7veX8H4s4WJfdrKC61N6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9847SXyPLJAgrYHCLthP56"/>
        <rdfs:label>Malicious Civil Prosecution</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Ação civil maliciosa</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Böswillige Zivilklage</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Malicious Civil Prosecution</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Poursuite civile malveillante</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Procedimiento civil malicioso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Procedimiento civil malintencionado</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה אזרחית רשלנית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दुर्भाग्यपूर्ण सिविल अभियोग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">恶意民事诉讼</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">悪意のある民事訴訟</skos:altLabel>
        <skos:definition>The concept of Malicious Civil Prosecution refers to the intentional and wrongful initiation of a civil lawsuit without probable cause, for the purpose of harassing, injuring, or otherwise causing harm to the defendant.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCO8vPIIGC7P4PcjCa9cYBG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCO8vPIIGC7P4PcjCa9cYBG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
        <rdfs:label>Restrictive Covenant</rdfs:label>
        <skos:definition>A restrictive covenant, in property law, is a clause in a contract or deed that limits what the owner of the property can do with it, often to preserve the value and enjoyment of adjoining properties. In employment law, it refers to an agreement, typically between an employer and employee, that restricts the employee&apos;s actions post-employment, such as prohibiting competition or solicitation of clients.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCOAttIoMLbO1VAdvmk1Ym1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCOAttIoMLbO1VAdvmk1Ym1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Montauk</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCOEo683nGTMlV6VjomHQ8D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCOEo683nGTMlV6VjomHQ8D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9KcDahapJG8vbCxXh6JDwm"/>
        <rdfs:label>Bullying</rdfs:label>
        <skos:definition>A bullying claim is a legal assertion that an individual has been subjected to repeated aggressive behavior, typically involving a real or perceived power imbalance. It can occur in various environments, including the workplace, schools, and online, and may involve physical, verbal, or psychological harassment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCOLYxt8alD3aUMFnWyKyeb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCOLYxt8alD3aUMFnWyKyeb">
