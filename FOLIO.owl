        <skos:altLabel xml:lang="de-de">Kündigungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בדיקת פסק וחזרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विराम अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">中止条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">解除条項</skos:altLabel>
        <skos:definition>A break clause is a provision in a contract that allows one or both parties to terminate the agreement before the end of its term.</skos:definition>
    </owl:Class>
    


