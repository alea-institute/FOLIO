        <skos:altLabel xml:lang="en-gb">Retainer</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Retenedor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Retenedor</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מְשַׁמֵּר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रिटेनर</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">聘请</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">顧問契約</skos:altLabel>
        <skos:definition>A recurring amount agreed to be billed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCJC86Ng8OLL0uVSv8HxhwB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCJC86Ng8OLL0uVSv8HxhwB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP"/>
        <dc:identifier>RET-FBVS</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=445"/>
        <rdfs:label>Food and Beverage Retailers Industry</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Food and Beverage Store Industry</skos:altLabel>
        <skos:altLabel>Food and Beverage Stores</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de tiendas de alimentos y bebidas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de tiendas de alimentos y bebidas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des magasins d&apos;alimentation et de boissons</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de lojas de alimentos e bebidas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lebensmittel- und Getränkegeschäftsbranche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית חנויות מזון ומשקאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खाद्य और पेय स्टोर उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">食品・飲料店業界</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">食品和饮料商店行业</skos:altLabel>
        <skos:definition>Industries in the Food and Beverage Retailers subsector primarily retail general or specialized lines of food and beverage products.  Establishments in this subsector with fixed point-of-sale locations have special equipment (e.g., freezers, refrigerated display cases, refrigerators) for displaying food and beverage products and have staff trained in the processing of food products to guarantee the proper storage and sanitary conditions required by regulatory authority.  Vending machine operators are also included in this subsector.</skos:definition>
        <skos:hiddenLabel>FBVS</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCJElSi1iqsNDc4FSWySKZO -->

