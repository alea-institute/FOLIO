                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RD56727CABa3aB066e948fc1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>110 Insurance (PACER NoS)</rdfs:label>
        <skos:definition>Action alleging breach of insurance contract, tort claim, or other cause related to an insurance contract, except for maritime insurance contracts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9VVYDIL7kBFA445Dir6MJy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9VVYDIL7kBFA445Dir6MJy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP"/>
        <rdfs:label>Kale</rdfs:label>
        <skos:altLabel>Brassica Oleracea Var. Acephala</skos:altLabel>
        <skos:definition>Kale is a leafy green vegetable from the Brassica oleracea species, known for its curly or flat leaves and robust, earthy flavor. It is consumed raw or cooked and is valued for its exceptional nutritional content, including high levels of vitamins A, C, and K, as well as calcium and antioxidants.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9VdnoybnEodiN0EUTedSOz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9VdnoybnEodiN0EUTedSOz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
        <rdfs:label>fee segment</rdfs:label>
        <skos:definition>&quot;The fee items included in the matter/invoice.  There will be 0 or more FEE segments per MATTER segment.  

All fee items are subject to the same MATTER_DISC_CRED.disc_cred MISF (Matter/Invoice Shared Fee) and MIDB (Matter/Invoice Discounted Bill) as all expense items for this matter/invoice.  If fee items are not subject to the same MISF or MIDB, they should be billed in a separate invoice.  E-Billing system rules that limit law firms to submitting only one invoice per quarter (or other time period) will need to change their logic so that bills of this type will be accommodated.&quot;</skos:definition>
    </owl:Class>
    


