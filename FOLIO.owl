        <rdfs:label>California Court of Appeal - 1st Dist.</rdfs:label>
        <skos:definition>The California Court of Appeal - 1st Dist. is a specific division of the California Court of Appeal, which is a higher court that hears appeals from lower courts in California.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7M2So7cSnn0yNcjECUou9K -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7M2So7cSnn0yNcjECUou9K">
