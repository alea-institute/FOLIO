    <!-- https://folio.openlegalstandard.org/RDJ5gLF3diEDjeGSux0X4TJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJ5gLF3diEDjeGSux0X4TJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7PHFZzZmVmczzNQl6iZKsa"/>
        <rdfs:label>Undersecured Creditor</rdfs:label>
        <skos:altLabel>Inadequately Secured Creditor</skos:altLabel>
        <skos:altLabel>Insufficiently Secured Lender</skos:altLabel>
        <skos:altLabel>Partially Secured Creditor</skos:altLabel>
        <skos:definition>An Undersecured Creditor is a lender whose collateral value securing a loan is less than the outstanding debt owed by the borrower. This situation often arises in bankruptcy contexts, affecting the creditor’s ability to fully recover the loan amount through collateral liquidation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJ9jbKtSOU0ZiD1spYiP1N -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJ9jbKtSOU0ZiD1spYiP1N">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9CVzEeaWrAlqPlPGv5TPjl"/>
        <rdfs:label>Motion to Dismiss for Lack of Subject Matter Jurisdiction</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Abweisung mangels Zuständigkeit des Gerichts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Desestimación por Falta de Jurisdicción sobre la Materia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Desestimación por Falta de Jurisdicción sobre la Materia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Dismiss for Lack of Subject Matter Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Arquivamento por Falta de Jurisdição Material</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en rejet pour absence de compétence matérielle</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לדחיית התביעה עקב חוסר סמכות כתבית נושא</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विषय विषयक अधिकरण की कमी के लिए खारिजी की मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">管轄権の欠如に基づく却下の申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">缺乏主题管辖权的驳回动议</skos:altLabel>
        <skos:definition>A Motion to Dismiss for Lack of Subject Matter Jurisdiction is a legal request to terminate a case due to the court lacking the authority to hear and decide on the specific legal matter at hand.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJGO2CCArhfhsh9diMdmd1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJGO2CCArhfhsh9diMdmd1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV"/>
        <rdfs:label>Official Immunity</rdfs:label>
        <skos:altLabel xml:lang="de-de">Amtshaftungsimmunität</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Immunité officielle</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Imunidade oficial</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inmunidad oficial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad oficial</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Official Immunity</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות רשמית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आधिकारिक अवरोध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公式免責</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">官方豁免权</skos:altLabel>
        <skos:definition>Official Immunity: Legal protection granted to government officials from being held personally liable for actions taken in the course of their official duties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJGZMiDpzOg0usYKbblkC3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJGZMiDpzOg0usYKbblkC3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ahGaNbVpIwATBsrRg3EZp"/>
        <rdfs:label>Kansas District Court - Labette County, Oswego</rdfs:label>
        <skos:definition>A court located in Labette County, Oswego, Kansas that has jurisdiction over certain legal matters within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJHR4WqMpTsR6pGC2fpzXx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJHR4WqMpTsR6pGC2fpzXx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROEhQluRR7rfqDyDYvJ3Dd"/>
        <rdfs:label>Travel Document Valid From</rdfs:label>
        <skos:definition>The &quot;Travel Document Valid From&quot; date indicates the starting date from which a travel document such as a passport or visa becomes legally valid for use. This date may differ from the issued date and marks the beginning of the period during which the holder is authorized to travel under the conditions specified by the document</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJKYhVrQurg0zQmBqlGpTE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJKYhVrQurg0zQmBqlGpTE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
        <rdfs:label>Post-Petition Transfer Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Créance de transfert post-pétition</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Forderung aus einer Übertragung nach Insolvenzantragstellung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Post-Petition Transfer Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de transferencia posterior a la petición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de transferencia posterior a la petición</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de transferência pós-petição</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת העברת חובות לאחר הפטיציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पोस्ट-पिटीशन ट्रांसफर दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">申请后转移索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産申請後の譲渡請求債権</skos:altLabel>
        <skos:definition>A post-petition transfer claim is a type of avoidance action claim in bankruptcy law that seeks to recover property or assets transferred by a debtor after the filing of a bankruptcy petition.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJM7d52FqDzFaBbtRdhECs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJM7d52FqDzFaBbtRdhECs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Limitations</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einschränkungen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Limitaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Limitaciones</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Limitations</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Limitations</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Limitações</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגבלות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सीमाएं</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">制限</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">限制</skos:altLabel>
        <skos:definition>The concept of Limitations refers to the legal time constraints that restrict the period within which a party can bring a claim or defense in a civil litigation matter, including statutes of repose, frauds, and limitations, equitable tolling, and laches.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJPhq9RjJu1rvptoQKqbbI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJPhq9RjJu1rvptoQKqbbI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HTLbEXSzD7fXO9Hu6mTmb"/>
        <rdfs:label>Airplane</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Aeroplane</skos:altLabel>
        <skos:altLabel>Fixed-Wing Air Vehicle</skos:altLabel>
        <skos:altLabel>Fixed-Wing Aircraft</skos:altLabel>
        <skos:altLabel>Jet</skos:altLabel>
        <skos:altLabel>Plane</skos:altLabel>
        <skos:definition>An Airplane is a powered fixed-wing aircraft that achieves flight through the use of forward thrust and aerodynamic lift. It typically has a fuselage, wings, and one or more engines, and is designed for transporting passengers, cargo, or both.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJUDQGYk9rhdIFXzTyv11u -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJUDQGYk9rhdIFXzTyv11u">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfP04tDTTpn4LDvwAxAqkh"/>
        <rdfs:label>Substantive Due Process Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf materielle Rechtsstaatlichkeit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de debido proceso sustantivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de debido proceso sustantivo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de devido processo legal material</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de procédure régulière</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Substantive Due Process Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת תהליך דיון משמעותי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वास्तविक दंड प्रक्रिया दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实体正当程序主张</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">実質的な正当な手続きの主張</skos:altLabel>
        <skos:definition>A substantive due process claim is a legal action initiated by an individual or entity alleging that their fundamental rights, as protected by the Due Process Clauses of the Fifth and Fourteenth Amendments of the United States Constitution, have been violated by the government or a government actor. Substantive due process protects individuals from arbitrary or unreasonable government actions that infringe on fundamental rights, even if proper procedures were followed. A substantive due process claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts a fundamental right (e.g., the right to privacy, the right to marry, or the right to make decisions about family matters) or when a government actor takes an arbitrary or irrational action that infringes on an individual&apos;s rights.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJWZSnQkLCRb0PTCafsUD9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJWZSnQkLCRb0PTCafsUD9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBxw7BF15bDA0Ifn2vOrC8h"/>
        <rdfs:label>Georgia District Court - Dougherty County</rdfs:label>
        <skos:definition>A court located in Dougherty County, Georgia that has jurisdiction over certain legal matters within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJWZaJFpjsPgcq6eYiav5a -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJWZaJFpjsPgcq6eYiav5a">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R66kux3H2uERxPz0E7KxtN"/>
        <rdfs:label>Joy</rdfs:label>
        <skos:altLabel>Bliss</skos:altLabel>
        <skos:altLabel>Contentment</skos:altLabel>
        <skos:altLabel>Delight</skos:altLabel>
        <skos:altLabel>Elation</skos:altLabel>
        <skos:altLabel>Jubilation</skos:altLabel>
        <skos:definition>Joy is an emotion of great pleasure or happiness, often resulting from success, good fortune, or a sense of well-being.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJYLQ3woaBs6FkT7wMbB4U -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJYLQ3woaBs6FkT7wMbB4U">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCcidDCaGrSequSQ0hnokdb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Wrongful Discharge or Termination</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Demissão ou rescisão injusta</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Despido Improcedente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Licenciement ou résiliation abusive</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Terminación Injusta</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unrechtmäßige Kündigung oder Entlassung</skos:altLabel>
        <skos:altLabel>Wrongful Discharge</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wrongful Dismissal or Termination</skos:altLabel>
        <skos:altLabel>Wrongful Termination</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים בלתי חוקיים או סיום חוקי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गलत निकास या अंतिम करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不当解雇または終了</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法解雇或终止</skos:altLabel>
        <skos:definition>The concept of Wrongful Discharge or Termination refers to the illegal firing or dismissal of an employee by an employer, in violation of the law or employment contract.</skos:definition>
        <skos:prefLabel>Wrongful Termination</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJc44Ilo9XW8Y74blNyfO9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJc44Ilo9XW8Y74blNyfO9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ReswYRsH8IbmoE68QpgOCd"/>
        <rdfs:label>Supplemental Jurisdiction</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ergänzende Gerichtsbarkeit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Juridiction supplémentaire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Jurisdicción Suplementaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Jurisdicción Suplementaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisdição suplementar</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Supplemental Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט משלים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूरक अधिकार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">补充管辖权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">補足的司法権</skos:altLabel>
        <skos:definition>Supplemental Jurisdiction refers to the authority of a court to hear and decide on claims that are related to the original claim, but may not fall under the court&apos;s primary jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJcJ6zr1Q6V6fF7cMytaoU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJcJ6zr1Q6V6fF7cMytaoU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zwKGkogGKIKWSVWb1ItRL"/>
        <rdfs:label>Motion for Royalty</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Lizenzgebühren</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de regalías</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Royalty</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Petición de regalías</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição por royalties</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en matière de redevances</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לזכויות יוצרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रॉयल्टी के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ロイヤルティの申立て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">版税动议</skos:altLabel>
        <skos:definition>A Motion for Royalty is a formal request made to a trial court for compensation or ongoing payment for the use of intellectual property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJdE3YoLZbldxnPJMYCyrx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJdE3YoLZbldxnPJMYCyrx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zrphg3yY4ZZzvj2CAu6hN"/>
        <rdfs:label>Contact Full Name</rdfs:label>
        <skos:definition>Contact Full Name refers to the complete legal name of an individual serving as a point of contact in professional or business interactions. This often includes the person&apos;s first name, middle name or initial, and last name, and is used for formal documentation and communication.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJgy4NDLgsP7qaqied5k5c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJgy4NDLgsP7qaqied5k5c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR0Wfb4Zz9V56W2ri7JeTU"/>
        <rdfs:label>Interactive Media</rdfs:label>
        <skos:altLabel>Digital Interactive Work</skos:altLabel>
        <skos:altLabel>Interactive Content</skos:altLabel>
        <skos:definition>Interactive Media refers to digital content that requires user interaction to deliver its content, such as video games, virtual reality experiences, and interactive websites. Protected under copyright law, interactive media grants the creators exclusive rights to reproduce, distribute, and display the content.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJpP80M638JNtaUBT73xB8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJpP80M638JNtaUBT73xB8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKIYD2zDw4nfizmybGcOn1"/>
        <rdfs:label>Proceeding Transferred Into This Dispute Forum</rdfs:label>
        <skos:altLabel>Case Transferred Into This Dispute Forum</skos:altLabel>
        <skos:definition>The concept of &quot;Case Transferred Into This Dispute Forum&quot; refers to a legal matter that has been moved from another forum to the current forum for resolution, and is currently open or pending.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJqeqCuDHyFSnpfHfmeHEW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJqeqCuDHyFSnpfHfmeHEW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KnhbKXnWBeCBhayT7e9BY"/>
        <rdfs:label>Warranty</rdfs:label>
        <skos:definition>A Warranty is a promise or guarantee provided by a manufacturer or seller to the buyer concerning the quality, condition, or functionality of a product for a specified period. If the product fails to meet the stipulated conditions during the warranty period, the manufacturer or seller is obliged to repair, replace, or refund the product.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJrTFbZzszQTzfaqdDQ7CW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJrTFbZzszQTzfaqdDQ7CW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Minangkabau</rdfs:label>
        <skos:altLabel xml:lang="de-de">Minangkabau</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Minangkabau</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Minangkabau</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ミナンカバウ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民丹卡峇鲁</skos:altLabel>
        <skos:definition>A language spoken in the Minangkabau region of Indonesia, characterized by its unique matrilineal culture and use of a modified Arabic script.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJrxrj7NP4TJBZS8rgy610 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJrxrj7NP4TJBZS8rgy610">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R16E44cA98bb827F808ADdfd"/>
        <rdfs:label>D.C. Board on Professional Responsibility</rdfs:label>
        <skos:definition>The D.C. Board on Professional Responsibility is a disciplinary body within the District of Columbia Courts that oversees the conduct of lawyers practicing in the District of Columbia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJssYq6dD0i6zlieP3cotj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJssYq6dD0i6zlieP3cotj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Crewmember Visa</rdfs:label>
        <skos:altLabel xml:lang="en-us">D-1 Visa</skos:altLabel>
        <skos:definition>A Crewmember Visa is a specific type of visa issued to individuals who work on board a sea vessel or international airline, such as pilots, flight attendants, or ship crew members. This visa allows the holder to enter and stay in a foreign country for a limited period, strictly for the purpose of joining, working on, or disembarking from their vessel or aircraft.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJvfvUzCUfCqBqkpPjclIi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJvfvUzCUfCqBqkpPjclIi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDMSaAtom7aKKKg3DZgOG0U"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Failure to Yield to Pedestrian Claim</rdfs:label>
        <skos:altLabel>Pedestrian Crossing Offence Claim</skos:altLabel>
        <skos:altLabel>Pedestrian Priority Violation Claim</skos:altLabel>
        <skos:definition>A Pedestrian Right-of-Way Violation Claim involves allegations that a driver has failed to yield the right-of-way to pedestrians under circumstances where pedestrians are legally prioritized, such as crosswalks or signals.</skos:definition>
        <skos:prefLabel>Pedestrian Right-of-Way Violation Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJwYAhLKCUFLjsFuACCRPB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJwYAhLKCUFLjsFuACCRPB">
