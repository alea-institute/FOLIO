        <skos:altLabel xml:lang="en-gb">Merchant Wholesalers, Nondurable Goods Industry</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית סיטונאי סחורות לא צמיגות</skos:altLabel>
