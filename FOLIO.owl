            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ambassador</rdfs:label>
        <skos:definition>An ambassador is a diplomatic representative who serves as the highest-ranking official of their home country&apos;s government in a foreign nation. The ambassador is responsible for managing diplomatic relations, representing their country&apos;s interests, and overseeing the activities of their nation&apos;s embassy or consulate in the host country.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBPehVKHmGilQbPA55VggB6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBPehVKHmGilQbPA55VggB6">
