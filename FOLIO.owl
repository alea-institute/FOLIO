        <rdfs:label>New Car Dealers</rdfs:label>
        <skos:definition>See industry description for 441110.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/wLAgU8Z_RtusJm-rni0-MA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/wLAgU8Z_RtusJm-rni0-MA">
