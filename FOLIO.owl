        <skos:altLabel xml:lang="fr-fr">chuuk</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">chuukês</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">チューク語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">楚克语</skos:altLabel>
        <skos:definition>Chuukese (Language) is a structured system of communication that consists of grammar and vocabulary specific to the Chuukese people and culture.</skos:definition>
    </owl:Class>
    


