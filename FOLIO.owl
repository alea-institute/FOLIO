        <skos:definition>Religious Law is a system of law based on religious texts and traditions, governing the conduct of adherents of a particular faith or belief.</skos:definition>
        <skos:prefLabel>Ecclesiastical Law</skos:prefLabel>
    </owl:Class>
    


