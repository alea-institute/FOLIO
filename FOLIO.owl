        <skos:altLabel xml:lang="es-es">Litigante Vexatorio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Litigante de má-fé</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Plaignant vexatoire</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Querulant</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Vexatious Litigant</skos:altLabel>
