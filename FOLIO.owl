        <skos:altLabel xml:lang="de-de">Klausel zur Nichtbestehen einer Agenturbeziehung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No Agency Relationship Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף ללא יחסי סוכנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कोई एजेंसी संबंध शर्त नहीं</skos:altLabel>
