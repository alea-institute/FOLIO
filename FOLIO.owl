        <skos:altLabel xml:lang="es-mx">Cláusula de Mediación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de mediação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mediation Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schiedsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף גישור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मध्यस्थता शर्त</skos:altLabel>
