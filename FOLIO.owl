        <rdfs:label>Assignment of Claims Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abtretungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Assignment of Claims Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de cession de créances</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cesión de créditos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de cesión de derechos de crédito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de cessão de créditos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף העברת טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावों की असाइनमेंट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">债权转让条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債権譲渡条項</skos:altLabel>
        <skos:definition>An Assignment of Claims Clause is a provision in a contract that allows one party to transfer their right to receive payment from another party to a third party.</skos:definition>
    </owl:Class>
    


