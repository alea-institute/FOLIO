        <rdfs:label>Financial System Risk</rdfs:label>
        <skos:definition>The risk that the failure of a financial institution or a group of institutions can cause a systemic crisis.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBcuoqBaLiPaGEYNL1fcaP9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBcuoqBaLiPaGEYNL1fcaP9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBBfInsYEtsGJvAm3qnQm6l"/>
        <rdfs:label>Raspberries</rdfs:label>
        <skos:altLabel>Rubus Fruit</skos:altLabel>
        <skos:definition>Raspberries are aggregate fruits from the Rubus genus, characterized by their juicy drupelets and sweet-tart flavor. Widely grown in temperate regions, raspberries are consumed fresh, frozen, or processed into various products such as jams, jellies, and desserts, valued for their high vitamin C and fiber content.</skos:definition>
    </owl:Class>
    


