                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8N5U2j0fGGKFU8RsaFVQKQ"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tax_tier_total_tax</rdfs:label>
        <skos:definition>&quot;The sum of all TAX_TIERS.tax_tier_amount for this tx_id expressed in INVOICE.inv_currency.  
&quot;</skos:definition>
    </owl:Class>
    


