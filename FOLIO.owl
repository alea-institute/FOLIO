        <skos:altLabel xml:lang="es-es">Cláusula de zona de amortiguamiento del paisaje</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de zona de amortiguamiento del paisaje</skos:altLabel>
