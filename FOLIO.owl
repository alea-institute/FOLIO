        <skos:altLabel xml:lang="de-de">Fehlerhafte Behandlung von Zahlungsinstrumenten durch die Inkassobank</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mala gestión del banco colector de instrumentos negociables</skos:altLabel>
