        <rdfs:label>Kansas District Court - Marion County</rdfs:label>
        <skos:definition>Kansas District Court - Marion County: A specific court within the Kansas District Court system located in Marion County, responsible for administering legal proceedings within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM15eODsrNXiaOu4wliU3w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM15eODsrNXiaOu4wliU3w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7N6wsHsNyqgPE4xFK8wKJx"/>
        <rdfs:label>Native Village of Kongiganak</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM35ursk6terURihawIPFX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM35ursk6terURihawIPFX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MK1XmyjtYxZKg8Iw4ZN4K"/>
        <rdfs:label>Mass Torts Law</rdfs:label>
        <skos:altLabel>Collective Redress Law</skos:altLabel>
        <skos:altLabel>Complex Torts Law</skos:altLabel>
        <skos:altLabel>Group Torts Law</skos:altLabel>
        <skos:definition>Mass torts law is an area of law that deals with legal actions involving numerous plaintiffs against one or a few defendants, where the plaintiffs allege harm caused by common actions or products. These cases often involve complex negotiations and litigation due to the large number of claimants, extensive evidence, and significant legal and financial stakes.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM46E1YF0hTNl4lsMh0aC1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM46E1YF0hTNl4lsMh0aC1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI"/>
        <rdfs:label>Texas District Court - Guadalupe County</rdfs:label>
        <skos:definition>A court located in Guadalupe County, Texas that has jurisdiction over certain legal matters within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM5NNS6Pt6sOGNkkMEK8Wm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM5NNS6Pt6sOGNkkMEK8Wm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmCERXtzdqIJcW9mdbk0Bb"/>
        <rdfs:label>Annual Information Form</rdfs:label>
        <skos:altLabel>Annual Financial Disclosure</skos:altLabel>
        <skos:definition>The Annual Information Form, also known as Form 10-K in the U.S., is an extensive disclosure document filed annually that includes a detailed account of a company&apos;s financial performance and operations. It is required by securities regulators and is intended for shareholders and potential investors.</skos:definition>
        <skos:prefLabel>10-K</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM6KeGyv1uH0zuGDufnxkw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM6KeGyv1uH0zuGDufnxkw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
        <rdfs:label>Caselaw and Common Law</rdfs:label>
        <skos:altLabel>Jurisprudence</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Jurisprudence et Common Law</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Jurisprudência e Common Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtsprechung und Common Law</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">判例法とコモン・ロー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">判例法和普通法</skos:altLabel>
        <skos:definition>The law as established by the outcome of previously decided court cases (e.g., judicial opinions).</skos:definition>
        <skos:prefLabel>Caselaw</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM6VrtfziMgMan8tAl6Ezq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM6VrtfziMgMan8tAl6Ezq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Uniformity Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Gleichheitsgrundsatz-Anspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Cláusula de Uniformidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Cláusula de Uniformidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de uniformidade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de clause d&apos;uniformité</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Uniformity Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף האחידות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एकरूपता धारा दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">均等条項主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">统一性条款要求</skos:altLabel>
        <skos:definition>A Uniformity Clause claim refers to a legal argument challenging the constitutionality of a tax or revenue-related law based on the requirements outlined in the Uniformity Clause of a particular jurisdiction&apos;s constitution. This claim asserts that the law violates the Uniformity Clause by imposing taxes or burdens in a manner that is not uniform or equal across the affected individuals or entities, potentially rendering it invalid or unconstitutional. The Uniformity Clause typically aims to ensure fairness and equality in taxation or revenue measures.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM83MuWEVQF14MZqJHo9jP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM83MuWEVQF14MZqJHo9jP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBCzyIAi2Hjl80hfQr8wAMR"/>
        <rdfs:label>Death Certificate</rdfs:label>
        <skos:definition>A Death Certificate is an official document issued by a government authority that records the details of a person&apos;s death. It typically includes information such as the deceased individual&apos;s name, date and place of death, cause of death, and the attending physician&apos;s or coroner&apos;s signature. Death certificates are important for legal and administrative purposes, including the settlement of the deceased person&apos;s estate and handling matters related to inheritance, insurance, and funeral arrangements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM8MNiSWdzUOtPxknfkXpI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM8MNiSWdzUOtPxknfkXpI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1A5cd40F21ccBABafb0C2e8"/>
        <rdfs:label>New Jersey Superior Court - Somerset County</rdfs:label>
        <skos:definition>The New Jersey Superior Court - Somerset County is a court of general jurisdiction within the New Jersey state court system, located in Somerset County and serving the surrounding area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM8uFdNbkVDabwW32Bv8E -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM8uFdNbkVDabwW32Bv8E">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
        <rdfs:label>Religious Law System</rdfs:label>
        <skos:altLabel>Divine Law</skos:altLabel>
        <skos:altLabel>Sacred Law</skos:altLabel>
        <skos:altLabel>Theocratic Legal System</skos:altLabel>
        <skos:definition>A Religious Law System is a legal framework grounded in religious beliefs, texts, and traditions, governing both the moral and legal aspects of the lives of its adherents. These systems derive their authority from sacred scriptures and religious institutions, and often encompass both private conduct and public law.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM9xLNaRTTvo1CwFn80Y6T -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RM9xLNaRTTvo1CwFn80Y6T">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RMIoMi1OqwHKqsjgrjdaHj"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RfJigJT2rTvBzyMa18Nh9F"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Legal Aid Organization</rdfs:label>
        <skos:definition>A Legal Aid Organization is a non-profit entity that provides free or low-cost legal assistance to individuals who cannot afford private legal representation. These organizations typically serve low-income clients, offering services on matters such as family law, housing, and employment issues.</skos:definition>
        <skos:example>Global Alliance for Legal Aid (GALA)</skos:example>
        <skos:example>International Legal Aid Group (ILAG)</skos:example>
        <skos:example>International Legal Foundation (ILF)</skos:example>
        <skos:example>Legal Action Worldwide (LAW)</skos:example>
        <skos:example>Legal Aid Agency (UK)</skos:example>
        <skos:example>Legal Services Corporation</skos:example>
        <skos:example>National Legal Aid &amp; Defender Association (NLADA)</skos:example>
        <skos:prefLabel>Legal Assistance Entity</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMAQl6YOUChd9mXqKxyo2Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMAQl6YOUChd9mXqKxyo2Z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Intellectual Property Indemnification Clause</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cláusula de indemnización de propiedad intelectual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de indemnización de propiedad intelectual</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intellectual Property Indemnification Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פיצוי קניין רוחני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बौद्धिक संपदा भरण-पोषण शर्त</skos:altLabel>
        <skos:definition>A provision in a contract that requires one party to compensate the other for any legal costs or damages resulting from a claim of intellectual property infringement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMCOdQKgX53SQsK4bTUaFY -->

