        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5u9wTR86QD4UfWi91OTra"/>
        <rdfs:label>Forum Selection Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Action en clause de juridiction</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forum Selection Clause Claim</skos:altLabel>
