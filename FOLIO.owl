        <skos:altLabel xml:lang="es-es">Cláusula de idioma del acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de idioma del acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Idioma da cláusula de acordo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Language of Agreement Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langue de la clause d&apos;accord</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sprache der Vereinbarungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף שפת ההסכם</skos:altLabel>
