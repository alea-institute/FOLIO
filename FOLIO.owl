        <rdfs:label>Horses and Other Equine Production</rdfs:label>
        <skos:definition>See industry description for 112920.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/sfQKH-cmS_SSWOm024hzcg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/sfQKH-cmS_SSWOm024hzcg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/vYl5tm7YTduEPX3h-92rmQ"/>
