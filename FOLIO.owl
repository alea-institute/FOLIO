        <rdfs:label>Books Printing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in printing or printing and binding books and pamphlets without publishing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/95A7L62KRT2UoxjWyuPHAg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/95A7L62KRT2UoxjWyuPHAg">
