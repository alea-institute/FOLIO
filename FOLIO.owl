        <skos:altLabel xml:lang="es-mx">Informe Amicus</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mémoire d&apos;amicus curiae</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Parecer de Amicus Curiae</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תגובת עמיתים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अमिकस ब्रीफ</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アミクス・キュリエ意見書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">友情陈述书</skos:altLabel>
        <skos:definition>An amicus brief is a written legal argument submitted to a court by a non-party who has a strong interest in the outcome of a case, typically to provide additional information or perspective on the legal issues at hand.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBckmqcc5Fc5xTyszOgC7Te -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBckmqcc5Fc5xTyszOgC7Te">
