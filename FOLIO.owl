        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rub2xErcJ0t8GToQfoaVG1"/>
        <rdfs:label>Leguminous Vegetables</rdfs:label>
        <skos:definition>Leguminous vegetables, also known as legumes or pulses, are a category of vegetables from the legume family (Fabaceae), known for their pod-bearing growth habit and nutrient-rich seeds. They are consumed as a protein source in diets worldwide and are valued for their high protein, fiber, vitamin, and mineral content, as well as their role in improving soil fertility through nitrogen fixation.</skos:definition>
        <skos:prefLabel>Legumes</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8sIipxJfqJ8ILg1TS3HBY9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8sIipxJfqJ8ILg1TS3HBY9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9p98NogvwJk1MnJgYzuiZd"/>
        <rdfs:label>Grass Roots Organization and Management</rdfs:label>
        <skos:altLabel>Community Organization Advisory</skos:altLabel>
        <skos:altLabel>Community-Based Organization Management</skos:altLabel>
        <skos:altLabel>Grassroots Campaign Management</skos:altLabel>
        <skos:altLabel>Volunteer Organization Support</skos:altLabel>
        <skos:definition>Grass Roots Organization and Management involves providing legal advice and support for the creation, development, and governance of community-based, often volunteer-driven, organizations. This practice includes structuring the organization, ensuring regulatory compliance, and facilitating effective grassroots campaigns and advocacy efforts.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8sLSP3fcYlpo2TNHbyFkQ8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8sLSP3fcYlpo2TNHbyFkQ8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5mVKmojg3FKSzxupI6FLy"/>
        <rdfs:label>Secondary Offering Practice</rdfs:label>
        <skos:altLabel>Secondary Offering</skos:altLabel>
        <skos:altLabel>Secondary Offering Service</skos:altLabel>
        <skos:altLabel>Seasoned Equity Offering Practice</skos:altLabel>
        <skos:definition>Secondary Offering Practice involves the sale of shares by existing shareholders, typically through a public offering, after the company&apos;s initial public offering (IPO). It includes the legal and regulatory processes to ensure compliance with securities laws and protect investors&apos; interests.</skos:definition>
        <skos:prefLabel>Follow-On Offering Practice</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8sMcpQMoO3EOWAx73lpZ16 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8sMcpQMoO3EOWAx73lpZ16">
