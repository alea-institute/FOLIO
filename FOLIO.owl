                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9eNwwldCTuAoPYr6fyaEtW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>total_tax_on_expense</rdfs:label>
        <skos:definition>&quot;Total of tax due on tax_total_detail_expense for this tx_id, including amounts applicable on MATTER_DISC_CRED where disc_cred_category = &quot;&quot;Exp&quot;&quot;.

If TAX.increase_decrease = Decrease for this TAX.tx_id, this will be a negative number.

If tx_id is a Tiered Tax, the value in this field should be 0.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDQak5HGE3kdzKHvzDmgnQw -->

