        <rdfs:label>Responses to Requests for Production</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antworten auf Anträge auf Produktion</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Responses to Requests for Production</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Respostas a Pedidos de Produção</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Respuestas a solicitudes de producción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Respuestas a solicitudes de producción</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réponses aux demandes de production</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תגובות לבקשות לייצור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्पादन के लिए अनुरोधों का जवाब</skos:altLabel>
