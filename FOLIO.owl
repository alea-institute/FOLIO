        <skos:altLabel xml:lang="pt-br">Incomodo público</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Molestia Pública</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Nuisancia Pública</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Public Nuisance</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Trouble de voisinage</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Öffentliche Belästigung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הטרדה ציבורית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक उत्पीड़न</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共の迷惑行為</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公共妨碍</skos:altLabel>
        <skos:definition>A public nuisance is a type of nuisance that affects the community or the public at large, rather than just one individual or property owner.</skos:definition>
    </owl:Class>
    


