        <skos:altLabel xml:lang="pt-br">Cláusula de Interpretação de Contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de interpretación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de interpretación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Auslegung von Verträgen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Rule of Construction Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כללי לפרשנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्माण नियम शब्दावली</skos:altLabel>
