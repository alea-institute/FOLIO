    <!-- https://folio.openlegalstandard.org/RC0mco4vTHaJiBJtqbaq90J -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0mco4vTHaJiBJtqbaq90J">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
        <rdfs:label>Human-Centric AI</rdfs:label>
        <skos:altLabel>Human-Oriented AI</skos:altLabel>
        <skos:altLabel>People-Centric AI</skos:altLabel>
        <skos:altLabel>User-Centric AI</skos:altLabel>
        <skos:definition>Human-Centric AI, also known as human-centered AI, is an approach to designing, deploying, and using AI systems that considers them as integral components of socio-technical environments where humans maintain meaningful agency. This approach prioritizes enhancing human capabilities rather than replacing them and is promoted in policy, research, and engineering to develop AI systems that serve human beings and increase human and environmental well-being by upholding human rights, the rule of law, democratic values, and sustainable development.</skos:definition>
        <skos:prefLabel>Human-Centered AI</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC0o3VfL4MzDOSi8iTe8Wti -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0o3VfL4MzDOSi8iTe8Wti">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEWWtS3nM8GE8R4en1abRz"/>
        <rdfs:label>Arkansas Circuit Court - Calhoun Cty.</rdfs:label>
        <skos:definition>The Arkansas Circuit Court - Calhoun County is a specific court within the Arkansas Circuit Court system that has jurisdiction over legal matters within Calhoun County, Arkansas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RC0pOXr7Np5vCRZ00mrLema -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RC0pOXr7Np5vCRZ00mrLema">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9eX3Auj16MgFGGYWRmhns8"/>
        <rdfs:label>Quadriplegia</rdfs:label>
        <skos:altLabel>Tetraplegia</skos:altLabel>
        <skos:altLabel>Total Body Paralysis</skos:altLabel>
        <skos:definition>Quadriplegia, also known as tetraplegia, is a type of mobility disability characterized by the partial or complete paralysis of all four limbs and the torso. This condition typically results from a spinal cord injury or disease affecting the cervical region of the spine, leading to a loss of motor and sensory function below the level of injury.</skos:definition>
        <skos:prefLabel>Quadriplegic Condition</skos:prefLabel>
    </owl:Class>
    


