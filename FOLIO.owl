        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAoFbSK8WP6xJyVrgQd5PZ"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:label>Illegality Doctrine</rdfs:label>
        <skos:altLabel xml:lang="es-es">Doctrina de la Ilegalidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Doctrina de la Ilegalidad</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Doctrine d&apos;illégalité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Doutrina da Ilegalidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Illegality Doctrine</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Illegitimitätsdoktrin</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תורת הלא-חוקיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवैधता डॉक्ट्रिन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">違法主義原則</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非法原则</skos:altLabel>
        <skos:definition>The Illegality Doctrine is a legal defense used in civil litigation that argues that a plaintiff should not be able to recover damages if their claim is based on an illegal act or transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RgosX7Fov7brVHrrsHP3ao -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgosX7Fov7brVHrrsHP3ao">
