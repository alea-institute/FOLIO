        <skos:altLabel xml:lang="es-mx">Discriminación por sexo y género</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Discrimination sexuelle et de genre</skos:altLabel>
        <skos:altLabel xml:lang="he-il">Discrimination על סמך מגדר ומין</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Discriminação de gênero e sexo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Diskriminierung aufgrund von Geschlecht und Geschlechtsidentität</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sex and Gender Discrimination</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लिंग और जेंडर भेदभाव</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">性別差別</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">性别歧视</skos:altLabel>
        <skos:definition>Sex and Gender Discrimination refers to the unfair treatment of individuals based on their sex or gender, particularly in the workplace, which can include differences in pay, promotion opportunities, and job responsibilities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8BLgPtZOuKFI8MtZNTaT0u -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8BLgPtZOuKFI8MtZNTaT0u">
