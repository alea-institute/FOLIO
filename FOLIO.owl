        <skos:altLabel xml:lang="pt-br">Reivindicação do Artigo 3</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף 3</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुच्छेद 3 दावा</skos:altLabel>
