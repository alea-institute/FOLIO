        <skos:definition>A Protection &amp; Advocacy (P&amp;A) Attorney is a type of lawyer who specializes in representing individuals with disabilities in legal matters related to their rights and access to services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RS489lsfpR7SJTB0tH66wpQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RS489lsfpR7SJTB0tH66wpQ">
