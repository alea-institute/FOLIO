            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prison Law</rdfs:label>
        <skos:altLabel>Correctional Administration Law</skos:altLabel>
        <skos:altLabel>Correctional Law</skos:altLabel>
        <skos:definition>Prison Law refers to the body of laws and regulations that govern the rights and responsibilities of prisoners, including their treatment and conditions of incarceration. It also encompasses the rules and policies that regulate the management and organization of prison facilities.</skos:definition>
        <skos:note>Added per Cambridge UK professor Felix Steffek, noting that UK law includes Prison Law.</skos:note>
        <skos:prefLabel>Penal Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81ea6Rg9Cd8vEEma9Eqp9t -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81ea6Rg9Cd8vEEma9Eqp9t">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
        <rdfs:label>Terrorism</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Terrorism</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Terrorisme</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Terrorismo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Terrorismo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Terrorismo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Terrorismus</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טרוריזם</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आतंकवाद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">テロリズム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">恐怖主义</skos:altLabel>
        <skos:definition>The concept of Terrorism refers to the use of violence and intimidation in pursuit of political aims, often targeting civilians and carried out by individuals or groups against a government or society.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81gIxZEycEyh9ymjYjs9qK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81gIxZEycEyh9ymjYjs9qK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r"/>
        <rdfs:label>Exchange Debt for Equity</rdfs:label>
        <skos:altLabel>Debt Conversion</skos:altLabel>
        <skos:altLabel>Debt-to-Equity Swap</skos:altLabel>
        <skos:altLabel>Equity Conversion</skos:altLabel>
        <skos:altLabel>Equity-to-Debt Swap</skos:altLabel>
        <skos:definition>An asset exchange where a party replaces debt with equity — or equity with debt — in a company. Replacing debt with equity often occurs during restructuring to improve financial stability. Replacing equity with debt can help raise capital while avoiding dilution of ownership.</skos:definition>
        <skos:prefLabel>Exchange Equity for Debt</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81j4VBZk0ZJyM8Z4bfKDJG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81j4VBZk0ZJyM8Z4bfKDJG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Work Order Clause</rdfs:label>
        <skos:altLabel xml:lang="de-de">Arbeitsauftragsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;ordre de travail</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Orden de Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Orden de Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de ordem de trabalho</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Work Order Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הזמנת עבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार्य आदेश शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">作業命令条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工作订单条款</skos:altLabel>
        <skos:definition>A Work Order Clause is a provision in a contract that outlines the specific tasks or services to be performed by one party for another, often including details such as timelines, deliverables, and compensation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81kMOLHVVbe2vyCOS8LTuR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81kMOLHVVbe2vyCOS8LTuR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9gqzNBOvSSiVGWHH7ZIXzM"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R97apJidWmx520LzKBIhkc1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Emancipation of a Minor (Remedy)</rdfs:label>
        <skos:definition>Emancipation of a minor refers to a legal process through which a minor becomes legally independent from their parents or guardians, thereby assuming most adult responsibilities. Once emancipated, the minor is no longer under the care or control of their parents or guardians, and they can make legal decisions on their own behalf.</skos:definition>
        <skos:prefLabel>Emancipation of a Minor</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81n0uoiTFQMwwdzAskqkZD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81n0uoiTFQMwwdzAskqkZD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
        <rdfs:label>Business Development Management</rdfs:label>
        <skos:definition>Business Development Management refers to the strategic planning and implementation of initiatives aimed at expanding and improving the business operations of a law firm or legal organization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81opfsWnlEQvW2jFPWFOxo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81opfsWnlEQvW2jFPWFOxo">
