    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGDeLOS6gclKMduTkkQmoa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RGDeLOS6gclKMduTkkQmoa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4kWkG9m4DarQ45A7wBpJQ"/>
        <rdfs:label>Genetic Evidence</rdfs:label>
        <skos:definition>Genetic evidence, commonly known as DNA evidence, refers to the unique genetic material found in cells, body fluids, or tissues. It is used in forensic science to identify or exclude individuals as sources of the material, providing a powerful tool for linking suspects to crime scenes or victims.</skos:definition>
        <skos:prefLabel>DNA Evidence</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGEgmKbY18qXXUvDzNAmv3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RGEgmKbY18qXXUvDzNAmv3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R82ikX2gSG3Kyc0OXqOpZve"/>
        <rdfs:label>&quot;Superior Offer, or Acquisition Proposal reasonably likely/expected to result in a Superior Offer&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Oferta superior ou proposta de aquisição razoavelmente provável de resultar em uma oferta superior</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oferta superior, o propuesta de adquisición razonablemente probable/esperada de resultar en una Oferta Superior</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oferta superior, o propuesta de adquisición razonablemente probable/esperada de resultar en una Oferta Superior</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Offre supérieure ou proposition d&apos;acquisition raisonnablement susceptible de donner lieu à une offre supérieure</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Superior Offer, or Acquisition Proposal reasonably likely/expected to result in a Superior Offer Language</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Überlegenes Angebot oder Akquisitionsangebot, bei dem vernünftigerweise zu erwarten ist, dass es zu einem überlegenen Angebot führt</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת רכישה עליונה, או הצעת רכישה הצפויה בהסתייגות עליונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्कृष्ट प्रस्ताव, या उत्कृष्ट प्रस्ताव के नतीजे में अनुमानित रूप से होने वाले अधिग्रहण प्रस्ताव भाषा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">“优越报价”或“合理预计将导致优越报价的收购提议”语言</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">「優れた提案、または妥当な理由があって優れた提案が期待される買収提案」の言語</skos:altLabel>
        <skos:definition>A &quot;Superior Offer, or Acquisition Proposal reasonably likely/expected to result in a Superior Offer&quot; is a proposal made during a legal matter that is expected to be better than any other offers made, and triggers an exception to a previously agreed upon no-shop covenant.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGEouAo51bku9BbBZNLYV5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RGEouAo51bku9BbBZNLYV5">
