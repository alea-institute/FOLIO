        <rdfs:label>Sewage Treatment Facilities</rdfs:label>
        <skos:definition>See industry description for 221320.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/IQEK2e2PQXCmXOShpQTpMA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/IQEK2e2PQXCmXOShpQTpMA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/FU1iai9aRCiAxRE3W8mGEQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=483212"/>
        <rdfs:label>Inland Water Passenger Transportation</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in providing inland water transportation of passengers on lakes, rivers, or intracoastal waterways (except on the Great Lakes System).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/IUCBWEtsSCuAyPMl-pwsEQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/IUCBWEtsSCuAyPMl-pwsEQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/eVywMcrkRIWncIVCvfzJHw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=112320"/>
        <rdfs:label>Broilers and Other Meat Type Chicken Production</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in raising broilers, fryers, roasters, and other meat type chickens.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/IfIBynZOQjOE7yggakYfCQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/IfIBynZOQjOE7yggakYfCQ">
