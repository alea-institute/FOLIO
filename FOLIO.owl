        <skos:altLabel xml:lang="pt-br">Gerenciamento de documentos e arquivos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Gestion de documents et de fichiers</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gestión de documentos y archivos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניהול מסמכים וקבצים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दस्तावेज़ और फ़ाइल प्रबंधन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">文書およびファイル管理</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">文档和文件管理</skos:altLabel>
        <skos:definition>Document and File Management refers to the process of organizing and maintaining legal documents and files related to a specific legal matter, including their creation, storage, retrieval, and disposal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8dfMuqMaYzPBgT6hKdBfbB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8dfMuqMaYzPBgT6hKdBfbB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ae7DEoQrCeEfzwnZbEK6X"/>
        <rdfs:label>Friendly Fact Witness Interview</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Entretien amical avec un témoin de faits</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Entrevista amigável com testemunha de fatos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Entrevista amistosa con testigo de hechos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Entrevista amistosa con testigo de hechos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Freundliches Faktenerhebungsgespräch mit Zeugen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Friendly Fact Witness Interview</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ראיית עד ידידותית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मित्रवत सत्य गवाह साक्षात्कार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">友好的事实证人采访</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">友好的事実証人面接</skos:altLabel>
        <skos:definition>A &quot;Friendly Fact Witness Interview&quot; is a type of interview conducted with a witness who is not hostile or adverse to the party conducting the interview, and is intended to gather information about the facts of a case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8dffWHpqOZGlpzu5LERjar -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8dffWHpqOZGlpzu5LERjar">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
        <rdfs:label>Interest Rate Risk</rdfs:label>
        <skos:definition>The risk that an investment&apos;s value will change due to a change in the absolute level of interest rates.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8dg62MjLTQnUX9VOs20LYJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8dg62MjLTQnUX9VOs20LYJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UZkDXz7Wg2AtyHFQEeySC"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
        <rdfs:label>Freedom of the Press</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Freedom of the Press Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Pressefreiheitsanspruch</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de Libertad de Prensa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de Libertad de Prensa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da liberdade de imprensa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la liberté de la presse</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת חופש העיתונות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रेस की स्वतंत्रता का दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">報道の自由主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">新闻自由要求</skos:altLabel>
        <skos:definition>A freedom of the press claim is a legal action initiated by a journalist, news organization, or other entity alleging that their right to freedom of the press, as protected by the First Amendment of the United States Constitution, has been violated by the government or a government actor. A freedom-of-the-press claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts press freedom, when a journalist is punished or threatened for their reporting, or when access to public information or events is improperly denied.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8dibofd2NKjj7T26WNnqZA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8dibofd2NKjj7T26WNnqZA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R93T7OEmCjkwufvhJAY4ScV"/>
        <rdfs:label>Easement by Implication</rdfs:label>
        <skos:altLabel xml:lang="de-de">Duldungsweg</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Easement by Implication</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Servidumbre por implicación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Servidumbre por implicación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Servidão por Implicação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Servitude par implication</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות שימוש משולבת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संवेदनशीलता द्वारा आसानी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">暗示的地役権</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">默示地役权</skos:altLabel>
        <skos:definition>An easement by implication is a type of easement that arises when the circumstances surrounding the creation of a property suggest that the parties intended for an easement to exist, even though it was not explicitly granted or reserved in the deed or other legal document.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8dkzjtpVOUmi34qEb1r5Ds -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8dkzjtpVOUmi34qEb1r5Ds">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Mon-Khmer languages</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Langues môn-khmer</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas môn-khmer</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mon-Khmer-Sprachen</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">モン・クメール語族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">孟高棉语族</skos:altLabel>
        <skos:definition>Mon-Khmer languages are a group of languages spoken in Southeast Asia, including Cambodian and Vietnamese.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8dnDzxaVRIaYEySNQmiCCe -->

