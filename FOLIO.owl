        <rdfs:label>Tech Market Segment</rdfs:label>
        <skos:altLabel>Technology Sector</skos:altLabel>
        <skos:definition>Tech Segment refers to businesses that apply scientific knowledge and technological advancements to various industries, resulting in innovative products, services, and solutions. This tag is used in conjunction with other Industries to encompasses a wide range of sectors. For example Tech + Financial Industry = FinTech (financial technology). Tech + Biology = BioTech (biotechnology). Tech + Law = LegalTech (legal technology). Adding Tech tech indicates that the company is focused on leveraging technology to enhance their respective industries.</skos:definition>
        <skos:example>BioTech</skos:example>
        <skos:example>FinTech</skos:example>
        <skos:example>LegalTech</skos:example>
        <skos:prefLabel>Tech Sector</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDxhyGlyiWv7cf1zjWtVmIE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDxhyGlyiWv7cf1zjWtVmIE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RaQIRktfYrGWDS7HAq0N6f"/>
        <rdfs:label>Political Donation</rdfs:label>
        <skos:altLabel>Campaign Contribution</skos:altLabel>
        <skos:altLabel>Electoral Donation</skos:altLabel>
        <skos:altLabel>Political Contribution</skos:altLabel>
        <skos:altLabel>Political Financial Support</skos:altLabel>
        <skos:definition>A Political Donation is a financial contribution made to a political candidate, party, or campaign to support their electoral efforts or policy initiatives. This type of donation is subject to specific legal regulations and reporting requirements, and is intended to provide financial support for political activities without the expectation of direct personal favors or benefits.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDxjS115CmY9LiXGgtsx0CU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDxjS115CmY9LiXGgtsx0CU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJgy4NDLgsP7qaqied5k5c"/>
        <rdfs:label>Video Game</rdfs:label>
        <skos:altLabel>Computer Game</skos:altLabel>
        <skos:altLabel>Digital Game</skos:altLabel>
        <skos:altLabel>Electronic Game</skos:altLabel>
        <skos:altLabel>Interactive Game</skos:altLabel>
        <skos:definition>A Video Game is an electronic game that involves interaction with a user interface or input device to generate visual feedback on a two- or three-dimensional video display. Protected under copyright law, video games grant the developers exclusive rights to reproduce, distribute, and display the game.</skos:definition>
    </owl:Class>
    


