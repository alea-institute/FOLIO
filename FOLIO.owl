        <skos:altLabel xml:lang="de-de">Mandschu</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">manchu</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">mandchou</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">満州語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">满族语</skos:altLabel>
        <skos:definition>Manchu is a written or spoken structured system of communication that consists of grammar and vocabulary, and is a member of the Language top-level class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCebyurX2mFkPJG9ftrSBMy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCebyurX2mFkPJG9ftrSBMy">
