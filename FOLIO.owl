    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R3Q94wfBzs41rD9XxEgl6m -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R3Q94wfBzs41rD9XxEgl6m">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED Wage Statement Violation Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Verletzung der Lohnabrechnung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por violación de la declaración de salarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por violación de la declaración de salarios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de violação de extrato de salário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de violation de relevé de salaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wage Statement Violation Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת הצהרת שכר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वेतन विवरण उल्लंघन दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工资报表违规索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">賃金明細書違反請求</skos:altLabel>
        <skos:definition>A wage statement violation claim is a legal action initiated by an employee against their employer for not complying with the legal requirement to provide accurate and complete wage statements or pay stubs. These statements typically include information about the employee&apos;s hours worked, wages earned, deductions taken, and other important employment-related information. The claim typically arises when an employer provides wage statements that do not accurately reflect the employee&apos;s earnings or deductions, or do not contain all the information required by law. Employers can face liability for failing to provide accurate and complete wage statements, which can result in financial harm to the employee.</skos:definition>
        <skos:definition>DEPRECATED as duplicative of `Failure to Provide Wage Records Claim`</skos:definition>
    </owl:Class>
    


