        <skos:altLabel xml:lang="ja-jp">医療過誤の弁護</skos:altLabel>
        <skos:definition>Medical Malpractice Defenses are legal arguments or strategies used by defendants in a medical malpractice case to defend against the plaintiff&apos;s claims of negligence or wrongdoing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCuv1eyebu3W695hYQutNMO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCuv1eyebu3W695hYQutNMO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Akan</rdfs:label>
        <skos:altLabel xml:lang="de-de">Akan</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Akan</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Akan</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アカン語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">阿坎语</skos:altLabel>
        <skos:definition>Akan is a structured system of communication consisting of grammar and vocabulary, primarily spoken in Ghana and Ivory Coast.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCv1mXvS4wBS00uefnLb5hm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCv1mXvS4wBS00uefnLb5hm">
