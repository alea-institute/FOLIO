    <!-- https://folio.openlegalstandard.org/RBjHlhJCrfswuGxGyjLZibB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBjHlhJCrfswuGxGyjLZibB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Borderline Personality Disorder</rdfs:label>
        <skos:altLabel>BPD</skos:altLabel>
        <skos:altLabel>Borderline Disorder</skos:altLabel>
        <skos:altLabel>EUPD</skos:altLabel>
        <skos:altLabel>Emotional Dysregulation Disorder</skos:altLabel>
        <skos:altLabel>Emotionally Unstable Personality Disorder</skos:altLabel>
        <skos:altLabel>Unstable Personality Disorder</skos:altLabel>
        <skos:definition>Borderline Personality Disorder (BPD) is a mental health condition characterized by pervasive instability in moods, behavior, self-image, and functioning. Individuals with BPD often experience intense episodes of anger, depression, and anxiety that can last from a few hours to days, leading to impulsive actions and unstable relationships.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBjHwNNG2ASVmasLFU42otk">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Forums and Venues</rdfs:label>
        <skos:altLabel xml:lang="de-de">Foren und Veranstaltungsorte</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Foros y lugares</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Foros y lugares</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forums and Venues</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Forums et lieux</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fóruns e locais</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פורומים ומקומות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फोरम और स्थान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">フォーラムと会場</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">论坛和场馆</skos:altLabel>
        <skos:definition>Forums and Venues refer to organizational or governmental entities where proceedings occur, either as disputes or as transactions. For disputes, the term &quot;Forum&quot; describes the jurisdiction or court type, while &quot;Venue&quot; refers to the actual location, such as the courthouse, jurisdiction, or judicial district. For equities and securities, this category also includes Stock Exchanges.</skos:definition>
    </owl:Class>
    


