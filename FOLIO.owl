        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:label>Employer&apos;s Breach of Implied Covenant of Good Faith and Fair Dealing</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Employer&apos;s Breach of Implied Covenant of Good Faith and Fair Dealing</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento del empleador del convenio implícito de buena fe y trato justo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento del empleador del convenio implícito de buena fe y trato justo</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Pflicht des Arbeitgebers zur Treue und Rücksichtnahme</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de l&apos;obligation implicite de bonne foi et de loyauté de l&apos;employeur</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação do dever implícito de boa-fé e lealdade do empregador</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת מען האמון המשתלם והטיפול הוגן של המעסיק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नियोक्ता की विश्वसनीय निवेदन का उल्लंघन और निष्पक्षता और उचित व्यवहार का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">雇主违反善意和公平交易的默示契约</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">雇用者の善意と公正な取引の暗黙の契約違反</skos:altLabel>
        <skos:definition>The Employer&apos;s Breach of Implied Covenant of Good Faith and Fair Dealing refers to a legal claim made by an employee against their employer for violating the implied promise of good faith and fair dealing in the employment relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHqSGY9j6DiileorokNvl5 -->

