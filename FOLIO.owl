        <skos:altLabel xml:lang="zh-cn">德拉维达语系</skos:altLabel>
        <skos:definition>A group of languages spoken in southern India and parts of Sri Lanka, characterized by a distinct grammatical structure and vocabulary, and including Tamil, Telugu, Kannada, and Malayalam.</skos:definition>
    </owl:Class>
    


