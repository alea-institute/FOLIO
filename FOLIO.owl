        <skos:altLabel xml:lang="ja-jp">既判力</skos:altLabel>
        <skos:definition>Res Judicata refers to the legal principle that a matter that has been adjudicated by a competent court and a final judgment has been rendered, cannot be litigated again between the same parties or their privies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Ov4MbOJULZY0aLe1KoP3Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Ov4MbOJULZY0aLe1KoP3Z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89ziIl0nXs5c4ONtS7qXTP"/>
        <rdfs:label>Personal Information</rdfs:label>
        <skos:altLabel>Private Information</skos:altLabel>
        <skos:definition>Personal Information refers to any data that relates to an identified or identifiable individual. This includes both sensitive personal information, which requires greater protection due to its potential to cause harm if disclosed, and personally identifiable information (PII), which can be used to identify, contact, or locate a specific individual.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Owlw8lExgVrP33uVeEYD1 -->

