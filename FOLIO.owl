        <skos:altLabel xml:lang="he-il">פרסיס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रेसिस</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プレシス</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">摘要</skos:altLabel>
        <skos:definition>A precis is a concise summary of a longer document or text, typically used in legal proceedings, and is a type of trial court practice document.</skos:definition>
    </owl:Class>
    


