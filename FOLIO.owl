        <rdfs:label>L650 Review (NOS)</rdfs:label>
        <skos:definition>&quot;NOS&quot; = Not Otherwise Specified (catch-all, includes the subcategories) Primarily charges on a hourly, per GB, per document or per page charges.</skos:definition>
        <skos:prefLabel>L650 Review (NOS)</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRZQDX3XRtxNOixKc8JZSG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRZQDX3XRtxNOixKc8JZSG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Candidate</rdfs:label>
        <skos:altLabel>Hopeful</skos:altLabel>
        <skos:definition>A Candidate is an individual who is seeking selection, nomination, or election for a specific position, office, or role. This person typically undergoes a formal process of evaluation, campaigning, or competition to be chosen for the desired position, whether in a political, professional, or organizational context.</skos:definition>
        <skos:prefLabel>Nominee</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRa8pbp0z1jaRfCG5da6lC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRa8pbp0z1jaRfCG5da6lC">
