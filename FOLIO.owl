        <skos:altLabel xml:lang="zh-cn">破产动议实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産動議の実務</skos:altLabel>
        <skos:definition>Bankruptcy Motion Practice refers to the legal procedures and strategies involved in filing and responding to motions in bankruptcy cases, including but not limited to motions for relief from automatic stay, objections to claims, and motions to dismiss.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDEMNnnV0XSIHMD7zFKEZzv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDEMNnnV0XSIHMD7zFKEZzv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7z8IPBHMwVOHP53OFYeSZN"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/6.00-Genitourinary-Adult.htm#6_04"/>
        <rdfs:label>Kidney Transplant</rdfs:label>
        <skos:altLabel>Kidney Graft</skos:altLabel>
        <skos:altLabel>Renal Transplant</skos:altLabel>
        <skos:definition>A kidney transplant is a surgical procedure in which a healthy kidney from a donor is implanted into a patient whose kidneys have failed or are severely impaired. This procedure aims to restore normal kidney function and improve the patient&apos;s quality of life, often replacing the need for dialysis.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDEPV9wd2UNQWyYVRDVkWj2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDEPV9wd2UNQWyYVRDVkWj2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDroRAFhNybTCHv1WlHGerL"/>
        <rdfs:label>Employment Oral Warning</rdfs:label>
        <skos:altLabel>Informal Warning</skos:altLabel>
        <skos:altLabel>Oral Warning</skos:altLabel>
        <skos:altLabel>Spoken Warning</skos:altLabel>
        <skos:altLabel>Verbal Reprimand</skos:altLabel>
        <skos:altLabel>Verbal Warning</skos:altLabel>
        <skos:definition>An Employment Verbal Warning is an informal reprimand issued by an employer to an employee for minor misconduct or performance issues. This warning serves as an initial step in the disciplinary process and is typically documented in the employee’s personnel file.</skos:definition>
        <skos:prefLabel>Employment Verbal Warning</skos:prefLabel>
    </owl:Class>
    


