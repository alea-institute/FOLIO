    <!-- https://folio.openlegalstandard.org/R787C07azf3BxNqxCxSvBxc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R787C07azf3BxNqxCxSvBxc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQGborh1CfXanGZipDL0Qo"/>
        <rdfs:label>County Governmental Body</rdfs:label>
        <skos:definition>A county governmental body oversees governance at the county level, which is typically a subdivision of a state or province, but above local city or town governments. County governments handle administrative and regulatory responsibilities that span multiple municipalities within their boundaries. These responsibilities can include law enforcement (through county sheriff&apos;s departments), maintaining county roads and infrastructure, overseeing public health and welfare programs, managing property records, and conducting elections.</skos:definition>
    </owl:Class>
    


