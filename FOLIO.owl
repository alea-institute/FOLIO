        <skos:altLabel xml:lang="zh-cn">故意不当行为</skos:altLabel>
        <skos:definition>Intentional and reckless behavior that goes beyond mere negligence, often resulting in harm or injury to another person or property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCuhulltRlDN8kiH5sooyW9 -->

