        <rdfs:label>Statement</rdfs:label>
        <skos:altLabel xml:lang="es-es">Declaración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Declaración</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Declaração</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déclaration</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Erklärung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Statement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצהרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बयान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">声明</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">声明</skos:altLabel>
        <skos:definition>A statement is a written or spoken declaration of facts or opinions, typically made under oath or affirmation, and used as evidence in a legal proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RGI4PhR8gNWSUrBwEMgBqH -->

