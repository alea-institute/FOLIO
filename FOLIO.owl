        <rdfs:label>Florida Circuit Court - Bay County - 14th Circuit Court</rdfs:label>
        <skos:definition>A court located in Bay County, Florida that is part of the larger Florida Circuit Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7dtuzkADCUpOA2gp5JN4mn -->

