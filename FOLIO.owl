    <!-- https://folio.openlegalstandard.org/R7fFIQpFBTrvkmKLbzK30pY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7fFIQpFBTrvkmKLbzK30pY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L7kPrkn8q0VbbyH4lv1VJ"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Voter Fraud Claim</rdfs:label>
        <skos:altLabel>Ballot Fraud Allegation</skos:altLabel>
        <skos:altLabel>Electoral Fraud Allegation</skos:altLabel>
        <skos:altLabel>Voting Fraud Accusation</skos:altLabel>
        <skos:definition>A Voter Fraud Claim refers to an allegation that illegal actions were taken to manipulate the outcome of an election, including activities such as voting more than once, casting ballots under false identities, tampering with vote counts, or falsifying voter registrations. These claims question the integrity of the voting process and require investigation to ensure electoral fairness.</skos:definition>
        <skos:prefLabel>Electoral Fraud Claim</skos:prefLabel>
    </owl:Class>
    


