        <skos:altLabel xml:lang="fr-fr">Copte</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Koptisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コプト語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">科普特语</skos:altLabel>
        <skos:definition>A language that was spoken in Egypt from the 2nd to the 17th century AD, characterized by its use of the Coptic alphabet derived from the Greek alphabet.</skos:definition>
    </owl:Class>
    


