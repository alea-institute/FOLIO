    <!-- https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
        <rdfs:label>Article 1 Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch gemäß Artikel 1</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Article 1 Claim</skos:altLabel>
        <skos:altLabel>Article I Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación del Artículo 1</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación del Artículo 1</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação do artigo 1</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de l&apos;article 1</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף 1</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुच्छेद 1 दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">第1条クレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">第1条要求</skos:altLabel>
        <skos:definition>An Article I claim refers to a legal argument based on the provisions of Article I of the U.S. Constitution, which outlines the powers, limits, and functions of the legislative branch. Such a claim might arise when there is a dispute over the exercise or limitation of these powers, including matters related to taxation, regulation of commerce, or the creation and enforcement of laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkwKnlvFjjIktxrGokIDMx -->

