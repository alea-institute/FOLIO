        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
        <rdfs:label>&quot;&apos;Reasonably likely/expected breach&apos; of fiduciary duties&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="en-gb">&apos;Reasonably likely/expected breach&apos; of fiduciary duties</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento razonablemente probable/esperado de los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento razonablemente probable/esperado de los deberes fiduciarios</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação &apos;razoavelmente provável/prevista&apos; de deveres fiduciários</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">« Violation raisonnablement probable/attendue » des devoirs fiduciaires</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובות פידוסיאריות &apos;בהסתמך על הסתייגות סבירה/צפויה&apos;</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विश्वसनीय दायित्वों के &apos;योग्यता के आधार पर संभवतः&apos; उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">“合理可能/预期违反”受托责任</skos:altLabel>
        <skos:altLabel xml:lang="de-de">„Angemessen wahrscheinlicher/erwarteter Verstoß“ gegen Treuepflichten</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">「合理的に予想される/予想される」受託義務違反</skos:altLabel>
        <skos:definition>The concept of &quot;&apos;Reasonably likely/expected breach&apos; of fiduciary duties&quot; refers to the language used in legal documents to describe a situation where a fiduciary is expected to violate their duties, and the legal standards that apply in such a scenario.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ktpZsNlvJzWq7eH4BVXIN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ktpZsNlvJzWq7eH4BVXIN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDwYaUfGBr5UZFb2zWldOBw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/Rt4T1FlyWPLKcpZDSAspuG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Last Clear Chance Doctrine</rdfs:label>
        <skos:definition>The Last Clear Chance Doctrine is a legal principle in tort law that allows a plaintiff to recover damages even if they were partially at fault, provided the defendant had the final opportunity to avoid the accident but failed to do so. This doctrine mitigates the harshness of contributory negligence by shifting the focus to the defendant&apos;s ability to prevent the harm.</skos:definition>
    </owl:Class>
    


