        <rdfs:label>Timne</rdfs:label>
        <skos:altLabel xml:lang="de-de">Timne</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Timne</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Timne</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Timne</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Timne</skos:altLabel>
        <skos:definition>Timne is a language that belongs to the Language top-level class, which is a structured system of communication consisting of grammar and vocabulary used in legal matters.</skos:definition>
    </owl:Class>
    


