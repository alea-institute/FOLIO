    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ipFN3Gn38ZzYsDrEMptrr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ipFN3Gn38ZzYsDrEMptrr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rp6HMd8Eea47JMlXfYvttU"/>
        <rdfs:label>Hardship Discharge</rdfs:label>
        <skos:definition>A Military Hardship Discharge is granted when a service member faces extreme and unforeseeable personal or financial hardships that significantly affect their ability to continue serving. The hardships could include serious illness of a family member or severe financial strain, and they must be conditions that have developed or dramatically worsened after enlisting.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9irAG86NjCSqLqVShUQsKO -->

