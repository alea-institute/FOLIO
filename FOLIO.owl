            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Teen Market Segment</rdfs:label>
        <skos:definition>The teen market segment refers to a division of the market that is specifically targeted towards teenagers as consumers. This segment encompasses products, services, and marketing strategies that are designed to cater to the unique needs, preferences, and interests of teenagers, taking into account factors such as social trends, lifestyle choices, and identity exploration.</skos:definition>
        <skos:prefLabel>Adolescent Market Segment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKaBk2mcAWgrFpk174Kg69 -->

