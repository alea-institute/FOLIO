        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5223"/>
        <rdfs:label>Activities Related to Credit Intermediation Industry</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in facilitating credit intermediation by performing activities, such as arranging loans by bringing borrowers and lenders together and clearing checks and credit card transactions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/HURLh5PmTK2m1hc66Dx_7Q -->

