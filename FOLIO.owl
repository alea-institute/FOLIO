            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Invasion of Privacy Claim</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Action en violation de la vie privée</skos:altLabel>
        <skos:altLabel>Breach of Privacy Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Breach of Privacy Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klage wegen Verletzung der Privatsphäre</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por invasión de la privacidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por invasión de la privacidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de invasão de privacidade</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת פרטיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गोपनीयता अधिकार का दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プライバシー侵害請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">侵犯隐私索赔</skos:altLabel>
        <skos:definition>A claim made by an individual alleging that their right to privacy has been violated without their consent, often involving intrusion into their private affairs or public disclosure of private information.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rpy6zPVlaMKkIhe7yY9NUy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rpy6zPVlaMKkIhe7yY9NUy">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RraVbXQhP74EFbW54D6Why"/>
        <rdfs:label>Exclusion from School Activities</rdfs:label>
        <skos:definition>Exclusion from school activities refers to the removal or denial of participation in various school-sponsored events, programs, or activities. This exclusion can apply to students or parents and may occur for various reasons, such as disciplinary actions, lack of consent, or failure to meet specific requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RpyimCrQmkKuZJZ5IVFkkS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RpyimCrQmkKuZJZ5IVFkkS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L4OY7QCBEVJpav2Da6Gef"/>
        <rdfs:label>Excise Tax Payment</rdfs:label>
        <skos:definition>Excise Tax Payment refers to taxes levied as product-specific unit taxes on a predefined, limited range of goods. Excises are usually imposed at differentiated rates on nonessential or luxury goods, such as alcoholic beverages, tobacco, and energy. They may be assessed at any stage of production or distribution and are typically calculated based on the value, weight, strength, or quantity of the product. These taxes can also apply to individual products like sugar, matches, and chocolates, as well as utilities such as water, electricity, gas, and energy.</skos:definition>
        <skos:prefLabel>Excises</skos:prefLabel>
        <skos:prefLabel>Luxury Goods Tax Payment</skos:prefLabel>
    </owl:Class>
    


