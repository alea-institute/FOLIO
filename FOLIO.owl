    <!-- https://folio.openlegalstandard.org/RDBx9QJcUHJtJqQ2FM1Ij3g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDBx9QJcUHJtJqQ2FM1Ij3g">
