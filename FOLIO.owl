        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3117"/>
        <rdfs:label>Seafood Product Preparation and Packaging</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/bCP5M_IYQRO22fkQNM1X-g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/bCP5M_IYQRO22fkQNM1X-g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/CEjDss3RQsOiM2GQlgZ_PA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=113110"/>
        <rdfs:label>Timber Tract Operations</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in the operation of timber tracts for the purpose of selling standing timber.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/bCX4WCQaQQOMmfdvsl1DhQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/bCX4WCQaQQOMmfdvsl1DhQ">
