        <skos:altLabel xml:lang="fr-fr">Suspicion Raisonnable</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חשד סביר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">युक्त संदेह</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合理怀疑</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合理的疑い</skos:altLabel>
        <skos:definition>Reasonable Suspicion is a legal standard that requires an officer to have a belief, based on specific and articulable facts, that a person is involved in criminal activity or is about to be involved in criminal activity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9yjVzN8I8D3wt6c0Wg44nI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9yjVzN8I8D3wt6c0Wg44nI">
