        <skos:altLabel xml:lang="es-mx">Objeción</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Objection</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Objection</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Objeção</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התנגדות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आपत्ति</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反对</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">異議</skos:altLabel>
        <skos:definition>An objection is a formal statement made in a trial court or bankruptcy case challenging the validity or legality of a specific action or request, such as a confirmation of a plan, application for professional employment, professional fees, claim, debtor&apos;s claim of exemptions, or transfer of claim.</skos:definition>
    </owl:Class>
    


