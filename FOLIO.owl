            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>T-FIN-FINDBT</dc:identifier>
        <rdfs:label>Debt Financing Practice</rdfs:label>
        <skos:altLabel>Debt Finance</skos:altLabel>
        <skos:altLabel>Debt Financing Service</skos:altLabel>
        <skos:altLabel>Debt Financing</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Debt Financing Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de financement par la dette</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de financiación de deuda</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de financiamiento de deuda</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de financiamento por dívida</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schuldenfinanzierungspraxis</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מעשה מימון חוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऋण वित्त प्रथा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">债务融资实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債務ファイナンスの実践</skos:altLabel>
        <skos:definition>Debt financing occurs when a firm raises money for working capital or capital expenditures by selling debt instruments to individuals and/or institutional investors. In return for lending the money, the individuals or institutions become creditors and receive a promise that the principal and interest on the debt will be repaid.</skos:definition>
        <skos:hiddenLabel>FINDBT</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8nzGmaooF9VdUO5jELI3Et -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8nzGmaooF9VdUO5jELI3Et">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBMj5dbvLFgFGrPZ3MvFGYl"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Evasion Attack</rdfs:label>
        <skos:altLabel>Deceptive Input Attack</skos:altLabel>
        <skos:altLabel>Evasion</skos:altLabel>
        <skos:altLabel>Misclassification Attack</skos:altLabel>
        <skos:definition>An evasion attack is one of the most common attacks on machine learning models performed during production. It involves designing an input that appears normal to a human but is misclassified by ML models, affecting their behavior; a typical example includes altering pixels in an image to cause an image recognition system to fail in classification.</skos:definition>
        <skos:prefLabel>Adversarial Evasion</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8o0lzPUMDOV8nWAfYHXpEK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8o0lzPUMDOV8nWAfYHXpEK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDvvMcl4VbqDv1BGaZqaSL"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDs4GGRr5BzwWdb6Lci8ZOJ"/>
        <rdfs:label>Agency Service Provider</rdfs:label>
        <skos:altLabel>Transaction Coordinator</skos:altLabel>
        <skos:definition>An Agency Service Provider in project finance transactions acts as an intermediary between the various parties involved, ensuring smooth communication and coordination. This entity manages administrative tasks, facilitates financial transactions, and ensures compliance with contractual obligations.</skos:definition>
        <skos:example>Bank Acting As An Administrative Agent For A Syndicated Loan</skos:example>
        <skos:example>Financial Institution Managing Communication Between Lenders And Borrowers</skos:example>
        <skos:example>Service Provider Overseeing Compliance In A Project Finance Deal</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8o3msiN3MfLDSiYFszhDUU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8o3msiN3MfLDSiYFszhDUU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KdQLWwrvkyzohDgf48st7"/>
        <rdfs:label>Application for Copyright Registration</rdfs:label>
        <skos:definition>An Application for Copyright Registration is a formal submission to a copyright office to secure legal protection for an original work of authorship. The application generally includes a copy of the work being copyrighted, relevant personal and work details, and the appropriate fees, serving as the basis for granting or denying copyright protection.</skos:definition>
        <skos:prefLabel>Copyright Application</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8o5aT4858rVxNv8e4cnfQs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8o5aT4858rVxNv8e4cnfQs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9G5Ptc8g9T3Ag0GDVQOwae"/>
        <rdfs:label>Active Inducement of Patent Infringement</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Active Inducement of Patent Infringement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Aktive Veranlassung von Patentverletzungen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Incitation active à l&apos;infraction de brevet</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Inducción activa a la infracción de patentes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inducción activa a la infracción de patentes</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indução ativa à infração de patente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפעלת גורמי עוולת פטנטים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पेटेंट उल्लंघन का सक्रिय प्रेरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">主动引诱侵犯专利</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">特許侵害の積極的誘発</skos:altLabel>
        <skos:definition>The Active Inducement of Patent Infringement refers to the intentional and knowing encouragement or assistance provided by one party to another in the act of infringing a patent.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8o666peng6V5762ClxsX1f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8o666peng6V5762ClxsX1f">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDDqZT9xNC4I7mH402nrpml"/>
        <rdfs:label>Operational Efficiency</rdfs:label>
        <skos:definition>Operational Efficiency is the measure of how effectively a business converts inputs into outputs. It gauges the optimal utilization of resources to maximize revenue. Commonly calculated as the ratio of output to input within a specific time period, operational efficiency is often expressed as a percentage. If that percentage is higher, then the business is more operationally efficient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8o77OqyndqK7R237rr61yE -->

