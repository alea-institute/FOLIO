        <skos:altLabel>Business Issuer</skos:altLabel>
        <skos:altLabel>Corporate Entity Issuer</skos:altLabel>
        <skos:altLabel>Enterprise Issuer</skos:altLabel>
        <skos:definition>A Corporate Issuer refers to a corporation that issues debt or equity securities to raise capital for various purposes, such as expanding operations, financing acquisitions, or refinancing existing debt. These securities can include corporate bonds, stocks, and commercial paper, and are sold to investors in the capital markets.</skos:definition>
        <skos:prefLabel>Company Issuer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8P4TfMxPJDoohmXd80aX2H -->

