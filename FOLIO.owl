        <skos:altLabel>Compulsory Process Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Derecho a un Proceso Compulsivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Derecho a un Proceso Compulsorio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito a processo compulsório</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit à une procédure obligatoire</skos:altLabel>
