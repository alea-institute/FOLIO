    <!-- https://folio.openlegalstandard.org/R8ZlXt0J1JMbXm6T0xEg2SO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ZlXt0J1JMbXm6T0xEg2SO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sdPQV8kCK3BNF8jcPV5cD"/>
        <rdfs:label>Dividend Payment Types</rdfs:label>
        <skos:definition>Dividend Payment Types refer to the various forms of dividend payments that shareholders are entitled to receive from an organization. These types of income can include cash dividends, stock dividends, property dividends, and special dividends, each providing different benefits and methods of distribution to shareholders.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Zmjg83QF1JXPMOUm9AZjE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Zmjg83QF1JXPMOUm9AZjE">
