        <rdfs:label>Failure to Obtain Auto Insurance</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Défaut de souscription d&apos;une assurance automobile</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Failure to Obtain Auto Insurance</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha em obter seguro de automóvel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta de obtención de seguro de auto</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta de obtención de seguro de auto</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fehlender Abschluss einer Kfz-Versicherung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר בקבלת ביטוח רכב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऑटो बीमा प्राप्त न करना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">未能获得汽车保险</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">自動車保険の未加入</skos:altLabel>
        <skos:definition>The failure of an individual to obtain automobile insurance as required by law.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9n7zgPfjWgz6T9XnL0goDx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9n7zgPfjWgz6T9XnL0goDx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Good Faith Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de bonne foi</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de boa-fé</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de buena fe</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de buena fe</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Good Faith Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Treu und Glauben Klausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אמון טוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अच्छी निष्ठा धारा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">善意条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">善意条項</skos:altLabel>
        <skos:definition>A Good Faith Clause is a provision in a contract that requires the parties to act honestly and fairly towards each other in their dealings, and to refrain from taking advantage of one another.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9n8FRvEhNiVY8ziiHcHarQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9n8FRvEhNiVY8ziiHcHarQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Kumyk</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Cúmico</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Koumyk</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kumyk</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クミク語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">库木克语</skos:altLabel>
        <skos:definition>Kumyk is a language that belongs to the Turkic language family and is spoken primarily in the Dagestan Republic of Russia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9n8ukOX6QZ7e4bydqrEyfE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9n8ukOX6QZ7e4bydqrEyfE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCRVBAzI4EaLARuVLhgDBTB"/>
        <rdfs:label>Commutation</rdfs:label>
        <skos:definition>Commutation is the reduction of a punishment or sentence for a crime, usually from a more severe form to a lesser one, without negating the underlying conviction. Unlike a pardon, which absolves the individual of the crime, a commutation typically pertains to reducing the length of a prison sentence or changing the type of punishment, but the conviction remains on the individual&apos;s record.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9nB8qcUs6VLcyZcPsiJwhS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9nB8qcUs6VLcyZcPsiJwhS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfOoWbuAOqLv617rVNcHYh"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Anorexia Nervosa</rdfs:label>
        <skos:altLabel>Anorexia</skos:altLabel>
        <skos:definition>Anorexia Nervosa is an eating disorder characterized by an intense fear of gaining weight and a distorted body image leading to severe food restriction and extreme weight loss. Individuals with this disorder may also engage in excessive exercise, purging, or other behaviors to prevent weight gain.</skos:definition>
        <skos:prefLabel>Anorexic Disorder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9nJOi50KsOCucMfgcb5Fhd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9nJOi50KsOCucMfgcb5Fhd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Omaha Tribe of Nebraska</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9nJZe8rDXgfMrl5tUdHw8N -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9nJZe8rDXgfMrl5tUdHw8N">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7uq2Mq8qLUybQoDhVczzZ5"/>
        <rdfs:label>Indiana Superior Court - Morgan County, Superior Court1</rdfs:label>
        <skos:definition>A court of general jurisdiction in Morgan County, Indiana, with authority to hear and decide a wide range of legal disputes and cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9nKffsUrlMdYIg9r9KAHcu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9nKffsUrlMdYIg9r9KAHcu">
