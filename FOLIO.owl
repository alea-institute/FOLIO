        </rdfs:subClassOf>
        <rdfs:label>Consideration - Intellectual Property Assets</rdfs:label>
        <skos:altLabel>Consideration - IP Assets</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Consideration - Intellectual Property Assets</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Contraprestación - Activos de Propiedad Intelectual</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Contraprestación - Activos de Propiedad Intelectual</skos:altLabel>
