        <skos:altLabel xml:lang="es-mx">Dilación Negligente de Pruebas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fahrlässige Vernichtung von Beweismitteln</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligent Spoliation of Evidence</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Spoliation de preuves négligente</skos:altLabel>
        <skos:altLabel xml:lang="he-il">השחתת ראיות שגויה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लापरवाह साक्ष्य नष्ट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">过失毁证</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">過失による証拠隠滅</skos:altLabel>
        <skos:definition>The intentional or reckless destruction or alteration of evidence by a party who had a duty to preserve it, resulting in the inability to use the evidence in a legal proceeding, due to their negligence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9ICeOg6A95qwBlvRoew3Br -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9ICeOg6A95qwBlvRoew3Br">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy"/>
        <rdfs:label>Moral Rights</rdfs:label>
        <skos:definition>Moral Rights in copyright law refer to the rights of creators to protect the personal and reputational value of their works. These rights typically include the right to claim authorship, the right to prevent distortion or mutilation, and the right to withdraw or alter the work.</skos:definition>
        <skos:prefLabel>Droit Moral</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9INwIwwIifomch7DOeSFDg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9INwIwwIifomch7DOeSFDg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pQxz2fUIrk1LjvVP8hikg"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDBYmMtBs3jHkWCzKsvQP44"/>
        <rdfs:label>Civil Arrest</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Arrestation civile</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Arresto Civil</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Arresto Civil</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Civil Arrest</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prisão civil</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zivilhaft</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עיכוב אזרחי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नागरिक गिरफ्तारी</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">民事拘束</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">民事拘留</skos:altLabel>
        <skos:definition>The concept of Civil Arrest refers to the act of detaining a person by legal authority in order to enforce a civil judgment against them.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IOi6YnPlSPWuCJD1p2q3i -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9IOi6YnPlSPWuCJD1p2q3i">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
        <rdfs:label>Disclaimer for Lack of Cooperation</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Aviso de Isenção de Responsabilidade por Falta de Cooperação</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aviso de falta de cooperación</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de non-responsabilité pour défaut de coopération</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disclaimer for Lack of Cooperation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsausschluss bei mangelnder Zusammenarbeit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Renuncia de responsabilidad por falta de cooperación</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כתב ויתור על החסרת שיתוף פעולה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सहयोग की कमी के लिए अस्वीकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不合作免责声明</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">協力不足の免責事項</skos:altLabel>
        <skos:definition>A disclaimer for lack of cooperation is a statement made by an insurance company indicating that they are not liable for a claim due to the policyholder&apos;s failure to cooperate with the investigation or provide necessary information.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IQTEVH1zSGQgYcTbCBSvM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9IQTEVH1zSGQgYcTbCBSvM">
