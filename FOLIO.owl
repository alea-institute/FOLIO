            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Legal Opinion Document</rdfs:label>
        <skos:altLabel>Legal Advisory Document</skos:altLabel>
        <skos:altLabel>Legal Opinion Letter</skos:altLabel>
        <skos:definition>A legal opinion document is a written statement by a legal expert, usually an attorney or a law firm, expressing their professional judgment on the legal aspects of a transaction, agreement, or legal issue. It provides an analysis of the legality, enforceability, or compliance of the matter in question with applicable laws and regulations.</skos:definition>
        <skos:prefLabel>Attorney Opinion Letter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RKqxeuifrYkNfCxyHq59hz -->

