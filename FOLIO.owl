        <skos:altLabel xml:lang="fr-fr">Motion pour éviter une hypothèque sur les biens ménagers</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Avoid Lien on Household Goods</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para evitar ônus sobre bens domésticos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה להימנע ממעטפה על רכוש ביתי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">घरेलू सामान पर लिएन से बचने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家庭用品に対する抵当権回避申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">避免对家庭用品设定留置权动议</skos:altLabel>
        <skos:definition>A Motion to Avoid Lien on Household Goods is a legal request to remove a lien on personal property that is essential for daily living, such as furniture and appliances.</skos:definition>
    </owl:Class>
    


