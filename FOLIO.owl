            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Written Discovery Practice</rdfs:label>
        <skos:altLabel>Written Discovery</skos:altLabel>
        <skos:altLabel>Written Discovery Service</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique de la découverte écrite</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de Descubrimiento Escrito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de Descubrimiento Escrito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de Descoberta Escrita</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schriftliche Entdeckungspraxis</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Written Disclosure Practice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תרגול גילוי כתב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लिखित खोज प्रथा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">书面发现实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">書面開示手続き</skos:altLabel>
        <skos:definition>Written Discovery Practice refers to the process of obtaining information from the opposing party in a legal matter through written requests, such as requests for documents or answers to written questions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBNJRrn32LiG4q8cOTsB72C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBNJRrn32LiG4q8cOTsB72C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
        <rdfs:label>Loan Participation Interest</rdfs:label>
        <skos:altLabel>Loan Fractions</skos:altLabel>
        <skos:altLabel>Loan Participations</skos:altLabel>
        <skos:altLabel>Participations</skos:altLabel>
        <skos:definition>Participations refer to the fractional interests in a loan or pool of loans sold by the original lender to other investors in the secondary market. These investors, known as participants, acquire the rights to receive payments and share in the risks associated with the underlying loans.</skos:definition>
        <skos:example>An investor purchases a participation in a mortgage loan, receiving a proportional share of the interest and principal payments.</skos:example>
    </owl:Class>
    


