        <rdfs:label>Disclosure Statement - Small Business</rdfs:label>
        <skos:altLabel xml:lang="es-es">Declaración de divulgación - Pequeña empresa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Declaración de divulgación - Pequeña empresa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Declaração de divulgação - Pequenas empresas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disclosure Statement - Small Business</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déclaration de divulgation - Petite entreprise</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Offenlegungserklärung - Kleinunternehmen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצהרת חשיפה - עסק קטן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डिस्क्लोजर स्टेटमेंट - छोटे व्यवसाय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">披露声明 - 小企业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">開示声明 - 小規模事業者</skos:altLabel>
        <skos:definition>A Disclosure Statement - Small Business is a written document that provides information about a small business to potential investors or buyers, including financial information, risks, and other relevant details.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8YtvLbmLTbuOrG1Ns7EfIw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8YtvLbmLTbuOrG1Ns7EfIw">
