        <skos:altLabel xml:lang="ja-jp">過剰な力の主張</skos:altLabel>
        <skos:definition>A claim made against a government entity or its agents for the use of unnecessary or unreasonable physical force in the course of their duties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBMv2Oc5Pt88hXwPuqQs2Vr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBMv2Oc5Pt88hXwPuqQs2Vr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>International Organization Visa - Representatives and Their Families</rdfs:label>
        <skos:altLabel xml:lang="en-us">G-2 Visa</skos:altLabel>
        <skos:definition>An International Organization Visa for representatives and their families is a specialized visa category that permits individuals who represent their country at international organizations to enter and reside in a host country for the duration of their assignment. This visa often extends to the immediate family members of the representatives as well. It typically comes with certain diplomatic privileges and immunities to facilitate their work and official duties.</skos:definition>
    </owl:Class>
    


