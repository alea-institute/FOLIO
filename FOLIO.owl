        <rdfs:label>Motion to Expedite Discovery</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Beschleunigung der Beweisaufnahme</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Acelerar el Descubrimiento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour accélérer la découverte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Expedite Disclosure</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para Acelerar a Descoberta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Promoción para Acelerar el Descubrimiento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לקידום גילויים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खोज को त्वरित करने के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">加速发现动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証拠開示の迅速化を求める請願</skos:altLabel>
        <skos:definition>A Motion to Expedite Discovery is a legal request to speed up the process of obtaining evidence in a case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NbFVMmNBqSIc3izA5Yf1N -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NbFVMmNBqSIc3izA5Yf1N">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDVtW9pxx7DVUlXOsBrOUEO"/>
        <rdfs:label>Lead Underwriter</rdfs:label>
        <skos:altLabel>Arranger</skos:altLabel>
        <skos:altLabel>Lead Manager</skos:altLabel>
        <skos:altLabel>Managing Underwriter</skos:altLabel>
        <skos:definition>A bookrunner, also known as a lead underwriter or lead manager, is a financial institution or investment bank responsible for managing the issuance of new securities, such as bonds or stocks, in a public offering. The bookrunner coordinates the syndicate of underwriters, sets the price of the securities, and allocates them to investors, playing a crucial role in the success of the offering.</skos:definition>
        <skos:prefLabel>Bookrunner</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
        <rdfs:label>Asset Redemption Right</rdfs:label>
        <skos:altLabel>Redemption Provisions</skos:altLabel>
        <skos:definition>Asset Redemption Right refers to the provisions and options available for the retirement or redemption of shares, allowing for the return of investment under specific conditions. These rights include various scenarios such as redeemable shares, extendible redemption dates, exchangeable shares, and perpetual shares with no fixed maturity date.</skos:definition>
        <skos:prefLabel>Buyback Rights</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Nc5vbh0wZZ68BgwFgUMkQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Nc5vbh0wZZ68BgwFgUMkQ">
