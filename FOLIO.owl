        <skos:altLabel xml:lang="hi-in">अपराध के लिए मामला खारिज करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">虐待事件の却下申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">驳回虐待案件动议</skos:altLabel>
        <skos:definition>A Motion to Dismiss Case for Abuse is a legal request made by a party in a bankruptcy case to terminate the proceedings due to the debtor&apos;s alleged abuse of the bankruptcy system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfVOYip9VRmSX7YTmktPR -->

