        <skos:altLabel xml:lang="es-mx">Derecho de Inspección</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Direito de inspeção</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Droit d&apos;inspection</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Inspektionsrecht</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right of Inspection</skos:altLabel>
        <skos:altLabel xml:lang="he-il">זכות לבדיקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निरीक्षण का अधिकार</skos:altLabel>
