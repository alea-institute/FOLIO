            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Dispositive Motion Practice</rdfs:label>
        <skos:altLabel>Dispositive Motion</skos:altLabel>
        <skos:altLabel>Dispositive Motion Service</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bewegungsverfahren zur Entscheidung über den Streitgegenstand</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dispositive Motion Practice</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Procédure de motion dispositive</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de mociones dispositivas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de mociones dispositivas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de movimento dispositivo</skos:altLabel>
