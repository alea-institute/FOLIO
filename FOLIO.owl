        <rdfs:label>Engagement Arrangements</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Accords d&apos;engagement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Acordos de engajamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acuerdos de compromiso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Arreglos de compromiso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Engagement Arrangements</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Engagement-Vereinbarungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסדרי מעורבות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यवस्थाओं की गतिविधि</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エンゲージメント契約</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">参与安排</skos:altLabel>
        <skos:definition>Ancillary engagement terms and features that the Provider may provide the Buyer, which may or may not involve remuneration.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jfpv3pujiNn5FzdM1xG1X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jfpv3pujiNn5FzdM1xG1X">
