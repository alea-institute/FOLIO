        <rdfs:label>Deposition Exhibit</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Deposition Exhibit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Exhibición de deposición</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Exhibición de deposición</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Exibição de depoimentos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Exposition de témoignages</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeugenaussage-Ausstellung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תערוכת הפסקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाही प्रदर्शन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言展示</skos:altLabel>
