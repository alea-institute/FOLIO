        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Extend Exclusivity Period</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung des Exklusivitätszeitraums</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender el período de exclusividad</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour prolonger la période d&apos;exclusivité</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Exclusivity Period</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para prorrogar o período de exclusividade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de prórroga del período de exclusividad</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת תקופת הבלעדיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवसरवादी अवधि को बढ़ाने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长排他期的动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">排他期間延長の申立て</skos:altLabel>
        <skos:definition>A Motion to Extend Exclusivity Period is a request made in a bankruptcy case to prolong the time during which a debtor has the exclusive right to propose a reorganization plan, thereby preventing competing plans from being proposed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9mdedEs06VHEXTtNhvq5at -->

