        <rdfs:label>Pennsylvania District and County Court</rdfs:label>
        <skos:definition>A Pennsylvania District and County Court is a court within the Pennsylvania State Courts system that has jurisdiction over cases within a specific district or county.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9zAjVvrLNpXJbOpIWrXULN -->

