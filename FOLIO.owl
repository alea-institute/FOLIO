        <skos:altLabel xml:lang="es-mx">Reclamaciones de crédito al consumidor y cobro de deudas injusto</skos:altLabel>
        <skos:altLabel>Unfair Debt Collection Claims</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verbraucherkredite und unberechtigte Schuldeneintreibungsansprüche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות צרכניות על קרדיט לצרכן וגביית חובות לא הוגנת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उपभोक्ता क्रेडिट और अन्यायपूर्ण ऋण वसूली दावे</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">消費者クレジットと不当な債務回収請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">消费者信贷和不当债务收集索赔</skos:altLabel>
        <skos:definition>Consumer Credit and Unfair Debt Collection Claims refer to legal claims made by individuals against creditors or debt collectors for unfair or deceptive practices in the collection of debts or the provision of credit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7KSeR2OcrUxcnB9JZYTeiz -->

