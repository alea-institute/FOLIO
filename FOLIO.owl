        <skos:altLabel xml:lang="es-mx">Cosa Juzgada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rechtskraft</skos:altLabel>
        <skos:altLabel>Res Adjudicata</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Res Judicata</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רס יודיקטה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रेस जुडिकाटा</skos:altLabel>
