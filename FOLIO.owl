        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj"/>
        <rdfs:label>Hostile Takeover</rdfs:label>
        <skos:altLabel xml:lang="es-es">Adquisición hostil</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Adquisición hostil</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aquisição hostil</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Feindliche Übernahme</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Hostile Takeover</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">OPA hostile</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רכישה או כיבוש אויבני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शत्रुतापूर्ण विजय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">敌意收购</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">敵対的買収</skos:altLabel>
        <skos:definition>A hostile takeover occurs when the acquiring company attempts to take control of the target company without the consent or cooperation of the target company&apos;s management and board of directors. This is typically achieved through a tender offer directly to the shareholders or by launching a proxy fight to gain control of the board.</skos:definition>
    </owl:Class>
    


