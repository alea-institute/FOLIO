        <skos:altLabel xml:lang="pt-br">Cláusula de direito de sublocação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zum Untervermietungsrecht</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Right to Sublet Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף זכות לכפות תת-השכרה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सबलेट करने का अधिकार शर्त</skos:altLabel>
