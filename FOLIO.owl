        <rdfs:label>Constructive Fraudulent Transfer</rdfs:label>
        <skos:altLabel>Constructive Fraudulent Conveyance</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Constructive Fraudulent Transfer</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Konstruktive betrügerische Übertragung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Transferencia Fraudulenta Constructiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Transferencia Fraudulenta Constructiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Transfert frauduleux constructif</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Transferência fraudulenta construtiva</skos:altLabel>
        <skos:altLabel xml:lang="he-il">העברת מרמה בונה</skos:altLabel>
