    <!-- https://folio.openlegalstandard.org/R7zFDSz9BjpVwMtwSqsOTsY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7zFDSz9BjpVwMtwSqsOTsY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2OdJWZ0azNvrSJ7DPl0gU"/>
        <rdfs:label>Contingent Convertible Share</rdfs:label>
        <skos:altLabel>CoCo bond</skos:altLabel>
        <skos:altLabel>Contingent Convertible Instrument</skos:altLabel>
        <skos:altLabel>Convertible Contingent Security</skos:altLabel>
        <skos:definition>A Contingent Convertible Share, often referred to as a CoCo bond, is a type of debt security that automatically converts into equity when a predefined trigger event occurs, typically related to the issuer&apos;s financial health or regulatory capital thresholds. These instruments are designed to provide additional capital to the issuer during periods of financial stress, thereby enhancing financial stability.</skos:definition>
        <skos:prefLabel>Contingent Convertible Bond</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7zHyrVy8Z3m15uOpjfOyhb -->

