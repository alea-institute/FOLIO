        <rdfs:label>Caribbean Community</rdfs:label>
        <skos:definition>CARICOM (Caribbean Community): An organization of Caribbean nations and dependencies aiming for economic integration and cooperation among its members, ensuring that the benefits of integration are equitably shared, and coordinating foreign policy.</skos:definition>
        <skos:prefLabel>CARICOM</skos:prefLabel>
    </owl:Class>
    


