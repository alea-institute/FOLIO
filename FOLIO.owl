        <skos:altLabel xml:lang="fr-fr">Motions et dépôts pour disqualifier le décideur</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petições e requerimentos para desqualificar o tomador de decisão</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות והגשות לפסול את המכריע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्णय लेने वाले को अयोग्य ठहराने के लिए आवेदन और दाखिले</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">撤销决策者的动议和申请书</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">決定者を拒否するための動議と申立書</skos:altLabel>
        <skos:definition>A Motion or Filing to Disqualify Decisionmaker is a legal request made by a party to remove a judge, arbitrator, or other decisionmaker from a case due to a perceived conflict of interest or bias.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOm7uyuCKhvuGGPF0usp02 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOm7uyuCKhvuGGPF0usp02">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDDqZT9xNC4I7mH402nrpml"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCIQtHHdQl861KZaBklud18"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Work Utilization</rdfs:label>
        <skos:altLabel>Timekeeper Utilization Rate</skos:altLabel>
        <skos:definition>Utilization is a metric often used in service industries to measure the percentage of a professional&apos;s working hours that are engaged in revenue-generating activities (billable). It is calculated by dividing the billable hours by the total available working hours. Utilization it usually expressed as a percentage, used to assess individual, team, or workforce efficiency and capacity utilization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOoYq5UsqIy3nBTVUnTNco -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOoYq5UsqIy3nBTVUnTNco">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85Datx36zz4sBBoEYxCByw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDpdutTNI2rbLZMnb9oqlOc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>State Government Representative</rdfs:label>
        <skos:altLabel>State Official</skos:altLabel>
        <skos:altLabel>State-Level Public Servant</skos:altLabel>
        <skos:definition>A State Government Representative is an elected or appointed official who serves in the government of a state, province, or similar sub-national administrative division. This individual is responsible for participating in the creation, debate, or implementation of state-level laws, policies, and programs, as well as representing the interests of their constituents within the state governmental structure.</skos:definition>
        <skos:prefLabel>Provincial Governmental Representative</skos:prefLabel>
    </owl:Class>
    


