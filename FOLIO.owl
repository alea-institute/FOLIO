    <!-- https://folio.openlegalstandard.org/R8O1VWhQ1xk3ac5wJbUD7C1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8O1VWhQ1xk3ac5wJbUD7C1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP"/>
        <rdfs:label>Spinach</rdfs:label>
        <skos:altLabel>Spinacia Oleracea</skos:altLabel>
        <skos:definition>Spinach is a leafy green vegetable from the Spinacia oleracea species, known for its tender leaves and mild, slightly earthy flavor. It is consumed raw or cooked and is valued for its high nutritional content, including vitamins A, C, and K, iron, calcium, and antioxidants.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8O1uQRrzRaJZpBZ6wL39Aw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8O1uQRrzRaJZpBZ6wL39Aw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Dxh7cqKFFJ2jKNTvICMhf"/>
        <rdfs:label>Army</rdfs:label>
        <skos:altLabel>Ground Forces</skos:altLabel>
        <skos:altLabel>Infantry</skos:altLabel>
        <skos:altLabel>Land Army</skos:altLabel>
        <skos:altLabel>Land Forces</skos:altLabel>
        <skos:definition>An Army is the land-based military branch of a nation&apos;s armed forces, primarily responsible for ground warfare and territorial defense. This organization consists of trained soldiers, support personnel, and various types of land-based military equipment, structured to conduct large-scale ground operations and maintain national security.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy">
