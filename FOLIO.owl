        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
        <rdfs:label>Breach of Insurance Contract</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Insurance Contract</skos:altLabel>
