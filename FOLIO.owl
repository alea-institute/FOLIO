        <skos:altLabel xml:lang="es-mx">Discriminación retaliatoria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Discrimination de représailles</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Discriminação retaliatória</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Retaliatory Discrimination</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergeltungsdiskriminierung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפלילה הנקמנית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतिशोधात्मक भेदभाव</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">報復的差別待遇</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">报复性歧视</skos:altLabel>
        <skos:definition>Retaliatory Discrimination refers to the act of an employer taking adverse action against an employee in response to the employee&apos;s complaint or opposition to discriminatory practices in the workplace.</skos:definition>
    </owl:Class>
    


