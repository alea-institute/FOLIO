        <rdfs:label>Security and Confidentiality Attributes</rdfs:label>
        <skos:altLabel>Confidentiality Levels</skos:altLabel>
        <skos:altLabel>Data Protection Attributes</skos:altLabel>
        <skos:altLabel>Information Security Levels</skos:altLabel>
        <skos:altLabel>Protection Classifications</skos:altLabel>
        <skos:definition>Security and Confidentiality Attributes refer to the various levels of protection and access controls applied to information to prevent unauthorized disclosure, modification, or destruction. These attributes include different classifications such as top secret, secret, confidential, and restricted, each defining the degree of security and the associated protocols for managing sensitive information within an organization (e.g., company, nonprofit, nation).</skos:definition>
        <skos:prefLabel>Data Security Attributes</skos:prefLabel>
    </owl:Class>
    


