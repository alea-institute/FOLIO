        <skos:altLabel xml:lang="es-es">Mociones sobre la prueba, el expediente o el apéndice</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones sobre la prueba, el expediente o el apéndice</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motions on Evidence, the Record, or Appendix</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions sur les preuves, le dossier ou l&apos;annexe</skos:altLabel>
