        <rdfs:label>Pet Care (except Veterinary) Services</rdfs:label>
        <skos:definition>See industry description for 812910.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/dBznQuc4TF2u9qYTVToxXA -->

