            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Estoppel by Deed</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Estoppel by Deed</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Estoppel par acte</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Grundbuchschutz</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Impedimento por Escritura</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Impedimento por Escritura</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Impedimento por escritura</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אסטופל על ידי כתב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डीड द्वारा रोक</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">契约禁言</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">権利拒否主張</skos:altLabel>
        <skos:definition>A legal principle that prevents a party from denying the truth of a statement made in a deed or other legal document, when that party&apos;s previous actions or words have relied upon the truth of that statement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkWZtlhJVbVdxHsT52SK45 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkWZtlhJVbVdxHsT52SK45">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9qWOyiOCY9v0cF2P0cRjvx"/>
        <rdfs:label>Reserve Based Lending Practice</rdfs:label>
        <skos:altLabel>Reserve Based Lending</skos:altLabel>
        <skos:altLabel>Reserve Based Lending Service</skos:altLabel>
        <skos:definition>Reserve Based Lending Practice involves legal work focused on asset-based lending where the loan is secured by the value of a borrower&apos;s reserves.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkY60gHdSvN4pl6vmXgyUg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkY60gHdSvN4pl6vmXgyUg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8WhsyEOse5TvMLfnHDYfTY"/>
        <rdfs:label>Plums</rdfs:label>
        <skos:altLabel>Prunus Domestica</skos:altLabel>
        <skos:definition>Plums are smooth-skinned stone fruits from the Prunus genus, known for their juicy flesh and sweet-tart flavor. They are consumed fresh, dried as prunes, or used in cooking, baking, and preserves, valued for their vitamins, antioxidants, and dietary fiber.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkZ1f1SIdbFYRwzAad7v3D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkZ1f1SIdbFYRwzAad7v3D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7I7inwWLqKi8ZMm0Ey6dkK"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8RfDzMtuMPdmNTonmhBxu"/>
        <rdfs:label>Real Estate Lease</rdfs:label>
        <skos:definition>A Real Estate Lease is a contract wherein the owner (lessor) grants the right to occupy and use their property to another party (lessee) for a specified period in exchange for rental payments.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkZBjHchWXuRh8dwpGuJwX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDkZBjHchWXuRh8dwpGuJwX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pQxz2fUIrk1LjvVP8hikg"/>
        <rdfs:label>Demolition</rdfs:label>
        <skos:definition>Demolition is the process of tearing down or dismantling a building or structure, often to clear land for new construction or to remove unsafe or obsolete buildings. This process involves various techniques and machinery, including manual labor, wrecking balls, and controlled explosives, to safely and efficiently bring down the structure. The demolition may be the result of a legal proceeding (e.g., condemnation).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDka3Y1Nf4XVfulwZDbzUVU -->

