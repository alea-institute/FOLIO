        <skos:altLabel xml:lang="es-es">Juez de lo Contencioso-Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Juge administratif</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Juiz de Direito Administrativo</skos:altLabel>
