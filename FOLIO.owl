        <skos:altLabel xml:lang="zh-cn">公司代表证言</skos:altLabel>
        <skos:definition>A Corporate Representative Deposition is a legal proceeding where a company designates a representative to testify on its behalf in response to a subpoena or other legal request for information.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj">
