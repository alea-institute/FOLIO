    <!-- https://folio.openlegalstandard.org/W2f3zFf7TqGjiIp6K4IVNQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/W2f3zFf7TqGjiIp6K4IVNQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmVqE62aGlOtAoEND19KjU"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=54119"/>
        <rdfs:label>Other Legal Services</rdfs:label>
        <skos:definition>This industry comprises establishments of legal practitioners (except lawyers and attorneys) primarily engaged in providing specialized legal or paralegal services.</skos:definition>
        <skos:example>Notary public services</skos:example>
        <skos:example>Paralegal services</skos:example>
        <skos:example>Patent agent services (i.e., patent filing and searching services)</skos:example>
        <skos:example>Process serving services</skos:example>
        <skos:example>Real estate settlement offices</skos:example>
        <skos:example>Real estate title abstract companies</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/W34Tw5sHTNqJ7fTdB7PAmw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/W34Tw5sHTNqJ7fTdB7PAmw">
