            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Separation Agreement</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Accord de séparation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Acordo de separação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acuerdo de Separación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de Separación</skos:altLabel>
        <skos:altLabel>Document</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Separation Agreement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Trennungsvereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם הפרדה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विभाजन समझौता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">分居协议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">離婚協議書</skos:altLabel>
        <skos:definition>A Separation Agreement is a written document that outlines the terms and conditions agreed upon by parties who are separating or divorcing, including issues such as property division, child custody, and support.</skos:definition>
        <skos:prefLabel>Divorce Agreement</skos:prefLabel>
        <skos:prefLabel>Marriage Dissolution Agreement</skos:prefLabel>
        <skos:prefLabel>Marriage Termination Agreement</skos:prefLabel>
    </owl:Class>
    


