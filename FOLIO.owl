        <skos:altLabel xml:lang="fr-fr">Par temps avec tarifs réduits</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Por tempo com tarifas com desconto</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Por tiempo con tarifas descontadas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Por tiempo con tarifas descontadas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לפי זמן עם מחירים מוזלים</skos:altLabel>
