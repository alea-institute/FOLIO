        <skos:altLabel xml:lang="de-de">Verzicht auf Bürgschaftsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waiver of Bond Provision</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפקדת ערבות נכסים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बंधक प्रावधान से इनकार करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保証金免除条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">免除保证金条款</skos:altLabel>
        <skos:definition>A Waiver of Bond Provision is a clause within a Specific Performance agreement that allows the party seeking performance to waive the requirement of posting a bond to secure the performance.</skos:definition>
    </owl:Class>
    


