        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RzfFH8JWSdPtXHz4cLcFGE"/>
        <rdfs:label>Motion to Extend Time</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Fristverlängerung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender el tiempo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Time</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de prorrogação de prazo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en prorogation de délai</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de prórroga de plazo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת זמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समय बढ़ाने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长时间动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">期間延長請求</skos:altLabel>
        <skos:definition>A Motion to Extend Time is a request made to a court to allow for a longer period of time to complete a specific action or filing, typically in the context of a bankruptcy or other legal proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R4mSfvmS03kmmWa1Jj5tEm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R4mSfvmS03kmmWa1Jj5tEm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5bITZZ0taJOXwcwS314VU"/>
        <rdfs:label>Comity Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Comity Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Comity-Klausel-Anspruch</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande de clause de comité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Cláusula de Comidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Cláusula de Comidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de comitê</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף קומיטי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कोमिटी क्लॉज क्लेम</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コミティ条項請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">礼让条款索赔</skos:altLabel>
        <skos:definition>A Comity Clause claim refers to a legal argument based on the Comity Clause of the United States Constitution, asserting that one state must give full faith and credit to the public acts, records, and judicial proceedings of another state. It aims to ensure interstate cooperation and prevent discrimination against individuals or entities based on their out-of-state status.</skos:definition>
    </owl:Class>
    


