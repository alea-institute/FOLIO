        </rdfs:subClassOf>
        <rdfs:label>Trial and Post-Trial Motion Practice</rdfs:label>
        <skos:altLabel>Trial and Post-Trial Motion</skos:altLabel>
        <skos:altLabel>Trial and Post-Trial Motion Service</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pratique des motions de procès et post-procès</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Prozess- und Nachprozessbewegungen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Práctica de juicio y post-juicio de mociones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Práctica de juicio y post-juicio de mociones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Prática de movimentos de julgamento e pós-julgamento</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trial and Post-Trial Motion Practice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניהול הליך ניסיון והליך תנועה לאחר הליך ניסיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रायल और पोस्ट-ट्रायल मोशन प्रैक्टिस</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">审判和审判后动议实践</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判および裁判後の動議手続き</skos:altLabel>
        <skos:definition>Trial and Post-Trial Motion Practice refers to the legal procedures and actions taken by parties after a trial has concluded, including motions for a new trial, appeals, and other post-trial motions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RgPGuacDwkSwCHphS7lmt7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgPGuacDwkSwCHphS7lmt7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
        <rdfs:label>Cruel and Inhuman Treatment</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Cruel and Inhuman Treatment</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Grausame und unmenschliche Behandlung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Traitement cruel et inhumain</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tratamento cruel e desumano</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Trato cruel e inhumano</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Trato cruel e inhumano</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טיפול אכזרי ואנושי לא סביר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निष्ठुर और अमानवीय व्यवहार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">残忍和不人道的待遇</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">残酷で非人道的な扱い</skos:altLabel>
        <skos:definition>The concept of &quot;Cruel and Inhuman Treatment&quot; refers to a claim made in a divorce case where one spouse alleges that the other has subjected them to severe physical or emotional abuse, making it impossible for them to continue the marriage.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RgPO0_bdCQIOa3ULZ7yx9JA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RgPO0_bdCQIOa3ULZ7yx9JA">
