        <skos:definition>Use only for other trademark related tasks that can not be included under a previous code, or as instructed by the client.</skos:definition>
        <skos:prefLabel>TR799 Other Trademark Prosecution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHwCmZ2yKrJobzC86GC6Ep -->

