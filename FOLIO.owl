        <rdfs:label>Motion to File Supplemental Excerpts of Record</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Einreichung von ergänzenden Auszügen aus dem Protokoll</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para presentar extractos de registro suplementarios</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour déposer des extraits de dossier supplémentaires</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to File Supplemental Excerpts of Record</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para arquivar extratos suplementares do registro</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud para presentar extractos de registro suplementarios</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להגשת צילומי רשומות נוספים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रिकॉर्ड के सप्लीमेंटल अंशों को फाइल करने के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">提交补充记录摘录的动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">補足的記録抜粋を提出する動議</skos:altLabel>
        <skos:definition>A Motion to File Supplemental Excerpts of Record is a formal request made to a court to allow additional evidence to be added to the record of a case, beyond what was originally submitted.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHqTgT2qpg1odifoEnqutL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RHqTgT2qpg1odifoEnqutL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtmRdqzdG4lddVrtCToiL1"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9oT1uDgFl2wSjoa358Wowx"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Business Partner Breaching Fiduciary Duty to Co-Partner</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Business Partner Breaching Fiduciary Duty to Co-Partner</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geschäftspartner, der seine Treuepflicht gegenüber dem Mitgesellschafter verletzt</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Parceiro de negócios violando o dever fiduciário para com o co-sócio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Partenaire commercial violant son devoir fiduciaire envers le co-partenaire</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Socio comercial que incumple su deber fiduciario con el co-socio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Socio comercial que incumple su deber fiduciario con el co-socio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שותף עסקי שמפר חובת נאמנות לשותף עסקי אחר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यवसायिक साझेदार जो सह-साझेदार के वफादारी कर्तव्य का उल्लंघन करता है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">共同出資者に対する信託義務違反を行うビジネスパートナー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">商业伙伴违反对合伙人的信义义务</skos:altLabel>
        <skos:definition>When a business partner fails to uphold their legal obligation to act in the best interest of their co-partner, they are breaching their fiduciary duty and can be held liable for any resulting damages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHqmAJXMNndwznZfBHEbJG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RHqmAJXMNndwznZfBHEbJG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSOFJGFjyBIx52S43z5Vzc"/>
        <rdfs:label>Writ of Attachment</rdfs:label>
        <skos:definition>A Writ of Attachment is a court order to seize or take control of a specific property or assets before the final judgment in a lawsuit, ensuring that the property will not be disposed of or hidden by the defendant.</skos:definition>
        <skos:prefLabel>Attachment Order</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHrIIrzJpjzV7eD3r5UMh4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RHrIIrzJpjzV7eD3r5UMh4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9eX3Auj16MgFGGYWRmhns8"/>
        <rdfs:label>Hemiplegia</rdfs:label>
        <skos:altLabel>One-Sided Paralysis</skos:altLabel>
        <skos:definition>Hemiplegia is a condition characterized by paralysis or severe weakness on one side of the body, typically resulting from brain injuries such as stroke, traumatic brain injury, or neurological diseases. This condition affects motor function, coordination, and sensation on the affected side, significantly impacting daily activities.</skos:definition>
        <skos:prefLabel>Hemiparetic Condition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RHvP1bbr9Twm9do6grfUR6w -->

