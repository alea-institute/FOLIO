        <skos:altLabel xml:lang="ja-jp">囚人救出</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">囚犯营救</skos:altLabel>
        <skos:definition>The Rescue of Prisoner is a criminal act against the government that involves the unlawful liberation of a person who is being held in custody.</skos:definition>
    </owl:Class>
    


