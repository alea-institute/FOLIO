        <skos:altLabel xml:lang="pt-br">Lista de testemunhas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Liste de témoins</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Witness List</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zeugenliste</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רשימת עדים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाह सूची</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証人リスト</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">证人清单</skos:altLabel>
        <skos:definition>A witness list is a document that contains the names of individuals who may be called upon to testify in a legal proceeding related to bankruptcy and restructuring.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RM1302VsZ3oF1kJWNkxjRy -->

