                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RuDAbRiNW105SQoqb1XZ4c"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Economic Loss Doctrine</rdfs:label>
        <skos:altLabel xml:lang="es-es">Doctrina de la Pérdida Económica</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Doctrina de la Pérdida Económica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Doctrine des pertes économiques</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Doutrina de Perda Econômica</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Economic Loss Doctrine</skos:altLabel>
        <skos:altLabel>Economic Loss Rule</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Wirtschaftlicher Verlustgrundsatz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תאוריה של הפסד כלכלי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आर्थिक हानि डॉक्ट्रिन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">経済損失原則</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">经济损失原则</skos:altLabel>
        <skos:definition>The Economic Loss Doctrine is a legal principle that limits recovery in negligence claims to only economic losses, such as lost profits or property damage, and excludes recovery for personal injury or other non-economic losses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7YToQxzuXojCNWk2g0gIk8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7YToQxzuXojCNWk2g0gIk8">
