        <rdfs:label>Written Consent in Lieu of Meeting Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de consentement écrit en lieu et place de la réunion</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Consentimiento por Escrito en Lugar de Reunión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Consentimiento por Escrito en Lugar de Reunión</skos:altLabel>
