        <skos:altLabel xml:lang="es-mx">Industria de la grabación de sonido</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de l&apos;enregistrement sonore</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de gravação de som</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Sound Recording Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Tonträgerindustrie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית הקלטת צלילים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ध्वनि रिकॉर्डिंग उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">音声録音産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">音频录制产业</skos:altLabel>
        <skos:definition>The Sound Recording Industry is a branch of the Recording Industry that specifically deals with the production and distribution of audio recordings.</skos:definition>
    </owl:Class>
    


