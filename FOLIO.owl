    <!-- https://folio.openlegalstandard.org/RvUd14Lw1TxYJEBX6IFgY0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RvUd14Lw1TxYJEBX6IFgY0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC"/>
        <rdfs:label>Wellness Market Segment</rdfs:label>
        <skos:altLabel>Well-Being Market Segment</skos:altLabel>
        <skos:definition>The wellness market segment refers to a division of the market that is specifically targeted towards consumers who are interested in maintaining or enhancing their overall well-being. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek holistic health solutions, including physical, mental, emotional, and spiritual wellness.</skos:definition>
        <skos:example>Aromatherapy Products</skos:example>
        <skos:example>Meditation and Mindfulness Apps</skos:example>
        <skos:example>Wellness Apps</skos:example>
        <skos:example>Wellness Coaching</skos:example>
        <skos:prefLabel>Holistic Health Market</skos:prefLabel>
    </owl:Class>
    


