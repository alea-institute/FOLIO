    <!-- https://folio.openlegalstandard.org/R7weWtBHO2jaJ1TqfeSAjfE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7weWtBHO2jaJ1TqfeSAjfE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9WRFGVqE913fnyJVUGR8Xg"/>
        <rdfs:label>Oats</rdfs:label>
        <skos:definition>Oats are a cereal crop belonging to the species Avena sativa, known for their edible seeds that are highly nutritious and commonly used in food products such as oatmeal, granola, and oat milk. They are valued for their high fiber content, particularly beta-glucan, and are grown primarily in temperate regions.</skos:definition>
        <skos:prefLabel>Avena Sativa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7wiZFY7X1mvwdTAODDGrNi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7wiZFY7X1mvwdTAODDGrNi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxmjoCAyfDHKhwXHlwikL"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDMlfBHhw2Mfk0FBrVCQJY9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Split Dollar Agreement</rdfs:label>
        <skos:definition>A Split Dollar Agreement is a contract that details how the premiums, death benefits, and cash values of a life insurance policy are split between two parties. Typically, one party owns the policy, while the other has a vested interest in the death benefit or cash value.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs -->

