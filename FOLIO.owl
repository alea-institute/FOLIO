        <rdfs:label>Trucking Negligence</rdfs:label>
        <skos:altLabel xml:lang="de-de">LKW-Nachlässigkeit</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia en el transporte de carga por carretera</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia en el transporte de mercancías por carretera</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência no transporte rodoviário</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence routière</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Trucking Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בהובלת מטענים על גבי משאיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रकिंग लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">トラック過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">货车疏忽</skos:altLabel>
        <skos:definition>Trucking Negligence refers to the failure of a common carrier engaged in the transportation of goods by truck to exercise reasonable care, resulting in harm or injury to others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uaOTdTaAuNmWKOgiGiD9t -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uaOTdTaAuNmWKOgiGiD9t">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV"/>
        <rdfs:label>Lost Capacity in Living Resulting from Tort</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Lost Capacity in Living Resulting from Tort</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Perda de capacidade de viver resultante de tortura</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Perte de capacité de vivre résultant de la torture</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Pérdida de capacidad de vivir como resultado de un delito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Pérdida de capacidad de vivir como resultado de un delito</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verlorene Lebensqualität aufgrund von Folter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגיעה ביכולת לחיות כתוצאה מפשע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तोड़फोड़ से होने वाली जीवन में क्षमता का नुकसान</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因酷刑而导致的生活能力丧失</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">拷問による生活能力の喪失</skos:altLabel>
        <skos:definition>The concept of Lost Capacity in Living Resulting from Tort refers to the reduction in a person&apos;s ability to enjoy life due to injuries caused by someone else&apos;s wrongful act, for which compensation may be sought in a personal injury claim under the category of non-economic damages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ucHOT4J1VQ7KZTWxIoth3 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ucHOT4J1VQ7KZTWxIoth3">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
        <rdfs:label>Fruit of the Poisonous Tree</rdfs:label>
        <skos:altLabel>Exclusion of Unfair Evidence</skos:altLabel>
        <skos:altLabel>Tainted Evidence</skos:altLabel>
        <skos:inSchema>UK</skos:inSchema>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uoc2fGReblZYERcaEgDBS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uoc2fGReblZYERcaEgDBS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwadSStLIBnmEe8euTpNYP"/>
        <rdfs:label>Work Environment Harassment</rdfs:label>
        <skos:altLabel xml:lang="es-mx">Acoso en el ambiente laboral</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acoso en el entorno laboral</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Assédio no ambiente de trabalho</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Belästigung am Arbeitsplatz</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Harcèlement en milieu de travail</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Work Environment Harassment</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הטרדה בסביבת עבודה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कार्य वातावरण उत्पीड़न</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">工作环境骚扰</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">職場でのハラスメント</skos:altLabel>
        <skos:definition>Work Environment Harassment refers to a type of employment harassment claim that involves creating a hostile work environment through unwelcome and discriminatory behavior or conduct.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8utefjaPVm1ooWgvWHaZ8p -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8utefjaPVm1ooWgvWHaZ8p">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Social Anxiety Disorder</rdfs:label>
        <skos:definition>Social Anxiety Disorder, also known as social phobia, is a mental health condition characterized by an intense, persistent fear of social or performance situations where one may be scrutinized or judged by others. This fear often leads to significant distress and avoidance of social interactions, affecting daily functioning and quality of life.</skos:definition>
        <skos:example>Public Speaking Anxiety: An individual experiences severe anxiety and avoidance when required to speak in front of a group.</skos:example>
        <skos:example>Social Interaction Anxiety: An individual fears and avoids social gatherings or interactions due to fear of being negatively evaluated or embarrassed.</skos:example>
        <skos:prefLabel>Social Phobia</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uuvxRrK0Eet2bpHbBGjGp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uuvxRrK0Eet2bpHbBGjGp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP"/>
        <rdfs:label>Lettuce</rdfs:label>
        <skos:altLabel>Lactuca Sativa</skos:altLabel>
        <skos:definition>Lettuce is a leafy vegetable from the Lactuca sativa species, known for its crisp texture and mild, refreshing flavor. It is commonly consumed raw in salads and sandwiches and is valued for its low-calorie content and nutritional benefits, including vitamins A, C, and K, as well as fiber.</skos:definition>
    </owl:Class>
    


