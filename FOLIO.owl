        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RjVgVOLkDyEKic8xZS06iB"/>
        <rdfs:label>Speculative Grade</rdfs:label>
        <skos:altLabel>High-Risk Bond</skos:altLabel>
        <skos:altLabel>High-Yield Debt</skos:altLabel>
        <skos:altLabel>Junk Grade</skos:altLabel>
        <skos:altLabel>Non-Investment Grade</skos:altLabel>
        <skos:definition>Speculative Grade refers to a category of credit rating that indicates a higher risk of default, making the debt securities less suitable for conservative investors. These ratings are assigned by credit rating agencies and generally include ratings below BBB on the Standard &amp; Poor&apos;s and Fitch scales, and below Baa3 on the Moody&apos;s scale.</skos:definition>
        <skos:example>B Rating</skos:example>
        <skos:example>BB Rating</skos:example>
        <skos:example>C Rating</skos:example>
        <skos:example>CC Rating</skos:example>
        <skos:example>CCC Rating</skos:example>
        <skos:example>D Rating</skos:example>
        <skos:prefLabel>Junk Bond</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uMgFwwOTwfOpkGF733wx9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uMgFwwOTwfOpkGF733wx9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3Q1HDu5jO8nvhdbr2Uj0c"/>
        <rdfs:label>Florida Circuit Court - Osceola County - 9th Circuit Court</rdfs:label>
        <skos:definition>A Florida Circuit Court located in Osceola County that operates within the 9th Circuit Court jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uPIk7OdU6TA8qkpovKICu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uPIk7OdU6TA8qkpovKICu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
        <rdfs:label>Suit on Sworn Account</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Action sur compte juré</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ação de Conta Juramentada</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Juicio sobre cuenta jurada</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Juicio sobre cuenta jurada</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klage auf Eidkonto</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Suit on Sworn Account</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על חשבון נאמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शपथपूर्वक खाते पर मुकदमा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">宣誓口座に関する訴訟</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">宣誓账户诉讼</skos:altLabel>
        <skos:definition>A Suit on Sworn Account is a legal claim that arises from a written statement made under oath by a party who seeks to recover a debt or demand payment for goods or services provided, and is based on a contractual or quasi-contractual relationship between the parties involved.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uPzCETLEs7fjbuzJPtMPS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uPzCETLEs7fjbuzJPtMPS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8oBTLovip7JQGJ9AeOmmCD"/>
        <rdfs:label>Antitrust - Refusal to Deal Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de Negativa a Negociar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de Negativa a Negociar</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Antitrust - Refusal to Deal Claims</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות סירוב לעסקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - डील से इनकार दावे</skos:altLabel>
        <skos:definition>The concept of &quot;Antitrust - Refusal to Deal Claims&quot; refers to legal claims made against a company for refusing to do business with another company, in violation of antitrust laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uUwQ5jjK4J6dt0P4Hg7PW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uUwQ5jjK4J6dt0P4Hg7PW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg"/>
        <rdfs:label>Tax Agreements</rdfs:label>
        <skos:definition>A Tax Related Agreement is a contract outlining the terms, conditions, and responsibilities of parties concerning taxation matters. This agreement can address issues like the allocation of tax liabilities, indemnifications, and procedures for handling tax-related disputes or inquiries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uVWChGsC92Bmw3gMJD9bg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uVWChGsC92Bmw3gMJD9bg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
        <rdfs:label>Creativity</rdfs:label>
        <skos:definition>Creativity in copyright law refers to the requirement that a work must display some level of original thought or artistic expression. It distinguishes copyrightable works from mere mechanical reproductions, ensuring protection is afforded only to creations that embody the author&apos;s intellectual effort.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uW4lNe8RZr0qftjrI1ACm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uW4lNe8RZr0qftjrI1ACm">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
        <rdfs:label>Solvency Risk</rdfs:label>
        <skos:definition>The risk that the company will not have sufficient assets to meet its liabilities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uW6qS9Y0zZglFODk0qKA9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8uW6qS9Y0zZglFODk0qKA9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Bonus Opportunity Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bonus Opportunity Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bonusmöglichkeitsklausel</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;opportunité de bonus</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Oportunidad de Bonificación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Oportunidad de Bonificación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de oportunidade de bônus</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הזדמנות בונוס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बोनस अवसर शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ボーナス機会条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">奖金机会条款</skos:altLabel>
        <skos:definition>A Bonus Opportunity Clause is a provision in a contract that provides an additional chance for a party to receive a bonus or reward based on certain conditions being met.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8uW7tSElnScC1uC2CnZTIL -->

