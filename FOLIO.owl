        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCssZ0eE4LoAphnQlNXXQo4"/>
        <rdfs:label>Logging Real Estate Asset</rdfs:label>
        <skos:definition>A logging real estate asset refers to a property that contains or is primarily used for the extraction of timber through logging activities. This asset is crucial in the context of forestry law, environmental law, and property law, as it involves the rights to harvest, manage, and sell timber resources.</skos:definition>
    </owl:Class>
    


