        <rdfs:label>Management, Scientific, and Technical Consulting Services Industry</rdfs:label>
        <skos:altLabel xml:lang="es-es">Industria de Consultoría Técnica</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Consultoría Técnica</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie du conseil technique</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de consultoria técnica</skos:altLabel>
        <skos:altLabel>Technical Consulting</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Technical Consulting Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Technische Beratungsbranche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית ייעוץ טכני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तकनीकी परामर्श उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">技术咨询行业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">技術コンサルティング業界</skos:altLabel>
        <skos:definition>This industry group comprises establishments primarily engaged in providing advice and assistance to businesses and other organizations on management, environmental, scientific, and technical issues.</skos:definition>
        <skos:hiddenLabel>TCHC</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBEl2j7VESmhE9eN8pS2Q1F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBEl2j7VESmhE9eN8pS2Q1F">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCOOyyZhW3l3cdenBfC5LT4"/>
        <rdfs:label>Co-Authoring Management</rdfs:label>
        <skos:definition>Co-Authoring Management refers to the process of managing the collaboration and contribution of multiple authors to a document, within the context of Document Management.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBEnDvjP0Wekrb9m53BLnws -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBEnDvjP0Wekrb9m53BLnws">
