    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkkleTMIObttgaIgsbLmXo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Soninke</rdfs:label>
        <skos:altLabel xml:lang="de-de">Soninke</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Soninke</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Soninké</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ソニンケ族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">索宁克族</skos:altLabel>
        <skos:definition>A language spoken primarily in West Africa, specifically in the countries of Mali, Senegal, and Mauritania, among others.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkkuBZSNq25iEr81d16qsc -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkkuBZSNq25iEr81d16qsc">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RikjKAB2GQa9wClhzmpv5z"/>
        <rdfs:label>Succession Rights Claim</rdfs:label>
        <skos:altLabel>Succession Rights</skos:altLabel>
        <skos:definition>A succession rights claim pertains to a legal action filed by a family member or household member seeking the right to continue residing in a rent-controlled or rent-stabilized apartment after the original tenant has vacated or passed away. In some jurisdictions, rent control or rent stabilization laws allow certain family members or individuals who have lived with the tenant for an extended period to succeed to the tenancy and maintain the regulated rent. Succession rights claims typically involve legal proceedings to determine eligibility and establish the successor&apos;s right to remain in the rental unit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkmwkCxidQzeNwqnSEZHyW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkmwkCxidQzeNwqnSEZHyW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROT1GuNtl9h4QU8jrvAVO9"/>
        <dc:identifier>EQTYA-FUTURE</dc:identifier>
        <dc:identifier>FUTURE</dc:identifier>
        <rdfs:label>Futures - Assets</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Futures - Actifs</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Futures - Assets</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Futures - Vermögenswerte</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Futuros - Activos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Futuros - Activos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Futuros - Ativos</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עתידים - נכסים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भविष्य विवरण - संपत्ति</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">先物 - 資産</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">期货 - 资产</skos:altLabel>
        <skos:definition>Futures are financial contracts obligating the buyer to purchase an asset or the seller to sell an asset and have a predetermined future date and price. A futures contract allows an investor to speculate on the direction of a security, commodity, or a financial instrument.</skos:definition>
        <skos:hiddenLabel>FUTURE</skos:hiddenLabel>
        <skos:prefLabel>Futures</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkoLkee3wjmDwsHW0ENyrT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkoLkee3wjmDwsHW0ENyrT">
