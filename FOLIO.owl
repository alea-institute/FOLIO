        <rdfs:label>Interference with Prospective Economic Advantage</rdfs:label>
        <skos:altLabel xml:lang="de-de">Beeinträchtigung künftiger wirtschaftlicher Vorteile</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interferência com vantagem econômica prospectiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Obstruction de perspectives économiques futures</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">将来の経済的利益の妨害</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">干扰未来经济利益</skos:altLabel>
        <skos:definition>The concept of Interference with Prospective Economic Advantage refers to the intentional or negligent actions of one party that prevent another party from realizing potential economic benefits or advantages that were reasonably expected to occur in the future.</skos:definition>
    </owl:Class>
    


