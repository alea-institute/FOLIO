        <skos:altLabel xml:lang="es-mx">Reclamaciones por discriminación laboral</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de discriminação no emprego</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות על הפרת זכויות עובדים</skos:altLabel>
