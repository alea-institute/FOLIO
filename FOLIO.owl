    <!-- https://folio.openlegalstandard.org/RDB03224BF1b7177ab986d54 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDB03224BF1b7177ab986d54">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0DB70442Cf8b73D9275F14a"/>
        <dc:identifier>US-FD-DOJ-USMS</dc:identifier>
        <rdfs:label>United States Marshals Service</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Service des marshals des États-Unis</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Servicio de Alguaciles de los Estados Unidos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Servicio de Alguaciles de los Estados Unidos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Serviço de Delegados dos Estados Unidos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">United States Marshals Service</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">United States Marshals Service</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שירות מרשלי ארצות הברית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">यूनाइटेड स्टेट्स मार्शल सेवा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アメリカ合衆国保安官局</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">美国司法部警卫局</skos:altLabel>
        <skos:definition>The United States Marshals Service (USMS) is a federal law enforcement agency within the U.S. Department of Justice. It is the oldest American federal law enforcement agency and was created by the Judiciary Act of 1789 during the presidency of George Washington as the Office of the United States Marshal. The USMS as it stands today was established in 1969 to provide guidance and assistance to Marshals throughout the federal judicial districts. USMS is an agency of the United States executive branch reporting to the United States Attorney General, but serves as the enforcement arm of the United States federal courts to ensure the effective operation of the judiciary and integrity of the Constitution.</skos:definition>
        <skos:hiddenLabel>USMS</skos:hiddenLabel>
        <skos:prefLabel>United States Marshals Service</skos:prefLabel>
    </owl:Class>
    


