    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7zm5gZHD2sMJlUNd5mXdN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7zm5gZHD2sMJlUNd5mXdN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBkL8I5saFF7mqpLTI7GxSh"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Legal Assistance Document</rdfs:label>
        <skos:definition>A legal assistance document refers to informational materials designed to guide individuals through legal processes, often without the need for direct representation by a lawyer. Examples include legal self-help guides, online court legal information portals, and standardized forms that provide step-by-step instructions for common legal procedures.</skos:definition>
        <skos:prefLabel>Legal Help Document</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7zmzVgoKNctwopFd7QgvPA -->

