        <rdfs:label>Misappropriation of Likeness</rdfs:label>
        <skos:altLabel>Appropriation of Likeness</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Apropiación indebida de imagen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Apropiación indebida de imagen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Apropriação Indevida de Imagem</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Détournement d&apos;image</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Misappropriation of Likeness</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Veruntreuung von Ähnlichkeit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">התאמת תמונה ללא רשות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">चित्रकार के अनुरूप अपव्यय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">肖像权侵犯</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">肖像権侵害</skos:altLabel>
        <skos:definition>The Misappropriation of Likeness is a legal claim that arises when someone uses another person&apos;s name, image, or likeness without their permission for commercial gain or other benefits.</skos:definition>
    </owl:Class>
    


