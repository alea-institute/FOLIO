        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5412"/>
        <rdfs:label>Accounting, Tax Preparation, Bookkeeping, and Payroll Services Industry</rdfs:label>
        <skos:altLabel>Accounting Services</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Accounting Services Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Buchhaltungsdienstleistungsbranche</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de Servicios de Contabilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de Servicios de Contabilidad</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des services comptables</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de serviços contábeis</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית שירותי חשבונאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लेखा सेवा उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">会計サービス業界</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">会计服务行业</skos:altLabel>
        <skos:definition>This industry group comprises establishments primarily engaged in auditing accounting records; designing accounting systems; preparing financial statements; developing budgets; preparing tax returns; processing payrolls; bookkeeping; and billing.</skos:definition>
        <skos:hiddenLabel>ACCT</skos:hiddenLabel>
    </owl:Class>
    


