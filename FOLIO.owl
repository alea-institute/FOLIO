            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion to Seal</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Versiegelung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Sellado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Seal</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Petición de Sellado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de selagem</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête de scellé</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לחתימה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सील करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">封印申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">封存动议</skos:altLabel>
        <skos:definition>A Motion to Seal is a request made to a court to keep certain information or documents confidential and not available to the public or other parties involved in a legal proceeding.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9c308a4u0CCe3bCKyh96dZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9c308a4u0CCe3bCKyh96dZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7pZSuLowh1QRBeGOhk6zEr"/>
        <rdfs:label>Motion to Extend Time to File Appellant Designation of Reporters Transcript</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlängerung der Frist zur Einreichung des Berufungsentwurfs des Protokolls der Reporter</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para extender el plazo para presentar la designación del informe de los reporteros del apelante</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para extender el plazo para presentar la designación del informe de los reporteros del apelante</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour prolonger le délai de dépôt du projet d&apos;appel de la transcription des reporters</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Extend Time to File Appellant Designation of Reporters Transcript</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para prorrogar o prazo para apresentação do rascunho de apelação da transcrição dos repórteres</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להארכת הזמן להגשת תיעוד של העדות של המתאר המערער</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपीलकर्ता रिपोर्टर्स ट्रांसक्रिप्ट के नामजद फ़ाइल करने के लिए समय बढ़ाने की मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">延长提交上诉记录员记录草案的时间动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴記録者の記録の草案の提出期限延長の動議</skos:altLabel>
        <skos:definition>A Motion to Extend Time to File Appellant Designation of Reporters Transcript is a request made to the appellate court to allow additional time for the appellant to designate the portions of the trial transcript that will be included in the appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk">
