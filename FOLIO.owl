    <!-- https://folio.openlegalstandard.org/Rzqx5UOno00GCvPYpSdWD5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rzqx5UOno00GCvPYpSdWD5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zrphg3yY4ZZzvj2CAu6hN"/>
        <rdfs:label>Contact Short Name</rdfs:label>
        <skos:definition>Contact Short Name refers to an abbreviated or simplified name used to easily identify a person or entity. This shortened name may be used in databases, communications, or reports, and is usually derived from the client&apos;s full legal or DBA name for ease of reference.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RzrvyhxM3e9TKFbTTL2Huh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RzrvyhxM3e9TKFbTTL2Huh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/3.00-Respiratory-Adult.htm#3_14"/>
        <rdfs:label>Respiratory Failure</rdfs:label>
        <skos:altLabel>Prolonged Respiratory Failure</skos:altLabel>
        <skos:definition>Respiratory failure is a serious condition in which the respiratory system fails to adequately exchange oxygen and carbon dioxide, leading to insufficient oxygenation of the blood or inadequate removal of carbon dioxide. This condition, resulting from chronic respiratory disorders, requires invasive mechanical ventilation, noninvasive ventilation with bilevel positive airway pressure (BiPAP), or a combination of both treatments for a continuous period of at least 48 hours, or at least 72 hours if postoperative.</skos:definition>
        <skos:prefLabel>Chronic Respiratory Failure</skos:prefLabel>
    </owl:Class>
    


