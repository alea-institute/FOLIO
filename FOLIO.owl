    <!-- https://folio.openlegalstandard.org/R87EsagydUYKkWMX3oyulrq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R87EsagydUYKkWMX3oyulrq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
