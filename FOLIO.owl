            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Breach of Warranty</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Warranty</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de garantía</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de garantía</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der Gewährleistung</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de garantie</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de garantia</skos:altLabel>
        <skos:altLabel>Warranty Claims</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת אחריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वारंटी का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保証違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保证违约</skos:altLabel>
        <skos:definition>Breach of Warranty refers to a legal claim made by a party against another party for failing to fulfill the terms of a warranty, either express or implied, related to a product or service.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NSOpfI2rIDYuhJrfuca1J -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NSOpfI2rIDYuhJrfuca1J">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RLFy69g18M213jDVncEVvs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Fair Labor Standards Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Fair Labor Standards Act</skos:altLabel>
        <skos:altLabel>FLSA Claim</skos:altLabel>
        <skos:altLabel>Fair Labor Standards Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Fair Labour Standards Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Normas Justas de Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Normas Justas de Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Normas Trabalhistas Justas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur les normes équitables du travail</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק תקנות עבודה הוגנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फेयर लेबर स्टैंडर्ड्स एक्ट का दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公平劳动标准法索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正労働基準法クレーム</skos:altLabel>
        <skos:definition>A Fair Labor Standards Claim is a legal claim made by an employee against an employer for violations of federal labor laws related to minimum wage, overtime pay, and other employment standards.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NSY7xuiRPxwfxpijRhyaF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NSY7xuiRPxwfxpijRhyaF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:label>Tailgating Claim</rdfs:label>
        <skos:altLabel>Close Following Offence Claim</skos:altLabel>
        <skos:altLabel>Unsafe Following Claim</skos:altLabel>
        <skos:definition>A Tailgating Claim involves allegations that a driver has followed another vehicle too closely, violating safe following distance regulations and potentially causing a safety hazard. This type of claim is typically addressed in traffic courts and can lead to penalties, including fines and driving record points, depending on the jurisdiction.</skos:definition>
        <skos:prefLabel>Following Too Closely Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NSnFDAuKIakuxCUbcQ2A2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NSnFDAuKIakuxCUbcQ2A2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Escrow Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de consignation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de depósito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de depósito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de depósito en garantía</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Escrow Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Treuhandsatzung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף אסקרו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एस्क्रो क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エスクロー条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">托管条款</skos:altLabel>
        <skos:definition>An Escrow Clause is a provision in a contract that requires a third party to hold funds or property until certain conditions are met, providing security and assurance to both parties involved in the transaction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NY3RN4HKneok9Io7xvYmb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NY3RN4HKneok9Io7xvYmb">
