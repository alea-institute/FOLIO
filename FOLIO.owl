        <rdfs:label>Apples</rdfs:label>
        <skos:altLabel>Pome Fruit</skos:altLabel>
        <skos:definition>Apples are a type of fruit crop from the Malus domestica tree, known for their crisp texture and sweet to tart flavor. They are consumed fresh, cooked, or processed into products such as juices, ciders, sauces, and baked goods, contributing significantly to human nutrition with their fiber and vitamin content.</skos:definition>
        <skos:prefLabel>Malus Domestica</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCMCLWvGJBZnyYkyK19WvoX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCMCLWvGJBZnyYkyK19WvoX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Relinquishment Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renúncia</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Relinquishment Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzichtsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף נפילה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">त्याग अनुबंध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">放弃条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">放棄条項</skos:altLabel>
        <skos:definition>A relinquishment clause is a provision in a contract that allows one party to give up or surrender their rights or claims to something specified in the agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCMCyg29yJdESbSXnNRLABk -->

