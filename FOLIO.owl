        <rdfs:label>Deceptive Use of Credit-Bureau Name</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Deceptive Use of Credit-Bureau Name</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Täuschende Verwendung des Namens der Kreditauskunftei</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Uso enganoso do nome da agência de crédito</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Uso engañoso del nombre de la agencia de crédito</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Uso engañoso del nombre de la agencia de crédito</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Utilisation trompeuse du nom de l&apos;agence de crédit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שימוש מטעה בשם גוף אשראי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रेडिट-ब्यूरो के नाम का धोखाधड़ी से उपयोग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">信用調査機関名の偽装使用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">欺诈性使用信用局名称</skos:altLabel>
        <skos:definition>The deceptive use of a credit-bureau name refers to the illegal practice of falsely representing oneself as a credit bureau or using a name similar to a credit bureau in order to deceive consumers, which falls under the broader categories of consumer credit and unfair debt collection claims.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROon9w3fWFgCuXMEGnkMzK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROon9w3fWFgCuXMEGnkMzK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
        <rdfs:label>Synthetic Data</rdfs:label>
        <skos:altLabel>Artificial Data</skos:altLabel>
        <skos:altLabel>Computationally Created Data</skos:altLabel>
        <skos:altLabel>Generated Data</skos:altLabel>
        <skos:altLabel>Modeled Data</skos:altLabel>
        <skos:altLabel>Simulated Data</skos:altLabel>
        <skos:definition>Synthetic data is data that is artificially generated by a computational process rather than being collected through sensory means or manually created by humans. It is typically produced by a model trained to replicate the characteristics and structure of its original training data, aiming to maintain a similar  distribution.</skos:definition>
    </owl:Class>
    


