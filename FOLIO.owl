        <rdfs:label>Maine Superior Court</rdfs:label>
        <skos:definition>The Maine Superior Court is a court of general jurisdiction within the Maine State Courts system, with authority to hear civil and criminal cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfQwgEfZY9s4jK5GRXmmzS -->

