        <skos:altLabel xml:lang="fr-fr">Yoruba</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ヨルバ語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">约鲁巴语</skos:altLabel>
        <skos:definition>A language spoken in Nigeria and Benin, belonging to the Niger-Congo language family.</skos:definition>
