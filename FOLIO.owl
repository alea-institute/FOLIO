        <skos:altLabel>Property Law</skos:altLabel>
        <skos:altLabel>Real Property Law</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Real Property Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sachenrecht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק רכוש נדלן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रियल प्रॉपर्टी कानून</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">不动产法</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不動産法</skos:altLabel>
        <skos:definition>Law that governs the various forms of ownership and tenancy in real property.</skos:definition>
        <skos:hiddenLabel>REAL</skos:hiddenLabel>
        <skos:prefLabel>Real Estate Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbAKgnNWH9gfbPfjrq50KO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbAKgnNWH9gfbPfjrq50KO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Union County</rdfs:label>
        <skos:definition>Georgia Superior Court - Union County: A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Union County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbDt5n4osubVafgim4zlMK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbDt5n4osubVafgim4zlMK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Q9CszYRTjTgwQ8JRqVZ0x"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBVQj7fYsBw67yNXs4WI6RX"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Broker-Dealer</rdfs:label>
        <skos:altLabel>Securities Broker</skos:altLabel>
        <skos:altLabel>Securities Firm</skos:altLabel>
        <skos:altLabel>Trading Firm</skos:altLabel>
        <skos:definition>A Broker-Dealer is a financial firm or individual that buys and sells securities on behalf of clients (acting as a broker) or for its own account (acting as a dealer). Broker-dealers are essential in facilitating securities transactions, providing market liquidity, and offering investment advice and services to individual and institutional investors.</skos:definition>
        <skos:example>Goldman Sachs &amp; Co. LLC: An investment bank with broker-dealer operations facilitating securities trading and market making.</skos:example>
        <skos:example>Morgan Stanley &amp; Co. LLC: A global financial services firm offering broker-dealer services among other financial solutions.</skos:example>
        <skos:prefLabel>Market Maker</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbLAS6qswjO9THxoH0fCaU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbLAS6qswjO9THxoH0fCaU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
        <rdfs:label>Ocularist Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle de l&apos;oculiste</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fehlerhafte Augenprothetik</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia profesional del ocularista</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia profesional del ocularista</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência do ocularista</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Ocularist Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שגיאת מקצוע של אוקולריסט</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऑक्युलरिस्ट लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">眼科医の過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">眼科医生过失</skos:altLabel>
        <skos:definition>Negligent or wrongful conduct by an ocularist, such as improper fitting or fabrication of an artificial eye, resulting in harm to the patient, which may give rise to a medical malpractice claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbPkac12BNESLyUsRjPpwv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbPkac12BNESLyUsRjPpwv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDNsW4JqaHcQ9KPtpXLzCPc"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Job Search</rdfs:label>
        <skos:definition>Job search refers to the process of looking for employment opportunities in a specific field or industry. This activity often involves creating a resume, applying for jobs through various channels such as online job boards or company websites, networking, and participating in interviews. It is frequently a requirement for receiving certain types of public benefits, such as unemployment insurance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbPxkhMd0cybxwkTWi9a9z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbPxkhMd0cybxwkTWi9a9z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RE5Fc26D4606fC0Cd7664845"/>
        <rdfs:label>US Chapter 11 - Small Business Debtors</rdfs:label>
        <skos:definition>Chapter 11 of the United States Bankruptcy Code allows small businesses to restructure their debts while continuing operations under court supervision. It provides a mechanism for small businesses to create a repayment plan to satisfy creditors and emerge as a viable entity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbQNmI3UopeglxG3PTOVeS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbQNmI3UopeglxG3PTOVeS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Chumash</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbTsm6UiUkrXtgSq8hGcc5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbTsm6UiUkrXtgSq8hGcc5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Fayette County</rdfs:label>
        <skos:definition>Georgia Superior Court - Fayette County: A court of general jurisdiction in the state of Georgia that has the authority to hear and decide civil and criminal cases within Fayette County.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbYhA2hITtFSxcbyAdWgaC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbYhA2hITtFSxcbyAdWgaC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RyXFkz3behDLKJusiUFxnh"/>
        <rdfs:label>Special Economic Zone</rdfs:label>
        <skos:altLabel>Business-Friendly Regulatory Area</skos:altLabel>
        <skos:altLabel>Investment Promotion Zone</skos:altLabel>
        <skos:altLabel>SEZ</skos:altLabel>
        <skos:definition>A Special Economic Zone (SEZ) is a designated geographic area that is subject to unique economic regulations and policies, distinct from the rest of the geography, to promote foreign investment, economic growth, and job creation. These zones often offer tax incentives, simplified export-import procedures, and other regulatory relaxations to attract businesses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbaJ11MNLGfMNxu3S9zWok -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbaJ11MNLGfMNxu3S9zWok">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSGywkPBv7f2ACrfTSiirV"/>
        <rdfs:label>690 Other Nature of Suit (PACER NoS)</rdfs:label>
        <skos:definition>Action primarily based on Acts or Bills that cannot be classified under any other nature of suit, such as: Endangered Species Act, Federal Hazardous Substance Act 15:1261, Game &amp; Wildlife Act 15:256C et seq. (Penalty), Federal Trade Commission Act 15:41-51 (Penalty), Federal Coal Mine Health &amp; Safety Act 30:801 et seq. (Penalty), Load Line Act 46:85-85G, McGuire Bill (Federal Fair Trade) 15:45L Penalty, Marihuana Tax Act 50 STAT 551, Motorboat Act 46:526-526T, National Traffic &amp; Motor Vehicle Safety Act penalty 49:1655, Veterans&apos; Benefit Act, Title 38 Penalty.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbbFqyJbMrYEkex2BtyZAj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbbFqyJbMrYEkex2BtyZAj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Molalla</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbbUJ2GU3xWVdXFDTfVMPf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbbUJ2GU3xWVdXFDTfVMPf">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBV7sRG5Rn12K0LqLOhxdRz"/>
        <rdfs:label>Women&apos;s Suffrage Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Frauenwahlrecht</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo del sufragio femenino</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo del sufragio femenino</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação do sufrágio feminino</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication du suffrage des femmes</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Women&apos;s Suffrage Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת הזכות לבחירות של הנשים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">महिला सुफ़्रेज़ का दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">女性参政権要求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">妇女选举权要求</skos:altLabel>
        <skos:definition>A Women&apos;s Suffrage claim is a legal assertion that a government has denied or restricted the right to vote to citizens on the basis of sex, effectively providing women the right to vote.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDbbqAnmYyVrvQ9aMcRPc40 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDbbqAnmYyVrvQ9aMcRPc40">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Assumption of Lease Clause</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Assumption of Lease Clause</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Clause de reprise de bail</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Assunção de Locação</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de asunción de arrendamiento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de asunción de arrendamiento</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Übernahme des Mietvertrags</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הנחת השכירות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लीज़ की अधिग्रहण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リース引き継ぎ条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">租赁承接条款</skos:altLabel>
        <skos:definition>An Assumption of Lease Clause is a provision in a contract that obligates a party to take over the rights and obligations of an existing lease agreement.</skos:definition>
    </owl:Class>
    


