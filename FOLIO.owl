        <skos:altLabel xml:lang="en-gb">Mineral Resources Law</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mineralressourcengesetz</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוק משאבי מינרלים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खनिज संसाधन कानून</skos:altLabel>
