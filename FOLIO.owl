        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=513191"/>
        <rdfs:label>Greeting Card Publishers</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in publishing greeting cards. These establishments may publish works in print or electronic form, including exclusively on the Internet.</skos:definition>
    </owl:Class>
    


