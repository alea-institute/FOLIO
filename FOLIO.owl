        <rdfs:label>Outlicense Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de cession de licence</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cesión de licencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de cesión de licencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de licença de saída</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Outlicense Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Outlizenzklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף העברת רישיון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">आउटलाइसेंस क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">アウトライセンス条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">出让许可条款</skos:altLabel>
        <skos:definition>An outlicense clause is a provision in a contract that allows one party to grant a license to use or sell a product or technology to another party outside of the original agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiUJfLkeiXd9F4LLYW8Hiz -->

