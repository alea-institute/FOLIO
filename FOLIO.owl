        <rdfs:label>Corn</rdfs:label>
        <skos:definition>Corn, also known as maize, is a cereal crop belonging to the species Zea mays, widely grown for its edible kernels that are used as food for humans and livestock, and as raw material in industrial products. Known for its versatility, corn is a staple in many diets and a key ingredient in products such as cornmeal, corn syrup, and ethanol.</skos:definition>
        <skos:prefLabel>Maize</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R78P63bt8qx54WQ5xBdBOdm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R78P63bt8qx54WQ5xBdBOdm">
