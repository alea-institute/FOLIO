        <rdfs:label>Arkansas Circuit Court - Union Cty.</rdfs:label>
        <skos:definition>A court located in Union County, Arkansas that has jurisdiction over civil and criminal cases within its designated geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeiGFdK6TTSZb0MaH3Uj3P -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeiGFdK6TTSZb0MaH3Uj3P">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8LxIR1bsgFd3td2G24G3mq"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/REFNhmFYG6yk3W0RPLFV6g"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/10.00-MultipleBody-Adult.htm"/>
        <rdfs:label>Tay-Sachs Disease</rdfs:label>
        <skos:altLabel>GM2 Gangliosidosis Type I</skos:altLabel>
        <skos:altLabel>Hexosaminidase A Deficiency</skos:altLabel>
        <skos:definition>Tay-Sachs disease is a rare, inherited neurodegenerative disorder caused by a deficiency of the enzyme hexosaminidase A. This deficiency leads to the accumulation of GM2 gangliosides, which are toxic to nerve cells.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeiXNGpqL4H3jo1g1NobSm -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeiXNGpqL4H3jo1g1NobSm">
