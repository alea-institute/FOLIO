        <rdfs:label>Khoisan languages</rdfs:label>
        <skos:altLabel xml:lang="de-de">Khoisan-Sprachen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Langues khoïsan</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Línguas khoisan</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コイサン語族</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">科伊桑语系</skos:altLabel>
        <skos:definition>Khoisan languages are a group of languages spoken by the Khoisan people in southern Africa, characterized by the use of click consonants.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Yin9d0YtF1BoKEXRjcCo7 -->

