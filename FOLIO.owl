        <rdfs:label>Wrongful Death Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch auf Schadensersatz bei Todesfällen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por muerte injusta</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo por muerte injusta</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de morte injusta</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation pour décès injuste</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wrongful Death Claim</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על מוות לא חוקי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गलत मौत दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不当死亡請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非正当死亡索赔</skos:altLabel>
        <skos:definition>A wrongful death claim is a legal action brought by the survivors of a deceased person against the party responsible for the death, seeking compensation for damages resulting from the loss of the individual&apos;s life.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R3whmOrApEu7NZS1v3HEki -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R3whmOrApEu7NZS1v3HEki">
