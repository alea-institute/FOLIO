        <rdfs:label>Helsinki Stock Exchange</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCXw2fA0rxsKWlnKljAIRMB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCXw2fA0rxsKWlnKljAIRMB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ROaRQTFgM9oWtVX4k6v6I"/>
        <rdfs:label>Transportation Accessibility Claim</rdfs:label>
        <skos:definition>A claim of this type arises when transportation services, whether public or private, are not accessible to individuals with disabilities. This can range from buses not having accessible ramps to airports not providing appropriate assistance for passengers with mobility challenges.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCY2rPRVd5uyRkzjCbgXYoR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCY2rPRVd5uyRkzjCbgXYoR">
