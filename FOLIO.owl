        <skos:altLabel xml:lang="pt-br">Pedido de Exclusão</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לאפשור הוצאה לפועל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निष्कासन याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">除外申立</skos:altLabel>
        <skos:definition>A Motion to Exclude is a legal request made by a party in a trial to prevent certain evidence, documents, reports, witnesses, or testimony from being presented or considered by the court.</skos:definition>
    </owl:Class>
    


