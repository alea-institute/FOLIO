        <skos:altLabel xml:lang="zh-cn">不可抗力</skos:altLabel>
        <skos:definition>An unforeseeable and uncontrollable event that prevents a party from fulfilling their contractual obligations, and may excuse them from liability for breach of contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCp7CWkln0LsVi6oRkR2MY5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCp7CWkln0LsVi6oRkR2MY5">
