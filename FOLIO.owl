        <skos:altLabel xml:lang="es-es">Aviso de presentación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Aviso de presentación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hinterlegungsanzeige</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Notice of Lodging</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הודעת הגשה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लॉजिंग की सूचना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">存放通知</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">預託通知書</skos:altLabel>
        <skos:definition>Notice of filing physical items (e.g., thumb drives, videotapes) with the court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCssZ0eE4LoAphnQlNXXQo4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCssZ0eE4LoAphnQlNXXQo4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV"/>
        <rdfs:label>Natural Resources Extraction Real Estate Asset</rdfs:label>
        <skos:definition>A natural resources extraction real estate asset refers to a property that contains or is believed to contain natural resources such as minerals, oil, gas, or timber, which can be extracted for economic value. This asset is significant in the realms of property law, environmental law, and resource management, as it encompasses the rights and regulations related to the extraction and use of these resources.</skos:definition>
        <skos:prefLabel>Extractive Industries Land</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCsvCP3AkYwAzs61PUwCYW6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCsvCP3AkYwAzs61PUwCYW6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq"/>
        <rdfs:label>Interstitial Lung Disease</rdfs:label>
        <skos:definition>Interstitial lung disease (ILD) refers to a group of disorders characterized by inflammation and scarring of the interstitium (the tissue and space around the air sacs) in the lungs. This group of diseases leads to progressive lung damage, impaired gas exchange, and respiratory symptoms such as cough and shortness of breath.</skos:definition>
    </owl:Class>
    


