        <rdfs:label>Contact Job Title</rdfs:label>
        <skos:definition>Contact Job Title refers to the official designation or position held by an individual who serves as a point of contact for a business or organization. This title provides context for the individual&apos;s role and responsibilities, and is often included in professional communications and documentation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsZqYmFpa29ujUnSiVifIp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsZqYmFpa29ujUnSiVifIp">
