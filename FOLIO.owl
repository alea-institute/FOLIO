        <skos:altLabel xml:lang="es-es">Petición de rescate</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Resgate</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en rachat</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה לגאול</skos:altLabel>
