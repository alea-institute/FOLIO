        <skos:altLabel xml:lang="he-il">סוכן אסקרו מפזר כספים באופן לא תקין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एस्क्रो एजेंट धन गलत तरीके से वितरित कर रहा है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">エスクローエージェントが不適切に資金を支払う</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">托管代理人不当支配资金</skos:altLabel>
        <skos:definition>The improper release of funds by an escrow agent, who is responsible for holding and distributing funds in a legal matter, resulting in potential liability for the agent.</skos:definition>
    </owl:Class>
    


