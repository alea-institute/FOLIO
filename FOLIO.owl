        <dc:identifier>US-FD-DOL-OALJ</dc:identifier>
        <rdfs:label>Office of Administrative Law Judges</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Bureau des juges administratifs</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Büro der Verwaltungsrichter</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Escritório de Juízes Administrativos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Office of Administrative Law Judges</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina de Jueces de Derecho Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oficina de Jueces de Derecho Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">משרד שופטי דין מנהלי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रशासनिक कानून न्यायाधीशों का कार्यालय</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">行政法官办公室</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">行政裁判官事務所</skos:altLabel>
        <skos:definition>The Office of Administrative Law Judges conducts rulemaking and adjudicatory hearings throughout the United States in proceedings subject to the Administrative Procedure Act. Approximately 50 statutes administered by agencies within the Department of Agriculture require APA hearings. The Judges issue initial decisions and orders in adjudicatory proceedings, approve of consent decisions entered into by parties, and decide appeals of debarments and suspensions.</skos:definition>
        <skos:hiddenLabel>OALJ</skos:hiddenLabel>
        <skos:prefLabel>Office of Administrative Law Judges</skos:prefLabel>
    </owl:Class>
    


