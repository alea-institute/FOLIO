        <rdfs:label>Orutsararmiut Traditional Native Council</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NaWaVnkBqgo4SQa0idAnx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8NaWaVnkBqgo4SQa0idAnx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCGW5RFfjJ95ygeSCJLaJQT"/>
        <rdfs:label>Apparent Authority</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Apparent Authority</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Autoridad aparente</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Autoridad aparente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Autoridade aparente</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Pouvoir apparent</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Scheinbare Vollmacht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">רשות נראית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रतीत प्राधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">明白な権限</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">表见授权</skos:altLabel>
        <skos:definition>The concept of Apparent Authority refers to the legal principle that holds a principal liable for the actions of an agent who appears to have the authority to act on their behalf, even if the agent does not actually have such authority.</skos:definition>
    </owl:Class>
    


