                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Superseding Intervening Cause</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Causa Interveniente Suplantadora</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Causa Interviniente Sustitutiva</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Causa Interviniente Sustitutiva</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Cause intermédiaire supplantée</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Superseding Intervening Cause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Übergeordneter Eingriffsgrund</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גורם מתערב חלופי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सुपरसीडिंग अंतर्वर्ती कारण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">代替干预原因</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">優先介入原因</skos:altLabel>
        <skos:definition>An intervening cause that breaks the chain of causation and relieves the defendant of liability, but only if it is unforeseeable and supersedes the defendant&apos;s original act or omission.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBwMhlMYnN7SRBNxJwAJ9SF -->

