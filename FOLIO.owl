        <rdfs:label>Motion to Stay Proceedings Pending Settlement</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Aussetzung des Verfahrens bis zur Beilegung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Suspensión del Procedimiento Pendiente de Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Suspensión del Procedimiento Pendiente de Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Stay Proceedings Pending Settlement</skos:altLabel>
