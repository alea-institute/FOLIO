        <rdfs:label>Missouri Circuit Court - Pike County</rdfs:label>
        <skos:definition>Missouri Circuit Court - Pike County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Pike County, Missouri.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCUj7BUa4TPnpoDUQLK1VZO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCUj7BUa4TPnpoDUQLK1VZO">
