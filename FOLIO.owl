        <skos:altLabel xml:lang="fr-fr">Parjure</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Perjurio</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Perjury</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Perjúrio</skos:altLabel>
