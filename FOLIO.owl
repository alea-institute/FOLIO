        <rdfs:label>Motion for New Trial - Procedural Error</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Neues Verfahren - Verfahrensfehler</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de nuevo juicio - Error procesal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de nuevo juicio - Error procesal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for New Trial - Procedural Error</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour un nouveau procès - Erreur de procédure</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de novo julgamento - Erro processual</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה חדשה לניסיון - שגיאה תהליכית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नई याचिका - प्रक्रियात्मक त्रुटि के लिए</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">新しい裁判のための動議 - 手続き上の誤り</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">新审判动议 - 程序错误</skos:altLabel>
        <skos:definition>A Motion for New Trial based on Procedural Error is a request made by a party to a lawsuit asking the court to set aside the previous trial&apos;s verdict and order a new trial due to errors in the legal procedures followed during the original trial.</skos:definition>
    </owl:Class>
    


