        <rdfs:label>Discharge for Refusing to Commit Illegal Act</rdfs:label>
        <skos:altLabel xml:lang="es-es">Despido por negarse a cometer un acto ilegal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Despido por negarse a cometer un acto ilegal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Discharge for Refusing to Commit Illegal Act</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dispensa por recusa em cometer ato ilegal</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Entlassung wegen Weigerung, eine illegale Handlung zu begehen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Licenciement pour refus de commettre un acte illégal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים עבור סירוב לבצע פעולה לא חוקית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवैतनिक कार्य करने से इनकार करने के लिए निष्कासित</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">因拒绝犯罪行为而被解雇</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">違法行為を拒否したための解雇</skos:altLabel>
        <skos:definition>An employee&apos;s termination from their job due to their refusal to engage in illegal activities requested by their employer.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RotXFxpj8usoe4w5Ir87R -->

