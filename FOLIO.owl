        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9nKffsUrlMdYIg9r9KAHcu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Judgment As a Matter of Law</rdfs:label>
        <skos:altLabel xml:lang="es-es">Fallo como Cuestión de Derecho</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fallo como Cuestión de Derecho</skos:altLabel>
        <skos:altLabel>JAML</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Judgment As a Matter of Law</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Jugement en tant que question de droit</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Julgamento como questão de direito</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Urteil als Rechtsfrage</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פסק דין כנושא של חוק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानून के रूप में फैसला</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律问题的判决</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法的問題としての判決</skos:altLabel>
        <skos:definition>Judgment As a Matter of Law (JAML) is a legal decision made by a judge based on the evidence presented in a case, rather than being left to the jury to decide.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9nMt6HkjdNxIGBpR7EDpTL -->

