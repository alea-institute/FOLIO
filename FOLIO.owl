        <skos:altLabel xml:lang="de-de">Zentrum für Verbraucherinformationen und Versicherungsaufsicht</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מרכז למידע ופיקוח על ביטוח לצרכנים</skos:altLabel>
