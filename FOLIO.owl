    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsPz5V4eHK4ktNBSAAf6V6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsPz5V4eHK4ktNBSAAf6V6">
