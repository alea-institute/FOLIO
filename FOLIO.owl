    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiVfYrNwYdmawA7b4v9WKg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiVfYrNwYdmawA7b4v9WKg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:label>Receiver</rdfs:label>
        <skos:altLabel xml:lang="de-de">Empfänger</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Receiver</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Receptor</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Receptor</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Receptor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Récepteur</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מקבל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्राप्तकर्ता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">レシーバー</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">接收器</skos:altLabel>
        <skos:definition>A neutral person (often a professional trustee) appointed by a judge to take charge of the property and business of one of the parties to a lawsuit and receive his/her rents and profits while the right to the moneys has not been finally decided.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDiYVKMDZiMUiO6XVCIdr7a -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDiYVKMDZiMUiO6XVCIdr7a">
