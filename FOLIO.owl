        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Cross-Designation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Cross-Designation</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cruzamiento de designación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cruzamiento de designación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Designação cruzada</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Désignation croisée</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kreuzbezeichnung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ציווי חציון</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रॉस-डिज़ाइनेशन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クロス指定</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">交叉指定</skos:altLabel>
        <skos:definition>Cross-Designation refers to the act of designating a party or a document in a legal case with a different name or title than originally given, and it falls under the category of Appellate Filings - Correspondence and Forms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeYuXiU2d2WV3BlrRtfxcn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCeYuXiU2d2WV3BlrRtfxcn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Yn0rpoHNTFiymo0I8CAVf"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Somatic Symptom Disorder</rdfs:label>
        <skos:altLabel>Somatic Disorder</skos:altLabel>
        <skos:altLabel>Somatoform Disorder</skos:altLabel>
        <skos:definition>Somatic Symptom Disorder is characterized by one or more physical symptoms that cause significant distress or impairment in daily functioning, with excessive thoughts, feelings, or behaviors related to the symptoms. The physical symptoms cannot be fully explained by a medical condition, substance use, or another mental disorder.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCeZAhlt48BDPGyJqTt5SrX -->

