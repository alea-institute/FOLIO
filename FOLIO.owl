        <rdfs:label>New York City Court - Troy</rdfs:label>
        <skos:definition>A court located in Troy, New York that operates under the jurisdiction of the New York City Court system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHOpIXbHYvOI5B7MOTVQH5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHOpIXbHYvOI5B7MOTVQH5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9bDj9fP4dwi812AMzfxj9Z"/>
        <rdfs:label>Motion to Transfer Venue for Convenience</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verlegung des Gerichtsstands aus Gründen der Bequemlichkeit</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Transferir el Lugar del Juicio por Conveniencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Transferir el Lugar del Juicio por Conveniencia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour transfert de juridiction pour convenance</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Transfer Venue for Convenience</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Transferência de Foro por Conveniência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להעברת מקום דיון לצורך נוחות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सुविधा के लिए स्थानांतरण के लिए मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">便利起见的转移管辖权动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">便宜のための管轄権移転請求</skos:altLabel>
        <skos:definition>A Motion to Transfer Venue for Convenience is a legal request to move a case from one court to another based on the convenience of the parties or witnesses involved, rather than the location of the incident or the jurisdiction of the court.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHQU61QnQdh5rS6gNc4tsi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHQU61QnQdh5rS6gNc4tsi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
        <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
        <rdfs:label>Business Operations Risk</rdfs:label>
        <skos:definition>Business Operations Risk refers to the potential for losses or disruptions that may occur in a company&apos;s daily activities, processes, or systems. These risks can stem from various sources, such as technology failures, human errors, or supply chain disruptions, ultimately impacting the organization&apos;s overall performance and profitability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCHQliBWOr7kTnOfaU1hw0h -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCHQliBWOr7kTnOfaU1hw0h">
