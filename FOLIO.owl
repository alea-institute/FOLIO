        <skos:altLabel xml:lang="zh-cn">性能保证条款</skos:altLabel>
        <skos:definition>A Performance Warranty Clause is a type of Warranty Clause that guarantees the quality and functionality of a product or service for a specific period of time.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXIwuCHiebiYnRNELoWlw0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXIwuCHiebiYnRNELoWlw0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQ69YOKe39BaW5qr4XUjYo"/>
        <rdfs:label>By Portfolio</rdfs:label>
        <skos:altLabel xml:lang="en-gb">By Portfolio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nach Portfolio</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Par portefeuille</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Por cartera</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Por portafolio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Por portfólio</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לפי תיק השקעות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पोर्टफोलियो द्वारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ポートフォリオ別</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">按投资组合</skos:altLabel>
        <skos:definition>Engagement fee model where a client pays a predetermined fee for legal services that cover two or more matters (i.e., a portfolio of matters).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXL5NHWRqvuvmX1QtleDS9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXL5NHWRqvuvmX1QtleDS9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ddsah86bL3tQ5OmO9B7PB"/>
        <rdfs:label>Subordination Agreement</rdfs:label>
        <skos:definition>A &quot;Subordination Agreement&quot; is a contractual arrangement where a creditor agrees to rank its claim on a debtor&apos;s assets below the claims of one or more other creditors. This legal document outlines the conditions and circumstances under which the subordinated creditor will be repaid, typically in the event of a liquidation, default, or insolvency of the debtor.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXL6jE97xf2iDoGwngUejw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXL6jE97xf2iDoGwngUejw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCtUZjZqZ1lszDFiDOLUuTh"/>
        <rdfs:label>Illinois Circuit Court - Mercer County (14th Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXLxktY5N0q3aCYxxk3TGA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXLxktY5N0q3aCYxxk3TGA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7zvYKadqTXgMZV8ghLsloR"/>
        <rdfs:label>Request</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anfrage</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Petición</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Request</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अनुरोध</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リクエスト</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">请求</skos:altLabel>
        <skos:definition>A request is a type of trial court practice document that is filed with the court to ask for a specific action or relief.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXMxIaY6np2I0j3UqtOeK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXMxIaY6np2I0j3UqtOeK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4kWkG9m4DarQ45A7wBpJQ"/>
        <rdfs:label>Ballistics Evidence</rdfs:label>
        <skos:definition>Ballistics evidence refers to the study and analysis of firearms, bullets, and the patterns of damage they cause, particularly when a weapon is discharged. It is used in criminal investigations to link projectiles and casings found at a crime scene to a specific weapon or to determine other details of a shooting incident, such as the trajectory or distance from which a shot was fired. Expert ballisticians can match unique markings on a bullet or casing to the specific firearm that fired it, providing critical evidence in firearm-related cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXOUUDPfzuxRdZOd1kgJEZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXOUUDPfzuxRdZOd1kgJEZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8XAQoyqCZvUawGZUsBxFOG"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R01E1a02E74a0235f7022f40"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R5DE425E15b8c8CE8fb6Eecf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R765fdd1D03d3269330E964e"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.dol.gov/general/aboutdol/majorlaws"/>
        <rdfs:label>Occupational Safety and Health Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Arbeitsschutzgesetz</skos:altLabel>
        <skos:altLabel>OSH Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Occupational Safety and Health Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Seguridad y Salud Ocupacional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Seguridad y Salud en el Trabajo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reclamação da Lei de Segurança e Saúde Ocupacional</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la sécurité et la santé au travail</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק הבריאות והבטיחות המקצועית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यवसायिक सुरक्षा और स्वास्थ्य अधिनियम दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">労働安全衛生法クレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">职业安全与健康法索赔</skos:altLabel>
        <skos:definition>An Occupational Safety and Health Act (OSHA) claim is a legal action initiated by an employee or group of employees against an employer, alleging that the employer has violated safety and health regulations, failed to maintain a safe work environment, or retaliated against employees for reporting safety concerns or exercising their rights under the OSHA. The OSHA is a federal law enacted in 1970 to ensure safe and healthy working conditions for employees in the United States by setting and enforcing safety standards and regulations. Employers have a general duty under the OSH Act to provide their employees with work and a workplace free from recognized, serious hazards.</skos:definition>
        <skos:prefLabel>OSHA Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXOgy9uSGpY2aX5Ot8Kwip -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXOgy9uSGpY2aX5Ot8Kwip">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8AoCbH9WBp8yoMXj21haD4"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBeZkopwGsxt3K5BXOgNBNF"/>
        <rdfs:label>Noise Violation Claim</rdfs:label>
        <skos:altLabel>Noise Pollution Offence Claim</skos:altLabel>
        <skos:altLabel>Sound Level Violation Claim</skos:altLabel>
        <skos:definition>A Noise Violation Claim involves allegations that an individual or entity has exceeded legally established noise levels, leading to disruptions or disturbances in residential, commercial, or public areas. These claims are handled through administrative or legal proceedings and can result in fines, orders to cease the noise, or other corrective actions.</skos:definition>
        <skos:prefLabel>Excessive Noise Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXSNwXQHNppuziZkXfxrtd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXSNwXQHNppuziZkXfxrtd">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDE27640D20253AD6e26B78e"/>
        <rdfs:label>New Hampshire Supreme Court</rdfs:label>
        <skos:definition>The New Hampshire Supreme Court is the highest court in the state of New Hampshire and serves as the final court of appeal for all legal cases within the state&apos;s jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXUO9viUhUieZENrWoIbk9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXUO9viUhUieZENrWoIbk9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R06956a0657387D6513A8528"/>
        <rdfs:label>New York Supreme Court - Oneida County</rdfs:label>
        <skos:definition>The New York Supreme Court - Oneida County is a court of general jurisdiction located in Oneida County, New York, with authority to hear and decide a wide range of legal disputes within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXUc6YCuUilVK4rdtFxHOa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXUc6YCuUilVK4rdtFxHOa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QcJpEJ19eAN8glCzxd4Wo"/>
        <rdfs:label>Spend Management</rdfs:label>
        <skos:definition>Spend Management refers to the process of controlling and optimizing the expenses incurred by an organization, typically through the use of technology and data analysis.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXVQ8cnzCJi3hsyglfDHKz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXVQ8cnzCJi3hsyglfDHKz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7aSm1AVSKBVx8el1HZUrxw"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCi7RfKkkmw6lGMEMbhezRG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
        <rdfs:label>Conflict of Interest Risk</rdfs:label>
        <skos:definition>Conflict of Interest Risk refers to the potential for ethical, legal, or reputational issues arising when an individual&apos;s personal interests, relationships, or obligations compromise their ability to make impartial decisions on behalf of their organization or role. These conflicts can lead to biased decision-making, decreased trust, or even regulatory penalties, ultimately impacting the organization&apos;s integrity and performance</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXVU4vw8lOn8Q1MVwyiBuM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXVU4vw8lOn8Q1MVwyiBuM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Runaway</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ausreißer</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fugitivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fugitivo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fugitivo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fugueur</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Runaway</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ברחן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भगोड़ा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">家出少年</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">逃跑者</skos:altLabel>
        <skos:definition>A person under 18 years of age who has left home without permission of his/her parent(s) or legal guardian</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXYIdMeIpqr2E0zR4TUIqi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXYIdMeIpqr2E0zR4TUIqi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>Change in Law Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cambio en el lenguaje de la ley</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cambio en el lenguaje de la ley</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Change in Law Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Changement de la langue de la loi</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Mudança na linguagem da lei</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Änderung der Gesetzessprache</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שינוי בשפת החוק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कानून भाषा में बदलाव</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法律言語の変更</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法律语言变更</skos:altLabel>
        <skos:definition>A change in law language refers to a provision in a legal agreement that outlines the impact of any modifications or alterations made to existing laws on the agreement, specifically within the context of carveouts related to material adverse effect (MAE) definitions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXYWRRfVqe7EHO86IeXrcR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXYWRRfVqe7EHO86IeXrcR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8zxICG1ccCZO0nNV776P8B"/>
        <rdfs:label>Stipulation to Appoint Resolution Advocate</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estipulación para nombrar un defensor de resolución</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estipulación para nombrar un defensor de resolución</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Estipulação para nomeação de advogado de resolução</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Stipulation de nomination d&apos;un avocat de résolution</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stipulation to Appoint Resolution Advocate</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vereinbarung zur Ernennung eines Schlichtungsbeauftragten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם למינוי עוזר פועל לפתרון סכסוך</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संकल्प नियुक्ति संरक्षण प्रवक्ता के नामने के लिए</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">任命解决倡导者的规定</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">解決支援者の任命に関する規定</skos:altLabel>
        <skos:definition>A Stipulation to Appoint Resolution Advocate is a legal agreement between parties in a dispute, where they agree to appoint a neutral third party to help resolve the dispute.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXa7Zas4KaZjtUpwq0RHxv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXa7Zas4KaZjtUpwq0RHxv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
        <rdfs:label>Natural Law System</rdfs:label>
        <skos:altLabel>Jus Naturale</skos:altLabel>
        <skos:altLabel>Law of Nature</skos:altLabel>
        <skos:altLabel>Natural Law Theory</skos:altLabel>
        <skos:definition>The Natural Law System is a legal philosophy asserting that laws are derived from a set of inherent moral principles and universal truths that govern human behavior, existing independently of human-made laws. It posits that these principles are discoverable through reason and are inherent to human nature, providing a basis for evaluating and guiding positive law.</skos:definition>
        <skos:example>Human Rights Charters often draw on principles from the Natural Law System, asserting rights that transcend national legal systems.</skos:example>
        <skos:example>The abolition of apartheid in South Africa was partly justified by appeals to the universal moral principles of the Natural Law System.</skos:example>
        <skos:prefLabel>Universal Moral Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXe7jvdOMHWIvT93GSGUk0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXe7jvdOMHWIvT93GSGUk0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVG1zLys64KOCQFR2MhzS7"/>
        <rdfs:label>European Commission</rdfs:label>
        <skos:altLabel>Commission of the European Union</skos:altLabel>
        <skos:definition>The European Commission is the executive branch of the European Union, responsible for proposing legislation, implementing decisions, and managing the day-to-day operations of the EU. It represents the interests of the EU as a whole, rather than individual member states.</skos:definition>
        <skos:prefLabel>EU Commission</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXeFnOtcGD1SnlKcTDDOAx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXeFnOtcGD1SnlKcTDDOAx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCua1MtzwNcjfYov8VFcoV3"/>
        <dc:source rdf:resource="https://en.wikipedia.org/wiki/Special-purpose_entity"/>
        <dc:source rdf:resource="https://www.centralbank.ie/consumer-hub/explainers/what-is-a-special-purpose-entity#:~:text=A%20Special%20Purpose%20Entity%20(SPE,other%20entities%20or%20investor(s)"/>
        <rdfs:label>Special Purpose Entity</rdfs:label>
        <skos:altLabel>Financial Vehicle Corporation</skos:altLabel>
        <skos:altLabel>SPE</skos:altLabel>
        <skos:altLabel>SPV</skos:altLabel>
        <skos:definition>A Special Purpose Entity (SPE) is a legal entity created for a specific, limited purpose, particularly in financial transactions. This entity is often used to isolate financial risk by legally segregating certain activities, assets, or investments from the main organization, thereby facilitating transaction security and credit enhancement.</skos:definition>
        <skos:prefLabel>Special Purpose Vehicle</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXkndIfbrsY00eledcb9p4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXkndIfbrsY00eledcb9p4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Modoc</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXlENNMqPqLLWMb9ubdsod -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXlENNMqPqLLWMb9ubdsod">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>Pandemic or Other Public Health Event Language</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Langage de pandémie ou d&apos;autres événements de santé publique</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lenguaje de pandemia u otros eventos de salud pública</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lenguaje de pandemia u otros eventos de salud pública</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Linguagem de pandemia ou outros eventos de saúde pública</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Pandemic or Other Public Health Event Language</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Sprache zu Pandemien oder anderen öffentlichen Gesundheitsereignissen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שפת מגפה או אירועי בריאות ציבורית אחרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">महामारी या अन्य सार्वजनिक स्वास्थ्य घटना भाषा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">パンデミックまたはその他の公衆衛生イベント言語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">大流行或其他公共卫生事件语言</skos:altLabel>
        <skos:definition>Language included in a contract that defines the impact of a pandemic or other public health event on the material adverse effect (MAE) clause, which outlines exceptions to the clause in the event of certain circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXlobBYNwoSXUUh9hyG7YU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXlobBYNwoSXUUh9hyG7YU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R72p6HAKCuvyIWvgxuoCM9R"/>
        <rdfs:label>Individual Contributor</rdfs:label>
        <skos:definition>An Individual Contributor is an employee who specializes in performing specific tasks or roles within an organization but does not have managerial responsibilities over a team. Individual Contributors focus on executing their specialized skill sets and are evaluated based on their own performance rather than the performance of a group.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXlyRlyC23XqOQQkufi4ag -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXlyRlyC23XqOQQkufi4ag">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9DXiBqsNgLGb4GIKF77xx9"/>
        <rdfs:label>864 SSID Title XVI (PACER NoS)</rdfs:label>
        <skos:definition>Action filed with regard to social security benefits provided to Supplemental Security Income Disability under Title XVI</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Tktpdf3HuYd3nI7nf9xQU"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCSG4k3ah1Pu5YgPexPgOmL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Health-Conscious Market Segment</rdfs:label>
        <skos:definition>The health-conscious segment refers to a portion of the market that is characterized by consumers who prioritize health and wellness in their purchasing decisions. This segment includes products and services that are designed to promote physical, mental, and emotional well-being, catering to individuals who seek a healthy lifestyle.</skos:definition>
        <skos:example>Health Supplements</skos:example>
        <skos:example>Organic Foods</skos:example>
        <skos:example>Preventive Healthcare Products</skos:example>
        <skos:prefLabel>Wellness Segment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXozjgPVMyJbstz1YtUOAu -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXozjgPVMyJbstz1YtUOAu">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_17"/>
        <rdfs:label>Small Intestine Cancer</rdfs:label>
        <skos:altLabel>Small Bowel Cancer</skos:altLabel>
        <skos:altLabel>Small Intestinal Carcinoma</skos:altLabel>
        <skos:altLabel>Small Intestinal Malignancy</skos:altLabel>
        <skos:definition>Small intestine cancer is a malignant neoplasm originating in the small intestine, which includes the duodenum, jejunum, and ileum. This type of cancer can cause symptoms such as abdominal pain, weight loss, and bowel obstruction and may include various subtypes such as adenocarcinoma, carcinoid tumors, and gastrointestinal stromal tumors (GISTs).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXpZKEtUb90P79zVvnHHsH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXpZKEtUb90P79zVvnHHsH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqHLQbqYW16CtZ6TSKOZPz"/>
        <rdfs:label>Death on High Seas Act Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über Todesfälle auf hoher See</skos:altLabel>
        <skos:altLabel>DOHSA Claim</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Death on High Seas Act Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por el Acta de Muerte en Alta Mar</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por la Ley de Muerte en Alta Mar</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de acordo com a Lei de Mortes no Alto Mar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur les décès en haute mer</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על פי חוק מוות בים גבוה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ऊंची समुद्र में मृत्यु अधिनियम दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">高海上死亡法に基づく請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">高海上死亡法案索赔</skos:altLabel>
        <skos:definition>The Death on High Seas Act (DOHSA) is a legal concept that falls under the categories of Statutory and Regulatory Claims, as well as Admiralty and Maritime Claims. It provides a framework for compensation in cases of death that occur on the high seas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXrokRoNHSUbxowFTkMH9p -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXrokRoNHSUbxowFTkMH9p">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCnCHWsREqpfQAAfaN2lRPV"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <rdfs:label>Schizoid Personality Disorder</rdfs:label>
        <skos:definition>Schizoid Personality Disorder is characterized by a pervasive pattern of detachment from social relationships and a restricted range of emotional expression. Individuals with this disorder often appear aloof, indifferent, and emotionally cold, and they typically have a limited desire for social interactions or engagement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXuNdDDsjEhgwsBBejAjWB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXuNdDDsjEhgwsBBejAjWB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R81q0MYebZZv26XtzcIvVJ5"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>In-home Supportive Service Disability Benefit</rdfs:label>
        <skos:definition>In-home supportive service disability benefit is a specific type of public assistance program designed to help individuals with disabilities receive essential care and services within their own homes rather than in institutional settings. These benefits can cover a range of services including personal care, meal preparation, and medical monitoring, and aim to enhance the quality of life for disabled individuals by enabling them to live more independently.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBXvJDVALlJ0Uzr6YqyOuT0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBXvJDVALlJ0Uzr6YqyOuT0">
