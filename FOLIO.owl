        <skos:altLabel xml:lang="fr-fr">Montant de la remise - Dépense</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Monto de descuento - Gasto</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Rabattbetrag - Aufwand</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Valor do desconto - Despesa</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סכום הנחה - הוצאה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">डिस्काउंट राशि - व्यय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">割引額 - 費用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">折扣金额 - 费用</skos:altLabel>
        <skos:definition>Discount Amount - Expense refers to the reduction in cost incurred by a client for expenses related to legal services provided, as opposed to fees charged for the services themselves.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNSwAshjiwHs39Hzl7nSk5 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNSwAshjiwHs39Hzl7nSk5">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSK8CbOPdmMwMyMIlw8pdO"/>
        <rdfs:label>New Mexico Magistrate Court - Harding County</rdfs:label>
        <skos:definition>A court located in Harding County, New Mexico that has limited jurisdiction over certain types of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNTEwOnsaiI3lR6MvF87G1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNTEwOnsaiI3lR6MvF87G1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Public Benefit Coverage Objective</rdfs:label>
        <skos:definition>Public Benefit Coverage Objective refers to the goal of a legal service provider in determining client eligibility for public benefits. This can encompass various types of assistance including cash or food benefits, as well as specific healthcare services (e.g., birth control, dental care, prescriptions, optical services).</skos:definition>
        <skos:prefLabel>Public Benefit Eligibility Objective</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNTYkBVeXztmcHkabwEWse -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNTYkBVeXztmcHkabwEWse">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Visa for Temporary Agricultural Workers</rdfs:label>
        <skos:altLabel xml:lang="en-us">H-2A Visa</skos:altLabel>
        <skos:altLabel>Seasonal Agricultural Worker Visa</skos:altLabel>
        <skos:definition>A Temporary Agricultural Workers Visa is a type of visa designed to allow foreign nationals to work temporarily in the agricultural sector of a host country. These visas are typically issued to address seasonal labor needs, such as planting, harvesting, or other farm-related activities that require a temporary influx of workers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNUBxUepOEIOvagLHcD3N0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNUBxUepOEIOvagLHcD3N0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:label>Extraordinary Ability Non-Immigrant Visa Types</rdfs:label>
        <skos:definition>An O visa is issued to foreign nationals with extraordinary ability in the sciences, arts, education, business, or athletics, allowing them to enter the U.S. to continue work in their field. This visa category includes O-1 for individuals with extraordinary ability, O-2 for essential support personnel, and O-3 for their immediate family members.</skos:definition>
        <skos:prefLabel>O Visa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNUGmrpcfQUKZlrclalY1YQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNUGmrpcfQUKZlrclalY1YQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R_SzQ5B5tSJymAiew37taiw"/>
        <rdfs:label>WC120 Analysis/Strategy</rdfs:label>
        <skos:definition>Thinking, Strategizing, and Planning for a case, including preparing for/attending initial strategy conference with adjuster/employer/ nurse case manager, discussions/writing /meetings on case strategy, preparation of litigation plan &amp; updates, communication on case strategy/trial strategy with adjuster/ employer/nurse case manager</skos:definition>
        <skos:prefLabel>WC120 Analysis/Strategy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNUWCvAay3JJ2Jtnrxx8cX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNUWCvAay3JJ2Jtnrxx8cX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70IGZ5XRTshj1E64tVcxJD"/>
        <rdfs:label>Pennsylvania Magisterial District Court - Lycoming County</rdfs:label>
        <skos:definition>A Pennsylvania Magisterial District Court in Lycoming County is a specific court within the Pennsylvania Magisterial District Court system that handles minor criminal offenses, traffic violations, and civil cases involving amounts up to $12,000.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNUiEzpRIjQmJpv69ijYuE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNUiEzpRIjQmJpv69ijYuE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7gzXxHYGOLSEudb6n1QFWm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Redemption Claim</rdfs:label>
        <skos:definition>A redemption claim is a legal action in which a party seeks to regain ownership or rights to property that has been foreclosed upon or sold due to nonpayment of a debt or other financial obligations. In some cases, property owners or debtors have the opportunity to &quot;redeem&quot; their property by paying off the outstanding debt, including associated costs and fees, within a specified period defined by law. Redemption claims can be part of the foreclosure process, allowing individuals or entities to reclaim their property under certain conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNVlq2ReYjeb3r8UkUYvso -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNVlq2ReYjeb3r8UkUYvso">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RiuB3WjtPaioVphDpqLzVK"/>
        <rdfs:label>Proposed Findings of Fact</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Achados de Fato Propostos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Conclusiones propuestas de hecho</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Constatations de fait proposées</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Hallazgos de hecho propuestos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Proposed Findings of Fact</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorgeschlagene Feststellungen von Tatsachen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ממצאי עובדה מוצעים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">तथ्य के प्रस्तावित फैसले</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">事実認定案件提出書</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">拟议事实发现</skos:altLabel>
        <skos:definition>Proposed Findings of Fact refer to a written document submitted to the court by a party in a legal case, outlining the facts that they believe have been proven during the trial or hearing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNVmOiJzfp0FYujNYjaTAL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNVmOiJzfp0FYujNYjaTAL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLxL22W67GcWCpN6VKZd50"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmqysGFQ1RYW3F9lv5u3hu"/>
        <rdfs:label>Subscription Agreement</rdfs:label>
        <skos:definition>Subscription Agreement is a contract between a company and an investor, stipulating the terms under which the investor can purchase shares or other securities from the company. It includes the purchase price, the number of shares, and representations and warranties.</skos:definition>
        <skos:prefLabel>Subscription Document</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RNVukeUKKKNxWuboyhfRlO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RNVukeUKKKNxWuboyhfRlO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9W6ztFgHG0Jgzd362x6JLf"/>
        <rdfs:label>Blood Evidence</rdfs:label>
        <skos:definition>Blood evidence includes any traces of blood found at a crime scene, whether in liquid form, stains, or spatter patterns. Forensic experts analyze this evidence for DNA, blood type, and other factors to identify individuals or recreate events related to a crime.</skos:definition>
    </owl:Class>
    


