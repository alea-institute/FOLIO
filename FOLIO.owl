        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Liquor Law Violations</rdfs:label>
        <skos:altLabel>Alcohol Law Violations</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Infracciones a la Ley de Bebidas Alcohólicas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Liquor Law Violations</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verstöße gegen das Alkoholgesetz</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Violaciones a la Ley de Bebidas Alcohólicas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violations de la loi sur les boissons alcoolisées</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violações da lei de bebidas alcoólicas</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרות חוקי הסגולה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शराब कानून उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">酒类法规违规行为</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">酒類法違反行為</skos:altLabel>
        <skos:definition>The violation of laws or ordinances prohibiting the manufacture, sale, purchase, transportation, possession, or use of alcoholic beverages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJwn8LJKJJfFEQ6r16Pf8D -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJwn8LJKJJfFEQ6r16Pf8D">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Alpine</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJxZ2vqqnde5q8ti6PKfnF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJxZ2vqqnde5q8ti6PKfnF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4kWkG9m4DarQ45A7wBpJQ"/>
        <rdfs:label>Impression Evidence</rdfs:label>
        <skos:definition>Impression evidence refers to marks, patterns, or imprints left on surfaces that can be studied and analyzed to derive information about the object or tool that made them. Examples include shoeprints, tire treads, and tool marks. Such evidence can be instrumental in criminal investigations, as it can link a particular object or individual to a crime scene. Detailed analysis of these impressions can reveal unique characteristics or wear patterns that can be matched to specific sources.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJy67uuHSmMFfjfpevrNe0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJy67uuHSmMFfjfpevrNe0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1XGKMfgmQGI3yTSEndqMN"/>
        <rdfs:label>Best Interest of the Child Claim</rdfs:label>
        <skos:definition>A Best Interest of the Child Claim is a legal argument presented in family court, typically during custody or visitation disputes, where one party asserts that a particular custody arrangement or decision serves the child&apos;s best interests. This claim focuses on the child&apos;s welfare and well-being, considering factors such as their emotional, physical, and educational needs, the stability of each parent&apos;s home, and their relationship with both parents. Courts prioritize the best interests of the child when making custody and visitation determinations to ensure their safety and well-being.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJyLaQc804aQ8QTjdAVeqs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJyLaQc804aQ8QTjdAVeqs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Enurement Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause d&apos;agrément</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Aproveitamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de cesión de derechos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de enervación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Durchsetzungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Enurement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הזכאות להעברה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एनुरमेंट क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">有効化条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">生效条款</skos:altLabel>
        <skos:definition>An Enurement Clause is a provision in a contract that ensures the benefits or obligations of the contract extend to third parties who were not originally parties to the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDJyQQ2d7F3O273pz2330Ym -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDJyQQ2d7F3O273pz2330Ym">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RTHm2BxeaziDbm5655G1ki"/>
        <rdfs:label>Fixed Costs</rdfs:label>
        <skos:definition>Fixed costs are expenses that do not change regardless of the business&apos;s production levels or service levels. Examples include rent, salaries of permanent staff, and insurance premiums, and these costs are incurred even if the business has zero output.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDK00RGn4D8WBqOyOXqlrfn -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDK00RGn4D8WBqOyOXqlrfn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9v17ZYsnDkNSEZkvD36nhT"/>
        <rdfs:label>Legislative Proceedings</rdfs:label>
        <skos:definition>Legislative Proceedings refer to the formal discussions and decision-making processes carried out by a governing body, such as a parliament or congress, in order to create or amend laws.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDK1HhTVsPM0kA6teSZzZO6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDK1HhTVsPM0kA6teSZzZO6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtSJkLiGzcKx8PVlCAB5q5"/>
        <rdfs:label>Application for Order Waiving Requirement for Business Evaluation</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Befreiung von der Anforderung einer Geschäftsbewertung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Application for Order Waiving Requirement for Business Evaluation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Demande de dispense de l&apos;exigence d&apos;évaluation commerciale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Dispensa da Exigência de Avaliação Empresarial</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de orden para eximir el requisito de evaluación empresarial</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de orden para eximir el requisito de evaluación empresarial</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לפטור מהדרישה להערכת עסקים לצורך הזמנת צו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यापार मूल्यांकन के लिए आवश्यकता को माफ करने के आदेश के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">事業評価の要件免除申請</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">豁免业务评估要求申请</skos:altLabel>
        <skos:definition>An Application for Order Waiving Requirement for Business Evaluation is a legal document submitted in bankruptcy proceedings requesting exemption from the requirement to evaluate the debtor&apos;s business.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDK1QEdQg1T8B5HQqMK2pZN -->

