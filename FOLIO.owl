        <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
        <rdfs:label>Tax Tier Maximum</rdfs:label>
        <skos:altLabel xml:lang="de-de">Höchstgrenze für Steuerklassen</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Maximum de la tranche d&apos;imposition</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Máximo da faixa de imposto</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Máximo de nivel de impuestos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Máximo de nivel de impuestos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Tax Tier Maximum</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מקסימום שכבת מס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टैक्स टियर अधिकतम</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">税收阶层最高限额</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">税金ティア最大限度</skos:altLabel>
        <skos:definition>The Tax Tier Maximum is a specific detail within the broader concept of Tax Tier Detail, which sets the maximum amount of tax that can be charged for legal services provided under a particular engagement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IbKxfqnuzXc47sOigTUNT -->

