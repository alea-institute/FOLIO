        <rdfs:label>Bank</rdfs:label>
        <skos:altLabel>Depository Institution</skos:altLabel>
        <skos:definition>A bank is a financial institution licensed to receive deposits, make loans, and provide various financial services such as wealth management, currency exchange, and safe deposit boxes. Banks play a crucial role in the economy by facilitating financial transactions, providing credit, and offering investment products.</skos:definition>
        <skos:prefLabel>Financial Institution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Tyn1myNHR9ZL14Xk8j972 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Tyn1myNHR9ZL14Xk8j972">
