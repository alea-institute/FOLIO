        <skos:altLabel xml:lang="es-mx">Carta de Crédito</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Carta de crédito</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Letter of Credit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lettre de crédit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אישור אשראי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">क्रेडिट पत्र</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">信用状</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">信用证</skos:altLabel>
        <skos:definition>A Letter of Credit is a written agreement between a buyer and a seller, typically used in international trade, in which a bank guarantees payment to the seller upon receipt of certain documents.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBWYY2uAZnK8OjExo8X6PDh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBWYY2uAZnK8OjExo8X6PDh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBCzyIAi2Hjl80hfQr8wAMR"/>
        <rdfs:label>Public Comment</rdfs:label>
        <skos:definition>A Public Comment Document is a written submission made by an individual, organization, or other stakeholder to express views, provide data, or raise concerns about a proposed rule or regulation during the public comment period. These documents become part of the administrative record and are considered by the regulating agency before finalizing the new rule, serving to inform and potentially influence the final regulation</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBWYYH8EVxFlamkT7Z7UYqi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBWYYH8EVxFlamkT7Z7UYqi">
