        <skos:altLabel xml:lang="es-mx">Abstención del Río Colorado</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Colorado River Abstention</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כניעה לנהר קולורדו</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कोलोराडो नदी संयम</skos:altLabel>
