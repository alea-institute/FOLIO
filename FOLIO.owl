            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Spouse</rdfs:label>
        <skos:definition>A Spouse is a legally recognized partner in a marriage, civil union, or domestic partnership. This status confers various legal rights and responsibilities related to inheritance, taxation, healthcare decision-making, and immigration.</skos:definition>
    </owl:Class>
    


