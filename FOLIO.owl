            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>credit_note</rdfs:label>
        <skos:definition>&quot;In the European Union (and possibly in other areas of the world) it is required to indicate whether an instrument is a Credit Note if it corrects a Tax Invoice.  
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7a564vmQrNahaDKe1FlwJw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7a564vmQrNahaDKe1FlwJw">
