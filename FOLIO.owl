        <skos:altLabel xml:lang="es-es">Cláusula de cuotas pendientes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de cuotas pendientes</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de taxas pendentes</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu ausstehenden Gebühren</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Outstanding Fees Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף דמי ממתינים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बकाया फीस क्लॉज</skos:altLabel>
