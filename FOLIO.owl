        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCcQHyZbjBHsXsm0zrZGme5"/>
        <rdfs:label>Interference with Parent-Child Relationship</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Ingérence dans la relation parent-enfant</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Interference with Parent-Child Relationship</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Interferencia en la relación entre padres e hijos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Interferencia en la relación entre padres e hijos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Interferência na relação entre pais e filhos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Störung des Eltern-Kind-Verhältnisses</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרעה בקשר הורה-ילד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">माता-पिता-बच्चे के संबंध में हस्तक्षेप</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">干扰亲子关系</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">親子関係の妨害</skos:altLabel>
        <skos:definition>The concept of &quot;Interference with Parent-Child Relationship&quot; refers to the intentional or negligent actions of a third party that disrupt or damage the relationship between a parent and their child, leading to emotional distress or harm.</skos:definition>
        <skos:prefLabel>Tortious Interference with Parent-Child Relationship</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBfVDqiPdUODfM3nVf6asSB -->

