        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcW4pUMnXuufMtnyvdX0dB"/>
        <rdfs:label>Assignment Agreement</rdfs:label>
        <skos:altLabel>Transfer Contract</skos:altLabel>
        <skos:definition>An Assignment Agreement is a legal contract that transfers rights, benefits, or obligations from one party to another. This agreement outlines the conditions under which the assignment takes place, including the responsibilities of each party and any limitations or requirements that must be met for the assignment to be effective.</skos:definition>
        <skos:prefLabel>Transfer Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Htmn5aUWrjyC3naK9oxt6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Htmn5aUWrjyC3naK9oxt6">
