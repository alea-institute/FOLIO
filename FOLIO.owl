        <rdfs:label>Aircraft</rdfs:label>
        <skos:altLabel>Airborne Vehicle</skos:altLabel>
        <skos:definition>An Aircraft is a vehicle capable of atmospheric flight due to its interaction with the air, primarily through the generation of lift. This category includes various types of flying machines such as airplanes, helicopters, gliders, and drones.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9HVZcHfpIbYNnALLEZQy84 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9HVZcHfpIbYNnALLEZQy84">
