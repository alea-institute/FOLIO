        <skos:altLabel xml:lang="pt-br">Evento Interveniente - Conhecimento pelo Conselho Alvo</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Evento Interviniente - Conocimiento por el Consejo Objetivo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento Interviniente - Conocimiento por el Consejo Objetivo</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intervening Event - Knowledge by Target Board</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement intervenant - Connaissance par le conseil cible</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אירוע מתערב - ידע על ידי הועד היעד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हस्तक्षेप घटना - लक्ष्य बोर्ड द्वारा ज्ञान</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">介入イベント - ターゲットボードによる知識</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">干预事件 - 目标委员会的知识</skos:altLabel>
        <skos:definition>An intervening event in a legal matter that involves the knowledge possessed by the target board, which may affect the outcome of the case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCh6Oc8mbSkrdPsFW4zrL6F -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCh6Oc8mbSkrdPsFW4zrL6F">
