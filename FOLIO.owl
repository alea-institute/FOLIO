        <skos:altLabel xml:lang="ja-jp">マッチング権利言語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">匹配权利语言</skos:altLabel>
        <skos:definition>Matching Rights Language refers to the specific contractual language used in a Change of Recommendation Covenant that grants parties the right to maintain their ownership percentage in a company during a merger or acquisition by allowing them to purchase additional shares of the new entity.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RQhgntHFeLiHfBK6veDedh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RQhgntHFeLiHfBK6veDedh">
