        <skos:altLabel xml:lang="hi-in">ब्रीफ संशोधित करने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">修改意见书动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">簡易書面修正申立</skos:altLabel>
        <skos:definition>A Motion to Amend Brief is a formal request made to a court to modify or revise a previously submitted written argument or statement.</skos:definition>
    </owl:Class>
    


