        <skos:altLabel xml:lang="ja-jp">エラム語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">埃兰语</skos:altLabel>
        <skos:definition>A language that was spoken in ancient Elam, which is now modern-day Iran.</skos:definition>
    </owl:Class>
    


