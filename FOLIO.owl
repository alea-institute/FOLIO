        <skos:altLabel xml:lang="es-es">Mociones y presentaciones para descalificar al tomador de decisiones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones y presentaciones para descalificar al tomador de decisiones</skos:altLabel>
