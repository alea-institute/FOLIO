        <rdfs:label>Traffic Violation Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Reclamaciones por infracciones de tráfico</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamaciones por violaciones de tráfico</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações por violação de trânsito</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations pour violation du code de la route</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Traffic Violation Claims</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verkehrsverstoßansprüche</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות עבירות תנועה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रैफिक उल्लंघन दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">交通违规索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">交通違反請求</skos:altLabel>
        <skos:definition>A traffic violation claim is a type of criminal claim that involves the violation of traffic laws, such as speeding or running a red light, and the legal proceedings that follow.</skos:definition>
    </owl:Class>
    


