        <rdfs:label>Objection to Confirmation of the Plan</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einspruch gegen die Bestätigung des Plans</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Objection to Confirmation of the Plan</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Oposición a la Aprobación del Plan</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oposición a la Confirmación del Plan</skos:altLabel>
