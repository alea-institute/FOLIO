            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDS8DPtuFReTFfJ5nGCczD5"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RjM80CC0FA0G2sKxmlbaJF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Sale of Goods</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Sale of Goods</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Venda de bens</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Venta de Bienes</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Venta de Mercancías</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vente de biens</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Warenverkauf</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מכירת מקרקעין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वस्तुओं की बिक्री</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">商品の販売</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">货物销售</skos:altLabel>
        <skos:definition>The Sale of Goods is a legal concept that refers to the transfer of ownership of tangible personal property in exchange for money or other consideration, and is a type of contract or quasi-contract claim.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8t5ZgAelF7GIF22HOqyVwH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8t5ZgAelF7GIF22HOqyVwH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7D81edCD2d848A515dCCe2f"/>
        <rdfs:label>Ohio Municipal Court</rdfs:label>
        <skos:definition>Ohio Municipal Court is a court of limited jurisdiction in Ohio that handles minor criminal offenses, traffic violations, and civil cases within a specific geographic area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8t6ml1A9wI4Nz7X4rHVvNA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8t6ml1A9wI4Nz7X4rHVvNA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBNTLgdEoQpfLgYExWmsFao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Language Access Right</rdfs:label>
        <skos:definition>Language Access Right refers to the legal entitlement of individuals to receive assistance in understanding and communicating in the jurisdiction&apos;s dominant language (e.g., English) when interacting with government agencies or accessing public services. This right aims to eliminate language barriers that may prevent individuals, particularly those who are not proficient in the dominant language, from fully participating in civic activities or obtaining necessary services.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8t7u58Bmu2hmFFto8S64nx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8t7u58Bmu2hmFFto8S64nx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RgT3hiPFNllfpt00aHX6u7"/>
        <rdfs:label>Expert Fields</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Campos de especialização</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Campos de expertos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Campos de expertos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Domaines d&apos;expertise</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Expert Fields</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Expertenfelder</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שדות מומחים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विशेषज्ञ क्षेत्र</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专家领域</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">専門分野</skos:altLabel>
        <skos:definition>The fields in which a person is an expert.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8tEo7eLTGlfjDnmVgY0Qpp -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8tEo7eLTGlfjDnmVgY0Qpp">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ACnuRxPimlRqGRtJOwkgn"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9rhwkH0GU868poYsoFKzVb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motion for Injunction</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf einstweilige Verfügung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Injunction</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Injunction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de liminar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en injonction</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de medida cautelar</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לצו איסור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निषेधाज्ञा के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">差止命令申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">禁令动议</skos:altLabel>
        <skos:definition>A Motion for Injunction is a legal request made to a court to order a person or entity to stop doing a certain action or behavior, typically to prevent harm or damage to another party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8tHU2UcmJzAEBDUdM51ays -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8tHU2UcmJzAEBDUdM51ays">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMlfBHhw2Mfk0FBrVCQJY9"/>
        <rdfs:label>Term Life Insurance</rdfs:label>
        <skos:definition>Term life insurance is a policy that provides coverage for a specified period, or &quot;term,&quot; usually ranging from 10 to 30 years. If the insured individual dies within this term, the death benefit is paid out to the beneficiaries; however, if the term expires and the policyholder is still alive, there is generally no payout.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8tHwZFllPzNEUgzUV3YRLb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8tHwZFllPzNEUgzUV3YRLb">
