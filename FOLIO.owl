        <skos:altLabel xml:lang="fr-fr">Testament</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Testamento</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Testamento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Testamento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">צוואה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अंतिम इच्छापत्र</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">遗嘱</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">遺言書</skos:altLabel>
        <skos:definition>A Last Will and Testament is a legal document that outlines a person&apos;s wishes for the distribution of their property and assets after their death, and is a type of Trusts and Estate Planning Document.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDK6KqszFBwtJBxdJtoGdQ9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDK6KqszFBwtJBxdJtoGdQ9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCIv9j8UdKC0YVPrbl5EGRq"/>
        <rdfs:label>Squash</rdfs:label>
        <skos:altLabel>Cucurbita</skos:altLabel>
        <skos:definition>Squash refers to a diverse group of fruit vegetables from the Cucurbitaceae family, known for their various shapes, sizes, and flavors. They are categorized into summer and winter types, and are valued for their culinary versatility, nutritional benefits, including vitamins A and C, fiber, and antioxidants.</skos:definition>
        <skos:prefLabel>Gourds</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDK6eFy9n1upjAdRoNbPxQd -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDK6eFy9n1upjAdRoNbPxQd">
