    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCke27mKlKUFzAoyUK47qNn">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rt4T1FlyWPLKcpZDSAspuG"/>
        <rdfs:label>Comparative Fault of Others</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Comparative Fault of Others</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Culpa comparativa de outros</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Faute comparée d&apos;autres</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad comparativa de otros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad comparativa de otros</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vergleichbares Verschulden Dritter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אשמתם המשווה של אחרים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अन्यों की तुलनात्मक दोष</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">他人比较过失</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">他者の比較的過失</skos:altLabel>
        <skos:definition>The concept of Comparative Fault of Others refers to the legal principle that allows a defendant to argue that the fault of a non-party contributed to the plaintiff&apos;s injuries, and that the damages should be reduced accordingly.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCkf7qS1PEazmsboewDsIEX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCkf7qS1PEazmsboewDsIEX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
