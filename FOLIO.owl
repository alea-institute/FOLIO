    <!-- https://folio.openlegalstandard.org/R7PdNH9CyPCZwagGc0NzW76 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7PdNH9CyPCZwagGc0NzW76">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ri4LGaOgWzMWy2yX79DQi0"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_05"/>
        <rdfs:label>Hemoglobin Deficiency</rdfs:label>
        <skos:definition>Thalassemia is a genetic blood disorder characterized by the reduced production of hemoglobin, leading to anemia and other related health issues. It is caused by mutations in the genes responsible for hemoglobin production, resulting in abnormal hemoglobin and red blood cells.</skos:definition>
        <skos:prefLabel>Thalassemia</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7PjSMSqDsr4pw5CY13gyBr -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7PjSMSqDsr4pw5CY13gyBr">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKY2B2HNSx5K82dgVN6Qn7"/>
        <rdfs:label>Application for National Interest Waiver</rdfs:label>
        <skos:altLabel>EB-2 NIW</skos:altLabel>
        <skos:altLabel>Form I-140 NIW</skos:altLabel>
        <skos:altLabel>I-140 NIW Petition</skos:altLabel>
        <skos:definition>In the United States, an application for National Interest Waiver (NIW) is a request submitted by foreign nationals seeking an exemption from the labor certification requirement as part of the employment-based green card process in the United States. By applying for an NIW, applicants are essentially requesting that the requirement for a job offer and labor certification be waived due to their work being deemed in the national interest of the United States. The NIW is typically filed as part of the I-140 petition (Immigrant Petition for Alien Worker) and requires demonstrating how the applicant&apos;s work benefits the U.S. in a significant and unique manner</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7PoPGfISTLi8JD8AMy_Jkg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7PoPGfISTLi8JD8AMy_Jkg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtpnOBk4lRnWigpEBBKYUDQ"/>
        <rdfs:label>X126 Witness Fees</rdfs:label>
        <skos:definition>Any sheriff or service fees and other costs associated with the testimony of a witness at court or in a similar legal proceeding</skos:definition>
        <skos:prefLabel>X126 Witness Fees</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7PxEci57eXCLx3AlRl5dGg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7PxEci57eXCLx3AlRl5dGg">
