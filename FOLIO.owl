        <skos:altLabel xml:lang="en-gb">Processing</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Traitement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verarbeitung</skos:altLabel>
