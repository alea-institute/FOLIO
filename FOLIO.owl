        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QiKeEkci1FYlRMv6nDRnv"/>
        <rdfs:label>Cash Collateral Motion</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Hinterlegung von Bargeld als Sicherheit</skos:altLabel>
        <skos:altLabel>Bankruptcy</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Cash Collateral Motion</skos:altLabel>
        <skos:altLabel>Motion to Use Cash Collateral</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Depósito de Garantia em Dinheiro</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Petición de garantía en efectivo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en dépôt de garantie en espèces</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de garantía en efectivo</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשת אכיפת מזומנים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कैश कॉलेटरल मोशन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">现金抵押动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現金担保動議</skos:altLabel>
        <skos:definition>A Cash Collateral Motion in Bankruptcy is a legal request made by a debtor to use cash or cash equivalents that are held as collateral by a creditor, in order to continue operating their business during the bankruptcy process.</skos:definition>
    </owl:Class>
    


