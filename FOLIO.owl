        <rdfs:label>Georgia Superior Court - Lowndes County</rdfs:label>
        <skos:definition>A court of general jurisdiction in the state of Georgia, located in Lowndes County and having authority over civil and criminal cases within its jurisdiction.</skos:definition>
    </owl:Class>
    


