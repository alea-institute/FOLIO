        <skos:altLabel xml:lang="es-es">Activos de bonos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Activos de bonos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Anleihenvermögen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ativos de títulos</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bond Assets</skos:altLabel>
        <skos:altLabel>Bonds</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נכסי אגרות חוב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बॉन्ड संपत्ति</skos:altLabel>
