        <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Fairness</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Persönliche Zuständigkeit durch Angemessenheit</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שיפוט אישי על פי הוגנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यायमित्त व्यक्तिगत अधिकरण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公平个人管辖权</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公正による個人管轄権</skos:altLabel>
        <skos:definition>Personal Jurisdiction by Fairness refers to the authority of a court to hear a case based on the fairness of doing so, even if the defendant does not have sufficient minimum contacts with the forum state.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83cWaRd5UP59KOlvvFWPXP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83cWaRd5UP59KOlvvFWPXP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOBgLFktExGekPrKF5oWmr"/>
        <rdfs:label>Schizophrenia</rdfs:label>
        <skos:altLabel>Paranoid Schizophrenia</skos:altLabel>
        <skos:altLabel>Psychotic Disorder</skos:altLabel>
        <skos:altLabel>Schizophrenic Disorder</skos:altLabel>
        <skos:definition>Schizophrenia is a chronic and severe mental health disorder characterized by disturbances in thought processes, perceptions, emotional responsiveness, and social interactions. Symptoms include hallucinations, delusions, disorganized thinking, and impaired functioning, which can significantly affect daily life and require long-term treatment and support.</skos:definition>
        <skos:prefLabel>Schizophrenic Condition</skos:prefLabel>
    </owl:Class>
    


