        <skos:altLabel>Electoral Coercion Complaints</skos:altLabel>
        <skos:altLabel>Voter Harassment Claims</skos:altLabel>
        <skos:altLabel>Voting Intimidation Allegations</skos:altLabel>
        <skos:definition>Voter Intimidation and Coercion Claims refer to allegations that individuals were threatened, harassed, or pressured to influence their vote or deter them from voting. These claims can include physical threats, verbal harassment, misleading information, or coercive tactics designed to interfere with the free exercise of voting rights.</skos:definition>
        <skos:prefLabel>Voting Interference Claims</skos:prefLabel>
    </owl:Class>
    


