        <dc:identifier>HTC-AHCS</dc:identifier>
        <rdfs:label>Ambulatory Health Care Services Industry</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ambulante Gesundheitsdienstleistungsbranche</skos:altLabel>
        <skos:altLabel>Ambulatory Health Care Services</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Ambulatory Health Care Services Industry</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de servicios de atención médica ambulatoria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de servicios de atención médica ambulatoria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie des services de soins ambulatoires</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de serviços de saúde ambulatorial</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית שירותי טיפול ברפואה סיעודית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अम्बुलेटरी स्वास्थ्य देखभाल सेवाएं उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">外来医療サービス産業</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">门诊医疗服务行业</skos:altLabel>
        <skos:definition>Industries in this group provide health care services directly or indirectly to ambulatory patients and do not usually provide inpatient services. Health practitioners in this subsector provide outpatient services, with the facilities and equipment not usually being the most significant part of the production process. This group includes offices of physicians, dentists, chiropractors, optometrists, psychologists, mental health practitioners, podiatrists, etc.</skos:definition>
        <skos:hiddenLabel>AHCS</skos:hiddenLabel>
    </owl:Class>
    


