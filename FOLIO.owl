        <skos:altLabel xml:lang="pt-br">Responsabilidade do vice-diretor</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité du vice-principal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Vice-Principal Liability</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות סגן-מנהל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उप प्रधानाध्यापक दायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">副校長の責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">副校长责任</skos:altLabel>
        <skos:definition>The legal concept of Vice-Principal Liability refers to the responsibility of a person or entity, such as a company, for the actions of their subordinates or agents, even if the person in charge did not directly participate in the wrongdoing.</skos:definition>
    </owl:Class>
    


