        <skos:altLabel xml:lang="en-gb">Theft from Motor Vehicle</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Vol dans un véhicule à moteur</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גניבה מרכב נייד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मोटर वाहन से चोरी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">机动车盗窃</skos:altLabel>
