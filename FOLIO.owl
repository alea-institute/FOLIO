        <skos:altLabel xml:lang="fr-fr">Népalais</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ネパール語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">尼泊尔语</skos:altLabel>
        <skos:definition>Nepali (Language) is a structured system of communication consisting of grammar and vocabulary used in Nepal and some parts of India.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBSQAl4UWcJk3GnqGxbZgHk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBSQAl4UWcJk3GnqGxbZgHk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R3JSBxP8r1OUSNgxHhgv9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>News Source Privilege</rdfs:label>
        <skos:altLabel>Confidential Source Protection</skos:altLabel>
        <skos:altLabel>Reporter&apos;s Privilege</skos:altLabel>
        <skos:altLabel>Shield Law Protection</skos:altLabel>
        <skos:definition>News source privilege is a legal principle that allows journalists to refuse to disclose the identities of confidential sources or unpublished information obtained during the newsgathering process. This privilege is grounded in the First Amendment&apos;s freedom of the press and is intended to protect the flow of information to the public by ensuring the confidentiality of sources.</skos:definition>
        <skos:prefLabel>Journalist&apos;s Privilege</skos:prefLabel>
    </owl:Class>
    


