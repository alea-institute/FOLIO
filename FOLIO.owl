        <skos:altLabel>formerly Homicide</skos:altLabel>
        <skos:definition>Duplicates `Murder`</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhfNPsv8keQ9VVfjW93FQP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhfNPsv8keQ9VVfjW93FQP">
