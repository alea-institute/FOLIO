    <!-- https://folio.openlegalstandard.org/pCXQ41bfRSq8cilnQzIFWg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/pCXQ41bfRSq8cilnQzIFWg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_Xh4w_XyQVSUrqC7JJ2SpA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=721199"/>
        <rdfs:label>All Other Traveler Accommodation</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in providing short-term lodging (except hotels, motels, casino hotels, and bed-and-breakfast inns).</skos:definition>
        <skos:example>Guest houses</skos:example>
        <skos:example>Hostels</skos:example>
        <skos:example>Housekeeping cabins and cottages</skos:example>
        <skos:example>Tourist homes</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/pDxCS7g2QSS6LaWXf2aLfA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/pDxCS7g2QSS6LaWXf2aLfA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/adQcOuLaTMu96ErMjMF2_g"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=221330"/>
        <rdfs:label>Steam and Air-Conditioning Supply</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in providing steam, heated air, or cooled air. The steam distribution may be through mains.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/pJi61X8ITgSUPahyIDfvNg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/pJi61X8ITgSUPahyIDfvNg">
