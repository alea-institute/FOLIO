        <dc:source>Fed. R. Evid. 801(a)</dc:source>
        <rdfs:label>Statements Not Offered for the Truth of the Matter Asserted</rdfs:label>
        <skos:definition>Statements Not Offered for the Truth of the Matter Asserted are out-of-court statements that are admitted into evidence for a purpose other than proving the truth of the content of the statement itself. These statements are not considered hearsay because they are not relied upon for their truthfulness, but rather for another legally relevant purpose.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRCaFxX4hpUklgNnVS9D8C"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
        <rdfs:label>Deal Language</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause sur les effets défavorables importants</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Efeito Material Adverso</skos:altLabel>
        <skos:altLabel>Deal Language</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zu wesentlichen nachteiligen Auswirkungen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Lenguaje de Efecto Adverso Material</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Lenguaje de Efecto Adverso Material</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Language</skos:altLabel>
        <skos:altLabel xml:lang="he-il">שפת השפעה נגדית חומרית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव भाषा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利益事象に関する条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">重大不利影响条款</skos:altLabel>
        <skos:definition>Material Adverse Effect (MAE) Language refers to a legal provision in mergers and acquisitions contracts that outlines specific circumstances or events that would have a significant negative impact on the value or operations of the target company, and may allow the acquiring party to terminate the agreement or renegotiate the terms.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RQK2hPELdaFnrBqNkJFzWO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RQK2hPELdaFnrBqNkJFzWO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Rdvjz7Q76QLZXnSJ66z40"/>
        <dc:source>ABA M&amp;A Deal Points Study</dc:source>
        <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
        <rdfs:label>Merger</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Fusion</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fusión</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fusión</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fusão</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Merger</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zusammenschluss</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מיזוג</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विलय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">合併</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合并</skos:altLabel>
        <skos:definition>The concept of &quot;Merger&quot; refers to a type of M&amp;A deal structure where two or more companies combine into a single entity, with one surviving entity and the others being absorbed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RQKn9DJ8Sq6C9iOXGuL8bs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RQKn9DJ8Sq6C9iOXGuL8bs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKOcs51IQGZ9MeUqtONIlc"/>
        <rdfs:label>Dividend Payment</rdfs:label>
        <skos:altLabel>Dividend Distribution</skos:altLabel>
        <skos:altLabel>Equity Income</skos:altLabel>
        <skos:altLabel>Shareholder Distribution</skos:altLabel>
        <skos:altLabel>Shareholder Payment</skos:altLabel>
        <skos:definition>A Dividend Payment is a distribution of a portion of a company&apos;s earnings to its shareholders, typically in the form of cash or additional shares. Dividends are usually paid out regularly (e.g., quarterly) and are intended to provide a return on investment to shareholders.</skos:definition>
        <skos:prefLabel>Dividend Income</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RQLBTAwgrpijWFVGwUX2Zv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RQLBTAwgrpijWFVGwUX2Zv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwOMSIjx2yx6LoJwtVc8Yt"/>
        <rdfs:label>Public Space Committee</rdfs:label>
        <skos:altLabel>Civic Space Planning Committee</skos:altLabel>
        <skos:altLabel>Community Open Space Board</skos:altLabel>
        <skos:altLabel>Urban Public Space Panel</skos:altLabel>
        <skos:definition>A Public Space Committee is an organized group of individuals, often within local government or a relevant agency, that oversees, plans, and makes recommendations for the development, maintenance, and use of public spaces within a community. This committee typically collaborates with urban planners, landscape architects, and community stakeholders to create spaces that serve public needs and enhance community welfare.</skos:definition>
    </owl:Class>
    


