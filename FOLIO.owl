        <rdfs:label>Commercial and Industrial Machinery and Equipment (except Automotive and Electronic) Repair and Maintenance</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/kAGSv3rrQEuwFvq3mE48-w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/kAGSv3rrQEuwFvq3mE48-w">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Wnb0B4vNR66_Oszwz0yiSQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334112"/>
        <rdfs:label>Computer Storage Device Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing computer storage devices that allow the storage and retrieval of data from a phase change, magnetic, optical, or magnetic/optical media. Examples of products made by these establishments are computer disk drives, USB flash drives, and tape storage and backup units.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/kCdDtru2Q-e1BNBNmK5ztA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/kCdDtru2Q-e1BNBNmK5ztA">
