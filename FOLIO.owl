        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=56172"/>
        <rdfs:label>Janitorial Services</rdfs:label>
        <skos:definition>See industry description for 561720.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/boTmEmz0QkyMSYYgHoHJDA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/boTmEmz0QkyMSYYgHoHJDA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R83VhHEeaRnvGWxfksxJUSc"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3352"/>
        <rdfs:label>Household Appliance Manufacturing</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in manufacturing small electric appliances, electric housewares, and major household appliances.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/bsZKqgnrSEChswxz8e6_-g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/bsZKqgnrSEChswxz8e6_-g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Y35yCdJSS8epkqV594aqDA"/>
        <rdfs:isDefinedBy rdf:resource="https://pitchbook.com/what-are-industry-verticals#petTech"/>
