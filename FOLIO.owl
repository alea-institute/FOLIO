                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBCzyIAi2Hjl80hfQr8wAMR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:source>Fed. R. Evid. 803(8)</dc:source>
        <rdfs:label>Public Record Document</rdfs:label>
        <skos:altLabel>Official Record</skos:altLabel>
        <skos:altLabel>Public Authority Record</skos:altLabel>
        <skos:definition>A public record document is an official record created, maintained, and accessible by a government agency or public body, which can be used as evidence in legal proceedings. These documents include a wide range of materials, such as birth certificates, property deeds, and court records, and are generally considered reliable and admissible under the public records exception to the hearsay rule.</skos:definition>
        <skos:prefLabel>Government Record</skos:prefLabel>
    </owl:Class>
    


