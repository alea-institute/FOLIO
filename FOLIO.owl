        <rdfs:label>Hematology Malpractice</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Faute professionnelle en hématologie</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Hämatologie-Malpractice</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência médica em hematologia</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">血液学の医療過誤</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">血液病医疗事故</skos:altLabel>
        <skos:definition>Medical negligence related to the diagnosis, treatment, or management of blood disorders or diseases.</skos:definition>
    </owl:Class>
    


