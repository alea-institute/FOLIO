        <rdfs:label>Norwegian Nynorsk; Nynorsk, Norwegian</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Norueguês Nynorsk; Nynorsk, Norueguês</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Norvégien Nynorsk; Nynorsk, Norvégien</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Norwegisch Nynorsk; Nynorsk, Norwegisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ノルウェー・ニーノシュク語; ニーノシュク語、ノルウェー語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">挪威尼诺斯克语; 尼诺斯克语，挪威语</skos:altLabel>
        <skos:definition>Norwegian Nynorsk is a written or spoken structured system of communication that consists of grammar and vocabulary, and is a variation of the Norwegian language.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIID6TwX1zfh0pWeJjeDrF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIID6TwX1zfh0pWeJjeDrF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxq2qQYpdo9stHOBIQhub7"/>
        <rdfs:label>Real Estate Design Review</rdfs:label>
        <skos:altLabel>Architectural Review</skos:altLabel>
        <skos:altLabel>Design Review</skos:altLabel>
        <skos:altLabel>Urban Design Assessment</skos:altLabel>
        <skos:definition>Real Estate Design Review is the process by which proposed architectural and site designs for a development project are evaluated for their adherence to local design standards, aesthetics, and land use compatibility. This review is usually conducted by a designated committee or governing body and may involve public hearings, expert consultations, and revisions to the initial plans.</skos:definition>
        <skos:prefLabel>Design Approval Process</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIJ4bPoH3UCJNKCSOdiFNg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIJ4bPoH3UCJNKCSOdiFNg">
