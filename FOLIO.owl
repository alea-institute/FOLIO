    <!-- https://folio.openlegalstandard.org/RhCLmyJ9TLbnSraEygiNg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RhCLmyJ9TLbnSraEygiNg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Subordination Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de subordination</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Subordinación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Subordinación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de subordinação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nachrangklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Subordination Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כפול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अधीनता शर्त</skos:altLabel>
