        <skos:altLabel xml:lang="zh-cn">干涉动议</skos:altLabel>
        <skos:definition>A Motion to Intervene is a legal request made by a non-party to join an ongoing case in order to protect their interests or rights.</skos:definition>
    </owl:Class>
    


