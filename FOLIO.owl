        <skos:altLabel xml:lang="ja-jp">損害賠償の専門家</skos:altLabel>
        <skos:definition>An expert who opines on prospective or actual damages.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Jfe7vUl3X8WdhirLRGKbU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Jfe7vUl3X8WdhirLRGKbU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Underpayment of Public Benefit</rdfs:label>
        <skos:definition>Underpayment of public benefit refers to the situation in which an individual or family receives less financial assistance or services than they are entitled to under a specific public benefit program. This can occur due to administrative errors, incomplete information, or misapplication of eligibility criteria, and may require corrective action to adjust the benefit amount and deliver the owed resources to the recipient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Jgkb8zAsxQEH7BoHCCqy4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Jgkb8zAsxQEH7BoHCCqy4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Fon</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fon</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fon</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Fon</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fon</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Fon</skos:altLabel>
        <skos:definition>African language spoken primarily in Benin, Togo, and Nigeria.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JhYoJucfcSzANhL3U9wq9 -->

