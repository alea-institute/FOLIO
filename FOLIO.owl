        <rdfs:label>New Jersey Municipal Court</rdfs:label>
        <skos:definition>New Jersey Municipal Court is a court of limited jurisdiction in New Jersey that handles minor criminal offenses, traffic violations, and small claims cases.</skos:definition>
    </owl:Class>
    


