        <rdfs:label>Copying Expense</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Copying Expense</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Despesa de cópia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais de copie</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Gasto de copiado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gasto de copiado</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kopierkosten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאות העתקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कॉपी खर्च</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">コピー費用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">复印费用</skos:altLabel>
        <skos:definition>The Copying Expense concept refers to the costs incurred for reproducing documents or materials, which are necessary for a legal matter and are considered as an expense.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R81c1psAgogF7fBsY65GnQy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R81c1psAgogF7fBsY65GnQy">
