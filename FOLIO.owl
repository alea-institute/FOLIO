        <rdfs:label>Parental Immunity</rdfs:label>
        <skos:altLabel xml:lang="es-es">Inmunidad parental</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Inmunidad parental</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Parental Immunity</skos:altLabel>
        <skos:altLabel xml:lang="de-de">elterliche Immunität</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">immunité parentale</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">imunidade parental</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חסינות הורית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पारंपरिक प्रतिरक्षा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">亲子免疫</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">親子免疫</skos:altLabel>
        <skos:definition>A legal doctrine that shields a parent from being sued by their child for harm caused by the parent&apos;s actions, based on the idea that the parent-child relationship is of such importance to society that it should not be subject to legal scrutiny.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RD2RElTCvTbk5aUX9CfbJC5 -->

