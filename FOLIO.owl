        <rdfs:label>TR110 Fact Investigation and Development</rdfs:label>
        <skos:definition>All actions to investigate and understand the facts of a matter that are not included under another trademark task code below. Covers initial meeting to discuss new matter, interview of client personnel and potential witnesses, review of documents to learn the facts of a potential case, work with an investigator, and all related communications and correspondence.</skos:definition>
        <skos:prefLabel>TR110 Fact Investigation and Development</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RZqUEjM4B0PS0FbnLUORs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8RZqUEjM4B0PS0FbnLUORs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
        <rdfs:label>Directive</rdfs:label>
        <skos:definition>A Directive is an official or authoritative instruction or guideline issued by a governing body or regulatory authority, often aiming to manage or direct specific actions within its jurisdiction. It typically outlines procedures, sets standards, or provides guidance for compliance with laws and regulations</skos:definition>
        <skos:example>European Union Directive</skos:example>
        <skos:example>U.S. Department of Defense Directive</skos:example>
    </owl:Class>
    


