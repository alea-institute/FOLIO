        <rdfs:label>Multi-Jurisdictional Objective</rdfs:label>
        <skos:altLabel>Cross-Border Objective</skos:altLabel>
        <skos:definition>Multi-Jurisdictional Objective pertains to legal principles and strategies that involve multiple jurisdictions, including international, regional, and inter-state/provincial laws. It encompasses the application, coordination, and conflict of laws across different legal systems to address multi-jurisdictional issues.</skos:definition>
        <skos:prefLabel>International Law Objective</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBph9lU6r2b2uGdmXJ0Hv17 -->

