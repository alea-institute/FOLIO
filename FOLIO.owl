        <rdfs:label>Massachusetts Superior Court - Norfolk County</rdfs:label>
        <skos:definition>The Massachusetts Superior Court - Norfolk County is a court of general jurisdiction in Massachusetts that hears civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDdgYa5ZbqVnS9aGrOwQu5h -->

