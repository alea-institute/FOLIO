        <skos:altLabel xml:lang="es-es">Cláusula de transferencia de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de transferencia de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de transferência de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Übertragung des Eigentums</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transfer of Ownership Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף העברת בעלות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्वामित्व की अंतरण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">所有权转移条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">所有権移転条項</skos:altLabel>
        <skos:definition>A Transfer of Ownership Clause is a provision in a contract that outlines the conditions under which ownership of a particular asset or property is transferred from one party to another.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCT9Ji3xwVRmaAm7oP74vvB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCT9Ji3xwVRmaAm7oP74vvB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD1oQDMlC6FytjOndhJTMy8"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9HlxYOQb4WGC3goxZENvJs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>International Organization Visa - Diplomats</rdfs:label>
        <skos:altLabel xml:lang="en-us">G-1 Visa</skos:altLabel>
        <skos:definition>An International Organization Visa for diplomats refers to a specialized visa category that allows foreign diplomats representing their countries at international organizations to enter and reside in a host country for the duration of their diplomatic assignment. This visa comes with specific diplomatic privileges and immunities in accordance with international law to facilitate their diplomatic duties and interactions within the international organization&apos;s context.</skos:definition>
    </owl:Class>
    


