        <skos:altLabel xml:lang="de-de">Nationales Büro für Hintergrunduntersuchungen</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Oficina Nacional de Investigaciones de Antecedentes</skos:altLabel>
