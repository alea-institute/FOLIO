        <rdfs:label>Performance Improvement Plan</rdfs:label>
        <skos:altLabel>Corrective Action Plan</skos:altLabel>
        <skos:altLabel>Improvement Plan</skos:altLabel>
        <skos:altLabel>Performance Action Plan</skos:altLabel>
        <skos:definition>A Performance Improvement Plan (PIP) is a formal document outlining specific goals and actions an employee must take to improve their performance to meet organizational standards. This plan typically includes a timeline, measurable objectives, and support resources to help the employee achieve the required improvements.</skos:definition>
        <skos:prefLabel>PIP</skos:prefLabel>
    </owl:Class>
    


