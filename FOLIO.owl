        <rdfs:label>Indiana Town Court - Marion County, Warren Twp.</rdfs:label>
        <skos:definition>A court located in Marion County, Warren Township, Indiana that has limited jurisdiction over minor criminal offenses, traffic violations, and small claims cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9W2eJfjJCn8diXAUar3XfF -->

