    <!-- https://folio.openlegalstandard.org/RBJHEe1jRjysGW7Lv6tggAP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJHEe1jRjysGW7Lv6tggAP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Telfair County</rdfs:label>
        <skos:definition>A court of general jurisdiction in Telfair County, Georgia, with authority over civil and criminal cases within its geographical jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJHLOZetGcv6GWkosBeFsq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJHLOZetGcv6GWkosBeFsq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsA0EjhyOEG9HBBGLsyj0G"/>
        <rdfs:label>Excited Utterance</rdfs:label>
        <skos:altLabel>Spontaneous Exclamation</skos:altLabel>
        <skos:altLabel>Startled Statement</skos:altLabel>
        <skos:definition>An Excited Utterance is a statement relating to a startling event or condition made while the declarant was under the stress of excitement caused by the event or condition. This hearsay exception is based on the idea that statements made under the influence of excitement or shock are unlikely to be fabricated due to the lack of time for reflection or deliberation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx">
