        <rdfs:label>E110 Out-of-town travel</rdfs:label>
        <skos:definition>Expenses incurred for travel outside of the employee&apos;s usual work location.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9LJ3VYJiCCG4bvoMOFX1Kq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9LJ3VYJiCCG4bvoMOFX1Kq">
