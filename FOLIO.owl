        <rdfs:isDefinedBy rdf:resource="https://www.childwelfare.gov/topics/outofhome/foster-care/oppla-appla/"/>
        <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
        <rdfs:label>Another Planned Permanent Living Arrangement</rdfs:label>
        <skos:altLabel>APPLA</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Another Planned Permanent Living Arrangement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Eine weitere geplante dauerhafte Wohnanordnung</skos:altLabel>
        <skos:altLabel>Other Planned Permanent Living Arrangement (OPPLA)</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Otro arreglo de vida permanente planificado</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Otro arreglo de vida permanente planificado</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Outra Arranjo Permanente de Vida Planejado</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Une autre arrangement de vie permanente planifiée</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סידור מגורים קבוע תוכנן נוסף</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एक और योजित स्थायी निवास व्यवस्था</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">別の計画された永久的な生活環境</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">另一种计划永久居住安排</skos:altLabel>
        <skos:definition>A planned permanent living arrangement (APPLA) is an alternative option for a child in the foster care system who cannot be reunited with their birth family or adopted, and involves placing the child in a long-term, stable living situation with a caregiver who is not their legal guardian.</skos:definition>
    </owl:Class>
    


