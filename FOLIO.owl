        <rdfs:label>Hoonah Indian Association</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_06"/>
        <rdfs:label>Anxiety and Obsessive-Compulsive Disorders</rdfs:label>
        <skos:definition>Anxiety and Obsessive-Compulsive Disorders are characterized by excessive anxiety, worry, apprehension, and fear, or by avoidance of feelings, thoughts, activities, objects, places, or people.  Symptoms and signs may include restlessness, difficulty concentrating, hyper-vigilance, muscle tension, sleep disturbance, fatigue, panic attacks, obsessions and compulsions, constant thoughts and fears about safety, and frequent physical complaints.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDKHz2tUvUDYTa1DlEFt6oh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDKHz2tUvUDYTa1DlEFt6oh">
