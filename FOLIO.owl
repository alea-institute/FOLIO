        <rdfs:label>New York Supreme Court - Orange County</rdfs:label>
        <skos:definition>A court located in Orange County, New York that has jurisdiction over civil and criminal cases within its geographical area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCXKHit5xKTluVcolPmkikj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCXKHit5xKTluVcolPmkikj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
        <rdfs:label>Foreign Agents Registration Act Claim</rdfs:label>
        <skos:altLabel>Agent Non-Compliance Claim</skos:altLabel>
        <skos:altLabel>FARA Claim</skos:altLabel>
        <skos:altLabel>FARA Violation Claim</skos:altLabel>
        <skos:altLabel>Foreign Lobbying Disclosure Claim</skos:altLabel>
        <skos:definition>A Foreign Agents Registration Act (FARA) claim involves legal action taken against individuals or entities for failing to comply with the disclosure and registration requirements mandated by FARA. Such claims seek to enforce transparency and accountability regarding foreign influence on U.S. political and public processes.</skos:definition>
        <skos:prefLabel>Foreign Influence Transparency Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCXZS96ySWIuhlC6yiTUzVg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCXZS96ySWIuhlC6yiTUzVg">
