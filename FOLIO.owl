        <skos:altLabel xml:lang="pt-br">Pedido de Renovação de Julgamento</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Solicitud de Renovación de Sentencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Solicitud de Renovación de Sentencia</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לחידוש צו יישום</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फिर से न्यायाधिकरण के लिए आवेदन</skos:altLabel>
