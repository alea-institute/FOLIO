        <skos:altLabel xml:lang="zh-cn">手语</skos:altLabel>
        <skos:definition>A system of communication that uses visual gestures and signs instead of spoken words, used by individuals who are deaf or hard of hearing.</skos:definition>
    </owl:Class>
    


