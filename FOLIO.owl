        <rdfs:label>Inflation Risk</rdfs:label>
        <skos:definition>The risk that the value of assets or income will decrease as inflation shrinks the purchasing power of a currency.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCGEbsIMcwPm77vzI1wtvUL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCGEbsIMcwPm77vzI1wtvUL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJgy4NDLgsP7qaqied5k5c"/>
        <rdfs:label>Website</rdfs:label>
        <skos:altLabel>Internet Site</skos:altLabel>
        <skos:altLabel>Online Site</skos:altLabel>
        <skos:altLabel>Web Page</skos:altLabel>
        <skos:altLabel>Web Portal</skos:altLabel>
        <skos:altLabel>Webpage</skos:altLabel>
        <skos:definition>A Website is a collection of interconnected web pages hosted on the internet, accessible via a web browser, that provides information, services, or content to users. Protected under copyright law, websites grant the creators exclusive rights to reproduce, distribute, and display the content.</skos:definition>
    </owl:Class>
    


