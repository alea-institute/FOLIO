            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Employment Eligibility Verification Form</rdfs:label>
        <skos:definition>The Employment Eligibility Verification Form (in the U.S., the I-9) is a form required by the government for all employees to verify their identity and authorization to work in the country. Employers must complete and retain an Employment Eligibility Verification Form for each person they hire, and the form must be available for inspection by authorized government officers.</skos:definition>
        <skos:prefLabel>I-9</skos:prefLabel>
    </owl:Class>
    


