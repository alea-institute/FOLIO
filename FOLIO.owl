    <!-- https://folio.openlegalstandard.org/RCtJD0HhBY5n4xkKpNWbRnR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCtJD0HhBY5n4xkKpNWbRnR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDx4PuWu7ZznwNEGW6rXll0"/>
        <rdfs:label>Strawberries</rdfs:label>
        <skos:altLabel>Fragaria</skos:altLabel>
        <skos:definition>Strawberries are small, red, and fragrant aggregate fruits belonging to the Fragaria genus, known for their sweet flavor and juicy texture. They are widely consumed fresh or processed into jams, desserts, and beverages and are valued for their high vitamin C content, antioxidants, and dietary fiber.</skos:definition>
    </owl:Class>
    


