        <skos:definition>A department of persons who enforce laws, investigate crimes, and make arrests.</skos:definition>
        <skos:definition>Identification of law enforcement or investigative agency that initiated the case. FOLIO utilizes the FBI standard (ORI Number). https://www.icpsr.umich.edu/files/NACJD/ORIs/STATESoris.html</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RILtMHLpDM8luT3w9ni6LK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RILtMHLpDM8luT3w9ni6LK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
        <dc:source>Fed. R. Evid. 401</dc:source>
        <dc:source>Fed. R. Evid. 402</dc:source>
        <rdfs:label>Irrelevant Evidence Objection</rdfs:label>
        <skos:altLabel>Irrelevant</skos:altLabel>
        <skos:altLabel>No Probative Value Objection</skos:altLabel>
        <skos:altLabel>Non-Pertinent Evidence Objection</skos:altLabel>
        <skos:altLabel>Objection to Inapplicable Evidence</skos:altLabel>
        <skos:altLabel>Unrelated Evidence Objection</skos:altLabel>
        <skos:definition>An Irrelevant Evidence Objection is raised when a party in a legal proceeding believes that the evidence being presented is not related to the issues at hand or does not have any probative value. This objection aims to prevent the introduction of extraneous information that could distract or mislead the decision-maker.</skos:definition>
        <skos:prefLabel>Immaterial Objection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RILuqAMxcqNJm8vHgoOo7a -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RILuqAMxcqNJm8vHgoOo7a">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBVXMCXoBW3Ef1c3VUuU84a"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R76UTCrg8DDzlFkZCPjrdqe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Visa for Families of Skilled Workers</rdfs:label>
        <skos:altLabel xml:lang="en-us">H-4 Visa</skos:altLabel>
        <skos:definition>A Visa for Families of Skilled Workers, such as the U.S. H-4 Visa, is a category of visa that allows the immediate family members (spouse and dependent children) of skilled workers with certain types of visas to accompany them to the host country. These family members are often granted the right to reside in the country and, in some cases, may be eligible to apply for work authorization.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIMzJ5opssCCB2tKCqEiwD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIMzJ5opssCCB2tKCqEiwD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QcJpEJ19eAN8glCzxd4Wo"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8LpBISZyz97ud1vw9vqsQ9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Pro Bono Management</rdfs:label>
        <skos:definition>Pro Bono Management refers to the management of legal services provided by lawyers and law firms on a voluntary basis, typically for individuals or organizations who cannot afford legal representation.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIOjneXO96zMhlYgGHiovK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIOjneXO96zMhlYgGHiovK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RpiyvcnyPAZ5hygNt0zO3j"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_17"/>
        <rdfs:label>Major Weight-Bearing Joint Surgery</rdfs:label>
        <skos:definition>Reconstructive surgery or surgical arthrodesis of a major weight-bearing joint involves surgical procedures aimed at repairing or stabilizing large joints that support significant body weight, such as the hip, knee, or ankle. This type of surgery is performed to restore function, alleviate pain, and improve stability in joints severely affected by injury, disease, or degeneration.</skos:definition>
        <skos:prefLabel>Reconstructive Surgery or Surgical arthrodesis of a Major Weight-bearing Joint</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIPGUOqov5ujn1dMUQF7sZ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIPGUOqov5ujn1dMUQF7sZ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVu433XojPQPseoDXhidgO"/>
        <rdfs:label>Suburban Market Segment</rdfs:label>
        <skos:definition>The suburban market segment refers to a group of consumers or businesses located in the suburbs, areas that are typically situated on the outskirts of urban centers and characterized by a mix of residential and commercial zones. This segment is distinguished by its unique lifestyle and consumption patterns, often blending urban convenience with a more spacious and family-oriented environment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIPyGUpyktHtX5nzig7K2c -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIPyGUpyktHtX5nzig7K2c">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Chairman Emeritus Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de président émérite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Presidente Emérito</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorsitzender Emeritus Klausel</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">名誉主席条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">名誉会長条項</skos:altLabel>
        <skos:definition>A Chairman Emeritus Clause is a contractual provision that grants a former chairman of a company certain privileges or rights, such as a seat on the board of directors or an honorary title.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIQnXfIDi8YStyeDYkefmC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIQnXfIDi8YStyeDYkefmC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDr6DXAcukDYZgOiiRN8qtf"/>
        <rdfs:label>Equal Protection Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Equal Protection Claim</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gleichheitsschutzklage</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de Protección Igualitaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de Protección Igualitaria</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Recours en protection de l&apos;égalité</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de proteção igualitária</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת הגנה שווה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समान अधिकार दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">平等保护索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">平等保護請求</skos:altLabel>
        <skos:definition>An equal protection claim is a legal action initiated by an individual or group alleging that their Fourteenth Amendment right to equal protection under the law has been violated by the government or a government actor. The Equal Protection Clause of the Fourteenth Amendment prohibits the government from treating individuals or groups differently based on their race, gender, national origin, or other protected categories. An equal protection claim may arise in various contexts, such as when a government enacts a law or policy that treats certain individuals or groups unfairly or unequally, or when a government actor engages in discriminatory conduct. Examples of unequal treatment can include unequal enforcement of laws, unequal access to public services or benefits, or unequal treatment in the criminal justice system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RISXpicfJlkGlawzTdc9Eb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RISXpicfJlkGlawzTdc9Eb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOvAHsvY8TKJ1O1orXPM9o"/>
        <rdfs:label>Kashmiri</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Cachemiri</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Caxemira</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kaschmirisch</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">カシミール語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">克什米尔语</skos:altLabel>
        <skos:definition>Kashmiri (Language) is a structured system of communication consisting of grammar and vocabulary used in the Kashmir region, including in legal documents, artifacts, evidence, testimony, proceedings, and other legal aspects.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RITVzcNUrw2Bg0fvFueOTT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RITVzcNUrw2Bg0fvFueOTT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg"/>
        <rdfs:label>Lease Agreements</rdfs:label>
        <skos:definition>A Lease Related Agreement refers to any supplementary contract or document associated with a primary lease agreement, addressing specific terms, conditions, or scenarios that might arise during the lease period. Examples include lease renewals, extensions, terminations, subleases, assignments, and guaranties, among others. These agreements provide clarity and legal framework for particular aspects or contingencies of the lease relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIVIkx09k4mvjoAwOWMTgH -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIVIkx09k4mvjoAwOWMTgH">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7ReDY2v13rer1U8AyOj55L"/>
        <rdfs:label>Lead Matter Designation</rdfs:label>
        <skos:definition>Designation as parent-level matter, where one or more other matters may be subsidiary matters or subset matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RIViC7vaOR6iUf5SXhRvyT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RIViC7vaOR6iUf5SXhRvyT">
