        <skos:altLabel xml:lang="fr-fr">Clause de non-responsabilité</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Descargo de Responsabilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Descargo de Responsabilidad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de Isenção de Responsabilidade</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Disclaimer of Responsibility Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף כחלון אחראיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ज़िम्मेदारी से संबंधित अस्वीकरण शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">免責事項規定条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">免责声明条款</skos:altLabel>
        <skos:definition>A Disclaimer of Responsibility Clause is a statement in a legal document that absolves a party from any liability or obligation for the consequences of their actions or omissions.</skos:definition>
    </owl:Class>
    


