        <rdfs:label>Fee Discount or Credit Type</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Fee Discount or Credit Type</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebührenrabatt- oder Gutschrifttyp</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tipo de desconto ou crédito de taxa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tipo de descuento o crédito de tarifa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tipo de descuento o crédito de tarifa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Type de réduction ou de crédit de frais</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוג הנחה או זיכוי עמלה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फी छूट या क्रेडिट प्रकार</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">手数料割引またはクレジットタイプ</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">费用折扣或信用类型</skos:altLabel>
        <skos:definition>A Fee Discount or Credit Type is a specific type of discount or credit offered in the context of legal services, which reduces the amount of fees charged to the client.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9cB1UdsSPUHqk2F6LnDU4s -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9cB1UdsSPUHqk2F6LnDU4s">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
        <rdfs:label>Actions Taken by Buyer Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Acciones Tomadas por el Comprador</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acciones Tomadas por el Comprador</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Actions Taken by Buyer Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Actions prises par l&apos;acheteur</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Ações tomadas pelo comprador</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vom Käufer ergriffene Maßnahmen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פעולות שננקטו על ידי הקונה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खरीदार भाषा द्वारा की गई कार्रवाई</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">买方采取的行动</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">買い手による措置</skos:altLabel>
        <skos:definition>Actions Taken by Buyer Language refers to the specific provisions and clauses included in a contract by the buyer to protect themselves from any negative consequences that may arise after the acquisition of a company, and which are exempted from the Material Adverse Effect definition.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9cEuVuOq3LFLnpRBWR2FfB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9cEuVuOq3LFLnpRBWR2FfB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8iqvgE2NjybgksTeqsGhr3"/>
