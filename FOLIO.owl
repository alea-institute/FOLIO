        <rdfs:label>Agents and Managers for Artists, Athletes, Entertainers, and Other Public Figures</rdfs:label>
        <skos:definition>See industry description for 711410.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Vh_0VPk6TBSZaKwlDwbrCA -->

