                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBmVfFGPaLW8uopGsgeSVfy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Nondisclosure Agreement</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Accord de non-divulgation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Acordo de confidencialidade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acuerdo de confidencialidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de confidencialidad</skos:altLabel>
        <skos:altLabel>Non Disclosure Agreement</skos:altLabel>
        <skos:altLabel>Non-disclosure Agreement</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Nondisclosure Agreement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vertraulichkeitsvereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הסכם סודיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गोपनीयता समझौता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保密协议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">秘密保持契約</skos:altLabel>
        <skos:definition>A Nondisclosure Agreement (NDA) is a legal contract between two or more parties that outlines confidential material, knowledge, or information that the parties wish to share with one another for certain purposes, but wish to restrict access to or by third parties.</skos:definition>
        <skos:prefLabel>NDA</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Kz1SpfoudXPH8dRbdIlkO -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Kz1SpfoudXPH8dRbdIlkO">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCtUZjZqZ1lszDFiDOLUuTh"/>
        <rdfs:label>Illinois Circuit Court - Rock Island County (14th Circuit Court)</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8KzUPYg1EIWzWsZMsBs0OE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8KzUPYg1EIWzWsZMsBs0OE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ztXl8BwOPON0CMPeL83QD"/>
        <rdfs:label>Carrots</rdfs:label>
        <skos:altLabel>Daucus Carota Sativus</skos:altLabel>
        <skos:definition>Carrots are root vegetables belonging to the Daucus carota species, typically characterized by their elongated, tapering shape and orange color, although other colors exist. They are cultivated for their edible taproot, which is rich in beta-carotene and other nutrients, and are widely used in culinary applications and as animal feed.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8L0VeDT62kbpCDGP2YgEs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8L0VeDT62kbpCDGP2YgEs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Hh6KeMR56ynN9kPCNDHTl"/>
        <rdfs:label>Administrative Mandate</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Administrative Mandate</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mandat administratif</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mandato Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mandato Administrativo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Mandato administrativo</skos:altLabel>
