    <!-- https://folio.openlegalstandard.org/RBJ0dgV4Z2Xk7aGfJt2nSj7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJ0dgV4Z2Xk7aGfJt2nSj7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm"/>
        <rdfs:label>Immune System Disorders</rdfs:label>
        <skos:altLabel>Immunodeficiency Diseases</skos:altLabel>
        <skos:definition>Immune system disorders are conditions that result from abnormalities in the immune system, leading to improper immune responses. These disorders include a wide range of diseases, such as autoimmune diseases, immune deficiency disorders, and hypersensitivity reactions, which can cause significant impairment in the body&apos;s ability to fight infections and maintain homeostasis.</skos:definition>
        <skos:prefLabel>Immunological Disorders</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJ4HPUl2DrL4G30lmoFKJN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJ4HPUl2DrL4G30lmoFKJN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBkL8I5saFF7mqpLTI7GxSh"/>
        <rdfs:label>Transactional Document</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Document transactionnel</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Documento transaccional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Documento transaccional</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Documento transacional</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transactional Document</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Transaktionsdokument</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מסמך עסקי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लेन-देन दस्तावेज़</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">交易文件</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">取引文書</skos:altLabel>
        <skos:definition>A Transactional Document is a written or recorded representation of a legal agreement or transaction, such as a contract or deed, that memorializes the terms and conditions of the agreement between parties.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJ539i2zjZ7GGvJz0xJBmF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJ539i2zjZ7GGvJz0xJBmF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
        <rdfs:label>Origination Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Behauptung der Ursprungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Origination Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de la Cláusula de Origen</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de la Cláusula de Origen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Originação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Revendication de la clause d&apos;origine</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף המקור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">उत्पत्ति शर्त दावा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">起源条款索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">起源条項クレーム</skos:altLabel>
        <skos:definition>An Origination Clause claim refers to a legal argument challenging the constitutionality of a bill or law based on the requirement in the United States Constitution that revenue-raising bills must originate in the House of Representatives. This claim asserts that a particular law violates the Origination Clause by originating in the wrong legislative chamber, potentially rendering it invalid or unconstitutional.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJ6A3S5334Ger54kVnawXS -->

