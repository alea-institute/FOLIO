    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/wLPY4QkERcWafkpqOnVrwQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/wLPY4QkERcWafkpqOnVrwQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/1pmSUI3pSqONDRIfnummbw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=713930"/>
        <rdfs:label>Marinas</rdfs:label>
        <skos:definition>This industry comprises establishments, commonly known as marinas, engaged in operating docking and/or storage facilities for pleasure craft owners, with or without one or more related activities, such as retailing fuel and marine supplies; and repairing, maintaining, or renting pleasure boats.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/wOCdzDoJQO6q8hs6SwU5ow -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/wOCdzDoJQO6q8hs6SwU5ow">
