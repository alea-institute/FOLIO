        <rdfs:label>Motion for Appointment of Ombudsman</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ernennung eines Ombudsmanns</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para la designación de un Defensor del Pueblo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para la designación de un Ombudsman</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Appointment of Ombudsman</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para nomeação de ombudsman</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en nomination d&apos;un médiateur</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הצעת חוק למינוי אמבודסמן</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ओम्बड्समैन की नियुक्ति के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">オンブズマンの任命に関する請願</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">任命调解员动议</skos:altLabel>
        <skos:definition>A Motion for Appointment of Ombudsman is a request made in a bankruptcy case for the appointment of an independent third party to investigate and resolve disputes between the debtor and creditors.</skos:definition>
    </owl:Class>
    


