    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDeWjTZogrlt1XvduSP1R8s -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDeWjTZogrlt1XvduSP1R8s">
