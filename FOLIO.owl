                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8xSzwRnuQy4kqrATCJ6awq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9wXEpicPBDF420JUfmdsD8"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Substance Abuse Policy</rdfs:label>
        <skos:definition>A substance abuse policy is a formal document established by an organization to outline its stance on the use, possession, and distribution of drugs and alcohol in the workplace. It aims to ensure a safe and productive work environment by defining prohibited behaviors, setting forth procedures for testing and handling violations, and providing resources for prevention and treatment.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9U7CCfNJJ3kqoPAmXEX7aV -->

