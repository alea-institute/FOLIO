            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ACCOUNT_TYPE</rdfs:label>
        <skos:definition>A type of account used in the LEDES98BI V5 Format Rev 1-2020 standard for electronic legal invoicing.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSk58vy4yOtGYBiNHGjAdi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSk58vy4yOtGYBiNHGjAdi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RyXFkz3behDLKJusiUFxnh"/>
        <rdfs:label>Coastal Real Estate Asset</rdfs:label>
        <skos:altLabel>Beachfront Real Estate</skos:altLabel>
        <skos:altLabel>Coastal Property</skos:altLabel>
        <skos:altLabel>Seaside Real Estate</skos:altLabel>
        <skos:definition>A Coastal Real Estate Asset refers to property located along the coastlines of oceans or seas. These assets typically offer scenic views, access to water-based activities, and come with unique environmental and regulatory considerations related to coastal management and conservation.</skos:definition>
        <skos:prefLabel>Oceanfront Property</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSlvXSRrQSEGiNYhyhqkqZQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RSlvXSRrQSEGiNYhyhqkqZQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rn5kG4YdbRjOyGEVaUvrizw"/>
        <rdfs:label>P400 Initial Document Preparation/Filing</rdfs:label>
        <skos:definition>This phase includes all tasks undertaken to prepare transaction documents and opinions prior to their being sent to non-client third parties. Also includes all tasks undertaken to file documents (including regulatory filings). All related communications with the client and review of client generated transaction documentation should be coded here.</skos:definition>
        <skos:prefLabel>P400 Initial Document Preparation/Filing</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RSlwAS5uNtWAdCEahR3Sf2 -->

