        <skos:altLabel xml:lang="hi-in">अपीलीय प्रक्रियात्मक याचिकाएं</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">上诉程序动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">控訴手続きの動議</skos:altLabel>
        <skos:definition>Appellate Procedural Motions are requests made to an appellate court regarding the procedures of a case, such as substituting a party or expediting an appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfdsGohesGRhPjCfwDdBlK -->

