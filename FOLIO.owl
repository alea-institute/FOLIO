        <rdfs:label>Breach of Implied Warranty of Merchantability</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Merchantability</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Incumplimiento de la garantía implícita de comerciabilidad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Incumplimiento de la garantía implícita de comercialización</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung der Handelsfähigkeit</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite de qualité marchande</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de comercialização</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת האחריות המשוררת למסחריות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">व्यापक वारंटी के उल्लंघन का उल्लंघन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">商業上の適格性に関する黙示的保証違反</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反适销性默示保证</skos:altLabel>
        <skos:definition>The Breach of Implied Warranty of Merchantability refers to a situation where a seller fails to provide a product that is fit for its intended purpose, even though no express warranty was given.</skos:definition>
    </owl:Class>
    


