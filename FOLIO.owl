        <rdfs:label>Employment-Based Immigration Request</rdfs:label>
        <skos:definition>An Employment-Based Immigration Request is a type of immigration application in which an individual seeks entry or residency in a destination country based on a job offer or employment opportunity. The sponsoring employer usually files petitions and necessary documents on behalf of the employee, and the process often involves labor certifications and other prerequisites to prove the employment need.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Gb3dVBy5POvEQPuNpy0A9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Gb3dVBy5POvEQPuNpy0A9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
        <rdfs:label>Senior Credit Ranking</rdfs:label>
        <skos:altLabel>Senior Debt Ranking</skos:altLabel>
        <skos:definition>Senior Credit Ranking refers to the priority status of senior debts, which are ranked above senior subordinated, junior, and junior subordinated debts in the event of liquidation. This ranking ensures that senior creditors are paid first from the proceeds of the liquidated assets, providing them with a higher level of security and reducing their risk exposure.</skos:definition>
        <skos:prefLabel>Senior Debt Priority</skos:prefLabel>
    </owl:Class>
    


