        <rdfs:label>Book Retailers and News Dealers</rdfs:label>
        <skos:definition>NULL</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BOu_F2RbSrybYXlvs8l0IA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BOu_F2RbSrybYXlvs8l0IA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Vh_0VPk6TBSZaKwlDwbrCA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=923130"/>
        <rdfs:label>Administration of Human Resource Programs (except Education, Public Health, and Veterans&apos; Affairs Programs)</rdfs:label>
        <skos:definition>This industry comprises government establishments primarily engaged in the planning, administration, and coordination of programs for public assistance, social work, and welfare activities. The administration of Social Security, disability insurance, Medicare, unemployment insurance, and workers&apos; compensation programs are included in this industry.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BP33n_U3Qhadujz1PLanBQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BP33n_U3Qhadujz1PLanBQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4pYCvaJ8nADRG8NCwgCoa"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4238"/>
        <rdfs:label>Machinery, Equipment, and Supplies Merchant Wholesalers</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in the merchant wholesale distribution of construction, mining, farm, garden, industrial, service establishment, and transportation machinery, equipment, and supplies.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BPceootDSmSNz2Nt6FtVuA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BPceootDSmSNz2Nt6FtVuA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/-2gRm-5aTO2n7z3Buw_MRA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32111"/>
        <rdfs:label>Sawmills and Wood Preservation</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) sawing dimension lumber, boards, beams, timber, poles, ties, shingles, shakes, siding, and wood chips from logs or bolts; (2) sawing round wood poles, pilings, and posts and treating them with preservatives; and (3) treating wood sawed, planed, or shaped in other establishments with creosote or other preservatives to prevent decay and to protect against fire and insects.  Sawmills may plane the rough lumber that they make with a planing machine to achieve smoothness and uniformity of size.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BTL-8C11SF2xHMasVRGw7A -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BTL-8C11SF2xHMasVRGw7A">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/kyN-KUDNTweyrC4jbi9QXw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325992"/>
        <rdfs:label>Photographic Film, Paper, Plate, Chemical, and Copy Toner Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing sensitized film, sensitized paper, sensitized cloth, sensitized plates, toners (i.e., for photocopiers, laser printers, and similar electrostatic printing devices), toner cartridges, and photographic chemicals.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/BUU0Ap-qSa2xyhxy7QQJuQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/BUU0Ap-qSa2xyhxy7QQJuQ">
