        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RhNl96zoCgI6solrSRV55Z"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Negligent Failure to Warn of Dangerous Condition</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Défaut négligent d&apos;avertir d&apos;une condition dangereuse</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fahrlässiges Versäumnis, vor gefährlichen Bedingungen zu warnen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Falha negligente em alertar sobre condição perigosa</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Falta negligente de advertencia sobre una condición peligrosa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Falta negligente de advertencia sobre una condición peligrosa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negligent Failure to Warn of Dangerous Condition</skos:altLabel>
        <skos:altLabel xml:lang="he-il">כשל לאזהר על מצב מסוכן באופן שגוי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खतरनाक स्थिति की चेतावनी करने में लापरवाही से असफलता</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">危険な状態の警告の怠慢な不履行</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">疏忽未能警告危险情况</skos:altLabel>
        <skos:definition>Negligent Failure to Warn of Dangerous Condition refers to a legal claim made by an individual who has suffered harm due to a failure to warn of a dangerous condition, where the failure to warn was due to negligence.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7NMdyMuLrZYEdmZV4gNBCx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7NMdyMuLrZYEdmZV4gNBCx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDFRUssa9OxEwcySpHx8iby"/>
        <rdfs:label>Commercial Mortgage-Backed Securities</rdfs:label>
        <skos:altLabel>CMBS</skos:altLabel>
        <skos:definition>Commercial Mortgage-Backed Securities (CMBS) are a type of asset-backed security backed by a pool of commercial real estate loans, such as those for office buildings, hotels, shopping centers, and other income-generating properties. Investors in CMBS receive payments from the principal and interest collected on the underlying commercial mortgages, offering exposure to the commercial real estate market.</skos:definition>
        <skos:prefLabel>Commercial MBS</skos:prefLabel>
    </owl:Class>
    


