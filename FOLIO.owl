        <skos:altLabel xml:lang="en-gb">Minor in Possession of Alcohol</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קטן בבעלות אלכוהול</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">शराब के साथ अवैध रूप से नाबालिग होना</skos:altLabel>
