        <rdfs:label>450 Commerce (PACER NoS)</rdfs:label>
        <skos:definition>Action filed under the Interstate Commerce Acts 49:1 et seq., 49:301</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7a6EyWsqfhBLYPLP3eb0HY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7a6EyWsqfhBLYPLP3eb0HY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkB4hqzLrfXeDv4AyntCzX"/>
        <rdfs:isDefinedBy>PACER https://www.ca2.uscourts.gov/clerk/case_filing/electronic_filing/how_to_use_cmecf/filing_types.html</rdfs:isDefinedBy>
        <rdfs:label>Transcript Appendix</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Annexe de transcription</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Apéndice de Transcripción</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Apéndice de Transcripción</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Apêndice de transcrição</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transcript Appendix</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Transkript-Anhang</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נספח תמליל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ट्रांसक्रिप्ट अपेंडिक्स</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">成绩单附录</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">記録付録</skos:altLabel>
        <skos:definition>A transcript appendix is a supplementary section of a document that includes a written or recorded record of spoken words, typically used in legal proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aBbOhIQLuwrLOympuadoq -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aBbOhIQLuwrLOympuadoq">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3391bdB1A2adE51071C7cf7"/>
        <rdfs:label>New York District Court</rdfs:label>
        <skos:definition>The New York District Court is a trial court within the New York State Courts system, with jurisdiction over civil and criminal cases in a specific geographic area within the state.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aFBns3Z2d9MuNI5sDEGxF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aFBns3Z2d9MuNI5sDEGxF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R73Uo5x4VyfiOXt6i4R256t"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBEXxc9B6kR2p0BMwGjhWGW"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
        <rdfs:label>Deportation</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abschiebung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Deportación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Deportación</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Deportation</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Deportação</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Déportation</skos:altLabel>
        <skos:altLabel xml:lang="he-il">גירושין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">निर्वासन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">強制送還</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">驱逐</skos:altLabel>
        <skos:definition>The forced removal of a person from a country by the government as a consequence of violating immigration laws or committing a crime.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aHk2AkuO60xkjZ0nGpV70 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aHk2AkuO60xkjZ0nGpV70">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nREeU6lB0zs0dt9N339nm"/>
        <rdfs:label>Disinterested</rdfs:label>
        <skos:altLabel>Impartial</skos:altLabel>
        <skos:altLabel>Unbiased</skos:altLabel>
        <skos:definition>The attribute &quot;disinterested&quot; refers to parties, often trustees or professionals, who have no personal interest in the outcome of the proceedings and no prior relationship with the debtor or creditors. Disinterested parties ensure unbiased administration and decision-making, fostering fairness and integrity in the process.</skos:definition>
        <skos:prefLabel>Neutral</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aOV3ldC5GVaSOcGua7Nqs -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aOV3ldC5GVaSOcGua7Nqs">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBuYThXwp8tJjNWkTeuFvAZ"/>
        <rdfs:label>Expired Parking Violation</rdfs:label>
        <skos:definition>This occurs when a vehicle is parked in a regulated space beyond the time limit indicated on a parking meter or permit. The violation is typically enforced through a citation and fine issued by parking enforcement officers.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aPdNazR2TDAE03Nhekjx -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aPdNazR2TDAE03Nhekjx">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGK6KYY8XqLTyeigvEAIOg"/>
        <rdfs:label>Meal Break</rdfs:label>
        <skos:definition>A &quot;Meal Break&quot; is a period of time during the workday, typically lasting 30 minutes to an hour, in which employees are allowed to stop working and have a meal. This break is often unpaid and is intended to provide employees with the opportunity to eat and recharge.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aSm1AVSKBVx8el1HZUrxw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aSm1AVSKBVx8el1HZUrxw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Conflict of Interest Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de conflit d&apos;intérêts</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Conflicto de Intereses</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Conflicto de Intereses</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de conflito de interesses</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Conflict of Interest Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Vermeidung von Interessenkonflikten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף עימות עניינים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">हितधर्म विसंगति शर्त</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">利益冲突条款</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">利益相反条項</skos:altLabel>
        <skos:definition>A Conflict of Interest Clause is a provision in a contract that requires the parties involved to disclose any potential conflicts of interest that may arise during the course of their relationship.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aTogftBWxHCdIJBM31Q3X -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aTogftBWxHCdIJBM31Q3X">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBREngQZS9QIgeWCOMPBLIo"/>
        <rdfs:label>School Liability Claims</rdfs:label>
        <skos:altLabel xml:lang="de-de">Ansprüche wegen Schulhaftung</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Demandas de responsabilidad escolar</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamaciones de responsabilidad escolar</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicações de responsabilidade escolar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamations de responsabilité scolaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">School Liability Claims</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעות אחריות בבתי ספר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">स्कूल दायित्व दावे</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">学校の責任請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">学校责任索赔</skos:altLabel>
        <skos:definition>School Liability Claims: Legal claims brought against educational institutions for damages or injuries caused by the institution&apos;s negligence or failure to provide a safe environment for students.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7aZgPyFypRCPoD3uONOvJ0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7aZgPyFypRCPoD3uONOvJ0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8wEzsnWA30YRmdfZKRkFuH"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9G5Ptc8g9T3Ag0GDVQOwae"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Claim Construction Brief</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anspruchskonstruktionskurzdarstellung</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Breve construção de reivindicação</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Breve de Construcción de Reclamaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Breve de Construcción de Reivindicaciones</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Brève construction de revendication</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Claim Construction Brief</skos:altLabel>
        <skos:altLabel>Markman</skos:altLabel>
        <skos:altLabel>Markman Brief</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקציר בניית טענות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दावा निर्माण संक्षिप्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">クレーム構築の概要</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">权利要求构建简介</skos:altLabel>
        <skos:definition>A Claim Construction (Markman) Brief is a written document submitted to a court that provides an interpretation of the language used in patent claims, specifically for the purpose of determining the scope of the patent.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ad12pe2psHapASxpXGsk1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ad12pe2psHapASxpXGsk1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8D6zCNSxUO8g0ZstLxnK28"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/3.00-Respiratory-Adult.htm#3_07"/>
        <rdfs:label>Bronchiectasis</rdfs:label>
        <skos:altLabel>Abnormal Bronchial Dilation</skos:altLabel>
        <skos:altLabel>Bronchial Dilation</skos:altLabel>
        <skos:altLabel>Persistent Bronchial Expansion</skos:altLabel>
        <skos:definition>Bronchiectasis is a chronic respiratory condition characterized by abnormal and permanent dilation of the bronchial tubes, leading to impaired mucus clearance, chronic cough, and frequent respiratory infections. This condition results from damage to the airway walls, which can be caused by a variety of factors, including infections, genetic disorders, and autoimmune diseases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7afrfWXgffBUFBsbsa0E6Z -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7afrfWXgffBUFBsbsa0E6Z">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwipRpN2mP7u4u1N74MVzK"/>
        <rdfs:label>Negative Commerce Clause Claim</rdfs:label>
        <skos:altLabel xml:lang="de-de">Klage wegen Verletzung des negativen Handelsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Negative Commerce Clause Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Comercio Negativo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Comercio Negativo</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de comércio negativa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de clause de commerce négative</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת סעיף המסחר השלילי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">नकारात्मक वाणिज्य अनुबंध दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ネガティブ商業条項クレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">负面商业条款索赔</skos:altLabel>
        <skos:definition>A Negative Commerce Clause claim is a legal argument asserting that a state law or regulation violates the United States Constitution by unduly burdening or discriminating against interstate commerce, even in the absence of federal legislation. This claim is based on the interpretation that the Negative Commerce Clause prohibits states from imposing unreasonable barriers on interstate trade and commerce, thereby ensuring a free and fair flow of goods and services between states.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ahfB1BbtNvve47RAqswqA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ahfB1BbtNvve47RAqswqA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
        <rdfs:label>Blacklisting Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Blacklisting Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de inclusión en lista negra</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de inclusión en lista negra</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de lista negra</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de liste noire</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Schwarze-Liste-Anspruch</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעת רישום ברשימה שחורה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">काली सूची दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ブラックリストクレーム</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">黑名单索赔</skos:altLabel>
        <skos:definition>A blacklisting claim refers to a legal action taken by an individual or entity who alleges they have been unfairly prevented from obtaining employment, services, or opportunities due to being placed on a &quot;blacklist.&quot; A blacklist is an unofficial list of persons or entities that are deemed undesirable or untrustworthy, resulting in exclusion from certain opportunities or associations.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7alL3ThuE851s7NQLQmXZX -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7alL3ThuE851s7NQLQmXZX">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Forfeiture Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de déchéance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Forfeiture</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Pérdida</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de perda</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forfeiture Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verfallsklausel</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף מחילות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फोर्फेचर क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">没収条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">没收条款</skos:altLabel>
        <skos:definition>A forfeiture clause is a provision in a contract that allows one party to forfeit or lose their right to something, such as a deposit, if they fail to meet certain obligations outlined in the contract.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7arGvfMggUy3bSTuJ2l3aY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7arGvfMggUy3bSTuJ2l3aY">
