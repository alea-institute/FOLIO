        <skos:definition>The concept of &quot;Unfair Collection Practices&quot; refers to any actions taken by debt collectors that are deemed to be abusive, deceptive, or unfair towards consumers, and can result in legal claims against the collectors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RkFwuqn5BPx3sEHetAAePg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RkFwuqn5BPx3sEHetAAePg">
