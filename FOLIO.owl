        <skos:altLabel xml:lang="zh-cn">隆迪语</skos:altLabel>
        <skos:definition>Rundi is a structured system of communication that consists of grammar and vocabulary, and is a member of the language family.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOfHufoKKV4QprPsIqnqM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDOfHufoKKV4QprPsIqnqM">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85Imx70Iv0XY38PT8gfM6z"/>
        <rdfs:label>Family Petition For Intracompany Transferees</rdfs:label>
        <skos:definition>An L-2 Petition allows the immediate family members of L-1 visa holders, specifically their spouses and unmarried children under 21, to accompany or join the primary visa holder in the U.S. This petition facilitates the entry and stay of dependents of L-1 visa holders.</skos:definition>
        <skos:prefLabel>L-2 Petition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDOff54WFJRA9Y4mtNSQtsB -->

