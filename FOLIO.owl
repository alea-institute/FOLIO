        <skos:altLabel>Commercial Content</skos:altLabel>
        <skos:altLabel>Marketing Asset</skos:altLabel>
        <skos:altLabel>Marketing Content</skos:altLabel>
        <skos:altLabel>Promotional Material</skos:altLabel>
        <skos:definition>An Advertisement, as a type of copyright asset, is a creative work designed to promote products, services, or ideas, protected under copyright law. This includes various forms of media such as print, digital, audio, and visual content, ensuring exclusive rights to the creator or owner against unauthorized use.</skos:definition>
        <skos:prefLabel>Advertising Asset</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RYtULK5FVUYCKpDMVJVgM8 -->

