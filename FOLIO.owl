        <skos:altLabel xml:lang="pt-br">Cláusula de Diretor Emérito</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Director Emeritus Clause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Direktor Emeritus Klausel</skos:altLabel>
