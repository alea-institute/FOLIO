        <skos:altLabel xml:lang="pt-br">Nyoro</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Nyoro</skos:altLabel>
        <skos:definition>Nyoro is a structured system of communication that consists of grammar and vocabulary, and is a language within the context of legal matters.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9TyJ8yqLicto5rFa8puek4 -->

