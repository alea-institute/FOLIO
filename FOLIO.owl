        <rdfs:label>Ownership Type Attributes</rdfs:label>
        <skos:altLabel>Share Type Attributes</skos:altLabel>
        <skos:definition>Ownership Type Attributes refer to the specific characteristics and categories of shares that represent ownership in a company. These attributes include distinctions such as common shares, ordinary shares, and preferred shares, each with unique rights, privileges, and obligations.</skos:definition>
        <skos:prefLabel>Equity Type Attributes</skos:prefLabel>
    </owl:Class>
    


