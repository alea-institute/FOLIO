        <skos:altLabel xml:lang="zh-cn">许可权条款</skos:altLabel>
        <skos:definition>A Licensed Rights Clause is a provision in a contract that grants permission to use or distribute a specific product or service, subject to certain conditions and limitations.</skos:definition>
    </owl:Class>
    


