        <rdfs:label>Dangerous Condition of Premises</rdfs:label>
        <skos:altLabel xml:lang="es-es">Condición Peligrosa de las Instalaciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Condición Peligrosa de las Instalaciones</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Condição perigosa das instalações</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dangerosité de l&apos;état des locaux</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dangerous Condition of Premises</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gefährlicher Zustand von Räumlichkeiten</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מצב מסוכן של הנכס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">भूमि की खतरनाक स्थिति</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">场所危险状态</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">建物の危険な状態</skos:altLabel>
        <skos:definition>A dangerous condition of premises refers to a hazardous situation or circumstance on a property that poses a risk of harm or injury to individuals who are lawfully present on the premises.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RhODoZEsVZp3nkeCKtJhmL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RhODoZEsVZp3nkeCKtJhmL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCv6Kq9tkPBxjujeEY7MyL9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Main Proceeding (Foreign Insolvency)</rdfs:label>
        <skos:definition>A main proceeding in foreign insolvency is the primary insolvency case initiated in the debtor&apos;s center of main interests (COMI), typically where the debtor&apos;s principal place of business is located. This proceeding takes precedence over other insolvency proceedings and serves as the primary forum for administering the debtor&apos;s assets and restructuring efforts.</skos:definition>
    </owl:Class>
    


