        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxWrCyEH6sVtwYoR6elPPp"/>
        <rdfs:label>Olives</rdfs:label>
        <skos:altLabel>Olea Europaea</skos:altLabel>
        <skos:definition>Olives are small, oval fruits from the Olea europaea tree, known for their culinary and oil-producing uses. They are consumed as table olives or processed into olive oil, valued for their rich flavor, healthy fats, and nutritional benefits, including antioxidants and vitamins.</skos:definition>
    </owl:Class>
    


