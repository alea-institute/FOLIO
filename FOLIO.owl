        <skos:altLabel xml:lang="de-de">Fehlende Zuständigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Lack of Subject Matter Jurisdiction</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חוסר סמכות תחום נושא</skos:altLabel>
