            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Eviction (Event)</rdfs:label>
        <skos:definition>Eviction is a legal process by which a landlord forces a tenant to leave a rented property, typically due to nonpayment of rent, lease violations, or other breaches of the rental agreement. The process involves court proceedings, notice requirements, and, if ordered by the court, law enforcement intervention to remove the tenant from the property.</skos:definition>
        <skos:prefLabel>Eviction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7fBgPMKM2CgXRYzs5jY323 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7fBgPMKM2CgXRYzs5jY323">
