        <skos:altLabel xml:lang="de-de">Antrag auf Intervention</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Intervención</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Intervención</skos:altLabel>
