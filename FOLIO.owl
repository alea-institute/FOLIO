        <rdfs:label>Fees of Court Clerk or Marshal</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Fees of Court Clerk or Marshal</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Frais du greffier ou du marshal de la cour</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gebühren des Gerichtsschreibers oder Marshals</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Honorarios del Secretario o Alguacil del Tribunal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Honorarios del Secretario o Alguacil del Tribunal</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Taxas do escrivão ou do marechal do tribunal</skos:altLabel>
        <skos:altLabel xml:lang="he-il">דמי מזכיר בית המשפט או מרשל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">कोर्ट क्लर्क या मार्शल के शुल्क</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法院书记员或元帅的费用</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">裁判所の書記官またはマーシャルの手数料</skos:altLabel>
        <skos:definition>The Fees of Court Clerk or Marshal refer to the charges imposed by the court clerk or marshal for their services rendered in a legal matter, which are included in the overall Court Costs.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8QA8463ZVLrPCfw6Jjdwd4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8QA8463ZVLrPCfw6Jjdwd4">
