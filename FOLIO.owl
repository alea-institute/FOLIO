        <skos:altLabel xml:lang="es-es">Gastos de transcripción de declaraciones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Gastos de transcripción de deposiciones</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kosten für die Transkription von Zeugenaussagen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הוצאות תמלילי הפגישות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गवाही ट्रांसक्रिप्ट व्यय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">証言記録費用</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">证言记录费用</skos:altLabel>
        <skos:definition>The Deposition Transcripts Expense refers to the cost incurred by a party in a legal matter for obtaining a written record of a witness&apos;s testimony given under oath outside of court proceedings.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7J5tsgW4oZHjUWIol2tkAg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7J5tsgW4oZHjUWIol2tkAg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
        <rdfs:label>Out of Immigration Status</rdfs:label>
        <skos:altLabel>Out of Status</skos:altLabel>
        <skos:definition>&quot;Out of Status&quot; refers to the condition where an individual has violated the terms of their visa or other immigration authorization. This could involve overstaying the duration specified on their visa, working without proper authorization, or failing to maintain enrollment in a study program, among other infractions.</skos:definition>
        <skos:prefLabel>Undocumented Status</skos:prefLabel>
    </owl:Class>
    


