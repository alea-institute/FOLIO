        <rdfs:label>Motion to Settle</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Erledigung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Acuerdo</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Convenio</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Settle</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição de Acordo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en règlement</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועה להסדר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समझौते के लिए आवेदन</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">和解申立</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">结案动议</skos:altLabel>
        <skos:definition>A Motion to Settle is a legal request made by one party to a lawsuit to resolve the case through a mutually agreed upon settlement, rather than proceeding to trial.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaWObOphVqdpQ8MspdRMci -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaWObOphVqdpQ8MspdRMci">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq7yrbwVSqS8fuRtnzDx6g"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RzN0lEecajkj9LkgP3LBQ4"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Advertising Law</rdfs:label>
        <skos:definition>Advertising Law regulates the practices and methods of promoting products, services, and brands to ensure that advertisements are truthful, non-deceptive, and fair. It encompasses regulations on commercial speech, consumer protection, and compliance with industry standards.</skos:definition>
        <skos:prefLabel>Marketing Law</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaYhztvtpscasYcvEpQB8U -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaYhztvtpscasYcvEpQB8U">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Retention Bonus Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de prime de rétention</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de bonificación por retención</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de bonificación por retención</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de bônus de retenção</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Aufbewahrungsprämie</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Retention Bonus Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף בונוס החזקה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रिटेंशन बोनस क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">留任ボーナス条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">留任奖金条款</skos:altLabel>
        <skos:definition>A retention bonus clause is a provision in a contract that offers an incentive payment to an employee to encourage them to remain with the company for a specified period of time.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Raa0PzFhxKvb9wz31HZ0gv -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Raa0PzFhxKvb9wz31HZ0gv">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rnaTadzLe6EuX6FHVxEvF"/>
        <rdfs:label>Bankruptcy Schedule - Income</rdfs:label>
        <skos:altLabel>Earnings Disclosure</skos:altLabel>
        <skos:altLabel>Earnings Schedule</skos:altLabel>
        <skos:altLabel>Income Statement</skos:altLabel>
        <skos:definition>Bankruptcy Schedule - Income, also known as Schedule I, requires the debtor to disclose all sources of income, including wages, salaries, business income, rental income, and other earnings. This schedule provides a detailed account of the debtor&apos;s financial resources, helping the court and creditors assess the debtor&apos;s ability to repay debts.</skos:definition>
        <skos:prefLabel>Schedule I</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Raa2imyBqrpa2SmbpG5lj5 -->

