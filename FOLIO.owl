        <skos:altLabel xml:lang="es-es">Acuerdo de transporte</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acuerdo de transporte</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Transportation Agreement</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Transportvereinbarung</skos:altLabel>
