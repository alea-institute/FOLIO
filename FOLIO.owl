        <skos:altLabel xml:lang="de-de">Gesetze</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Legislation</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Lois</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">法令</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">法规</skos:altLabel>
        <skos:definition>A law enacted by a government&apos;s legislative branch.</skos:definition>
        <skos:prefLabel>Codes</skos:prefLabel>
    </owl:Class>
    


