        <rdfs:label>Malicious Prosecution</rdfs:label>
        <skos:altLabel xml:lang="de-de">Böswillige Strafverfolgung</skos:altLabel>
        <skos:altLabel>Malicious Abuse of Legal Process</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Malicious Prosecution</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Persecução Maliciosa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Poursuite malveillante</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Procedimiento Malicioso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Proceso Malicioso</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה מתועבת</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दुर्व्यवहारपूर्ण अभियोग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">恶意起诉</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">悪質な起訴</skos:altLabel>
        <skos:definition>The concept of Malicious Prosecution refers to the intentional and wrongful use of legal process against another person, without probable cause and with malice, resulting in damages to the victim.</skos:definition>
    </owl:Class>
    


