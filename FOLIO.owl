        <rdfs:label>Burns</rdfs:label>
        <skos:altLabel>Thermal Injuries</skos:altLabel>
        <skos:definition>Burns are injuries to the skin or other tissues caused by exposure to heat, chemicals, electricity, or radiation. They are categorized by severity into first, second, third, and fourth degrees based on the depth and extent of tissue damage.</skos:definition>
        <skos:prefLabel>Skin Burns</skos:prefLabel>
    </owl:Class>
    


