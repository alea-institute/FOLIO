            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>340 Marine (PACER NoS)</rdfs:label>
        <skos:definition>Action (Admiralty and Maritime) alleging personal injury or death from an accident involving a water vessel or harbor/dock facilities, including suits brought under the Jones Act and the Limitation of Liability Act. (Excludes marine product liability claims)</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8iaSMweBcBegYYI9g2byVW -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8iaSMweBcBegYYI9g2byVW">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
        <rdfs:label>Fee Tail Estate</rdfs:label>
        <skos:definition>A Fee Tail Estate is a form of property ownership in which land is granted to an individual and the heirs of their body, limiting inheritance to direct descendants and preventing the property from being sold or transferred outside the family line. This archaic legal concept was designed to keep estates within families for generations.</skos:definition>
        <skos:prefLabel>Hereditary-Restricted Property Ownership</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ibMTtrBCWGIGOeFjTLtL0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ibMTtrBCWGIGOeFjTLtL0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV"/>
        <rdfs:label>Correctional Facility - Real Estate Asset</rdfs:label>
        <skos:altLabel>Correctional Facility</skos:altLabel>
        <skos:altLabel>Correctional Property</skos:altLabel>
        <skos:altLabel>Incarceration Facility</skos:altLabel>
        <skos:definition>A Correctional Facility includes properties specifically designed, constructed, and operated to confine individuals who have been arrested, are awaiting trial, or have been convicted of crimes. These assets encompass a range of facilities, including prisons, jails, detention centers, and penitentiaries, and are critical components of the criminal justice system.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ieQwxal23z5ggRO3EN2Wh -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ieQwxal23z5ggRO3EN2Wh">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBE5bLTCIia7wAstjMsnKO"/>
        <rdfs:label>Georgia Superior Court - Washington County</rdfs:label>
        <skos:definition>Georgia Superior Court - Washington County is a specific court within the Georgia Superior Court system that has jurisdiction over legal matters within Washington County, Georgia.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ifKK3H7Ra75thrWRwyh8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ifKK3H7Ra75thrWRwyh8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RILQypXcjvqd1GxNIcqsb7"/>
        <rdfs:label>Chief of Police</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Chief Constable</skos:altLabel>
        <skos:altLabel>Commissioner of Police</skos:altLabel>
        <skos:altLabel>Director of Public Safety</skos:altLabel>
        <skos:altLabel>Head of Police</skos:altLabel>
        <skos:altLabel>Police Chief</skos:altLabel>
        <skos:altLabel>Senior Law Enforcement Official</skos:altLabel>
        <skos:definition>A Chief of Police is the highest-ranking law enforcement officer within a police department or municipal law enforcement agency. This individual is responsible for overseeing all aspects of police operations, including personnel management, policy implementation, and ensuring public safety within their jurisdiction.</skos:definition>
        <skos:example>Los Angeles Police Chief</skos:example>
        <skos:example>Metropolitan Police Commissioner (London)</skos:example>
        <skos:example>New York City Police Commissioner</skos:example>
        <skos:prefLabel>Police Commissioner</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ikwmNh8thc1y2mvVMnLy1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ikwmNh8thc1y2mvVMnLy1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
        <rdfs:label>E104 Facsimile</rdfs:label>
        <skos:definition>A facsimile, which falls under the category of expenses, refers to a document that is transmitted electronically and appears as a copy of the original document.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8ilN2XAU46TLoKcz3nwwkK -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8ilN2XAU46TLoKcz3nwwkK">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJxZ2vqqnde5q8ti6PKfnF"/>
        <rdfs:label>Fabric Impressions</rdfs:label>
        <skos:definition>Fabric impressions are patterns left by fabrics, often clothing, on surfaces or objects. Analysis of these impressions can reveal the type, weave, or specific characteristics of the fabric, aiding in identifying or corroborating details related to a crime scene.</skos:definition>
    </owl:Class>
    


