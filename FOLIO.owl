        <skos:altLabel xml:lang="pt-br">Mentoria</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Mentoring</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mentoring</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mentoría</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mentoría</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מנטורינג</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मेंटरिंग</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">メンタリング</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">导师制度</skos:altLabel>
        <skos:definition>Mentoring refers to the process of providing guidance and support to an individual who has been subject to criminal disposition conditions, with the aim of helping them successfully reintegrate into society.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9MN1G4wnHJd0sU2okv2nwa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9MN1G4wnHJd0sU2okv2nwa">
