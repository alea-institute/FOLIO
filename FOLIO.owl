    <!-- https://folio.openlegalstandard.org/RsMfhxTVe2SIdylrtbIfAj -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsMfhxTVe2SIdylrtbIfAj">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <rdfs:label>Endometrial Cancer</rdfs:label>
        <skos:altLabel>Endometrial Carcinoma</skos:altLabel>
        <skos:definition>Endometrial cancer is a type of cancer that begins in the endometrium, the lining of the uterus. It often presents with abnormal vaginal bleeding and typically requires treatments such as surgery, radiation therapy, and chemotherapy.</skos:definition>
        <skos:prefLabel>Uterine Cancer</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsMwYoqVE3O2RRmXEOZtwl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsMwYoqVE3O2RRmXEOZtwl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RvyyiqOv1WWXcWSX9JVjya"/>
        <rdfs:label>Contact Mobile Phone</rdfs:label>
        <skos:definition>Contact Mobile Phone Number refers to the mobile telephone number associated with an individual serving as a point of contact for a business or organization. This information is commonly used for direct communication and may be stored in databases or directories for easy access.</skos:definition>
        <skos:definition>Mobile Phone Number</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsN5jMsiqL57uIZtgve6CB -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsN5jMsiqL57uIZtgve6CB">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
        <rdfs:label>Withdrawal of Union Shop Authority Claim</rdfs:label>
        <skos:definition>A Withdrawal of Union Shop Authority (UD) Claim is a legal action initiated by an employer or labor organization to terminate or modify a union shop arrangement, which requires all employees in a bargaining unit to become union members as a condition of employment. This claim often arises in the context of changes in labor relations or challenges to the legality of union security clauses.</skos:definition>
        <skos:prefLabel>Union Deauthorization Claim</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RsN9x9sbDJ1uoxxhxVCNgM -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RsN9x9sbDJ1uoxxhxVCNgM">
