    <!-- https://folio.openlegalstandard.org/RDQcIoH7z9XCmcWG8cYFoiT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDQcIoH7z9XCmcWG8cYFoiT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC8DcXod0PuHVIvUZSx8UU9"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxtm6yCTUcImGngCzkPcx0"/>
        <dc:source>Fed. R. Evid. 804(b)(4)</dc:source>
        <rdfs:label>Statement of Personal or Family History</rdfs:label>
        <skos:altLabel>Assertion of Family History</skos:altLabel>
        <skos:altLabel>Assertion of Personal History</skos:altLabel>
        <skos:definition>A Statement of Personal or Family History is a hearsay exception that allows the admission of statements concerning the declarant&apos;s own birth, adoption, marriage, divorce, legitimacy, relationship by blood or marriage, ancestry, or other similar facts of personal or family history. This exception also includes statements concerning the same facts about another person, if the declarant was related to that person by blood, adoption, or marriage.</skos:definition>
    </owl:Class>
    


