        <rdfs:label>Motion for Turnover of Property</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Herausgabe von Eigentum</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para la entrega de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion for Turnover of Property</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Petición de entrega de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para entrega de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de la remise de biens</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למסירת נכסים</skos:altLabel>
