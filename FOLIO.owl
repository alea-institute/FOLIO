        <skos:altLabel xml:lang="es-mx">Intereses posteriores a la sentencia</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Intérêts post-jugement</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Juros pós-julgamento</skos:altLabel>
