        <skos:altLabel xml:lang="pt-br">Luiseno</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Luiseno</skos:altLabel>
        <skos:definition>A Native American language spoken by the Luiseno people in Southern California.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rfgtsl3cveBJQwasdTQZTN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/Rfgtsl3cveBJQwasdTQZTN">
