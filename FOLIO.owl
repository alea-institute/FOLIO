        <skos:altLabel xml:lang="zh-cn">覆盖率 / 利息覆盖</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7jlRhsr5P4uqeoPwH6OOY0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7jlRhsr5P4uqeoPwH6OOY0">
