        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325212"/>
        <rdfs:label>Synthetic Rubber Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing synthetic rubber.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/8OFpmvY5Tj-sYEysscJ30w -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/8OFpmvY5Tj-sYEysscJ30w">
