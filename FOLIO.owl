        <skos:altLabel xml:lang="es-es">Objetivos Regulatorios de Marcas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Objetivos Regulatorios de Marcas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Objetivos regulatórios de marcas</skos:altLabel>
