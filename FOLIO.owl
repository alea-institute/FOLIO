                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCle92dC68FgjvzRNv0eQoF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
        <rdfs:label>Drug Crimes</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Crimes de drogas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Crimes liés aux drogues</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Delitos de Drogas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Delitos de Narcóticos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Drogenverbrechen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Drug Offences</skos:altLabel>
        <skos:altLabel>Narcotic Crimes</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פשעי סמים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">ड्रग अपराध</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">毒品犯罪</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">麻薬犯罪</skos:altLabel>
        <skos:definition>The violation of laws prohibiting the production, distribution, and/or use of certain controlled substances and the equipment or devices utilized in their preparation and/or use.</skos:definition>
        <skos:prefLabel>Controlled Substance Crime</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaBYuS5jx75uCCFVCzLPjk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaBYuS5jx75uCCFVCzLPjk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSOFJGFjyBIx52S43z5Vzc"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9jpIjzc10qdgl78jXOZtfm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Writ of Execution</rdfs:label>
        <skos:altLabel>Enforcement Warrant</skos:altLabel>
        <skos:altLabel>Execution Order</skos:altLabel>
        <skos:altLabel>Levy Order</skos:altLabel>
        <skos:definition>A Writ of Execution is a court order granted to enforce a judgment of possession or to collect on a judgment of monetary damages by allowing the seizure or transfer of the debtor&apos;s property by authorities.</skos:definition>
        <skos:prefLabel>Judgment Enforcement Order</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaBmh0xc5Ks5Nek44dumPI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaBmh0xc5Ks5Nek44dumPI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
        <rdfs:label>Primary Care Negligence</rdfs:label>
        <skos:altLabel xml:lang="de-de">Fahrlässigkeit in der Primärversorgung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Negligencia en Atención Primaria</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Negligencia en Atención Primaria</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Negligência na Atenção Primária</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Négligence en soins primaires</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Primary Care Negligence</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת חובת טיפול ראשוני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्राथमिक देखभाल लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">プライマリケアの過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">初级保健疏忽</skos:altLabel>
        <skos:definition>Negligence by a primary care physician in providing medical treatment or advice to a patient, resulting in harm or injury to the patient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaCNymQDK4cCroLbq84WeE -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaCNymQDK4cCroLbq84WeE">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9M9IxtSoHX1iXJWLIlKnrE"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/6.00-Genitourinary-Adult.htm#6_05"/>
        <rdfs:label>Impairment of Kidney Function</rdfs:label>
        <skos:altLabel>Kidney Dysfunction</skos:altLabel>
        <skos:altLabel>Renal Dysfunction</skos:altLabel>
        <skos:altLabel>Renal Impairment</skos:altLabel>
        <skos:definition>Impairment of kidney function refers to a reduction in the kidneys&apos; ability to filter waste products and excess fluids from the blood. This condition can vary in severity and may lead to chronic kidney disease, necessitating medical management or interventions to prevent further deterioration.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaE0yNxl79wosO0dNpKTnw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaE0yNxl79wosO0dNpKTnw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9MgbwX1P8fNJNx3EbF0gnu"/>
        <rdfs:label>Trial Court Forum</rdfs:label>
        <skos:definition>A Trial Court Forum is a level of court forum where legal proceedings are conducted and judgments are made, typically involving the presentation of evidence and witnesses.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaGE48yicwYTUmAcoEjy0C -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaGE48yicwYTUmAcoEjy0C">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1ceWXE3emNHpYlrOvvmxG"/>
        <rdfs:label>Sac River Band of the Chickamauga - Cherokee</rdfs:label>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaK9Nhu5Alxalhuh4CMCRC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaK9Nhu5Alxalhuh4CMCRC">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RiYwKEna4NZ311TVYJ2yCj"/>
        <rdfs:label>Back Pay</rdfs:label>
        <skos:altLabel>Salary Arrears</skos:altLabel>
        <skos:altLabel>Unpaid Wages</skos:altLabel>
        <skos:altLabel>Wage Arrears</skos:altLabel>
        <skos:definition>Back Pay refers to the wages, benefits, or other forms of compensation owed to an employee for past work performed but not yet paid. This could arise due to miscalculation, wage disputes, legal settlements, or retroactive pay increases.</skos:definition>
        <skos:prefLabel>Retroactive Pay</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaQIRktfYrGWDS7HAq0N6f -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaQIRktfYrGWDS7HAq0N6f">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sdPQV8kCK3BNF8jcPV5cD"/>
        <rdfs:label>Donation</rdfs:label>
        <skos:altLabel>Benefaction</skos:altLabel>
        <skos:altLabel>Contribution</skos:altLabel>
        <skos:altLabel>Endowment</skos:altLabel>
        <skos:altLabel>Grant</skos:altLabel>
        <skos:definition>A Donation is a voluntary gift of money, goods, services, or property given to an individual, organization, or cause without expectation of reciprocation or direct personal benefit. This act of giving is typically motivated by altruism, support for a specific mission or goal, or a desire to contribute to societal well-being.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaSUkwgm6NE3TznRNysK9M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaSUkwgm6NE3TznRNysK9M">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmafyqOLdKzHzFsjz4ro2r"/>
        <rdfs:label>National Upper House Legislator</rdfs:label>
        <skos:altLabel>Member of Upper House</skos:altLabel>
        <skos:altLabel>Upper Chamber Member</skos:altLabel>
        <skos:definition>A National Upper House Legislator is a member of the higher chamber in a bicameral national legislature, typically responsible for providing a check on the lower house and representing broader state or regional interests. This official participates in crafting, debating, and voting on national legislation, often with special powers such as confirming executive appointments or ratifying treaties.</skos:definition>
        <skos:example>U.S. Senator</skos:example>
        <skos:prefLabel>U.S. Senator</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaTFMaI3WJbEKbswbaqFS2 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaTFMaI3WJbEKbswbaqFS2">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzg8mCIjXsMzEVnQwCTKIi"/>
        <rdfs:label>Pennsylvania Court of Common Pleas -  York County</rdfs:label>
        <skos:definition>The Pennsylvania Court of Common Pleas - York County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering civil and criminal proceedings at the county level in Pennsylvania.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RaV7idwCeVbMb3CYq4kEG7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RaV7idwCeVbMb3CYq4kEG7">
