        <rdfs:label>Bankruptcy Motions</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bankruptcy Motions</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Insolvenzanträge</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mociones de bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mociones de quiebra</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motions de faillite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petições de falência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תנועות בקריסת עסקים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन याचिकाएं</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産動議</skos:altLabel>
        <skos:definition>Bankruptcy Motions are written requests made by parties in a bankruptcy case to the court for various purposes, such as to approve a plan, extend time, pay debts, or dismiss a case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9Ij6BH1GeEahrPLtiToNHF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9Ij6BH1GeEahrPLtiToNHF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R71ioUDFC2H7Ndh54CU1rlM"/>
        <rdfs:label>Florida County Court - Hardee County</rdfs:label>
        <skos:definition>A court located in Hardee County, Florida that has jurisdiction over certain legal matters within its geographical boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9IkFUwMggGV4EMZUJMmcMo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9IkFUwMggGV4EMZUJMmcMo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w"/>
        <rdfs:label>Novelty</rdfs:label>
        <skos:definition>Novelty in legal terms signifies that an invention must be new or original, not previously known or used, to be patentable. It ensures that patents are granted only for genuinely new advancements, not for modifications of existing ones.</skos:definition>
    </owl:Class>
    


