        <skos:altLabel xml:lang="ja-jp">ケルト語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">凯尔特语</skos:altLabel>
        <skos:definition>A group of languages spoken in parts of Europe, including Ireland, Scotland, and Wales, that share a common linguistic and cultural heritage.</skos:definition>
