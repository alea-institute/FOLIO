        <rdfs:label>Notice of Proposed Use, Sale, or Lease of Property</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Avis d&apos;utilisation, de vente ou de location proposée de biens</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Aviso de Uso, Venda ou Locação Proposta de Propriedade</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Aviso de Uso, Venta o Arrendamiento Propuesto de Propiedad</skos:altLabel>
