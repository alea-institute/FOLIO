        <skos:definition>The &quot;Invoice Due Date&quot; is a specific detail within the broader concept of &quot;Fee Invoice Detail&quot; and refers to the date by which payment for legal services must be made.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8RWtvqzcTuy24nU1nW19MQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8RWtvqzcTuy24nU1nW19MQ">
