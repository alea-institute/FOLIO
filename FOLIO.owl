        <rdfs:label>Economic Community of West African States</rdfs:label>
        <skos:definition>ECOWAS (Economic Community of West African States): A regional group of fifteen West African countries, founded to promote economic integration across the region.</skos:definition>
        <skos:prefLabel>ECOWAS</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/Rd5U9LwpXnyPC2FrSlAVBv -->

