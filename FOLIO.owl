        <skos:altLabel xml:lang="es-mx">Deterioro intencional de evidencia</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Deterioro intencional de pruebas</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Intentional Spoliation of Evidence</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vorsätzliche Vernichtung von Beweismitteln</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פגיעה מכוונת בראיות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रमाणों के जानबूझकर नष्ट करना</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">意図的な証拠隠滅</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">故意毁证</skos:altLabel>
        <skos:definition>The intentional destruction or alteration of evidence by a party in a legal matter.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xOnSD7ckOYgvhgmXrE6sy -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xOnSD7ckOYgvhgmXrE6sy">
