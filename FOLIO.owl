        <rdfs:label>Virginia State Bar District Committee</rdfs:label>
        <skos:definition>A Virginia State Bar District Committee is a sub-division of the Virginia State Courts responsible for administering and overseeing legal proceedings within a specific geographic area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDfwCFFw23Fb7WhqmrYLBqS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RDfwCFFw23Fb7WhqmrYLBqS">
