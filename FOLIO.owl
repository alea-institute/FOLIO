        <rdfs:label>Antitrust - Vertical Agreement/Conspiracy Claims</rdfs:label>
        <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de Acuerdos Verticales/Conspiración</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de Acuerdos Verticales/Conspiración</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations d&apos;accord/conspiration verticale</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Antitrust - Vertical Agreement/Conspiracy Claims</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de Acordo/Conspiração Vertical</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Kartellrecht - Ansprüche wegen vertikaler Vereinbarungen/Verschwörungen</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות הסכמי אנטיטרוסט עקומים / קונספירציה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - लंबवत समझौता / साज़िश दावे</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反垄断 - 垂直协议/阴谋索赔</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">独占禁止法 - 垂直合意/陰謀主張</skos:altLabel>
