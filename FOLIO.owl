        <rdfs:label>Pedestrian</rdfs:label>
        <skos:altLabel>Wayfarer</skos:altLabel>
        <skos:definition>A pedestrian refers to any person who is on foot, traveling on a surface intended for human passage. This includes individuals walking, running, hiking, or moving via other human-powered means on pathways, sidewalks, crosswalks, or similar public thoroughfares.</skos:definition>
        <skos:prefLabel>Walker</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9R6TG6M7mEmCejpboTihyc -->

