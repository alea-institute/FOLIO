        <skos:altLabel xml:lang="ja-jp">公立学校における祈りの主張</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">公立学校中的祷告要求</skos:altLabel>
        <skos:definition>A claim made by parents alleging that the education system has violated their civil rights by allowing prayer in public schools.</skos:definition>
    </owl:Class>
    


