        <rdfs:label>Connecticut Court of Appeals</rdfs:label>
        <skos:definition>The Connecticut Court of Appeals is a specific intermediate appellate court within the Connecticut State Courts system, responsible for hearing appeals from lower courts in the state.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8bMQuNrTYO2o9Xs17lkH2u -->

