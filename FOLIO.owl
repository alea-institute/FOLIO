        <skos:altLabel xml:lang="hi-in">घाव देखभाल लापरवाही</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">伤口护理过失</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">傷口ケアの過失</skos:altLabel>
        <skos:definition>Negligent or improper treatment of a patient&apos;s wounds by a healthcare professional, resulting in harm or injury, which may lead to a legal claim for medical malpractice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9YgCdNKjdtf7WV2Xdrkof9 -->

