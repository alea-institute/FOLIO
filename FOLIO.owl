    <!-- https://folio.openlegalstandard.org/R89oi9q0gloVKePs2lNWx1T -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R89oi9q0gloVKePs2lNWx1T">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs"/>
        <dc:source rdf:resource="https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_08"/>
        <rdfs:label>Salivary Gland Cancer</rdfs:label>
        <skos:definition>Salivary gland cancer is a malignant neoplasm that originates in the salivary glands, which produce saliva to aid in digestion and maintain oral health. It includes various subtypes depending on the specific gland affected, such as parotid, submandibular, and sublingual glands, and can impact functions like swallowing and speaking.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R89u8Sgmu4092Cu2g8zt7J8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R89u8Sgmu4092Cu2g8zt7J8">
