        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=44921"/>
        <rdfs:label>Electronics and Appliance Retailers</rdfs:label>
        <skos:definition>See industry description for 449210.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/MqQx3WSASiOOx-A9ARPHqw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/MqQx3WSASiOOx-A9ARPHqw">
