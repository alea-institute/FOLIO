        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RP1pWHzFMMBgTeweVm2dwU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tax_on_tax</rdfs:label>
        <skos:definition>&quot;&quot;&quot;Tax-on-Tax&quot;&quot; is a situation where one or more taxes in a tax jurisdiction are based on the sum of the corresponding invoice line item totals AND any other tax amount previously applied to those line item totals. For example, formerly n both Quebec and Prince Edward Island Canada had specific taxes calculated on the sum of the line items plus the federal tax paid on those line items.
&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7Io9U9PqnfjRLxLhRBHLO1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7Io9U9PqnfjRLxLhRBHLO1">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBI5p2rdv7JzHTtGyObrIcl"/>
        <rdfs:label>Bankruptcy Plan Confirmation</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Bankruptcy Plan Confirmation</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Bestätigung des Insolvenzplans</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Confirmación del Plan de Bancarrota</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Confirmación del Plan de Quiebra</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Confirmation du plan de faillite</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Confirmação do Plano de Falência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אישור תוכנית פשיטת רגל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालियापन योजना की पुष्टि</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产计划确认</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産計画の承認</skos:altLabel>
        <skos:definition>The Bankruptcy Plan Confirmation (Event) is the legal process of approving a debtor&apos;s proposed plan for reorganizing their finances and repaying their debts, which occurs within the context of a bankruptcy case.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7IqV5quFMKN1NFsYqqteuD -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7IqV5quFMKN1NFsYqqteuD">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeiXNGpqL4H3jo1g1NobSm"/>
        <rdfs:label>Indiana Circuit Court - Warren County</rdfs:label>
        <skos:definition>A court located in Warren County, Indiana that has jurisdiction over certain legal matters within its designated area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ItETKZAfykvNgICh5RBN4 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ItETKZAfykvNgICh5RBN4">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8D6zCNSxUO8g0ZstLxnK28"/>
        <rdfs:label>Chronic Bronchitis</rdfs:label>
        <skos:altLabel>Chronic Cough</skos:altLabel>
        <skos:altLabel>Chronic Mucous Bronchitis</skos:altLabel>
        <skos:altLabel>Persistent Bronchitis</skos:altLabel>
        <skos:definition>Chronic bronchitis is a type of Chronic Obstructive Pulmonary Disease (COPD) characterized by persistent inflammation of the bronchial tubes, leading to a chronic cough and production of mucus over a period of at least three months per year for two consecutive years. This condition results in narrowed airways and impaired airflow, causing difficulty in breathing and frequent respiratory infections.</skos:definition>
        <skos:prefLabel>Long-Term Bronchial Inflammation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7ItJL7sTHMRx2i7WbPxnik -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7ItJL7sTHMRx2i7WbPxnik">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xpf80TbUte15aQuYy4a12"/>
        <rdfs:label>Geese</rdfs:label>
        <skos:definition>Geese are domesticated waterfowl belonging to the genus Anser and Branta, commonly raised for their meat, eggs, feathers, and down. Known for their grazing habits and strong flocking instincts, geese are often utilized in agriculture for weeding and as guard animals, as well as for their high-quality meat and egg production.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7IurUy8ro7uBQ6cHRDnRP8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7IurUy8ro7uBQ6cHRDnRP8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9sdPQV8kCK3BNF8jcPV5cD"/>
        <rdfs:label>Supersedeas Bond Payment Event</rdfs:label>
        <skos:altLabel>Appeal Security Bond Payment</skos:altLabel>
        <skos:altLabel>Suspension Bond Payment</skos:altLabel>
        <skos:definition>A Supersedeas Bond Payment is the payment of a type of surety bond required by a court from an appellant who seeks to delay payment of a judgment until the appeal is resolved. This bond ensures that the appellee will be compensated if the appellant fails to meet the judgment after the appeal.</skos:definition>
        <skos:prefLabel>Appeal Bond Payment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7IyL6dp9k9JuIaKGhPcczR -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7IyL6dp9k9JuIaKGhPcczR">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9zyvDXyYEEyM7dTnON56uL"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R98LwwW6Zozu5EHwFgpns7"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Fishing License</rdfs:label>
        <skos:definition>A fishing license is an official permit issued by a governing authority that allows individuals to legally catch fish in specific bodies of water during certain times. The purpose of such licenses is to regulate and conserve fish populations, ensuring sustainable practices. To acquire a fishing license, individuals usually pay a fee, and in some jurisdictions, they might also need to complete an educational course or adhere to certain regulations, such as bag and size limits.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7J2SwejNGksmubIaDsRQin -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7J2SwejNGksmubIaDsRQin">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDvQuaxSojEqV7COK0FlBTI"/>
        <rdfs:label>Texas District Court - Tarrant County</rdfs:label>
        <skos:definition>A Texas District Court located in Tarrant County, which is a trial court of general jurisdiction in Texas handling civil and criminal cases.</skos:definition>
    </owl:Class>
    


