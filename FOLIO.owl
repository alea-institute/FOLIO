        <skos:altLabel xml:lang="es-mx">Cláusula de Cobertura de Renta</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Mietdeckungsquote</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Rent Coverage Ratio Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף יחס כיסוי שכירות</skos:altLabel>
