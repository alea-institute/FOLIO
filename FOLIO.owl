        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
        <rdfs:label>Most Favored Customer Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause du client le plus favorisé</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de Cliente Más Favorecido</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de Cliente Más Favorecido</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula do cliente mais favorecido</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel des Meistbegünstigten Kunden</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Most Favored Customer Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף לקוח המועדף ביותר</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सर्वाधिक अनुकूल ग्राहक शर्त</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">最恵国条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">最惠国条款</skos:altLabel>
        <skos:definition>A Most Favored Customer Clause is a provision in a contract that requires one party to offer the same or better terms to the other party as it offers to its most favored customer, ensuring that the other party receives the best possible deal.</skos:definition>
    </owl:Class>
    


