    <!-- https://folio.openlegalstandard.org/RB0NTk0Fdnf8pBJPUc9Yrw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RB0NTk0Fdnf8pBJPUc9Yrw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R9mf4jHGk1EcEkyTBhfv6Zw"/>
            </owl:Restriction>
