        <skos:altLabel xml:lang="es-mx">Infracción de patente - Patentes de utilidad</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Patent Infringement - Utility Patents</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Patentverletzung - Gebrauchsmusterpatente</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Violação de patente - Patentes de utilidade</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הפרת פטנט - פטנטי שימוש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पेटेंट उल्लंघन - यूटिलिटी पेटेंट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">专利侵权 - 实用新型专利</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">特許侵害 - 実用新案特許</skos:altLabel>
        <skos:definition>The unauthorized use, manufacture, sale, or importation of a product or process that is protected by a utility patent.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8NfA8M4UkdbVvVH1UrMgQb -->

