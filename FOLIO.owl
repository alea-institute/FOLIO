        <rdfs:label>Neutral Fact Witness Interview</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Entretien avec un témoin de faits neutre</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Entrevista com testemunha neutra dos fatos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Entrevista neutral a testigos de hechos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Entrevista neutral a testigos de hechos</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Interview mit einem neutralen Tatsachenzeugen</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Neutral Fact Witness Interview</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ראיין עד עצמאי נייטרלי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">न्यूट्रल फैक्ट गवाह साक्षात्कार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">中立事实证人采访</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">中立的事実証人へのインタビュー</skos:altLabel>
        <skos:definition>A Neutral Fact Witness Interview is an interview conducted by an unbiased party with a person who has knowledge of a situation, without taking any side or expressing any opinion.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RxIAXZIbLd8oSF4ZgqZVdF -->

