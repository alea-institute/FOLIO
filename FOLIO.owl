    <!-- https://folio.openlegalstandard.org/9vXTZzIjTxSQuke4ceOKJQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/9vXTZzIjTxSQuke4ceOKJQ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCaeZbTg74NX3xyNzskpVH8"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3118"/>
        <rdfs:label>Bakeries and Tortilla Manufacturing</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in one of the following: (1) manufacturing fresh and frozen bread and other bakery products; (2) retailing bread and other bakery products not for immediate consumption made on the premises from flour, not from prepared dough; (3) manufacturing cookies, crackers, and dry pasta; (4) manufacturing prepared flour mixes or dough from flour ground elsewhere; or (5) manufacturing tortillas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/9xi9zob-TjalizJYugTRHw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/9xi9zob-TjalizJYugTRHw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/gc05XgiIRYmVHrg3IjevCw"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=312113"/>
        <rdfs:label>Ice Manufacturing</rdfs:label>
        <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing ice.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/9xzYzeBZRhCxExqFWRLZkg -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/9xzYzeBZRhCxExqFWRLZkg">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/9OG4cvlYR7OivuWaJgh3CA"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561210"/>
        <rdfs:label>Facilities Support Services</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in providing operating staff to perform a combination of support services within a client&apos;s facilities. Establishments in this industry typically provide a combination of services, such as janitorial, maintenance, trash disposal, guard and security, mail routing, reception, laundry, and related services to support operations within facilities. These establishments provide operating staff to carry out these support activities, but are not involved with or responsible for the core business or activities of the client. Establishments providing facilities (except computer and/or data processing) operation support services and establishments providing private jail services or operating correctional facilities (i.e., jails) on a contract or fee basis are included in this industry.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/9yIWfAOaT3Sff7Jf3jc5Gw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/9yIWfAOaT3Sff7Jf3jc5Gw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/bnBzf24zSFSpgxwo8AjWDQ"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561720"/>
        <rdfs:label>Janitorial Services</rdfs:label>
        <skos:definition>This industry comprises establishments primarily engaged in cleaning building interiors, interiors of transportation equipment (e.g., aircraft, rail cars, ships), and/or windows.</skos:definition>
        <skos:example>Custodial services</skos:example>
        <skos:example>Housekeeping (i.e., cleaning) services</skos:example>
        <skos:example>Maid (i.e., cleaning) services</skos:example>
        <skos:example>Service station cleaning and degreasing services</skos:example>
        <skos:example>Washroom sanitation services</skos:example>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/93UXWLTCQB2XarynV_W5qQ -->

