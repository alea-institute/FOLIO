        <rdfs:label>Child Dependency Permanency</rdfs:label>
        <skos:altLabel xml:lang="de-de">Abhängigkeitsdauer</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Child Dependency Permanency</skos:altLabel>
        <skos:altLabel>Dependency Permanency</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Permanence de la dépendance</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Permanencia de la Dependencia</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Permanencia de la Dependencia</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Permanência da dependência</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קיום תלות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अवलंबन स्थायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">依存永続性</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">依赖永久性</skos:altLabel>
        <skos:definition>Dependency Permanency refers to the legal remedies, relief, and penalties related to the options available for a child&apos;s living arrangements when they cannot remain with their biological parents, including APPLA, return to parent, TPR, and adoption.</skos:definition>
    </owl:Class>
    


