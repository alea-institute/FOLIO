        <skos:altLabel xml:lang="de-de">Ein-Schritt-Fusion</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fusion en une seule étape</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Fusión en un solo paso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Fusión en un solo paso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fusão em uma etapa</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">One-Step Merger</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מסירה בשלב אחד</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एक-चरण विलय</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">ワンステップ合併</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">一步合并</skos:altLabel>
        <skos:definition>A One-Step Merger is a type of merger where the acquiring company merges directly with the target company, without the need for a separate shareholder vote on the merger agreement.</skos:definition>
    </owl:Class>
    


