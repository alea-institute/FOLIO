    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8JkKF4Hj1gEToIcmTffB1y">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJEhNjPDXIeJRMwifVraDk"/>
        <rdfs:label>Unilateral Mistake in Contract</rdfs:label>
        <skos:altLabel xml:lang="de-de">Einseitiger Irrtum im Vertrag</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Erreur unilatérale dans le contrat</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Erro unilateral no contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Error unilateral en el contrato</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Error unilateral en el contrato</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Unilateral Mistake in Contract</skos:altLabel>
        <skos:altLabel xml:lang="he-il">טעות חד-צדדית בחוזה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">एकतरफ़ा अशुद्धि अनुबंध में</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">合同中的单方面错误</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">契約における一方的な誤り</skos:altLabel>
        <skos:definition>A unilateral mistake in contract is a legal concept that occurs when only one party to a contract is mistaken about a material fact, which can lead to the contract being voidable or unenforceable.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8JtFY330JV9BMSQjUX8vWf -->

