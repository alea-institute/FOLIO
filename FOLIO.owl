        <skos:altLabel>A NATO-4 visa is issued to officials of NATO and their immediate family members, allowing them to enter the U.S. to perform official duties related to NATO. This visa category includes high-ranking officials, diplomats, and their dependents.</skos:altLabel>
        <skos:altLabel>International Military Alliance Official Visa</skos:altLabel>
        <skos:altLabel>NATO Diplomat Visa</skos:altLabel>
        <skos:altLabel>NATO Official Visa</skos:altLabel>
        <skos:altLabel>NATO Senior Officer Visa</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBdctXabA8wNOWq0sdZG5PC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBdctXabA8wNOWq0sdZG5PC">
