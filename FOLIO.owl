            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Hunting Rights</rdfs:label>
        <skos:definition>These rights grant an individual or entity the permission to hunt wildlife on a specific piece of land. They can be acquired through leases, permits, or land ownership.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBpsWIRUJELHpUvE3xQw7Of -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBpsWIRUJELHpUvE3xQw7Of">
