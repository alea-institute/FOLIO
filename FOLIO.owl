        <skos:altLabel xml:lang="he-il">הכלאה הפלילית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अपराधी बंदी रखना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">刑事监禁</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">刑務所収容</skos:altLabel>
        <skos:definition>The concept of Criminal Incarceration refers to the punishment of a person who has been convicted of a crime by being confined to a prison or jail for a specified period of time, as a penalty for their wrongdoing.</skos:definition>
    </owl:Class>
    


