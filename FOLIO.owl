        <skos:altLabel xml:lang="ja-jp">ケチュア語</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">克丘亚语</skos:altLabel>
        <skos:definition>Quechua is a structured system of communication, both written and spoken, that is used in certain regions of South America and is a member of the Language top-level class.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDkRxKHNQx5WN6SKW7M4vS -->

