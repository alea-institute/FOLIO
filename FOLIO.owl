        <skos:altLabel xml:lang="zh-cn">债务承担动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">債務負担に関する動議</skos:altLabel>
        <skos:definition>A Motion to Incur Debt is a request made in a bankruptcy case seeking court approval to obtain new debt or credit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCW4ROCsdWndMwqVoSxvEE2 -->

