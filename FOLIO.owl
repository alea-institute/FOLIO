        <skos:altLabel xml:lang="de-de">Anspruch auf gerechte Umwandlung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Equitable Conversion Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación de conversión equitativa</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación de conversión equitativa</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de conversão equitativa</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de conversion équitable</skos:altLabel>
