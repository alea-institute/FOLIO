        <rdfs:label>Stomach Cancer</rdfs:label>
        <skos:altLabel>Gastric Carcinoma</skos:altLabel>
        <skos:altLabel>Stomach Carcinoma</skos:altLabel>
        <skos:definition>Stomach cancer, also known as gastric cancer, is a type of cancer that develops from the lining of the stomach. It can spread to other parts of the body if not treated and typically requires treatments such as surgery, chemotherapy, radiation therapy, and targeted therapy.</skos:definition>
        <skos:prefLabel>Gastric Cancer</skos:prefLabel>
    </owl:Class>
    


