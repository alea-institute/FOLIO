        <rdfs:label>Stipulated Voluntary Dismissal with Prejudice</rdfs:label>
        <skos:altLabel xml:lang="es-es">Desestimación voluntaria estipulada con perjuicio</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Desestimación voluntaria estipulada con perjuicio</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Desistência voluntária estipulada com prejuízo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Désistement volontaire stipulé avec préjudice</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Stipulated Voluntary Dismissal with Prejudice</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Vereinbarter freiwilliger Abweisung mit Vorurteil</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטור רשמי ומתומן עם פגיעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">पूर्वनिर्धारित स्वेच्छा से अस्वीकृति जो नुकसान के साथ होती है</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">前例となる自発的な不起訴放棄</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">有偏见的自愿撤诉</skos:altLabel>
        <skos:definition>A Stipulated Voluntary Dismissal with Prejudice is a legal agreement between parties in a lawsuit where the plaintiff agrees to dismiss the case permanently and cannot bring the same claim again in the future.</skos:definition>
    </owl:Class>
    


