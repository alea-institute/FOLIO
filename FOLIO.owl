        <skos:altLabel xml:lang="en-gb">Analysis of Insurance Considerations</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Análise de considerações de seguro</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Análisis de consideraciones de seguros</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Análisis de consideraciones de seguros</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ניתוח של שיקולי ביטוח</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">बीमा विचारों का विश्लेषण</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">保险考虑分析</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">保険に関する考慮の分析</skos:altLabel>
        <skos:definition>Analysis of Insurance Considerations refers to the process of evaluating the potential impact of insurance policies on a legal obligation, such as a contract or tort liability.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9REJRRQygCxAwvw7ogO7TS -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9REJRRQygCxAwvw7ogO7TS">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7oBWHStfmqTLn2MypkW3Pj"/>
        <dc:identifier>ENTITY-EC</dc:identifier>
        <rdfs:label>Exempted Company</rdfs:label>
        <skos:altLabel xml:lang="de-de">Befreites Unternehmen</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Empresa isenta</skos:altLabel>
        <skos:altLabel>Exempted Company</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Société exonérée</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">免除された会社</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">豁免公司</skos:altLabel>
        <skos:definition>A company that does not have to pay tax or act according to the usual regulations of the country in which it is established. Exempted companies fall on the tax laws of countries and territories including are the Cayman Islands, Bermuda, and Gibraltar.</skos:definition>
        <skos:hiddenLabel>EC</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R9RFuWyCmHtZlkspRITqU50 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R9RFuWyCmHtZlkspRITqU50">
