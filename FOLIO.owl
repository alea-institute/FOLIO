        <skos:altLabel xml:lang="de-de">Laches</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Laches</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Laches</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Laches</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Laches</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">Laches</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Laches</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Laches</skos:altLabel>
        <skos:altLabel xml:lang="he-il">לאצ&apos;ס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">लाचेस</skos:altLabel>
        <skos:definition>Laches is a legal defense that argues that a plaintiff has unreasonably delayed in bringing a claim, causing prejudice to the defendant.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMmqDogmlGEOTbDl6GgXyL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMmqDogmlGEOTbDl6GgXyL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm"/>
        <rdfs:label>Dangerous Domesticated Animals</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Animais domésticos perigosos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Animales domésticos peligrosos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Animales domésticos peligrosos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Animaux domestiques dangereux</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dangerous Domesticated Animals</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gefährliche domestizierte Tiere</skos:altLabel>
        <skos:altLabel xml:lang="he-il">חיות מחמד מסוכנות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खतरनाक पालतू जानवर</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">危险的家养动物</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">危険な家庭飼い動物</skos:altLabel>
        <skos:definition>Dangerous Domesticated Animals: Domesticated animals that have a propensity to cause harm or injury to humans or other animals, and are subject to specific legal regulations and liabilities.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMo0rWec8owXGDAYl6PGNG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMo0rWec8owXGDAYl6PGNG">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
        <rdfs:label>Concurrent Interest</rdfs:label>
        <skos:altLabel>Dual Ownership</skos:altLabel>
        <skos:altLabel>Shared Ownership</skos:altLabel>
        <skos:altLabel>Simultaneous Ownership</skos:altLabel>
        <skos:definition>Concurrent Interest refers to the situation where two or more parties simultaneously hold ownership interests in the same piece of property. This type of ownership includes various forms such as joint tenancy, tenancy in common, and tenancy by the entirety, each with distinct legal implications regarding the rights of the owners.</skos:definition>
        <skos:prefLabel>Co-Ownership</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMp106nIJRsFkB6OvTrosk -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMp106nIJRsFkB6OvTrosk">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7knuzL2Cu6WLdyvQiDMp8F"/>
        <rdfs:label>Liable</rdfs:label>
        <skos:definition>In a civil legal context, &quot;liable&quot; is a determination made by a court that a party is legally responsible or accountable for a particular harm, injury, or legal obligation. It often leads to the imposition of remedies or damages to compensate the injured party in a civil lawsuit.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMsjauKT3Gp0pGU1YUnXVI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RMsjauKT3Gp0pGU1YUnXVI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
        <rdfs:label>Liability to Property Trespassers</rdfs:label>
        <skos:altLabel xml:lang="de-de">Haftung für Hausfriedensbruch</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Liability to Property Trespassers</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Responsabilidad frente a los intrusos en la propiedad</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Responsabilidad frente a los invasores de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Responsabilidade por invasores de propriedade</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Responsabilité envers les intrus sur la propriété</skos:altLabel>
        <skos:altLabel xml:lang="he-il">אחריות כלפי פורעי קניין</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संपत्ति घुसपैठ के लिए उत्तरदायित्व</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">不法侵入者に対する責任</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">对财产侵入者的责任</skos:altLabel>
        <skos:definition>Liability to Property Trespassers refers to the legal responsibility of a property owner for any harm caused to individuals who enter their property without permission, and the resulting legal claims that may arise in relation to such harm.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RMubzEbysFKAz1z6P3BYMX -->

