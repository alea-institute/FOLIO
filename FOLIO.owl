        <rdfs:label>Motion to Exclude Hearsay Witness</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Ausschluss eines Zeugen wegen Hearsay</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Excluir Testigo de Oídas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Excluir Testigo de Oídas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour exclure un témoin de ouï-dire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Exclude Hearsay Witness</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de exclusão de testemunha de ouvir dizer</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">hearsay 証人排除請求</skos:altLabel>
        <skos:altLabel xml:lang="he-il">בקשה לאפשר ראיית שמועה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">अबक़ात गवाह को निकालने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">排除传闻证人动议</skos:altLabel>
        <skos:definition>A Motion to Exclude Hearsay Witness is a legal request to prevent a witness from testifying in court based on the fact that their testimony is based on hearsay evidence.</skos:definition>
    </owl:Class>
    


