        <rdfs:label>Motion to Reopen Adversary Proceeding</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Wiedereröffnung des Widerspruchsverfahrens</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción para Reabrir el Procedimiento Contencioso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Reabrir el Procedimiento Contencioso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour rouvrir la procédure contradictoire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Reopen Adversary Proceeding</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para reabrir o processo contraditório</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לפתיחת משפט נגדי מחדש</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विरोधी प्रक्रिया को फिर से खोलने के लिए आवेदन</skos:altLabel>
