        <skos:altLabel xml:lang="zh-cn">争议解决服务</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">紛争処理サービス</skos:altLabel>
        <skos:definition>A process that describes a conflict/adversarial event potentially or actually involving a second party. This can include government entity or internal investigation</skos:definition>
        <skos:hiddenLabel>D</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RDign9opONc6uL7W3U2h9g1 -->

