        <skos:altLabel xml:lang="de-de">Kein-Shop-Verpflichtung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">No-Shop Covenant</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Pacto de no compras</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pacto de não-compra</skos:altLabel>
