        <skos:altLabel xml:lang="zh-cn">现代希腊语</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">現代ギリシャ語</skos:altLabel>
        <skos:definition>Greek, Modern (1453-) is a form of language that emerged after the fall of the Byzantine Empire and is still in use today.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBgyUJt7qyOEtnXbAg6mdTJ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBgyUJt7qyOEtnXbAg6mdTJ">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
        <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
        <rdfs:label>Health Public Benefit</rdfs:label>
        <skos:definition>Health public benefit refers to government programs designed to provide medical services or financial assistance for healthcare needs to eligible individuals. This can include programs like Medicaid in the United States, which offers healthcare coverage to low-income families and individuals.</skos:definition>
        <skos:prefLabel>Medical Assistance</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
        <rdfs:label>Non-economic Damages</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Danos não econômicos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Daños no económicos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Daños no económicos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Dommages non-économiques</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Nichtwirtschaftliche Schäden</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Non-economic Damages</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נזקים לא-כלכליים</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गैर-आर्थिक हानि</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">非経済的損害賠償</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">非经济性损害赔偿</skos:altLabel>
        <skos:definition>Non-economic damages refer to compensation awarded in a legal matter for harm or loss that cannot be quantified in monetary terms, such as pain and suffering, emotional distress, disfigurement, and loss of consortium.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBgyq2bGwkmGczszqmysCpl -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBgyq2bGwkmGczszqmysCpl">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8g9E8c4U6pZQefIjUNRuDd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bankrupt’s Voiding of Preferential Transfer of Property</rdfs:label>
        <skos:altLabel xml:lang="de-de">Anfechtung von bevorzugten Übertragungen von Eigentum durch den Insolvenzverwalter</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Annulation de transfert préférentiel de propriété par le failli</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Anulación por parte del fallido de la transferencia preferente de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Anulação de transferência preferencial de propriedade pelo falido</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Bankrupt’s Voiding of Preferential Transfer of Property</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Nulidad por parte del quebrado de la transferencia preferencial de propiedad</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ביטול העברה מועדפת של נכשל</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दिवालिया के द्वारा सुविधाजनक संपत्ति के स्थानांतरण को रद्द करना</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">破产人废止优先财产转让</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">破産者による優先的な財産譲渡の無効化</skos:altLabel>
        <skos:definition>The Bankrupt&apos;s Voiding of Preferential Transfer of Property refers to the legal concept where a bankrupt individual or entity is allowed to cancel or undo any transfer of property made to a creditor within a certain time period before filing for bankruptcy, in order to ensure fair distribution of assets among all creditors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBgzWJQz52CrObfGXDKH1t7 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBgzWJQz52CrObfGXDKH1t7">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79LjWBKHCdmQKEW6zPY8Co"/>
