        <skos:altLabel xml:lang="ja-jp">雇用差別主張</skos:altLabel>
        <skos:definition>A claim made by an employee alleging unfair treatment or disparate impact based on a protected characteristic such as race, gender, age, or disability in the workplace.</skos:definition>
    </owl:Class>
    


