    <!-- https://folio.openlegalstandard.org/R8eQHglxCehdB1Pf0aeQOi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8eQHglxCehdB1Pf0aeQOi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxtm6yCTUcImGngCzkPcx0"/>
        <dc:source>Fed. R. Evid. 804(b)(2)</dc:source>
        <rdfs:label>Dying Declaration</rdfs:label>
        <skos:altLabel>Statement Under Belief of Impending Death</skos:altLabel>
        <skos:definition>A Dying Declaration is a hearsay exception that allows the admission of statements made by a declarant while believing that their death was imminent, concerning the cause or circumstances of what the declarant believed to be their impending death. This exception is based on the rationale that a person facing imminent death is unlikely to lie, giving their statement a guarantee of trustworthiness.</skos:definition>
        <skos:prefLabel>Deathbed Declaration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8eT1bTptg5J6ZfnwSUQYpf -->

