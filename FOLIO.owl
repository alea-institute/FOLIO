        <skos:altLabel xml:lang="hi-in">ग्राहक मामला आईडी</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">客户事项编号</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">顧客案件ID</skos:altLabel>
