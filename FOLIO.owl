    <!-- https://folio.openlegalstandard.org/RORCUYDiiZxOrpiC8NiK74 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RORCUYDiiZxOrpiC8NiK74">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwdLsWxoa7TqpUv5hIYwzW"/>
        <rdfs:label>Corporate Vice President</rdfs:label>
        <skos:altLabel>EVP</skos:altLabel>
        <skos:altLabel>Executive Vice President</skos:altLabel>
        <skos:altLabel>SVP</skos:altLabel>
        <skos:altLabel>Senior Vice President</skos:altLabel>
        <skos:altLabel>VP</skos:altLabel>
        <skos:definition>A Corporate Vice President is an executive officer responsible for leading specific departments or functions within a company and supporting the President or CEO in executing strategic initiatives. The Vice President may oversee operations, sales, finance, or other divisions, often holding a key leadership role within the organization&apos;s hierarchy.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROT1GuNtl9h4QU8jrvAVO9 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROT1GuNtl9h4QU8jrvAVO9">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBVQj7fYsBw67yNXs4WI6RX"/>
        <rdfs:label>Derivatives Investment Assets</rdfs:label>
        <skos:definition>Derivatives Investment Assets are financial instruments whose value is derived from an underlying asset, index, or security. Examples include options, futures, and swaps, and these derivatives are often used for hedging risk or for speculative purposes, offering the potential for high returns but also carrying high risk.</skos:definition>
        <skos:prefLabel>Derivatives</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROT5i4M3OcSpvgyDmrju1B -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/ROT5i4M3OcSpvgyDmrju1B">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7"/>
        <rdfs:label>Firm Innovation Personnel</rdfs:label>
        <skos:definition>Firm innovation personnel are individuals within a law firm or legal organization who are responsible for driving innovation and implementing new technologies or processes. They focus on improving efficiency, enhancing service delivery, and creating new business models to keep the firm competitive in an evolving legal landscape.</skos:definition>
        <skos:prefLabel>Legal Innovation Personnel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/ROTdtGQjm30XPpZAiSyVxm -->

