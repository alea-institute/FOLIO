        <skos:altLabel xml:lang="ja-jp">規制物質の所持</skos:altLabel>
        <skos:definition>The unlawful cultivation, manufacture, distribution, sale, purchase, use, possession, transportation, or importation of any controlled drug or narcotic substance.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8PCFARyZiL1JkOYsz4sen3 -->

