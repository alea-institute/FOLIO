        <rdfs:label>Motion to Stay Preliminary Injunction</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Aussetzung der einstweiligen Verfügung</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Moción de Suspensión de la Orden de Alejamiento Provisional</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción de Suspensión de la Orden de Alejamiento Provisional</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Stay Preliminary Injunction</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Suspensão da Liminar Preliminar</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en suspension de l&apos;injonction préliminaire</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה לעצירת צו אישור זמני</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रारंभिक अवरोध को रोकने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">仮処分差止め請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">暂停初步禁令动议</skos:altLabel>
        <skos:definition>A Motion to Stay Preliminary Injunction is a request made to a court to temporarily suspend or delay the enforcement of a preliminary injunction until a final decision is made on the case.</skos:definition>
    </owl:Class>
    


