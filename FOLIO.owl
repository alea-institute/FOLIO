        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
        <rdfs:label>Waiver and Release Clause</rdfs:label>
        <skos:altLabel xml:lang="fr-fr">Clause de renonciation et de libération</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Cláusula de renuncia y liberación</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cláusula de renuncia y liberación</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Cláusula de renúncia e liberação</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verzichts- und Freistellungsklausel</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Waiver and Release Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף פטור ושחרור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">वेवर और रिलीज क्लॉज</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">放棄および解除条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">豁免和解除条款</skos:altLabel>
        <skos:definition>A waiver and release clause is a provision in a contract that releases a party from liability for certain actions or events, and waives the right to pursue legal action related to those actions or events.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RWuBs7zey8BVg86iZuFUNk -->

