    <!-- https://folio.openlegalstandard.org/p5WlN9F1QDmFONE9xA29OA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/p5WlN9F1QDmFONE9xA29OA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=314"/>
        <rdfs:label>Textile Product Mills Industry</rdfs:label>
        <skos:definition>Industries in the Textile Product Mills subsector group establishments that make textile products (except apparel).  With a few exceptions, processes used by these establishments are generally cut and sew (i.e., purchasing fabric and cutting and sewing to make nonapparel textile products, such as sheets and towels).</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/p5Wlpt9nS5STsLznQ5Lg5g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/p5Wlpt9nS5STsLznQ5Lg5g">
