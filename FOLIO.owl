        <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo de Liberación</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Klausel zur Freigabevereinbarung</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Release Agreement Clause</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סעיף הסכם שחרור</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">रिलीज समझौता धारा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">リリース契約条項</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">发布协议条款</skos:altLabel>
        <skos:definition>A Release Agreement Clause is a provision in a legal contract that outlines the terms and conditions for releasing one party from liability or obligation to another party.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RRG4lERCqVLwIjrkNgCGaG -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RRG4lERCqVLwIjrkNgCGaG">
