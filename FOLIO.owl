        <skos:altLabel xml:lang="zh-cn">诽谤</skos:altLabel>
        <skos:definition>Defamation is a civil claim and tort claim that involves the communication of a false statement that harms the reputation of an individual or entity.</skos:definition>
    </owl:Class>
    


