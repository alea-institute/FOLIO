        <rdfs:label>Probate Filing Type</rdfs:label>
        <skos:altLabel xml:lang="de-de">Nachlassanmeldungsart</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Probate Filing Type</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tipo de arquivamento de inventário</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Tipo de presentación de sucesiones</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Tipo de presentación de sucesiones testamentarias</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Type de dépôt de succession</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סוג הגשת צוואות לפקודת ירושה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रोबेट फाइलिंग प्रकार</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">遗嘱认证申请类型</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">遺産申告タイプ</skos:altLabel>
        <skos:definition>A Probate Filing Type is a specific category of legal documents submitted to a court for the purpose of initiating or managing a probate case, such as Emergency or Successor Probate.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R92PYc4oBJtNCJNfRqaXHFo -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R92PYc4oBJtNCJNfRqaXHFo">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDpizZcACsM7yyhWpT5tJaM"/>
        <rdfs:label>Forward-looking MAE Standard - &quot;Would reasonably be expected to&quot; Language</rdfs:label>
        <skos:altLabel xml:lang="es-es">Estándar de MAE prospectivo - Lenguaje &quot;Razonablemente se esperaría que&quot;</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándar de MAE prospectivo - Lenguaje &quot;Razonablemente se esperaría que&quot;</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Forward-looking MAE Standard - &quot;Would reasonably be expected to&quot; Language</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Norme MAE prospective - Langage &quot;Serait raisonnablement attendu&quot;</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Padrão de MAE prospectivo - Linguagem &quot;Seria razoavelmente esperado&quot;</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Standard für vorwärtsgerichtete MAE - Sprache &quot;Wäre vernünftigerweise zu erwarten&quot;</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקן MAE עתידני - שפת &quot;מצפים לראות בצורה סבירה&quot;</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">फॉरवर्ड-लुकिंग एमएई मानक - &quot;यह तर्कसंगत रूप से उम्मीद किया जाना चाहिए&quot; भाषा</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">前瞻性 MAE 标准 - &quot;合理预期&quot;</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">将来的な MAE 標準 - &quot;合理的に予想される&quot; 言語</skos:altLabel>
        <skos:definition>A Forward-looking MAE Standard with &quot;Would reasonably be expected to&quot; Language is a legal concept that refers to a standard used in contracts to determine whether a material adverse effect has occurred or is likely to occur, based on what a reasonable person would expect.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R92QUjbbHLrql6U0Ju03hkP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R92QUjbbHLrql6U0Ju03hkP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED: Proceeding Status</rdfs:label>
        <skos:definition>DEPRECATED in favor of `Proceeding Status`</skos:definition>
        <skos:definition>Legal Proceeding Status refers to the current stage or condition of a legal case or proceeding. It indicates whether the case is ongoing, completed, pending, or at a specific milestone within the legal process.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R92S2HIVThaRnO0lgcFKgIw -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R92S2HIVThaRnO0lgcFKgIw">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RGK6KYY8XqLTyeigvEAIOg"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Break Violation Claim</rdfs:label>
        <skos:altLabel xml:lang="en-gb">Break Violation Claim</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Reclamación por violación de descanso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Reclamación por violación de descanso</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Reivindicação de violação de intervalo</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Réclamation de violation de pause</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verstoß gegen die Pause-Regelung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה על הפרת מנוחה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">विश्राम उल्लंघन दावा</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">休憩違反請求</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反休息规定索赔</skos:altLabel>
        <skos:definition>A break violation claim is a legal action initiated by an employee against their employer relating to the legal requirement to provide breaks during the workday. These breaks can include rest breaks and meal breaks, and the claim typically arises when an employer either denies or interrupts breaks or does not provide them in accordance with applicable labor laws. In some cases, employers may also be liable for break violations if they do not compensate employees for certain types of work performed during breaks.</skos:definition>
    </owl:Class>
    


