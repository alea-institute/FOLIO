        <rdfs:label>Assignment of Case</rdfs:label>
        <skos:altLabel xml:lang="es-es">Asignación de Caso</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Asignación de Caso</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Assignment of Case</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Atribuição de caso</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Attribution de cas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Fallzuweisung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הקצאת תיק</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मामले का असाइनमेंट</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">事件の割り当て</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">案件分配</skos:altLabel>
        <skos:definition>The concept of &quot;Assignment of Case&quot; refers to the act of designating a specific case to a particular individual or group for handling.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJVPkhBi7K5BLh6864GAZT -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJVPkhBi7K5BLh6864GAZT">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R969M34LEgPe5hm59rdksmi"/>
        <rdfs:label>oasis:Prohibition</rdfs:label>
        <skos:definition>A prohibition is a type of deontic specification in the OASIS ontology, indicating that an action or behavior is not allowed or prohibited.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJWgTkaOcLU7qdyszskft6 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJWgTkaOcLU7qdyszskft6">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKUCwOJGfYiSc7zU1qkhAS"/>
        <rdfs:label>Data Tampering</rdfs:label>
        <skos:definition>Data tampering involves the unauthorized alteration of data, often to mislead or commit fraud. It can compromise the integrity of the data and lead to incorrect or false conclusions.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJX0FzWzDirAGzjMvOdfte -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBJX0FzWzDirAGzjMvOdfte">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDS8DPtuFReTFfJ5nGCczD5"/>
        <rdfs:label>Cargo</rdfs:label>
        <skos:altLabel>Shipment</skos:altLabel>
        <skos:definition>Cargo refers to goods or merchandise conveyed in a vessel, airplane, or vehicle. It encompasses all types of freight, excluding passengers&apos; baggage, transported for commercial gain or military purposes.</skos:definition>
        <skos:prefLabel>Freight</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBJYdhH76MiHrKCxH8ObYBl -->

