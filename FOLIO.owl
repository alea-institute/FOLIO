        <rdfs:label>National Background Investigations Bureau</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Bureau Nacional de Investigações de Antecedentes</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Bureau national des enquêtes de sécurité</skos:altLabel>
