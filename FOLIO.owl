        <skos:altLabel xml:lang="es-mx">Industria de la Información</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de l&apos;information</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria da informação</skos:altLabel>
        <skos:altLabel>Information</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Information Industry</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Informationsindustrie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית המידע</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सूचना उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">信息产业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">情報産業</skos:altLabel>
        <skos:definition>The Information industry group comprises establishments engaged in the following processes: producing and distributing information and cultural products, providing the means to transmit or distribute these products as well as data or communications, and processing data.</skos:definition>
        <skos:hiddenLabel>INF</skos:hiddenLabel>
    </owl:Class>
    


