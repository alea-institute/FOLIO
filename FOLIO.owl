    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RPmxKo7VSI6mX0Ibh7moQ0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RPmxKo7VSI6mX0Ibh7moQ0">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9KC6PngzJi80MRTJgJyVad"/>
