        <skos:altLabel xml:lang="hi-in">20 सबसे बड़े अवधारणहीन उधारदाताओं में से एक उधारदाता</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">20大无担保债权人中的债权人</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">20大未保証債権者の債権者</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Acreedor entre los 20 mayores acreedores no garantizados</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Acreedor entre los 20 mayores acreedores no garantizados</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Creditor Among 20 Largest Unsecured Creditors</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Credor entre os 20 maiores credores não garantidos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Créancier parmi les 20 plus grands créanciers non garantis</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gläubiger unter den 20 größten ungesicherten Gläubigern</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נושה בין 20 הנושים הלא מבוטחים הגדולים ביותר</skos:altLabel>
        <skos:definition>A creditor among the 20 largest unsecured creditors is a person or entity who is owed a debt by a debtor and is one of the top 20 creditors who do not have a security interest in the debtor&apos;s property.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCAXcbiFPecGaQxA1PnYrTk -->

