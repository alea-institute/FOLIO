        <skos:altLabel xml:lang="ja-jp">医薬品過失</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">药品过失</skos:altLabel>
        <skos:definition>Pharmaceutical Negligence refers to the failure of a medical professional or institution to provide adequate care and treatment in the prescription, dispensing, or administration of medication, resulting in harm or injury to the patient.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8iWQahgBm11W2MRLvhPRPb -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8iWQahgBm11W2MRLvhPRPb">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMlfBHhw2Mfk0FBrVCQJY9"/>
        <rdfs:label>Universal Life Insurance</rdfs:label>
        <skos:definition>Universal life insurance is a type of permanent life insurance that offers both a death benefit and a cash value component, similar to whole life insurance. However, it differs in its flexibility, allowing policyholders to adjust the premiums and death benefit within certain limits, and it often has an investment element where the cash value can be invested for potential growth.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8iXTxfLjmRheZqxZ2JOSIL -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8iXTxfLjmRheZqxZ2JOSIL">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLxL22W67GcWCpN6VKZd50"/>
        <rdfs:label>Equity Distribution Agreement</rdfs:label>
        <skos:definition>Equity Distribution Agreement is an agreement between a company and a distribution agent detailing the terms and conditions under which the company&apos;s equity securities may be sold or distributed to the public or private investors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8iZHlVVgILFrbU5x5AVRK0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8iZHlVVgILFrbU5x5AVRK0">
