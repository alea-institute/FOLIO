        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32616"/>
        <rdfs:label>Plastics Bottle Manufacturing</rdfs:label>
        <skos:definition>See industry description for 326160.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/qzjL3jOmS3icWuCRXgVKKA -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/qzjL3jOmS3icWuCRXgVKKA">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCJC86Ng8OLL0uVSv8HxhwB"/>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4451"/>
        <rdfs:label>Grocery and Convenience Retailers</rdfs:label>
        <skos:definition>This industry group comprises establishments primarily engaged in retailing a general line of food products. This industry group also includes vending machine operators.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/r-Ao21m5RV2eHmoN57h4qQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/r-Ao21m5RV2eHmoN57h4qQ">
