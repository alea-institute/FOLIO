    <!-- https://folio.openlegalstandard.org/sRxB9Rr0SOqAHsdRgOhU3g -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/sRxB9Rr0SOqAHsdRgOhU3g">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tC-ANburRjGXa9bmfoQdTA"/>
