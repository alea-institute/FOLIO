        <skos:altLabel xml:lang="pt-br">Prisão em flagrante</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verhaftung in flagranti</skos:altLabel>
        <skos:altLabel xml:lang="he-il">עצירה במצב ראיה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">दृष्टिकोण गिरफ्तारी</skos:altLabel>
