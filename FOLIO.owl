    <!-- https://folio.openlegalstandard.org/RwEJQCNxcN2xpsZ1I2YD18 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RwEJQCNxcN2xpsZ1I2YD18">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
        <dc:source>Fed. R. Evid. 611(b)</dc:source>
        <rdfs:label>Beyond the Scope Objection</rdfs:label>
        <skos:altLabel>Irrelevant Inquiry Objection</skos:altLabel>
        <skos:altLabel>Objection to Extraneous Questions</skos:altLabel>
        <skos:definition>A Beyond the Scope Objection is raised when questions during cross-examination or redirect examination address matters not covered in the previous direct examination, exceeding the permissible scope as defined by rules of evidence (e.g., Federal Rule of Evidence 611(b)). While cross-examination is generally limited to the subject matter of the direct examination and matters relating to credibility, decision-makers often permit wide-ranging examinations as long as the questions are relevant, with the option to call the witness as an adverse witness for further questioning.</skos:definition>
        <skos:prefLabel>Outside the Scope Objection</skos:prefLabel>
    </owl:Class>
    


