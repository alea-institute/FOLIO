        <rdfs:label>Mandamus</rdfs:label>
        <skos:altLabel xml:lang="de-de">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">Mandamus</skos:altLabel>
        <skos:altLabel xml:lang="he-il">מנדמוס</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">मंडेमस</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">マンダムス</skos:altLabel>
        <skos:definition>A writ of mandamus is a civil remedy sought to compel a public official or entity to perform a duty that they are legally obligated to perform.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mBLAvdwmc4l41eWBKzkVi -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mBLAvdwmc4l41eWBKzkVi">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9SAKPHWeGi7uZqUG6EMlt"/>
        <rdfs:label>Warden</rdfs:label>
        <skos:altLabel>Chief Correctional Officer</skos:altLabel>
        <skos:altLabel>Corrections Chief</skos:altLabel>
        <skos:altLabel>Prison Superintendent</skos:altLabel>
        <skos:definition>A Warden is the chief administrative officer of a correctional facility, responsible for overseeing all aspects of the facility&apos;s operations, including security, inmate management, staff supervision, and compliance with regulations. The Warden ensures the effective and humane treatment of inmates while maintaining order and safety within the institution.</skos:definition>
        <skos:prefLabel>Prison Director</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8mBvlYvkPszVDMmG8t1ZV -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8mBvlYvkPszVDMmG8t1ZV">
