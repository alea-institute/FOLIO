        <skos:altLabel xml:lang="pt-br">Contraréu</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Contre-défendeur</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Counter-Defendant</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Gegenbeklagter</skos:altLabel>
        <skos:altLabel xml:lang="he-il">נתבע נגדי</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">काउंटर-डिफेंडेंट</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">反被告</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">反訴被告</skos:altLabel>
        <skos:definition>A person against whom a counterclaim is brought.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RfSV5TP9lvM2Xd6B5dsm8W -->

