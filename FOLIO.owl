                <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8Wfz2mTFwxxmbtobaQ5NU9"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Petition for Visa for Dependent of Intended Spouse of Citizen</rdfs:label>
        <skos:altLabel>Form I-129F</skos:altLabel>
        <skos:altLabel>K-1 Petition</skos:altLabel>
        <skos:altLabel>Petition for Alien Fiancé(e)</skos:altLabel>
        <skos:definition>In the United States, a &quot;Petition for Alien Fiancé(e)&quot; refers to Form I-129F in the United States, which is used by U.S. citizens to petition for their foreign fiancé(e) to enter the U.S. for the purpose of getting married. This form initiates the K-1 visa process, allowing the foreign fiancé(e) to travel to the U.S. and marry the U.S. citizen petitioner within 90 days of arrival</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7feY1bvDA4NCnWbsdCZlmC -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7feY1bvDA4NCnWbsdCZlmC">
