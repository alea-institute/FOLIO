        <skos:altLabel xml:lang="es-mx">Custodio</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Verwalter</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">gardien</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">guardião</skos:altLabel>
