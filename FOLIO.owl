        <rdfs:label>Minnesota District Court - Hubbard County</rdfs:label>
        <skos:definition>Minnesota District Court - Hubbard County: A specific district court located in Hubbard County, Minnesota, responsible for administering legal proceedings within its jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBN7uJnEv3AuuJJf6B0MhiQ -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBN7uJnEv3AuuJJf6B0MhiQ">
