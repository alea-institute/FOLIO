        <skos:altLabel xml:lang="pt-br">Citação</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Summons</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Zustellung</skos:altLabel>
        <skos:altLabel xml:lang="he-il">קריאה להופעה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">समन</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">传票</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">召喚状</skos:altLabel>
        <skos:definition>A summons is a legal document issued by a court that commands a person to appear before the court at a specific time and place to respond to a legal action or complaint.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFixP6neKN2GNXnGyEFLgz -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFixP6neKN2GNXnGyEFLgz">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Dxh7cqKFFJ2jKNTvICMhf"/>
        <rdfs:label>Coast Guard</rdfs:label>
        <skos:altLabel>A Coast Guard is a maritime security and safety force responsible for law enforcement, search and rescue operations, and protection of a nation&apos;s maritime borders and interests. This organization typically operates in coastal waters, ports, and inland waterways, serving both military and civilian functions depending on the country&apos;s structure.</skos:altLabel>
        <skos:altLabel>Maritime Guard</skos:altLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RFjY2mO804t9gJNy5Dn4P1 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RFjY2mO804t9gJNy5Dn4P1">
