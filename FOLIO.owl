    <!-- https://folio.openlegalstandard.org/R8KGri8xvqfghB4ViHja406 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8KGri8xvqfghB4ViHja406">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
        <rdfs:label>Repudiatory Breach of Contract</rdfs:label>
        <skos:definition>A Repudiatory Breach of Contract Claim is a legal action asserting that one party has committed a breach so fundamental that it effectively nullifies the contract, allowing the innocent party to terminate the agreement. This type of claim alleges that the breach goes to the root of the contract, depriving the innocent party of substantially the whole benefit they were intended to derive from it.</skos:definition>
        <skos:prefLabel>Contract Repudiation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8KI0TMnv76RaTtsQlLeHvU -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8KI0TMnv76RaTtsQlLeHvU">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8H8cpx25KBk3kH55YwSdDv"/>
        <rdfs:label>DEPRECATED - Material Adverse Effect Definition - Applies to Both Target and Subsidiaries</rdfs:label>
        <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Aplica tanto al Objetivo como a las Subsidiarias</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Aplica tanto al Objetivo como a las Subsidiarias</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Definition eines wesentlichen nachteiligen Effekts - gilt sowohl für das Zielunternehmen als auch für Tochtergesellschaften</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Aplica-se tanto ao Alvo quanto às Subsidiárias</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Définition de l&apos;effet indésirable matériel - s&apos;applique à la fois à la cible et aux filiales</skos:altLabel>
        <skos:altLabel>MAE</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - Applies to Both Target and Subsidiaries</skos:altLabel>
        <skos:altLabel xml:lang="he-il">הגדרת השפעה נגדית חומרית - חלה על המטרה והספקות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - लक्ष्य और उपशाखाओं दोनों के लिए लागू होती है</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">实质不利影响定义-适用于目标和子公司</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-ターゲットと子会社の両方に適用されます</skos:altLabel>
        <skos:definition>SUPERCEDED BY ACQUIROR AND ACQUIREE TAGS. A Material Adverse Effect (MAE) is a significant negative change or event that impacts both the target and its subsidiaries, as defined in a legal agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y">
