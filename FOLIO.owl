        <skos:altLabel xml:lang="es-mx">Dote</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dote</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Douaire</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Dower</skos:altLabel>
