        <skos:altLabel xml:lang="es-es">Evento de Producción de Documentos</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Evento de Producción de Documentos</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Evento de produção de documento</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Événement de production de document</skos:altLabel>
