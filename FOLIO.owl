        <skos:altLabel xml:lang="es-es">Moción para Disolver la Orden de Restricción Temporal</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para Disolver la Orden de Restricción Temporal</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Dissolve Temporary Restraining Order</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Pedido de Dissolução de Ordem de Restrição Temporária</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Requête en vue de la levée d&apos;une ordonnance de référé</skos:altLabel>
