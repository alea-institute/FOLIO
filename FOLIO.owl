        <rdfs:label>Arkansas Circuit Court - Conway Cty.</rdfs:label>
        <skos:definition>The Arkansas Circuit Court - Conway County is a specific court within the Arkansas Circuit Court system that has jurisdiction over legal matters within Conway County, Arkansas.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R83rG2F2Gwg1Tptjt4tnm5M -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R83rG2F2Gwg1Tptjt4tnm5M">
