        <skos:altLabel xml:lang="es-mx">Valor de propiedad de configuración de movimiento</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Valor de propriedade de configuração de movimento</skos:altLabel>
        <skos:altLabel xml:lang="he-il">ערך מאפיין הגדרת תנועה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">गति सेटिंग संपत्ति मूल्य</skos:altLabel>
