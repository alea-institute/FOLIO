        <rdfs:label>Arkansas District Court - Carroll Cty.</rdfs:label>
        <skos:definition>A court located in Carroll County, Arkansas that has jurisdiction over certain legal matters within its designated geographic area.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8Xrium2aVaYqlV8F4UZu6u -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8Xrium2aVaYqlV8F4UZu6u">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
        <rdfs:label>Intellectual Property Management</rdfs:label>
        <skos:definition>Intellectual Property Management refers to the process of managing and protecting intangible assets such as patents, trademarks, copyrights, and domain names.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R8XwFrJuWIwLcyBNEkI3VW0 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R8XwFrJuWIwLcyBNEkI3VW0">
