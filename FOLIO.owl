    <!-- https://folio.openlegalstandard.org/RCaeZbTg74NX3xyNzskpVH8 -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCaeZbTg74NX3xyNzskpVH8">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS"/>
        <dc:identifier>MFG-FDBV</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311"/>
        <rdfs:label>Food Manufacturing Industry</rdfs:label>
        <skos:altLabel>Food and Beverage Manufacturing</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Food and Beverage Manufacturing Industry</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Industria de fabricación de alimentos y bebidas</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Industria de fabricación de alimentos y bebidas</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Industrie de la fabrication d&apos;aliments et de boissons</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Indústria de fabricação de alimentos e bebidas</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Lebensmittel- und Getränkeherstellungsindustrie</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תעשיית ייצור מזון ומשקאות</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">खाद्य और पेय विनिर्माण उद्योग</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">食品和饮料制造业</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">食品飲料製造業</skos:altLabel>
        <skos:definition>Industries in the Food Manufacturing subsector transform livestock and agricultural products into products for intermediate or final consumption.  The industry groups are distinguished by the raw materials (generally of animal or vegetable origin) processed into food products.

The food products manufactured in these establishments are typically sold to wholesalers or retailers for distribution to consumers, but establishments primarily engaged in retailing bakery and candy products made on the premises not for immediate consumption are included.

Establishments primarily engaged in manufacturing beverages are classified in Subsector 312, Beverage and Tobacco Product Manufacturing.</skos:definition>
        <skos:hiddenLabel>FDBV</skos:hiddenLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88m06glAkTkIFNVlAF30zy"/>
        <rdfs:label>AI Trustworthiness</rdfs:label>
        <skos:altLabel>Trustworthy Machine Intelligence</skos:altLabel>
        <skos:definition>AI Trustworthiness refers to the degree of confidence that users and stakeholders can have in an AI system&apos;s ability to perform its intended functions reliably, safely, and ethically. It encompasses various attributes such as fairness, transparency, accountability, and robustness, ensuring that AI systems operate in a manner aligned with societal values and ethical standards.</skos:definition>
        <skos:prefLabel>Trustworthy Artificial Intelligence</skos:prefLabel>
    </owl:Class>
    


