    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhSgKU6gYyBR6VVgW6TBpY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xvhTRvZsOK7xYmQh6eEKG"/>
        <rdfs:label>Closed During Tail Period</rdfs:label>
        <skos:altLabel xml:lang="es-es">Cerrado Durante el Período de Cola</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Cerrado Durante el Período de Cola</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Closed During Tail Period</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Fechado durante o período de cauda</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Fermé pendant la période de queue</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Geschlossen während der Nachlaufperiode</skos:altLabel>
        <skos:altLabel xml:lang="he-il">סגור במהלך תקופת הזנב</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">टेल अवधि के दौरान बंद</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">テール期間中に閉鎖</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">尾期关闭</skos:altLabel>
        <skos:definition>The concept of &quot;Closed During Tail Period&quot; refers to a specific timing of the acquisition proposal closing, where the target company is not allowed to consider any other offers during a certain period after the initial offer has been made.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhX9MYw5DnHiTlEAJgOEzP -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhX9MYw5DnHiTlEAJgOEzP">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGK6KYY8XqLTyeigvEAIOg"/>
        <rdfs:label>Rest Break</rdfs:label>
        <skos:definition>A &quot;Rest Break&quot; is a shorter break during the workday, during which employees can briefly pause from work to rest, stretch, or relax. These breaks are usually paid and are designed to improve productivity and well-being.</skos:definition>
        <skos:prefLabel>Coffee Break</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RBhdG3XVNyKbjAWftcN6wNf -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RBhdG3XVNyKbjAWftcN6wNf">
