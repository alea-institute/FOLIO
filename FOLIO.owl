    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/R7xBgB4PfVczsw05VoUobOY -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/R7xBgB4PfVczsw05VoUobOY">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVcQsyiR3zEN86uQG2Onsy"/>
        <rdfs:label>Efforts Standards</rdfs:label>
        <skos:altLabel xml:lang="de-de">Bemühungsstandards</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Efforts Standards</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Estándares de Esfuerzos</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Normas de Esfuerzos</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Normes d&apos;efforts</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Padrões de esforço</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תקני מאמץ</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">प्रयास मानक</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">努力基準</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">努力标准</skos:altLabel>
        <skos:definition>Efforts Standards are a set of obligations that require a party to use a certain level of effort or diligence in fulfilling their obligations under a contract, with variations including Flat Covenant, Commercially Reasonable Efforts Standard, and Reasonable Best Efforts Standard.</skos:definition>
    </owl:Class>
    


