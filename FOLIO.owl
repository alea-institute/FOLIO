    <!-- https://folio.openlegalstandard.org/RJ7AbKi8Al2xc1FYEO7ASF -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJ7AbKi8Al2xc1FYEO7ASF">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJYLQ3woaBs6FkT7wMbB4U"/>
        <rdfs:label>Wrongful Discharge in Violation of Public Policy</rdfs:label>
        <skos:altLabel xml:lang="es-es">Despido Improcedente por Violación de Política Pública</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Despido Injustificado en Violación de la Política Pública</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Dispensa injusta em violação da política pública</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Licenciement abusif en violation de l&apos;intérêt public</skos:altLabel>
        <skos:altLabel xml:lang="de-de">Unrechtmäßige Kündigung aus Gründen des öffentlichen Interesses</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Wrongful Dismissal in Breach of Public Policy</skos:altLabel>
        <skos:altLabel xml:lang="he-il">פיטורים בלתי חוקיים בהפרת מדיניות ציבורית</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">सार्वजनिक नीति के उल्लंघन में गलत निकाल</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">公共政策に違反する不当解雇</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">违反公共政策的非法解雇</skos:altLabel>
        <skos:definition>The concept of &quot;Wrongful Discharge in Violation of Public Policy&quot; refers to the termination of an employee by an employer in a manner that violates public policy, such as firing an employee for refusing to engage in illegal activities or for reporting illegal conduct.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJ7M50VwxB1VdhcRhCZCbN -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJ7M50VwxB1VdhcRhCZCbN">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Ii4OzSADsjS0VegX12oQJ"/>
        <rdfs:label>Motion to Sell Property Free and Clear</rdfs:label>
        <skos:altLabel xml:lang="de-de">Antrag auf Verkauf von Eigentum frei und unbelastet</skos:altLabel>
        <skos:altLabel xml:lang="es-mx">Moción para vender propiedad libre de gravámenes</skos:altLabel>
        <skos:altLabel xml:lang="fr-fr">Motion pour vendre un bien libre et clair</skos:altLabel>
        <skos:altLabel xml:lang="en-gb">Motion to Sell Property Free and Clear</skos:altLabel>
        <skos:altLabel xml:lang="es-es">Petición para vender propiedad libre de cargas</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Petição para vender propriedade livre e desimpedida</skos:altLabel>
        <skos:altLabel xml:lang="he-il">תביעה למכירת נכסים בחינם ובצורה ברורה</skos:altLabel>
        <skos:altLabel xml:lang="hi-in">संपत्ति को मुक्त और स्पष्ट रूप से बेचने के लिए याचिका</skos:altLabel>
        <skos:altLabel xml:lang="zh-cn">出售不受限制的财产动议</skos:altLabel>
        <skos:altLabel xml:lang="ja-jp">物件の自由な売却に関する動議</skos:altLabel>
        <skos:definition>A Motion to Sell Property Free and Clear is a legal request made in a bankruptcy case to sell a property without any liens or claims against it, allowing the proceeds to be used to pay off creditors.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJ7P2VbioQVexfXhjLwsBI -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJ7P2VbioQVexfXhjLwsBI">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDK6eFy9n1upjAdRoNbPxQd"/>
        <rdfs:label>Tax Incentive</rdfs:label>
        <skos:altLabel>Tax Benefit</skos:altLabel>
        <skos:definition>A Tax Incentive is a provision in tax law designed to encourage specific behaviors or activities by reducing a taxpayer&apos;s tax burden. It encompasses various mechanisms such as tax credits, deductions, exemptions, and preferential rates aimed at promoting certain economic or social objectives.</skos:definition>
        <skos:prefLabel>Tax Relief Mechanism</skos:prefLabel>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJ7piLl6k76qESLjp7iR3R -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJ7piLl6k76qESLjp7iR3R">
        <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R06956a0657387D6513A8528"/>
        <rdfs:label>New York Supreme Court - Cayuga County</rdfs:label>
        <skos:definition>The New York Supreme Court - Cayuga County is a court of general jurisdiction located in Cayuga County, New York, with authority to hear and decide a wide range of civil and criminal cases.</skos:definition>
    </owl:Class>
    


    <!-- https://folio.openlegalstandard.org/RJ9ORBE2bbdkqT1X753x8l -->

    <owl:Class rdf:about="https://folio.openlegalstandard.org/RJ9ORBE2bbdkqT1X753x8l">
